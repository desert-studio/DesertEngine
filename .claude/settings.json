{
  "autoCompactWindow": 200000,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/agent_guard.py\"" }
        ]
      },
      {
        "matcher": "mcp__notion__.*",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/board_guard.py\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/fix_exists_guard.py\"" }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/build_gate.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/agent_guard.py\"" },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/lead_watch.py\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/format_on_edit.py\"" }
        ]
      },
      {
        "matcher": "mcp__notion__.*",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/board_guard.py\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/agent_guard.py\" --self-check" },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/wrapper_lint.py\" --quiet-ok" },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/studio.py\" digest" },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/board_guard.py\" --session-start" },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/not_in_dev.py\" --hook --quiet-ok" }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/agent_guard.py\"" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/agent_guard.py\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/lead_watch.py\"" },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/arch_prompt.py\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/board_guard.py\"" },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/auto_compact.py\"", "timeout": 10 },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/silence_guard.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
