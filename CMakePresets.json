{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "windows-msvc-ninja",
      "displayName": "Windows x64, MSVC, Ninja (run from an x64 developer prompt: vcvars64)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos-clang-ninja",
      "displayName": "macOS arm64, Apple clang, Ninja",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++", "CMAKE_OBJCXX_COMPILER": "clang++" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-ninja-debug",    "configurePreset": "windows-msvc-ninja", "configuration": "Debug" },
    { "name": "windows-msvc-ninja-release",  "configurePreset": "windows-msvc-ninja", "configuration": "Release" },
    { "name": "windows-msvc-ninja-shipping", "configurePreset": "windows-msvc-ninja", "configuration": "Shipping" },
    { "name": "macos-clang-ninja-debug",     "configurePreset": "macos-clang-ninja",  "configuration": "Debug" },
    { "name": "macos-clang-ninja-release",   "configurePreset": "macos-clang-ninja",  "configuration": "Release" },
    { "name": "macos-clang-ninja-shipping",  "configurePreset": "macos-clang-ninja",  "configuration": "Shipping" }
  ]
}
