{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DESERT_WITH_TESTS": "ON"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "win-dev",
      "displayName": "Windows x64, MSVC, Development: module DLLs, unity, FASTLINK (from an x64 developer prompt: vcvars64)",
      "inherits": "windows",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Development" }
    },
    {
      "name": "win-debug",
      "displayName": "Windows x64, MSVC, DebugGame: module DLLs, /Od, debug CRT",
      "inherits": "windows",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "DebugGame" }
    },
    {
      "name": "win-ship",
      "displayName": "Windows x64, MSVC, Shipping: static monolith, /GL + /LTCG",
      "inherits": "windows",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Shipping" }
    },
    {
      "name": "mac-dev",
      "displayName": "macOS arm64, Apple clang, Development: module dylibs, unity",
      "inherits": "macos",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Development" }
    },
    {
      "name": "mac-debug",
      "displayName": "macOS arm64, Apple clang, DebugGame",
      "inherits": "macos",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "DebugGame" }
    },
    {
      "name": "mac-ship",
      "displayName": "macOS arm64, Apple clang, Shipping: static monolith",
      "inherits": "macos",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Shipping" }
    },
    {
      "name": "linux-server-clang",
      "displayName": "Linux x86-64, clang, Ninja, Shipping: the dedicated server only, one static binary (Server/Dockerfile, CI server-linux)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Shipping",
        "DESERT_WITH_TESTS": "OFF",
        "DESERT_SERVER_ONLY": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    { "name": "win-dev", "configurePreset": "win-dev" },
    { "name": "win-debug", "configurePreset": "win-debug" },
    { "name": "win-ship", "configurePreset": "win-ship" },
    { "name": "mac-dev", "configurePreset": "mac-dev" },
    { "name": "mac-debug", "configurePreset": "mac-debug" },
    { "name": "mac-ship", "configurePreset": "mac-ship" },
    {
      "name": "linux-server-clang",
      "configurePreset": "linux-server-clang",
      "targets": [ "DesertServer" ]
    }
  ]
}
