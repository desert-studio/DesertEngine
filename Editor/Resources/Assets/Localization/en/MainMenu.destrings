    "DisplayName": "Main menu",
    "Entries": [
        {
            "Key": "menu.play",
            "Comment": "Primary action on the main screen. A verb.",
            "Forms": {
                "other": "PLAY"
            }
        },
        {
            "Key": "menu.characters",
            "Comment": "Menu item: the player's saved characters.",
            "Forms": {
                "other": "CHARACTERS"
            }
        },
        {
            "Key": "menu.servers",
            "Comment": "Menu item: the server browser.",
            "Forms": {
                "other": "SERVERS"
            }
        },
        {
            "Key": "menu.store",
            "Comment": "Menu item: the in-game shop.",
            "Forms": {
                "other": "STORE"
            }
        },
        {
            "Key": "menu.settings",
            "Comment": "Menu item that OPENS the settings screen. A noun; settings.title is that screen's heading.",
            "Forms": {
                "other": "SETTINGS"
            }
        },
        {
            "Key": "menu.quit",
            "Comment": "Menu item: leave the game entirely.",
            "Forms": {
                "other": "QUIT"
            }
        },
        {
            "Key": "menu.connect",
            "Comment": "Button on the server card. A verb: join this server.",
            "Forms": {
                "other": "CONNECT"
            }
        },
        {
            "Key": "menu.status.offline",
            "Comment": "Shown until gameplay reports a friend count; overridden through the player.status binding.",
            "Forms": {
                "other": "OFFLINE"
            }
        },
        {
            "Key": "menu.status.friends",
            "Comment": "{n} is the friend count. Russian needs three forms; English two. Russian's 'other' is the form a printed fraction takes.",
            "Forms": {
                "one": "ONLINE   -   {n} friend",
                "other": "ONLINE   -   {n} friends"
            }
        },
        {
            "Key": "menu.profile.title",
            "Comment": "Shown on the profile row until gameplay reports a level and a balance.",
            "Forms": {
                "other": "PROFILE"
            }
        },
        {
            "Key": "menu.profile.summary",
            "Comment": "{level} is a number, {money} is already formatted money. Assembled by UIDataBridge.lua.",
            "Forms": {
                "other": "Lv. {level}    {money}"
            }
        },
        {
            "Key": "menu.server.caption.idle",
            "Comment": "Shown on the server card until gameplay reports load and latency.",
            "Forms": {
                "other": "SERVER"
            }
        },
        {
            "Key": "menu.news.patch",
            "Comment": "News ticker row. The bracketed part is a rich-text colour tag, not text.",
            "Forms": {
                "other": "[color=#FF7A33]PATCH[/color]  0.9.1 - housing & car auction"
            }
        },
        {
            "Key": "menu.news.event",
            "Comment": "News ticker row.",
            "Forms": {
                "other": "[color=#2FE3FF]EVENT[/color]  Weekend races - 5,000,000$ prize"
            }
        },
        {
            "Key": "menu.news.clan",
            "Comment": "News ticker row.",
            "Forms": {
                "other": "[color=#2FE3FF]CLAN[/color]  Vinewood Family recruiting"
            }
        },
        {
            "Key": "menu.ticker",
            "Comment": "Scrolling marquee at the bottom of the screen. Three announcements, wide gaps between them.",
            "Forms": {
                "other": "Double XP until Monday        Season 4 starts Aug 15        Join our Discord community"
            }
        },
        {
            "Key": "menu.hints",
            "Comment": "Keyboard hints. 'Tab', 'Enter' and 'Esc' are KEY NAMES and must not be translated.",
            "Forms": {
                "other": "Tab - navigate    Enter - select    Esc - back"
            }
        },
        {
            "Key": "settings.title",
            "Comment": "Heading of the settings screen.",
            "Forms": {
                "other": "SETTINGS"
            }
        },
        {
            "Key": "settings.resolution",
            "Comment": "Settings row. The resolution itself is placeholder content in this demo screen.",
            "Forms": {
                "other": "Resolution      1920 x 1080"
            }
        },
        {
            "Key": "settings.volume",
            "Comment": "Settings row.",
            "Forms": {
                "other": "Volume        80%"
            }
        },
        {
            "Key": "settings.note",
            "Comment": "Explains what this screen demonstrates: Back returns to the screen underneath.",
            "Forms": {
                "other": "Screen stack: Back returns to Main"
            }
        },
        {
            "Key": "settings.back",
            "Comment": "Returns to the previous screen. The '<' is decoration.",
            "Forms": {
                "other": "< BACK"
            }
        }
    ]
}
