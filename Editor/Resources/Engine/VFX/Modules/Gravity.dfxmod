// DesertAsset {"Kind":"VFXModule","Guid":"bd19bb728e4646919475240f1a19369d","Versions":{"VFXM":1},"Dependencies":[]}
Module "Gravity"
{
    Stage ParticleUpdate
    Category Forces
    Description "Adds a constant acceleration to the accumulated force."
    Attribute PhysicsForce vec3
    Attribute Mass float
    Input Gravity vec3 Units=cm/s2 Range=-2000..2000 Default=0,-980,0

    // Engine VFX module Gravity (UE Niagara Content/Modules/Update/Forces/GravityForce): adds a constant
    // acceleration to the particle's accumulated force. Centimetres per second squared (world units = cm).
    // SolveForcesAndVelocity integrates the sum.
    void Module( inout ParticleCtx p, inout VFXSim sim, in ModuleInputs i )
    {
        // A force, so it is acceleration times mass; a particle never given a mass weighs 1.
        p.PhysicsForce += i.Gravity * ( p.Mass > 0.0 ? p.Mass : 1.0 );
    }
}
