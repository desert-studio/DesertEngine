// DesertAsset {"Kind":"VFXModule","Guid":"2d5323b9c4d349f8b91c4fc795599f4f","Versions":{"VFXM":1},"Dependencies":[]}
Module "InitializeLifetime"
{
    Category Initialize
    Description "Sets a newborn's lifetime in seconds."
    Usage ParticleSpawn
    Attribute Age float
    Attribute Lifetime float
    Input Lifetime float = 1 Unit s

    // Engine VFX module InitializeLifetime (UE InitializeParticle's Lifetime, NiagaraStatelessModule_
    // InitializeParticle.ush:20-37 + the emitter's lifetime range): the newborn's age is zero and its lifetime is the
    // Lifetime input, seconds — a Random-source range is UE's lifetime min/max — or a Spawn from Channel lifetime when
    // the emitter binds one. Spawn group; UpdateAge retires it.
    void Module( inout ParticleCtx p, inout VFXSim sim, in ModuleInputs i )
    {
        p.Age      = 0.0;
        p.Lifetime = sim.ChannelScalars.w > 0.5 ? max( sim.ChannelScalars.x, 0.0 ) : max( i.Lifetime, 0.0 );
    }
}
