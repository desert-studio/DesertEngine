// DesertAsset {"Kind":"VFXModule","Guid":"55923c5734e04fc78e068ad051c4772c","Versions":{"VFXM":1},"Dependencies":[]}
Module "InitializeSpriteSize"
{
    Stage ParticleSpawn
    Category Initialize
    Description "Sets a newborn's sprite size in centimetres."
    Attribute SpriteSize vec2
    Attribute InitialSpriteSize vec2
    Input Size vec2 Units=cm Range=0..1000 Default=20,20

    // Engine VFX module InitializeSpriteSize (UE Initialize Particle's Sprite Size): the newborn's sprite width
    // and height in centimetres. A Random-source range is UE's size min/max (non-uniform; a uniform range is the same
    // value in both; a Spawn from Channel Size scales it afterwards, SpawnFromChannel). Kept as
    // InitialSpriteSize, the base SizeOverLife scales. Spawn group.
    void Module( inout ParticleCtx p, inout VFXSim sim, in ModuleInputs i )
    {
        p.SpriteSize        = max( i.Size, vec2( 0.0 ) );
        p.InitialSpriteSize = p.SpriteSize;
    }
}
