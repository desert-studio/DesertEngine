#ifndef DESERT_BINDLESS_TEXTURES_GLSLH
#define DESERT_BINDLESS_TEXTURES_GLSLH

// THE GLOBAL BINDLESS TEXTURE TABLE (Engine/Graphic/BindlessTextureTable.hpp, VulkanBindlessTextureTable.hpp).
// Every texture created from uploaded pixels has a slot for its GPU life; slot 0 is the magenta "missing" texture.
// Sampled images and samplers are separate arrays: the sampler is the material slot's state, picked from a FIXED
// set of 18 (one per wrap U x wrap V x filter), never one per texture.
//
// The set index is the engine's (kBindlessSetIndex), handed to every compile as DESERT_BINDLESS_SET, so the shader
// and the pipeline layout cannot disagree. The binding numbers mirror kBindlessSamplerBinding / kBindlessTextureBinding:
// the variable-count image array must be the highest binding.

#extension GL_EXT_nonuniform_qualifier : require

#ifndef DESERT_BINDLESS_SET
#error "DESERT_BINDLESS_SET is defined by the shader compiler (kBindlessSetIndex); this shader was compiled without it"
#endif

layout( set = DESERT_BINDLESS_SET, binding = 0 ) uniform sampler u_BindlessSamplers[18];
layout( set = DESERT_BINDLESS_SET, binding = 1 ) uniform texture2D u_BindlessTextures[];

// Sampler indices: wrapU + 3 * wrapV + 9 * filter, with wrap Repeat 0 / Clamp 1 / Mirror 2 and filter Linear 0 /
// Nearest 1 (BindlessSamplerFor in BindlessTextureTable.hpp).
#define BINDLESS_SAMPLER_LINEAR_REPEAT  0u
#define BINDLESS_SAMPLER_LINEAR_CLAMP   4u
#define BINDLESS_SAMPLER_LINEAR_MIRROR  8u
#define BINDLESS_SAMPLER_NEAREST_REPEAT 9u
#define BINDLESS_SAMPLER_NEAREST_CLAMP  13u

// Both indices are nonuniformEXT: a ray hit or a material record diverges across a subgroup, and an index that
// is not dynamically uniform without the qualifier is undefined behaviour.
vec4 SampleBindless( uint textureSlot, uint samplerSlot, vec2 uv, float lod )
{
    return textureLod( sampler2D( u_BindlessTextures[nonuniformEXT( textureSlot )],
                                  u_BindlessSamplers[nonuniformEXT( samplerSlot )] ),
                       uv, lod );
}

#endif
