#ifndef DESERT_CAMERA_UB_GLSLH
#define DESERT_CAMERA_UB_GLSLH

// The shader view of the per-frame ViewFrame (TAA1 step 3). C++ twin: Graphic/ShaderProtocols/Camera.hpp,
// offsets held by Desert/Tests/Engine/TemporalViewContract/camera_ub_layout_test.cpp.
// It is THE view block (UE's FViewUniformShaderParameters): one per view per frame. A surface cell's vertex header
// and Mesh/Surface/SurfaceTypes.glslh (for SurfaceInput.Time / CameraPosition) both include it, hence the guard.
// Raster geometry: JitteredViewProjection. World position from depth: InvJitteredViewProjection.
// Reprojection: PrevViewProjection vs ViewProjection (unjittered). Projection / View: the camera's, unjittered.
Uniform(0) CameraUB {
    mat4 Projection;
    mat4 View;
    mat4 JitteredViewProjection;
    mat4 ViewProjection;
    mat4 PrevViewProjection;
    mat4 InvJitteredViewProjection;
    vec2 JitterNdc;
    vec2 PrevJitterNdc;
    vec3 CameraPos;
    float Time;
    vec3 PrevCameraPos;
    float PrevTime;
    float MaterialMipBias;
    float ShadowSlopeBias;  // light views only: the caster's slope depth bias per unit tan (Common/ShadowCasterBias.glslh)
    float ShadowSlopeClamp; // light views only: the tangent where that slope term stops
    // Parallax occlusion (Mesh/Surface/SurfaceParallax.glslh): the machine's step counts (Scalability group Shading)
    // and the main directional light's direction TOWARD the sun (zero when the scene has none) for the relief's
    // self-shadow. Every view carries the steps (a light view marches the relief for its depth too).
    float ParallaxMinSteps;
    vec3  SunDirection;
    float ParallaxMaxSteps;
    float ParallaxShadowSteps;
    float CameraPad0;
    float CameraPad1;
    float CameraPad2;
} cameraUB;

#endif
