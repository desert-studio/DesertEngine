// THE cloud parameter block. Declared ONCE, in C++: Graphic::CloudGpuPayload (Engine/Graphic/Clouds/CloudLayout.hpp),
// from which Tools/ShaderProtocolGen writes Generated/Clouds/CloudParams.glslh and checks every offset at compile
// time. This file adds the binding's story and the march's helpers around it.
//
// UNITS: KILOMETRES throughout, already converted on the C++ side by PackCloudParams. Nothing in this
// block is in world units, and nothing downstream converts a second time.
//
// EVERY SLOT HAS A CONSUMER, OR A ROW IN Graphic::kCloudUnreadSlots SAYING WHY NOT. A slot nobody reads is a
// dead setting wearing a parameter's clothes, and the first person to need a new one will quietly repurpose it.
// Desert/Tests/Engine/CloudMediumConsumers takes the members from the C++ declaration and works out from the
// shader tree which components any shader fetches — so an unread slot goes red because it has no row.

#ifndef CLOUD_PARAMS_GLSLH
#define CLOUD_PARAMS_GLSLH

// ComputePipeline::SetStorageBuffer takes the binding as an explicit argument and never consults the
// shader's reflection; the generated block's default is Graphic::kCloudParamsBinding itself.
//
// OVERRIDABLE, because one pass reads this block ALONGSIDE a block that also wants binding 1. The sky's
// environment bake (Programs/Compute/BakeProceduralSky.shader) marches the clouds into the panorama and
// therefore binds BOTH this buffer and the sky payload, whose Graphic::kSkyPayloadBinding is likewise 1 —
// two blocks on one descriptor is not a diagnosable failure, it is one of them reading the other's bytes.
// That pass defines CLOUD_PARAMS_BINDING before including this file; every other consumer leaves the default.
#include <Generated/Clouds/CloudParams.glslh>

// Seeds and octave counts are absent from the block on purpose: they decide what the baked volumes CONTAIN,
// not how the march reads them, so they belong to the generators and would be values copied into every
// dispatch for nothing.

// THE STEP SCHEDULE IS NOT HERE ANY MORE. CLOUD_MIN_STEPS and CLOUD_DISTANCE_TO_MAX_STEPS_KM used to be
// declared in this file, beside the parameter block, and their two siblings — the coarse multiplier and
// the empty-sample count — already lived in Common/CloudGeometry.glslh for a reason this pair shares: a
// uniform block cannot be compiled as C++, so a constant declared here can only ever be PARSED OUT OF THE
// FILE AS TEXT by a test, never driven. Desert/Tests/Engine/CloudGeometry did exactly that, and the
// arrangement hid a relation that text cannot express — that the schedule's step has to resolve the cloud
// the library places. All four now live together in CloudGeometry.glslh, which that suite compiles.

// Builds the shell this frame marches. Requires Common/CloudGeometry.glslh.
CloudLayer CloudUnpackLayer()
{
    return CloudMakeLayer( CloudLayerGeometry.x, CloudLayerGeometry.y, CloudLayerGeometry.z );
}

// Builds the producer's parameters. Requires Common/CloudField.glslh.
CloudFieldParams CloudUnpackFieldParams()
{
    CloudFieldParams p;
    p.DetailTileKm   = CloudDetail.z;
    p.DetailStrength = CloudDetail.x;
    p.DensityScale   = CloudDetail.y;
    p.SpeciesCount   = int( clamp( CloudDetail.w, 0.0f, float( CLOUD_SPECIES_SLOTS ) ) );

    for ( int slot = 0; slot < CLOUD_SPECIES_SLOTS; ++slot )
    {
        p.SpeciesEdge[slot] = CloudSpeciesEdge[slot];
        // CLAMPED ON THE WAY IN, and the bound is the number of samplers this pass actually declares.
        // The packer clamps too; this is the other end of the same wire, and it is here because an index
        // out of range does not fault in the select below — it falls through to slot 0 and cuts the whole
        // sky from the wrong volume with nothing in the log.
        p.SpeciesNoise[slot] =
             int( clamp( CloudSpeciesNoise[slot], 0.0f, float( CLOUD_SPECIES_SLOTS - 1 ) ) );
        p.SpeciesWispBase[slot] = CloudSpeciesWispBase[slot];
        p.SpeciesWispTop[slot]  = CloudSpeciesWispTop[slot];
    }

    // The clip levels' windows, finest first; the last one is periodic (sky occlusion, the far path).
    for ( int level = 0; level < CLOUD_PROCEDURAL_CLIP_LEVELS; ++level )
        p.ProceduralLevel[level] = CloudLevel[level];
    p.Weather         = CloudWeather.yw;
    p.FarScale        = CloudWeather.x;
    p.Coverage        = CloudWeather.z;
    p.SpeciesCover    = CloudSpeciesCover;
    for ( int band = 0; band < CLOUD_FAR_BANDS; ++band )
    {
        p.FarPresence[band] = CloudFarPresence[band];
        p.FarProfile[band]  = CloudFarProfile[band];
    }
    p.LayoutPlace     = CloudLayoutPlace;
    p.LayoutStrength  = CloudLayoutStrength.xy;

    p.WindOffsetKm = vec3( CloudWind.x, CloudWind.y, CloudWind.z );

    // THE UNPACKED PARAMETERS DESCRIBE A VIEW RAY, and a march that is not one says so itself right after
    // this call. It is set HERE rather than left to each caller because an unset float is the one value a
    // graph's `mix( expensive, cheap, ShadowRay )` cannot survive — and because this is the only place in
    // the tree a CloudFieldParams is built, so "every field is written exactly once" stays a property of
    // one function instead of a rule four programs have to remember.
    p.ShadowRay = CLOUD_RAY_VIEW;
    return p;
}

#endif // CLOUD_PARAMS_GLSLH
