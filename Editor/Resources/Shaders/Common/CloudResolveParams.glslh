// CloudResolveBuffer, the one parameter block of the cloud reconstruction: read by CloudTemporalResolve.shader
// (the reprojection and the full-resolution compose, one dispatch), bound to the one buffer
// VolumetricCloudRenderer uploads per frame (m_ResolveParamsBuffer).

// The block is declared ONCE, in C++: Graphic::CloudResolveParams (Engine/Graphic/Clouds/CloudLayout.hpp), from
// which Tools/ShaderProtocolGen writes the generated block at Graphic::kCloudResolveParamsBinding.
//
// A BUFFER AND NOT A PUSH CONSTANT: two 4x4 matrices are already 128 bytes, which is the whole
// size Vulkan guarantees for push constants, and several desktop drivers report exactly that
// minimum. The camera and the frame state would not fit.
#include <Generated/Clouds/CloudResolveParams.glslh>
