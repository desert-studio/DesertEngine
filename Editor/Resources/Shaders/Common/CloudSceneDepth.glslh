// The scene depth a cloud texel is cut at, written once for the three programs that must agree on it:
// CloudRaymarch.shader (where the ray stops), CloudTemporalResolve.shader (the distance its disocclusion test
// and its guide's .y carry) and CloudUpsample.shader (which compares every full-resolution pixel's own depth
// against that .y).
//
// THE FARTHEST SURFACE OF THE FOOTPRINT, not one texel of it. A half-resolution cloud texel stands for the
// block of full-resolution pixels under it (2x2 at the usual ratio). It used to read ONE of them, the
// top-left. Over thin alpha-masked geometry — grass blades, leaves, twigs against the sky — that one pixel is
// covered on some frames and open on others, because the scene is rasterised with the TAA jitter and a blade
// a pixel wide crosses it as the jitter walks. The texel's ray was then cut at the blade (no cloud) on one
// frame and run to the sky (cloud) on the next, the resolve saw its scene distance jump by the whole sky and
// threw the history away, and the composite received a different answer at every blade edge every frame:
// the foliage-against-cloud flicker (FOLIAGE-CLOUD-FLICKER).
//
// The farthest surface of the block is stable under that jitter — a blade that covers part of the block never
// covers all of it — and it is the right thing to trace to: the texel then holds the cloud IN FRONT OF THE
// FARTHEST surface it covers, and the full-resolution upsample removes it from every pixel whose own surface
// is nearer than the cloud (CloudUpsample.shader). That is Unreal's arrangement: the trace runs to the far
// end of the footprint's depth range (VolumetricCloud.usf, SceneDepthMinAndMaxTexture) and the compose, which
// reads each pixel's own scene depth, keeps the volume behind opaque by the cloud front.
//
// REVERSED-Z (Core/Projection.hpp): 1 is the near plane, 0 the far one and the sky, so the farthest surface is
// the SMALLEST device depth.
//
// The includer declares `SceneDepthTexture` (the single-sample scene depth, as a combined sampler) before
// including this file.

// The block of the full-resolution depth that half-resolution pixel @p halfCoord covers on a @p halfSize
// grid, inclusive. The half extent is the full one rounded UP, so the last row and column of the half grid
// can cover nothing but the edge; the max() keeps that block one texel wide rather than empty.
void CloudDepthFootprint(ivec2 halfCoord, ivec2 halfSize, ivec2 depthSize, out ivec2 first, out ivec2 last)
{
    ivec2 edge = depthSize - ivec2(1, 1);
    first = clamp((halfCoord * depthSize) / halfSize, ivec2(0, 0), edge);
    last  = clamp(((halfCoord + ivec2(1, 1)) * depthSize) / halfSize - ivec2(1, 1), first, edge);
}

// The smallest (farthest, reversed-Z) device depth over that block. 0 means the whole block is sky.
float CloudFootprintFarthestDepth(ivec2 halfCoord, ivec2 halfSize)
{
    ivec2 depthSize = textureSize(SceneDepthTexture, 0);
    ivec2 first;
    ivec2 last;
    CloudDepthFootprint(halfCoord, halfSize, depthSize, first, last);

    float farthest = 1.0f;
    for (int y = first.y; y <= last.y; ++y)
        for (int x = first.x; x <= last.x; ++x)
            farthest = min(farthest, texelFetch(SceneDepthTexture, ivec2(x, y), 0).r);
    return farthest;
}

// ---- GEOMETRY IN FRONT OF THE LAYER CUTS NOTHING (SKY-FLICKER) ------------------------------------------------
//
// A footprint whose farthest surface is no farther than the first point the march would sample hides ALL of the
// layer from every pixel of the block: each of them is at most that far, and CloudUpsample.shader removes from a
// pixel every texel whose cloud front (never nearer than that first point) is at or behind the pixel's surface.
// Cutting such a ray at the leaf therefore buys those pixels nothing — and costs the block its history. Under
// the TAA jitter a block at a crown, a roof or a fence edge is wholly covered on some frames and partly open on
// others; the cut made its trace and its scene distance swing between "clear, at the leaf" and "the cloud, at
// the far plane", the resolve threw the history away on every swing, and the sky pixels of the block and of the
// blocks beside it showed a fresh, often edge-mixed trace on exactly those frames.
//
// So such a footprint is OCCLUDED: the march spends nothing on it and marks its texel as holding no sample
// (guide .z = 1), and the march and the resolve both give it the far plane as its scene distance — the
// distance it would have been cut at with the geometry gone, which is the one that does not swing. The resolve
// then keeps the block's cloud from its history (or from its open neighbours) instead of replacing it, and the
// block's own pixels still receive no cloud from the upsample's front test. Geometry FARTHER than the first
// march point — a slope inside the layer, a mountain behind a cloud — still cuts the ray where it stands.
//
// Unreal traces to the far end of the footprint's depth range as well (VolumetricCloud.usf,
// SceneDepthMinAndMaxTexture) but cuts at it whatever it is, so a wholly covered block holds "no cloud" there
// too; it leans on TAA for the swing. Deciding by the layer's own segment removes the swing instead.
//
// The three helpers below are the march's classification, written once for CloudRaymarch.shader and
// CloudTemporalResolve.shader, which must agree on it bit for bit on the pixel the frame traced. They require
// Common/CloudGeometry.glslh (CloudLayer, CloudLayerIntersect, CLOUD_WORLD_UNITS_PER_KM).

// Planet-centre-relative kilometres for a camera at @p cameraWorld (centimetres): the frame in which both
// shells are centred on the origin.
vec3 CloudPlanetOriginKm(vec3 cameraWorld, float planetRadiusKm)
{
    vec3 cameraKm = cameraWorld * (1.0f / CLOUD_WORLD_UNITS_PER_KM);
    return vec3(cameraKm.x, cameraKm.y + planetRadiusKm, cameraKm.z);
}

// The segment the march samples along @p rayDir: the layer's chord (y <= x when there is none), started no
// nearer than the authored tracing start and run no farther past it than the authored view distance. The
// distance limit is measured FROM THE LAYER ENTRY, Unreal's DistanceFromCloudLayerEntryPoint mode, because a
// limit measured from the camera would cut the layer short at a fixed radius and put a circular edge in the sky.
vec2 CloudMarchSegment(CloudLayer layer, vec3 originKm, vec3 rayDir, float tracingStartKm, float maxViewKm)
{
    vec2 segment = CloudLayerIntersect(layer, originKm, rayDir);
    segment.x    = max(segment.x, tracingStartKm);
    segment.y    = min(segment.y, segment.x + max(maxViewKm, 0.0f));
    return segment;
}

// Whether the march samples anything along @p segment at all: the entry lies inside the authored reach and the
// segment is not empty. Both refusals answer "clear" whatever the geometry is.
bool CloudMarchHasWork(vec2 segment, float tracingStartMaxKm)
{
    return segment.x <= max(tracingStartMaxKm, 0.0f) && segment.y > segment.x;
}

// The rule above: geometry in the whole footprint (@p farthestDepth > 0, reversed-Z), at @p geomKm no farther
// than the march's first point, on a ray the march would sample.
bool CloudFootprintOccluded(float farthestDepth, float geomKm, vec2 segment, bool hasWork)
{
    return hasWork && farthestDepth > 0.0f && geomKm <= segment.x;
}
