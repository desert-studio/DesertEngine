#ifndef DESERT_CONE_SAMPLING_GLSLH
#define DESERT_CONE_SAMPLING_GLSLH

// THE SUN'S CONE, SAMPLED (UE GetLightSourceDirection over a directional light's SourceAngle): the one sampler of
// the shadow methods that soften by the sun's angular diameter - "Shadows: Ray Traced Sun" (RayTracedSunShadow.shader)
// and the virtual shadow map's shadow-map ray tracing (VirtualShadowMapProject.shader).

uint ConePcg( uint v )
{
    const uint state = v * 747796405u + 2891336453u;
    const uint word  = ( ( state >> ( ( state >> 28u ) + 4u ) ) ^ state ) * 277803737u;
    return ( word >> 22u ) ^ word;
}

// Two uniform numbers in [0, 1) for sample @p sampleIndex of @p pixel on frame @p frame.
vec2 ConeRandom2( uvec2 pixel, uint frame, uint sampleIndex )
{
    const uint first  = ConePcg( pixel.x + ConePcg( pixel.y + ConePcg( frame * 16u + sampleIndex ) ) );
    const uint second = ConePcg( first );
    return vec2( float( first ), float( second ) ) * ( 1.0 / 4294967296.0 );
}

// A direction inside the cone of half-angle @p halfAngle around @p axis, uniform over its solid angle.
vec3 ConeDirection( vec3 axis, float halfAngle, vec2 u )
{
    const float cosTheta  = mix( 1.0, cos( halfAngle ), u.x );
    const float sinTheta  = sqrt( max( 0.0, 1.0 - cosTheta * cosTheta ) );
    const float phi       = 6.28318530718 * u.y;
    const vec3  helper    = abs( axis.z ) < 0.999 ? vec3( 0.0, 0.0, 1.0 ) : vec3( 1.0, 0.0, 0.0 );
    const vec3  tangent   = normalize( cross( helper, axis ) );
    const vec3  bitangent = cross( axis, tangent );
    return normalize( tangent * ( cos( phi ) * sinTheta ) + bitangent * ( sin( phi ) * sinTheta ) + axis * cosTheta );
}

#endif
