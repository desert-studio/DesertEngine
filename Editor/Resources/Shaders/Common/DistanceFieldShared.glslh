// THE DISTANCE-FIELD LAYOUT CONSTANTS - the one statement of them, compiled twice from this text: as GLSL by
// every shader that reads a mesh distance field or the global distance field (MeshDistanceField.glslh,
// GlobalDistanceField.glslh), and as C++ by Engine/Graphic/DistanceField, which packs the buffers those shaders
// read. The C++ side also pins the brick numbers against Assets/MeshDistanceField.hpp (UE DistanceField::).
// Dialect as LandscapeHeight.glslh: plain `const int` / `const float` with `f` suffixes, nothing else.
#ifndef DISTANCE_FIELD_SHARED_GLSLH
#define DISTANCE_FIELD_SHARED_GLSLH

// Mesh distance fields (UE DistanceFieldAtlas.h:39-50).
const int DF_BRICK_SIZE        = 8; // samples per brick side, one of them the shared border
const int DF_UNIQUE_BRICK_SIZE = 7;
const int DF_NUM_MIPS          = 3;
// The brick atlas, in bricks per side along x and y (it grows along z).
const int DF_ATLAS_BRICKS_X = 64;
const int DF_ATLAS_BRICKS_Y = 64;
// Per asset in the asset buffer (vec4s): a header, then three per mip (UE DF_ASSET_DATA_MIP_STRIDE).
const int DF_ASSET_MIP_STRIDE = 3;
const int DF_ASSET_STRIDE     = 1 + DF_ASSET_MIP_STRIDE * DF_NUM_MIPS;
// Per object in the object buffer (vec4s): world -> volume (three affine rows), the volume extent with the
// volume -> world distance scale (the smallest axis'), the asset index with each volume axis' own volume -> world
// scale (the box distance, exact under a non-uniform scale), the world box's minimum and maximum corners (xyz, cm;
// UE FDFObjectBounds - the near field's cull), the object's flags (UE FDFObjectData's flags) last.
const int DF_OBJECT_STRIDE = 8;
const int DF_OBJECT_ROW_BOUNDS_MIN = 5;
const int DF_OBJECT_ROW_BOUNDS_MAX = 6;
// Flag bits of the object's last row (.x as uint bits): the mesh is mostly two-sided (foliage, UE bMostlyTwoSided).
const int DF_OBJECT_FLAG_MOSTLY_TWO_SIDED = 1;

// The near field a GI ray traces through the mesh distance fields before the global one (UE
// r.Lumen.TraceMeshSDFs.TraceDistance 180 cm), and the view's froxel grid of object lists a ray looks its objects up
// in by its origin (UE FLumenMeshSDFGridParameters, LumenMeshSDFCulling - culled on the GPU each frame): cells of
// DF_MESH_SDF_GRID_PIXEL_SIZE pixels, slices of view depth log2(depth * LOG_Z_SCALE + LOG_Z_OFFSET) * Z_SCALE out to
// DF_MESH_SDF_GRID_MAX_DISTANCE (UE r.Lumen.DiffuseIndirect.CullGridPixelSize 64,
// CullGridDistributionLogZScale .01, LogZOffset 1, ZScale 4, CardTraceEndDistanceFromCamera 40 m - no mesh field is
// traced from farther), each cell listing every object within the trace distance of it - no cap; the lists are
// compacted into one buffer whose first frame holds DF_MESH_SDF_GRID_INITIAL_OBJECTS_PER_CELL entries per cell and
// grows to what the GPU reports it needed (GlobalDistanceField::ReadNearFieldFeedback; a frame that needed more
// than it had is refused and logged, never cut short).
// A near-field ray leaves its surface by one voxel of the finest resident mip of the objects there, at least
// DF_MESH_SDF_SURFACE_BIAS (UE's mesh-SDF trace starts a few cm off the surface; the global field's continuation
// keeps its own voxel - GIRayBias).
const float DF_MESH_SDF_TRACE_DISTANCE                = 180.0f;
const int   DF_MESH_SDF_GRID_PIXEL_SIZE               = 64;
const float DF_MESH_SDF_GRID_LOG_Z_SCALE              = 0.01f;
const float DF_MESH_SDF_GRID_LOG_Z_OFFSET             = 1.0f;
const float DF_MESH_SDF_GRID_Z_SCALE                  = 4.0f;
const float DF_MESH_SDF_GRID_MAX_DISTANCE             = 4000.0f;
const int   DF_MESH_SDF_GRID_INITIAL_OBJECTS_PER_CELL = 32;
const float DF_MESH_SDF_SURFACE_BIAS                  = 4.0f;

// The global distance field (UE GlobalDistanceField.cpp: four clipmaps of 128^3, Lumen's 25 m first extent
// doubling per level, an influence range of four voxels).
const int   GDF_NUM_CLIPMAPS                = 4;
const int   GDF_RESOLUTION                  = 128;
const int   GDF_UPDATE_BRICK                = 8;   // the update granularity, voxels per side
const float GDF_CLIPMAP0_EXTENT             = 2500.0f; // half-size of clipmap 0, centimetres
const float GDF_INFLUENCE_RANGE_IN_VOXELS   = 4.0f;

#endif
