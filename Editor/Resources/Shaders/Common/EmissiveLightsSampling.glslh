#ifndef DESERT_EMISSIVE_LIGHTS_SAMPLING_GLSLH
#define DESERT_EMISSIVE_LIGHTS_SAMPLING_GLSLH

// Sampling the scene's emissive triangles (Common/EmissiveLights.glslh): the consumer has declared the seven buffers
// (emissiveSegments, emissiveTriangles, emissivePower, emissiveDynamicSegments, emissiveDynamicTriangles,
// emissiveDynamicPower, emissiveLookup) before including this header. Every function takes the two parts' params
// (RayTracing::EmissiveLightsFrame::StaticParams / DynamicParams): @p s = (static triangles, leaves, levels, TLAS
// instances of the lookup), @p d = (dynamic triangles, leaves, levels, 0). A triangle index below s.x is static,
// the rest are dynamic (index - s.x).
//
// THE CONTRACT OF GI-TEMPORAL2 (written by the architect; no package edits this file).
// ONE SELECTION SOURCE. Two distributions over the same triangles, both exact:
//   global  EmissiveLightsPick / EmissiveLightsPickPdf: a triangle by its power over the whole list. The path
//           tracer's (the reference renderer keeps the estimator its reference frames were shot with).
//   grid    EmissiveGridPick / EmissiveGridPickPdf: a triangle for a receiver in a world cell (the surface cache's
//           emissive layer, MegaLights, the world radiance cache). A cell holds kEmissiveGridSlots slots: clusters
//           (one node of a part's power tree at the cluster level = a run of triangles) with the probability the
//           cell gives each, and one REMAINDER slot (cluster kEmissiveNone) = the global distribution. The pdf of a
//           triangle is the mixture  sum over the cell's slots naming its cluster of
//           slot weight x power / cluster power  +  remainder weight x global pdf;  the remainder weight is never
//           below kEmissiveGridRemainderMin, so every triangle with power has a positive pdf in every cell and the
//           estimate needs no clamp. The grid is built by EmissiveLightsRenderer ("EmissiveLights: Grid"), is
//           deterministic, and is rebuilt only when the list it was built from moved.
// ONE RADIANCE. EmissiveLightsRadiance is what a listed triangle emits for every consumer that does not evaluate
// the material at the hit: the triangle's average of the material emission the path tracer reads at a point.
//
// A grid consumer declares an EIGHTH buffer and defines EMISSIVE_LIGHTS_GRID before including this header:
//   ReadBuffer(n) EmissiveGridUB { vec4 emissiveGrid[]; };      // RayTracing::EmissiveLightsFrame::Grid
// Rows of emissiveGrid:
//   [0] xyz = world position of the grid's minimum corner (cm)
//   [1] xyz = one cell's size per axis (cm, > 0)
//   [2] xyz = cells per axis (floatBitsToUint, each >= 1), w = cluster level of the static part (floatBitsToUint)
//   [3] x = cluster level of the dynamic part, y = clusters of the static part (floatBitsToUint both)
//   [kEmissiveGridHeaderRows + cell * kEmissiveGridSlots / 2 + slot / 2], .xy for an even slot, .zw for an odd one:
//       x = cluster (floatBitsToUint; kEmissiveNone = the remainder), y = the slot's upper bound in the cell's CDF.
//   The bounds do not decrease along the slots; the last slot's bound is 1; a slot of zero width is never picked.
//   Pick and pdf read the slots through one walk (EmissiveGridSlotRange), which holds those three to the rows.
//   A cluster is named by at most one slot of a cell. Cluster k < [3].y is node k of the static tree's level [2].w;
//   the others are node k - [3].y of the dynamic tree's level [3].x. An empty list has one cell: the remainder.

#include <Common/EmissiveLights.glslh>

const uint  kEmissiveGridHeaderRows   = 4u;
const uint  kEmissiveGridSlots        = 16u;
// Cells per axis at most, and the cluster level asked for (a part with fewer levels uses its root).
const uint  kEmissiveGridMaxCells     = 32u;
const uint  kEmissiveGridClusterLevel = 4u;
// The least weight of a cell's remainder slot.
const float kEmissiveGridRemainderMin = 0.0625;

// Node @p index of a part's power tree.
float EmissivePowerAt(bool dynamicPart, uint index)
{
    return dynamicPart ? emissiveDynamicPower[index] : emissivePower[index];
}

// A part's total power (its tree's root).
float EmissiveLightsPartTotal(bool dynamicPart, uvec4 part)
{
    return EmissivePowerAt(dynamicPart, EmissivePowerLevelOffset(part.y, part.z - 1u));
}

// The total power of the list (the common root over the two parts); 0 = no emissive triangle.
float EmissiveLightsTotal(uvec4 s, uvec4 d)
{
    return EmissiveLightsPartTotal(false, s) + EmissiveLightsPartTotal(true, d);
}

// The emissive triangles of both parts.
uint EmissiveLightsTriangleCount(uvec4 s, uvec4 d)
{
    return s.x + d.x;
}

// The probability the GLOBAL sampler picks @p triangle.
float EmissiveLightsPickPdf(uint triangle, uvec4 s, uvec4 d)
{
    const float total = EmissiveLightsTotal(s, d);
    if (total <= 0.0)
        return 0.0;
    const bool dynamicPart = triangle >= s.x;
    return EmissivePowerAt(dynamicPart, dynamicPart ? triangle - s.x : triangle) / total;
}

// One leaf under node @p node of level @p level of a part's tree, in proportion to its power; @p u in [0, 1).
uint EmissiveLightsDescendFrom(bool dynamicPart, uvec4 part, uint node, uint level, float u)
{
    for (; level > 0u; --level)
    {
        const uint  below = EmissivePowerLevelOffset(part.y, level - 1u) + 2u * node;
        const float left  = EmissivePowerAt(dynamicPart, below);
        const float sum   = left + EmissivePowerAt(dynamicPart, below + 1u);
        const float p     = sum > 0.0 ? left / sum : 1.0;
        if (u < p)
        {
            u    = u / p;
            node = 2u * node;
        }
        else
        {
            u    = (u - p) / (1.0 - p);
            node = 2u * node + 1u;
        }
        u = min(u, 0.99999994);
    }
    return node;
}

// One leaf of a part's tree in proportion to its power, by descending from the root; @p u in [0, 1).
uint EmissiveLightsDescend(bool dynamicPart, uvec4 part, float u)
{
    return EmissiveLightsDescendFrom(dynamicPart, part, 0u, part.z - 1u, u);
}

// GLOBAL: one triangle in proportion to its power: the part by the two roots, then down that part's tree. @p u in
// [0, 1) is consumed. The total must be > 0.
uint EmissiveLightsPick(float u, uvec4 s, uvec4 d)
{
    const float staticTotal = EmissiveLightsPartTotal(false, s);
    const float pStatic     = staticTotal / (staticTotal + EmissiveLightsPartTotal(true, d));
    if (u < pStatic)
        return EmissiveLightsDescend(false, s, min(u / pStatic, 0.99999994));
    return s.x + EmissiveLightsDescend(true, d, min((u - pStatic) / (1.0 - pStatic), 0.99999994));
}

// The row of @p triangle (an index of either part).
EmissiveTriangle EmissiveLightsTriangle(uint triangle, uvec4 s)
{
    return triangle < s.x ? emissiveTriangles[triangle] : emissiveDynamicTriangles[triangle - s.x];
}

// The radiance @p triangle (row @p t) emits: the rgb "EmissiveLights: Build" stored in the row's Edge2Segment.w
// (EmissivePackRadiance: the material's colour x intensity times the emissive map's rgb average over the triangle;
// its power is that rgb's luminance x area). The one value for the surface cache, MegaLights and the radiance
// cache. @p triangle and @p s name the row's part for every reader of the list; the row alone holds the value.
vec3 EmissiveLightsRadiance(uint triangle, EmissiveTriangle t, uvec4 s)
{
    const uint packed = floatBitsToUint(t.Edge2Segment.w);
    const uint biased = packed >> 24u;
    if (biased == 0u)
        return vec3(0.0);
    const vec3 mantissa = vec3(uvec3(packed, packed >> 8u, packed >> 16u) & uvec3(0xFFu));
    return mantissa * exp2(float(int(biased) - 136));
}

// The list's triangle a hit met (gl_InstanceID, gl_GeometryIndexEXT, gl_PrimitiveID of the hit), or kEmissiveNone
// when that segment is not in the list.
uint EmissiveLightsTriangleOfHit(uint instance, uint geometry, uint primitive, uvec4 s)
{
    if (instance >= s.w)
        return kEmissiveNone;
    const uint base = emissiveLookup[instance];
    if (base == kEmissiveNone)
        return kEmissiveNone;
    const uint slot = emissiveLookup[base + geometry];
    if (slot == kEmissiveNone)
        return kEmissiveNone;
    if ((slot & kEmissiveDynamicSegmentBit) != 0u)
    {
        const uint row = slot & ~kEmissiveDynamicSegmentBit;
        if (primitive >= emissiveDynamicSegments[row].TriangleCount)
            return kEmissiveNone;
        return s.x + emissiveDynamicSegments[row].FirstTriangle + primitive;
    }
    if (primitive >= emissiveSegments[slot].TriangleCount)
        return kEmissiveNone;
    return emissiveSegments[slot].FirstTriangle + primitive;
}

// A point uniformly distributed over the triangle's area (Shirley's square-root map).
vec3 EmissiveLightsSamplePoint(EmissiveTriangle t, vec2 u)
{
    const float r = sqrt(u.x);
    return t.P0Area.xyz + t.Edge1Power.xyz * (r * (1.0 - u.y)) + t.Edge2Segment.xyz * (r * u.y);
}

// The unit geometric normal of the triangle (its winding's side; emission is two-sided, consumers take |cos|).
vec3 EmissiveLightsNormal(EmissiveTriangle t)
{
    return normalize(cross(t.Edge1Power.xyz, t.Edge2Segment.xyz));
}

// The solid-angle density of a point on triangle @p t seen from @p distance along a direction whose cosine with the
// triangle's normal is @p cosLight, given the probability @p pickPdf the sampler picked it: area pdf 1 / A turned
// into solid angle by d^2 / |cos|.
float EmissiveLightsSolidAnglePdf(EmissiveTriangle t, float pickPdf, float distance, float cosLight)
{
    const float c = abs(cosLight);
    if (c <= 0.0 || t.P0Area.w <= 0.0)
        return 0.0;
    return pickPdf * distance * distance / (c * t.P0Area.w);
}

#if defined(EMISSIVE_LIGHTS_GRID)
// The cell of world position @p p; a position outside the grid takes the nearest cell (its distribution is valid
// everywhere: the remainder covers the whole list).
uint EmissiveGridCell(vec3 p)
{
    const uvec3 dims = floatBitsToUint(emissiveGrid[2].xyz);
    const ivec3 c    = clamp(ivec3(floor((p - emissiveGrid[0].xyz) / emissiveGrid[1].xyz)), ivec3(0), ivec3(dims) - 1);
    return (uint(c.z) * dims.y + uint(c.y)) * dims.x + uint(c.x);
}

// Slot @p slot of @p cell: x = cluster (bits), y = upper CDF bound.
vec2 EmissiveGridSlot(uint cell, uint slot)
{
    const vec4 row = emissiveGrid[kEmissiveGridHeaderRows + cell * (kEmissiveGridSlots / 2u) + slot / 2u];
    return (slot & 1u) == 0u ? row.xy : row.zw;
}

// THE ONE WALK over a cell's slots, for the pick and its pdf alike: slot @p slot owns [@p lower, @p upper) of the
// cell's CDF, @p lower = the previous slot's @p upper (0 for slot 0). The upper is the stored bound held to
// [lower, 1], and the last slot's is 1, so the slots partition [0, 1) whatever the rows hold. Returns the cluster
// the slot names (kEmissiveNone = the remainder).
uint EmissiveGridSlotRange(uint cell, uint slot, float lower, out float upper)
{
    const vec2 entry = EmissiveGridSlot(cell, slot);
    upper            = slot + 1u == kEmissiveGridSlots ? 1.0 : clamp(entry.y, lower, 1.0);
    return floatBitsToUint(entry.x);
}

// A triangle of the cluster @p named (or of the whole list for the remainder), @p u in [0, 1) consumed.
uint EmissiveGridDescend(uint named, float u, uvec4 s, uvec4 d)
{
    const uint staticClusters = floatBitsToUint(emissiveGrid[3].y);
    if (named == kEmissiveNone)
        return EmissiveLightsPick(u, s, d);
    if (named < staticClusters)
        return EmissiveLightsDescendFrom(false, s, named, floatBitsToUint(emissiveGrid[2].w), u);
    return s.x + EmissiveLightsDescendFrom(true, d, named - staticClusters, floatBitsToUint(emissiveGrid[3].x), u);
}

// The probability the GRID sampler picks @p triangle for a receiver in @p cell (the exact mixture).
float EmissiveGridPickPdf(uint cell, uint triangle, uvec4 s, uvec4 d)
{
    const bool  dynamicPart    = triangle >= s.x;
    const uint  local          = dynamicPart ? triangle - s.x : triangle;
    const uint  level          = floatBitsToUint(dynamicPart ? emissiveGrid[3].x : emissiveGrid[2].w);
    const uint  staticClusters = floatBitsToUint(emissiveGrid[3].y);
    const uint  node           = local >> level;
    const uint  cluster        = dynamicPart ? staticClusters + node : node;
    const uvec4 part           = dynamicPart ? d : s;
    const float power          = EmissivePowerAt(dynamicPart, local);
    const float clusterPower   = EmissivePowerAt(dynamicPart, EmissivePowerLevelOffset(part.y, level) + node);
    // Every slot that can return the triangle adds its width x the triangle's share of it.
    float pdf   = 0.0;
    float lower = 0.0;
    for (uint slot = 0u; slot < kEmissiveGridSlots; ++slot)
    {
        float      upper;
        const uint named  = EmissiveGridSlotRange(cell, slot, lower, upper);
        const float width = upper - lower;
        lower             = upper;
        if (named == kEmissiveNone)
            pdf += width * EmissiveLightsPickPdf(triangle, s, d);
        else if (named == cluster && clusterPower > 0.0)
            pdf += width * power / clusterPower;
    }
    return pdf;
}

// GRID: one triangle for a receiver in @p cell; @p u in [0, 1) is consumed. Its probability is
// EmissiveGridPickPdf(cell, result, s, d). The list's total must be > 0.
uint EmissiveGridPick(uint cell, float u, uvec4 s, uvec4 d)
{
    // The slot whose [lower, upper) holds u; the slots partition [0, 1), so the last one closes the walk.
    float lower = 0.0;
    for (uint slot = 0u; slot + 1u < kEmissiveGridSlots; ++slot)
    {
        float      upper;
        const uint named = EmissiveGridSlotRange(cell, slot, lower, upper);
        if (u < upper)
            return EmissiveGridDescend(named, min((u - lower) / (upper - lower), 0.99999994), s, d);
        lower = upper;
    }
    float      upper;
    const uint named = EmissiveGridSlotRange(cell, kEmissiveGridSlots - 1u, lower, upper);
    return EmissiveGridDescend(named, min((u - lower) / max(upper - lower, 1e-30), 0.99999994), s, d);
}
#endif // EMISSIVE_LIGHTS_GRID

#endif
