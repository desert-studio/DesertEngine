// THE height-fog parameter block, byte for byte. The C++ side of this layout is Graphic::FogGpuPayload
// (Engine/Graphic/Fog/FogPayload.hpp); the two are kept in step by static_asserts on every offset there.
// A layout declared twice diverges the first time somebody inserts a field in the middle of one of them,
// and the failure is a corrupted frame with no error message — the asserts turn it into a build error.
//
// Raw `layout(std430, ...)` rather than the ReadBuffer(n) sugar, for the same reason SkyScattering.glslh
// gives: this header must also compile under plain glslc, and raw layout is the sanctioned escape for
// structural GLSL.
//
// UNITS: everything here is already in KILOMETRES and per-kilometre coefficients — PackFogParams
// converted once, on the C++ side. Nothing in this block is in world units.

#ifndef FOG_PARAMS_GLSLH
#define FOG_PARAMS_GLSLH

// The binding the fog parameter buffer is bound at. ComputePipeline::SetStorageBuffer takes the binding
// as an explicit argument and does not consult reflection, so this number and Graphic::kFogParamsBinding
// must be the same one — a mismatch lands the buffer on another descriptor, not on an error.
#define FOG_PARAMS_BINDING 1

layout(std430, binding = FOG_PARAMS_BINDING) readonly buffer FogParamsBuffer
{
    vec4 FogSun;          // xyz = TOWARD the sun (normalized), w = DirectionalInscatteringExponent
    vec4 FogDirectional;  // rgb = directional lobe colour,     w = directional start distance (km)
    vec4 FogInscattering; // rgb = fog inscattering colour,     w = 1 - FogMaxOpacity
    vec4 FogLayer0;       // x = density /km, y = height falloff /km, z = fog height (km), w = start distance (km)
    vec4 FogLayer1;       // x = density /km, y = height falloff /km, z = fog height (km), w = cutoff distance (km; 0 = off)
    vec4 FogAmbient;      // rgb = sky-ambient contribution scale, w = 1 when the distant sky light must be sampled
};

// Unpacks the block into the struct Common/HeightFog.glslh evaluates (include that first).
//
// The SKY AMBIENT is deliberately NOT unpacked here: in the physical model its value is a texel of the
// distant-sky-light image, and a sampler must not appear in this header — Inscattering below therefore
// carries only what the CPU could fold in, and the pass adds the sampled ambient to it (see
// Programs/Fog/HeightFog.shader). The alternative, passing the sampler into this function, would put a
// texture fetch in a header whose whole purpose is to describe a buffer.
HeightFogParams FogUnpackParams()
{
    HeightFogParams p;
    p.Density0            = FogLayer0.x;
    p.Falloff0            = FogLayer0.y;
    p.Height0Km           = FogLayer0.z;
    p.Density1            = FogLayer1.x;
    p.Falloff1            = FogLayer1.y;
    p.Height1Km           = FogLayer1.z;
    p.StartDistanceKm     = FogLayer0.w;
    p.CutoffDistanceKm    = FogLayer1.w;
    p.MinTransmittance    = FogInscattering.w;
    p.Inscattering        = FogInscattering.rgb;
    p.DirectionalColour   = FogDirectional.rgb;
    p.DirectionalExponent = FogSun.w;
    p.DirectionalStartKm  = FogDirectional.w;
    p.SunDirection        = FogSun.xyz;
    return p;
}

#endif // FOG_PARAMS_GLSLH
