// FOLIAGE WIND - the world-position offset of an instanced vertex (FO-7; UE: SimpleGrassWind as a WPO).
//
// ONE function for every instanced vertex stage - the forward surface, the G-buffer write and the shadow
// caster - so the shadow and the depth a plant leaves are the shadow and the depth of the plant that is
// drawn. Desert/Tests/Engine/MeshVertexPath refuses an instanced vertex stage that computes its position
// any other way. The GPU twin of Graphic::FoliageWindOffset (Engine/Graphic/InstanceWind.hpp): the same
// expressions in the same order; change one, change both, and the FrustumCulling suite holds the CPU half.
//
// windA = (dir.x, dir.z, Strength cm, Height cm), windB = (Speed Hz, Seconds, 0, 0), pushed at offset 80
// (Graphic::kInstancedWindPushOffset). Strength 0 = no offset, which every non-foliage instance pushes.
// gust = CameraUB::WindGust (CameraUB::PrevWindGust for a previous position): the scene's gust fronts at the
// instance's world point scale the sway (Common/WindGust.glslh; never past Strength).
// localAir = the scene's local wind sources at the instance's world point (Common/LocalWind.glslh LocalWindXZ
// of CameraUB::LocalWind, or of PrevLocalWind for a previous position; vec2(0) where no view block is bound):
// added to the directional wind by FoliageWindAir, so a point source bends the plant away from itself. This header reads no
// view block itself (ClusterCut includes it for the reach alone): the caller evaluates the local air.
#ifndef DESERT_FOLIAGE_WIND_GLSLH
#define DESERT_FOLIAGE_WIND_GLSLH

#include <Common/WindGust.glslh>

// The height mask FoliageWindOffset scales Strength by: the vertex's MESH-local height over Height, clamped to
// [0, 1] and squared - 0 at and below the root, 1 from Height up, never falling as the height grows.
float FoliageWindHeightMask(float localY, float height)
{
    float mask = clamp(localY / height, 0.0, 1.0);
    return mask * mask;
}

// The direction and fraction of Strength an instance sways by: the per-draw directional wind (windA.xy: unit, or
// zero when no directional source blows) plus the local sources' air, shortened to length 1 at most, so the offset
// never exceeds Strength (WindBoundsPad). No local air: the directional wind exactly. The GPU twin of
// Graphic::FoliageWindAir (Engine/Graphic/WindGust.hpp).
vec2 FoliageWindAir(vec2 directionXZ, vec2 localXZ)
{
    if (localXZ.x == 0.0 && localXZ.y == 0.0)
        return directionXZ;
    vec2  air          = directionXZ + localXZ;
    float lengthSquare = dot(air, air);
    return lengthSquare > 1.0 ? air / sqrt(lengthSquare) : air;
}

vec3 FoliageWindOffset(vec3 localPosition, vec3 instanceOrigin, vec4 windA, vec4 windB, vec4 gust, vec2 localAir)
{
    if (windA.z <= 0.0)
        return vec3(0.0);
    float mask = FoliageWindHeightMask(localPosition.y, windA.w);
    float phase  = instanceOrigin.x * 0.0123 + instanceOrigin.z * 0.0171;
    float t      = 6.2831853 * windB.x * windB.y;
    float sway   = 0.65 * sin(t + phase) + 0.35 * sin(2.3 * t + 1.7 * phase);
    float amount = windA.z * mask * (0.5 + 0.5 * sway) * WindGustScale(instanceOrigin.x, instanceOrigin.z, gust);
    vec2  air    = FoliageWindAir(vec2(windA.x, windA.y), localAir);
    return vec3(air.x, 0.0, air.y) * amount;
}

// The world position of an instanced vertex: the instance's model matrix, then the wind.
vec3 InstancedWorldPosition(mat4 model, vec3 localPosition, vec4 windA, vec4 windB, vec4 gust, vec2 localAir)
{
    return vec3(model * vec4(localPosition, 1.0)) +
           FoliageWindOffset(localPosition, vec3(model[3]), windA, windB, gust, localAir);
}

// THE WIND'S REACH over a mesh-local box whose top is at @p localTop (cm): the largest horizontal distance
// FoliageWindOffset moves a vertex of it - @p pad (the row's WindBoundsPad = Strength of a swaying row, the bound of
// the whole mesh) times the height mask at the top (the mask never falls with height, the sway term lies in [0, 1]).
// No Height (<= 0): the whole pad. What the cluster cut grows a node / cluster box by (ClusterCut.shader; UE grows
// every cluster of a WPO primitive by its one MaxWPODisplacement - here a trunk's low clusters grow by ~nothing).
float FoliageWindReach(float localTop, float height, float pad)
{
    if (!(pad > 0.0))
        return 0.0;
    if (!(height > 0.0))
        return pad;
    return pad * FoliageWindHeightMask(localTop, height);
}

#endif
