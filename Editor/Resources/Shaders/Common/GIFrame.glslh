#ifndef GI_FRAME_GLSLH
#define GI_FRAME_GLSLH

// What a GI pass knows of the frame (the view, the sun, the sky look, the global distance field's clipmaps): one
// record, uploaded once per frame by GlobalIllumination::WorldRadianceCache, declared by its passes as `giFrame`.
// std430 — must match GlobalIllumination::GIFramePayload (WorldRadianceCache.hpp). 288 bytes.
struct GIFrame {
    mat4 viewProjection;    // the jittered matrix the G-buffer was rasterised with
    mat4 invViewProjection; // its inverse
    vec4 camera;            // xyz = camera world position (cm)
    vec4 sunTravel;         // xyz = direction the sunlight travels, w = 1 when the scene has a sun
    vec4 sunRadiance;       // rgb = colour * intensity
    vec4 skyYawCosSin;      // the sky look (Graphic::SkyLookGPU)
    vec4 skyGain;
    vec4 gdfLevels[4];      // the global distance field's clipmaps (centre.xyz cm, voxel cm)
    vec4 screen;            // xy = G-buffer extent in pixels, zw = 1 / that
};

#endif // GI_FRAME_GLSLH
