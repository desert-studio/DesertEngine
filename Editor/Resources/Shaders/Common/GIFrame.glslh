#ifndef GI_FRAME_GLSLH
#define GI_FRAME_GLSLH

// What a GI pass knows of the frame (the view, the sun and atmosphere light 1, the sky look, the G-buffer
// extent): one record, uploaded once per frame by the frame's owner (SceneRenderer), declared by every GI pass
// as `giFrame`. Neutral to the tracer: what only one walk reads (the global distance field's clipmaps) is the
// tracer's own record (Common/GITracer.glslh, GlobalIllumination::TracerFrame).
// std430 — must match GlobalIllumination::GIFramePayload (GITracing.hpp). 256 bytes.
struct GIFrame {
    mat4 viewProjection;    // the jittered matrix the G-buffer was rasterised with
    mat4 invViewProjection; // its inverse
    vec4 camera;            // xyz = camera world position (cm)
    vec4 sunTravel;         // xyz = direction the sunlight travels, w = 1 when the scene has a sun
    vec4 sunRadiance;       // rgb = colour * intensity, w = 1 when it casts shadows (its CastShadows)
    // Atmosphere light 1 (UE's Atmosphere Sun Light Index 1, the moon): the scene's second directional light, which
    // every GI pass and the path tracer light as they light the sun (UE's path tracer and Lumen light every
    // directional light). Its radiance has crossed the atmosphere, as the deferred pass shades it.
    vec4 light1Travel;      // xyz = direction its light travels, w = 1 when the scene has one
    vec4 light1Radiance;    // rgb = colour * intensity, w = 1 when it casts shadows (its CastShadows)
    vec4 skyYawCosSin;      // the sky look (Graphic::SkyLookGPU)
    vec4 skyGain;
    vec4 screen;            // xy = G-buffer extent in pixels, zw = 1 / that
};

#endif // GI_FRAME_GLSLH
