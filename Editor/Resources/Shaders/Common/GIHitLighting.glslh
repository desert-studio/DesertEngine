#ifndef GI_HIT_LIGHTING_GLSLH
#define GI_HIT_LIGHTING_GLSLH

// GIHitRadiance AND GIMissRadiance (Common/GITracing.glslh) — what a GI ray brings back.
//
//   cards    FIRST, the surface cache (GI-CARD-LOOKUP; UE LumenSurfaceCacheSampling.ush, the hit read from the
//            cards: LightingFromSurfaceCache): the FinalLighting of the card texels at the hit
//            (Common/SurfaceCacheSampling.glslh — the instance table and object grid of contract B3): direct light,
//            the indirect of the radiosity slot (SurfaceCacheIndirectLighting.shader) and emissive — one fetch;
//   back     a hit behind a surface the cards captured (SURFACE_CACHE_HIT_BACK_FACE: the back of one-sided
//            geometry, inside its SDF's solid band; GI-BACKFACE-HIT): black, an occluder, as UE's surface-cache miss;
//   in place where no card holds the hit (GI_NO_MESH_CARDS: no cards built, none resident — small and far meshes
//            — or a coverage hole), or under DESERT_GI_HIT_LIGHTING_IN_PLACE (hardware only): a port of UE Lumen's
//            hit lighting (LumenHardwareRayTracingCommon.ush CalculateRayTracedLighting):
//     direct   the sun and the point/spot lights of the world light grid's cell at the hit
//              (Mesh/LightGrid.glslh LightGridWorldLightsAt), each with a visibility ray (GITraceVisibility, the
//              permutation's tracer) leaving the hit by the tracer's GIRayBias; Lambert for a guessed material,
//              the hit's own shading model for a closest-hit material (GIHitLightResponse: the generated dispatch
//              the deferred composite calls, so ClearCoat, Cloth, Anisotropic... light as in the raster, UE's
//              hit lighting evaluating the hit's BxDF);
//     global   a global-field hit (GIHit.globalField: the software far field's coarse surface) only by the sun and
//              the moon, one global-field visibility test each (GIHitRadianceGlobalField) - no local light, no
//              per-light ray from a far hit, as UE's TraceVoxels fires no shadow ray from a global-SDF hit;
//     bounce   the radiance cache's irradiance at the hit from the previous update (RadianceCacheIrradianceAt):
//              every frame adds a bounce, as UE's radiance cache feedback does;
//     material the hit's albedo and emissive from the G-buffer when the hit is the surface the view sees at its
//              pixel (the screen holds the material), otherwise GI_HIT_ALBEDO_OFF_SCREEN and no emissive — a
//              distance-field hit carries no material;
//   miss     the sky in the ray's direction: the scene environment's radiance cube (mip 0) through the sky look.
//
// The includer declares, before including this file: the GI frame record `giFrame` (Common/GIFrame.glslh), the point and
// spot rows (`pointLights[]`, `spotLights[]`), the world light grid (`lightGrid` + LIGHT_GRID_WORLD_CELLS, read
// section included), the radiance cache read (Common/RadianceCache.glslh, read section included), samplers
// EnvironmentSpecularTexture, GBufferDepthTexture, GBufferATexture, GBufferEmissiveTexture, includes the tracer (Common/GITracer.glslh),
// and defines GI_SURFACE_CACHE_BINDING (the surface cache's seven bindings). Nothing here knows which tracer that is.

#include <Common/SkyLook.glslh>
#include <Common/ReconstructPosition.glslh>
#include <Common/GIFrame.glslh>
#if !defined( DESERT_GI_HIT_LIGHTING_IN_PLACE )
#include <Common/SurfaceCacheSampling.glslh>
#endif
// Both lighting paths answer a hit with the direct-light BRDF (GIHitLightResponse), the in-place one included.
#include <Mesh/BRDF.glslh>
#include <Mesh/DirectLighting.glslh>
// Where a local light's visibility ray stops: on its emitter sphere (LightSourceSphereAxisReach).
#include <Common/LightSourceSampling.glslh>
// The payload, and through it the roughness floor (kDesertMinRoughness) a hit's own material is lit with.
#include <Common/RayTracingPayload.glslh>
// The shading models' direct-light dispatch and the shading word's decode: a closest-hit material is lit by its
// own model (GIHitLightResponse), the word the hit group packed (DesertRayPayload.ShadingWord).
#include <Generated/ShadingModels.glslh>

// The albedo of a hit the view does not see and no card holds (no material on a distance-field surface):
// photographic middle grey, 0.18 linear.
#define GI_HIT_ALBEDO_OFF_SCREEN 0.18

void GIHitMaterial( GIHit hit, vec3 rayDirection, out vec3 albedo, out vec3 emissive )
{
    albedo   = vec3( GI_HIT_ALBEDO_OFF_SCREEN );
    emissive = vec3( 0.0 );
    const vec4 clip = giFrame.viewProjection * vec4( hit.position, 1.0 );
    if ( clip.w <= 0.0 )
        return;
    const vec2 ndc = clip.xy / clip.w;
    if ( any( greaterThan( abs( ndc ), vec2( 1.0 ) ) ) )
        return;
    const vec2  uv    = vec2( ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5 );
    const float depth = textureLod( GBufferDepthTexture, uv, 0.0 ).r;
    const vec3  seen  = ReconstructWorldPosition( uv, depth, giFrame.invViewProjection );
    // The pixel's surface counts as the hit within the tracer's tolerance.
    if ( distance( seen, hit.position ) > GIRayBias( hit.position, hit.normal, rayDirection ).screenTolerance )
        return;
    albedo   = textureLod( GBufferATexture, uv, 0.0 ).rgb;
#if defined( GI_HIT_EXCLUDES_EMISSION )
    // The includer counts the emitter -> origin path by light sampling (Common/SurfaceCacheSampling.glslh).
    emissive = vec3( 0.0 );
#else
    emissive = textureLod( GBufferEmissiveTexture, uv, 0.0 ).rgb;
#endif
}

vec3 GIMissRadiance( vec3 rayDirection )
{
    return ApplySkyGain( textureLod( EnvironmentSpecularTexture, SkyLookDirection( rayDirection, giFrame.skyYawCosSin.xy ), 0.0 ).rgb,
                         giFrame.skyGain.rgb );
}

// The material a hit is lit with. Specular = false: a diffuse-only surface (GIHitMaterial's guess, which knows no
// roughness and no model; ShadingWord unread); true: the hit's own material from a closest-hit shader, lit by its
// shading model, which ShadingWord carries with its payload and Specular (DesertRayPayload.ShadingWord).
struct GIHitSurface
{
    vec3  BaseColor;
    float Metallic;
    float Roughness;
    vec3  Emissive;
    bool  Specular;
    uvec2 ShadingWord;
};

vec3 GIHitRadianceLit( GIHit hit, vec3 rayDirection, GIHitSurface surface );
vec3 GIHitRadianceGlobalField( GIHit hit, vec3 rayDirection, GIHitSurface surface );
vec3 GIHitLightResponse( GIHitSurface surface, vec3 P, vec3 N, vec3 V, vec3 L, vec3 radiance );

// GIHitRadiance in two halves, for a consumer that lights the global-field hits no card holds in a pass of its
// own (ScreenProbeTrace.shader SP_TRACE_HIT_LIGHTING; UE runs hit lighting as its own compacted pass): false with
// @p radiance when the cards answer the hit or the full in-place path lit it; true, @p radiance unset, for a
// global-field hit no card holds - GIHitRadianceGlobalFieldInPlace lights it, here or in that pass.
bool GIHitRadianceNeedsGlobalFieldInPlace( GIHit hit, vec3 rayDirection, out vec3 radiance )
{
    radiance = vec3( 0.0 );
#if !defined( DESERT_GI_HIT_LIGHTING_IN_PLACE )
    {
        const uint cards = SurfaceCacheHitLighting( hit, GIHitSurfaceCacheBias( hit ), radiance );
        // The back of one-sided geometry: an occluder that sends nothing back (UE: a surface-cache miss there has
        // no weight and no radiance). Lighting it in place would light the room from an underside nobody modelled.
        if ( cards != SURFACE_CACHE_HIT_UNCOVERED )
            return false;
    }
#endif
    // A global-field hit no card holds (terrain, far meshes without cards): UE's TraceVoxels never fires a shadow
    // ray from a global-SDF hit. It is lit from the directional lights, one coarse visibility test each.
    if ( hit.globalField )
        return true;
    vec3 albedo;
    vec3 emissive;
    GIHitMaterial( hit, rayDirection, albedo, emissive );
    radiance = GIHitRadianceLit( hit, rayDirection,
                                 GIHitSurface( albedo, 0.0, 1.0, emissive, false, uvec2( 0u ) ) );
    return false;
}

// The in-place lighting of a global-field hit no card holds (GIHitRadianceNeedsGlobalFieldInPlace said so).
vec3 GIHitRadianceGlobalFieldInPlace( GIHit hit, vec3 rayDirection )
{
    vec3 albedo;
    vec3 emissive;
    GIHitMaterial( hit, rayDirection, albedo, emissive );
    return GIHitRadianceGlobalField( hit, rayDirection,
                                     GIHitSurface( albedo, 0.0, 1.0, emissive, false, uvec2( 0u ) ) );
}

vec3 GIHitRadiance( GIHit hit, vec3 rayDirection )
{
    vec3 radiance;
    if ( !GIHitRadianceNeedsGlobalFieldInPlace( hit, rayDirection, radiance ) )
        return radiance;
    return GIHitRadianceGlobalFieldInPlace( hit, rayDirection );
}

// The response of the directional light of travel @p travel (w > 0.5: on) and radiance @p radiance (w > 0.5: casts
// shadows) at a hit, the shadow from ONE visibility test through the global field (GITraceVisibilityGlobalField).
vec3 GIHitDirectionalGlobalField( GIHitSurface surface, vec3 N, vec3 V, vec3 origin, GITraceBias bias, vec4 travel,
                                  vec4 radiance )
{
    if ( travel.w <= 0.5 )
        return vec3( 0.0 );
    const vec3 L = -travel.xyz;
    if ( dot( N, L ) <= 0.0 )
        return vec3( 0.0 );
    float visibility = 1.0;
    if ( radiance.w > 0.5 )
        visibility = GITraceVisibilityGlobalField( origin, L, GIFarFieldTMin( bias, N, L ), 1.0e6 );
    return GIHitLightResponse( surface, origin, N, V, L, radiance.rgb * visibility );
}

// The in-place lighting of a global-field hit no card holds (GIHit.globalField): the coarse field's surface, with
// no material but GIHitMaterial's guess. UE lights such a hit only from what the cards already hold; here the
// directional lights (the sun and the moon) light it, each shadowed by one global-field test, plus the radiance
// cache's bounce and the emissive - and NO local light, NO near-field ray: a per-light secondary ray from every
// far hit (GIHitRadianceLit) is the cost UE's design never pays (GPU-FARFIELD-2). Local lights reach such a hit
// through the radiance cache's bounce only.
vec3 GIHitRadianceGlobalField( GIHit hit, vec3 rayDirection, GIHitSurface surface )
{
    const vec3        N      = hit.normal;
    const vec3        V      = -rayDirection;
    const GITraceBias bias   = GIRayBias( hit.position, N, rayDirection );
    const vec3        origin = hit.position + N * bias.nearOffset;
    vec3 direct =
         GIHitDirectionalGlobalField( surface, N, V, origin, bias, giFrame.sunTravel, giFrame.sunRadiance );
    direct +=
         GIHitDirectionalGlobalField( surface, N, V, origin, bias, giFrame.light1Travel, giFrame.light1Radiance );
    const vec3 diffuseAlbedo = surface.BaseColor * ( 1.0 - surface.Metallic );
    const vec4 bounce        = RadianceCacheIrradianceAt( hit.position, N, -rayDirection, 0.5 );
    return direct + diffuseAlbedo * max( bounce.rgb, vec3( 0.0 ) ) + surface.Emissive;
}

// The response of @p surface to ONE analytic light of incident radiance @p radiance (shadow already applied) from
// unit direction @p L, seen along @p V at @p P. Diffuse-only: Lambert, albedo / pi; otherwise the hit's own
// shading model through the dispatch the deferred composite and the forward passes call
// (Generated/ShadingModels.glslh DesertEvaluateShadingModel), as UE's hit lighting evaluates the hit's BxDF for
// every light (LumenHardwareRayTracingCommon.ush CalculateRayTracedLighting). The visibility is already in @p
// radiance, so the light reaches the model unshadowed (Shadow = TransmissionShadow = 1); the surface is made where
// the passes make it (DesertMakeSurface: unit N and V, the roughness floor), the payload decoded from the hit's
// word.
vec3 GIHitLightResponse( GIHitSurface surface, vec3 P, vec3 N, vec3 V, vec3 L, vec3 radiance )
{
    if ( !surface.Specular )
        return surface.BaseColor * ( 1.0 / PI ) * radiance * max( dot( N, L ), 0.0 );
    const DesertSurface S = DesertMakeSurface( P, N, V, surface.BaseColor, surface.Metallic, surface.Roughness,
                                               DesertShadingWordSpecular( surface.ShadingWord ) );
    DesertLight light;
    light.L                  = L;
    light.Radiance           = radiance;
    light.Shadow             = 1.0;
    light.TransmissionShadow = 1.0;
    return DesertEvaluateShadingModel( DesertShadingModelIndex( surface.ShadingWord ), light, S,
                                       DesertUnpackPayload( surface.ShadingWord ) );
}

// The in-place lighting of a hit whose material is known: GIHitMaterial's diffuse guess above, or the hit's own
// material from a closest-hit shader (Common/SSRTrace.glslh, hit-lit reflections). Every analytic light is
// shadowed by a visibility ray (GITraceVisibility) - fired only where the light faces the surface.
vec3 GIHitRadianceLit( GIHit hit, vec3 rayDirection, GIHitSurface surface )
{
    const vec3 N = hit.normal;
    const vec3 V = -rayDirection;
    // Visibility rays leave the hit by the tracer's offsets, so they do not re-enter the surface they start on.
    const GITraceBias bias   = GIRayBias( hit.position, N, rayDirection );
    const vec3        origin = hit.position + N * bias.nearOffset;

    vec3 direct = vec3( 0.0 );
    if ( giFrame.sunTravel.w > 0.5 )
    {
        const vec3 L = -giFrame.sunTravel.xyz;
        if ( dot( N, L ) > 0.0 )
            direct += GIHitLightResponse(
                 surface, hit.position, N, V, L,
                 giFrame.sunRadiance.rgb *
                      ( giFrame.sunRadiance.w > 0.5 ? GITraceVisibility( origin, L, GIFarFieldTMin( bias, N, L ), 1.0e6 )
                                                    : 1.0 ) );
    }
    // Atmosphere light 1 (the moon), as the sun: UE's hit lighting lights every directional light. Either with
    // CastShadows off is unoccluded, as the deferred pass shades it.
    if ( giFrame.light1Travel.w > 0.5 )
    {
        const vec3 L = -giFrame.light1Travel.xyz;
        if ( dot( N, L ) > 0.0 )
            direct += GIHitLightResponse(
                 surface, hit.position, N, V, L,
                 giFrame.light1Radiance.rgb *
                      ( giFrame.light1Radiance.w > 0.5 ? GITraceVisibility( origin, L, GIFarFieldTMin( bias, N, L ), 1.0e6 )
                                                       : 1.0 ) );
    }
    const LightGridWorldRange range = LightGridWorldLightsAt( lightGrid, hit.position );
    for ( uint k = 0u; k < range.count; ++k )
    {
        const uint  index = LightGridWorldLight( range, k );
        DesertLight light;
        vec3        lightPosition;
        float       sourceRadius;
        if ( index < lightGrid.counts.x )
        {
            light         = DesertPointLightAt( pointLights[index], hit.position );
            lightPosition = pointLights[index].position;
            sourceRadius  = pointLights[index].sourceRadius;
        }
        else
        {
            light         = DesertSpotLightAt( spotLights[index - lightGrid.counts.x], hit.position );
            lightPosition = spotLights[index - lightGrid.counts.x].position;
            sourceRadius  = spotLights[index - lightGrid.counts.x].sourceRadius;
        }
        if ( dot( N, light.L ) <= 0.0 || max( light.Radiance.r, max( light.Radiance.g, light.Radiance.b ) ) <= 0.0 )
            continue;
        // The ray ends on the light's emitter sphere, not at its centre: a caster inside the emitter (the bulb of
        // its fixture) does not shadow it, as in the path tracer and the ray-traced local shadows.
        const float toLight = LightSourceSphereAxisReach( distance( lightPosition, origin ), sourceRadius );
        const vec3 toward = normalize( lightPosition - origin );
        direct += GIHitLightResponse(
             surface, hit.position, N, V, light.L,
             light.Radiance * GITraceVisibility( origin, toward, GIFarFieldTMin( bias, N, toward ), toLight ) );
    }

    // The next bounce: last update's irradiance at the hit (already / pi), on the diffuse albedo only.
    const vec3 diffuseAlbedo = surface.BaseColor * ( 1.0 - surface.Metallic );
    const vec4 bounce        = RadianceCacheIrradianceAt( hit.position, N, -rayDirection, 0.5 );
    return direct + diffuseAlbedo * max( bounce.rgb, vec3( 0.0 ) ) + surface.Emissive;
}

#endif // GI_HIT_LIGHTING_GLSLH
