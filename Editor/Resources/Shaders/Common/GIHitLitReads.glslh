#ifndef DESERT_GI_HIT_LIT_READS_GLSLH
#define DESERT_GI_HIT_LIT_READS_GLSLH

// THE READS OF A HIT LIT BY Common/GIHitLighting.glslh (System::SSRRenderer::TracedReads, bound by
// SSRRenderer::DeclareTracedReads): the GI frame record, the lights and the world light grid, the radiance cache's read
// (a neutral one, covering nothing, when the GI does not run it), the sky, the G-buffer's material (its shading word in
// set 1), then the tracer (23..33). The one list of these slots: Common/SSRTrace.glslh and
// Programs/Translucency/RayTracedTranslucency.shader include it. The includer declares LinearClampSampler,
// PointClampSampler and GBufferDepthTexture before this file and includes Common/GIHitLighting.glslh after it (with
// whatever it binds between: SSRTrace.glslh's surface cache and cascades).
#include <Generated/SceneBindings.glslh> // kSsrFrontLayerSet / kSsrShadingWordBinding: set 1's shading word slot
#include <Common/GIFrame.glslh>
#include <Common/RadianceCache.glslh>
#include <Mesh/LightSources.glslh>
#include <Mesh/LightGrid.glslh>
layout(std430, binding = 10) readonly buffer GIFrameUB
{
	GIFrame giFrame;
};
#define POINT_LIGHTS_UB_BINDING 11
#include <Mesh/PointLightsUB.glslh>
#define SPOT_LIGHTS_UB_BINDING 12
#include <Mesh/SpotLightsUB.glslh>
layout(std430, binding = 13) readonly buffer LightGridParamsUB
{
	LightGridParams lightGrid;
};
layout(std430, binding = 14) readonly buffer LightGridWorldCellsUB
{
	uint lightGridWorldCells[];
};
#define LIGHT_GRID_WORLD_CELLS lightGridWorldCells
#include <Mesh/LightGrid.glslh>
layout(std430, binding = 15) readonly buffer RadianceCacheParamsUB
{
	RadianceCacheParams radianceCache;
};
layout(std430, binding = 16) readonly buffer RadianceCacheIndirectionUB
{
	uint radianceCacheIndirection[];
};
layout(std430, binding = 17) readonly buffer RadianceCacheProbesUB
{
	RadianceCacheProbe radianceCacheProbes[];
};
layout(binding = 18) uniform texture2D RadianceCacheIrradianceTexture;
#define RadianceCacheIrradianceTexture sampler2D(RadianceCacheIrradianceTexture, LinearClampSampler)
layout(binding = 19) uniform texture2D RadianceCacheDepthTexture;
#define RadianceCacheDepthTexture sampler2D(RadianceCacheDepthTexture, LinearClampSampler)
layout(binding = 20) uniform textureCube EnvironmentSpecularTexture;
#define EnvironmentSpecularTexture samplerCube(EnvironmentSpecularTexture, LinearClampSampler)
layout(binding = 21) uniform texture2D GBufferATexture;
#define GBufferATexture sampler2D(GBufferATexture, PointClampSampler)
layout(binding = 22) uniform texture2D GBufferEmissiveTexture;
#define GBufferEmissiveTexture sampler2D(GBufferEmissiveTexture, PointClampSampler)
// The shading word (uint): a hit's far side and emission mark (GIHitMaterial). Set 1, the
// program's own set, beside the front layer's slots (Core::kSsrShadingWordBinding).
layout(set = kSsrFrontLayerSet, binding = kSsrShadingWordBinding) uniform utexture2D GBufferShadingWordTexture;
#define GBufferShadingWordTexture usampler2D(GBufferShadingWordTexture, PointClampSampler)
// The traced radiance probes (the radiance read, RadianceCacheRadianceAt): the software tracer's world legs end a
// rough texel's ray at the cache's minimum trace distance and read the cache past it (SSR.shader THE SOFTWARE
// TRACER'S WORLD LEGS, FPS-SSR-FAR). Slot 41: after the surface cache's 34..40, before the lists' 42..47.
layout(binding = 41) uniform texture2D RadianceCacheRadianceAtlasTexture;
#define RadianceCacheRadianceAtlasTexture sampler2D(RadianceCacheRadianceAtlasTexture, LinearClampSampler)
#define RADIANCE_CACHE_INDIRECTION radianceCacheIndirection
#define RADIANCE_CACHE_PROBES radianceCacheProbes
#define RADIANCE_CACHE_RADIANCE_ATLAS RadianceCacheRadianceAtlasTexture
#include <Common/RadianceCache.glslh>
#define GI_TRACER_BINDING 23
#include <Common/GITracer.glslh>

#endif // DESERT_GI_HIT_LIT_READS_GLSLH
