#ifndef GI_TRACE_DISTANCE_FIELD_GLSLH
#define GI_TRACE_DISTANCE_FIELD_GLSLH

// THE SOFTWARE TRACER (DESERT_GI_TRACER_SOFTWARE): GITraceRay of Common/GITracing.glslh as a march of the global
// distance field (Common/GlobalDistanceField.glslh, GLOBAL-SDF). Port of UE's global-SDF leg of Lumen software
// tracing (LumenTraceGlobalSDF / RayTraceGlobalDistanceField in GlobalDistanceFieldUtils.ush): the hit is the
// expanded surface's entry, its normal the field's gradient. UE first marches the mesh SDFs near the ray origin
// (r.Lumen.TraceMeshSDFs): the screen probes do so here too (Common/GITraceMeshSDF.glslh, before this walk); the
// radiance cache's probes and the cards' shadow rays march the global field only, as in UE.
//
// Included by Common/GITracer.glslh only, which declares u_GlobalDistanceField0..3, includes
// Common/GlobalDistanceField.glslh, and defines GI_TRACE_GDF_LEVELS as the expression of this frame's
// vec4[GDF_NUM_CLIPMAPS] clipmap parameters.

#ifndef DESERT_GI_TRACER_SOFTWARE
#error "GITraceDistanceField.glslh is the software tracer: define DESERT_GI_TRACER_SOFTWARE"
#endif

// Sphere-trace steps per ray (UE r.Lumen.TraceGlobalSDF... MaxSteps scale; the GDF debug view's count).
#define GI_GDF_MAX_STEPS 128

GITraceResult GITraceRay( GITraceInput ray )
{
    GITraceResult result;
    result.hit = false;
    const vec3 start = ray.origin + ray.direction * ray.tMin;
    // A gather ray passes foliage stochastically (UE bDitheredTransparency); a shadow ray stops on it. The dither's
    // seed is the ray itself: every consumer already jitters its rays per frame, so the noise moves with them.
    const bool  dithered = ( ray.flags & GI_TRACE_SHADOW_RAY ) == 0u;
    const uvec3 o        = floatBitsToUint( ray.origin );
    const uvec2 d        = floatBitsToUint( ray.direction.xy );
    const uint  seed     = ( o.x * 73856093u ) ^ ( o.y * 19349663u ) ^ ( o.z * 83492791u ) ^ ( d.x * 2654435761u ) ^
                      ( d.y * 2246822519u );
    const GlobalDistanceFieldHit march = TraceGlobalDistanceField( start, ray.direction, ray.tMax - ray.tMin,
                                                                   GI_GDF_MAX_STEPS, GI_TRACE_GDF_LEVELS, dithered, seed );
    if ( !march.Hit )
        return result;

    result.hit                   = true;
    result.surface.distance      = ray.tMin + march.T;
    result.surface.position      = start + ray.direction * march.T;
    result.surface.meshCards     = GI_NO_MESH_CARDS;
    result.surface.instance      = GI_NO_INSTANCE;
    result.surface.primitive     = 0u;
    result.surface.barycentrics  = vec2( 0.0 );
    result.surface.frontFace     = true;
    result.surface.normal        = -ray.direction;
    const int level = march.Level >= 0 ? march.Level : GlobalDistanceFieldLevelAt( result.surface.position, GI_TRACE_GDF_LEVELS );
    if ( level >= 0 )
    {
        const vec3 gradient = GlobalDistanceFieldGradient( level, result.surface.position, GI_TRACE_GDF_LEVELS[level].w );
        if ( dot( gradient, gradient ) > 1e-12 )
            result.surface.normal = normalize( gradient );
    }
    result.surface.frontFace = dot( result.surface.normal, ray.direction ) < 0.0;
    return result;
}

// Visibility only: 1 when nothing of the field lies between @p origin and @p maxT along @p direction.
float GITraceVisibility( vec3 origin, vec3 direction, float maxT )
{
    GITraceInput ray;
    ray.origin    = origin;
    ray.tMin      = 0.0;
    ray.direction = direction;
    ray.tMax      = maxT;
    ray.coneAngle = 0.0;
    ray.flags     = GI_TRACE_SHADOW_RAY;
    return GITraceRay( ray ).hit ? 0.0 : 1.0;
}

// The voxel of the finest clipmap holding @p position (the coarsest one's outside them all), cm.
float GITraceVoxelAt( vec3 position )
{
    const int level = GlobalDistanceFieldLevelAt( position, GI_TRACE_GDF_LEVELS );
    return level >= 0 ? GI_TRACE_GDF_LEVELS[level].w : GI_TRACE_GDF_LEVELS[GDF_NUM_CLIPMAPS - 1].w;
}

// The march stops on the EXPANDED field surface, up to half a voxel in front of the mesh: a secondary ray leaves a
// voxel out so it does not re-enter the surface it starts on, and the view's pixel surface counts as the hit within
// a voxel of it (UE's global-SDF surface bias, LumenTracingUtils.ush).
GITraceBias GIRayBias( vec3 position, vec3 normal, vec3 direction )
{
    const float voxel = GITraceVoxelAt( position );
    GITraceBias bias;
    bias.normalOffset    = voxel;
    bias.screenTolerance = voxel;
    return bias;
}

// Out of geometry along the field's gradient: up to @p clearance of free space around @p position, never more than
// @p maxOffset from it per axis (DDGI's probe relocation; four gradient steps).
vec3 GIMoveOutOfGeometry( vec3 position, float clearance, float maxOffset )
{
    vec3 p = position;
    for ( int i = 0; i < 4; ++i )
    {
        const int level = GlobalDistanceFieldLevelAt( p, GI_TRACE_GDF_LEVELS );
        if ( level < 0 )
            break;
        const float d = SampleGlobalDistanceFieldLevel( level, p, GI_TRACE_GDF_LEVELS[level].w );
        if ( d >= clearance )
            break;
        const vec3 gradient = GlobalDistanceFieldGradient( level, p, GI_TRACE_GDF_LEVELS[level].w );
        if ( dot( gradient, gradient ) < 1e-12 )
            break;
        p = position + clamp( p + normalize( gradient ) * ( clearance - d ) - position, vec3( -maxOffset ),
                              vec3( maxOffset ) );
    }
    return p;
}

// The rows of the object grid cell at @p hit (UE EvaluateGlobalDistanceFieldHit): the cell is looked up half a voxel
// off the surface along the normal, in the finest clipmap holding that point, so a thin wall's two sides read the
// cells in front of them. A slot holds the row in its low 24 bits (the distance above them only sorted the cell).
uvec4 GIHitObjectGridRows( GIHit hit )
{
    const vec3 probe = hit.position + hit.normal * ( 0.5 * GITraceVoxelAt( hit.position ) );
    const int  level = GlobalDistanceFieldLevelAt( probe, GI_TRACE_GDF_LEVELS );
    if ( level < 0 )
        return uvec4( GI_NO_INSTANCE );
    const float cellSize = float( GDF_OBJECT_GRID_CELL_VOXELS ) * GI_TRACE_GDF_LEVELS[level].w;
    const ivec3 cell     = ivec3( floor( probe / cellSize ) );
    const ivec3 wrapped  = ( ( cell % GDF_OBJECT_GRID_RESOLUTION ) + GDF_OBJECT_GRID_RESOLUTION ) %
                          GDF_OBJECT_GRID_RESOLUTION;
    const ivec3 base     = ivec3( wrapped.x * GDF_OBJECT_GRID_SLOTS, wrapped.y,
                                  level * GDF_OBJECT_GRID_RESOLUTION + wrapped.z );
    uvec4 rows;
    for ( int i = 0; i < GDF_OBJECT_GRID_SLOTS; ++i )
    {
        const uint slot = texelFetch( u_GlobalDistanceFieldObjectGrid, base + ivec3( i, 0, 0 ), 0 ).r;
        rows[i]         = slot == GI_NO_INSTANCE ? GI_NO_INSTANCE : ( slot & 0xFFFFFFu );
    }
    return rows;
}

// The grid's rows, except for a hit that knows its object (the mesh SDF near field, Common/GITraceMeshSDF.glslh):
// that row first (UE ConeTraceMeshSDFsAndInterpolateFromCards: the hit object's MeshCardsIndex), then the cell's
// others.
uvec4 GIHitInstanceRows( GIHit hit )
{
    const uvec4 cell = GIHitObjectGridRows( hit );
    if ( hit.instance == GI_NO_INSTANCE )
        return cell;
    uvec4 rows = uvec4( hit.instance, GI_NO_INSTANCE, GI_NO_INSTANCE, GI_NO_INSTANCE );
    int   next = 1;
    for ( int i = 0; i < GDF_OBJECT_GRID_SLOTS && next < 4; ++i )
        if ( cell[i] != GI_NO_INSTANCE && cell[i] != hit.instance )
            rows[next++] = cell[i];
    return rows;
}

// The surface-cache bias of a software hit (UE LumenSoftwareRayTracing.ush). A mesh SDF hit: 20 cm, UE's literal
// for the mesh SDF and heightfield hits (TraceMeshSDFs / TraceAndCalculateRayTracedLightingFromSurfaceCache) - the
// mesh field's bricks are coarser than the mesh, so its surface stands off the captured one by up to a voxel of a
// large mesh. A global-field hit: DISTANCE_FIELD_OBJECT_GRID_CARD_INTERPOLATION_RANGE_IN_VOXELS (3) x the hit
// clipmap's ClipmapVoxelExtent (half a voxel), UE GlobalDistanceFieldObjectGrid.ush.
#define GI_MESH_SDF_SURFACE_CACHE_BIAS 20.0
#define GI_GDF_CARD_INTERPOLATION_RANGE_IN_VOXELS 3.0
float GIHitSurfaceCacheBias( GIHit hit )
{
    if ( hit.instance != GI_NO_INSTANCE )
        return GI_MESH_SDF_SURFACE_CACHE_BIAS;
    return GI_GDF_CARD_INTERPOLATION_RANGE_IN_VOXELS * 0.5 * GITraceVoxelAt( hit.position );
}

#endif // GI_TRACE_DISTANCE_FIELD_GLSLH
