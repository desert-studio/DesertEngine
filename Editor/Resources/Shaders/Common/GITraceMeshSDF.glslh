#ifndef GI_TRACE_MESH_SDF_GLSLH
#define GI_TRACE_MESH_SDF_GLSLH

// THE MESH SDF NEAR FIELD of the software tracer: a ray marched through the mesh distance fields of the objects
// near its origin, before the global field takes over (UE Lumen's mesh SDF leg: LumenSoftwareRayTracing.ush
// RayTraceSingleMeshSDF / ConeTraceMeshSDFsAndInterpolateFromCards / CalculateMeshSDFDerivedData, adapted: GLSL,
// this engine's object records (Graphic/DistanceField/GlobalDistanceField, MeshSDFScene), the hit handed to the
// GI ray contract as a GIHit whose `instance` is the object's instance-table row, so GIHitRadiance reads that
// object's cards (GIHitInstanceRows) instead of the global field's object grid). A mesh SDF hit is the mesh's own
// surface at the field's resolution, where the global field's is the expanded surface of 39 cm voxels and more:
// the contact a probe sees at a wall's foot or under a chair.
//
// The includer defines GI_MESH_SDF_BINDING (the first of six bindings) and includes this file once, software tracer
// only. The object list the trace walks is the includer's (UE: the froxel grid's list; ScreenProbeTrace.shader:
// its probe's own): GITraceMeshSDFObject marches one object and keeps the nearest hit.

#ifndef DESERT_GI_TRACER_SOFTWARE
#error "GITraceMeshSDF.glslh is the software tracer's near field: define DESERT_GI_TRACER_SOFTWARE"
#endif
#ifndef GI_MESH_SDF_BINDING
#error "GITraceMeshSDF.glslh: define GI_MESH_SDF_BINDING (the first of the near field's six descriptor bindings)"
#endif

layout( binding = GI_MESH_SDF_BINDING + 0 ) uniform sampler3D u_DFBrickAtlas;
layout( std430, binding = GI_MESH_SDF_BINDING + 1 ) readonly buffer DFAssetData
{
    vec4 u_DFAssetData[];
};
layout( std430, binding = GI_MESH_SDF_BINDING + 2 ) readonly buffer DFIndirection
{
    uint u_DFIndirection[];
};
layout( std430, binding = GI_MESH_SDF_BINDING + 3 ) readonly buffer DFObjects
{
    vec4 u_DFObjects[];
};
// Per object of u_DFObjects: its instance-table row (contract B3), or GI_NO_INSTANCE when the cache has no cards.
layout( std430, binding = GI_MESH_SDF_BINDING + 4 ) readonly buffer GIMeshSDFObjectRowsUB
{
    uint giMeshSDFObjectRows[];
};
// The view-culled objects (GlobalDistanceField::AddMeshSDFReads): [0].x = the count's bits, then per object
// (world box min, the object index's bits), (world box max, 0).
layout( std430, binding = GI_MESH_SDF_BINDING + 5 ) readonly buffer GIMeshSDFCulledUB
{
    vec4 giMeshSDFCulled[];
};

#include <Common/MeshDistanceField.glslh>

uint GIMeshSDFCulledCount()
{
    return floatBitsToUint( giMeshSDFCulled[0].x );
}

// Culled entry @p i: its object index; its world box in @p boxMin / @p boxMax.
uint GIMeshSDFCulledObject( uint i, out vec3 boxMin, out vec3 boxMax )
{
    const vec4 lo = giMeshSDFCulled[1u + 2u * i];
    const vec4 hi = giMeshSDFCulled[2u + 2u * i];
    boxMin        = lo.xyz;
    boxMax        = hi.xyz;
    return floatBitsToUint( lo.w );
}

// The nearest hit so far of one ray over the objects it was marched through (UE FTraceMeshSDFResult).
struct GIMeshSDFTrace
{
    float hitDistance; // world cm along the ray; the ray's max distance while nothing was hit
    uint  hitObject;
};

// UE's LineBoxIntersect: the entry and exit of the segment start..end through the box, as fractions of it.
vec2 GIMeshSDFLineBox( vec3 start, vec3 end, vec3 boxMin, vec3 boxMax )
{
    const vec3 inv     = 1.0 / ( end - start );
    const vec3 first   = ( boxMin - start ) * inv;
    const vec3 second  = ( boxMax - start ) * inv;
    const vec3 nearest = min( first, second );
    const vec3 farthest = max( first, second );
    return clamp( vec2( max( nearest.x, max( nearest.y, nearest.z ) ), min( farthest.x, min( farthest.y, farthest.z ) ) ),
                  0.0, 1.0 );
}

// One voxel of the asset's finest resident mip in volume space (the largest axis): UE's VolumeSurfaceBias, the
// distance the surface is expanded by to find thin features.
float GIMeshSDFVolumeSurfaceBias( DFAssetMip mip )
{
    const vec3 voxel = ( 1.0 / float( DF_UNIQUE_BRICK_SIZE ) ) / mip.VolumeToIndirectionScale;
    return max( voxel.x, max( voxel.y, voxel.z ) );
}

// UE RayTraceSingleMeshSDF (SDF_TRACING_TRAVERSE_MIPS, no dithered transparency): sphere-traces object
// @p objectIndex from @p start along @p direction between @p tMin and @p tMax (world cm), mips from the finest down
// while far from the surface, and keeps the hit when it is nearer than @p trace's.
void GITraceMeshSDFObject( vec3 start, vec3 direction, float tMin, float tMax, uint objectIndex,
                           inout GIMeshSDFTrace trace )
{
    const uint base = objectIndex * uint( DF_OBJECT_STRIDE );
    const vec4 r0   = u_DFObjects[base + 0u];
    const vec4 r1   = u_DFObjects[base + 1u];
    const vec4 r2   = u_DFObjects[base + 2u];
    const vec3 extent     = u_DFObjects[base + 3u].xyz;
    const uint assetIndex = floatBitsToUint( u_DFObjects[base + 4u].x );

    // Up to the current hit (UE: plus the object's surface bias, in world units here: the march below decides).
    tMax = min( tMax, trace.hitDistance );
    if ( tMax <= tMin )
        return;
    const vec3 worldEnd    = start + direction * tMax;
    const vec3 volumeStart = vec3( dot( r0, vec4( start, 1.0 ) ), dot( r1, vec4( start, 1.0 ) ), dot( r2, vec4( start, 1.0 ) ) );
    const vec3 volumeEnd   = vec3( dot( r0, vec4( worldEnd, 1.0 ) ), dot( r1, vec4( worldEnd, 1.0 ) ), dot( r2, vec4( worldEnd, 1.0 ) ) );
    vec3        volumeDirection = volumeEnd - volumeStart;
    const float volumeMax       = length( volumeDirection );
    if ( volumeMax <= 0.0 )
        return;
    volumeDirection /= volumeMax;
    // World cm per volume unit along this ray (exact under a non-uniform scale: the ray's own stretch).
    const float worldPerVolume = tMax / volumeMax;
    vec2        times          = GIMeshSDFLineBox( volumeStart, volumeEnd, -extent, extent ) * volumeMax;
    times.x                    = max( times.x, tMin / worldPerVolume );
    if ( times.x >= times.y )
        return;

    const uint numMips = DFAssetNumMips( assetIndex );
    if ( numMips == 0u )
        return;
    const uint maxMip      = numMips - 1u;
    uint       reversedMip = maxMip; // start at the finest resident mip
    DFAssetMip mip         = LoadDFAssetMip( assetIndex, reversedMip );
    const float surfaceBias = GIMeshSDFVolumeSurfaceBias( LoadDFAssetMip( assetIndex, maxMip ) );

    const uint  kMaxSteps   = 64u;
    const float minStepSize = 1.0 / ( 16.0 * float( kMaxSteps ) );
    float       t           = times.x;
    float       maxDistance = 0.0; // UE InitialMaxDistance 0: no expansion until the ray has left the surface
    bool        hit         = false;
    uint        step        = 0u;
    for ( ; step < kMaxSteps; ++step )
    {
        float distance = SampleSparseMeshSignedDistanceField( volumeStart + volumeDirection * t, mip );
        maxDistance    = max( distance, maxDistance );
        // Expand the surface to find thin features, away from the start where it would self-occlude (UE).
        const float expand     = surfaceBias * clamp( maxDistance / ( 2.0 * surfaceBias ), 0.0, 1.0 );
        const float maxEncoded = mip.DistanceFieldToVolumeScaleBias.x + mip.DistanceFieldToVolumeScaleBias.y;
        if ( abs( distance ) > maxEncoded && reversedMip > 0u )
        {
            // Past this mip's narrow band: a coarser mip for the next step.
            --reversedMip;
            mip = LoadDFAssetMip( assetIndex, reversedMip );
        }
        else if ( abs( distance ) < 0.25 * maxEncoded && reversedMip < maxMip )
        {
            // Near the surface: step back to safety and refine.
            distance -= 6.0 * surfaceBias;
            ++reversedMip;
            mip = LoadDFAssetMip( assetIndex, reversedMip );
        }
        else if ( distance < expand && reversedMip == maxMip )
        {
            // One more step to the surface, pulled back by the expansion for a better gradient.
            t   = clamp( t + distance - expand, times.x, times.y );
            hit = true;
            break;
        }
        t += max( distance, minStepSize );
        if ( t > times.y + expand )
            break;
    }
    if ( step == kMaxSteps )
        hit = true; // UE: an exhausted march counts as a hit (over-occlusion rather than a leak)
    if ( hit )
    {
        const float worldT = t * worldPerVolume;
        if ( worldT < trace.hitDistance )
        {
            trace.hitDistance = worldT;
            trace.hitObject   = objectIndex;
        }
    }
}

// UE CalculateMeshSDFDerivedData: the hit of @p trace as the GI ray contract's GIHit - the position, the normal of
// the finest mip's gradient through the transposed world -> volume matrix (a non-uniform scale bends it), and the
// object's instance-table row as the hit's instance (GIHitInstanceRows reads that object's cards first).
GIHit GIMeshSDFHit( vec3 start, vec3 direction, float tOffset, GIMeshSDFTrace trace )
{
    const uint base = trace.hitObject * uint( DF_OBJECT_STRIDE );
    const vec4 r0   = u_DFObjects[base + 0u];
    const vec4 r1   = u_DFObjects[base + 1u];
    const vec4 r2   = u_DFObjects[base + 2u];
    const vec3 extent     = u_DFObjects[base + 3u].xyz;
    const uint assetIndex = floatBitsToUint( u_DFObjects[base + 4u].x );

    GIHit hit;
    hit.position     = start + direction * trace.hitDistance;
    hit.distance     = tOffset + trace.hitDistance;
    hit.normal       = -direction;
    hit.meshCards    = GI_NO_MESH_CARDS;
    hit.instance     = giMeshSDFObjectRows[trace.hitObject];
    hit.primitive    = 0u;
    hit.barycentrics = vec2( 0.0 );

    const vec4 p      = vec4( hit.position, 1.0 );
    const vec3 volume = clamp( vec3( dot( r0, p ), dot( r1, p ), dot( r2, p ) ), -extent, extent );
    const uint numMips = DFAssetNumMips( assetIndex );
    if ( numMips > 0u )
    {
        const DFAssetMip mip = LoadDFAssetMip( assetIndex, numMips - 1u );
        // UE CalculateMeshSDFGradient: half a voxel either side (the field's border allows no more).
        const vec3 h = 0.5 * ( 1.0 / float( DF_UNIQUE_BRICK_SIZE ) ) / mip.VolumeToIndirectionScale;
        const vec3 g = vec3( SampleSparseMeshSignedDistanceField( volume + vec3( h.x, 0.0, 0.0 ), mip ) -
                                  SampleSparseMeshSignedDistanceField( volume - vec3( h.x, 0.0, 0.0 ), mip ),
                             SampleSparseMeshSignedDistanceField( volume + vec3( 0.0, h.y, 0.0 ), mip ) -
                                  SampleSparseMeshSignedDistanceField( volume - vec3( 0.0, h.y, 0.0 ), mip ),
                             SampleSparseMeshSignedDistanceField( volume + vec3( 0.0, 0.0, h.z ), mip ) -
                                  SampleSparseMeshSignedDistanceField( volume - vec3( 0.0, 0.0, h.z ), mip ) );
        const vec3 world = g.x * r0.xyz + g.y * r1.xyz + g.z * r2.xyz;
        if ( dot( world, world ) > 1e-12 )
            hit.normal = normalize( world );
    }
    hit.frontFace = dot( hit.normal, direction ) < 0.0;
    return hit;
}

#endif // GI_TRACE_MESH_SDF_GLSLH
