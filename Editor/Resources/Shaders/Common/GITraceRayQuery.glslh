#ifndef GI_TRACE_RAY_QUERY_GLSLH
#define GI_TRACE_RAY_QUERY_GLSLH

// THE HARDWARE GI TRACER (DESERT_GI_TRACER_HARDWARE): GITraceRay, GITraceVisibility, GIRayBias and
// GIMoveOutOfGeometry of the GI ray contract (Common/GITracing.glslh) as inline rayQueryEXT over the view's TLAS.
// Follows UE 5.8 Lumen/LumenHardwareRayTracingCommon.ush (the inline TraceLumenHardwareRay path, hit read from the
// surface cache) and LumenScreenProbeHardwareRayTracing.usf (the ray's TMin and normal bias), adapted: GLSL ray
// query instead of an HLSL RayQuery, the hit normal interpolated from the vertex buffers through the RT-SHADOWS
// geometry records (UE FRayTracingSceneMetadata), the mesh cards through the surface cache's per-instance table
// instead of GPUScene's GetMeshCardsIndexFromSceneInstanceIndex. C++ side: GlobalIllumination::TracerFrame and
// DeclareTracerReads (Graphic/GlobalIllumination/GITracing.hpp).
//
// Included by Common/GITracer.glslh only, which declares the TLAS and the record blocks (through
// Common/RayQueryVisibility.glslh, the ONE hardware visibility walk and the ONE vertex fetch by device address) and
// the u_GIInstanceMeshCards table, then includes this file.

#ifndef DESERT_GI_TRACER_HARDWARE
#error "GITraceRayQuery.glslh is the hardware tracer: include it only under DESERT_GI_TRACER_HARDWARE"
#endif

// UE r.Lumen.ScreenProbeGather.HardwareRayTracing.Bias / .NormalBias (both 0.1, UE units = cm): the ray starts this
// far off the surface along its normal, and skips this much along its direction, so it does not re-hit the triangle
// it leaves where the traced triangles differ from the G-buffer's surface.
const float kGIHardwareRayBiasCm    = 0.1;
const float kGIHardwareNormalBiasCm = 0.1;

// THE surface cache's MeshCards index of TLAS instance @p customIndex (RayTracingInstance::CustomIndex = the
// instance's scene row; one TLAS instance per mesh instance, DECISIONS-1015 S4), or GI_NO_MESH_CARDS. The table is
// GI-SURFACE-CACHE's (B3: one uint per custom index, GI_NO_MESH_CARDS where the instance has no cards); this is the
// one place the tracer reads it.
uint GIMeshCardsForInstance( uint customIndex )
{
    return customIndex < uint( u_GIInstanceMeshCards.length() ) ? u_GIInstanceMeshCards[customIndex]
                                                                : GI_NO_MESH_CARDS;
}

// Three consecutive floats of the segment's vertex @p vertex at @p byteOffset (RayQueryVisibility.glslh's fetch).
vec3 GIHardwareVertexVec3( RayTracingGeometryRecord record, uint vertex, uint byteOffset )
{
    const uvec2 base = RayQueryAddressAdd( record.VertexAddress, vertex * record.VertexStride + byteOffset );
    return uintBitsToFloat( uvec3( RayQueryUintRef( base ).Value, RayQueryUintRef( RayQueryAddressAdd( base, 4u ) ).Value,
                                   RayQueryUintRef( RayQueryAddressAdd( base, 8u ) ).Value ) );
}

// The interpolated object-space normal of @p primitive of geometry record @p recordIndex at @p barycentrics (the
// ray query's: weights of vertices 1 and 2). A segment without a normal stream gives the triangle's face normal.
vec3 GIHardwareObjectNormal( uint recordIndex, uint primitive, vec2 barycentrics )
{
    const RayTracingGeometryRecord record = u_RayTracingGeometry[recordIndex];
    uvec3                          corner;
    for ( uint i = 0u; i < 3u; ++i )
    {
        const uint indexByte = ( record.FirstIndex + primitive * 3u + i ) * 4u;
        corner[i] = RayQueryUintRef( RayQueryAddressAdd( record.IndexAddress, indexByte ) ).Value + record.FirstVertex;
    }
    if ( record.NormalOffset == kRayTracingNoRecord )
    {
        // Position offset 0: RayTracingGeometrySegment::PositionOffset of every engine vertex (Desert::Vertex).
        const vec3 p0 = GIHardwareVertexVec3( record, corner.x, 0u );
        const vec3 p1 = GIHardwareVertexVec3( record, corner.y, 0u );
        const vec3 p2 = GIHardwareVertexVec3( record, corner.z, 0u );
        return cross( p1 - p0, p2 - p0 );
    }
    const vec3 weights = vec3( 1.0 - barycentrics.x - barycentrics.y, barycentrics.x, barycentrics.y );
    return GIHardwareVertexVec3( record, corner.x, record.NormalOffset ) * weights.x +
           GIHardwareVertexVec3( record, corner.y, record.NormalOffset ) * weights.y +
           GIHardwareVertexVec3( record, corner.z, record.NormalOffset ) * weights.z;
}

// The walk with the alpha test of masked segments (only they come back as candidates): returns the query, committed.
#define GI_HARDWARE_WALK( query, flags, cullMask, origin, tMin, direction, tMax )                                     \
    rayQueryInitializeEXT( query, u_SceneTLAS, flags, ( cullMask ) & 0xFFu, origin, tMin, direction, tMax );         \
    while ( rayQueryProceedEXT( query ) )                                                                              \
    {                                                                                                                  \
        if ( rayQueryGetIntersectionTypeEXT( query, false ) == gl_RayQueryCandidateIntersectionTriangleEXT &&        \
             RayQueryCandidateBlocks( query ) )                                                                        \
            rayQueryConfirmIntersectionEXT( query );                                                                   \
    }

GITraceResult GITraceRay( GITraceInput ray )
{
    const bool shadowRay = ( ray.flags & GI_TRACE_SHADOW_RAY ) != 0u;
    const uint flags     = shadowRay ? gl_RayFlagsTerminateOnFirstHitEXT : gl_RayFlagsNoneEXT;
    const uint cullMask  = shadowRay ? RAY_TRACING_MASK_SHADOW_CASTER : RAY_TRACING_MASK_OPAQUE;

    rayQueryEXT query;
    GI_HARDWARE_WALK( query, flags, cullMask, ray.origin, ray.tMin, ray.direction, ray.tMax )

    GITraceResult result;
    result.hit = rayQueryGetIntersectionTypeEXT( query, true ) == gl_RayQueryCommittedIntersectionTriangleEXT;
    if ( !result.hit )
        return result;

    const uint record = rayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT( query, true ) +
                        uint( rayQueryGetIntersectionGeometryIndexEXT( query, true ) );
    const uint primitive    = uint( rayQueryGetIntersectionPrimitiveIndexEXT( query, true ) );
    const vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT( query, true );
    // Object -> world for a normal: the inverse transpose, i.e. the world -> object rows applied from the left.
    const mat4x3 worldToObject = rayQueryGetIntersectionWorldToObjectEXT( query, true );
    const vec3   objectNormal  = GIHardwareObjectNormal( record, primitive, barycentrics );

    result.surface.distance     = rayQueryGetIntersectionTEXT( query, true );
    result.surface.position     = ray.origin + ray.direction * result.surface.distance;
    result.surface.normal       = normalize( objectNormal * mat3( worldToObject ) );
    result.surface.instance     = uint( rayQueryGetIntersectionInstanceCustomIndexEXT( query, true ) );
    result.surface.meshCards    = GIMeshCardsForInstance( result.surface.instance );
    result.surface.primitive    = primitive;
    result.surface.barycentrics = barycentrics;
    result.surface.frontFace    = rayQueryGetIntersectionFrontFaceEXT( query, true );
    return result;
}

// THE hardware visibility walk is RT-SHADOWS' (alpha-tested, first hit ends it); GI adds nothing to it.
float GITraceVisibility( vec3 origin, vec3 direction, float maxT )
{
    return RayQueryVisibility( origin, direction, maxT, RAY_TRACING_MASK_SHADOW_CASTER );
}

// The ray leaves the hit by UE's normal bias (the normal turned to the ray's side, so a ray leaving the back of a
// two-sided surface is pushed out of that side) plus its bias along the ray. A traced triangle IS the surface, so the
// view's pixel counts as the hit only within those two offsets (the SDF tracer needs a voxel; this one does not).
GITraceBias GIRayBias( vec3 position, vec3 normal, vec3 direction )
{
    GITraceBias bias;
    bias.normalOffset    = kGIHardwareNormalBiasCm;
    bias.screenTolerance = kGIHardwareNormalBiasCm + kGIHardwareRayBiasCm;
    return bias;
}

// Out of geometry by short ray queries along the six axes (UE Lumen's radiance-cache probe placement / DDGI probe
// relocation with hardware rays): a BACK face within @p clearance means the point is inside a mesh, and it moves
// through that face to @p clearance beyond it (the nearest such exit); otherwise every FRONT face closer than
// @p clearance pushes it away by the shortfall. The offset never exceeds @p maxOffset per axis.
vec3 GIMoveOutOfGeometry( vec3 position, float clearance, float maxOffset )
{
    const vec3 axes[6] = vec3[6]( vec3( 1, 0, 0 ), vec3( -1, 0, 0 ), vec3( 0, 1, 0 ), vec3( 0, -1, 0 ),
                                  vec3( 0, 0, 1 ), vec3( 0, 0, -1 ) );
    const float reach  = clearance + maxOffset;
    float       exitT  = reach;
    vec3        exitAt = vec3( 0.0 );
    vec3        push   = vec3( 0.0 );
    for ( int i = 0; i < 6; ++i )
    {
        rayQueryEXT query;
        GI_HARDWARE_WALK( query, gl_RayFlagsNoneEXT, 0xFFu, position, 0.0, axes[i], reach )
        if ( rayQueryGetIntersectionTypeEXT( query, true ) != gl_RayQueryCommittedIntersectionTriangleEXT )
            continue;
        const float t = rayQueryGetIntersectionTEXT( query, true );
        if ( !rayQueryGetIntersectionFrontFaceEXT( query, true ) )
        {
            if ( t < exitT )
            {
                exitT  = t;
                exitAt = axes[i] * ( t + clearance );
            }
        }
        else if ( t < clearance )
            push -= axes[i] * ( clearance - t );
    }
    const vec3 offset = exitT < reach ? exitAt : push;
    return position + clamp( offset, vec3( -maxOffset ), vec3( maxOffset ) );
}

#undef GI_HARDWARE_WALK

#endif // GI_TRACE_RAY_QUERY_GLSLH
