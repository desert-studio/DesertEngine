#ifndef GI_TRACING_GLSLH
#define GI_TRACING_GLSLH

// THE GI RAY CONTRACT: one entry for every consumer, two tracers behind it, one function that lights a hit. The
// C++ side and the design notes are Graphic/GlobalIllumination/GITracing.hpp. Ports UE Lumen's contract:
// FConeTraceInput / FConeTraceResult (LumenSoftwareRayTracing.ush, LumenTracingCommon.ush) and
// FRayTracedLightingContext / FRayTracedLightingResult (LumenHardwareRayTracingCommon.ush), reduced to what both
// tracers fill.
//
// THE FUNCTIONS — declared here, each DEFINED by exactly one include of the consumer's permutation:
//   GITraceRay         the walk. DESERT_GI_TRACER_SOFTWARE: the mesh SDFs near the origin, then the global SDF march
//                      (GLOBAL-SDF, GITraceDistanceField);
//                      DESERT_GI_TRACER_HARDWARE: rayQueryEXT over the scene TLAS (RT-SCENE, GI-HWRT).
//   GITraceNearField / GITraceFarField  the walk's two legs, for a consumer that runs them as separate passes over
//                      the rays still open (the screen probe gather, UE TraceMeshSDFs then TraceVoxels over compacted
//                      traces): GITraceRay = the near field, then on a miss the far field from its farStart.
//                      Software: the mesh SDFs of the origin's froxel / the global SDF. Hardware (one TLAS, one
//                      precision): the near field walks the whole ray (farStart = its hit, or tMax), the far field
//                      walks the same TLAS from its ray.tMin (the near field's farStart) - empty after a near miss.
//   GITraceVisibility  visibility only, 1 when nothing lies within @p maxT of @p origin along @p direction (the far
//                      field from @p farTMin on) — the shadow ray of hit lighting (and of the cards' lighting where
//                      no shadow map covers them).
//   GIRayBias          how far a secondary ray leaves a hit — TWO offsets: the near field's (nearOffset, the ray's
//                      origin) and the far field's (farOffset, which the ray must have risen to before the far
//                      field counts: GIFarFieldTMin -> GITraceInput.farTMin) — and how close the view's pixel
//                      surface must lie to count as the hit: the TRACER's own numbers (UE: the mesh-SDF and the
//                      global-SDF surface biases, the hardware tracer's RayBias for both), so the shared hit
//                      lighting below knows no distance field.
//   GIMoveOutOfGeometry  a point pushed out of nearby geometry (a radiance-cache probe before it traces).
//   GIHitInstanceRows  the instance-table rows (contract B3) the hit may belong to, nearest first, GI_NO_INSTANCE
//                      after the last: the hardware hit's own instance; for a distance-field hit, which has no
//                      object identity, the object grid cell at the hit (UE GlobalDistanceFieldPageObjectGrid).
//   GIHitSurfaceCacheBias  how far, in cm, the hit may lie from the surface the cards captured and still be read
//                      from them (UE SampleLumenMeshCards' SurfaceCacheBias): the traced surface is the field's, not
//                      the mesh's, so it is the field's precision - per hit kind, the TRACER's own number.
//   GIHitRadiance      the radiance leaving a hit towards the ray's origin — ONE function for both tracers
//                      (GIHitLighting.glslh; GI-SURFACE-CACHE): the surface cache's FinalLighting at the hit; a hit
//                      with no cards (GI_NO_MESH_CARDS — this hit only, never the whole tracer), or any hit under
//                      DESERT_GI_HIT_LIGHTING_IN_PLACE (hardware only), is lit in place: the lights of the world
//                      light grid with GITraceVisibility + emissive + albedo x the radiance cache. UE returns black
//                      outside coverage (FSurfaceCacheSample.bValid = false); here it is never black.
//   GIMissRadiance     the sky in the ray's direction (the live sky, not the baked ambient cube).
// A consumer includes Common/GITracer.glslh (the permutation's tracer) and Common/GIHitLighting.glslh, and calls
// GIRayRadiance; it never names a tracer, a distance field or an acceleration structure.
//
// THE PERMUTATION comes from C++ only (GlobalIllumination::TracerVariant of Pipeline::Tracer). A compile with no
// tracer define is the program's registered default, which the shader service compiles at load and no pass
// dispatches; it is compiled as the software walk so that it compiles at all.
#if !defined( DESERT_GI_TRACER_SOFTWARE ) && !defined( DESERT_GI_TRACER_HARDWARE )
#define DESERT_GI_TRACER_SOFTWARE 1
#endif
#if defined( DESERT_GI_TRACER_SOFTWARE ) && defined( DESERT_GI_TRACER_HARDWARE )
#error "GITracing.glslh: one tracer per permutation (DESERT_GI_TRACER_SOFTWARE or DESERT_GI_TRACER_HARDWARE)"
#endif
#if defined( DESERT_GI_HIT_LIGHTING_IN_PLACE ) && !defined( DESERT_GI_TRACER_HARDWARE )
#error "GITracing.glslh: hit lighting in place needs the hardware tracer (a distance-field hit has no material)"
#endif

#define GI_NO_INSTANCE 0xFFFFFFFFu
#define GI_NO_MESH_CARDS 0xFFFFFFFFu

// What a consumer asks (UE FConeTraceInput / the RayDesc of FRayTracedLightingContext).
struct GITraceInput {
    vec3  origin;    // world, cm
    float tMin;      // cm skipped before a hit counts (the radiance cache's probe TMin, a screen trace's end)
    vec3  direction; // unit
    float tMax;      // cm; past it the ray is a miss
    float coneAngle; // half angle, radians: the SDF march widens its step with it, the surface cache picks a mip
    uint  flags;     // GI_TRACE_* below
    float farTMin;   // cm skipped before a FAR-field hit counts: GIFarFieldTMin of the ray leaving a surface, else 0
};
#define GI_TRACE_SHADOW_RAY 1u // any hit ends the walk (visibility only)

// Where a ray stopped (the fields both tracers can fill; UE FConeTraceResult / FRayTracedLightingResult).
struct GIHit {
    vec3  position;  // world, cm
    float distance;  // along the ray, cm
    vec3  normal;    // world, unit: the SDF gradient (software) or the triangle's shading normal (hardware)
    uint  meshCards; // MeshCards index of the hit instance (Common/SurfaceCache.glslh), or GI_NO_MESH_CARDS
    uint  instance;  // instance-table row (hardware: the TLAS instance custom index; software: the mesh SDF near
                     // field's object, Common/GITraceDistanceField.glslh; a global-field hit: GI_NO_INSTANCE)
    uint  primitive; // triangle within the instance (hardware only; software: 0)
    vec2  barycentrics; // of the triangle (hardware only; software: 0)
    bool  frontFace;
    // How far, world cm, the hit point moved since last frame (UE FConeTraceResult.WorldVelocity /
    // CalcPrevTranslatedWorldPositionFromGPUSceneInstanceIndex: the hit object's previous transform), valid when
    // motionKnown: a hit that knows its object (the mesh SDF near field's). A global-field hit has no object
    // identity and no motion (UE TraceVoxels writes no moving trace).
    vec3  velocity;
    bool  motionKnown;
};

struct GITraceResult {
    bool  hit;
    GIHit surface; // valid when hit
};

// The tracer's offsets (GIRayBias).
struct GITraceBias {
    float nearOffset;      // cm a secondary ray's origin leaves the hit along its normal (the near field's precision)
    float farOffset;       // cm off the hit along its normal before the far field counts a hit (its precision)
    float screenTolerance; // cm within which the view's pixel surface counts as the hit (it holds the material)
};

GITraceResult GITraceRay( GITraceInput ray );
GITraceResult GITraceNearField( GITraceInput ray, out float farStart );
GITraceResult GITraceFarField( GITraceInput ray );
float         GITraceVisibility( vec3 origin, vec3 direction, float farTMin, float maxT );
GITraceBias   GIRayBias( vec3 position, vec3 normal, vec3 direction );
vec3          GIMoveOutOfGeometry( vec3 position, float clearance, float maxOffset );
uvec4         GIHitInstanceRows( GIHit hit );
float         GIHitSurfaceCacheBias( GIHit hit );
vec3          GIHitRadiance( GIHit hit, vec3 rayDirection );
vec3          GIMissRadiance( vec3 rayDirection );

// How far along @p direction a ray that left a surface (normal @p normal) by @p bias.nearOffset goes before it is
// @p bias.farOffset off the surface's plane: its GITraceInput.farTMin. A ray within a few degrees of the plane
// reaches it late (no far-field hit before), never early (no self-hit in the coarse field).
float GIFarFieldTMin( GITraceBias bias, vec3 normal, vec3 direction )
{
    const float rise = bias.farOffset - bias.nearOffset;
    return rise > 0.0 ? rise / max( dot( normal, direction ), 1.0e-3 ) : 0.0;
}

// THE ONE ENTRY: the radiance arriving at @p ray.origin from @p ray.direction.
vec3 GIRayRadiance( GITraceInput ray )
{
    const GITraceResult result = GITraceRay( ray );
    return result.hit ? GIHitRadiance( result.surface, ray.direction ) : GIMissRadiance( ray.direction );
}

// The same, with how far the ray went (@p ray.tMax on a miss): the radiance cache keeps it for its probes' visibility.
vec3 GIRayRadiance( GITraceInput ray, out float hitDistance )
{
    const GITraceResult result = GITraceRay( ray );
    hitDistance = result.hit ? result.surface.distance : ray.tMax;
    return result.hit ? GIHitRadiance( result.surface, ray.direction ) : GIMissRadiance( ray.direction );
}

#endif // GI_TRACING_GLSLH
