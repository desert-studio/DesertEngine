// SAMPLING AND MARCHING THE GLOBAL DISTANCE FIELD - the one GPU reading of Graphic/DistanceField/
// GlobalDistanceField's clipmaps, shared by the debug view and every software trace that will march the scene
// (GI, reflections, distance-field shadows). Ported from UE 5.8 Engine/Shaders/Private/DistanceField/
// GlobalDistanceFieldShared.ush (clipmap selection, SampleGlobalDistanceField, the gradient) and
// GlobalDistanceFieldUtils.ush (the sphere-trace loop), adapted: dense clipmaps addressed toroidally through a
// REPEAT sampler (texel = world voxel index mod resolution) instead of UE's page atlas, distances stored in
// centimetres rather than normalized by the influence radius, and the coverage (UE's coverage atlas) in the second
// channel of the same texel (RG16F).
//
// The including shader declares GlobalDistanceField0Texture..3 before including this file (separate texture3Ds, each
// with a same-name `sampler3D(texture, LinearRepeatSampler)` macro: the pass's shared repeat state), and passes
// the clipmap parameters: GDFLevel[k] = (centre.xyz world cm, voxel size cm), the C++ ClipmapUniforms().
#ifndef GLOBAL_DISTANCE_FIELD_GLSLH
#define GLOBAL_DISTANCE_FIELD_GLSLH

#include <Common/DistanceFieldShared.glslh>

float SampleGlobalDistanceFieldLevel(int level, vec3 worldPosition, float voxelSize)
{
    // World voxel g covers [g, g+1) * voxel and lives in texel g mod R, whose centre is at (g + 0.5) / R - so
    // the normalized coordinate is simply position / (voxel * R), wrapped by the sampler.
    const vec3 uvw = worldPosition / (voxelSize * float(GDF_RESOLUTION));
    if (level == 0)
        return textureLod(GlobalDistanceField0Texture, uvw, 0.0).x;
    if (level == 1)
        return textureLod(GlobalDistanceField1Texture, uvw, 0.0).x;
    if (level == 2)
        return textureLod(GlobalDistanceField2Texture, uvw, 0.0).x;
    return textureLod(GlobalDistanceField3Texture, uvw, 0.0).x;
}

// The distance (x, cm) and the coverage (y: 1 near solid geometry, 0 where only foliage or nothing is near) in one
// fetch (UE SampleGlobalDistanceFieldCoverage beside the page distance).
vec2 SampleGlobalDistanceFieldLevelCoverage(int level, vec3 worldPosition, float voxelSize)
{
    const vec3 uvw = worldPosition / (voxelSize * float(GDF_RESOLUTION));
    if (level == 0)
        return textureLod(GlobalDistanceField0Texture, uvw, 0.0).xy;
    if (level == 1)
        return textureLod(GlobalDistanceField1Texture, uvw, 0.0).xy;
    if (level == 2)
        return textureLod(GlobalDistanceField2Texture, uvw, 0.0).xy;
    return textureLod(GlobalDistanceField3Texture, uvw, 0.0).xy;
}

// The finest clipmap whose window holds @p worldPosition with a one-voxel margin (the trilinear footprint must
// not wrap onto the far side of the window), or -1 outside all of them.
int GlobalDistanceFieldLevelAt(vec3 worldPosition, vec4 levels[GDF_NUM_CLIPMAPS])
{
    for (int level = 0; level < GDF_NUM_CLIPMAPS; ++level)
    {
        const float halfExtent = levels[level].w * float(GDF_RESOLUTION) * 0.5 - levels[level].w;
        if (all(lessThan(abs(worldPosition - levels[level].xyz), vec3(halfExtent))))
            return level;
    }
    return -1;
}

// Centimetres to the nearest surface, clamped to the level's influence radius; a large value outside the field.
float SampleGlobalDistanceField(vec3 worldPosition, vec4 levels[GDF_NUM_CLIPMAPS])
{
    const int level = GlobalDistanceFieldLevelAt(worldPosition, levels);
    if (level < 0)
        return levels[GDF_NUM_CLIPMAPS - 1].w * GDF_INFLUENCE_RANGE_IN_VOXELS;
    return SampleGlobalDistanceFieldLevel(level, worldPosition, levels[level].w);
}

vec3 GlobalDistanceFieldGradient(int level, vec3 worldPosition, float voxelSize)
{
    const float h = voxelSize;
    const float dx = SampleGlobalDistanceFieldLevel(level, worldPosition + vec3(h, 0, 0), voxelSize) -
                     SampleGlobalDistanceFieldLevel(level, worldPosition - vec3(h, 0, 0), voxelSize);
    const float dy = SampleGlobalDistanceFieldLevel(level, worldPosition + vec3(0, h, 0), voxelSize) -
                     SampleGlobalDistanceFieldLevel(level, worldPosition - vec3(0, h, 0), voxelSize);
    const float dz = SampleGlobalDistanceFieldLevel(level, worldPosition + vec3(0, 0, h), voxelSize) -
                     SampleGlobalDistanceFieldLevel(level, worldPosition - vec3(0, 0, h), voxelSize);
    return vec3(dx, dy, dz);
}

struct GlobalDistanceFieldHit
{
    bool  Hit;
    float T;     // centimetres along the (normalized) ray
    int   Level; // the clipmap the hit was found in
    int   Steps;
};

// Sphere trace from @p origin along the unit @p direction until a surface, @p maxT, @p maxSteps, or the ray leaves
// the coarsest clipmap.
//
// THE SURFACE IS EXPANDED BY UP TO HALF A VOXEL (UE RayTraceGlobalDistanceField: ExpandSurfaceDistance =
// ClipmapVoxelExtent, ramped in over 2x that much ray time, bExpandSurfaceUsingRayTimeInsteadOfMaxDistance). A
// surface thinner than a voxel - a 20 cm floor in 39 cm voxels, its two neighbouring voxel centres both outside it -
// never reconstructs to a negative distance, so a test against a fixed small threshold sees through it; the
// expansion catches it. The ramp keeps a ray that starts on a surface from hitting itself.
//
// FOLIAGE IS NOT A SOLID (UE's coverage, GlobalDistanceFieldUtils.ush + Lumen's r.Lumen.TraceGlobalSDF.*). A dense
// crown of leaf cards is within half a 39 cm voxel everywhere inside, so the expanded field is one closed blob and
// every GI ray from a leaf ends a few centimetres out in the dark crown (FOLIAGE-LOOK-6: the backlit crown at 63
// of n7's 105; the expansion cut to 0.05 voxel alone gave 90). Where the coverage says no solid surface is near:
//   - the expansion is scaled by GDF_NOT_COVERED_EXPAND_SURFACE_SCALE (UE NotCoveredExpandSurfaceScale; covered
//     regions keep CoveredExpandSurfaceScale 1);
//   - with @p ditheredTransparency (a GI gather ray, UE FGlobalSDFTraceInput::bDitheredTransparency) the band is
//     hit only when noise x (1 - coverage) <= GDF_DITHERED_TRANSPARENCY_STEP_THRESHOLD (UE
//     DitheredTransparencyStepThreshold): each step into foliage stops the ray with that chance, otherwise it goes on;
//   - the smallest step grows from 0.1 voxel to one voxel (UE scales its MinStepSize by NotCoveredMinStepScale):
//     one dither sample per voxel crossed, so a foliage voxel lets (1 - threshold) of the rays through whatever the
//     step phase, and a crown's transmittance follows its depth in voxels.
// Shadow rays (no dither) still stop on foliage, with the reduced expansion.
//
// THE FIRST HIT IS REFINED BY BISECTION (not in UE). Such a sheet reconstructs to a V whose bottom is the voxel
// centre nearest to it, not the sheet, and trilinear interpolation of a V overestimates the distance by up to half
// a voxel, so a full sphere step can land anywhere in the band where the field is under the expansion - also in
// its lower half, past the sheet, where the gradient points away from the ray (the dark pits of the 80 m Bistro
// view: every clipmap-2 voxel of the plaza floor has a V of minimum ~0.3 voxel at its centre). The band is one
// interval along the ray between the last miss and the first hit, so bisecting that segment finds its entry: the
// expanded surface every ray reports, whatever its step phase. After a step that passed through foliage the
// previous sample lies in the band already, and the hit is taken where it is.
const float GDF_COVERED_EXPAND_SURFACE_SCALE         = 1.0;
const float GDF_NOT_COVERED_EXPAND_SURFACE_SCALE     = 0.6;
const float GDF_DITHERED_TRANSPARENCY_STEP_THRESHOLD = 0.1;

// The expansion at ray time @p t over a voxel of @p voxel cm with @p coverage.
float GlobalDistanceFieldExpand(float t, float voxel, float coverage)
{
    const float expandDistance = 0.5 * voxel;
    const float scale = mix(GDF_NOT_COVERED_EXPAND_SURFACE_SCALE, GDF_COVERED_EXPAND_SURFACE_SCALE, coverage);
    return expandDistance * clamp(t / (2.0 * expandDistance), 0.0, 1.0) * scale;
}

float GlobalDistanceFieldExcess(vec3 origin, vec3 direction, float t, vec4 levels[GDF_NUM_CLIPMAPS])
{
    const vec3 p     = origin + direction * t;
    const int  level = GlobalDistanceFieldLevelAt(p, levels);
    if (level < 0)
        return 1.0;
    const float voxel  = levels[level].w;
    const vec2  field  = SampleGlobalDistanceFieldLevelCoverage(level, p, voxel);
    return field.x - GlobalDistanceFieldExpand(t, voxel, field.y);
}

// THREE BISECTION STEPS IN ONE ROUND OF FETCHES (FPS-GI-FARFIELD). The serial bisection's next three midpoints are
// always among the seven of [lo, hi] at eighths, computed as the same halvings (p4 = mid of lo and hi, p2 of lo and
// p4, ...), so all seven are fetched together and the three decisions replayed on them: the same lo, hi and excess
// at hi, bit for bit, as three serial steps - one fetch latency instead of three on the hit's lane, which every
// wave of a gather pass holds (a quarter of the far field's rays hit).
void GlobalDistanceFieldBisect3(vec3 origin, vec3 direction, vec4 levels[GDF_NUM_CLIPMAPS], inout float lo,
                                inout float hi, inout float hiExcess)
{
    const float p4 = 0.5 * (lo + hi);
    const float p2 = 0.5 * (lo + p4);
    const float p6 = 0.5 * (p4 + hi);
    const float p1 = 0.5 * (lo + p2);
    const float p3 = 0.5 * (p2 + p4);
    const float p5 = 0.5 * (p4 + p6);
    const float p7 = 0.5 * (p6 + hi);
    const float e1 = GlobalDistanceFieldExcess(origin, direction, p1, levels);
    const float e2 = GlobalDistanceFieldExcess(origin, direction, p2, levels);
    const float e3 = GlobalDistanceFieldExcess(origin, direction, p3, levels);
    const float e4 = GlobalDistanceFieldExcess(origin, direction, p4, levels);
    const float e5 = GlobalDistanceFieldExcess(origin, direction, p5, levels);
    const float e6 = GlobalDistanceFieldExcess(origin, direction, p6, levels);
    const float e7 = GlobalDistanceFieldExcess(origin, direction, p7, levels);
    // First step at p4.
    const bool  inA  = e4 < 0.0;
    const float loA  = inA ? lo : p4;
    const float hiA  = inA ? p4 : hi;
    const float heA  = inA ? e4 : hiExcess;
    // Second at the middle of that half: p2 or p6.
    const float pB   = inA ? p2 : p6;
    const float eB   = inA ? e2 : e6;
    const bool  inB  = eB < 0.0;
    const float loB  = inB ? loA : pB;
    const float hiB  = inB ? pB : hiA;
    const float heB  = inB ? eB : heA;
    // Third at the middle of that quarter: p1, p3, p5 or p7.
    const float pC   = inA ? (inB ? p1 : p3) : (inB ? p5 : p7);
    const float eC   = inA ? (inB ? e1 : e3) : (inB ? e5 : e7);
    const bool  inC  = eC < 0.0;
    lo       = inC ? loB : pC;
    hi       = inC ? pC : hiB;
    hiExcess = inC ? eC : heB;
}

// A uniform number in [0, 1) per ray @p seed and step (PCG hash), the per-step noise of the dithered transparency.
float GlobalDistanceFieldStepNoise(uint seed, int step)
{
    uint v = seed + uint(step) * 747796405u + 2891336453u;
    v = ((v >> ((v >> 28u) + 4u)) ^ v) * 277803737u;
    v = (v >> 22u) ^ v;
    return float(v & 0xFFFFFFu) / 16777216.0;
}

// EMPTY SPACE IS CROSSED IN THE COARSER FIELD (UE: a step where the page holds no surface reads the coarse
// GlobalDistanceFieldMipTexture instead, whose influence range is larger). Each clipmap clamps its distance to
// GDF_INFLUENCE_RANGE_IN_VOXELS of ITS voxels, so in open air the finest clipmap steps 4 x 39 cm at most: a sun
// ray leaving the ground crossed clipmap 0 in 16+ samples. Where the step's own level is saturated (no surface
// within its influence), the level GDF_SKIP_LEVELS coarser - its window holds every finer one - is sampled at the
// same point, and its distance less GDF_SKIP_MARGIN_VOXELS of its voxels (the trilinear reconstruction of a
// 1-Lipschitz field overestimates by at most sqrt(3)/2 of a voxel) is taken when longer: 469 cm a step in clipmap
// 0, 937 in 1. A conservative step lands short of any surface, never past it, so the hit (refined below) is the
// same surface.
const int   GDF_SKIP_LEVELS            = 2;
const float GDF_SKIP_MARGIN_VOXELS     = 1.0;
const float GDF_SATURATED_FRACTION     = 0.95;

// The step from @p p of level @p level whose own field reads @p distance there: the coarse field's longer
// conservative step where @p distance is saturated, else @p fineStep.
int GlobalDistanceFieldSkipLevel(int level)
{
    return min(level + GDF_SKIP_LEVELS, GDF_NUM_CLIPMAPS - 1);
}

// GlobalDistanceFieldSkipStep with the skip level's distance at p (@p coarseDistance) already read.
float GlobalDistanceFieldSkipStepOf(int level, float distance, float fineStep, float coarseDistance,
                                    vec4 levels[GDF_NUM_CLIPMAPS])
{
    const int coarse = GlobalDistanceFieldSkipLevel(level);
    if (distance < GDF_SATURATED_FRACTION * GDF_INFLUENCE_RANGE_IN_VOXELS * levels[level].w || coarse <= level)
        return fineStep;
    return max(fineStep, coarseDistance - GDF_SKIP_MARGIN_VOXELS * levels[coarse].w);
}

float GlobalDistanceFieldSkipStep(vec3 p, int level, float distance, float fineStep, vec4 levels[GDF_NUM_CLIPMAPS])
{
    const int coarse = GlobalDistanceFieldSkipLevel(level);
    if (distance < GDF_SATURATED_FRACTION * GDF_INFLUENCE_RANGE_IN_VOXELS * levels[level].w || coarse <= level)
        return fineStep;
    return GlobalDistanceFieldSkipStepOf(level, distance, fineStep,
                                         SampleGlobalDistanceFieldLevel(coarse, p, levels[coarse].w), levels);
}

// @p anyHit (a shadow ray: visibility only) ends at the first sample in the band, unrefined - its T and Level are
// not read; a gather ray's hit is refined to the band's entry.
GlobalDistanceFieldHit TraceGlobalDistanceField(vec3 origin, vec3 direction, float maxT, int maxSteps,
                                                vec4 levels[GDF_NUM_CLIPMAPS], bool ditheredTransparency,
                                                uint seed, bool anyHit)
{
    GlobalDistanceFieldHit result;
    result.Hit   = false;
    result.T     = 0.0;
    result.Level = -1;
    result.Steps = 0;
    float t             = 0.0;
    float previousT     = 0.0;
    bool  previousInBand = false;
    for (int step = 0; step < maxSteps && t < maxT; ++step)
    {
        const vec3 p     = origin + direction * t;
        const int  level = GlobalDistanceFieldLevelAt(p, levels);
        if (level < 0)
            break;
        const float voxel    = levels[level].w;
        const vec2  field    = SampleGlobalDistanceFieldLevelCoverage(level, p, voxel);
#if defined(GDF_PREFETCH_SKIP_LEVEL)
        // FPS-GI-FARFIELD: the skip level's distance at p read beside the level's own, not after it (a short march
        // in open air - the far field's ~1 step a ray - is saturated at nearly every step and would wait on two
        // dependent fetches a step). The includer opts in where its marches are short and mostly saturated; a long
        // march near geometry would pay the second fetch on every unsaturated step for nothing.
        const int   skipLevel    = GlobalDistanceFieldSkipLevel(level);
        const float skipDistance = SampleGlobalDistanceFieldLevel(skipLevel, p, levels[skipLevel].w);
#endif
        const float distance = field.x;
        const float coverage = field.y;
        result.Steps = step + 1;
#if defined(GDF_COUNT_STEPS)
        // A dev counter's includer (ScreenProbeTrace.shader SP_TRACE_MISS_REASONS) declares the private total.
        ++gdfCountedSteps;
#endif
        const bool inBand = distance < GlobalDistanceFieldExpand(t, voxel, coverage);
        if (inBand && (!ditheredTransparency ||
                       GlobalDistanceFieldStepNoise(seed, step) * (1.0 - coverage) <=
                           GDF_DITHERED_TRANSPARENCY_STEP_THRESHOLD))
        {
            if (anyHit)
            {
                result.Hit = true;
                result.T   = t;
                return result;
            }
            // The excess at hi is carried, not re-read: at t it is this step's own (the same point, level and
            // fetch GlobalDistanceFieldExcess would take), at a mid the one just read.
            float lo       = previousT;
            float hi       = t;
            float hiExcess = distance - GlobalDistanceFieldExpand(t, voxel, coverage);
            // Six bisection steps as two rounds of three (GlobalDistanceFieldBisect3: the same result).
            if (step > 0 && !previousInBand)
            {
                GlobalDistanceFieldBisect3(origin, direction, levels, lo, hi, hiExcess);
                GlobalDistanceFieldBisect3(origin, direction, levels, lo, hi, hiExcess);
            }
            result.Hit   = true;
            result.T     = max(hi + min(hiExcess, 0.0), 0.0);
            result.Level = GlobalDistanceFieldLevelAt(origin + direction * hi, levels);
            return result;
        }
        previousT      = t;
        previousInBand = inBand;
        const float fineStep = max(distance, voxel * mix(1.0, 0.1, coverage));
#if defined(GDF_PREFETCH_SKIP_LEVEL)
        t += GlobalDistanceFieldSkipStepOf(level, distance, fineStep, skipDistance, levels);
#else
        t += GlobalDistanceFieldSkipStep(p, level, distance, fineStep, levels);
#endif
    }
    result.T = t;
    return result;
}

#endif
