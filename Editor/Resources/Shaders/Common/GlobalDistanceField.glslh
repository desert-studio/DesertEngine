// SAMPLING AND MARCHING THE GLOBAL DISTANCE FIELD - the one GPU reading of Graphic/DistanceField/
// GlobalDistanceField's clipmaps, shared by the debug view and every software trace that will march the scene
// (GI, reflections, distance-field shadows). Ported from UE 5.8 Engine/Shaders/Private/DistanceField/
// GlobalDistanceFieldShared.ush (clipmap selection, SampleGlobalDistanceField, the gradient) and
// GlobalDistanceFieldUtils.ush (the sphere-trace loop), adapted: dense clipmaps addressed toroidally through a
// REPEAT sampler (texel = world voxel index mod resolution) instead of UE's page atlas, distances stored in
// centimetres (R32F) rather than normalized by the influence radius.
//
// The including shader declares sampler3D u_GlobalDistanceField0..3 before including this file, and passes
// the clipmap parameters: GDFLevel[k] = (centre.xyz world cm, voxel size cm), the C++ ClipmapUniforms().
#ifndef GLOBAL_DISTANCE_FIELD_GLSLH
#define GLOBAL_DISTANCE_FIELD_GLSLH

#include <Common/DistanceFieldShared.glslh>

float SampleGlobalDistanceFieldLevel(int level, vec3 worldPosition, float voxelSize)
{
    // World voxel g covers [g, g+1) * voxel and lives in texel g mod R, whose centre is at (g + 0.5) / R - so
    // the normalized coordinate is simply position / (voxel * R), wrapped by the sampler.
    const vec3 uvw = worldPosition / (voxelSize * float(GDF_RESOLUTION));
    if (level == 0)
        return textureLod(u_GlobalDistanceField0, uvw, 0.0).x;
    if (level == 1)
        return textureLod(u_GlobalDistanceField1, uvw, 0.0).x;
    if (level == 2)
        return textureLod(u_GlobalDistanceField2, uvw, 0.0).x;
    return textureLod(u_GlobalDistanceField3, uvw, 0.0).x;
}

// The finest clipmap whose window holds @p worldPosition with a one-voxel margin (the trilinear footprint must
// not wrap onto the far side of the window), or -1 outside all of them.
int GlobalDistanceFieldLevelAt(vec3 worldPosition, vec4 levels[GDF_NUM_CLIPMAPS])
{
    for (int level = 0; level < GDF_NUM_CLIPMAPS; ++level)
    {
        const float halfExtent = levels[level].w * float(GDF_RESOLUTION) * 0.5 - levels[level].w;
        if (all(lessThan(abs(worldPosition - levels[level].xyz), vec3(halfExtent))))
            return level;
    }
    return -1;
}

// Centimetres to the nearest surface, clamped to the level's influence radius; a large value outside the field.
float SampleGlobalDistanceField(vec3 worldPosition, vec4 levels[GDF_NUM_CLIPMAPS])
{
    const int level = GlobalDistanceFieldLevelAt(worldPosition, levels);
    if (level < 0)
        return levels[GDF_NUM_CLIPMAPS - 1].w * GDF_INFLUENCE_RANGE_IN_VOXELS;
    return SampleGlobalDistanceFieldLevel(level, worldPosition, levels[level].w);
}

vec3 GlobalDistanceFieldGradient(int level, vec3 worldPosition, float voxelSize)
{
    const float h = voxelSize;
    const float dx = SampleGlobalDistanceFieldLevel(level, worldPosition + vec3(h, 0, 0), voxelSize) -
                     SampleGlobalDistanceFieldLevel(level, worldPosition - vec3(h, 0, 0), voxelSize);
    const float dy = SampleGlobalDistanceFieldLevel(level, worldPosition + vec3(0, h, 0), voxelSize) -
                     SampleGlobalDistanceFieldLevel(level, worldPosition - vec3(0, h, 0), voxelSize);
    const float dz = SampleGlobalDistanceFieldLevel(level, worldPosition + vec3(0, 0, h), voxelSize) -
                     SampleGlobalDistanceFieldLevel(level, worldPosition - vec3(0, 0, h), voxelSize);
    return vec3(dx, dy, dz);
}

struct GlobalDistanceFieldHit
{
    bool  Hit;
    float T;     // centimetres along the (normalized) ray
    int   Level; // the clipmap the hit was found in
    int   Steps;
};

// Sphere trace from @p origin along the unit @p direction until a surface (distance below a tenth of the
// level's voxel), @p maxT, @p maxSteps, or the ray leaves the coarsest clipmap.
GlobalDistanceFieldHit TraceGlobalDistanceField(vec3 origin, vec3 direction, float maxT, int maxSteps,
                                                vec4 levels[GDF_NUM_CLIPMAPS])
{
    GlobalDistanceFieldHit result;
    result.Hit   = false;
    result.T     = 0.0;
    result.Level = -1;
    result.Steps = 0;
    float t = 0.0;
    for (int step = 0; step < maxSteps && t < maxT; ++step)
    {
        const vec3 p     = origin + direction * t;
        const int  level = GlobalDistanceFieldLevelAt(p, levels);
        if (level < 0)
            break;
        const float voxel    = levels[level].w;
        const float distance = SampleGlobalDistanceFieldLevel(level, p, voxel);
        result.Steps = step + 1;
        if (distance < voxel * 0.1)
        {
            result.Hit   = true;
            result.T     = t;
            result.Level = level;
            return result;
        }
        t += max(distance, voxel * 0.1);
    }
    result.T = t;
    return result;
}

#endif
