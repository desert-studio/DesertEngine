// GPU-DRIVEN contract (C0): the rows of the scene's persistent GPU tables and of the culled-draw tables.
//
// The rows' one declaration: Engine/Graphic/GpuDriven/GpuSceneLayout.hpp (std430), generated into the include below.
// UE: FPrimitiveSceneShaderData / FInstanceSceneShaderData (SceneData.ush) and the InstanceCulling draw records.
//
// Readers: the instance cull (Programs/GpuDriven/InstanceCull.shader) and, through VisibleInstances[gl_InstanceIndex],
// the vertex stage of every binned mesh pass — which then reads World / PrevWorld / bones / material row from these
// rows instead of the push block's Transform / MaterialIndex / PrimitiveIndex (Common/MaterialTransport.glslh) and
// instead of the per-view ObjectMotions rows (Common/Velocity.glslh), which this header retires.
//
// Buffer declarations: the scene-read range (Core/ShaderCompiler/ShaderGraphBindings.hpp) holds the primitive
// table at kGpuScenePrimitivesBinding and the bone palettes at kObjectBonesBinding (Generated/SceneBindings.glslh), each
// declared by the stage that defines DESERT_GPU_SCENE_PRIMITIVES / DESERT_GPU_SCENE_BONES before including this
// header (the view-pass vertex stages, Mesh/Surface/Vertex_Static.glslh / Vertex_Skinned.glslh). The binned draw's
// four tables sit at 41-44 under DESERT_GPU_SCENE_DRAWS (below); the cull-only tables get theirs in phase CULL.

#ifndef DESERT_GPU_SCENE_GLSLH
#define DESERT_GPU_SCENE_GLSLH
#include <Generated/SceneBindings.glslh> // the set-0 slot table (Core::kSceneBindingNames)
#include <Common/ShadowWind.glslh>       // the shadow wind distance's rule, shared with the CPU walk

// The rows, the PrimitiveFlags / CullViewFlags / CascadeContentHash / CullVisibility / draw-slot / visible-entry bits:
// generated at build time from GpuDriven/GpuSceneLayout.hpp (meanings there). Read the transforms ONLY through
// GpuScene_LocalToWorld / GpuScene_PrevLocalToWorld / GpuScene_InstanceToPrimitive below.
#include <Generated/GpuDriven/GpuScene.glslh>

// THE ONLY UNPACK of a packed transform (GpuDriven::UnpackAffine is its C++ twin): Rows are the matrix's rows, GLSL
// mat4 takes columns, so column c = (Rows[0][c], Rows[1][c], Rows[2][c], c == 3 ? 1 : 0).
mat4 GpuScene_UnpackAffine( const GpuAffine3x4 t )
{
    return mat4( vec4( t.Rows[0].x, t.Rows[1].x, t.Rows[2].x, 0.0 ), vec4( t.Rows[0].y, t.Rows[1].y, t.Rows[2].y, 0.0 ),
                 vec4( t.Rows[0].z, t.Rows[1].z, t.Rows[2].z, 0.0 ), vec4( t.Rows[0].w, t.Rows[1].w, t.Rows[2].w, 1.0 ) );
}
mat4 GpuScene_LocalToWorld( const GpuScenePrimitive p )
{
    return GpuScene_UnpackAffine( p.LocalToWorld );
}
mat4 GpuScene_PrevLocalToWorld( const GpuScenePrimitive p )
{
    return GpuScene_UnpackAffine( p.PrevLocalToWorld );
}
mat4 GpuScene_InstanceToPrimitive( const GpuSceneInstance i )
{
    return GpuScene_UnpackAffine( i.InstanceToPrimitive );
}
// The primitive's foliage wind as Common/FoliageWind.glslh takes it (windA, windB; Graphic::PackInstanceWind's layout),
// at this frame's clock or, @p previous, the previous step's (a view pass's velocity).
vec4 GpuScene_WindA( const GpuScenePrimitive p )
{
    return p.Wind;
}
vec4 GpuScene_WindB( const GpuScenePrimitive p, const bool previous )
{
    return vec4( p.WindSpeed, previous ? p.WindPrevSeconds : p.WindSeconds, 0.0, 0.0 );
}

// WHO SWAYS IN THE SHADOWS in a cull view: a caster view's instance of a swaying primitive (Wind.z = Strength > 0)
// casts its rest pose by Common/ShadowWind.glslh's one rule (its bounds centre in the world, ShadowWindInstancePoint,
// against the main camera's position LodOrigin.xyz and the view's shadow wind distance LodOrigin.w), the same
// function MeshRenderer::ShadowIsmInstances compiles as C++ for the CPU walk. @p instanceToWorld is
// GpuScene_LocalToWorld( primitive ) * GpuScene_InstanceToPrimitive( instance ).
bool GpuCull_CastsRestPose( const GpuCullView view, const GpuScenePrimitive primitive, const mat4 instanceToWorld )
{
    if ( ( view.Flags & DESERT_GPU_CULL_VIEW_SHADOW_CASTER ) == 0u || !( primitive.Wind.z > 0.0 ) )
        return false;
    const vec3 point = ShadowWindInstancePoint( instanceToWorld, primitive.LocalBoundsCenter.xyz );
    if ( ShadowWindCastsRestPose( point, view.LodOrigin.xyz, view.LodOrigin.w ) )
        return true;
    // THE CASTER'S REACH (GPU-FRAME-7, MeshRenderer::ShadowWindRingOf): nearer the camera than the cascade's ring
    // lets its sway reach a receiver of it, the instance casts its rest pose too (the CPU walk's
    // ShadowWindRingSideOf: the same functions on the same bounds and pad).
    const vec2  reach = ShadowWindCasterReach( instanceToWorld, primitive.LocalBoundsExtent.xyz,
                                               primitive.LocalBoundsCenter.w );
    const float inner = ShadowWindRingInner( view.CasterRing, reach );
    return ShadowWindInsideRing( point, view.LodOrigin.xyz, inner );
}

// THE SCENE'S PRIMITIVE TABLE (GpuDriven::GpuScene, one per scene, stable rows): a view-pass draw reads its row
// through the push block's PrimitiveIndex (Common/MaterialTransport.glslh). Bound by name onto every view-pass
// material by Graphic::SceneFrameBinding::ApplyTo. DShaderParser refuses a Properties row or texture run inside
// the scene-read range by name, and Tests/Engine/VelocityTarget holds the whole tree to nothing else there.
#ifdef DESERT_GPU_SCENE_PRIMITIVES
layout( std430, binding = kGpuScenePrimitivesBinding ) readonly buffer GpuScenePrimitives
{
    GpuScenePrimitive Primitives[];
}
gpuScene;
#endif
// THE SCENE'S BONE PALETTES this frame: both frames' palettes of every skinned primitive, end to end; a row's
// BoneOffset / PrevBoneOffset name its two slices, so every pass that draws the primitive skins it from the same
// bytes.
#ifdef DESERT_GPU_SCENE_BONES
layout( std430, binding = kObjectBonesBinding ) readonly buffer ObjectBones
{
    mat4 Palettes[];
}
objectBones;
#endif

// THE BINNED DRAW'S TABLES (kGpuSceneInstancesBinding .. kGpuSceneSubmeshTransformsBinding): a mesh-pass
// vertex stage resolves EVERYTHING per draw from its instance id — the row of the pass's visible list names the
// instance (-> its primitive) and the cached draw slot (-> material row, submesh transform), so a draw pushes nothing.
// THE ID IS A PER-INSTANCE VERTEX STREAM (decision 10-27, UE5's instance id stream): a_VisibleRow, 4 bytes at
// VK_VERTEX_INPUT_RATE_INSTANCE (GpuDriven::kVisibleRowVertexBinding / kVisibleRowVertexLocation), written by the
// cull's compaction (InstanceCulling) and bound by RenderMeshIndirectGroup. Never gl_InstanceIndex: whether it includes firstInstance differs
// across drivers (MoltenVK), an instance-rate attribute does not. Transforms never ride a vertex stream.
// UE: GetSceneDataIntermediates through the instance id stream (SceneData.ush). Needs DESERT_GPU_SCENE_PRIMITIVES.
// THE SCENE'S INSTANCE ROWS: the binned draw's (below) and a CPU-instanced ISM cell's (DESERT_GPU_SCENE_INSTANCES,
// Mesh/Surface/Vertex_Instanced.glslh DESERT_SURFACE_SCENE_INSTANCES: the draw names GpuScene instances by id and
// reads their InstanceToPrimitive here, UE GPU Scene's instance data by InstanceId). Needs
// DESERT_GPU_SCENE_PRIMITIVES.
#if defined( DESERT_GPU_SCENE_DRAWS ) || defined( DESERT_GPU_SCENE_INSTANCES )
#ifndef DESERT_GPU_SCENE_PRIMITIVES
#error "the GpuScene instance rows name their primitive: define DESERT_GPU_SCENE_PRIMITIVES too"
#endif
layout( std430, binding = kGpuSceneInstancesBinding ) readonly buffer GpuSceneInstances
{
    GpuSceneInstance Instances[];
}
gpuSceneInstances;
#endif
#ifdef DESERT_GPU_SCENE_DRAWS
#ifndef DESERT_GPU_SCENE_PRIMITIVES
#error "DESERT_GPU_SCENE_DRAWS reads the primitive table: define DESERT_GPU_SCENE_PRIMITIVES too"
#endif
// VG-SW-RASTER: the VG visibility resolve (Mesh/Surface/Pass_VisibilityResolve.glslh, both stages) reads no
// instance id stream - its row comes from the pixel's visibility word (DesertResolveVgDrawOf) - and defines
// DESERT_GPU_SCENE_NO_VISIBLE_ROW.
#ifndef DESERT_GPU_SCENE_NO_VISIBLE_ROW
layout( location = 9 ) in uint a_VisibleRow; // GpuDriven::kVisibleRowVertexLocation
#endif

#ifndef DESERT_GPU_SCENE_VIRTUAL_GEOMETRY
layout( std430, binding = kGpuSceneVisibleInstancesBinding ) readonly buffer GpuSceneVisibleInstances
{
    GpuVisibleInstance VisibleInstances[];
}
gpuSceneVisible;
#endif
layout( std430, binding = kGpuSceneDrawSlotsBinding ) readonly buffer GpuSceneDrawSlots
{
    GpuDrawSlot DrawSlots[];
}
gpuSceneDrawSlots;
layout( std430, binding = kGpuSceneSubmeshTransformsBinding ) readonly buffer GpuSceneSubmeshTransforms
{
    mat4 SubmeshTransforms[];
}
gpuSceneSubmeshTransforms;

// One mesh-pass draw instance, resolved: the rows it came from and both frames' local-to-world of its vertices
// (Primitive.LocalToWorld x Instance.InstanceToPrimitive x the submesh's transform relative to the primitive; the
// last two are the same in both frames, so a still primitive gives PrevWorld == World bit for bit).
struct DesertMeshDraw
{
    uint Instance;
    uint Primitive;
    uint MaterialRow; // row in Materials[]; the fragment stage gets it as a flat varying
    uint Flags;       // the primitive's DESERT_GPU_PRIMITIVE_*, plus the slot's DESERT_GPU_DRAW_EMISSION_IS_LIGHT; the
                      // fragment stage gets it as a flat varying
    bool RestPose;    // DESERT_GPU_VISIBLE_REST_POSE: the wind does not bend it in this view
    // DesertClipLODTransition's side (Mesh/Surface/LODTransition.glslh): +1 the older level of a dithered LOD
    // transition (DESERT_GPU_VISIBLE_LOD_FADE_OUT), -1 the newer (_FADE_IN), 0 no transition.
    float LodFadeSide;
    mat4 World;
    mat4 PrevWorld;
};

DesertMeshDraw DesertResolveDrawOf( const GpuVisibleInstance visible )
{
    const GpuSceneInstance   instance  = gpuSceneInstances.Instances[visible.Instance];
    const uint               slotRow   = visible.DrawSlot & DESERT_GPU_VISIBLE_SLOT_MASK;
    const GpuDrawSlot        slot      = gpuSceneDrawSlots.DrawSlots[slotRow];
    const GpuScenePrimitive  primitive = gpuScene.Primitives[instance.Primitive];
    const mat4 local =
         GpuScene_InstanceToPrimitive( instance ) * gpuSceneSubmeshTransforms.SubmeshTransforms[slot.SubmeshTransform];
    DesertMeshDraw draw;
    draw.Instance    = visible.Instance;
    draw.Primitive   = instance.Primitive;
    draw.MaterialRow = slot.MaterialRow;
    draw.Flags       = primitive.Flags;
    if ( ( slot.Flags & DESERT_GPU_DRAW_SLOT_EMISSION_IS_LIGHT ) != 0u )
        draw.Flags |= DESERT_GPU_DRAW_EMISSION_IS_LIGHT;
    draw.RestPose    = ( visible.DrawSlot & DESERT_GPU_VISIBLE_REST_POSE ) != 0u;
    draw.LodFadeSide = 0.0;
    if ( ( visible.DrawSlot & DESERT_GPU_VISIBLE_LOD_FADE_OUT ) != 0u )
        draw.LodFadeSide = 1.0;
    if ( ( visible.DrawSlot & DESERT_GPU_VISIBLE_LOD_FADE_IN ) != 0u )
        draw.LodFadeSide = -1.0;
    draw.World      = GpuScene_LocalToWorld( primitive ) * local;
    draw.PrevWorld   = GpuScene_PrevLocalToWorld( primitive ) * local;
    return draw;
}

#ifndef DESERT_GPU_SCENE_VIRTUAL_GEOMETRY
#ifndef DESERT_GPU_SCENE_NO_VISIBLE_ROW
DesertMeshDraw DesertResolveMeshDraw()
{
    return DesertResolveDrawOf( gpuSceneVisible.VisibleInstances[a_VisibleRow] );
}
#endif
#else
// THE VIRTUAL GEOMETRY RASTER'S DRAW (the `.VirtualGeometry` surface cells; kVgRaster*Binding): the
// instance id names a row of the cluster cut's VisibleClusters (written per material group by "VirtualGeometry:
// Raster Binning", Programs/VirtualGeometry/RasterBinning.shader), i.e. (instance, cluster); the draw slot is the
// pass's lod-0 slot of the cluster's DAG submesh - the very slot the cut took the submesh transform from
// (ClusterCut.shader) and the binning took the material group from. A draw instance is one cluster: vertex =
// triangle x 3 + corner of it (Common/VirtualGeometry.glslh).
#include <Common/VirtualGeometry.glslh>
layout( std430, binding = kVgRasterClustersBinding ) readonly buffer VgRasterClusters
{
    VgCluster Clusters[];
}
vgRasterClusters;
layout( std430, binding = kVgRasterDagsBinding ) readonly buffer VgRasterDags
{
    VgClusterDag Dags[];
}
vgRasterDags;
layout( std430, binding = kVgRasterVisibleClustersBinding ) readonly buffer VgRasterVisibleClusters
{
    VgVisibleCluster VisibleClusters[];
}
vgRasterVisible;
layout( std430, binding = kVgRasterPrimitiveDrawsBinding ) readonly buffer VgRasterPrimitiveDraws
{
    GpuPrimitivePassDraws PrimitiveDraws[];
}
vgRasterPrimitiveDraws;

struct DesertVgDraw
{
    DesertMeshDraw Draw;
    VgClusterDag   Dag;
    VgCluster      Cluster;
    uint           View; // the cut view the cluster was found for (a VSM cut: the clipmap level)
};

// The draw of VisibleClusters row @p visibleRow: the raster's instance id (DesertResolveVgDraw), or the row a
// software-rastered pixel's visibility word names (VG-SW-RASTER, Pass_VisibilityResolve.glslh: word row -
// VgFirstRow), so the pixels of both rasters rebuild the very same draw.
DesertVgDraw DesertResolveVgDrawOf( const uint visibleRow )
{
    const VgVisibleCluster visible = vgRasterVisible.VisibleClusters[visibleRow];
    DesertVgDraw           vg;
    vg.Cluster = vgRasterClusters.Clusters[visible.Cluster];
    vg.Dag     = vgRasterDags.Dags[vg.Cluster.Dag];
    vg.View    = visible.View;
    const uint primitive = gpuSceneInstances.Instances[visible.Instance].Primitive;
    GpuVisibleInstance row;
    row.Instance = visible.Instance;
    row.DrawSlot = vgRasterPrimitiveDraws.PrimitiveDraws[primitive].FirstDrawSlot + vg.Dag.Submesh;
    // The cut's rest pose (ClusterCut's CutFrame.RestPose) rides the slot's bit, as a binned entry's does.
    row.DrawSlot |= visible.Flags & DESERT_GPU_VISIBLE_REST_POSE;
    vg.Draw      = DesertResolveDrawOf( row );
    return vg;
}
#ifndef DESERT_GPU_SCENE_NO_VISIBLE_ROW
DesertVgDraw DesertResolveVgDraw()
{
    return DesertResolveVgDrawOf( a_VisibleRow );
}
#endif
#endif
#endif

#endif
