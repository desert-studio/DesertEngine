// THE GRASS FIELD'S DISTANCE LAW (GRASS-DENSITY, GRASS-FIELD): ONE definition of how much of a grass variety's field
// stands at a distance, read by the generator that thins the blades (Programs/Grass/GrassGenerate.shader) and by the
// ground's far cover that carries on what the thinning removed (Common/LandscapeGrassCover.glslh). Two copies of
// this law drifted once already: the generator thinned by (S / d)^2 while the cover took on only the fade, so the
// thinned field past S lost coverage the ground never made up (GRASS-VIS-15).
//
// Past StartCullDistance S the share of instances kept falls with the square of the distance, (S / d)^2 - a blade's
// screen area falls so, and so does what it costs to draw it - and on top of that UE's fade, down to nothing at
// EndCullDistance E. S = 0 states no full-density zone to scale from: the variety fades as UE's does, linearly.
// A blade survivor stands for the 1 / share blades dropped around it, so its footprint widens by 1 / sqrt(share) (the
// share clamped at 0.05: past that a survivor does not grow further) at its own height; the height falls only over
// the last 20 % of the fade, so the far edge melts into the ground instead of the whole band shrinking.
//
// So the share of the full field's covered ground the survivors still cover is kept x widen x height - sqrt(share)
// while the share is above 0.05 - and the cover takes on the rest, 1 - that. Before S nothing is thinned: the
// coverage is 1 and the cover adds nothing.
//
// The screen-width floor (GRASS-WIDTH) thins too: past the distance D where the mean blade stands MinScreenWidth
// pixels wide the generator keeps (D / d)^2 and lifts each kept card to the floor width, d / D times the mean
// blade's. Both thinnings at once keep the smaller share - the thinning from F = min(S, D), the same F a cascade
// thins from (GrassRenderer: GpuInstanceBladeShadowLod::StartCull) - and a survivor is as wide as the wider of
// the two widenings, so the coverage is min(kept, floor) x max(widen, lift) x height (GRASS-VIS-16: D / d where
// the floor binds, where the cover used to assume sqrt(kept) and left the ground balder than the blades).
//
// Only a BLADE widens (GPU-COST-29; UE: foliage.DensityScale drops instances and never grows the survivors, the
// grass HISM fades its instances out by PerInstanceFadeAmount / scale to zero, and the landscape's material carries
// the coverage past them). A blade is a flat strip whose cost is its vertices: one wider strip for the 1 / share it
// stands for is cheaper than those. A MESH variety is alpha cards whose cost is their pixels: widened 1 / sqrt(share)
// its cards keep the full field's screen area - and so its overdraw - out to EndCullDistance. So a mesh survivor
// keeps its own size and instead SHRINKS TO NOTHING before the thinning drops it: an instance with draw r is dropped
// at the distance where Kept falls to r, and it scales down uniformly over the last kGrassMeshShrinkReach of that
// distance, linearly in the share - full while r < Ahead (the share kept kGrassMeshShrinkReach x farther, so it would
// still stand there), nothing as Kept reaches r. The fade to EndCullDistance is inside Kept, so the same shrink
// takes every survivor to nothing at EndCullDistance, and no mesh pops at the range's end. The mesh field's
// coverage is then Kept's survivors by their mean shrunken footprint: Ahead of them whole, the Kept - Ahead between
// shrinking linearly (a mean area of 1/3), (Kept + 2 Ahead) / 3 (GrassMeshCoverage) - the cover takes on the rest.
#ifndef GRASS_FIELD_SHARE_GLSLH
#define GRASS_FIELD_SHARE_GLSLH

struct GrassFieldShare
{
    float Faded;  // UE's fade between S and E, 0..1
    float Kept;   // the share of the field's instances kept: (S / d)^2 x (1 - Faded)
    float Widen;  // a survivor's width multiplier, 1 / sqrt(max(Kept, 0.05))
    float Height; // a survivor's height multiplier, 1 down to 0 over the last 20 % of the fade
    float Floor;  // the share the screen-width floor keeps: (D / d)^2 (1 before D, and with no floor)
    float Lift;   // the floor's lift of a kept card's width past D, d / D of the mean blade's (1 before D)
    float Ahead;  // the share Kept is kGrassMeshShrinkReach x farther: a mesh survivor whose draw beats it is whole
};

// How far before the distance its thinning drops it a mesh survivor starts to shrink: over the last 1 / 1.25 of it
// (GPU-COST-29). Past StartCullDistance (S / d)^2 then falls to 0.64 of itself across the band.
const float kGrassMeshShrinkReach = 1.25;

// The share a (F / d)^2 thinning keeps at @p distance past @p from F (1 before it; F = 0 states no thinning). The
// one form of every distance thinning of the field: the generator's past StartCullDistance (below), its
// screen-width floor's past D (GrassGenerate.shader, GRASS-WIDTH) and a cascade caster's
// (Mesh/Surface/Vertex_GrassBlade.glslh, GPU-COST-20). Two such thinnings at once keep the smaller share:
// min((S / d)^2, (D / d)^2) is one thinning from min(S, D).
float GrassThinShare( float distance, float from )
{
    return from > 0.0 ? min( 1.0, ( from * from ) / max( distance * distance, 1.0 ) ) : 1.0;
}

// The field's share at @p distance for a variety with Start/EndCullDistance @p startCull / @p endCull and its
// screen-width floor's distance @p floorDistance (0: no floor) - all in the same units, cm, through the view's
// Foliage quality and lens (GrassRenderer GrassFieldLens; the cover's TerrainInstance rows carry the same).
GrassFieldShare GrassFieldShareAt( float distance, float startCull, float endCull, float floorDistance )
{
    GrassFieldShare s;
    s.Faded      = clamp( ( distance - startCull ) / max( endCull - startCull, 1.0 ), 0.0, 1.0 );
    float screen = GrassThinShare( distance, startCull );
    s.Kept       = screen * ( 1.0 - s.Faded );
    s.Widen      = inversesqrt( max( s.Kept, 0.05 ) );
    s.Height     = 1.0 - clamp( ( s.Faded - 0.8 ) / 0.2, 0.0, 1.0 );
    s.Floor      = GrassThinShare( distance, floorDistance );
    s.Lift       = floorDistance > 0.0 ? max( 1.0, distance / floorDistance ) : 1.0;
    float ahead  = distance * kGrassMeshShrinkReach;
    s.Ahead      = GrassThinShare( ahead, startCull ) *
              ( 1.0 - clamp( ( ahead - startCull ) / max( endCull - startCull, 1.0 ), 0.0, 1.0 ) );
    return s;
}

// A mesh survivor's uniform scale for its thinning draw @p draw (kept: draw < s.Kept): 1 while it would still be
// kept kGrassMeshShrinkReach x farther, down to 0 as Kept reaches its draw (GPU-COST-29, above).
float GrassMeshShrink( GrassFieldShare s, float draw )
{
    return draw < s.Ahead ? 1.0 : clamp( ( s.Kept - draw ) / max( s.Kept - s.Ahead, 1.0e-6 ), 0.0, 1.0 );
}

// The share of the full field's covered ground the kept, widened survivors still cover (1 before min(S, D)):
// the smaller of the two thinnings' shares, each survivor as wide as the wider of their widenings.
float GrassFieldCoverage( GrassFieldShare s )
{
    return min( 1.0, min( s.Kept, s.Floor ) * max( s.Widen, s.Lift ) * s.Height );
}

// The share of the full field's covered ground a MESH variety's survivors still cover (1 before
// S / kGrassMeshShrinkReach): they do not widen and shrink to nothing before they are dropped, so Ahead of the
// field stands whole and Kept - Ahead shrinking linearly covers a third of its footprint (GrassMeshShrink).
float GrassMeshCoverage( GrassFieldShare s )
{
    return ( s.Kept + 2.0 * s.Ahead ) / 3.0;
}

// The coverage of a field whose leaf area is @p widenShare blades (GrassFieldCoverage) and the rest meshes
// (GrassMeshCoverage): the ground's far cover sums its layer's varieties so (LandscapeGrassCover).
float GrassFieldCoverageOf( GrassFieldShare s, float widenShare )
{
    return mix( GrassMeshCoverage( s ), GrassFieldCoverage( s ), widenShare );
}

#endif // GRASS_FIELD_SHARE_GLSLH
