// A landscape tile's height decode and sampling — the ONE statement of it, compiled twice from this text:
//   * as GLSL, by Programs/Terrain/Terrain.shader, which reads the tile's R16_UNORM copy;
//   * as C++, by Engine/World/Landscape/LandscapeData.cpp, which answers every CPU height query
//     (collision, raycast, brushes) from the tile's uint16 samples.
// So the height the GPU draws and the height the CPU reports are one function, not two that agree until
// the first edit on either side. The dialect is SkyMedium.glslh's: `f`-suffixed literals so C++ does not
// widen to double, no swizzles, no `out`, no arrays, functions before use.
//
// ENCODING. UE's (LandscapeDataAccess.h): a sample s is a local height of (s - 32768) / 128, and the
// landscape's vertical scale turns that into centimetres. Both factors are exact in float — the
// difference is an integer below 2^16 and 1/128 is a power of two — so the only rounding step is the
// multiply by the scale, correctly rounded on both sides.

#ifndef LANDSCAPE_HEIGHT_GLSLH
#define LANDSCAPE_HEIGHT_GLSLH

const float LANDSCAPE_MID_SAMPLE     = 32768.0f;
const float LANDSCAPE_LOCAL_PER_STEP = 0.0078125f; // 1/128, exactly
const float LANDSCAPE_MAX_SAMPLE     = 65535.0f;

// The integer sample back from an R16_UNORM texel. The sampler hands the shader s / 65535 as a float;
// the nearest integer to its product with 65535 is s for every s, which is what makes the GPU's input the
// CPU's input and not an approximation of it.
float LandscapeSampleFromUnorm( float unorm )
{
    return floor( unorm * LANDSCAPE_MAX_SAMPLE + 0.5f );
}

float LandscapeLocalFromSample( float sampleValue )
{
    return ( sampleValue - LANDSCAPE_MID_SAMPLE ) * LANDSCAPE_LOCAL_PER_STEP;
}

float LandscapeHeightCmFromSample( float sampleValue, float zScale )
{
    return LandscapeLocalFromSample( sampleValue ) * zScale;
}

// A lerp that returns its endpoints EXACTLY: t = 0 gives a and t = 1 gives b, bit for bit, with or without
// a fused multiply-add (a*0 + b*1 and a*1 + b*0 have one non-zero term each). The `a + (b - a) * t` form
// does not — a + (b - a) need not round back to b — and a tile's last sample column is evaluated at
// t = 1 on one side of a seam and at t = 0 on the other. This is the property the seam rests on.
float LandscapeLerp( float a, float b, float t )
{
    return a * ( 1.0f - t ) + b * t;
}

float LandscapeBilinear( float h00, float h10, float h01, float h11, float fx, float fz )
{
    return LandscapeLerp( LandscapeLerp( h00, h10, fx ), LandscapeLerp( h01, h11, fx ), fz );
}

// THE landscape surface: two planar triangles per cell, split on the (0, 0)-(1, 1) diagonal — the split
// Jolt's HeightFieldShape makes (HeightFieldShape.cpp, GetHeight / GetSurfaceNormal: fz >= fx is the
// triangle (x, z), (x, z+1), (x+1, z+1), the rest is (x, z), (x+1, z+1), (x+1, z)), and Jolt's split is
// fixed, so the drawn surface, every CPU height query and the ray follow it rather than the reverse. UE
// cuts its landscape quads the same way for rendering, tracing and collision alike. Bilinear is NOT this
// surface: inside a cell they differ by up to half the cell's twist |h00 - h10 - h01 + h11|, which on a
// steep hill put objects centimetres above or below what they were drawn on.
//
// Ported from UE 5.8 Engine/Source/Runtime/Landscape/Private/LandscapeGrass.cpp:2629-2643 (the
// barycentric height on the quad's two triangles; UE splits on the same (x,y)-(x+1,y+1) diagonal in its
// render index buffer, LandscapeRender.cpp:3346-3357, and collision, LandscapeCollision.cpp:639-683).
// Adapted: the plane is evaluated as nested LandscapeLerps instead of UE's three weighted terms, so every
// edge of the cell is LandscapeLerp of its own two samples bit for bit, whatever the compiler fuses into
// multiply-adds. A seam vertex is then the same bits from both tiles (the three-term form differed in the
// last bit across a seam once the products were contracted differently in the two branches). Upper
// triangle: from the left edge L = lerp(h00, h01, fz) to the diagonal D = lerp(h00, h11, fz), at fx / fz
// of the way; the lower triangle is the same with x and z exchanged. On the diagonal both give D.
bool LandscapeInUpperTriangle( float fx, float fz )
{
    return fz >= fx;
}

float LandscapeTriangle( float h00, float h10, float h01, float h11, float fx, float fz )
{
    if ( LandscapeInUpperTriangle( fx, fz ) )
        return LandscapeLerp( LandscapeLerp( h00, h01, fz ), LandscapeLerp( h00, h11, fz ),
                              fz > 0.0f ? fx / fz : 0.0f );
    return LandscapeLerp( LandscapeLerp( h00, h10, fx ), LandscapeLerp( h00, h11, fx ), fz / fx );
}

// The cell a local sample coordinate g (0 <= g <= samples - 1) falls in: its floor, except that the last
// sample belongs to the last cell (fraction 1) rather than to a cell that does not exist.
float LandscapeCellOf( float g, float samples )
{
    return min( floor( g ), samples - 2.0f );
}

// dh/d(axis) in cm per cm from the two samples either side, `steps` samples apart.
float LandscapeGradient( float hLow, float hHigh, float steps, float spacingCm )
{
    return ( hHigh - hLow ) / ( steps * spacingCm );
}

// The two sample indices the gradient at index i of one axis differences, i in [0, last]. CENTRAL wherever
// the sample beyond exists: inside the tile, and on a border whose neighbouring tile is loaded — the tile
// then carries that neighbour's next row as a one-sample ring (UE keeps its components' neighbour edges the
// same way), index -1 or last + 1. One-sided only on the landscape's own edge, where nothing lies beyond.
// hasLow / hasHigh are 1 when the neighbour on that side is present. The seam rests on this: both tiles of
// a shared edge difference the same two samples over the same two steps, so the normal there is one value,
// not a one-sided slope from each side that differ by the curvature and draw a line of light.
float LandscapeGradientLow( float i, float hasLow )
{
    return ( i > 0.0f || hasLow > 0.5f ) ? i - 1.0f : i;
}

float LandscapeGradientHigh( float i, float last, float hasHigh )
{
    return ( i < last || hasHigh > 0.5f ) ? i + 1.0f : i;
}

#endif // LANDSCAPE_HEIGHT_GLSLH
