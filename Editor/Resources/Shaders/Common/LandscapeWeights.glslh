// A landscape tile's painted weight layers over its ground (the root's first layer) — the surface stage's
// half of UE's weightmap (the other half, the RGBA8 pages, is LandscapeWeightmapAtlasTexels on the C++ side).
// Pure arithmetic, so the LandscapePaint suite compiles this file as C++ and checks the blend the GPU runs.
//
// Ported from UE 5.8 Engine/Source/Runtime/Landscape/Private/Materials/MaterialExpressionLandscapeLayerBlend.cpp:
// 180-325 (UMaterialExpressionLandscapeLayerBlend::Compile), adapted: the layer inputs are the root layers'
// values instead of material graphs (the landscape material calls it once per attribute, with that attribute
// of each layer: the blend is linear in them), LB_HeightBlend is LandscapeHeightBlend below (it hands this
// one modified weights), and what the weight-blended layers leave unclaimed is the ground's value rather
// than zero — UE allocates a layer to a component on its first stroke with every weight zero and shows its
// first layer where nothing is painted; our tiles start with no layer at all, so the caller passes that first layer as the ground.
#ifndef LANDSCAPE_WEIGHTS_GLSLH
#define LANDSCAPE_WEIGHTS_GLSLH

// w0, w1     = the tile's two weightmap pages at this pixel (UE's weightmap textures: layer i is page i / 4,
//              channel i % 4), 0..1; a page the tile does not have is vec4(0).
// c0..c7     = each tile layer's root layer colour in rgb; a = 1 when the root names the layer, 0 when it does
//              not (the layer is then not drawn at all, as if unpainted).
// alpha0/1   = per page, 1 per channel whose layer is NoWeightBlend (UE's LB_AlphaBlend), 0 for weight-blended ones.
// groundAlbedo = the albedo under every layer, shown where the weight-blended layers leave the pixel unclaimed.
vec3 LandscapeWeightBlend( vec4 w0, vec4 w1, vec4 c0, vec4 c1, vec4 c2, vec4 c3, vec4 c4, vec4 c5, vec4 c6,
                           vec4 c7, vec4 alpha0, vec4 alpha1, vec3 groundAlbedo )
{
    vec4 drawn0    = w0 * vec4( c0.a, c1.a, c2.a, c3.a );
    vec4 drawn1    = w1 * vec4( c4.a, c5.a, c6.a, c7.a );
    vec4 weighted0 = drawn0 * ( vec4( 1.0f ) - alpha0 );
    vec4 weighted1 = drawn1 * ( vec4( 1.0f ) - alpha1 );
    vec4 laidOver0 = drawn0 * alpha0;
    vec4 laidOver1 = drawn1 * alpha1;

    // LB_WeightBlend: the layers of both pages add by weight, with no renormalisation (the painter keeps
    // their sum at 255, LandscapeNormalizeWeights). Whatever they leave is the ground.
    float claimed = weighted0.x + weighted0.y + weighted0.z + weighted0.w + weighted1.x + weighted1.y +
                    weighted1.z + weighted1.w;
    float unclaimed = claimed < 1.0f ? 1.0f - claimed : 0.0f;

    vec3 albedo = vec3( c0 ) * weighted0.x + vec3( c1 ) * weighted0.y + vec3( c2 ) * weighted0.z +
                  vec3( c3 ) * weighted0.w + vec3( c4 ) * weighted1.x + vec3( c5 ) * weighted1.y +
               vec3( c6 ) * weighted1.z + vec3( c7 ) * weighted1.w + groundAlbedo * unclaimed;

    // LB_AlphaBlend: blended last, each a lerp over everything below it, in layer order.
    albedo = mix( albedo, vec3( c0 ), laidOver0.x );
    albedo = mix( albedo, vec3( c1 ), laidOver0.y );
    albedo = mix( albedo, vec3( c2 ), laidOver0.z );
    albedo = mix( albedo, vec3( c3 ), laidOver0.w );
    albedo = mix( albedo, vec3( c4 ), laidOver1.x );
    albedo = mix( albedo, vec3( c5 ), laidOver1.y );
    albedo = mix( albedo, vec3( c6 ), laidOver1.z );
    albedo = mix( albedo, vec3( c7 ), laidOver1.w );
    return albedo;
}

// UE's per-layer blend types (ELandscapeLayerBlendType) over the weight pages: an LB_HeightBlend layer's weight w
// becomes clamp(lerp(-1, 1, w) + height, 0.0001, 1), an LB_WeightBlend layer keeps w, and both kinds together
// are renormalised to sum to 1, so where a height-blended layer meets another the one whose height map stands
// higher wins the pixel (stones poke through the grass edge instead of a soft cross-fade).
//
// Ported from UE 5.8 Engine/Source/Runtime/Landscape/Private/Materials/MaterialExpressionLandscapeLayerBlend.cpp:
// 218-237 and 287-291 (LB_HeightBlend, InvWeightSumCode: the renormalisation runs over the weight- and the
// height-blended layers alike, and only when some layer is height-blended), adapted: the ground (what the
// weight-blended layers leave unclaimed — the root's first layer, see LandscapeWeightBlend) takes part as one
// more layer of its own blend type, and the result is handed back as weights LandscapeWeightBlend takes, so
// every attribute (albedo, normal, roughness, ...) is blended by one statement of the blend: the renormalised
// layers sum to 1 - the ground's share, which is what LandscapeWeightBlend then leaves to the ground.
// LB_AlphaBlend layers keep their painted weight (UE blends them after, unmodified). The caller runs this only
// when some layer or the ground is height-blended; with none it would only renormalise what already sums to 1.
//
// drawn0/1     = per layer 1 when the root names it (the colours' a), as in LandscapeWeightBlend.
// height0/1    = per layer 1 when it is LB_HeightBlend, 0 for LB_WeightBlend (alpha0/1 = LB_AlphaBlend).
// h0/h1        = per layer its height (0..1); groundHeight the ground's, groundHeightBlend 1 when the ground's
//                input is LB_HeightBlend.
struct LandscapeBlendWeights
{
    vec4 W0;
    vec4 W1;
};

LandscapeBlendWeights LandscapeHeightBlend( vec4 w0, vec4 w1, vec4 drawn0, vec4 drawn1, vec4 alpha0, vec4 alpha1,
                                            vec4 height0, vec4 height1, vec4 h0, vec4 h1, float groundHeight,
                                            float groundHeightBlend )
{
    vec4  m0      = drawn0 * ( vec4( 1.0f ) - alpha0 );
    vec4  m1      = drawn1 * ( vec4( 1.0f ) - alpha1 );
    float claimed = dot( w0, m0 ) + dot( w1, m1 );
    float ground  = claimed < 1.0f ? 1.0f - claimed : 0.0f;

    vec4  raised0 = clamp( w0 * 2.0f - vec4( 1.0f ) + h0, 0.0001f, 1.0f );
    vec4  raised1 = clamp( w1 * 2.0f - vec4( 1.0f ) + h1, 0.0001f, 1.0f );
    vec4  hw0     = ( w0 + ( raised0 - w0 ) * height0 ) * m0;
    vec4  hw1     = ( w1 + ( raised1 - w1 ) * height1 ) * m1;
    float raisedG = clamp( ground * 2.0f - 1.0f + groundHeight, 0.0001f, 1.0f );
    float hg      = ground + ( raisedG - ground ) * groundHeightBlend;
    float sum     = dot( hw0, vec4( 1.0f ) ) + dot( hw1, vec4( 1.0f ) ) + hg;
    float inv     = sum > 0.0f ? 1.0f / sum : 0.0f;

    LandscapeBlendWeights r;
    r.W0 = hw0 * inv + w0 * drawn0 * alpha0;
    r.W1 = hw1 * inv + w1 * drawn1 * alpha1;
    return r;
}

// Where page @p page of a tile's weightmap puts sample-space coordinate @p g (x along the tile, y along it in
// Z, in samples) in the stacked image: page p occupies rows [p * rows, (p + 1) * rows) of a pages * rows
// high image, and the texel centre of sample i is i + 0.5. A tile's samples run 0..rows-1, so the filter
// never reaches across into the neighbouring page.
vec2 LandscapeWeightmapPageUV( vec2 g, float page, vec2 imageSize, float pages )
{
    float rows = imageSize.y / pages;
    return vec2( ( g.x + 0.5f ) / imageSize.x, ( g.y + 0.5f + page * rows ) / imageSize.y );
}

// The tile's visibility at this pixel: its visibility layer's weight (kLandscapeVisibilityLayerName, UE's
// ALandscapeProxy::VisibilityLayer), read from the same two pages as the paint layers. @p layerPlusOne is
// TerrainInstance.Params.z — the visibility layer's index + 1, 0 when the tile has none (visibility 0: no hole).
//
// Ported from UE 5.8 Engine/Source/Runtime/Landscape/Private/Materials/MaterialExpressionLandscapeVisibilityMask.cpp:
// 28-33 (Compile: the mask is 1 - the layer's weight, 1 where the layer is not allocated), adapted: we return the
// weight itself and LandscapeIsHole compares it, instead of a mask fed to a material's opacity-mask clip.
float LandscapeVisibility( vec4 w0, vec4 w1, float layerPlusOne )
{
    int layer = int( layerPlusOne + 0.5f ) - 1;
    if ( layer < 0 )
        return 0.0f;
    return layer < 4 ? w0[layer] : w1[layer - 4];
}

// UE's default UMaterial::OpacityMaskClipValue (Material.cpp: OpacityMaskClipValue = 0.3333f): a pixel whose
// opacity mask falls below it is clipped.
const float kLandscapeHoleOpacityMaskClip = 0.3333f;

// A hole: UE's visibility mask (1 - the layer's weight, MaterialExpressionLandscapeVisibilityMask.cpp:32)
// below the opacity-mask clip value, i.e. a weight above 2/3 (171 of 255 and up). ONE statement of the
// threshold for every terrain program that discards (surface, G-buffer, shadow caster) and, compiled as C++,
// for the Jolt heightfield (LandscapeCollision) and the CPU raycast — a caster or a collider with its own
// threshold would shadow or stop at a rim the camera sees missing.
bool LandscapeIsHole( float visibility )
{
    return 1.0f - visibility < kLandscapeHoleOpacityMaskClip;
}

#endif // LANDSCAPE_WEIGHTS_GLSLH
