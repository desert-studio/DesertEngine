// LOCAL EXPOSURE (UE Local Exposure, Bilateral) — the one shader source of the exposure law and of the grid's
// slice mapping; Engine/Graphic/PostProcessing/LocalExposureRules.hpp mirrors it on the CPU.
// Port of UE PostProcessHistogramCommon.ush:251-310 with two deliberate differences (CONTRACT.md §6):
//  - slices are 1 EV each, centred on the exposed middle grey of the last exposure (LocalExposureSliceCoord);
//  - the threshold smoothstep has an explicit strength >= 1 branch instead of dividing by 1 - strength = 0.
#ifndef DESERT_LOCAL_EXPOSURE_GLSLH
#define DESERT_LOCAL_EXPOSURE_GLSLH

#define LOCAL_EXPOSURE_GRID_DEPTH 32

float LocalExposureLuminance( vec3 c )
{
    return dot( c, vec3( 0.2126, 0.7152, 0.0722 ) );
}

// Continuous slice coordinate of an UN-EXPOSED log2 luminance: slice i covers [i, i + 1). Not "LocalExposureSlice":
// that is the push-constant member of SceneComposite/BloomDownsample, and block members share the global scope.
float LocalExposureSliceCoord( float logLum, float sliceLogMin, float invSliceEV )
{
    return ( logLum - sliceLogMin ) * invSliceEV;
}

int LocalExposureSliceIndex( float logLum, float sliceLogMin, float invSliceEV )
{
    return clamp( int( floor( LocalExposureSliceCoord( logLum, sliceLogMin, invSliceEV ) ) ), 0,
                  LOCAL_EXPOSURE_GRID_DEPTH - 1 );
}

// The grid's W coordinate for an UN-EXPOSED log2 luminance (sampled with a linear 3D sampler; the callers do
// the fetch, so no sampler crosses a function boundary).
float LocalExposureGridW( float logLum, float sliceLogMin, float invSliceEV )
{
    float slice = clamp( LocalExposureSliceCoord( logLum, sliceLogMin, invSliceEV ), 0.5,
                         float( LOCAL_EXPOSURE_GRID_DEPTH ) - 0.5 );
    return slice / float( LOCAL_EXPOSURE_GRID_DEPTH );
}

// UE CalculateBaseLogLuminance (both overloads): the base layer = grid mean (@p cell = (sum logLum, count))
// blended toward the blurred log luminance; an empty cell falls back to the blurred value (the grid is built from
// half-res texels). Inputs UN-EXPOSED; the result is EXPOSED (+ log2 exposure).
float LocalExposureBaseLogLuminance( vec2 cell, float blurred, float blurredBlend, float logExposure )
{
    float bilateral = cell.y < 0.001 ? blurred : cell.x / cell.y;
    return mix( bilateral, blurred, blurredBlend ) + logExposure;
}

float LocalExposureThresholdSmooth( float e0, float strength, float x )
{
    if ( strength >= 1.0 )
        return 0.0; // UE: smoothstep(e0, e0 + 1/0, x) == 0
    return smoothstep( e0, e0 + 1.0 / ( 1.0 - strength ), x );
}

// UE CalculateLogLocalExposure. All log luminances EXPOSED. contrast = (highlight, shadow, detail, blurredBlend),
// threshold = (highlightThreshold, shadowThreshold, highlightStrength, shadowStrength).
float LocalExposureLogExposure( float logLum, float baseLogLum, float logMiddleGrey, vec4 contrast, vec4 threshold )
{
    float detail        = logLum - baseLogLum;
    float baseCentered  = baseLogLum - logMiddleGrey;
    float contrastScale = baseCentered > 0.0 ? contrast.x : contrast.y;
    float M;
    float T;
    if ( baseCentered > 0.0 )
    {
        M = max( 0.0, baseCentered - threshold.x );
        T = LocalExposureThresholdSmooth( threshold.x, threshold.z, abs( baseCentered ) );
    }
    else
    {
        M = min( 0.0, baseCentered + threshold.y );
        T = LocalExposureThresholdSmooth( threshold.y, threshold.w, abs( baseCentered ) );
    }
    float thresholdOffset = ( baseCentered - M ) * ( 1.0 - T );
    baseCentered -= thresholdOffset;
    float logLocalLum = logMiddleGrey + thresholdOffset + baseCentered * contrastScale + detail * contrast.z;
    return logLocalLum - logLum;
}

#endif
