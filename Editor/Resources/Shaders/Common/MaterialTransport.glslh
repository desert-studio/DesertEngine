// The per-draw half of THE parameter transport: the model matrix and the row this draw reads out of the
// shared `Materials[]` storage buffer. Both are push constants because Vulkan snapshots a push at record
// time — a value written here cannot be clobbered by the next object's setup before the GPU runs the
// draw, which is the property a per-material uniform block does not have and the reason it was deleted
// (Engine/Core/Formats/MaterialParamRow.hpp has the measurement and the probe scene).
//
// SHARED, not repeated per shader, so the offsets cannot drift: the CPU finds every field BY NAME in the
// layout reflected from this block (Core/Formats/MaterialLayout.hpp, Graphic/Materials/MaterialBinder.hpp)
// for the hand-written mesh lit shaders and for every shader the DSL generates alike. A stage that only needs Transform still declares the whole block — Vulkan
// takes ONE push range per pipeline, and two stages disagreeing about its length is a layout mismatch.
//
// ONE BLOCK FOR EVERY PIPELINE, the per-path tails included. The parser injects this header into the
// fragment stage of any `Properties Binding(n)` shader BEFORE the authored text, so a vertex stage that
// declared its own longer block (skinned: BoneOffset; instanced: wind) left the fragment 68 bytes against
// a 72/112-byte vertex — one pipeline, two lengths. The tails therefore live here: a path that does not
// read them leaves them unpushed (a push of a sub-range is legal), and every stage of every pipeline
// reflects the same 128 bytes, the whole range every Vulkan device guarantees (no field can be added).
//
// The guard is real work, not ceremony: DShaderParser injects this include into the fragment stage of any
// shader with a `Properties Binding(n)` block, and that shader's own vertex stage includes it too.
#ifndef DESERT_MATERIAL_TRANSPORT_GLSLH
#define DESERT_MATERIAL_TRANSPORT_GLSLH

// SHADER-PUSH-GEN-2: one block per variant (a preprocessor line inside a block has no single layout, so the
// generator - DesertHeaderTool --shader-push - refuses it): ShaderPush::MaterialTransportDrawRows under
// DESERT_SURFACE_DRAW_ROWS, ShaderPush::MaterialTransport otherwise. Both are 128 bytes and differ only at 112.
#ifdef DESERT_SURFACE_DRAW_ROWS
PushConstant MaterialTransportDrawRows
{
    mat4 Transform;     // offset 0
    uint MaterialIndex; // offset 64 — the row in Materials[]
    uint BoneOffset;    // offset 68 — skinned LIGHT-view cell only (masked shadow): first bone of THIS draw in BoneMatrices[]; a view pass reads its row
    uint PrimitiveIndex; // offset 72 — view passes and the skinned masked caster: the draw's GpuScene primitive in Primitives[] (Common/GpuScene.glslh,
                         // Material::SetPrimitiveIndex). Every submesh draw of one object reads the same row; in a
                         // view pass Transform is then the submesh's transform RELATIVE TO that row's World.
    vec4 WindA;         // offset 80 — instanced vertex only: Graphic::kInstancedWindPushOffset (FoliageWind.glslh)
    vec4 WindB;         // offset 96
    uint DrawRowsLo;    // offset 112 - a compacted bin's draw (RENDER-JOB-CPU-4): the address of the bin's
    uint DrawRowsHi;    // first DrawRows slot (DrawPushFields::DrawRows, Common/GpuInstanceDrawRow.glslh)
    uint PrimitiveFlags; // offset 120 — G-buffer fragment stage only (Mesh/Surface/Pass_GBuffer.glslh,
                         // Material::SetPrimitiveFlags): the draw's per-primitive bits, Graphic::PrimitiveFlag
                         // (bit 0 = NO_CONTACT_SHADOW, UE !bCastContactShadow; bit 1 = NO_EMISSION; bit 2 =
                         // EMISSION_IS_LIGHT). 0 = every default.
    float LodFadeSide;   // offset 124 - a CPU-recorded Masked draw's side of a dithered LOD transition
                         // (DrawPushFields::LodFadeSide; +1 older, -1 newer, 0 none - the binned draw's
                         // DesertMeshDraw::LodFadeSide; Mesh/Surface/LODTransition.glslh). Block size 128, the
                         // size every Vulkan device guarantees.
}
m_PushConstants;
#else
PushConstant MaterialTransport
{
    mat4 Transform;     // offset 0
    uint MaterialIndex; // offset 64 — the row in Materials[]
    uint BoneOffset;    // offset 68 — skinned LIGHT-view cell only (masked shadow): first bone of THIS draw in BoneMatrices[]; a view pass reads its row
    uint PrimitiveIndex; // offset 72 — view passes and the skinned masked caster: the draw's GpuScene primitive in Primitives[] (Common/GpuScene.glslh,
                         // Material::SetPrimitiveIndex). Every submesh draw of one object reads the same row; in a
                         // view pass Transform is then the submesh's transform RELATIVE TO that row's World.
    vec4 WindA;         // offset 80 — instanced vertex only: Graphic::kInstancedWindPushOffset (FoliageWind.glslh)
    vec4 WindB;         // offset 96
    vec2 ShadowSlope;   // offset 112 — terrain light-view vertex stage only (Programs/Terrain/TerrainShadow.shader,
                        // Material::SetShadowSlopeBias): Graphic::CascadeCasterBias SlopeBias / SlopeClamp
                        // of the cascade being drawn.
    uint PrimitiveFlags; // offset 120 — G-buffer fragment stage only (Mesh/Surface/Pass_GBuffer.glslh,
                         // Material::SetPrimitiveFlags): the draw's per-primitive bits, Graphic::PrimitiveFlag
                         // (bit 0 = NO_CONTACT_SHADOW, UE !bCastContactShadow; bit 1 = NO_EMISSION; bit 2 =
                         // EMISSION_IS_LIGHT). 0 = every default.
    float LodFadeSide;   // offset 124 - a CPU-recorded Masked draw's side of a dithered LOD transition
                         // (DrawPushFields::LodFadeSide; +1 older, -1 newer, 0 none - the binned draw's
                         // DesertMeshDraw::LodFadeSide; Mesh/Surface/LODTransition.glslh). Block size 128, the
                         // size every Vulkan device guarantees.
}
m_PushConstants;
#endif

// The bits of PrimitiveFlags — C++ twin: Graphic::PrimitiveFlag (Engine/Graphic/Materials/Material.hpp).
#define DESERT_PRIMITIVE_FLAG_NO_CONTACT_SHADOW 1u
// The draw writes no emission into the G-buffer: a surface-cache card capture of a material with Emissive Lights
// Scene on (MegaLights lights the scene from it directly; the cards' emissive layer, which GI reads, holds none).
#define DESERT_PRIMITIVE_FLAG_NO_EMISSION 2u
// The draw's emission is a MegaLights light source (its material has Emissive Lights Scene on): the G-buffer marks
// the shading word's EMISSION_IS_LIGHT, so a screen GI hit takes no emission from it (Common/GIHitLighting.glslh).
#define DESERT_PRIMITIVE_FLAG_EMISSION_IS_LIGHT 4u

#endif
