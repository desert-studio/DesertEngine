#ifndef MEGALIGHTS_GLSLH
#define MEGALIGHTS_GLSLH

// MEGALIGHTS (UE 5.5 Renderer/Private/MegaLights, Shadows Stochastic): the local lights of a pixel are shaded from a
// FIXED number of light samples per pixel instead of every light of its froxel with its shadow map. The samples
// live at HALF resolution (UE r.MegaLights.DownsampleFactor 2): one SAMPLE PIXEL per 2x2 block of render pixels,
// shaded at the block's representative pixel (MegaLightsScreenPixel: one of the four, rotated per frame). They are
// drawn anew every frame by weighted reservoir sampling over every light of the pixel's light-grid cell, without
// visibility; a light the tile did not see last frame (Common/MegaLightsSample.glslh, the visible-light hash) is
// drawn less often. Each sample is traced ONCE: a screen-space contact shadow first, then a ray query toward
// a point of the light's source sphere (UE SourceRadius: soft shadows). Every render pixel then shades the samples
// of one of its four sample pixels with its own surface (UE ShadeLightSamples), diffuse and specular apart, and the
// two are denoised as separate signals. The text every MegaLights pass shares: the view block, the G-buffer reads,
// the sample-pixel space, the light index space (the light grid's: points first, then spots) and the sample.
//
// The includer, before this file: `Uniform sampler PointClampSampler;`. Defines:
//   MEGALIGHTS_SHADING - the pass evaluates a light at its pixel (the target function, the shading): GBufferA and
//                        the shading word are declared and the registry's shading models included.
//   MEGALIGHTS_TRACE   - the pass tests visibility, from ONE source (Common::Scalability::StochasticVisibility):
//     MEGALIGHTS_VISIBILITY_RAY_QUERY - Common/RayQueryVisibility.glslh included before this file;
//     MEGALIGHTS_VISIBILITY_SCREEN    - the screen trace over the closest-depth HZB (the includer declares
//                                       HzbTexture, Common/HZBTrace.glslh), alone;
//     MEGALIGHTS_VISIBILITY_VSM       - beside MEGALIGHTS_VISIBILITY_SCREEN: then the light's virtual shadow map
//                                       pages (the includer declares the VSM reader's tables, DESERT_VSM_READ,
//                                       and VsmLocalLightsUB { VsmLocalLight vsmLocalLights[]; })
//                        (MEGALIGHTS_SHADING too: the contact shadow reads the shading word and the subsurface
//                        opacity of the receiver).
// Bindings: 0 the view block, 1 depth, 2 GBufferB, 3 GBufferA, 4 the shading word, 6 / 16 the point / spot rows
// (Mesh/PointLight.glslh, Mesh/Spotlight.glslh), 60..66 the scene-lighting emissive triangles, 67 their selection
// grid; a pass's own inputs and outputs from 10 on.
//
// THE EMISSIVE TRIANGLES AS LIGHTS (UE MegaLights' emissive-mesh lights; EMISSIVE-MEGALIGHTS): the triangles of the
// materials with Emissive Lights Scene on (SceneRenderer::AddFrameSceneEmissiveLights - its own instance of the
// emissive list, Common/EmissiveLights.glslh, filtered to those materials) are lights of the same index space,
// AFTER the points and spots: light points + spots + t is triangle t of that list. A pixel's candidates draw them
// from the list's selection grid, the cell of the pixel's world position (Common/EmissiveLightsSampling.glslh
// EmissiveGridPick, its exact pdf EmissiveGridPickPdf), on their OWN random stream (the local lights' draws stay
// those of a frame without them); a triangle emits EmissiveLightsRadiance, is shaded by its vector irradiance as a
// rect light is (Mesh/LightSources.glslh), and its shadow ray aims at a random point of it.
// Sample textures are sample-pixel sized (MegaLightsSampleSize), stacked in layers; the G-buffer is render sized.

#include <Common/ReconstructPosition.glslh>
#include <Mesh/LightSources.glslh>
#include <Mesh/PointLight.glslh> // binding 6
#include <Mesh/Spotlight.glslh>  // binding 16
#include <Mesh/MegaLightsDemodulation.glslh>
#include <Common/LightSourceSampling.glslh>

// The most samples a sample pixel draws (MegaLights.hpp kMegaLightsMaxSamplesPerPixel; Scalability
// Shadows.MegaLightsSamplesPerPixel 1..4). The sample textures stack the layers vertically: layer k of sample
// pixel (x, y) is texel (x, y + k * sample height).
#define MEGALIGHTS_MAX_SAMPLES 4

#include <Generated/Shadows/MegaLights.glslh> // Shadows/MegaLightsLayout.hpp
Uniform(0) MegaLightsViewUB { DESERT_MegaLightsView_MEMBERS };

// The scene-lighting emissive triangles (RayTracing::EmissiveLightsFrame of SceneRenderer::
// AddFrameSceneEmissiveLights; MegaLightsShaderParameters), bindings 60..66, and the list's selection grid
// (EmissiveLightsFrame::Grid), binding 67.
#include <Common/EmissiveLights.glslh>
layout(std430, binding = 60) readonly buffer MegaLightsEmissiveSegmentsUB
{
	EmissiveSegment emissiveSegments[];
};
layout(std430, binding = 61) readonly buffer MegaLightsEmissiveLookupUB
{
	uint emissiveLookup[];
};
layout(std430, binding = 62) readonly buffer MegaLightsEmissiveTrianglesUB
{
	EmissiveTriangle emissiveTriangles[];
};
layout(std430, binding = 63) readonly buffer MegaLightsEmissivePowerUB
{
	float emissivePower[];
};
layout(std430, binding = 64) readonly buffer MegaLightsEmissiveDynamicSegmentsUB
{
	EmissiveSegment emissiveDynamicSegments[];
};
layout(std430, binding = 65) readonly buffer MegaLightsEmissiveDynamicTrianglesUB
{
	EmissiveTriangle emissiveDynamicTriangles[];
};
layout(std430, binding = 66) readonly buffer MegaLightsEmissiveDynamicPowerUB
{
	float emissiveDynamicPower[];
};
layout(std430, binding = 67) readonly buffer MegaLightsEmissiveGridUB
{
	vec4 emissiveGrid[];
};
#define EMISSIVE_LIGHTS_GRID
#include <Common/EmissiveLightsSampling.glslh>

Uniform(1) texture2D GBufferDepthTexture;  // device depth, reversed-Z (0 = far: no surface)
#define GBufferDepthTexture sampler2D(GBufferDepthTexture, PointClampSampler)
Uniform(2) texture2D GBufferNormalTexture; // rgb = world normal, a = roughness
#define GBufferNormalTexture sampler2D(GBufferNormalTexture, PointClampSampler)
#ifdef MEGALIGHTS_SHADING
Uniform(3) texture2D GBufferATexture;                 // rgb = albedo, a = metallic
#define GBufferATexture sampler2D(GBufferATexture, PointClampSampler)
layout(set = 0, binding = 4) uniform utexture2D GBufferShadingWordTexture;
#define GBufferShadingWordTexture usampler2D(GBufferShadingWordTexture, PointClampSampler)
#include <Generated/ShadingModels.glslh>
#endif

// The render resolution: the G-buffer's, the shading's and the denoiser's.
ivec2 MegaLightsViewSize()
{
	return ivec2(MegaLightsFrame.yz);
}

int MegaLightsDownsampleFactor()
{
	return max(int(MegaLightsFrame.w), 1);
}

// The sample pixels: one per factor x factor block of render pixels (the last block of a row may be partial).
ivec2 MegaLightsSampleSize()
{
	const int factor = MegaLightsDownsampleFactor();
	return (MegaLightsViewSize() + factor - 1) / factor;
}

uint MegaLightsSamplesPerPixel()
{
	return clamp(Counts.z, 1u, uint(MEGALIGHTS_MAX_SAMPLES));
}

// The local lights of the light grid (points, then spots): the lights before the emissive triangles.
int MegaLightsLocalLightCount()
{
	return int(Counts.x + Counts.y);
}

// The scene-lighting emissive triangles (0: none this frame).
int MegaLightsEmissiveTriangleCount()
{
	return int(EmissiveLightsTriangleCount(EmissiveCounts, EmissiveDynamicCounts));
}

// Every light of the index space: the local lights, then the emissive triangles.
int MegaLightsLightCount()
{
	return MegaLightsLocalLightCount() + MegaLightsEmissiveTriangleCount();
}

bool MegaLightsLightIsEmissive(int light)
{
	return light >= MegaLightsLocalLightCount();
}

ivec2 MegaLightsSampleTexel(ivec2 samplePixel, uint layer)
{
	return ivec2(samplePixel.x, samplePixel.y + int(layer) * MegaLightsSampleSize().y);
}

// ---- Random (PCG hash, Jarzynski & Olano 2020) -------------------------------------------------------------------
uint MegaLightsPcg(uint v)
{
	const uint state = v * 747796405u + 2891336453u;
	const uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

// One stream per pixel, frame and pass (@p pass tells the passes' streams apart).
uint MegaLightsSeed(ivec2 pixel, uint pass)
{
	return MegaLightsPcg(uint(pixel.x) + MegaLightsPcg(uint(pixel.y) + MegaLightsPcg(MegaLightsFrame.x * 8u + pass)));
}

float MegaLightsRandom(inout uint state)
{
	state = MegaLightsPcg(state);
	return float(state >> 8u) * (1.0 / 16777216.0);
}

// THE REPRESENTATIVE: the render pixel of the block a sample pixel stands for (UE MegaLights' downsampled
// screen coordinate, jittered every frame). The first SURFACE pixel of the block, counting from a start rotated
// per frame and block, so over frames every pixel of the block is sampled and a block half on the sky still finds
// its surface. Every pass of a frame derives the same pixel from the same frame index.
ivec2 MegaLightsScreenPixel(ivec2 samplePixel)
{
	const int   factor = MegaLightsDownsampleFactor();
	const int   cells  = factor * factor;
	const ivec2 size   = MegaLightsViewSize();
	const ivec2 corner = samplePixel * factor;
	const int   start  = int(MegaLightsPcg(MegaLightsFrame.x + MegaLightsPcg(uint(samplePixel.x) +
	                                                                  MegaLightsPcg(uint(samplePixel.y)))) %
	                         uint(cells));
	for (int i = 0; i < cells; ++i)
	{
		const int   cell  = (start + i) % cells;
		const ivec2 pixel = corner + ivec2(cell % factor, cell / factor);
		if (pixel.x < size.x && pixel.y < size.y && texelFetch(GBufferDepthTexture, pixel, 0).r > 0.0)
			return pixel;
	}
	return min(corner, size - 1);
}

// ---- The light index space (Mesh/LightGrid.glslh: points first, then spots) ----------------------------------
vec3 MegaLightsLightPosition(int light)
{
	const int points = int(Counts.x);
	return light < points ? pointLights[light].position : spotLights[light - points].position;
}

// A light without kLightShadowInView casts no shadow in this view (UE CastShadows off): visible without a ray.
bool MegaLightsLightCastsShadow(int light)
{
	const int points = int(Counts.x);
	return DesertLightShadowsInView(light < points ? pointLights[light].shadowFlags : spotLights[light - points].shadowFlags);
}

// UE SourceRadius (cm): the sphere a shadow ray aims at; 0 = a point.
float MegaLightsLightSourceRadius(int light)
{
	const int points = int(Counts.x);
	return light < points ? pointLights[light].sourceRadius : spotLights[light - points].sourceRadius;
}

// UE SourceLength: the capsule's half-segment, cm (Mesh/LightSources.glslh LightSourceHalfAxis); 0 = the sphere.
vec3 MegaLightsLightSourceHalfAxis(int light)
{
	const int points = int(Counts.x);
	return light < points ? LightSourceHalfAxis(pointLights[light]) : LightSourceHalfAxis(spotLights[light - points]);
}

// The light's contact shadow (Mesh/LightSources.glslh LightContactShadow: length, in world, intensities).
vec4 MegaLightsLightContactShadow(int light)
{
	const int points = int(Counts.x);
	return light < points ? LightContactShadow(pointLights[light]) : LightContactShadow(spotLights[light - points]);
}

// ---- The emissive triangles (after the local lights) ------------------------------------------------------------
// THE TRIANGLE AS AN AREA LIGHT (Mesh/LightSources.glslh DesertRectLightAt over three edges, Heitz et al. 2016): its
// vector irradiance V gives L = V / |V| and Radiance = radiance x |V|, so Radiance x dot(N, L) is the triangle's
// Lambert irradiance on a surface it lies wholly above. Emission is two-sided (EmissiveLightsNormal): V is turned
// toward the triangle whatever its winding. Received as a punctual light along L (zero rect extents): the
// specular lobe sees the triangle from its representative direction.
DesertLight MegaLightsEmissiveLightAt(uint triangle, vec3 worldPosition)
{
	DesertLight light;
	light.L                  = vec3(0.0, 0.0, 1.0);
	light.Radiance           = vec3(0.0);
	light.Shadow             = 1.0;
	light.TransmissionShadow = 1.0;
	light.RectCenter         = vec3(0.0);
	light.RectExtentX        = vec3(0.0);
	light.RectExtentY        = vec3(0.0);
	light.RectLuminance      = vec3(0.0);
	light.RectLtcTexture     = 0;
	light.SphereCenter       = vec3(0.0); // a triangle: its irradiance vector is the whole source
	light.SphereRadius       = 0.0;
	light.SphereAxis         = vec3(0.0);
	const EmissiveTriangle t = EmissiveLightsTriangle(triangle, EmissiveCounts);
	const vec3  a        = t.P0Area.xyz - worldPosition;
	const vec3  b        = a + t.Edge1Power.xyz;
	const vec3  c        = a + t.Edge2Segment.xyz;
	const float shortest = min(dot(a, a), min(dot(b, b), dot(c, c)));
	if (shortest <= 1e-8)
		return light; // the receiver is on the emitter
	const vec3 c0 = normalize(a);
	const vec3 c1 = normalize(b);
	const vec3 c2 = normalize(c);
	vec3 irradiance = (RectLightEdge(c0, c1) + RectLightEdge(c1, c2) + RectLightEdge(c2, c0)) * 3.14159265;
	if (dot(irradiance, a + b + c) < 0.0)
		irradiance = -irradiance;
	const float solidAngle = length(irradiance);
	if (solidAngle <= 0.0)
		return light;
	light.L        = irradiance / solidAngle;
	light.Radiance = EmissiveLightsRadiance(triangle, t, EmissiveCounts) * solidAngle;
	return light;
}

// The light as a shading model receives it, unshadowed (the target function's light and the shading's).
DesertLight MegaLightsLightAt(int light, vec3 worldPosition)
{
	const int points = int(Counts.x);
	if (MegaLightsLightIsEmissive(light))
		return MegaLightsEmissiveLightAt(uint(light - MegaLightsLocalLightCount()), worldPosition);
	return light < points ? DesertPointLightAt(pointLights[light], worldPosition)
	                      : DesertSpotLightAt(spotLights[light - points], worldPosition);
}

// ---- The pixel ------------------------------------------------------------------------------------------------
struct MegaLightsPixel
{
	bool  Valid;     // a surface (the G-buffer's normal is not the cleared zero, the depth is not the far plane)
	vec3  Position;  // world, cm
	vec3  N;         // unit world normal
	float ViewDepth; // clip w through ViewProjection: the distance the upsample scales its plane test by
#ifdef MEGALIGHTS_SHADING
	int           Model;
	DesertSurface Surface;
	DesertPayload Payload;
	float         SubsurfaceOpacity;   // DesertSubsurfaceOpacity (-1 = not a subsurface model): the contact shadow's
	vec3          DiffuseReflectance;  // Mesh/MegaLightsDemodulation.glslh: the diffuse signal's demodulation
	vec3          SpecularReflectance; // and the specular signal's
#endif
};

MegaLightsPixel MegaLightsLoadPixel(ivec2 pixel)
{
	MegaLightsPixel p;
	const float depth  = texelFetch(GBufferDepthTexture, pixel, 0).r;
	const vec4  gb     = texelFetch(GBufferNormalTexture, pixel, 0);
	p.Valid            = depth > 0.0 && dot(gb.rgb, gb.rgb) > 0.001;
	p.N                = p.Valid ? normalize(gb.rgb) : vec3(0.0, 0.0, 1.0);
	const vec2 uv      = (vec2(pixel) + 0.5) / vec2(MegaLightsViewSize());
	p.Position         = ReconstructWorldPosition(uv, depth, InverseJitteredViewProjection);
	p.ViewDepth        = (ViewProjection * vec4(p.Position, 1.0)).w;
#ifdef MEGALIGHTS_SHADING
	const vec4  ga        = texelFetch(GBufferATexture, pixel, 0);
	const float roughness = max(gb.a, kDesertMinRoughness); // as the composite floors it
	const vec3  V         = normalize(CameraPosition.xyz - p.Position);
	const uvec2 word      = texelFetch(GBufferShadingWordTexture, pixel, 0).rg;
	p.Model               = DesertShadingModelIndex(word);
	p.Payload             = DesertUnpackPayload(word);
	p.Surface             = DesertMakeSurface(p.Position, p.N, V, ga.rgb, ga.a, roughness, DesertShadingWordSpecular(word));
	p.SubsurfaceOpacity   = DesertSubsurfaceOpacity(p.Model, p.Payload);
	p.DiffuseReflectance  = MegaLightsDiffuseReflectance(ga.rgb, ga.a);
	p.SpecularReflectance = MegaLightsSpecularReflectance(ga.rgb, ga.a, roughness, p.N, V);
#endif
	return p;
}

#ifdef MEGALIGHTS_SHADING
// The light's unshadowed contribution at the pixel: what the shading multiplies by the sample's weight and
// visibility.
vec3 MegaLightsUnshadowed(MegaLightsPixel p, int light)
{
	return DesertEvaluateShadingModel(p.Model, MegaLightsLightAt(light, p.Position), p.Surface, p.Payload);
}

// The unshadowed contribution split into the shading model's two lobes (ShadingModels/ShadingModelContract.glslh
// EvaluateSpecular): x = diffuse (transmission included), y = specular - the two denoiser signals.
void MegaLightsUnshadowedLobes(MegaLightsPixel p, int light, out vec3 diffuse, out vec3 specular)
{
	const DesertLight L = MegaLightsLightAt(light, p.Position);
	const vec3 total    = DesertEvaluateShadingModel(p.Model, L, p.Surface, p.Payload);
	specular            = DesertEvaluateShadingModelSpecular(p.Model, L, p.Surface, p.Payload);
	diffuse             = max(total - specular, vec3(0.0));
}

// THE TARGET FUNCTION: the sampling weight of a light at the pixel, the PERCEIVED brightness of its unshadowed
// contribution (UE MegaLightsSampling.ush, log2(luminance x exposure + 1)): under linear luminance one bright light
// behind a wall takes every sample from the dim ones that do light the pixel.
float MegaLightsTargetPdf(MegaLightsPixel p, int light)
{
	if (light < 0 || light >= MegaLightsLightCount())
		return 0.0;
	const float luminance = max(dot(MegaLightsUnshadowed(p, light), vec3(0.2126, 0.7152, 0.0722)), 0.0);
	return log2(luminance * CameraPosition.w + 1.0);
}
#endif

#include <Common/MegaLightsSample.glslh>

// ---- Visibility --------------------------------------------------------------------------------------------------
#ifdef MEGALIGHTS_TRACE
// The includer defines CONTACT_SHADOW_* before this file is included: the G-buffer depth, the jittered matrix, the
// shading word (Common/ContactShadow.glslh).
#define CONTACT_SHADOW_DEPTH        GBufferDepthTexture
#define CONTACT_SHADOW_VP           JitteredWorldToClip
#define CONTACT_SHADOW_INV_VP       InverseJitteredViewProjection
#define CONTACT_SHADOW_SHADING_WORD GBufferShadingWordTexture
// The representative pixel being traced (a compute pass has no gl_FragCoord): set by the pass before each test.
vec2 g_MegaLightsTracedPixel = vec2(0.0);
#define CONTACT_SHADOW_PIXEL g_MegaLightsTracedPixel
#include <Common/ContactShadow.glslh>

#if defined(MEGALIGHTS_VISIBILITY_SCREEN)
// The light's slot in the frame's virtual shadow map (-1: not shadowed from it this frame).
int MegaLightsLightShadowMaskSlot(int light)
{
	const int points = int(Counts.x);
	return light < points ? pointLights[light].shadowMaskSlot : spotLights[light - points].shadowMaskSlot;
}

// THE SCREEN TRACE over the closest HZB, shared with the volume's froxel samples (Common/MegaLightsScreenTrace.glslh),
// through the matrices the G-buffer (and so the HZB) was rasterised with.
#define MEGALIGHTS_SCREEN_TRACE_WORLD_TO_CLIP JitteredWorldToClip
#define MEGALIGHTS_SCREEN_TRACE_CLIP_TO_WORLD InverseJitteredViewProjection
#define MEGALIGHTS_SCREEN_TRACE_EYE           CameraPosition.xyz
#include <Common/MegaLightsScreenTrace.glslh>
#endif

// AN EMISSIVE TRIANGLE'S TEST: one ray to a point uniform over the triangle (EmissiveLightsSamplePoint, two draws of
// the sample's stream: the shadow softens with the occluder's distance over frames, as the sphere's), off the
// surface as a local light's, stopped short of the emitter by the bias and a relative margin (the emitter's own
// surface is not its occluder). The ray query when the program has it, else the screen trace; no contact shadow
// and no virtual shadow map (the triangle has neither). Binary for every receiver, as MegaLightsVisibility.
float MegaLightsEmissiveVisibility(MegaLightsPixel p, int light, inout uint random)
{
	const uint             triangle = uint(light - MegaLightsLocalLightCount());
	const EmissiveTriangle t        = EmissiveLightsTriangle(triangle, EmissiveCounts);
	vec2 u;
	u.x = MegaLightsRandom(random);
	u.y = MegaLightsRandom(random);
	const float bias     = Params.z;
	const vec3  toPoint  = EmissiveLightsSamplePoint(t, u) - p.Position;
	const float distance = length(toPoint);
	if (distance <= 2.0 * bias)
		return 1.0; // on the emitter
	const vec3  dir    = toPoint / distance;
	const vec3  origin = p.Position + p.N * (dot(p.N, dir) >= 0.0 ? bias : -bias);
	const float reach  = max(distance - max(2.0 * bias, 1e-3 * distance), 0.0);
#if defined(MEGALIGHTS_VISIBILITY_RAY_QUERY)
	return RayQueryVisibility(origin, dir, reach, RAY_TRACING_MASK_SHADOW_CASTER);
#else
	return MegaLightsScreenTraceOccluded(origin, dir, reach) ? 0.0 : 1.0;
#endif
}

// THE ONE VISIBILITY TEST of a sample (UE MegaLights traces each sample once): 0..1, how much of @p light reaches
// the surface point @p p. The ray aims at a point of the light's source sphere, uniform in the solid angle it
// subtends (UE SampleSphereLight / UniformSampleCone: SourceRadius makes the shadow soft over frames), first
// marched through the screen depth as the light's contact shadow (UE MegaLights screen traces: the detail the TLAS
// does not hold), then one ray query over the TLAS from the point (off the surface along its normal, on the
// light's side: a ray that enters a leaf starts under its back, UE bFlipNormalBiasDirection) to the sphere, stopped
// short by the same bias. BINARY for every receiver, a thin leaf too (UE: only SUBSURFACE and SUBSURFACE_PROFILE
// measure a thickness): what a crown scatters beyond its first leaf is indirect light.
float MegaLightsVisibility(MegaLightsPixel p, int light, inout uint random)
{
	if (MegaLightsLightIsEmissive(light))
		return MegaLightsEmissiveVisibility(p, light, random);
	if (!MegaLightsLightCastsShadow(light))
		return 1.0;
	const float bias     = Params.z;
	const vec3  toLight  = MegaLightsLightPosition(light) - p.Position;
	const float distance = length(toLight);
	const float radius   = MegaLightsLightSourceRadius(light);
	const vec3  halfAxis = MegaLightsLightSourceHalfAxis(light);
	const float axis2    = dot(halfAxis, halfAxis);
	const bool  capsule  = axis2 > 0.0;
	// The receiver's distance to the emitter's segment (its centre for a sphere): on or inside the emitter = lit.
	const float along    = capsule ? clamp(dot(-toLight, halfAxis) / axis2, -1.0, 1.0) : 0.0;
	if (length(toLight + halfAxis * along) <= max(2.0 * bias, radius))
		return 1.0; // on or inside the emitter
	// Common/LightSourceSampling.glslh: the cone angle first, then the azimuth (two draws of the sample's stream),
	// then, for a tube, the point along its segment (a third).
	vec2  u        = vec2(0.0);
	float uLength  = 0.5;
	if (radius > 0.0)
	{
		u.x = MegaLightsRandom(random);
		u.y = MegaLightsRandom(random);
	}
	if (capsule)
		uLength = MegaLightsRandom(random);
	float      reach = distance;
	const vec3 dir   = SampleLightSourceCapsule(toLight, halfAxis, radius, u, uLength, reach);
	const float contact =
	     ContactShadowFactor(p.Position, p.N, dir, MegaLightsLightContactShadow(light), p.SubsurfaceOpacity);
	if (contact <= 0.0)
		return 0.0;
	const vec3  origin    = p.Position + p.N * (dot(p.N, dir) >= 0.0 ? bias : -bias);
	const float rayLength = max(reach - 2.0 * bias, 0.0);
#if !defined(MEGALIGHTS_VISIBILITY_RAY_QUERY) && !defined(MEGALIGHTS_VISIBILITY_SCREEN)
#error "MegaLights.glslh: MEGALIGHTS_TRACE needs a MEGALIGHTS_VISIBILITY_* source"
#endif
#if defined(MEGALIGHTS_VISIBILITY_RAY_QUERY) && defined(MEGALIGHTS_VISIBILITY_SCREEN)
	// A mixed program (a ray-query frame with Screen / VirtualMaps lamps): each light tests its own source, the
	// payload's ShadowVisibility (Common::Scalability::StochasticVisibility: 0 = RayQuery), resolved per light by
	// Graphic::ResolveLightVisibility - the source the state reports for it.
	const int points = int(Counts.x);
	const int source = light < points ? pointLights[light].shadowVisibility : spotLights[light - points].shadowVisibility;
	if (source == 0)
#endif
#if defined(MEGALIGHTS_VISIBILITY_RAY_QUERY)
	return contact * RayQueryVisibility(origin, dir, rayLength, RAY_TRACING_MASK_SHADOW_CASTER);
#endif
#if defined(MEGALIGHTS_VISIBILITY_SCREEN)
	if (MegaLightsScreenTraceOccluded(origin, dir, rayLength))
		return 0.0;
#if defined(MEGALIGHTS_VISIBILITY_VSM)
	// The occluders the screen does not hold: the light's virtual shadow map, its pages marked from this G-buffer
	// ("VSM: Mark Local") - slot = the light's index in the frame's VsmLocalLights (AssignLocalShadowMaskSlots).
	// The same sampled direction marched through the map (VsmLocalVisibilityRay, UE SMRT for a local light), so
	// SourceRadius softens the shadow with the occluder's distance, as the traced ray does.
	const int slot = MegaLightsLightShadowMaskSlot(light);
	if (slot >= 0)
		return contact * VsmLocalVisibilityRay(vsmLocalLights[slot], p.Position,
		                                       dot(p.N, dir) >= 0.0 ? p.N : -p.N, dir, rayLength, MegaLightsRandom(random));
#endif
	return contact;
#endif
}
#endif

#endif // MEGALIGHTS_GLSLH
