#ifndef MEGALIGHTS_TRACE_SAMPLES_GLSLH
#define MEGALIGHTS_TRACE_SAMPLES_GLSLH
// "MegaLights: Trace Samples", the one body of its three programs (one per Common::Scalability::
// StochasticVisibility): Programs/Shadows/MegaLightsTraceSamples.shader (ray query),
// MegaLightsTraceSamplesVirtual.shader (screen trace + virtual shadow map) and MegaLightsTraceSamplesScreen.shader
// (screen trace). The includer defines its MEGALIGHTS_VISIBILITY_* source, declares that source's resources and
// PointClampSampler, then includes this file (Common/MegaLights.glslh's MEGALIGHTS_TRACE contract).
#define MEGALIGHTS_SHADING
#define MEGALIGHTS_TRACE
#include <Common/MegaLights.glslh>

// MegaLightsSample (Common/MegaLightsSample.glslh), stacked layers: "MegaLights: Generate Samples"
layout(set = 0, binding = 10) uniform utexture2D SamplesTexture;
#define SamplesTexture usampler2D(SamplesTexture, PointClampSampler)
layout(binding = 11, rg32ui) writeonly uniform uimage2D OutSamplesTexture; // the same, with their visibility

LocalSize(8, 8, 1);

void main()
{
	const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy); // a sample pixel
	const ivec2 size  = MegaLightsSampleSize();
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;
	const uint            samples = MegaLightsSamplesPerPixel();
	const ivec2           screen  = MegaLightsScreenPixel(pixel);
	const MegaLightsPixel p       = MegaLightsLoadPixel(screen);
	g_MegaLightsTracedPixel       = vec2(screen) + 0.5;
	uint random                   = MegaLightsSeed(pixel, 3u);
	for (uint k = 0u; k < samples; ++k)
	{
		const ivec2      texel = MegaLightsSampleTexel(pixel, k);
		MegaLightsSample s     = MegaLightsUnpackSample(texelFetch(SamplesTexture, texel, 0).rg);
		if (s.Light >= 0)
			s.Visibility = p.Valid ? MegaLightsVisibility(p, s.Light, random) : 0.0;
		imageStore(OutSamplesTexture, texel, uvec4(MegaLightsPackSample(s), 0u, 0u));
	}
}

#endif // MEGALIGHTS_TRACE_SAMPLES_GLSLH
