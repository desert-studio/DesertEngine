#ifndef MESH_SDF_GRID_GLSLH
#define MESH_SDF_GRID_GLSLH

// THE NEAR FIELD'S FROXEL GRID (UE FLumenMeshSDFGridParameters, LumenMeshSDFCulling.usf, written from memory): the
// view cut into cells of DF_MESH_SDF_GRID_PIXEL_SIZE pixels and logarithmic depth slices out to
// DF_MESH_SDF_GRID_MAX_DISTANCE (Common/DistanceFieldShared.glslh). Each cell holds, in a fixed block of
// MeshSDFGridCellStride uints, its object count then the indices of at most DF_MESH_SDF_GRID_MAX_OBJECTS_PER_CELL
// objects whose world box lies within DF_MESH_SDF_TRACE_DISTANCE of the cell - every object a ray starting in the cell
// can reach in its near field, the closest kept when more do. Culled on the GPU every frame
// (Programs/DistanceField/MeshSDFCullGrid.shader, DistanceField::GlobalDistanceField::AddNearFieldCullPasses), read
// by the software tracer (Common/GITraceDistanceField.glslh) by a ray origin's cell.
//
// The one statement of the grid's placement and of the cell <-> depth mapping: the cull and the tracer include it.

#include <Common/DistanceFieldShared.glslh>

// std430 - DistanceField::MeshSDFGridPlacement (MeshDistanceFieldReads.hpp), 112 bytes.
struct MeshSDFGrid {
    mat4  worldToClip;   // the view's unjittered view-projection
    uvec4 cells;         // x, y = cells across the view, z = depth slices, w = cells in all
    vec4  zDistribution; // DF_MESH_SDF_GRID_LOG_Z_SCALE, _LOG_Z_OFFSET, _Z_SCALE, DF_MESH_SDF_GRID_PIXEL_SIZE
    vec4  screen;        // xy = the view's extent in pixels, zw = 1 / that
};

const uint MeshSDFGridCellStride = 1u + uint( DF_MESH_SDF_GRID_MAX_OBJECTS_PER_CELL );

// The depth slice of view depth @p depth (cm), fractional.
float MeshSDFGridSliceAt( MeshSDFGrid grid, float depth )
{
    return log2( max( depth, 0.0 ) * grid.zDistribution.x + grid.zDistribution.y ) * grid.zDistribution.z;
}

// The view depth (cm) where slice @p slice begins.
float MeshSDFGridSliceDepth( MeshSDFGrid grid, float slice )
{
    return ( exp2( slice / grid.zDistribution.z ) - grid.zDistribution.y ) / grid.zDistribution.x;
}

// The cell holding world position @p position, or -1 outside the grid (behind the camera, off the view, past
// DF_MESH_SDF_GRID_MAX_DISTANCE): no near field there.
int MeshSDFGridCellAt( MeshSDFGrid grid, vec3 position )
{
    const vec4 clip = grid.worldToClip * vec4( position, 1.0 );
    if ( clip.w <= 0.0 )
        return -1;
    const vec2 ndc = clip.xy / clip.w;
    if ( any( greaterThan( abs( ndc ), vec2( 1.0 ) ) ) )
        return -1;
    const float slice = floor( MeshSDFGridSliceAt( grid, clip.w ) );
    if ( slice >= float( grid.cells.z ) )
        return -1;
    const uvec2 xy = min( uvec2( ( ndc * 0.5 + 0.5 ) * grid.screen.xy / grid.zDistribution.w ), grid.cells.xy - 1u );
    return int( ( uint( max( slice, 0.0 ) ) * grid.cells.y + xy.y ) * grid.cells.x + xy.x );
}

// THE CULL'S RECORD (std430 - DistanceField::MeshSDFCullPayload, 304 bytes): the grid, the way back from a cell to
// the world, the near field's frustum, the object count.
struct MeshSDFCullParams {
    MeshSDFGrid grid;
    mat4        clipToWorld; // the inverse of grid.worldToClip
    vec4        clipDepth;   // the projection's clip z and w as functions of view z: z = x * vz + y, w = z * vz + w
    vec4        planes[6];   // world, inward: dot( xyz, p ) + w >= 0 inside - the view's four sides, the camera's
                             // plane, the plane at DF_MESH_SDF_GRID_MAX_DISTANCE
    uvec4       counts;      // x = objects in the object buffer
};

#endif // MESH_SDF_GRID_GLSLH
