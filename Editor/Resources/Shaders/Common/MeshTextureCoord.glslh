#ifndef DESERT_MESH_TEXTURE_COORD_GLSLH
#define DESERT_MESH_TEXTURE_COORD_GLSLH

// THE ONE MESH UV CONVENTION. An engine mesh vertex (Desert::Vertex) stores its texture coordinates as imported
// (origin bottom-left, V up); a texture is addressed from its top-left. Every reader of a mesh vertex's UV turns the
// stored value into the texture's coordinate HERE: the raster vertex paths (Mesh/Surface/Vertex_*.glslh), the ray
// tracing hit fetch of a surface template (Mesh/Surface/Pass_RayHit.glslh) and the ray-query alpha test of a masked
// mesh segment (Common/RayQueryVisibility.glslh). A second spelling of it is how the hit group sampled an atlas
// mirrored (PT-PARITY-2: Bistro's hanging baskets, whose leaves sit at the bottom of the pansy atlas, traced as the
// pansies at its top). Not for geometry with its own vertex convention (3D text, landscape tiles).
vec2 DesertMeshTextureUV( vec2 stored )
{
    return vec2( stored.x, 1.0 - stored.y );
}

#endif
