#ifndef PARTICLE_POOL_GLSLH
#define PARTICLE_POOL_GLSLH

// One slot of an emitter's Counters buffer (ParticleGpuLayout.hpp kParticleDrawSlotStride = 32, two slots per
// emitter). The first four uints ARE a VkDrawIndirectCommand: the billboard draw reads the last compact's slot as
// its indirect arguments. VertexCount is 6 x the particles the compact found alive (it is the alive counter, added
// to by six), FirstVertex is 6 x the emitter's pool base, so the billboard's gl_VertexIndex / 6 is the alive-list
// entry (Base + k). FreeCount counts the free-list entries. ParticleCompact of compact c fills slot (c & 1) and
// resets slot ((c + 1) & 1) for the next compact; the host simulation program (ParticleSimulate.shader) of step s
// reads slot (s & 1), the one compact s filled before it.
// The thread-group size of ParticleSimulate and ParticleCompact (ParticleGpuLayout.hpp kParticleLocalSize): the
// divisor ParticleDispatchArgs turns thread counts into group counts with.
#define PARTICLE_GROUP_SIZE 64u

// Alive lists: each emitter has two halves, [2 Base + h Count, 2 Base + (h + 1) Count); compact c writes half c & 1
// and slot c & 1 (FirstVertex = 6 x the half's start), compact c+1 reads half c & 1 back.
struct ParticleDrawSlot
{
    uint VertexCount;
    uint InstanceCount;
    uint FirstVertex;
    uint FirstInstance;
    uint FreeCount;
    uint Touched; // the particles compact c+1 scans: compact c's alive + step c's spawned
    uint Pad1;
    uint Pad2;
};

// THE POOL SLOT, declared once: the engine's bookkeeping for one entry of the scene's particle pool, and NOTHING of
// the particle's data. The particle itself - Position, Color, SpriteSize, SpriteRotation, Age, Lifetime, Velocity
// and whatever else its module stack declares - lives in ONE place, the emitter's SoA attribute columns
// (VFXDataSetLayout; the host simulation program writes them, the sprite vertex path and the sort read them through
// Common/ParticleDrawLayout.glslh), as UE Niagara's FNiagaraDataBuffer is the one store its sprite renderer reads.
// What is left is what is not an attribute (UE: the data set's ID-to-index table and its instance count): the id
// the particle's random streams are keyed by, carried between steps, and whether the slot holds a live particle -
// the simulation clears Alive when the stack kills it, the compact frees a slot whose Alive is 0, a reset zeroes
// the slot.
//
// THE C++ STATEMENT OF THE SIZE is Graphic::System::kParticleSlotStride (ParticleGpuLayout.hpp), which allocates
// the pool; Tests/Engine/ShaderCacheKey asserts the array stride every stage compiled against it.
//
// FIELDS ARE APPENDED, NEVER INSERTED, and kParticleSlotStride is appended with them.
struct ParticleSlot
{
    uint Id;    // the particle's id (its random streams are keyed by it), written at spawn, carried by every step
    uint Alive; // 1 = a live particle; 0 = free (never spawned, reset, or killed by its stack this step)
};

#endif // PARTICLE_POOL_GLSLH
