#ifndef DESERT_PATH_TRACING_DENOISE_GLSLH
#define DESERT_PATH_TRACING_DENOISE_GLSLH

// THE PATH TRACER'S DENOISER GUIDES, spelled once for the writer (Programs/PathTracing/PathTracer.shader: each path
// adds its first surface's guides to the view's guide sums) and the reader (Programs/PathTracing/
// PathTracerDenoise.shader: the spatial denoiser over sum / count). UE 5.8 keeps the same contract between its path
// tracer and its denoiser plugin (PathTracing.cpp: the albedo and normal accumulated per pixel beside the radiance,
// averaged by the sample count before the denoiser reads them).
//
// Each path splits its radiance at its first opaque surface (glass is looked through to the surface behind it):
//   E = what it gathered before that surface's lighting - the sky it left the scene to, the emission of the
//       surface itself, an emitter met on the way through glass - which the surface's albedo does not modulate, and
//   R = the rest, the light the surface reflects, which it does: R = D * I with D its demodulation albedo
//       (PathTracingDenoiseAlbedo floored at kPathTracingAlbedoFloor per channel) and I the illumination.
// Only I is filtered (SVGF 4.1 demodulation, per path, so a pixel's emitters or sky are never divided by an
// albedo and spread onto neighbours that multiply them by theirs).
//
// GuideAlbedo:  rgb = the sum of each surface path's D, a = the number of surface paths s (a path that left the
//               scene adds nothing to any guide).
// GuideNormal:  xyz = the sum of each surface path's first-surface world normal, w = the sum of its distance from
//               the camera in cm.
// Demodulated:  rgb = the sum of each surface path's I, a = the sum of lum(I)^2 (the second moment of the signal
//               the filter smooths, from which its variance is estimated).
// All three are divided by s before use; a pixel with s = 0 saw no surface (PathTracingDenoiseSurfaceDepth).

// The camera distance a pixel no path of which met a surface reads (cm, 1000 km): far past any scene, so a sky
// pixel never passes the depth test against a surface beside it.
const float kPathTracingMissDepth = 1.0e8;

// The smallest albedo channel a path's reflected radiance is divided by: the dielectric F0 (4 %), which every
// non-metal's PathTracingDenoiseAlbedo holds anyway, so the floor only binds on a black metal channel; it bounds
// the illumination a channel the surface barely reflects in (its specular part) to 25 x what it reflects.
const float kPathTracingAlbedoFloor = 0.04;

// Below this many surface paths a pixel's illumination is a few heavy-tailed samples: its luminance tells a firefly
// from a dark path, not a lighting edge from a flat one. The variance pass then suppresses the pixel's fireflies
// (NRD ReLAX's firefly suppression) and the filter's first two iterations spread by normal and depth only.
const float kPathTracingDenoiseSpreadPaths = 16.0;

float PathTracingDenoiseLuminance(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// The edge-stopping distance of illumination b from a, per channel (SVGF 4.3 weighs by luminance only, which lets a
// spike in one channel - a blue specular path demodulated by a brown cobble's small blue albedo - pass and spread
// onto a neighbour that reflects more blue: a coloured speckle). Each channel's standard deviation is taken
// proportional to a's colour (the noise of one path is the noise of its throughput, shared by the channels), so
// with relativeWidth = the luminance width / lum(a) channel c is compared over relativeWidth * a.c; the distance is
// the largest of the three.
float PathTracingDenoiseChannelDistance(vec3 a, vec3 b, float relativeWidth)
{
    const vec3 d = abs(b - a) / (relativeWidth * a + 1.0e-10);
    return max(d.r, max(d.g, d.b));
}

// The albedo the denoiser demodulates by: what the surface reflects of white light at normal incidence, the
// diffuse share (base colour x (1 - metallic)) plus the specular reflectance F0, capped at 1.
vec3 PathTracingDenoiseAlbedo(vec3 baseColor, float metallic, vec3 f0)
{
    return min(baseColor * (1.0 - metallic) + f0, vec3(1.0));
}

// D, the albedo a path's reflected radiance is divided by (demodulation) and the pixel's mean D multiplies the
// filtered illumination by (remodulation).
vec3 PathTracingDemodulationAlbedo(vec3 albedo)
{
    return max(albedo, vec3(kPathTracingAlbedoFloor));
}

// The camera distance of a pixel's surface from its guide sums: the mean over its surface paths, or
// kPathTracingMissDepth when none met a surface.
float PathTracingDenoiseSurfaceDepth(vec4 normalSum, float surfacePaths)
{
    return surfacePaths > 0.5 ? normalSum.w / surfacePaths : kPathTracingMissDepth;
}

#endif
