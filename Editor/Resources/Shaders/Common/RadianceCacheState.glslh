#ifndef RADIANCE_CACHE_STATE_GLSLH
#define RADIANCE_CACHE_STATE_GLSLH

// THE RADIANCE CACHE UPDATE'S STATE, as every pass of the update declares it (Programs/GlobalIllumination/
// RadianceCache*.shader; the C++ side is Graphic/GlobalIllumination/WorldRadianceCache). Persistent across frames:
// the indirection (toroidal, Common/RadianceCache.glslh), the frame each entry was last read, the probe slots and
// their free list. Per frame: the schedule (priority histogram, then the probes this frame traces).
#include <Common/RadianceCache.glslh>

ReadBuffer(0) RadianceCacheParamsUB
{
    RadianceCacheParams radianceCache;
};
Buffer(1) RadianceCacheIndirectionUB
{
    uint radianceCacheIndirection[];
};
// Two words per indirection entry (RadianceCacheStampIndex): the last frame a COVERAGE reader stamped it - a read
// that interpolates this clipmap's cells itself - and the last frame the FALLBACK stamped it (RadianceCacheMark: the
// clipmap past a pixel's coarse end, read only while the coverage's own cells are untraced). Allocate ranks a new
// probe by which of the two stamped it this frame; Update frees by the later of the two.
Buffer(2) RadianceCacheLastUsedUB
{
    uint radianceCacheLastUsed[];
};
#define RC_STAMP_COVERAGE 0u
#define RC_STAMP_FALLBACK 1u
uint RadianceCacheStampIndex( uint entry, uint kind )
{
    return entry * 2u + kind;
}
Buffer(3) RadianceCacheProbesUB
{
    RadianceCacheProbe radianceCacheProbes[];
};
// [0] = free slots, then the free slot indices, then two words (RadianceCacheFailedAllocationsWord): the reads that
// found no free slot in the last frame of each FrameIndex parity.
Buffer(4) RadianceCacheFreeListUB
{
    int radianceCacheFreeList[];
};
// [0, RC_PRIORITY_BUCKETS) the priority histogram (RC_PRIORITY_*), then the traced count, the threshold bucket's
// taken count, the update's event counters (RC_STAT_*), and the traced probes. Mark, the update's first pass, clears
// all but the list.
Buffer(5) RadianceCacheScheduleUB
{
    uint radianceCacheSchedule[];
};

#define RC_PRIORITY_BUCKETS 38u // RadianceCache::kPriorityBuckets
#define RC_SCHEDULE_COUNT RC_PRIORITY_BUCKETS
#define RC_SCHEDULE_TAKEN ( RC_PRIORITY_BUCKETS + 1u )
// THE UPDATE'S COUNTERS (PROBE-TRACE-COST-3): one word per event of this frame. Select copies them, with the
// histogram's sums, to RadianceCache.UpdateCounts (WorldRadianceCache::LastUpdateCounts, the profile line
// "RadianceCache update"), so a camera turn shows where its probes go: freed and why, allocated, refused a slot.
#define RC_SCHEDULE_STATS ( RC_PRIORITY_BUCKETS + 2u )
#define RC_STAT_ALLOCATED      0u // Allocate: an empty entry a reader stamped took a slot
#define RC_STAT_FAILED         1u // Allocate: ... and found none (the atlas is full)
#define RC_STAT_FREED_STALE    2u // Update: the clipmap scrolled past the probe's cell
#define RC_STAT_FREED_UNUSED   3u // Update: unread for more than UnusedFrames
#define RC_STAT_FREED_PRESSURE 4u // Update: unread for more than the pressure's keep but not UnusedFrames
#define RC_STAT_PRESSED        5u // Update: 1 when the last frame refused a slot (the pressure's keep applies)
#define RC_STAT_WORDS          6u // WorldRadianceCache.cpp kScheduleCounters
#define RC_SCHEDULE_LIST ( RC_SCHEDULE_STATS + RC_STAT_WORDS )
// The words Select writes to RadianceCache.UpdateCounts, in this order (GlobalIllumination::RadianceCacheUpdateCounts,
// WorldRadianceCache.hpp).
#define RC_COUNT_STAMPED                 0u // entries a reader stamped this frame due a trace (the histogram's sum)
#define RC_COUNT_NEVER_TRACED            1u // ... by a coverage reader, whose probe was never traced
#define RC_COUNT_TRACED                  2u // probes traced this frame: min(stamped, budget)
#define RC_COUNT_BUDGET                  3u // the Select pass's budget (radianceCache.atlas.z)
#define RC_COUNT_EVENTS                  4u // RC_STAT_WORDS words: the counters above, in their order
#define RC_COUNT_LIVE                    ( RC_COUNT_EVENTS + RC_STAT_WORDS ) // slots held after Allocate
#define RC_COUNT_MAX_PROBES              ( RC_COUNT_LIVE + 1u )
#define RC_COUNT_NEVER_TRACED_BY_CLIPMAP ( RC_COUNT_MAX_PROBES + 1u ) // RADIANCE_CACHE_MAX_CLIPMAPS words: coverage
// RADIANCE_CACHE_MAX_CLIPMAPS words: the entries only the fallback stamped, never traced, per clipmap
#define RC_COUNT_FALLBACK_BY_CLIPMAP     ( RC_COUNT_NEVER_TRACED_BY_CLIPMAP + RADIANCE_CACHE_MAX_CLIPMAPS )
#define RC_COUNT_WORDS                   ( RC_COUNT_FALLBACK_BY_CLIPMAP + RADIANCE_CACHE_MAX_CLIPMAPS ) // 24
// THE BUDGET GOES TO THE COVERAGE FIRST (UE Lumen Radiance Cache: a probe is marked in the clipmap that covers the
// read point, the frame's budget traces the new probes first, then the longest untraced; a coarser level is the
// fallback for what the coverage does not answer). From the top bucket down:
//   NEW COVERAGE  a never-traced probe a coverage reader stamped this frame (RC_STAMP_COVERAGE): the cells the screen
//                 probes' covered rays and the irradiance readers interpolate themselves. Finest clipmap first: a
//                 clipmap 0 cell is read from the camera out, the cells of the others only in their shell past the
//                 finer clipmap, so a fine cell answers at least as many reads.
//   NEW FALLBACK  a never-traced probe only the fallback stamped (RC_STAMP_FALLBACK: the clipmap past a pixel's
//                 coarse end, RadianceCacheRadianceAt's answer while the coverage's own cells are untraced): traced
//                 from what the new coverage probes leave of the budget, finest first, and before any re-trace, so
//                 the edge of a clipmap keeps its fallback level.
//   LIGHTS CHANGED, then the age of the last trace (oldest first), whoever stamped the probe.
#define RC_PRIORITY_NEW_COVERAGE   ( RC_PRIORITY_BUCKETS - RADIANCE_CACHE_MAX_CLIPMAPS )
#define RC_PRIORITY_NEW_FALLBACK   ( RC_PRIORITY_NEW_COVERAGE - RADIANCE_CACHE_MAX_CLIPMAPS )
#define RC_PRIORITY_LIGHTS_CHANGED ( RC_PRIORITY_NEW_FALLBACK - 1u )
// FPS-RC-COST: a read probe that is due no trace this frame - no event (never traced, lights changed, traced before
// the last full update) and traced fewer than RefreshMinFrames frames ago. It ranks in no bucket: Select skips it,
// so the budget goes to the probes that need it instead of re-tracing a converged one every frame.
#define RC_PRIORITY_NOT_DUE        RC_PRIORITY_BUCKETS
// The bucket of a never-traced probe of @p clipmap: of the coverage when @p covered, else of the fallback.
uint RadianceCacheNewProbeBucket( bool covered, uint clipmap )
{
    const uint group = covered ? RC_PRIORITY_NEW_COVERAGE : RC_PRIORITY_NEW_FALLBACK;
    return group + RADIANCE_CACHE_MAX_CLIPMAPS - 1u - clipmap;
}

PushConstant RadianceCachePush
{
    uint  FrameIndex;       // 1, 2, ... (0 = never)
    uint  Reset;            // 1: the state is (re)initialised this frame
    uint  MaxProbes;        // probe slots
    uint  UnusedFrames;     // RadianceCache::kProbeUnusedFramesBeforeFree
    uint  Width;            // G-buffer extent
    uint  Height;
    float HistoryWeight;          // RadianceCache::kHistoryWeight
    float DirtyHistory;     // RadianceCache::kDirtyHistoryWeight
    uint  LightingFrame;    // the frame of the last full update: a probe last traced before it has no history
    uint  MarkFallback;     // 1: Mark stamps the clipmap past the coarse end (the screen probes' fallback)
    uint  RefreshMinFrames; // RadianceCache::kProbeRefreshMinFrames: an event-less probe's frames between traces
};

// THE ATLAS UNDER PRESSURE (PROBE-TURN-1; not in UE, which keeps an unread probe NumFramesToKeepCachedProbes frames
// whatever the atlas holds and leaves the overflow's cells empty): the word Allocate counts the cells of the frame of
// @p frameIndex's parity that found no free slot in. Update clears this frame's before Allocate counts it, and reads
// the last frame's: after a frame that dropped reads, a probe nobody stamped within the pixels' 2x2 rotation
// (RadianceCacheMark.shader: each pixel of a block marks every fourth frame) gives its slot back at once instead of
// after UnusedFrames - a camera turn's swept cells give way to this frame's reads, which an empty cell sends on to
// the full trace distance (ScreenProbes: Trace Cache Miss).
uint RadianceCacheFailedAllocationsWord( uint maxProbes, uint frameIndex )
{
    return 1u + maxProbes + ( frameIndex & 1u );
}
#define RADIANCE_CACHE_PRESSURE_KEEP_FRAMES 3u // an unread probe's frames under pressure: the rotation's 4 less one

#endif // RADIANCE_CACHE_STATE_GLSLH
