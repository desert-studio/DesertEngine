#ifndef RADIANCE_CACHE_STATE_GLSLH
#define RADIANCE_CACHE_STATE_GLSLH

// THE RADIANCE CACHE UPDATE'S STATE, as every pass of the update declares it (Programs/GlobalIllumination/
// RadianceCache*.shader; the C++ side is Graphic/GlobalIllumination/WorldRadianceCache). Persistent across frames:
// the indirection (toroidal, Common/RadianceCache.glslh), the frame each entry was last read, the probe slots and
// their free list. Per frame: the schedule (priority histogram, then the probes this frame traces).
#include <Common/RadianceCache.glslh>

ReadBuffer(0) RadianceCacheParamsUB
{
    RadianceCacheParams radianceCache;
};
Buffer(1) RadianceCacheIndirectionUB
{
    uint radianceCacheIndirection[];
};
// Two words per indirection entry (RadianceCacheStampIndex): the last frame a COVERAGE reader stamped it - a read
// that interpolates this clipmap's cells itself - and the last frame the FALLBACK stamped it (RadianceCacheMark: the
// clipmap past a pixel's coarse end, read only while the coverage's own cells are untraced). Allocate ranks a new
// probe by which of the two stamped it this frame; Mark's free part (RadianceCacheMark.shader) frees by the later of
// the two. Two more words per entry (RC_ENTRY_BRDF_BINS, FPS-RADIANCE-CACHE-BRDF): the READ DIRECTIONS - a 64-bit
// mask of the 8x8 octahedral bins (RadianceCacheBrdfBin) of the normals of the coverage readers that stamped the
// entry since its probe was last traced. Mark ORs them in; Select reads and clears them when it lists the probe and
// supersamples the squares those normals face (UE's probe BRDF and SupersampleTileBRDFThreshold); the Reset clears
// them. A freed entry keeps its bins (Mark's free runs beside this frame's stamps, so clearing there could drop them):
// the entry's next probe traces their squares once more, and its first trace clears them.
Buffer(2) RadianceCacheLastUsedUB
{
    uint radianceCacheLastUsed[];
};
#define RC_STAMP_COVERAGE  0u
#define RC_STAMP_FALLBACK  1u
#define RC_ENTRY_BRDF_BINS 2u // two words: bins 0..31, 32..63
#define RC_ENTRY_WORDS     4u // WorldRadianceCache.cpp kLastUsedEntryWords
uint RadianceCacheStampIndex( uint entry, uint kind )
{
    return entry * RC_ENTRY_WORDS + kind;
}
// The octahedral bin of a reader's normal @p N: 8x8 bins over RadianceCacheOctEncode's square, bin = y * 8 + x.
#define RC_BRDF_BINS_SIDE 8u
uint RadianceCacheBrdfBin( vec3 N )
{
    const uvec2 b = min( uvec2( ( RadianceCacheOctEncode( N ) * 0.5 + 0.5 ) * float( RC_BRDF_BINS_SIDE ) ),
                         uvec2( RC_BRDF_BINS_SIDE - 1u ) );
    return b.y * RC_BRDF_BINS_SIDE + b.x;
}
// The normal at the centre of bin @p bin.
vec3 RadianceCacheBrdfBinNormal( uint bin )
{
    const vec2 o = ( vec2( bin % RC_BRDF_BINS_SIDE, bin / RC_BRDF_BINS_SIDE ) + 0.5 ) / float( RC_BRDF_BINS_SIDE );
    return RadianceCacheOctDecode( o * 2.0 - 1.0 );
}
// A 64-bit mask (x = bits 0..31, y = 32..63) with bit @p i set, and whether @p mask has bit @p i.
uvec2 RadianceCacheMaskBit( uint i )
{
    return i < 32u ? uvec2( 1u << i, 0u ) : uvec2( 0u, 1u << ( i - 32u ) );
}
bool RadianceCacheMaskHas( uvec2 mask, uint i )
{
    return ( ( i < 32u ? mask.x >> i : mask.y >> ( i - 32u ) ) & 1u ) != 0u;
}
Buffer(3) RadianceCacheProbesUB
{
    RadianceCacheProbe radianceCacheProbes[];
};
// [0] = free slots, then the free slot indices, then two words (RadianceCacheFailedAllocationsWord): the reads that
// found no free slot in the last frame of each FrameIndex parity.
Buffer(4) RadianceCacheFreeListUB
{
    int radianceCacheFreeList[];
};
// [0, RC_PRIORITY_BUCKETS) the priority histogram (RC_PRIORITY_*), then the traced count, the threshold bucket's
// taken count, the update's event counters (RC_STAT_*), the trace tile count and Select's finished groups, then the
// traced probes (the budget's radianceCache.atlas.z words) and their trace tiles (RadianceCacheTraceTileList). The
// header (RC_SCHEDULE_LIST words) is zeroed by the graph's upload before Mark (WorldRadianceCache::AddUpdatePasses):
// every pass of the update may count into it from its first thread.
Buffer(5) RadianceCacheScheduleUB
{
    uint radianceCacheSchedule[];
};

#define RC_PRIORITY_BUCKETS 38u // RadianceCache::kPriorityBuckets
#define RC_SCHEDULE_COUNT RC_PRIORITY_BUCKETS
#define RC_SCHEDULE_TAKEN ( RC_PRIORITY_BUCKETS + 1u )
// THE UPDATE'S COUNTERS (PROBE-TRACE-COST-3): one word per event of this frame. Select copies them, with the
// histogram's sums, to RadianceCache.UpdateCounts (WorldRadianceCache::LastUpdateCounts, the profile line
// "RadianceCache update"), so a camera turn shows where its probes go: freed and why, allocated, refused a slot.
#define RC_SCHEDULE_STATS ( RC_PRIORITY_BUCKETS + 2u )
#define RC_STAT_ALLOCATED      0u // Allocate: an empty entry a reader stamped took a slot
#define RC_STAT_FAILED         1u // Allocate: ... and found none (the atlas is full)
#define RC_STAT_FREED_STALE    2u // Mark's free part: the clipmap scrolled past the probe's cell
#define RC_STAT_FREED_UNUSED   3u // Mark's free part: unread for more than UnusedFrames
#define RC_STAT_FREED_PRESSURE 4u // Mark's free part: unread for more than the pressure's keep but not UnusedFrames
#define RC_STAT_PRESSED        5u // Mark's free part: 1 when the last frame refused a slot (the pressure's keep applies)
#define RC_STAT_WORDS          6u // WorldRadianceCache.cpp kScheduleCounters
// The trace tiles Select listed (RadianceCacheTraceTileList), and how many of Select's groups are done: the last one
// writes Trace's and Filter's indirect arguments from the final counts (RadianceCacheSelect.shader).
#define RC_SCHEDULE_TILES       ( RC_SCHEDULE_STATS + RC_STAT_WORDS )
#define RC_SCHEDULE_SELECT_DONE ( RC_SCHEDULE_TILES + 1u )
#define RC_SCHEDULE_LIST        ( RC_SCHEDULE_SELECT_DONE + 1u ) // WorldRadianceCache.cpp kScheduleHeaderWords
// THE TRACE TILES (UE GenerateProbeTraceTiles, LumenRadianceCache.usf): one word per 8x8 tile of RAYS of a listed
// probe, after the budget's list. A tile traces at one of three LEVELS (FPS-RADIANCE-CACHE-BRDF, UE's trace tile
// levels): FULL - one ray per atlas texel, an 8x8 SQUARE of the probe's texels (the supersampled squares) -, HALF - one
// ray per 2x2 texels, 2x2 squares (the base of a near probe) - and QUARTER - one ray per 4x4 texels, 4x4 squares (a
// probe past the downsample distance, or read only as the fallback). A HALF tile carries the 2x2 squares it skips
// (RADIANCE_CACHE_TRACE_TILE_SKIP: bit (y * 2 + x) for its square (x, y)) because FULL tiles of the same probe trace
// them; every texel of a listed probe is written by exactly one tile. Word: the tile's index in its level's grid of
// tiles (bits 0..5), the skipped squares (6..9), the level (10..11), the probe's slot (12..31).
uint RadianceCacheTraceTileList( uint budget )
{
    return RC_SCHEDULE_LIST + budget;
}
#define RADIANCE_CACHE_TRACE_LEVEL_FULL    0u
#define RADIANCE_CACHE_TRACE_LEVEL_HALF    1u
#define RADIANCE_CACHE_TRACE_LEVEL_QUARTER 2u
#define RADIANCE_CACHE_TRACE_TILE_MASK     0x3Fu // the tile's index: up to 8x8 squares (ProbeResolution <= 64)
#define RADIANCE_CACHE_TRACE_TILE_SKIP_SHIFT  6u
#define RADIANCE_CACHE_TRACE_TILE_LEVEL_SHIFT 10u
#define RADIANCE_CACHE_TRACE_TILE_PROBE_SHIFT 12u // WorldRadianceCache.cpp kMaxTraceTileProbes
uint RadianceCacheTraceTileWord( uint probe, uint level, uint skip, uint tile )
{
    return ( probe << RADIANCE_CACHE_TRACE_TILE_PROBE_SHIFT ) | ( level << RADIANCE_CACHE_TRACE_TILE_LEVEL_SHIFT ) |
           ( skip << RADIANCE_CACHE_TRACE_TILE_SKIP_SHIFT ) | tile;
}
// The traced resolution of a probe of @p res texels a side at @p level: res, half or a quarter of it (rounded up).
uint RadianceCacheTraceResolution( uint res, uint level )
{
    const uint stride = 1u << level;
    return ( res + stride - 1u ) / stride;
}
// The 8x8 tiles a side of a probe of @p res texels a side at @p level.
uint RadianceCacheTraceTilesPerSide( uint res, uint level )
{
    return ( RadianceCacheTraceResolution( res, level ) + 7u ) / 8u;
}
// HALF tile @p h (of @p halves a side) covers the squares (2x + i, 2y + j) of a probe of @p squares a side: the 4-bit
// mask (bit j * 2 + i) of those the probe has (an edge tile of an odd square count has fewer).
uint RadianceCacheHalfTileSquares( uint h, uint halves, uint squares )
{
    const uvec2 first = uvec2( h % halves, h / halves ) * 2u;
    uint        mask  = 0u;
    for ( uint q = 0u; q < 4u; ++q )
        if ( first.x + ( q & 1u ) < squares && first.y + ( q >> 1 ) < squares )
            mask |= 1u << q;
    return mask;
}
// ... and of those, the squares supersampled in @p super (bit y * squares + x): the ones the HALF tile skips.
uint RadianceCacheHalfTileSkip( uvec2 super, uint h, uint halves, uint squares )
{
    const uvec2 first = uvec2( h % halves, h / halves ) * 2u;
    uint        skip  = 0u;
    for ( uint q = 0u; q < 4u; ++q )
    {
        const uvec2 s = first + uvec2( q & 1u, q >> 1 );
        if ( s.x < squares && s.y < squares && RadianceCacheMaskHas( super, s.y * squares + s.x ) )
            skip |= 1u << q;
    }
    return skip;
}
// The words Select writes to RadianceCache.UpdateCounts, in this order (GlobalIllumination::RadianceCacheUpdateCounts,
// WorldRadianceCache.hpp).
#define RC_COUNT_STAMPED                 0u // entries a reader stamped this frame due a trace (the histogram's sum)
#define RC_COUNT_NEVER_TRACED            1u // ... by a coverage reader, whose probe was never traced
#define RC_COUNT_TRACED                  2u // probes Select listed this frame (the cut's total, RadianceCacheSelect)
#define RC_COUNT_BUDGET                  3u // the Select pass's budget (radianceCache.atlas.z)
#define RC_COUNT_EVENTS                  4u // RC_STAT_WORDS words: the counters above, in their order
#define RC_COUNT_LIVE                    ( RC_COUNT_EVENTS + RC_STAT_WORDS ) // slots held after Allocate
#define RC_COUNT_MAX_PROBES              ( RC_COUNT_LIVE + 1u )
#define RC_COUNT_NEVER_TRACED_BY_CLIPMAP ( RC_COUNT_MAX_PROBES + 1u ) // RADIANCE_CACHE_MAX_CLIPMAPS words: coverage
// RADIANCE_CACHE_MAX_CLIPMAPS words: the entries only the fallback stamped, never traced, per clipmap
#define RC_COUNT_FALLBACK_BY_CLIPMAP     ( RC_COUNT_NEVER_TRACED_BY_CLIPMAP + RADIANCE_CACHE_MAX_CLIPMAPS )
// FPS-RC-BUDGET: the census of what asks for a trace besides the new probes - LIGHTS CHANGED (incl. a probe last
// traced before the last full update), and the event-less probes due by age (the refresh, capped at RefreshBudget).
#define RC_COUNT_LIGHTS_CHANGED          ( RC_COUNT_FALLBACK_BY_CLIPMAP + RADIANCE_CACHE_MAX_CLIPMAPS )
#define RC_COUNT_AGED                    ( RC_COUNT_LIGHTS_CHANGED + 1u )
#define RC_COUNT_WORDS                   ( RC_COUNT_AGED + 1u ) // 26
// THE BUDGET GOES TO THE COVERAGE FIRST (UE Lumen Radiance Cache: a probe is marked in the clipmap that covers the
// read point, the frame's budget traces the new probes first, then the longest untraced; a coarser level is the
// fallback for what the coverage does not answer). From the top bucket down:
//   NEW COVERAGE  a never-traced probe a coverage reader stamped this frame (RC_STAMP_COVERAGE): the cells the screen
//                 probes' covered rays and the irradiance readers interpolate themselves. Finest clipmap first: a
//                 clipmap 0 cell is read from the camera out, the cells of the others only in their shell past the
//                 finer clipmap, so a fine cell answers at least as many reads.
//   NEW FALLBACK  a never-traced probe only the fallback stamped (RC_STAMP_FALLBACK: the clipmap past a pixel's
//                 coarse end, RadianceCacheRadianceAt's answer while the coverage's own cells are untraced): traced
//                 from what the new coverage probes leave of the budget, finest first, and before any re-trace, so
//                 the edge of a clipmap keeps its fallback level.
//   LIGHTS CHANGED (or last traced before the last full update), then the age of the last trace (oldest first),
//                 whoever stamped the probe; the age buckets take at most RefreshBudget a frame (FPS-RC-BUDGET).
#define RC_PRIORITY_NEW_COVERAGE   ( RC_PRIORITY_BUCKETS - RADIANCE_CACHE_MAX_CLIPMAPS )
#define RC_PRIORITY_NEW_FALLBACK   ( RC_PRIORITY_NEW_COVERAGE - RADIANCE_CACHE_MAX_CLIPMAPS )
#define RC_PRIORITY_LIGHTS_CHANGED ( RC_PRIORITY_NEW_FALLBACK - 1u )
// FPS-RC-COST: a read probe that is due no trace this frame - no event (never traced, lights changed, traced before
// the last full update) and traced fewer than RefreshMinFrames frames ago. It ranks in no bucket: Select skips it,
// so the budget goes to the probes that need it instead of re-tracing a converged one every frame.
#define RC_PRIORITY_NOT_DUE        RC_PRIORITY_BUCKETS
// The bucket of a never-traced probe of @p clipmap: of the coverage when @p covered, else of the fallback.
uint RadianceCacheNewProbeBucket( bool covered, uint clipmap )
{
    const uint group = covered ? RC_PRIORITY_NEW_COVERAGE : RC_PRIORITY_NEW_FALLBACK;
    return group + RADIANCE_CACHE_MAX_CLIPMAPS - 1u - clipmap;
}

PushConstant RadianceCachePush
{
    uint  FrameIndex;       // 1, 2, ... (0 = never)
    uint  Reset;            // 1: the state is (re)initialised this frame
    uint  MaxProbes;        // probe slots
    uint  UnusedFrames;     // RadianceCache::kProbeUnusedFramesBeforeFree
    uint  Width;            // G-buffer extent
    uint  Height;
    float HistoryWeight;          // RadianceCache::kHistoryWeight
    float DirtyHistory;     // RadianceCache::kDirtyHistoryWeight
    uint  LightingFrame;    // the frame of the last full update: a probe last traced before it has no history
    uint  MarkFallback;     // 1: Mark stamps the clipmap past the coarse end (the screen probes' fallback)
    uint  RefreshMinFrames; // RadianceCache::kProbeRefreshMinFrames: an event-less probe's frames between traces
    uint  RefreshBudget;    // FPS-RC-BUDGET: the most event-less (age) probes Select lists a frame (the budget on a full update)
};

// THE ATLAS UNDER PRESSURE (PROBE-TURN-1; not in UE, which keeps an unread probe NumFramesToKeepCachedProbes frames
// whatever the atlas holds and leaves the overflow's cells empty): the word Allocate counts the cells of the frame of
// @p frameIndex's parity that found no free slot in. Mark's free part clears this frame's before Allocate counts it,
// and reads the last frame's: after a frame that dropped reads, a probe nobody stamped within the pixels' 2x2 rotation
// (RadianceCacheMark.shader: each pixel of a block marks every fourth frame) gives its slot back at once instead of
// after UnusedFrames - a camera turn's swept cells give way to this frame's reads, which an empty cell sends on to
// the full trace distance (ScreenProbes: Trace Cache Miss).
uint RadianceCacheFailedAllocationsWord( uint maxProbes, uint frameIndex )
{
    return 1u + maxProbes + ( frameIndex & 1u );
}
#define RADIANCE_CACHE_PRESSURE_KEEP_FRAMES 3u // an unread probe's frames under pressure: the rotation's 4 less one

#endif // RADIANCE_CACHE_STATE_GLSLH
