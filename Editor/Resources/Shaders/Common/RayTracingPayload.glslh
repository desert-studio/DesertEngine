#ifndef DESERT_RAY_TRACING_PAYLOAD_GLSLH
#define DESERT_RAY_TRACING_PAYLOAD_GLSLH

// THE RAY'S PAYLOAD between a ray generation stage and the hit groups (UE: FPackedMaterialClosestHitPayload of
// RayTracingCommon.ush, the material a hit shader returns; the lighting is the ray generation's, as UE's Lumen hit
// lighting lights the payload in its ray generation shader, LumenHardwareRayTracingCommon.ush
// CalculateRayTracedLighting). One struct for the material ray and the visibility ray: a visibility ray skips the
// closest hit (gl_RayFlagsSkipClosestHitShaderEXT) and reads HitT alone.
//
//   in   ConeWidth / ConeSpread: the ray cone at the origin (cm) and its spread (radians), for the hit's texture LOD;
//   out  HitT < 0: the ray met nothing (the miss stage wrote it); otherwise the hit's distance (cm) and, from a
//        closest hit, its material: BaseColor, Metallic, Roughness, Emissive, the shading normal (world, unit,
//        facing the ray) and Flags bit0 = the ray met the front face.
struct DesertRayPayload
{
    vec3  BaseColor;
    float HitT;
    vec3  Normal;
    float Roughness;
    vec3  Emissive;
    float Metallic;
    float ConeWidth;
    float ConeSpread;
    uint  Flags;
    float Pad;
};

const uint kDesertRayPayloadFrontFace = 1u;

#endif
