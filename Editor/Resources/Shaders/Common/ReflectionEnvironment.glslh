#ifndef REFLECTION_ENVIRONMENT_GLSLH
#define REFLECTION_ENVIRONMENT_GLSLH

// THE REFLECTION ENVIRONMENT: the reflection captures around a point, parallax-corrected and blended, then the
// sky where they do not reach (UE: ReflectionEnvironmentShared.ush GatherRadiance + the sky term, ported).
// One function for every reader: the lit passes' ambient specular (Mesh/AmbientIBL.glslh) today, and the
// fallback of every traced reflection on a miss (SSR2, RT reflections) next — they call
// DesertReflectionEnvironment with the ray they could not resolve.
//
// THE INCLUDER DECLARES THE TWO BINDINGS (the slots are its layout's), before including this file:
//   #include <Common/ReflectionCaptureGpu.glslh>
//   ReadBuffer(n) ReflectionCapturesUB { uvec4 ReflectionCaptureHeader; ReflectionCaptureGpu ReflectionCaptures[]; };
//   Uniform(m) samplerCubeArray ReflectionCaptureCubesTexture;
// The CPU side of both is
// Graphic/ReflectionCaptures/ReflectionCaptureRenderer.hpp (ReflectionCaptureGpu, the same layout, std430).
//
// ReflectionCaptureHeader.x = capture count. The captures are sorted SMALLEST INFLUENCE FIRST: the loop
// composites front to back with UE's under-operator, so the most local capture wins where several overlap.

#include <Common/ReflectionCaptureGpu.glslh>
#include <Common/ReflectionCaptureMip.glslh>

// UE r.ReflectionEnvironmentBeginMixingRoughness 0.1 / EndMixingRoughness 0.3 / LightmapMixLargestWeight 10000:
// a mirror is not normalised (it must match SSR and planar reflections), a rough lobe fully is.
const float kReflectionMixBeginRoughness = 0.1;
const float kReflectionMixEndRoughness   = 0.3;
const float kReflectionMixLargestWeight  = 10000.0;

// UE ComputeMixingWeight. The captures carry high DIRECTIONAL frequency but low SPATIAL frequency (one cube for a
// whole room); the local diffuse lighting has the opposite. The capture's low spatial frequency is replaced by the
// local one: scaled by (the diffuse at the pixel / the diffuse at the capture point), luminance only so the hue is
// kept. @p indirectIrradiance is the pixel's side, @p averageBrightness the one stored with the cube when it was
// written (ReflectionCaptureDiffuse.shader); what each is under the view's estimator is Graphic
// ReflectionCaptureLighting (under the radiance cache UE's pair: a smooth irradiance at the pixel against the cube's
// own brightness), so a relit room keeps its reflections in step with its diffuse until the capture is rendered
// again. A capture that stores 0 is NOT normalised (its own radiance): dividing by a value nobody measured would be
// a guess, and the old floor (0.0001) turned it into a 10000x blow-out.
float ReflectionCaptureMixingWeight(float indirectIrradiance, float averageBrightness, float roughness)
{
	if (averageBrightness <= 0.0)
		return 1.0;
	const float scale  = 1.0 / (kReflectionMixEndRoughness - kReflectionMixBeginRoughness);
	const float mixing = smoothstep(0.0, 1.0, clamp(roughness * scale - kReflectionMixBeginRoughness * scale, 0.0, 1.0));
	const float weight = min(indirectIrradiance / max(averageBrightness, 0.0001), kReflectionMixLargestWeight);
	return mix(1.0, weight, mixing);
}

// UE GetLookupVectorForSphereCapture: the reflection ray from the shaded point is intersected with the capture's
// sphere and the cube is read towards the hit, seen from the capture point. distanceAlpha fades the capture out
// over the outer 40 % of its radius.
vec3 ReflectionCaptureSphereLookup(vec3 R, vec3 P, ReflectionCaptureGpu capture, float normalizedDistance,
                                   out float distanceAlpha)
{
	distanceAlpha             = 0.0;
	vec3        lookup        = R;
	const float radius        = capture.PositionRadius.w;
	const vec3  localPosition = P - capture.PositionRadius.xyz;
	const float b             = dot(R, localPosition);
	const float c             = dot(localPosition, localPosition) - radius * radius;
	const float determinant   = b * b - c;
	if (determinant >= 0.0)
	{
		const float farHit = sqrt(determinant) - b;
		lookup             = localPosition + farHit * R - capture.CaptureOffsetBrightness.xyz;
		const float x      = clamp(2.5 * normalizedDistance - 1.5, 0.0, 1.0);
		distanceAlpha      = 1.0 - x * x * (3.0 - 2.0 * x);
	}
	return lookup;
}

// UE GetLookupVectorForBoxCapture: the ray is intersected with the box in box space ([-1, 1]^3) - the exit point,
// the nearest of the three far planes - and the cube is read towards it from the capture point. distanceAlpha
// fades the capture in across the transition distance inside the walls.
vec3 ReflectionCaptureBoxLookup(vec3 R, vec3 P, ReflectionCaptureGpu capture, vec3 localPosition,
                                out float distanceAlpha)
{
	const vec3  localDirection = (capture.WorldToBox * vec4(R, 0.0)).xyz;
	const vec3  invDirection   = 1.0 / localDirection;
	const vec3  first          = (-1.0 - localPosition) * invDirection;
	const vec3  second         = (1.0 - localPosition) * invDirection;
	const vec3  furthest       = max(first, second);
	const float hit            = min(furthest.x, min(furthest.y, furthest.z));
	const vec3  hitPosition    = P + hit * R;

	const vec3  extent         = capture.BoxExtentTransition.xyz;
	const vec3  insideDistance = extent - abs(localPosition) * extent;
	const float wallDistance   = min(insideDistance.x, min(insideDistance.y, insideDistance.z));
	distanceAlpha = smoothstep(0.0, max(0.7 * capture.BoxExtentTransition.w, 0.0001), wallDistance);

	return hitPosition - (capture.PositionRadius.xyz + capture.CaptureOffsetBrightness.xyz);
}

// The captures' share of the reflection along R at P (normal N): rgb = their composited radiance (normalised), a =
// how much of the reflection they cover (1 - what is left for the sky).
vec4 GatherReflectionCaptures(vec3 P, vec3 R, vec3 N, float roughness, float indirectIrradiance)
{
	const uint count = ReflectionCaptureHeader.x;
	if (count == 0u)
		return vec4(0.0);

	// The engine's one ramp (Common/ReflectionCaptureMip.glslh), the inverse of the one ReflectionCaptureFilter wrote.
	const float lastMip = float(textureQueryLevels(ReflectionCaptureCubesTexture) - 1);
	const float lod     = ComputeReflectionCaptureMipFromRoughness(roughness, lastMip);

	vec3  radiance          = vec3(0.0);
	float remaining         = 1.0;
	float brightness        = 0.0;
	for (uint i = 0u; i < count && remaining > 0.001; ++i)
	{
		const ReflectionCaptureGpu capture = ReflectionCaptures[i];
		float distanceAlpha = 0.0;
		vec3  lookup;
		if (capture.ShapeCube.x == 0u)
		{
			const vec3  toPoint = P - capture.PositionRadius.xyz;
			const float d2      = dot(toPoint, toPoint);
			const float radius  = capture.PositionRadius.w;
			if (d2 >= radius * radius)
				continue;
			lookup = ReflectionCaptureSphereLookup(R, P, capture, sqrt(d2) / radius, distanceAlpha);
		}
		else
		{
			const vec3 local = (capture.WorldToBox * vec4(P, 1.0)).xyz;
			if (any(greaterThan(abs(local), vec3(1.0))))
				continue;
			lookup = ReflectionCaptureBoxLookup(R, P, capture, local, distanceAlpha);
		}
		// A capture whose first cube was just written fades in over a few frames (ReflectionCaptureRenderer's
		// presence): the environment behind it shows through meanwhile, so a capture becoming readable is a
		// ramp, never a one-frame change of every rough surface it covers.
		distanceAlpha *= uintBitsToFloat(capture.ShapeCube.z);
		if (distanceAlpha <= 0.0)
			continue;

		const vec4  s      = textureLod(ReflectionCaptureCubesTexture, vec4(lookup, float(capture.ShapeCube.y)), lod);
		const float weight = distanceAlpha * remaining;
		radiance   += s.rgb * capture.CaptureOffsetBrightness.w * weight;
		// The stored diffuse is the lighting's, not the cube's: the capture's Brightness multiplier scales the
		// radiance only, so it still brightens a rough reflection (scaling both would cancel in the ratio). It is
		// read about the pixel's normal from the last mip, where each face is one texel - the capture point's ambient
		// cube (ReflectionCaptureFilter.shader), the irradiance a surface facing N would have had there.
		const float stored = textureLod(ReflectionCaptureCubesTexture, vec4(N, float(capture.ShapeCube.y)), lastMip).a;
		brightness += stored * weight;
		remaining  *= 1.0 - distanceAlpha;
	}

	const float coverage = 1.0 - remaining;
	if (coverage <= 0.0)
		return vec4(0.0);
	const float averageBrightness = brightness / coverage;
	return vec4(radiance * ReflectionCaptureMixingWeight(indirectIrradiance, averageBrightness, roughness), coverage);
}

// THE reflection fallback: the captures, then @p remainder where they leave one - the sky's prefiltered radiance
// along R (Mesh/AmbientIBL.glslh DesertAmbientSpecular), or the traced GI's specular (DeferredLighting, GI mode 2),
// which already holds the sky where it is visible. @p indirectIrradiance is the luminance of the diffuse the pixel
// receives from the view's estimator, the one the captures' stored diffuse was measured with.
vec3 DesertReflectionEnvironment(vec3 P, vec3 R, vec3 N, float roughness, vec3 remainder, float indirectIrradiance)
{
	const vec4 captures = GatherReflectionCaptures(P, R, N, roughness, indirectIrradiance);
	return captures.rgb + remainder * (1.0 - captures.a);
}

#endif // REFLECTION_ENVIRONMENT_GLSLH
