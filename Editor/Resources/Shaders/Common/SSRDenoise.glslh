// The shared denoiser for 1-sample-per-pixel jittered estimates: SSR's trace and the RSM-GI gather. ONE body,
// drawn fullscreen by SSRResolve.shader (GI) and over the reflecting tiles by SSRResolveTiled.shader (SSR).
//  1) SPATIAL: 5x5 alpha-weighted tent over the trace (misses don't darken hits; holes get filled), also
//     collecting the neighbourhood colour AABB.
//  2) TEMPORAL: reprojects this pixel's WORLD position through LAST frame's camera and blends the previous
//     resolved result in (exponential accumulation ~10 frames - this is what actually kills the HDR speckle).
//     History is clamped to the current neighbourhood AABB so moving objects / disocclusions don't ghost.
// Where the whole 5x5 neighbourhood of the trace is 0 the AABB is the single point 0, so the result is exactly
// 0 whatever the history holds - which is why the tiled SSR variant may leave such pixels undrawn.
//
// params: xy = texel size, z = history blend (0 = first frame / resize), w unused.
vec4 SSRDenoise(sampler2D traceTex, sampler2D historyTex, sampler2D worldPosTex, vec2 uv, mat4 prevViewProj,
                vec4 params)
{
	vec2 t = params.xy;

	// --- Spatial: alpha-weighted 5x5 tent + neighbourhood AABB (for the temporal clamp). ---
	vec3  colAcc = vec3(0.0);
	float aAcc   = 0.0;
	float wsum   = 0.0;
	vec3  mnC = vec3(1e9), mxC = vec3(-1e9);
	float mnA = 1e9, mxA = -1e9;
	for (int y = -2; y <= 2; y++)
		for (int x = -2; x <= 2; x++)
		{
			float w  = (3.0 - abs(float(x))) * (3.0 - abs(float(y)));
			vec2  su = clamp(uv + vec2(x, y) * t, vec2(0.001), vec2(0.999));
			vec4  s  = texture(traceTex, su);
			colAcc += s.rgb * s.a * w;
			aAcc   += s.a * w;
			wsum   += w;

			vec3 c = s.a > 0.001 ? s.rgb : vec3(0.0);
			mnC = min(mnC, c);
			mxC = max(mxC, c);
			mnA = min(mnA, s.a);
			mxA = max(mxA, s.a);
		}

	vec3  curCol = aAcc > 0.001 ? colAcc / aAcc : vec3(0.0);
	float curA   = aAcc / wsum;
	vec4  cur    = vec4(curCol, curA);

	// --- Temporal: reproject via last frame's camera (exact for static geometry), AABB-clamped. ---
	float blend = params.z;
	if (blend > 0.0)
	{
		vec3 wp = texture(worldPosTex, uv).rgb;
		vec4 pc = prevViewProj * vec4(wp, 1.0);
		if (pc.w > 0.0)
		{
			vec2 puv = pc.xy / pc.w * 0.5 + 0.5;
			puv.y = 1.0 - puv.y; // engine Y-flipped viewport (same convention as the trace)
			if (puv.x > 0.0 && puv.x < 1.0 && puv.y > 0.0 && puv.y < 1.0)
			{
				vec4 hist = texture(historyTex, puv);
				hist.rgb  = clamp(hist.rgb, mnC, mxC);
				hist.a    = clamp(hist.a, mnA, mxA);
				cur = mix(cur, hist, blend);
			}
		}
	}
	return cur;
}
