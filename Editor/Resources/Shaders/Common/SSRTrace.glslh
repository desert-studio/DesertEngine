#ifndef DESERT_SSR_TRACE_GLSLH
#define DESERT_SSR_TRACE_GLSLH

// THE REFLECTION TRACE OF ONE TEXEL (Programs/Deferred/SSR.shader): its bindings, the ray sequence, the screen walk
// and the world legs, up to TraceFrom. Shared by the program's two entry points so they cannot drift: the compute
// classify + trace (every method) and, under DESERT_REFLECTIONS_HIT_LIGHTING, the "HitLighting" pass's ray
// generation stage, whose world leg is a traceRayEXT into the surface templates' hit groups. The compute-only parts
// (LocalSize, shared memory) sit behind DESERT_RAY_TRACING_STAGE, which the parser defines in every ray tracing
// stage.

#include <Generated/SceneBindings.glslh> // the SSR front layer's set-1 slots (Core::kSsrFrontLayer*)
#include <Common/SSRGate.glslh>
#include <Common/ReconstructPosition.glslh>

// The traced methods' two programs (SSRRenderer: ReflectionMethod SoftwareTraced / HardwareTraced): the screen leg
// (DESERT_REFLECTIONS_SCREEN_LEG, no tracer in it) classifies and walks the screen, leaving the rays it does not
// answer to the world; the traced permutation (DESERT_REFLECTIONS_TRACED) traces them - its compute is the
// world stage (DESERT_REFLECTIONS_WORLD_STAGE), its hit-lit ray generation the whole texel. Both draw the world
// rays (DESERT_REFLECTIONS_WORLD_RAYS).
#if defined( DESERT_REFLECTIONS_TRACED ) && defined( DESERT_REFLECTIONS_SCREEN_LEG )
#error "the screen leg is the traced reflections' program without the tracer"
#endif
#if defined( DESERT_REFLECTIONS_TRACED ) || defined( DESERT_REFLECTIONS_SCREEN_LEG )
#define DESERT_REFLECTIONS_WORLD_RAYS
#endif
#if defined( DESERT_REFLECTIONS_TRACED ) && !defined( DESERT_REFLECTIONS_HIT_LIGHTING )
#define DESERT_REFLECTIONS_WORLD_STAGE
#endif

// Shared sampler states (UE's shared samplers): every input below is a separate texture read through one
// of these, bound once by the pass and numbered by the program build (SharedSamplerBinding.hpp); a
// same-name macro after each texture keeps the sampled form. The repeat state is the software tracer's too
// (Common/GITracer.glslh, the traced permutation): declared once, under its guard.
#ifndef DESERT_SHARED_LINEAR_REPEAT_SAMPLER
#define DESERT_SHARED_LINEAR_REPEAT_SAMPLER
Uniform sampler LinearRepeatSampler;
#endif
Uniform sampler LinearClampSampler;
Uniform sampler PointClampSampler;
Uniform(1) texture2D GBufferNormalTexture;   // rgb = world normal, a = roughness
#define GBufferNormalTexture sampler2D(GBufferNormalTexture, LinearRepeatSampler)
Uniform(2) texture2D GBufferDepthTexture;    // device depth (nearest): world position via SSRTraceUB's inverse
#define GBufferDepthTexture sampler2D(GBufferDepthTexture, PointClampSampler)
Uniform(3) texture2D SceneColorTexture;      // LAST frame's lit opaque scene (SSRRenderer's scene colour history)
#define SceneColorTexture sampler2D(SceneColorTexture, LinearClampSampler)
layout(binding = 4, rgba16f) writeonly uniform image2D SsrTraceTexture;    // one texel per DownsampleFactor^2 pixels (SsrParams3.x)
// One texel per tile: the compute classify writes it; the hit-lighting ray generation reads its texel's tile.
#if defined( DESERT_RAY_TRACING_STAGE )
layout(binding = 5, rgba8) readonly uniform image2D TileMaskTexture;
#else
layout(binding = 5, rgba8) writeonly uniform image2D TileMaskTexture;
#endif
Uniform(7) texture2D HzbTexture;             // closest-depth hierarchy of this frame's depth (HZB.shader)
#define HzbTexture sampler2D(HzbTexture, PointClampSampler)
Uniform(8) texture2D VelocityTexture;        // NDC current - previous per pixel (View/Velocity.hpp), unjittered
#define VelocityTexture sampler2D(VelocityTexture, PointClampSampler)
// The traced texel's ray, for the reconstruction's neighbour reuse (Denoise/SSDReconstructReflections.shader,
// UE SSRT): xyz = the WORLD point the texel's estimate was reflected from (a neighbour re-aims its own ray at it), w = log2 of
// the VNDF pdf with which this texel drew that direction. RGBA32F: ViewTargetFormats::kSSRTraceRay.
layout(binding = 9, rgba32f) writeonly uniform image2D TraceRayTexture;  // the resolution of SsrTraceTexture

#if defined( DESERT_REFLECTIONS_FRONT_LAYER )
// THE TRANSLUCENT FRONT LAYER (UE LumenReflections FRONT_LAYER_TRANSLUCENCY, Reflections.TranslucentFrontLayer): the
// surface the rays leave from is the nearest translucent surface of the pixel (Mesh/Surface/Pass_FrontLayer.glslh,
// "Translucency: Front Layer G-buffer"); the screen walk, its hits and every world leg still read the OPAQUE scene
// (GBufferNormalTexture / GBufferDepthTexture at a hit, HzbTexture, VelocityTexture): what glass reflects is the world, not itself.
// Set 1, the program's own set: set 0 has no slot outside every shared range (Core::kSsrFrontLayerSet).
layout(set = kSsrFrontLayerSet, binding = kSsrFrontLayerNormalBinding) uniform texture2D FrontLayerNormalTexture; // rgb = world normal, a = roughness (cleared: zero)
layout(set = kSsrFrontLayerSet, binding = kSsrFrontLayerDepthBinding) uniform texture2D FrontLayerDepthTexture;  // device depth of the front layer (cleared: far)
#endif

// THE REFLECTING SURFACE at G-buffer pixel @p p - where the rays leave from, never where they land: rgb = world
// normal, a = roughness; a zero normal reflects nothing (SSRPixelCanReflect). The opaque G-buffer, or, for the front
// layer, its translucent surface where that is in front of the opaque scene (reversed depth: DepthCompare::Closer is
// Greater) - a front layer behind an opaque surface is not seen and reflects nothing.
vec4 SSRSurfaceNormal(ivec2 p)
{
#if defined( DESERT_REFLECTIONS_FRONT_LAYER )
	if (texelFetch(sampler2D(FrontLayerDepthTexture, PointClampSampler), p, 0).r <= texelFetch(GBufferDepthTexture, p, 0).r)
		return vec4(0.0);
	return texelFetch(sampler2D(FrontLayerNormalTexture, PointClampSampler), p, 0);
#else
	return texelFetch(GBufferNormalTexture, p, 0);
#endif
}

// The reflecting surface's device depth at @p p (see SSRSurfaceNormal).
float SSRSurfaceDepth(ivec2 p)
{
#if defined( DESERT_REFLECTIONS_FRONT_LAYER )
	return texelFetch(sampler2D(FrontLayerDepthTexture, PointClampSampler), p, 0).r;
#else
	return texelFetch(GBufferDepthTexture, p, 0).r;
#endif
}
#include <Common/HZBTrace.glslh>

#if defined( DESERT_REFLECTIONS_TRACED )
// The traced legs' reads (System::SSRRenderer::TracedReads): what GIHitRadiance lights a hit with - the GI
// frame record, the lights and the world light grid, the radiance cache's read (a neutral one, covering
// nothing, when the GI does not run it), the sky, the G-buffer's material - then the tracer (23..28), the
// surface cache (29..35) and the mesh SDF near field (36..41).
#include <Common/GIFrame.glslh>
#include <Common/RadianceCache.glslh>
#include <Mesh/LightSources.glslh>
#include <Mesh/LightGrid.glslh>
layout(std430, binding = 10) readonly buffer GIFrameUB
{
	GIFrame giFrame;
};
layout(std430, binding = 11) readonly buffer PointLightsUB
{
	PointLight pointLights[];
};
layout(std430, binding = 12) readonly buffer SpotLightsUB
{
	SpotLight spotLights[];
};
layout(std430, binding = 13) readonly buffer LightGridParamsUB
{
	LightGridParams lightGrid;
};
layout(std430, binding = 14) readonly buffer LightGridWorldCellsUB
{
	uint lightGridWorldCells[];
};
#define LIGHT_GRID_WORLD_CELLS lightGridWorldCells
#include <Mesh/LightGrid.glslh>
layout(std430, binding = 15) readonly buffer RadianceCacheParamsUB
{
	RadianceCacheParams radianceCache;
};
layout(std430, binding = 16) readonly buffer RadianceCacheIndirectionUB
{
	uint radianceCacheIndirection[];
};
layout(std430, binding = 17) readonly buffer RadianceCacheProbesUB
{
	RadianceCacheProbe radianceCacheProbes[];
};
layout(binding = 18) uniform texture2D RadianceCacheIrradianceTexture;
#define RadianceCacheIrradianceTexture sampler2D(RadianceCacheIrradianceTexture, LinearClampSampler)
layout(binding = 19) uniform texture2D RadianceCacheDepthTexture;
#define RadianceCacheDepthTexture sampler2D(RadianceCacheDepthTexture, LinearClampSampler)
layout(binding = 20) uniform textureCube EnvironmentSpecularTexture;
#define EnvironmentSpecularTexture samplerCube(EnvironmentSpecularTexture, LinearClampSampler)
layout(binding = 21) uniform texture2D GBufferATexture;
#define GBufferATexture sampler2D(GBufferATexture, PointClampSampler)
layout(binding = 22) uniform texture2D GBufferEmissiveTexture;
#define GBufferEmissiveTexture sampler2D(GBufferEmissiveTexture, PointClampSampler)
#define RADIANCE_CACHE_INDIRECTION radianceCacheIndirection
#define RADIANCE_CACHE_PROBES radianceCacheProbes
#include <Common/RadianceCache.glslh>
#define GI_TRACER_BINDING 23
#include <Common/GITracer.glslh>
#define GI_SURFACE_CACHE_BINDING 34
#include <Common/GIHitLighting.glslh>
#if defined( DESERT_REFLECTIONS_HIT_LIGHTING )
// HIT LIGHTING (Reflections.HitLighting, UE Lumen reflections' r.Lumen.HardwareRayTracing.LightingMode = hit
// lighting): the world ray is traced by the ray tracing pipeline from this program's ray generation stage (the
// "HitLighting" pass of SSR.shader), the hit's material is its surface template's own closest-hit shader
// (Mesh/Surface/Pass_RayHit.glslh, the template's `RayTracing.Hit` cell) and the hit is lit here in place
// (GIHitRadianceLit: every light's diffuse + specular with a visibility ray, the radiance cache's bounce) - no
// surface cache, no G-buffer guess. The view block is bound for the hit shaders (SurfaceInput's camera and time) and the ray cone.
#if !defined( DESERT_GI_TRACER_HARDWARE ) || !defined( DESERT_GI_HIT_LIGHTING_IN_PLACE )
#error "hit-lit reflections are the hardware tracer's, lit in place"
#endif
// The compute stage of this permutation only classifies (SSR.shader main returns after the tile mask).
#if defined( DESERT_RAY_TRACING_STAGE )
#include <Common/CameraUB.glslh>
#include <Common/RayTracingPayload.glslh>
layout(location = 0) rayPayloadEXT DesertRayPayload payload;
#endif
#endif

// How far a ray looks before it is a miss, cm (UE r.Lumen.MaxTraceDistance; the screen probes' own).
const float kTracedMaxDistance = 20000.0;

// The world ray from the surface @p worldPos (normal @p N) along @p L, starting @p start cm along it (where the
// screen was certain), its origin @p nearOffset off the surface and its far field counting hits from @p farTMin on
// (GIRayBias, GIFarFieldTMin). One statement for the whole world leg (TraceWorld) and the software tracer's legs
// (SSR.shader: the far field rebuilds the ray the near field listed from the two offsets it kept).
GITraceInput SSRWorldRayInput(vec3 worldPos, vec3 N, vec3 L, float start, float nearOffset, float farTMin)
{
	GITraceInput ray;
	ray.origin    = worldPos + N * nearOffset;
	ray.farTMin   = farTMin;
	ray.direction = L;
	ray.tMax      = kTracedMaxDistance;
	ray.coneAngle = 0.0;
	ray.flags     = 0u;
	ray.tMin      = min(start, ray.tMax);
	return ray;
}

// SSRWorldRayInput with the tracer's offsets of the surface (GIRayBias).
GITraceInput SSRWorldRayFromSurface(vec3 worldPos, vec3 N, vec3 L, float start)
{
	const GITraceBias bias = GIRayBias(worldPos, N);
	return SSRWorldRayInput(worldPos, N, L, start, bias.nearOffset, GIFarFieldTMin(bias, N, L));
}

// The world leg of one ray from the surface @p worldPos (normal @p N) along @p L, starting @p start cm along
// it (where the screen was certain): the tracer to kTracedMaxDistance (Common/GITracer.glslh: for the software
// tracer the near field's froxel grid of mesh SDFs, then the global field). True on a hit: @p radiance =
// GIHitRadiance, @p hitPoint its position.
bool TraceWorld(vec3 worldPos, vec3 N, vec3 L, float start, out vec3 radiance, out vec3 hitPoint)
{
	radiance = vec3(0.0);
	hitPoint = worldPos;
	const GITraceInput ray = SSRWorldRayFromSurface(worldPos, N, L, start);
#if defined( DESERT_REFLECTIONS_HIT_LIGHTING ) && defined( DESERT_RAY_TRACING_STAGE )
	// The ray cone of the texel (UE GetPixelSpreadAngle): its width where the reflection leaves the surface and the
	// view's per-pixel spread, so the hit's texture LOD is the one the reflected footprint sees.
	const float pixelSpread = 2.0 / (abs(cameraUB.Projection[1][1]) * float(textureSize(GBufferNormalTexture, 0).y));
	payload.HitT       = -1.0;
	payload.ConeWidth  = pixelSpread * distance(cameraUB.CameraPos, worldPos);
	payload.ConeSpread = pixelSpread;
	traceRayEXT(SceneTlas, gl_RayFlagsNoneEXT, RAY_TRACING_MASK_OPAQUE, 0u, 1u, 0u, ray.origin, ray.tMin, L, ray.tMax,
	            0);
	if (payload.HitT < 0.0)
		return false;
	GIHit hit;
	hit.position     = ray.origin + L * payload.HitT;
	hit.distance     = payload.HitT;
	hit.normal       = payload.Normal;
	hit.meshCards    = GI_NO_MESH_CARDS;
	hit.instance     = GI_NO_INSTANCE;
	hit.primitive    = 0u;
	hit.barycentrics = vec2(0.0);
	hit.frontFace    = (payload.Flags & kDesertRayPayloadFrontFace) != 0u;
	hit.velocity     = vec3(0.0);
	hit.motionKnown  = false;
	hit.globalField  = false;
	radiance = GIHitRadianceLit(hit, L, GIHitSurface(payload.BaseColor, payload.Metallic, payload.Roughness,
	                                                 payload.Emissive, true));
	hitPoint = hit.position;
	return true;
#else
	const GITraceResult far = GITraceRay(ray);
	if (!far.hit)
		return false;
	radiance = GIHitRadiance(far.surface, L);
	hitPoint = far.surface.position;
	return true;
#endif
}
#endif // DESERT_REFLECTIONS_TRACED

#if defined( DESERT_REFLECTIONS_WORLD_RAYS )
// cm a world leg starts before the point up to which the screen was certain (twice UE's mesh SDF
// SurfaceBias, 5 cm): the world's surface stands off the depth buffer's by its own precision.
const float kWorldStartBackoff = 10.0;
#endif

// Filled on the CPU from the view's matrices once per view frame (SSRRenderer::UploadTraceUniforms).
// InverseJitteredViewProjection = inverse of the matrix the G-buffer depth was rasterised with
// (Common/ReconstructPosition.glslh); JitteredWorldToClip = that matrix (rays are projected with it,
// so a ray and the depth it is tested against are in one space). Where a hit was on last frame's screen
// is the hit pixel's VELOCITY, not a camera reprojection: a moving reflected object is read where it
// was, not where the still world behind it was (UE SSRT: the hit is reprojected through the velocity).
Uniform(6) SSRTraceUB
{
	mat4 InverseJitteredViewProjection;
	mat4 JitteredWorldToClip;
};

PushConstant PushConstants
{
	vec4 CameraPosition;  // xyz = camera world position, w = per-frame seed (ray sequence + 2x2 rotation)
	vec4 SsrParams;  // x = rays per texel, y = HZB iterations per ray, z = intensity, w = thickness (world)
	vec4 SsrParams2; // x = max ray distance (world), y = 1 when SceneColorTexture holds last frame,
	                   // z = mesh SDF trace distance, w = mesh SDF end distance from the camera (traced only)
	vec4 SsrParams3; // x = the trace's downsample factor (Scalability Reflections.DownsampleFactor: 1 or 2),
	                   // y = 1 / PrevPreExposure (SceneColorTexture is stored at LAST frame's pre-exposure),
	                   // z = 1 when the composite answers the lobe past kTracedMaxRoughness with the traced GI's
	                   // rough specular (traced only, SSRRenderer::TraceSettings::RoughSpecularFromGI),
	                   // w = the compute's stage: 0 = classify + list (one workgroup per tile), 1 = trace the list
	                   // (SSRRenderer::TraceStage; the ray generation ignores it)
};

// Whether texel source pixel gb is traced at all: the screen trace's gate, or the traced reflections' own under the
// traced GI (Common/SSRGate.glslh TracedReflectionsPixelTraces). The classify (SSR.shader) and TraceFrom both ask it,
// so a tile the classify marks empty holds no texel the trace would have reflected.
bool SSRTexelTraces(vec4 gb)
{
#if defined( DESERT_REFLECTIONS_WORLD_RAYS )
	return TracedReflectionsPixelTraces(gb, SsrParams3.z >= 0.5);
#else
	return SSRPixelCanReflect(gb);
#endif
}

// The G-buffer pixel trace texel q traces from: the pixel itself at factor 1; at factor 2 the pixel of its 2x2
// block the frame's seed rotates to, so four frames visit all four (UE's half-resolution reflections).
// Denoise/SSDReconstructReflections.shader finds a texel's source pixel the same way.
ivec2 SSRTraceSourcePixel(ivec2 q, int factor, int frame, ivec2 full)
{
	const ivec2 rotation = factor == 2 ? ivec2(frame & 1, (frame >> 1) & 1) : ivec2(0);
	return min(q * factor + rotation, full - 1);
}

#if !defined( DESERT_RAY_TRACING_STAGE )
LocalSize(8, 8, 1);

shared uint s_TileReflects;

// The trace's and the world stage's threads per workgroup (= LocalSize).
const uint kSSRTraceListGroupSize = 64u;

#if !defined( DESERT_REFLECTIONS_TRACED )
// THE TRACED TEXELS' LIST (UE LumenReflections.cpp ReflectionTileClassification's compacted trace texels and
// ReflectionTracingTileIndirectArgs): the classify (SSR.shader, SsrParams3.w = 0) appends every texel it hands to
// the trace, one atomic per tile, and sizes the trace's indirect dispatch; the trace (SsrParams3.w = 1) runs one
// thread per listed texel, so a wave walks rays on every lane instead of waiting on the texels its tile does not
// own (three in four at DownsampleFactor 2) or does not trace (sky, rougher than the gate). Reset by the graph's
// upload (SSRRenderer::kTraceListArgsReset). The screen alone and the traced reflections' screen leg
// (DESERT_REFLECTIONS_SCREEN_LEG) keep it; the traced permutation keeps none: hit-lit, its ray generation traces
// every texel, otherwise its compute is the world stage over the screen leg's world list.
layout(std430, binding = 42) buffer SsrTraceListArgsUB
{
	uvec4 ssrTraceListArgs; // x = the trace's workgroups, y = z = 1 (the indirect dispatch), w = texels listed
};
layout(std430, binding = 43) buffer SsrTraceListUB
{
	uint ssrTraceList[]; // q.x | q.y << 16: a trace texel (SsrTraceTexture)
};
shared uint s_ListCount;
shared uint s_ListStart;
#endif

#if defined( DESERT_REFLECTIONS_SCREEN_LEG ) || defined( DESERT_REFLECTIONS_WORLD_STAGE )
// THE WORLD RAYS' LIST (UE LumenReflectionTracing: the screen trace, then CompactReflectionTraces of the rays it
// did not answer, then the mesh SDF / hardware traces over that compacted list): the screen leg (the trace stage
// of DESERT_REFLECTIONS_SCREEN_LEG, no tracer in its kernel) writes every texel as if its world ray missed and
// lists the texels that drew one (SSRTraceSums::worldWeight > 0) with the screen's sums; the world stage (the
// traced permutation's compute, SsrParams3.w = 2) runs one thread per listed texel, traces its one world ray and,
// on a hit, rewrites the texel - the same sums in the same order as one kernel doing both. Reset by the graph's
// upload (SSRRenderer::kTraceListArgsReset).
struct SSRWorldRay
{
	vec4  RadianceHitWeight; // the screen's sums: rgb = radiance, a = hit weight (both Karis-weighted)
	vec4  HitPointCoverage;  // xyz = the hit points' weighted sum (world), w = coverage
	float WorldWeight;       // the summed weight of the rays left to the world
	float WeightSum;         // the summed weight of every ray
	float WorldStart;        // cm along the drawn ray where its world leg starts
	uint  TexelRay;          // q.x | q.y << 14 | the drawn ray's index << 28 (SSRRenderer::kWorldRayBytes = 48)
};
layout(std430, binding = 44) buffer SsrWorldListArgsUB
{
	uvec4 ssrWorldListArgs; // x = the world stage's workgroups, y = z = 1, w = texels listed
};
layout(std430, binding = 45) buffer SsrWorldListUB
{
	SSRWorldRay ssrWorldList[];
};
#if defined( DESERT_REFLECTIONS_WORLD_STAGE ) && defined( DESERT_GI_TRACER_SOFTWARE )
// THE SOFTWARE TRACER'S WORLD LEGS (UE LumenReflectionTracing: TraceMeshSDFs over the compacted rays, then
// CompactReflectionTraces of the rays the mesh SDFs left, then TraceVoxels; ScreenProbeTrace.shader's legs are the
// GI's same split): the world stage is three dispatches of this compute over three lists, so a wave holds lanes of
// one leg only - its near-field lanes do not wait on the far-field march of the lanes that missed, its march lanes
// not on the gradient, card search and shadow marches of the few that hit.
//   near field (SsrParams3.w = 2) over the world list: the mesh SDFs (GITraceNearField); a hit is lit and written
//       there, a miss whose far field has a span (GIFarFieldSpan) is listed in the far list;
//   far field (SsrParams3.w = 3) over the far list: the global field's march (GITraceFarFieldMarch); a hit is
//       listed in the hit list, a miss leaves the texel as the screen leg wrote it;
//   hit lighting (SsrParams3.w = 4) over the hit list: the hit's surface (GIFarFieldSurface of the march's position
//       and clipmap) lit by GIHitRadiance, the texel written.
// The same ray (SSRWorldRayInput from the offsets each list keeps), the same sums in the same order: the texels of
// the one-kernel world trace. Both lists: x = the next leg's workgroups (atomicMax), y = z = 1, w = entries; reset
// by the graph's upload (SSRRenderer::kTraceListArgsReset); entries sized for every texel of the trace.
layout(std430, binding = 46) buffer SsrWorldFarListUB
{
	uvec4 ssrWorldFarArgs;
	uvec4 ssrWorldFar[]; // x = the world list index, y = farStart, z = nearOffset, w = farTMin (float bits)
};
layout(std430, binding = 47) buffer SsrWorldHitListUB
{
	uvec4 ssrWorldHitArgs;
	uvec4 ssrWorldHit[]; // x = the world list index | (march clipmap + 1) << 28, y = nearOffset, z = globalStart,
	                     // w = the march's T (float bits)
};
#endif
#endif
#endif

#include <Common/MonteCarlo.glslh>
// A miss's point: 1 km (centimetres) along its ray - far enough that a neighbour re-aiming at it draws the
// same direction (the environment is at infinity), near enough to stay exact in a 32-bit float.
const float kMissDistance = 1.0e5;

// World point -> (uv, deviceZ) through the jittered matrix. False behind the camera.
bool ProjectToScreen(mat4 viewProj, vec3 p, out vec3 screen)
{
	const vec4 clip = viewProj * vec4(p, 1.0);
	if (clip.w <= 0.0)
		return false;
	screen = vec3(clip.xy / clip.w * 0.5 + 0.5, clip.z / clip.w);
	screen.y = 1.0 - screen.y; // engine renders through a Y-flipped viewport (Common/ScreenUV.glslh)
	return true;
}

// How much a walk that stopped at @p hit (uv, deviceZ) is a real reflection of the surface there, in [0, 1].
// 0 off the screen and on sky texels; 0 where the ray passed BEHIND the surface by more than the thickness
// (the depth buffer cannot say what is behind its first layer - the next source answers it); 0 on a face
// the ray arrives at from behind; then UE's screen-edge vignette and a soft end at the max distance.
// @p surface = the world point of the depth buffer at the hit (meaningful where the result is > 0).
float SSRHitConfidence(vec3 hit, vec3 origin, vec3 L, float thickness, float maxDistance, out vec3 surface)
{
	surface = origin;
	if (any(lessThan(hit.xy, vec2(0.0))) || any(greaterThan(hit.xy, vec2(1.0))))
		return 0.0;
	const ivec2 size  = textureSize(GBufferDepthTexture, 0);
	const ivec2 texel = clamp(ivec2(hit.xy * vec2(size)), ivec2(0), size - 1);
	const vec3  hN    = texelFetch(GBufferNormalTexture, texel, 0).rgb;
	if (dot(hN, hN) <= 0.001)
		return 0.0; // sky: the sky is the environment's, not a screen hit
	if (dot(normalize(hN), L) > 0.0)
		return 0.0; // back face
	surface             = ReconstructWorldPosition(hit.xy, texelFetch(GBufferDepthTexture, texel, 0).r,
	                                               InverseJitteredViewProjection);
	const vec3  rayAt   = ReconstructWorldPosition(hit.xy, hit.z, InverseJitteredViewProjection);
	const float behind  = distance(surface, rayAt);
	float confidence    = 1.0 - smoothstep(0.0, thickness, behind);
	confidence *= confidence;
	const float travel = distance(origin, surface);
	return confidence * HZBScreenEdgeFade(hit.xy) * (1.0 - smoothstep(0.7 * maxDistance, maxDistance, travel));
}

// ONE TRACED TEXEL's frame, shared by its rays: its surface, the lobe's basis, the rays' origin (on the screen and
// in the world) and the rotation of its ray sequence. The world stage (SSR.shader TraceWorldListed) recomputes it
// from the texel alone - the same statements on the same inputs, so the same bits as the screen leg's.
struct SSRTexel
{
	vec3  N;
	float roughness;
	float alpha;
	vec3  worldPos;
	vec3  T;
	vec3  B;
	vec3  Ve;           // the view direction in (T, B, N)
	vec3  origin;       // where the rays leave (world)
	vec3  originScreen; // origin in (uv, deviceZ), meaningful when onScreen
	bool  onScreen;
	float originW;      // origin's clip w
	vec2  rotation;     // the texel's rotation of the ray sequence
};

// The frame of the texel whose G-buffer pixel is @p gPix. False: the pixel does not trace (SSRTexelTraces).
bool SSRTexelSetup(ivec2 gPix, ivec2 gSize, out SSRTexel t)
{
	const vec2 gUV = (vec2(gPix) + 0.5) / vec2(gSize);
	const vec4 gb  = SSRSurfaceNormal(gPix);
	if (!SSRTexelTraces(gb))
		return false;
	t.N         = normalize(gb.rgb);
	t.roughness = gb.a;
	t.alpha     = max(t.roughness * t.roughness, 0.001);
	t.worldPos  = ReconstructWorldPosition(gUV, SSRSurfaceDepth(gPix), InverseJitteredViewProjection);
	const vec3 V = normalize(CameraPosition.xyz - t.worldPos);
	vec3       T, B;
	Basis(t.N, T, B);
	t.T  = T;
	t.B  = B;
	t.Ve = vec3(dot(V, T), dot(V, B), dot(V, t.N));
	// The ray leaves 2 cm off the surface (a world distance: centimetres) so a grazing ray does not meet its
	// own texel's neighbours in the depth buffer.
	t.origin = t.worldPos + t.N * 2.0;
	vec3 originScreen = vec3(0.0);
	t.onScreen     = ProjectToScreen(JitteredWorldToClip, t.origin, originScreen);
	t.originScreen = originScreen;
	t.originW      = (JitteredWorldToClip * vec4(t.origin, 1.0)).w;
	t.rotation     = vec2(hash12(vec2(gPix)), hash12(vec2(gPix) + 17.17));
	return true;
}

// Ray @p r of the texel's @p rays GGX-VNDF draws: @p Lt in (T, B, N), @p L in the world. False under the surface:
// a lobe sample that reflects nothing (weight 0 in the estimator).
bool SSRRayDirection(SSRTexel t, int r, int rays, uint seed, out vec3 Lt, out vec3 L)
{
	const vec2 u = RayRandom(t.rotation, seed * uint(rays) + uint(r));
	const vec3 H = SampleGGXVNDF(t.Ve, t.alpha, u);
	Lt = reflect(-t.Ve, H);
	L  = vec3(0.0);
	if (Lt.z <= 0.0)
		return false;
	L = normalize(Lt.x * t.T + Lt.y * t.B + Lt.z * t.N);
	return true;
}

// The ratio estimator's sums over one texel's rays (see the header): what the screen answered, and the world ray
// the reservoir drew among the rays it left to the world (DESERT_REFLECTIONS_WORLD_RAYS).
struct SSRTraceSums
{
	vec3  radiance;    // sum of w * conf * L, Karis-weighted
	float hitWeight;   // sum of w * conf, Karis-weighted (the radiance's normaliser)
	float coverage;    // sum of w * conf
	float weightSum;   // sum of w over every ray
	vec3  hitPoint;    // sum of w * conf * surface: the texel's hit point (world)
	vec3  rayDir;      // sum of w * Lt over every ray: the texel's direction when nothing hit
	float worldWeight; // sum of w of the rays left to the world
	vec3  worldL;      // the drawn world ray's direction
	float worldStart;  // and where its world leg starts
	int   worldRay;    // and its index among the texel's rays
};

// The texel gPix's rays over the screen (SSRTraceSourcePixel: every pixel, or one pixel of a 2x2 block rotating
// every frame). False: the texel has no ray - it is written 0 with a miss ray (pdf 0). The rays the screen did not
// answer are left to ONE world ray (UE Lumen reflections: one traced ray per texel), drawn among them in
// proportion to their weight (a reservoir); its answer stands for all of them and the temporal accumulation
// averages the draw over frames. It is traced by SSRAddWorldRay - in this kernel (the hit-lit ray generation) or
// by the world stage over the screen leg's list.
bool SSRTraceTexel(ivec2 gPix, ivec2 gSize, out SSRTexel t, out SSRTraceSums s)
{
	// Whether the screen holds last frame to return at a hit. Without it the screen-only trace answers
	// nothing (all to the next source); the traced one still has the world.
	const bool screenLeg = SsrParams2.y >= 0.5;
#if !defined( DESERT_REFLECTIONS_WORLD_RAYS )
	if (!screenLeg)
		return false;
#endif
	if (!SSRTexelSetup(gPix, gSize, t))
		return false;
#if !defined( DESERT_REFLECTIONS_WORLD_RAYS )
	if (!t.onScreen)
		return false;
#endif

	const int   rays        = int(SsrParams.x);
	const int   iterations  = int(SsrParams.y);
	const float thickness   = SsrParams.w;
	const float maxDistance = SsrParams2.x;
	const uint  seed        = uint(CameraPosition.w);
	const ivec2 vSize       = textureSize(VelocityTexture, 0); // where a hit reads its velocity
#if defined( DESERT_REFLECTIONS_WORLD_RAYS )
	// UE MaxRoughnessToTrace: the share of this texel's rays that go past the screen, dithered per ray.
	const float worldShare = TracedReflectionsAlpha(t.roughness);
#endif

	s.radiance    = vec3(0.0);
	s.hitWeight   = 0.0;
	s.coverage    = 0.0;
	s.weightSum   = 0.0;
	s.hitPoint    = vec3(0.0);
	s.rayDir      = vec3(0.0);
	s.worldWeight = 0.0;
	s.worldL      = vec3(0.0);
	s.worldStart  = 0.0;
	s.worldRay    = 0;
	for (int r = 0; r < rays; ++r)
	{
		vec3 Lt, L;
		if (!SSRRayDirection(t, r, rays, seed, Lt, L))
			continue;
		const float w = SmithG1(Lt.z, t.alpha);
		s.weightSum += w;
		s.rayDir    += w * Lt;

		// THE SCREEN. The segment: up to maxDistance (past it a hit fades out to nothing, SSRHitConfidence),
		// cut at 0.99 of the way to the camera plane so it projects (UE TraceHZB); the walk clips it to the screen.
		float confidence = 0.0;
		vec3  surface    = t.origin;
		vec3  L_i        = vec3(0.0);
		float start      = 0.0; // traced: where the world legs start along the ray (0: uncertain)
		const float dw   = (JitteredWorldToClip * vec4(L, 0.0)).w;
		const float rayLength = dw < 0.0 ? min(0.99 * t.originW / -dw, maxDistance) : maxDistance;
		vec3 endScreen;
		if (screenLeg && t.onScreen && ProjectToScreen(JitteredWorldToClip, t.origin + L * rayLength, endScreen))
		{
			const HZBTraceResult walk = HZBTraceScreen(t.originScreen, endScreen, iterations);
			if (!walk.Stopped)
			{
#if defined( DESERT_REFLECTIONS_WORLD_RAYS )
				// In front of every surface it passed, as far as it got: certain that far (UE writes the distance).
				const vec3 reached = ReconstructWorldPosition(walk.Position.xy, walk.Position.z,
				                                              InverseJitteredViewProjection);
				start = max(distance(t.origin, reached) - kWorldStartBackoff, 0.0);
#endif
			}
			else
			{
				confidence = SSRHitConfidence(walk.Position, t.origin, L, thickness, maxDistance, surface);
				if (confidence > 0.0)
				{
					// The hit's radiance: where the surface point was on LAST frame's screen - the hit pixel
					// minus its velocity (uv = ndc * (0.5, -0.5) under the engine's flipped viewport,
					// View/Velocity.hpp). The velocity carries the object's own motion as well as the camera's,
					// so a car passing in a shop window is read where the car was, not where the street behind
					// it was: no trail behind moving objects.
					const ivec2 vTexel = clamp(ivec2(walk.Position.xy * vec2(vSize)), ivec2(0), vSize - 1);
					const vec2  prevUV = walk.Position.xy - texelFetch(VelocityTexture, vTexel, 0).xy * vec2(0.5, -0.5);
					if (any(lessThan(prevUV, vec2(0.0))) || any(greaterThan(prevUV, vec2(1.0))))
						confidence = 0.0;
					else
						// Stored pre-exposed by last frame's P: undone, so the trace's output is absolute radiance.
						L_i = textureLod(SceneColorTexture, prevUV, 0.0).rgb * SsrParams3.y;
#if defined( DESERT_REFLECTIONS_WORLD_RAYS )
					// The depth there was certain: a world leg starts just before the surface the screen found.
					start = max(distance(t.origin, surface) - kWorldStartBackoff, 0.0);
#endif
				}
			}
		}
#if defined( DESERT_REFLECTIONS_WORLD_RAYS )
		// THE WORLD, where the screen did not answer (UE: the vignette and the thickness as a dither, so a
		// partly confident screen hit hands the rest of its rays over instead of fading them out).
		const float dither = hash12(vec2(gPix) + vec2(float(seed), float(r)) * 7.31);
		if (worldShare > dither && confidence <= dither)
		{
			s.worldWeight += w;
			if (hash12(vec2(gPix) * 1.37 + vec2(float(r), float(seed)) * 3.11) * s.worldWeight < w)
			{
				s.worldL     = L;
				s.worldStart = start;
				s.worldRay   = r;
			}
			continue;
		}
#endif
		if (confidence <= 0.0)
			continue;

		// Karis' inverse-luminance weight inside the estimator: a single ray onto a sun-lit wall does not
		// become a firefly the temporal accumulation has to average away over many frames.
		const float karis = 1.0 / (1.0 + dot(L_i, vec3(0.2126, 0.7152, 0.0722)));
		s.radiance  += L_i * (w * confidence * karis);
		s.hitWeight += w * confidence * karis;
		s.coverage  += w * confidence;
		s.hitPoint  += (w * confidence) * surface;
	}
	return true;
}

#if defined( DESERT_REFLECTIONS_TRACED )
// The drawn world ray's hit, radiance @p L_i at @p surface, added to the sums (SSRAddWorldRay; the software
// tracer's world legs in SSR.shader, which trace the ray leg by leg).
void SSRAddWorldHit(inout SSRTraceSums s, vec3 L_i, vec3 surface)
{
	const float karis = 1.0 / (1.0 + dot(L_i, vec3(0.2126, 0.7152, 0.0722)));
	s.radiance  += L_i * (s.worldWeight * karis);
	s.hitWeight += s.worldWeight * karis;
	s.coverage  += s.worldWeight;
	s.hitPoint  += s.worldWeight * surface;
}

// The drawn world ray of @p s (SSRTraceTexel), added to the sums when it hits. False: no world ray, or it missed -
// the sums are the screen's alone.
bool SSRAddWorldRay(SSRTexel t, inout SSRTraceSums s)
{
	if (s.worldWeight <= 0.0)
		return false;
	vec3 L_i;
	vec3 surface;
	if (!TraceWorld(t.worldPos, t.N, s.worldL, s.worldStart, L_i, surface))
		return false;
	SSRAddWorldHit(s, L_i, surface);
	return true;
}
#endif

// The texel's output from its sums: rgb = the ratio-estimated radiance of the hits, a = coverage (see the header);
// @p ray = the texel's ray for the reconstruction (TraceRayTexture): xyz = the point it hit (the weighted mean of
// the hit points; when nothing hit, a point kMissDistance along the weighted mean direction of all rays - the
// environment the next source answers is at infinity), w = the log2 pdf of drawing the direction to it from here.
// A texel with no ray: pdf 0 (log -126), which the reconstruction reads as "nothing to reuse".
vec4 SSRResolveTexel(SSRTexel t, SSRTraceSums s, out vec4 ray)
{
	ray = vec4(0.0, 0.0, 0.0, -126.0);
	if (s.weightSum <= 0.0)
		return vec4(0.0);
	if (s.hitWeight <= 0.0)
	{
		const vec3 Lt = normalize(s.rayDir);
		ray = vec4(t.worldPos + normalize(Lt.x * t.T + Lt.y * t.B + Lt.z * t.N) * kMissDistance,
		           Log2VNDFReflectionPdf(t.Ve, Lt, t.alpha));
		return vec4(0.0);
	}
	const vec3 hit = s.hitPoint / s.coverage;
	const vec3 L   = normalize(hit - t.worldPos);
	ray = vec4(hit, Log2VNDFReflectionPdf(t.Ve, vec3(dot(L, t.T), dot(L, t.B), max(dot(L, t.N), 1e-4)), t.alpha));

	const float fade = SSRRoughnessFade(t.roughness) * SsrParams.z;
	return vec4(s.radiance / s.hitWeight, clamp(s.coverage / s.weightSum * fade, 0.0, 1.0));
}

// The whole trace of the texel gPix in one thread - the screen, then its world ray where this permutation carries
// the tracer (the hit-lit ray generation). The compute's trace runs the screen leg alone (SSR.shader TraceListed).
vec4 TraceFrom(ivec2 gPix, ivec2 gSize, out vec4 ray)
{
	ray = vec4(0.0, 0.0, 0.0, -126.0);
	SSRTexel     t;
	SSRTraceSums s;
	if (!SSRTraceTexel(gPix, gSize, t, s))
		return vec4(0.0);
#if defined( DESERT_REFLECTIONS_TRACED )
	SSRAddWorldRay(t, s);
#endif
	return SSRResolveTexel(t, s, ray);
}

#endif
