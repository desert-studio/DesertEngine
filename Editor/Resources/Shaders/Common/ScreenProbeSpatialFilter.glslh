#ifndef SCREEN_PROBE_SPATIAL_FILTER_GLSLH
#define SCREEN_PROBE_SPATIAL_FILTER_GLSLH
// ONE PASS OF THE SCREEN PROBE SPATIAL FILTER AT ONE TEXEL (UE LumenScreenProbeFiltering.usf GatherNeighborRadiance),
// the one definition of its weights: ScreenProbeSpatialFilter.shader runs it over every texel per pass, and
// ScreenProbeFilter.shader's SP_FILTER_SPATIAL permutation runs the last pass in place of its own read (FPS-GI-FARFIELD:
// the last pass's output was read by its own probe's workgroup alone, so it never needs the atlas).
//
// The includer declares screenProbeParams, screenProbeIndex, screenProbes, screenProbeDisocclusion (float per uniform
// tile) and the ScreenProbeRadiance sampler (rgb = radiance, a = hit distance cm, SP_RES² per probe), and includes
// Common/ScreenProbes.glslh and Common/ScreenProbeTemporal.glslh (SP_DISOCCLUSION_FRACTION) first.
//
// Each texel gathers the same direction from the uniform probes of the four neighbouring tiles: weighted by how near
// the neighbour lies to this probe's plane and by the angle, seen from THIS probe, to the point the neighbour's ray hit
// (its hit distance clamped to this texel's own, which keeps contact shadows) - linear to zero at
// SP_SPATIAL_FILTER_MAX_RADIANCE_HIT_ANGLE (UE SpatialFilterMaxRadianceHitAngle). A disoccluded probe
// (ScreenProbeDisocclusion) drops the angle test: the temporal filter cannot help there.

// UE r.Lumen.ScreenProbeGather.SpatialFilterPositionWeightScale and SpatialFilterMaxRadianceHitAngle (10 degrees, in
// radians).
#define SP_SPATIAL_FILTER_POSITION_WEIGHT_SCALE 1000.0
#define SP_SPATIAL_FILTER_MAX_RADIANCE_HIT_ANGLE 0.17453293

// Texel @p t of @p probe's traced radiance. The first pass (SP_SPATIAL_FILTER_FILLS_SKIPPED, whose includer declares
// screenProbeTraceHit) reads a texel the screen leg skipped (Common/ScreenProbes.glslh THE SPARSE STABLE PROBES) as
// the mean of its traced row and column neighbours - the other checkerboard colour, so every one of them was traced
// - with the nearest of their hit distances (the angle test keeps contact shadows). Every later pass reads the
// rebuilt atlas.
vec4 SPSpatialFilterFetch( uint probe, ivec2 t )
{
    const ivec2 origin = SPAtlasOrigin( probe, SP_RES );
#if defined( SP_SPATIAL_FILTER_FILLS_SKIPPED )
    if ( SPTraceSkipped( screenProbeTraceHit[probe * SP_RES * SP_RES + uint( t.y ) * SP_RES + uint( t.x )] ) )
    {
        const ivec2 offsets[4] = ivec2[4]( ivec2( -1, 0 ), ivec2( 1, 0 ), ivec2( 0, -1 ), ivec2( 0, 1 ) );
        vec3        sum        = vec3( 0.0 );
        float       count      = 0.0;
        float       distance   = 3.0e38;
        for ( int i = 0; i < 4; ++i )
        {
            const ivec2 n = t + offsets[i];
            if ( any( lessThan( n, ivec2( 0 ) ) ) || any( greaterThanEqual( n, ivec2( SP_RES ) ) ) )
                continue;
            const vec4 traced = texelFetch( ScreenProbeRadiance, origin + n, 0 );
            sum += traced.rgb;
            count += 1.0;
            distance = min( distance, traced.a );
        }
        return vec4( sum / count, distance ); // a corner texel still has two neighbours
    }
#endif
    return texelFetch( ScreenProbeRadiance, origin + t, 0 );
}

// THE NEIGHBOURHOOD (FPS-SP-FILTER, UE LumenScreenProbeFiltering's per-probe neighbour setup): everything about the
// four neighbouring uniform probes that does not depend on the texel - which probe, its position and frame, its plane
// (position) weight, and whether this probe's tile is disoccluded - belongs to the probe, not the texel. The
// workgroup (one per probe, one thread per texel) builds it once in shared memory, one neighbour a lane; every texel
// then reads it. Before, each of the SP_RES² texels redid the four index reads, probe records, frames and exp2
// weights. Same expressions, same order: the same values as the per-texel form.
struct SPSpatialNeighbour
{
    mat3  frame;          // SPProbeFrame of its normal; frame[2] is the normal
    vec3  position;
    float positionWeight; // exp2( -scale * plane² ): how near it lies to this probe's plane
    uint  probe;          // SP_INVALID: none on that side (off the grid, untraced, or this probe itself)
};
shared SPSpatialNeighbour s_SPSpatialNeighbour[4];
shared uint               s_SPSpatialRelaxAngle; // 1: the probe's tile is disoccluded (or off the grid)
shared uint               s_SPSpatialNeighbours; // how many of the four are valid; 0: every texel keeps its own

// Builds THE NEIGHBOURHOOD of traced @p probe (record @p state) on lanes 0..4 of its workgroup (SP_RES >= 4: at least
// 16 lanes). Every lane of the group calls it, in uniform control flow: it contains barriers.
void SPSpatialFilterLoadNeighbourhood( uint probe, ScreenProbe state, uint lane )
{
    const ivec2 tile = SPUniformTileOf( SPProbePixelOf( state ) );
    if ( lane < 4u )
    {
        const ivec2        offsets[4] = ivec2[4]( ivec2( -1, 0 ), ivec2( 1, 0 ), ivec2( 0, -1 ), ivec2( 0, 1 ) );
        SPSpatialNeighbour n;
        n.probe          = SPUniformProbeAt( tile + offsets[lane] );
        n.frame          = mat3( 1.0 );
        n.position       = vec3( 0.0 );
        n.positionWeight = 0.0;
        if ( n.probe == probe )
            n.probe = SP_INVALID;
        if ( n.probe != SP_INVALID )
        {
            const ScreenProbe neighbour = screenProbes[n.probe];
            if ( neighbour.position.w <= 0.0 )
                n.probe = SP_INVALID;
            else
            {
                const float plane = abs( dot( neighbour.position.xyz - state.position.xyz, state.normal.xyz ) ) /
                                    state.position.w;
                n.frame          = SPProbeFrame( neighbour.normal.xyz );
                n.position       = neighbour.position.xyz;
                n.positionWeight = exp2( -SP_SPATIAL_FILTER_POSITION_WEIGHT_SCALE * plane * plane );
            }
        }
        s_SPSpatialNeighbour[lane] = n;
    }
    // The disoccluded share of the probe's uniform tile (ScreenProbeDisocclusion measures each tile once; an adaptive
    // probe takes its tile's); a probe off the grid counts as disoccluded.
    else if ( lane == 4u )
    {
        const bool relax = !SPUniformTileInside( tile ) ||
                           screenProbeDisocclusion[SPUniformTileIndex( tile )] > SP_DISOCCLUSION_FRACTION;
        s_SPSpatialRelaxAngle = relax ? 1u : 0u;
    }
    barrier();
    if ( lane == 0u )
    {
        uint valid = 0u;
        for ( uint i = 0u; i < 4u; ++i )
            valid += s_SPSpatialNeighbour[i].probe != SP_INVALID ? 1u : 0u;
        s_SPSpatialNeighbours = valid;
    }
    barrier();
}

// Texel @p t of traced @p probe (record @p state, the texel's world direction @p dir), after
// SPSpatialFilterLoadNeighbourhood: the filtered radiance in rgb, the texel's own hit distance carried through in a
// for the next pass.
vec4 SPSpatialFilterTexel( uint probe, ScreenProbe state, ivec2 t, vec3 dir )
{
    const vec4 own = SPSpatialFilterFetch( probe, t );
    // No valid neighbour: the texel is its own answer (sum / 1). Uniform over the group, no divergence.
    if ( s_SPSpatialNeighbours == 0u )
        return own;
    const float hitDistance = own.a;
    const vec3  p           = state.position.xyz;
    const bool  relaxAngle  = s_SPSpatialRelaxAngle != 0u;

    vec3  sum    = own.rgb;
    float weight = 1.0;
    for ( uint i = 0u; i < 4u; ++i )
    {
        const SPSpatialNeighbour neighbour = s_SPSpatialNeighbour[i];
        if ( neighbour.probe == SP_INVALID || dot( dir, neighbour.frame[2] ) <= 0.0 )
            continue;
        const vec4 ray         = SPSpatialFilterFetch( neighbour.probe, SPProbeTexel( neighbour.frame, dir ) );
        float      angleWeight = 1.0;
        if ( !relaxAngle )
        {
            const vec3  toHit = neighbour.position + dir * min( ray.a, hitDistance ) - p;
            const float angle = acos( clamp( dot( toHit, dir ) / max( length( toHit ), 1e-4 ), -1.0, 1.0 ) );
            angleWeight       = 1.0 - clamp( angle / SP_SPATIAL_FILTER_MAX_RADIANCE_HIT_ANGLE, 0.0, 1.0 );
        }
        const float w = neighbour.positionWeight * angleWeight;
        sum += ray.rgb * w;
        weight += w;
    }
    return vec4( sum / weight, hitDistance );
}

#endif // SCREEN_PROBE_SPATIAL_FILTER_GLSLH
