#ifndef SCREEN_PROBE_TEMPORAL_GLSLH
#define SCREEN_PROBE_TEMPORAL_GLSLH
// THE SCREEN PROBE GATHER'S HISTORY REPROJECTION — ported from UE 5.8
// Shaders/Private/StochasticLighting/StochasticLightingTileClassification.usf:874-1020 (the Lumen history taps: the
// history position from the velocity WITH its depth (GetHistoryScreenPosition, ReprojectedSceneDepth), the 2x2
// bilinear footprint, each tap kept by the depth test - LumenHistoryDistanceThreshold, ForFoliage on a
// bHasBackfaceDiffuse pixel -, the normal test and the foliage material test) and
// Shaders/Private/Lumen/LumenScreenProbeGatherTemporal.ush (the weighted average of the kept taps), adapted: the
// taps are tested where they are read (UE packs their validity into PackedPixelData in a classification pass);
// the history keeps the distance to its camera in DiffuseIndirectHistory.a (the view's depth history: UE
// DepthHistoryTexture holds scene depth, this the distance, which the plane of a grazing wall does not foreshorten),
// the normal + frames + foliage flag in HistoryGuide (UE NormalAndShadingInfoHistory and the frames of
// FastUpdateMode_NumFramesAccumulated) and the fast-update amount in RoughSpecularIndirectHistory.a; the surface's
// position of last frame is the inverse previous view-projection of its previous NDC.xyz (the velocity carries the device depth's change, UE
// VELOCITY_ENCODE_DEPTH), so a surface moving toward or away from the camera keeps its history.
// The constants are for every pass of the gather's denoiser; the functions need SCREEN_PROBE_HISTORY_DECLARED,
// defined by ScreenProbeDisocclusion and ScreenProbeTemporal after they declare screenProbeParams, giFrame,
// Velocity, GBufferShadingWord, DiffuseIndirectHistory and HistoryGuide and include Generated/ShadingModels.glslh.

// UE r.Lumen.ScreenProbeGather.Temporal.MaxFramesAccumulated.
#define SP_TEMPORAL_MAX_FRAMES_ACCUMULATED 10.0
// UE r.Lumen.ScreenProbeGather.Temporal.DistanceThreshold: the relative change of the distance above which a
// tap is another surface (raised at grazing angles and dithered, as UE does, for the jitter's depth change).
#define SP_TEMPORAL_DISTANCE_THRESHOLD 0.01
// UE r.Lumen.ScreenProbeGather.Temporal.DistanceThresholdForFoliage: a foliage pixel (UE bHasBackfaceDiffuse)
// sits among discontinuities and edges, so its history is kept more aggressively.
#define SP_TEMPORAL_DISTANCE_THRESHOLD_FOR_FOLIAGE 0.03
// UE r.Lumen.ScreenProbeGather.Temporal.NormalThreshold, 45 degrees.
#define SP_TEMPORAL_NORMAL_COS_THRESHOLD 0.70710678
// UE r.Lumen.ScreenProbeGather.SpatialFilter.DisocclusionMaxFrames / DisocclusionFraction: a pixel whose history
// holds fewer frames is disoccluded; a probe whose tile has more than that fraction of them filters harder.
#define SP_DISOCCLUSION_MAX_FRAMES 4.0
#define SP_DISOCCLUSION_FRACTION 0.4
// UE r.Lumen.ScreenProbeGather.Temporal.FractionOfLightingMovingForFastUpdateMode and MaxFastUpdateModeAmount: the
// share of moving rays at which the history goes fully fast, and the most of it the fast update may drop (the
// history always keeps (1 - this) x SP_TEMPORAL_MAX_FRAMES_ACCUMULATED frames' worth).
#define SP_TEMPORAL_FRACTION_OF_LIGHTING_MOVING_FOR_FAST_UPDATE_MODE 0.1
#define SP_TEMPORAL_MAX_FAST_UPDATE_MODE_AMOUNT 0.9

// UE LumenScreenProbeGatherTemporal.usf:488-489: the fast-update amount of a pixel whose LightIsMoving (the probes'
// moving share, ScreenProbeIntegrate) is @p lightIsMoving - nothing below a fifth of the fraction, then linear.
float SPFastUpdateModeAmount( float lightIsMoving )
{
    const float amount =
         clamp( lightIsMoving / SP_TEMPORAL_FRACTION_OF_LIGHTING_MOVING_FOR_FAST_UPDATE_MODE, 0.0, 1.0 );
    return clamp( min( ( amount - 0.2 ) / 0.8, SP_TEMPORAL_MAX_FAST_UPDATE_MODE_AMOUNT ), 0.0, 1.0 );
}

// HistoryGuide.w = frames accumulated (<= SP_TEMPORAL_MAX_FRAMES_ACCUMULATED) + this for a foliage pixel: both
// exact in RGBA16F (UE packs its foliage bit with the shading info, its frames with the fast-update amount).
#define SP_HISTORY_GUIDE_FOLIAGE 16.0

// The guide's w of a pixel: its accumulated @p frames and whether it is foliage (UE bHasBackfaceDiffuse).
float SPPackGuideW( float frames, bool foliage )
{
    return frames + ( foliage ? SP_HISTORY_GUIDE_FOLIAGE : 0.0 );
}

bool SPGuideFoliage( float w )
{
    // Halfway between the most frames a pixel holds and the flag: an averaged w of either kind stays on its side.
    return w > 0.5 * ( SP_HISTORY_GUIDE_FOLIAGE + SP_TEMPORAL_MAX_FRAMES_ACCUMULATED );
}

float SPGuideFrames( float w )
{
    return SPGuideFoliage( w ) ? w - SP_HISTORY_GUIDE_FOLIAGE : w;
}

#ifdef SCREEN_PROBE_HISTORY_DECLARED
// The history's 2x2 bilinear footprint around a pixel's previous position: the top-left tap and each tap's
// weight (00, 10, 01, 11), zero where the tap failed a test or left the screen.
struct SPHistoryTaps
{
    ivec2 origin;
    vec4  weights;
};

// The pixel's shading model has UE's backface diffuse (two-sided foliage): the foliage threshold and the material
// test of the history (UE Material.bHasBackfaceDiffuse).
bool SPPixelIsFoliage( ivec2 pixel )
{
    return DesertHasBackfaceDiffuse( DesertShadingModelIndex( texelFetch( GBufferShadingWord, pixel, 0 ).rg ) );
}

// @p deviceDepth / @p p / @p n: the pixel's G-buffer depth, world position and normal; @p foliage:
// SPPixelIsFoliage; @p noise: a [0, 1) value of the pixel (UE RandomScalar). No tap is kept when the history is
// not this view's previous frame (SP_FLAG_HISTORY_VALID).
SPHistoryTaps SPHistoryReproject( ivec2 pixel, float deviceDepth, vec3 p, vec3 n, bool foliage, float noise )
{
    SPHistoryTaps taps;
    taps.origin  = ivec2( 0 );
    taps.weights = vec4( 0.0 );
    if ( ( screenProbeParams.atlas.z & SP_FLAG_HISTORY_VALID ) == 0u )
        return taps;
    // The surface at the pixel's centre sits at its unjittered NDC (ndc - jitter); last frame it sat at that minus
    // the velocity, in xy and in device depth (UE GetHistoryScreenPosition); the history pixel holding it was
    // rasterised with last frame's jitter.
    const vec2 extent      = giFrame.screen.xy;
    const vec2 uv          = ( vec2( pixel ) + 0.5 ) * giFrame.screen.zw;
    const vec3 prevSurface =
         SPPreviousSurfaceNdc( screenProbeParams, uv, deviceDepth, texelFetch( Velocity, pixel, 0 ).xyz );
    const vec2 prevNdc     = prevSurface.xy + screenProbeParams.jitter.zw;
    const vec2 prevPixel   = vec2( prevNdc.x * 0.5 + 0.5, 0.5 - prevNdc.y * 0.5 ) * extent - 0.5;
    taps.origin            = ivec2( floor( prevPixel ) );
    const vec2 f           = prevPixel - vec2( taps.origin );
    const vec4 bilinear    = vec4( ( 1.0 - f.x ) * ( 1.0 - f.y ), f.x * ( 1.0 - f.y ), ( 1.0 - f.x ) * f.y, f.x * f.y );

    // UE ReprojectedSceneDepth: where the surface was last frame, as last frame's camera saw it - the value the
    // history holds for it when it is the same surface, moving or not.
    const float expected =
         length( SPPreviousWorldPosition( screenProbeParams, prevSurface ) - screenProbeParams.prevCamera.xyz );
    const float noV       = clamp( dot( n, normalize( giFrame.camera.xyz - p ) ), 0.0, 1.0 );
    const float relative  = foliage ? SP_TEMPORAL_DISTANCE_THRESHOLD_FOR_FOLIAGE : SP_TEMPORAL_DISTANCE_THRESHOLD;
    const float threshold = expected * relative * mix( 0.5, 1.5, noise ) / mix( 0.1, 1.0, noV );
    for ( int k = 0; k < 4; ++k )
    {
        const ivec2 tap = taps.origin + ivec2( k & 1, k >> 1 );
        if ( any( lessThan( tap, ivec2( 0 ) ) ) || any( greaterThanEqual( tap, ivec2( extent ) ) ) )
            continue;
        const float distance = texelFetch( DiffuseIndirectHistory, tap, 0 ).a;
        const vec4  guide    = texelFetch( HistoryGuide, tap, 0 );
        // Depth test, normal test, material test (UE: foliage never takes a non-foliage pixel's history, nor the
        // other way round).
        if ( distance > 0.0 && abs( distance - expected ) < threshold &&
             dot( guide.xyz, n ) >= SP_TEMPORAL_NORMAL_COS_THRESHOLD && SPGuideFoliage( guide.w ) == foliage )
            taps.weights[k] = bilinear[k];
    }
    return taps;
}

bool SPHistoryAnyValid( SPHistoryTaps taps )
{
    return dot( taps.weights, vec4( 1.0 ) ) > 0.0;
}

// The kept taps of @p history, averaged by their weights (UE WeightedAverage).
vec4 SPHistoryAverage( sampler2D history, SPHistoryTaps taps )
{
    vec4 sum = vec4( 0.0 );
    for ( int k = 0; k < 4; ++k )
        if ( taps.weights[k] > 0.0 )
            sum += taps.weights[k] * texelFetch( history, taps.origin + ivec2( k & 1, k >> 1 ), 0 );
    return sum / max( dot( taps.weights, vec4( 1.0 ) ), 1e-5 );
}

// The frames the history accumulated at the pixel (UE HistoryNumFramesAccumulated): 0 where no tap is kept. The
// kept taps share the pixel's foliage flag (the material test), so their average carries it whole.
float SPHistoryFrames( SPHistoryTaps taps )
{
    return SPHistoryAnyValid( taps ) ? SPGuideFrames( SPHistoryAverage( HistoryGuide, taps ).w ) : 0.0;
}
#endif // SCREEN_PROBE_HISTORY_DECLARED
#endif
