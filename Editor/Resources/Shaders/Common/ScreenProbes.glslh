#ifndef SCREEN_PROBES_GLSLH
#define SCREEN_PROBES_GLSLH

// THE SCREEN PROBE GATHER, GPU side (UE LumenScreenProbeCommon.ush / LumenScreenProbeGather.usf). The C++ side and
// the design notes are Graphic/GlobalIllumination/ScreenProbeGather.hpp; the records here must match it byte for
// byte. Binding-free, in two sections like Common/RadianceCache.glslh: the includer includes the file once for the
// records, declares `ScreenProbeParams screenProbeParams`, the index array `screenProbeIndex[]` and the probe array
// `screenProbes[]`, defines SCREEN_PROBES_DECLARED and includes it again for the readers.
//
// THE PROBES (UE LumenScreenProbeGather.usf ScreenProbeDownsampleDepthUniformCS / ScreenProbeAdaptivePlacementCS,
// LumenScreenProbeCommon.ush CalculateUpsampleInterpolationWeights). A uniform probe sits in every SP_DOWNSAMPLE
// tile (UE r.Lumen.ScreenProbeGather.DownsampleFactor 16) at the frame's jitter (SPJitter: UE GetScreenTileJitter,
// eight positions over eight frames). Then two adaptive levels on the 8 and 4 pixel grids at the same jitter, the
// positions of a coarser grid skipped: a position on geometry that the probes already placed cannot interpolate
// (SPInterpolate's summed weight under SP_ADAPTIVE_EPSILON: a depth edge, a twig, a leaf card alone against the
// sky) gets an adaptive probe while the budget lasts, listed under the uniform tile it falls in.
// screenProbeIndex: [0] = adaptive probes requested (past the budget too), then the uniform grid (probe index or
// SP_INVALID; uniform probe i is cell i), then per uniform tile one adaptive count per adaptive level
// (SPTileHeader), then per uniform tile SP_ADAPTIVE_PER_TILE adaptive probe slots (SPTileSlot). Adaptive probes
// follow the uniform ones in screenProbes[].
//
// A probe's radiance is a HEMI-octahedron (Cigolle et al.) around its G-buffer normal, SP_RES texels a side: every
// one of its rays leaves the surface. UE traces a world-space full octahedron and spends the texels below the
// surface on importance sampling; here no texel is below it, so all SP_RES² rays carry light.

#define SP_DOWNSAMPLE 16u
#define SP_LEVELS 3u
#define SP_RES 8u
#define SP_TILE ( SP_RES + 2u ) // a filtered probe with its one-texel border
#define SP_INVALID 0xFFFFFFFFu
// UE's Epsilon of the upsample: below this summed interpolation weight a pixel has no probe lighting. A placement
// position under it gets an adaptive probe; an integrated pixel under it (the budget spent) reads the world radiance
// cache; a uniform corner at or under it is replaced by its tile's best adaptive probe.
#define SP_ADAPTIVE_EPSILON 0.01
// The adaptive positions of one uniform tile: 2x2 - 1 on the 8 pixel grid, 4x4 - 2x2 on the 4 pixel grid
// (GlobalIllumination::ScreenProbeLayout::kAdaptivePerTile).
#define SP_ADAPTIVE_PER_TILE 15u

// std430 — must match GlobalIllumination::ScreenProbeParamsPayload (192 bytes).
struct ScreenProbeParams {
    mat4  prevViewProjection; // last frame's (unjittered) view-projection: the screen trace's reprojection
    mat4  prevInvViewProjection; // its inverse: the temporal filter's previous world position of a pixel
    vec4  prevCamera;         // xyz = last frame's camera (cm), w = 1 / PrevPreExposure (the scene colour history's scale)
    vec4  jitter;             // xy = this frame's jitter in NDC, zw = last frame's (the temporal filter's history)
    uvec4 grid;               // xy = level-0 grid, z = uniform probes, w = adaptive probe budget
    uvec4 atlas;              // x = probes per atlas row, y = frame index, z = SP_FLAG_* below,
                              // w = the probes' jitter in pixels (x | y << 16)
};

// UE GetHistoryScreenPosition: where the surface seen at @p uv (top-left) with @p deviceDepth sat last frame, as
// last frame's unjittered NDC.xyz - its unjittered NDC minus the velocity (NDC.xyz current - previous,
// View/Velocity.hpp), in xy and in device depth (UE VELOCITY_ENCODE_DEPTH).
vec3 SPPreviousSurfaceNdc( ScreenProbeParams params, vec2 uv, float deviceDepth, vec3 velocity )
{
    const vec2 ndc = vec2( uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0 );
    return vec3( ndc - params.jitter.xy - velocity.xy, deviceDepth - velocity.z );
}

// UE GetPrevTranslatedWorldPosition: the world position, cm, of last frame's NDC.xyz @p previousNdc
// (SPPreviousSurfaceNdc). A surface's world velocity is its position minus this one.
vec3 SPPreviousWorldPosition( ScreenProbeParams params, vec3 previousNdc )
{
    const vec4 world = params.prevInvViewProjection * vec4( previousNdc, 1.0 );
    return world.xyz / world.w;
}

// ScreenProbeParams.atlas.z — must match GlobalIllumination::kScreenProbe* (ScreenProbeGather.hpp).
#define SP_FLAG_HISTORY_VALID  1u // the temporal filter's history set is this view's previous frame
#define SP_FLAG_SHORT_RANGE_AO 2u // the ShortRangeAO pass ran this frame: the integrate reads its bent normal + AO
#define SP_FLAG_SCREEN_TRACE   4u // the scene colour history holds the previous frame: the screen trace runs

// std430 — must match GlobalIllumination::ScreenProbePayload (32 bytes).
struct ScreenProbe {
    vec4 position; // xyz = world (cm), w = distance to the camera (cm); 0 = no probe
    vec4 normal;   // xyz = the G-buffer normal at the probe's pixel, w = that pixel (SPPackPixel)
};

// A pixel in one float, exactly (both coordinates below 4096: 24 bits).
float SPPackPixel( ivec2 pixel )
{
    return float( pixel.y * 4096 + pixel.x );
}

ivec2 SPProbePixelOf( ScreenProbe probe )
{
    const int packed = int( probe.normal.w );
    return ivec2( packed % 4096, packed / 4096 );
}

uvec2 SPGridSize( uint level, vec2 extent )
{
    const uint s = SP_DOWNSAMPLE >> level;
    return ( uvec2( extent ) + s - 1u ) / s;
}

// The pixel a probe of @p cell at @p level sits on: the cell's corner plus the frame's jitter (inside the extent
// only for the uniform level; an adaptive position past the extent is skipped).
ivec2 SPProbePixel( uint level, ivec2 cell, uvec2 jitter )
{
    return cell * int( SP_DOWNSAMPLE >> level ) + ivec2( jitter );
}

// The adaptive probe slots of a level inside its uniform tile's SP_ADAPTIVE_PER_TILE: 3 at 8 px, then 12 at 4 px.
uint SPLevelSlotBase( uint level )
{
    return level == 1u ? 0u : 3u;
}

uint SPLevelSlots( uint level )
{
    return level == 1u ? 3u : 12u;
}

// The orthonormal frame of a probe's hemisphere around @p n (Duff et al. 2017, branchless).
mat3 SPProbeFrame( vec3 n )
{
    const float s = n.z >= 0.0 ? 1.0 : -1.0;
    const float a = -1.0 / ( s + n.z );
    const float b = n.x * n.y * a;
    return mat3( vec3( 1.0 + s * n.x * n.x * a, s * b, -s * n.x ), vec3( b, s + n.y * n.y * a, -n.y ), n );
}

// Hemi-octahedral mapping (Cigolle et al. 2014): [-1,1]^2 <-> the hemisphere z >= 0.
vec3 SPHemiOctDecode( vec2 o )
{
    const vec2 t = vec2( o.x + o.y, o.x - o.y ) * 0.5;
    return normalize( vec3( t, 1.0 - abs( t.x ) - abs( t.y ) ) );
}

vec2 SPHemiOctEncode( vec3 v )
{
    v /= abs( v.x ) + abs( v.y ) + max( v.z, 0.0 );
    return vec2( v.x + v.y, v.x - v.y );
}

// A world direction in the probe's frame, pushed onto the hemisphere when it points under it.
vec2 SPProbeOct( mat3 frame, vec3 direction )
{
    vec3 local = transpose( frame ) * direction;
    if ( local.z < 0.0 )
        local = normalize( vec3( local.xy, 0.0 ) + vec3( 0.0, 0.0, 1e-4 ) );
    return SPHemiOctEncode( local );
}

// The texel of the probe's traced texels a world direction falls in.
ivec2 SPProbeTexel( mat3 frame, vec3 direction )
{
    return clamp( ivec2( ( SPProbeOct( frame, direction ) * 0.5 + 0.5 ) * float( SP_RES ) ), ivec2( 0 ),
                  ivec2( SP_RES - 1u ) );
}

// ---- Irradiance: second-order spherical harmonics, already convolved with the clamped cosine and / pi (the
// baked irradiance cube's convention: a white sky reads 1). Nine vec4 per probe (rgb used).
float SPSHBasis( uint k, vec3 d )
{
    switch ( k )
    {
        case 0u: return 0.282095;
        case 1u: return 0.488603 * d.y;
        case 2u: return 0.488603 * d.z;
        case 3u: return 0.488603 * d.x;
        case 4u: return 1.092548 * d.x * d.y;
        case 5u: return 1.092548 * d.y * d.z;
        case 6u: return 0.315392 * ( 3.0 * d.z * d.z - 1.0 );
        case 7u: return 1.092548 * d.x * d.z;
        default: return 0.546274 * ( d.x * d.x - d.y * d.y );
    }
}

// Ramamoorthi & Hanrahan's cosine-lobe band factors A_l / pi.
float SPSHCosineBand( uint k )
{
    return k == 0u ? 1.0 : ( k < 4u ? 2.0 / 3.0 : 0.25 );
}

#endif // SCREEN_PROBES_GLSLH

#if defined( SCREEN_PROBES_DECLARED ) && !defined( SCREEN_PROBES_READ_GLSLH )
#define SCREEN_PROBES_READ_GLSLH

ivec2 SPAtlasOrigin( uint probe, uint texelsPerProbe )
{
    const uint row = screenProbeParams.atlas.x;
    return ivec2( probe % row, probe / row ) * int( texelsPerProbe );
}

uvec2 SPJitter()
{
    return uvec2( screenProbeParams.atlas.w & 0xFFFFu, screenProbeParams.atlas.w >> 16u );
}

// The uniform tile a pixel falls in (the grid is shifted by the jitter: the strip before it is tile -1).
ivec2 SPUniformTileOf( ivec2 pixel )
{
    return ivec2( floor( vec2( pixel - ivec2( SPJitter() ) ) / float( SP_DOWNSAMPLE ) ) );
}

bool SPUniformTileInside( ivec2 tile )
{
    return all( greaterThanEqual( tile, ivec2( 0 ) ) ) && all( lessThan( uvec2( tile ), screenProbeParams.grid.xy ) );
}

uint SPUniformTileIndex( ivec2 tile )
{
    return uint( tile.y ) * screenProbeParams.grid.x + uint( tile.x );
}

uint SPUniformProbeAt( ivec2 tile )
{
    return SPUniformTileInside( tile ) ? screenProbeIndex[1u + SPUniformTileIndex( tile )] : SP_INVALID;
}

// The index entry of a uniform tile's adaptive count of @p level (1 or 2), and of its adaptive slot @p k.
uint SPTileHeader( uint tile, uint level )
{
    return 1u + screenProbeParams.grid.z + tile * ( SP_LEVELS - 1u ) + level - 1u;
}

uint SPTileSlot( uint tile, uint level, uint k )
{
    return 1u + screenProbeParams.grid.z * SP_LEVELS + tile * SP_ADAPTIVE_PER_TILE + SPLevelSlotBase( level ) + k;
}

// UE's upsample plane weight (CalculateUpsampleInterpolationWeights, PLANE_WEIGHTING): how far probe @p id lies
// from the plane of the surface point @p p (normal @p n, @p viewDistance from the camera), relative to the depth —
// times its hemisphere facing the point's normal: a probe here is a hemi-octahedron around its own normal (UE's is
// a full octahedron), so a probe turned away from the point holds nothing it can read.
float SPProbeWeight( uint id, vec3 p, vec3 n, float viewDistance )
{
    const ScreenProbe probe = screenProbes[id];
    if ( probe.position.w <= 0.0 )
        return 0.0;
    const float plane = abs( dot( probe.position.xyz - p, n ) ) / max( viewDistance, 1.0 );
    return exp2( -10000.0 * plane * plane ) * max( dot( n, probe.normal.xyz ), 0.0 );
}

// UE CalculateUpsampleInterpolationWeights: the four uniform probes around @p pixel, bilinear x plane weight; a
// corner whose weight is at or under SP_ADAPTIVE_EPSILON takes the best adaptive probe of that corner's tile from
// the adaptive levels below @p levels (1 = none, SP_LEVELS = all), weighted by its plane and its screen distance
// to the pixel (1 at the pixel, 0 a uniform spacing away). Placement and integrate share it, so a position the
// placement left without a probe is exactly a pixel the integrate finds no probe for.
void SPInterpolate( ivec2 pixel, vec3 p, vec3 n, float viewDistance, uint levels, out uvec4 ids, out vec4 weights )
{
    const vec2  c = vec2( pixel - ivec2( SPJitter() ) ) / float( SP_DOWNSAMPLE );
    const ivec2 b = ivec2( floor( c ) );
    const vec2  f = c - vec2( b );
    for ( int i = 0; i < 4; ++i )
    {
        const ivec2 tile     = b + ivec2( i & 1, i >> 1 );
        const vec2  bilinear = mix( 1.0 - f, f, vec2( i & 1, i >> 1 ) );
        uint        id       = SPUniformProbeAt( tile );
        float       w = id == SP_INVALID ? 0.0 : bilinear.x * bilinear.y * SPProbeWeight( id, p, n, viewDistance );
        if ( w <= SP_ADAPTIVE_EPSILON && SPUniformTileInside( tile ) )
        {
            const uint t = SPUniformTileIndex( tile );
            for ( uint level = 1u; level < levels; ++level )
            {
                const uint count = min( screenProbeIndex[SPTileHeader( t, level )], SPLevelSlots( level ) );
                for ( uint k = 0u; k < count; ++k )
                {
                    const uint  candidate = screenProbeIndex[SPTileSlot( t, level, k )];
                    const vec2  d         = abs( vec2( SPProbePixelOf( screenProbes[candidate] ) - pixel ) );
                    const float corner    = 1.0 - clamp( max( d.x, d.y ) / float( SP_DOWNSAMPLE ), 0.0, 1.0 );
                    const float candidateW = corner * SPProbeWeight( candidate, p, n, viewDistance );
                    if ( candidateW > w )
                    {
                        w  = candidateW;
                        id = candidate;
                    }
                }
            }
        }
        ids[i]     = w > 0.0 ? id : SP_INVALID;
        weights[i] = w > 0.0 ? w : 0.0;
    }
}

#endif // SCREEN_PROBES_DECLARED
