#ifndef SHADOW_FILTER_DISK_GLSLH
#define SHADOW_FILTER_DISK_GLSLH

// THE SHADOW FILTERS' TAP PATTERN, one text for every percentage-closer filter of a shadow map: the sun's PCSS
// (Mesh/CascadedShadow.glslh) and the point and spot lights' PCF (Mesh/LocalLightShadow.glslh). A Vogel disc
// (golden-angle spiral) of n taps, turned per pixel by interleaved gradient noise, so the taps of neighbouring
// pixels interleave and the temporal filter blends them, instead of one fixed pattern banding. n is
// Scalability Shadows.FilterTaps (u_ShadowFilter.y) for both, as UE filters its local lights at the same
// r.ShadowQuality as its sun.

const float kGoldenAngle = 2.39996323;

// Jimenez 2014, the noise UE's shadow filters turn their discs by.
float shadowInterleavedGradientNoise(vec2 pixel)
{
	return fract(52.9829189 * fract(dot(pixel, vec2(0.06711056, 0.00583715))));
}

// Tap i of n on the unit disc, the disc turned by phi.
vec2 shadowVogelDisk(int i, int n, float phi)
{
	float r     = sqrt((float(i) + 0.5) / float(n));
	float theta = float(i) * kGoldenAngle + phi;
	return r * vec2(cos(theta), sin(theta));
}

#endif // SHADOW_FILTER_DISK_GLSLH
