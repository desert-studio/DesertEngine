// THE SURFACE CACHE'S EMISSIVE LIGHTING, ONE TEXEL (GI-TEMPORAL; the contract is Common/EmissiveCardLighting.glslh):
// the resources and the per-texel estimate of SurfaceCacheEmissiveLighting.shader (raster: one fragment per atlas
// texel of a relit page, blended with the layer's history by the pipeline) and SurfaceCacheEmissiveLightingAsync.shader
// (compute on the async queue: one thread per texel of a listed lighting tile, the blend in the shader). The page
// records (SurfaceCardPageBuffer, binding 0) and the relit page list (SurfaceLightingPages, binding 1) are the
// includer's. Numbers as the direct lighting has them: 2..5, 7, 28, the tracer at 29..39, the emissive list at 40..46.
#ifndef SURFACE_CACHE_EMISSIVE_LIGHTING_TEXEL_GLSLH
#define SURFACE_CACHE_EMISSIVE_LIGHTING_TEXEL_GLSLH
#include <Common/EmissiveCardLighting.glslh>
#include <Common/SurfaceCache.glslh>
#include <Mesh/BRDF.glslh> // PI
ReadBuffer(2) SurfaceCardBuffer
{
    SurfaceCard surfaceCards[];
};
// No LinearRepeatSampler here: no read of the texel goes through it; the software tracer declares it for its own
// clipmap reads (Common/GITracer.glslh), so the hardware variant carries none.
Uniform sampler PointClampSampler;
Uniform(3) texture2D AtlasDepthTexture;
#define AtlasDepthTexture sampler2D(AtlasDepthTexture, PointClampSampler)
Uniform(4) texture2D AtlasAlbedoTexture;
#define AtlasAlbedoTexture sampler2D(AtlasAlbedoTexture, PointClampSampler)
Uniform(5) texture2D AtlasOpacityTexture;
#define AtlasOpacityTexture sampler2D(AtlasOpacityTexture, PointClampSampler)
Uniform(7) texture2D AtlasNormalTexture;
#define AtlasNormalTexture sampler2D(AtlasNormalTexture, PointClampSampler)
// The light the texel lets through (rgb); 0 = opaque (SurfaceCacheCardCopy).
Uniform(28) texture2D AtlasSubsurfaceTexture;
#define AtlasSubsurfaceTexture sampler2D(AtlasSubsurfaceTexture, PointClampSampler)
#ifndef RADIOSITY_OPACITY
#define RADIOSITY_OPACITY AtlasOpacityTexture
#endif
#include <Common/SurfaceCacheRadiosity.glslh> // the texel's page, world position and normal, as the card lighting

// The active GI tracer's reads (GlobalIllumination::DeclareTracerReads), bindings 29..39 - below the emissive list.
#define GI_TRACER_BINDING 29
#include <Common/GITracer.glslh>
#include <Common/SurfaceCacheTracedShadow.glslh>

PushConstant SurfaceEmissiveLightingPush
{
    uvec4 EmissiveFrame;         // x = frame index (the seed), y = 1: no history (weight 1 everywhere)
    vec4  EmissiveWeights;       // x = the new estimate's weight against the history
    uvec4 EmissiveCounts;        // RayTracing::EmissiveLightsFrame::StaticParams()
    uvec4 EmissiveDynamicCounts; // RayTracing::EmissiveLightsFrame::DynamicParams()
};

// The scene's emissive triangles (RayTracing::EmissiveLightsFrame), bindings 40..46 after the tracer's.
#include <Common/EmissiveLights.glslh>
layout(std430, binding = 40) readonly buffer EmissiveSegmentsUB
{
    EmissiveSegment emissiveSegments[];
};
layout(std430, binding = 41) readonly buffer EmissiveLookupUB
{
    uint emissiveLookup[];
};
layout(std430, binding = 42) readonly buffer EmissiveTrianglesUB
{
    EmissiveTriangle emissiveTriangles[];
};
layout(std430, binding = 43) readonly buffer EmissivePowerUB
{
    float emissivePower[];
};
layout(std430, binding = 44) readonly buffer EmissiveDynamicSegmentsUB
{
    EmissiveSegment emissiveDynamicSegments[];
};
layout(std430, binding = 45) readonly buffer EmissiveDynamicTrianglesUB
{
    EmissiveTriangle emissiveDynamicTriangles[];
};
layout(std430, binding = 46) readonly buffer EmissiveDynamicPowerUB
{
    float emissiveDynamicPower[];
};
#include <Common/EmissiveLightsSampling.glslh>

// A per-texel, per-frame random stream (PCG hash, as the radiosity's strata jitter).
uint EmissiveHash(uvec3 v)
{
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v.x ^ v.y ^ v.z;
}
float EmissiveRandom(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    const uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return float((word >> 22u) ^ word) * (1.0 / 4294967296.0);
}

// The emissive triangles' irradiance at the texel (front, +N, into @p irradiance; the far side, -N, into
// @p back on a subsurface texel): an unbiased estimate of @p samples samples, each a triangle by power and a point
// on it by area (the path tracer's PathTracingSampleEmissive), radiance x |cos| / its solid-angle density, shadowed
// by the tracer's visibility ray, one sample's contribution capped at kEmissiveMaxSampleIntensity (a tiny pdf
// otherwise leaves a lone texel orders of magnitude above its neighbours). The ray stops short of the sampled point
// by a margin (the emitter's own surface is not its occluder); emission is two-sided (EmissiveLightsNormal).
void AddEmissiveLights(vec3 worldPos, vec3 N, bool through, uvec2 seed, uint samples, inout vec3 irradiance,
                       inout vec3 back)
{
    if (EmissiveLightsTriangleCount(EmissiveCounts, EmissiveDynamicCounts) == 0u ||
        EmissiveLightsTotal(EmissiveCounts, EmissiveDynamicCounts) <= 0.0)
        return;
    uint        rng   = EmissiveHash(uvec3(seed, EmissiveFrame.x));
    const float scale = 1.0 / float(samples);
    for (uint s = 0u; s < samples; ++s)
    {
        const float pick     = EmissiveRandom(rng);
        const vec2  u        = vec2(EmissiveRandom(rng), EmissiveRandom(rng));
        const uint  triangle = EmissiveLightsPick(pick, EmissiveCounts, EmissiveDynamicCounts);
        if (triangle >= EmissiveLightsTriangleCount(EmissiveCounts, EmissiveDynamicCounts))
            continue;
        const EmissiveTriangle t       = EmissiveLightsTriangle(triangle, EmissiveCounts);
        const vec3             toPoint = EmissiveLightsSamplePoint(t, u) - worldPos;
        const float            dist    = length(toPoint);
        if (dist <= 0.0)
            continue;
        const vec3  L     = toPoint / dist;
        const float NdotL = dot(N, L);
        const bool  front = NdotL > 0.0;
        if (!front && !(through && NdotL < 0.0))
            continue;
        const float lightPdf = EmissiveLightsSolidAnglePdf(
            t, EmissiveLightsPickPdf(triangle, EmissiveCounts, EmissiveDynamicCounts), dist,
            dot(EmissiveLightsNormal(t), L));
        if (!(lightPdf > 0.0))
            continue;
        const uint            row     = floatBitsToUint(t.Edge2Segment.w);
        const EmissiveSegment segment = triangle < EmissiveCounts.x ? emissiveSegments[row]
                                                                    : emissiveDynamicSegments[row];
        const vec3 radiance = segment.Radiance.rgb;
        if (max(radiance.r, max(radiance.g, radiance.b)) <= 0.0)
            continue;
        // Short of the sampled point by 1 % (the emitter's own triangles do not shadow it).
        const vec3  side       = front ? N : -N;
        const float visibility = TracedShadow(worldPos, side, L, dist * 0.99);
        if (visibility <= 0.0)
            continue;
        const vec3 contribution = SurfaceCacheClampLuminance(radiance * abs(NdotL) * visibility / lightPdf,
                                                             kEmissiveMaxSampleIntensity) * scale;
        if (front)
            irradiance += contribution;
        else
            back += contribution;
    }
}

// The texel @p atlasTexel of the relit page of card @p cardIndex (card rectangle @p cardUVRect, atlas rectangle
// @p atlasUVRect; @p captured != 0: captured this frame): rgb = the emissive triangles' diffuse radiance it leaves
// (albedo / PI x front + subsurface / PI x back irradiance), a = that estimate's weight against the layer's history.
// A texel the capture saw no surface in (opacity < 0.5) is zero, weight 1.
vec4 EmissiveLightingTexel(ivec2 atlasTexel, uint cardIndex, vec4 cardUVRect, vec4 atlasUVRect, uint captured)
{
    if (texelFetch(AtlasOpacityTexture, atlasTexel, 0).r < 0.5)
        return vec4(0.0, 0.0, 0.0, 1.0);
    const float weight  = (captured != 0u || EmissiveFrame.y != 0u) ? 1.0 : EmissiveWeights.x;
    const uint  samples = weight >= 1.0 ? kEmissiveSamplesFirstPass : kEmissiveSamplesPerTexel;

    const SurfaceCard card = surfaceCards[cardIndex];
    const ivec4 page     = RadiosityPageTexels(atlasUVRect, vec2(textureSize(AtlasOpacityTexture, 0)));
    const vec3  worldPos = RadiosityTexelWorldPosition(card, cardUVRect, page, atlasTexel,
                                                       texelFetch(AtlasDepthTexture, atlasTexel, 0).r);
    const vec3  N = RadiosityOctahedronToUnitVector(texelFetch(AtlasNormalTexture, atlasTexel, 0).rg * 2.0 - 1.0);

    const vec3 subsurface = texelFetch(AtlasSubsurfaceTexture, atlasTexel, 0).rgb;
    const bool through    = max(subsurface.r, max(subsurface.g, subsurface.b)) > 0.0;
    vec3       irradiance = vec3(0.0);
    vec3       back       = vec3(0.0);
    AddEmissiveLights(worldPos, N, through, uvec2(atlasTexel), samples, irradiance, back);
    const vec3 albedo = texelFetch(AtlasAlbedoTexture, atlasTexel, 0).rgb;
    return vec4(albedo / PI * irradiance + subsurface / PI * back, weight);
}
#endif // SURFACE_CACHE_EMISSIVE_LIGHTING_TEXEL_GLSLH
