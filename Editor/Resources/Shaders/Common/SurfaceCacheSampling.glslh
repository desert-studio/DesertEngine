#ifndef SURFACE_CACHE_SAMPLING_GLSLH
#define SURFACE_CACHE_SAMPLING_GLSLH

// A TRACED HIT READ FROM THE SURFACE CACHE (GI-CARD-LOOKUP; UE LumenSurfaceCacheSampling.ush SampleLumenMeshCards /
// EvaluateRayHitFromSurfaceCache). The C++ side is GlobalIllumination::SurfaceCacheFrame (GITracing.hpp) and the
// records of Graphic/GlobalIllumination/SurfaceCache.hpp; the reads are declared here, at descriptor bindings
// GI_SURFACE_CACHE_BINDING .. GI_SURFACE_CACHE_BINDING + 6, which the includer reserves and defines.
//
// WHICH CARDS (contract B3): the rows the tracer names for the hit (GIHitInstanceRows) - the hardware hit's own
// instance, or for a distance-field hit the four instances whose surfaces lie nearest its object grid cell, nearest
// first (UE EvaluateGlobalDistanceFieldHit over GlobalDistanceFieldPageObjectGridBuffer). The search ends at the
// first rows that hold the hit (UE: a summed weight of 0.9). A row gives the instance's MeshCards record.
//
// WHICH TEXELS: per world axis of the hit normal (in the mesh's frame) the cards facing it (MeshCards.cardLookup),
// weighted by the squared normal component (UE: the normal's projection weights). A card counts where the hit
// lies inside its box grown by half the SURFACE CACHE BIAS (GIHitSurfaceCacheBias: the traced field's precision,
// UE's SurfaceCacheBias - 20 cm for a mesh SDF hit), over its four texels around the hit, each where the capture
// saw a surface (opacity) and the captured depth lies within the bias of the hit's - UE SampleLumenCard. The
// weighted mean of the FinalLighting texels is the hit's radiance; a hit no card holds returns false and is lit in
// place.

#include <Common/SurfaceCache.glslh>

#ifndef GI_SURFACE_CACHE_BINDING
#error "SurfaceCacheSampling.glslh: define GI_SURFACE_CACHE_BINDING (the first of the surface cache's seven bindings)"
#endif

layout( std430, binding = GI_SURFACE_CACHE_BINDING + 0 ) readonly buffer SurfaceCardBuffer
{
    SurfaceCard surfaceCards[];
};
layout( std430, binding = GI_SURFACE_CACHE_BINDING + 1 ) readonly buffer SurfaceCardPageBuffer
{
    SurfaceCardPage surfaceCardPages[];
};
layout( std430, binding = GI_SURFACE_CACHE_BINDING + 2 ) readonly buffer SurfaceMeshCardsBuffer
{
    MeshCards surfaceMeshCards[];
};

// std430 — must match SurfaceCache::InstanceRowPayload (48 bytes).
struct SurfaceCacheInstance {
    uvec4 cards;     // x = MeshCards index or GI_NO_MESH_CARDS, y = first page, z = page count
    vec4  boundsMin; // world box of the instance's cards, cm
    vec4  boundsMax;
};
layout( std430, binding = GI_SURFACE_CACHE_BINDING + 3 ) readonly buffer SurfaceCacheInstancesUB
{
    SurfaceCacheInstance surfaceCacheInstances[];
};
layout( binding = GI_SURFACE_CACHE_BINDING + 4 ) uniform sampler2D u_SurfaceCacheFinalLighting;
layout( binding = GI_SURFACE_CACHE_BINDING + 5 ) uniform sampler2D u_SurfaceCacheDepth;
layout( binding = GI_SURFACE_CACHE_BINDING + 6 ) uniform sampler2D u_SurfaceCacheOpacity;
// Below this summed weight the cards hold too little of the hit to stand for it (UE: bValid needs a weight).
#define SURFACE_CACHE_MIN_HIT_WEIGHT 0.05
// From this summed weight on the rows read so far hold the hit: the farther rows are not read (UE
// EvaluateGlobalDistanceFieldHit: SampleWeightSum >= 0.9).
#define SURFACE_CACHE_ENOUGH_HIT_WEIGHT 0.9

struct SurfaceCacheHitSample {
    vec3  lighting; // weighted FinalLighting
    float weight;
};

// The atlas texel holding texel @p texel of @p card's resolution (the page table of the card's pages).
ivec2 SurfaceCacheCardAtlasTexel( SurfaceCard card, uvec2 res, uvec2 texel, vec2 atlasSize )
{
    const uvec2 pages = uvec2( card.pages.x & 0xFFFFu, card.pages.x >> 16u );
    uvec2       page  = uvec2( 0u );
    if ( res.x >= SURFACE_CACHE_PHYSICAL_PAGE_SIZE )
        page.x = min( texel.x / SURFACE_CACHE_VIRTUAL_PAGE_SIZE, pages.x - 1u );
    if ( res.y >= SURFACE_CACHE_PHYSICAL_PAGE_SIZE )
        page.y = min( texel.y / SURFACE_CACHE_VIRTUAL_PAGE_SIZE, pages.y - 1u );
    const SurfaceCardPage entry = surfaceCardPages[card.pages.y + page.y * max( pages.x, 1u ) + page.x];
    return ivec2( entry.physicalAtlasUVRect.xy * atlasSize + 0.5 ) +
           ivec2( texel - page * SURFACE_CACHE_VIRTUAL_PAGE_SIZE );
}

// The cards of one instance at the hit, accumulated into @p acc (UE SampleLumenMeshCards / SampleLumenCard). A card
// counts where the hit lies in its box grown by half the bias (then clamped onto its face); its four texels around
// the hit are each weighted bilinearly, by whether the capture saw a surface there (UE IsSurfaceCacheDepthValid:
// the opacity) and by UE's depth visibility - full within the bias of the captured depth, falling to none over a
// quarter of it beyond (both in the card's normalised depth, 0 at the card plane, 1 at the far side).
void SurfaceCacheSampleMeshCards( uint meshCardsIndex, vec3 position, vec3 normal, float bias,
                                  inout SurfaceCacheHitSample acc )
{
    const MeshCards mesh = surfaceMeshCards[meshCardsIndex];
    // The hit normal in the mesh's frame: its axes pick the card directions.
    const vec3 localNormal = vec3( dot( mesh.worldToLocal[0].xyz, normal ), dot( mesh.worldToLocal[1].xyz, normal ),
                                   dot( mesh.worldToLocal[2].xyz, normal ) );
    const vec2 atlasSize = vec2( textureSize( u_SurfaceCacheFinalLighting, 0 ) );
    for ( uint axis = 0u; axis < 3u; ++axis )
    {
        const float axisWeight = localNormal[axis] * localNormal[axis];
        if ( axisWeight < 0.01 )
            continue;
        // CardDirection: NegativeX, PositiveX, NegativeY, PositiveY, NegativeZ, PositiveZ.
        const uint direction = axis * 2u + ( localNormal[axis] >= 0.0 ? 1u : 0u );
        uint       mask      = MeshCardsFacing( mesh, direction );
        while ( mask != 0u )
        {
            const uint bit = findLSB( mask );
            mask &= mask - 1u;
            const SurfaceCard card = surfaceCards[mesh.cards.x + bit];
            if ( !SurfaceCardVisible( card ) )
                continue;
            vec3       local  = SurfaceCardWorldToLocal( card, position );
            const vec3 extent = card.localExtent.xyz;
            if ( any( greaterThan( abs( local ), extent + 0.5 * bias ) ) )
                continue;
            local.xy = clamp( local.xy, -extent.xy, extent.xy );
            const uvec2 res = uvec2( 1u << ( card.info.x & 0xFFu ), 1u << ( ( card.info.x >> 8u ) & 0xFFu ) );
            // Card UV: u along the card's X, v down its Y (the capture's rows run top-down), as the copy wrote it.
            const vec2  uv     = vec2( 0.5 + 0.5 * local.x / extent.x, 0.5 - 0.5 * local.y / extent.y );
            const vec2  t      = clamp( uv * vec2( res ) - 0.5, vec2( 0.0 ), vec2( res - 1u ) );
            const uvec2 t0     = uvec2( t );
            const uvec2 t1     = min( t0 + 1u, res - 1u );
            const vec2  f      = t - vec2( t0 );
            // Normalised depths: the hit's, and the threshold and falloff of UE's depth test.
            const float hitDepth  = 0.5 - 0.5 * local.z / extent.z;
            const float threshold = bias / extent.z;
            const float falloff   = 0.25 * threshold;
            vec3        lighting  = vec3( 0.0 );
            float       weightSum = 0.0;
            for ( uint k = 0u; k < 4u; ++k )
            {
                const uvec2 texel = uvec2( ( k & 1u ) != 0u ? t1.x : t0.x, ( k & 2u ) != 0u ? t1.y : t0.y );
                const float bilinear =
                     ( ( k & 1u ) != 0u ? f.x : 1.0 - f.x ) * ( ( k & 2u ) != 0u ? f.y : 1.0 - f.y );
                const ivec2 atlasTexel = SurfaceCacheCardAtlasTexel( card, res, texel, atlasSize );
                if ( bilinear <= 0.0 || texelFetch( u_SurfaceCacheOpacity, atlasTexel, 0 ).r < 0.5 )
                    continue;
                const float captured   = texelFetch( u_SurfaceCacheDepth, atlasTexel, 0 ).r;
                const float visibility = 1.0 - clamp( ( abs( hitDepth - captured ) - threshold ) / falloff, 0.0, 1.0 );
                const float w          = bilinear * visibility;
                if ( w <= 0.0 )
                    continue;
                lighting += texelFetch( u_SurfaceCacheFinalLighting, atlasTexel, 0 ).rgb * w;
                weightSum += w;
            }
            if ( weightSum <= 0.0 )
                continue;
            // UE: the texels' normalised mean, weighted by the card's sample weight (normal x summed texel weight).
            acc.lighting += lighting * axisWeight;
            acc.weight += axisWeight * weightSum;
        }
    }
}

void SurfaceCacheSampleRow( uint row, vec3 position, vec3 normal, float bias, inout SurfaceCacheHitSample acc )
{
    const SurfaceCacheInstance instance = surfaceCacheInstances[row];
    if ( instance.cards.x == GI_NO_MESH_CARDS )
        return;
    if ( any( lessThan( position, instance.boundsMin.xyz - bias ) ) ||
         any( greaterThan( position, instance.boundsMax.xyz + bias ) ) )
        return;
    SurfaceCacheSampleMeshCards( instance.cards.x, position, normal, bias, acc );
}

// The surface cache's radiance at @p hit (FinalLighting); false where no card holds the hit. @p bias: how far the
// hit may lie from the captured surface (GIHitSurfaceCacheBias, the tracer's precision for this hit).
bool SurfaceCacheHitLighting( GIHit hit, float bias, out vec3 lighting )
{
    SurfaceCacheHitSample acc;
    acc.lighting = vec3( 0.0 );
    acc.weight   = 0.0;
    const uvec4 rows = GIHitInstanceRows( hit );
    for ( int i = 0; i < 4; ++i )
    {
        if ( rows[i] == GI_NO_INSTANCE )
            break;
        if ( rows[i] < uint( surfaceCacheInstances.length() ) )
            SurfaceCacheSampleRow( rows[i], hit.position, hit.normal, bias, acc );
        if ( acc.weight >= SURFACE_CACHE_ENOUGH_HIT_WEIGHT )
            break;
    }
    if ( acc.weight < SURFACE_CACHE_MIN_HIT_WEIGHT )
    {
        lighting = vec3( 0.0 );
        return false;
    }
    lighting = acc.lighting / acc.weight;
    return true;
}

#endif // SURFACE_CACHE_SAMPLING_GLSLH
