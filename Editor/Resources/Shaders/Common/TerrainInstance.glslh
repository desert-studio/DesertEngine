// One terrain draw's per-draw data — a row of TerrainInstances[] (binding 8), named by the push-constant
// MaterialIndex. The C++ statement of the same layout is TerrainInstance in
// Engine/Graphic/Systems/Scene/Terrain/TerrainBatch.hpp, and the ShaderCacheKey suite asserts the stride of
// this one against it. Included by the Terrain vertex and fragment stages so the layout is written once on this side too.

#ifndef TERRAIN_INSTANCE_GLSLH
#define TERRAIN_INSTANCE_GLSLH

struct TerrainInstance
{
    vec4 Params;         // x = tile extent (cm), y = continuous LOD, z = visibility layer + 1 (0 = no holes), w = grid LOD
    vec4 Params2;        // x = 1 / LOD blend range, y = weight layer count, z = weightmap pages, w = neighbour mask
    vec4 GroundColor;    // rgb = the root's first layer colour, a = 1 when the root names a layer (else white ground)
    vec4 LandscapeFrame; // x = root origin X, y = base height, z = root origin Z, w = spacing
    vec4 LandscapeTile;  // xy = first global sample, z = quads per tile side, w = Z scale
    vec4 LodEdges;       // LOD on the West, East, South, North border: max(tile, neighbour)
    vec4 LodCorners;     // LOD on the (-x,-z), (+x,-z), (-x,+z), (+x,+z) corner: max of the four tiles
    vec4 LayerColors[8]; // tile layer colours (rgb), a = 1 when the root names the layer; layer i = page i/4, channel i%4
    vec4 LayerAlphaBlend[2]; // per page, 1 per channel whose layer is NoWeightBlend (laid over the weight blend)
    vec4 LayerInput[2];      // per page, per channel: the material input naming the layer's LayerName (-1 none)
    vec4 InputSlices[8];     // per material input: its slice in the albedo / normal / ARM / height arrays (-1 none)
    vec4 GroundInput;        // x = the ground's material input (the root's first layer; -1 none)
    // The grass FIELD's far cover per tile layer (GRASS-FIELD, Common/LandscapeGrassCover.glslh), from the layer's
    // grass types: rgb = the blades' mean albedo, a = leaf area index at full weight (m2 of blade per m2 of ground)
    vec4 GrassCover[8];
    vec4 GrassCoverLight[8]; // rgb = the blade material's SubsurfaceColor, a = its roughness
    vec4 GrassCoverRange[8]; // x/y = the blades' AUTHORED Start/EndCullDistance (cm; the view's Foliage quality and
                             // lens scale them in the shader, TerrainUB.GrassLens.x), z = the lowest weight that grows grass,
                             // w = the blade material's subsurface Opacity (UE's pin; the transmitted light's density)
    // LANDSCAPE DISPLACEMENT (Programs/Terrain/LandscapeDisplacement.glslh; UE 5.4+ landscape Nanite displacement)
    vec4 Displacement;       // x = magnitude (cm), y = center (0..1), z = fade start (cm), w = fade end (cm); x 0 = off
    vec4 DisplacementView;   // xyz = the MAIN camera (cm; the fade's origin for every view), w = 1: drawn diced in rings
    vec4 DiceWindow;         // xy = the camera's cell (tile-local LOD-0 grid), z = the fade square's half-extent (cells),
                             // w = cm per DicingRate pixels per cm of distance (the height's mip footprint)
    vec4 DisplacementTiling; // x = FarTilingDistance (cm), y = FarTilingScale: the far fetch the surface blends in
    vec4 InputTileSize[2];   // per material input, four to a vec4: LayerKTileSize (cm)
    vec4 InputBlend[2];      // per material input, four to a vec4: LayerKBlend (0 weight, 1 height, 2 alpha)
    vec4 DiceRings;          // half-extents (cells) of the rings diced 2, 4, 8, 16 (x..w; -1 = none)
    vec4 DicePool;           // x = the tile's first vertex in the frame's dice pool (-1 = none), y = the finest dice
                             // level this row's view draws (4 = the camera's; a caster's is coarser)
    vec4 DiceClip;           // [x0, z0) .. [x1, z1) tile-local LOD-0 cells: the main camera's view footprint; a cell
                             // outside it is undiced (LandscapeDisplacement.glslh LandscapeCellDiceOf)
    vec4 GrassCoverFloorWidth[2]; // per layer, four to a vec4: its blades' mean width per MinScreenWidth pixel
                                  // (cm / px; 0 = no floor); D = width x TerrainUB.GrassLens.y (GRASS-VIS-17)
    vec4 GrassCoverWiden[2];      // per layer, four to a vec4: the share of its grass leaf area that is blades, whose
                                  // survivors widen; the rest meshes shrinking out (GPU-COST-29, GrassFieldCoverageOf)
};

#endif // TERRAIN_INSTANCE_GLSLH
