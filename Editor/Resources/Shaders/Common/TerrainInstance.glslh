// One terrain draw's per-draw data — a row of TerrainInstances[] (binding 8), named by the push-constant
// MaterialIndex. The C++ statement of the same layout is TerrainInstance in
// Engine/Graphic/Systems/Scene/Terrain/TerrainBatch.hpp, and the ShaderCacheKey suite asserts the stride of
// this one against it. Included by all four Terrain stages so the layout is written once on this side too.

#ifndef TERRAIN_INSTANCE_GLSLH
#define TERRAIN_INSTANCE_GLSLH

struct TerrainInstance
{
    mat4 Model;
    vec4 Params;         // x = size, y = gridDim (patches/side), z = heightScale, w = tessLevel (MAX/near)
    vec4 Params2;        // x = noiseFrequency, y = seed, z = height source (0 fBm, 1 heightmap), w = spare
    vec4 LayerModes;     // x = grass, y = rock, z = snow (0=Auto,1=Manual,2=Off), w = std430 padding
    vec4 LandscapeFrame; // heightmap only: x = root origin X, y = base height, z = root origin Z, w = spacing
    vec4 LandscapeTile;  // heightmap only: xy = first global sample, z = quads per tile side, w = Z scale
};

#endif // TERRAIN_INSTANCE_GLSLH
