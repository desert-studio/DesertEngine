#ifndef DESERT_THIN_GEOMETRY_COVERAGE_GLSLH
#define DESERT_THIN_GEOMETRY_COVERAGE_GLSLH
// The view's thin-geometry coverage (Graphic::ViewTargetFormats::kThinGeometryCoverage): what the base pass that
// writes a pixel's depth says about its material, for TSR's thin-geometry detection (TSR.DetectThinGeometry).
// Ported from UE 5.8 Engine/Shaders/Private/TemporalSuperResolution/TSRMeasureCoverage.usf GetThinGeometry :25-37
// and TSRThinGeometryCommon.ush EncodeThinGeometryMaterial, adapted: written by the base passes themselves (the
// G-buffer pass and the forward opaque pass) instead of a compute pass over the G-buffer, so forward-shaded
// surfaces carry it too. 0: unlit or nothing drawn (the target's clear); 0.5: any other model; 1: two-sided
// foliage. UE's ShadingRange (Foliage / VaryingRange) is the detection's reading of these values, not the encoding.
#include <Generated/ShadingModels.glslh>

float DesertThinGeometryCoverage( const uint shadingModel )
{
    if ( shadingModel == SHADING_MODEL_INDEX_UNLIT )
        return 0.0;
    return shadingModel == SHADING_MODEL_INDEX_TWO_SIDED_FOLIAGE ? 1.0 : 0.5;
}
#endif
