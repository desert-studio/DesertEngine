// #pragma once

// THE ONE PLACE THE ACES FILM CURVE IS WRITTEN. SceneComposite grades every frame through it, and the
// editor's HDR thumbnail (Editor/Widgets/HdrSphereThumbnail.cpp) includes this same text compiled as C++,
// so the ball in the Content Browser is graded by the operator the viewport uses rather than by a
// transcription that would read correct alone and drift silently.
//
// `float(...)` around the literals: as C++ they are DOUBLES, and glm has no vec3 (op) double overload.

// ACES, as Unreal grades. This is the DEFAULT operator (decision D-10): the reference frame the
// sky programme measures itself against was captured through UE's ACES-derived film curve, so
// while the two sides used different operators every number in Docs/Clouds/CALIBRATION.md was
// reporting the gap between two TONEMAPPERS rather than between two skies.
//
// WHICH FIT, AND WHY THIS ONE. Two approximations are in common use. Narkowicz's is a single
// rational curve applied per channel in sRGB — one line, and visibly not the same operator: it
// rolls each channel off independently, so a bright SATURATED colour shifts hue on its way to
// white instead of desaturating toward it. Stephen Hill's fit (BakingLab/ACES.hlsl, MIT) keeps
// the structure of the real thing: into AP1, the RRT+ODT shoulder there, back out. That matters
// here specifically, because mean SATURATION is one of the five numbers this programme
// calibrates with — an operator that gets saturation wrong corrupts the very measurement the
// operator was changed to make honest. The price is two 3x3 products in one fullscreen pass,
// which is nothing next to the cloud march it is grading.
//
// The constants are the published matrices TRANSPOSED: the HLSL original lists ROWS, GLSL's
// mat3(...) fills COLUMNS. Copying them across verbatim gives a colour rotation that looks
// plausible and is wrong, which is the kind of defect this programme has already paid for once.
// THE OUTPUT TRANSFORM'S PEAK (HDR-OUTPUT p4; ACES 1.3 ACESlib.SSTS.ctl, as UE's ACESOutputTransforms1000/2000 and
// r.HDR.Display.OutputDevice: one tone scale whose upper end is set by the display's peak).
//
// ACES 1.3 builds every output transform from the Single-Stage Tone Scale: a log-log B-spline through three points
// (min, mid grey 0.18 -> 4.8 nits, max), the max point and the shoulder's bend found from the display's peak
// (lookup_ACESmax, init_coefsHigh). The SDR frame here is Hill's fit of the RRT + sRGB ODT — the curve the cloud
// and sky calibration was measured through (D-10) — so the peak enters as the SSTS's OWN answer to "how much
// brighter may this value be on a display of this peak than on the SDR one": the ratio of the tone scale at
// max = 48 x headroom to the tone scale at max = 48 (48 = ACES's SDR peak, which our paper white stands for).
// Min and mid are the same in both, so the ratio is exactly 1 at and below mid grey and the low segment drops out:
// shadows and mid-tones of an HDR frame ARE the SDR frame's (its SDR rendition is a clamp, captures stay
// comparable); above mid grey the highlights take ACES's HDR shoulder up to the headroom. At headroom 1 it is
// the identity, so SDR is the same code at a 1x peak and draws the frame it always drew.
float AcesLog10(float x)
{
    return log2(x) * float(0.30102999566);
}

// log10 of the SSTS (ACES 1.3 ssts(), high segment: x above mid grey) for a display of max luminance maxNits,
// in the tone scale's own nits (mid grey = 4.8, SDR peak = 48).
float AcesSstsHighLog10(float x, float maxNits)
{
    const float logMidX = float(-0.744727495);        // log10(0.18)
    const float logMidY = float(0.681241237);         // log10(4.8)
    const float midSlope = float(1.55);
    float logMaxY = AcesLog10(maxNits);
    // lookup_ACESmax: 6.5 stops above mid grey at 48 nits, 18 at 10000.
    float maxStops = mix(float(6.5), float(18.0),
                               clamp((logMaxY - float(1.681241237)) / (float(4.0) - float(1.681241237)),
                                     float(0.0), float(1.0)));
    float logMaxX = logMidX + maxStops * float(0.30102999566);
    float knotInc = (logMaxX - logMidX) / float(3.0);
    // init_coefsHigh: two knots straddling mid (slope 1.55), two at max (slope 0), the bend between them.
    float c0 = logMidY - midSlope * float(0.5) * knotInc;
    float c1 = logMidY + midSlope * float(0.5) * knotInc;
    float pctHigh = mix(float(0.89), float(0.90), (maxStops - float(6.5)) / (float(18.0) - float(6.5)));
    float c2 = logMidY + pctHigh * (logMaxY - logMidY);
    float c3 = logMaxY;

    float logX = AcesLog10(max(x, float(0.18)));
    if (logX >= logMaxX)
        return logMaxY;
    float knot = float(3.0) * (logX - logMidX) / (logMaxX - logMidX);
    float j    = min(floor(knot), float(2.0));
    float t    = knot - j;
    // The three coefficients of segment j (c3 repeats past the end: coefsHigh[4] = coefsHigh[5] = log max).
    float k0 = j < float(0.5) ? c0 : (j < float(1.5) ? c1 : c2);
    float k1 = j < float(0.5) ? c1 : (j < float(1.5) ? c2 : c3);
    float k2 = j < float(0.5) ? c2 : c3;
    // The quadratic B-spline basis M = {{0.5,-1,0.5},{-1,1,0.5},{0.5,0,0}} applied to (k0,k1,k2).
    return t * t * (float(0.5) * k0 - k1 + float(0.5) * k2) + t * (k1 - k0) + float(0.5) * (k0 + k1);
}

// How much brighter @p x (AP1, after the RRT's saturation) is drawn on a display of @p headroom x paper white
// than on the SDR one. 1 at headroom 1 and at or below mid grey.
float AcesPeakRatio(float x, float headroom)
{
    if (headroom <= float(1.0) || x <= float(0.18))
        return float(1.0);
    return exp2((AcesSstsHighLog10(x, float(48.0) * headroom) - AcesSstsHighLog10(x, float(48.0)))
                * float(3.32192809489));
}

// The ACES output transform for a display @p headroom x paper white bright (1 = SDR). Linear Rec.709 in and out,
// 1.0 = paper white; the result reaches the headroom, never past it.
vec3 TonemapACESOutput(vec3 color, float headroom)
{
    const mat3 ACESInput = mat3(
        0.59719, 0.07600, 0.02840,
        0.35458, 0.90834, 0.13383,
        0.04823, 0.01566, 0.83777);
    const mat3 ACESOutput = mat3(
         1.60475, -0.10208, -0.00327,
        -0.53108,  1.10813, -0.07276,
        -0.07367, -0.00605,  1.07602);

    vec3 v = ACESInput * color;
    vec3 a = v * (v + float(0.0245786)) - float(0.000090537);
    // No epsilon and none needed: 0.983729x^2 + 0.432951x + 0.238081 has a negative
    // discriminant, so it has no real root and cannot be zero for any v the matrix can produce
    // (including the negatives a saturated colour picks up on the way into AP1).
    vec3 b = v * (float(0.983729) * v + float(0.4329510)) + float(0.238081);
    // Per channel in AP1, where ACES applies its tone scale.
    vec3 toned = (a / b) * vec3(AcesPeakRatio(v.x, headroom), AcesPeakRatio(v.y, headroom),
                                AcesPeakRatio(v.z, headroom));
    // The clamp is the ODT's range, not a safety net: AP1 holds colours sRGB cannot, and those
    // come back out of the second matrix slightly outside [0, peak].
    return clamp(ACESOutput * toned, float(0.0), max(headroom, float(1.0)));
}

// The SDR output transform (headroom 1): the editor's HDR thumbnail and every SDR frame.
vec3 TonemapACES(vec3 color)
{
    return TonemapACESOutput(color, float(1.0));
}
