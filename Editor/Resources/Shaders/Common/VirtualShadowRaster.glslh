// The virtual shadow map caster's write, the ONE statement of it: every program that rasterizes into the physical pool
// ("VSM: Raster", MeshRenderer::AddVirtualShadowRasterPasses) - the mesh surface cells (Pass_VirtualShadowDepth.glslh)
// and the terrain (Programs/Terrain/TerrainVirtualShadow.shader) - includes this and calls VsmRasterWrite() last.
// Ported from UE 5.8 Engine/Shaders/Private/ShadowDepthPixelShader.usf (VIRTUAL_TEXTURE_TARGET: the page lookup and
// InterlockedMax into the physical pool), adapted: our page table (Common/VirtualShadowMap.glslh) and a flipped
// viewport.
//
// The pass has no attachment (RDG PassBuilder::RenderArea, 16384 x 16384): the fragment maps its virtual texel to the
// page the page table gives it and atomic-maxes its depth into the pool. Only a page that is allocated, dirty and
// requested this frame is written - "VSM: Clear Pages" cleared or re-merged exactly those; a clean page keeps its
// cached depth and a page no pixel asked for has no physical page. The node's layer (VSM_RASTER_LAYER) says which
// pages and which of the pool's layers: a still caster writes both layers of a page whose static layer is redrawn
// (VSM_FLAG_DIRTY_STATIC), a mover the merged layer of every drawn page (over the static layer "VSM: Clear Pages"
// copied there). The rasterised depth is the level's standard-Z clip depth, 0 toward
// the sun, clamped (the caster pipelines draw with depth clamp, so a caster nearer the sun than the level's range
// lands on 0). The pool stores 1 - depth so the atomic max keeps the occluder nearest the sun and a cleared texel (0)
// reads as no occluder (VirtualShadowMapProject: occluder = 1 - bits).
#ifndef VIRTUAL_SHADOW_RASTER_GLSLH
#define VIRTUAL_SHADOW_RASTER_GLSLH
#include <Generated/SceneBindings.glslh> // the set-0 slot table (Core::kSceneBindingNames)

#include <Common/VirtualShadowMap.glslh>

layout( std430, binding = kVsmFrameDataBinding ) restrict readonly buffer VsmFrameData
{
    VsmFrame Frame;
    VsmLevel Levels[];
};
layout( std430, binding = kVsmPageTableBinding ) restrict readonly buffer VsmPageTable
{
    VsmPageEntry Entries[];
};
layout( binding = kVsmPhysicalPoolBinding, r32ui ) restrict uniform uimage2D PhysicalPoolTexture;
// The level this fragment rasterizes and the node's layer: the draw's (VirtualShadowMapFrame::RasterLevel /
// RasterLevelMovable, x = level index, y = VSM_LAYER_*), unless the includer names the level per primitive first
// (VSM_RASTER_LEVEL: the cluster raster of every level in one pass, Mesh/Surface/Pass_VirtualShadowDepth.glslh - the
// clusters are still casters, VSM_LAYER_STATIC).
#ifndef VSM_RASTER_LEVEL
layout( std430, binding = kVsmRasterLevelBinding ) restrict readonly buffer VsmRasterLevel
{
    uvec4 RasterLevel;
};
#define VSM_RASTER_LEVEL RasterLevel.x
#define VSM_RASTER_LAYER RasterLevel.y
#endif
#ifndef VSM_RASTER_LAYER
#define VSM_RASTER_LAYER VSM_LAYER_STATIC
#endif

// @p depth is the caster's standard-Z depth at this fragment: the rasterised one (VsmRasterWrite), or a surface's
// Pixel Depth Offset depth (Mesh/Surface/Pass_VirtualShadowDepth.glslh, a template's `.Parallax` cell).
void VsmRasterWriteDepth( float depth )
{
    // The engine's viewport is flipped (negative height, VulkanRdgBackend::BeginRenderPass), so framebuffer y runs
    // down while the map's texel y (VsmProject: (clip.y * 0.5 + 0.5) * resolution) runs up.
    // The level's own resolution: 16k for a clipmap level, (128 >> mip) pages of a local light's mip.
    const uint  level      = VSM_RASTER_LEVEL;
    const int   resolution = int( Levels[level].Pages.y * VSM_PAGE_SIZE );
    const ivec2 texel      = ivec2( int( gl_FragCoord.x ), resolution - 1 - int( gl_FragCoord.y ) );
    if ( any( lessThan( texel, ivec2( 0 ) ) ) || any( greaterThanEqual( texel, ivec2( resolution ) ) ) )
        return;
    // The casters draw with depth clamp (the sun's levels keep casters toward the sun): a local view's caster in
    // front of its near plane lands on depth 0 there, which would shade the whole view - it is clipped instead,
    // as the atlas's near plane clips it.
    if ( Levels[level].Pages.z == VSM_LEVEL_LOCAL && depth <= 0.0 )
        return;
    const VsmPageEntry entry   = Entries[VsmLevelEntryIndex( Levels[level], level, texel / int( VSM_PAGE_SIZE ) )];
    const bool         movable = VSM_RASTER_LAYER == VSM_LAYER_MOVABLE;
    const uint         drawn   = VSM_FLAG_ALLOCATED | VSM_FLAG_REQUESTED | ( movable ? VSM_FLAG_DIRTY : VSM_FLAG_DIRTY_STATIC );
    if ( ( entry.Flags & drawn ) != drawn )
        return;
    const ivec2 inPage = texel & ivec2( int( VSM_PAGE_SIZE ) - 1 );
    const uint  bits   = floatBitsToUint( 1.0 - clamp( depth, 0.0, 1.0 ) );
    imageAtomicMax( PhysicalPoolTexture, VsmPoolPageOrigin( entry.Physical ) + inPage, bits );
    if ( !movable )
        imageAtomicMax( PhysicalPoolTexture,
                        VsmPoolStaticPageOrigin( entry.Physical, imageSize( PhysicalPoolTexture ).y ) + inPage, bits );
}

void VsmRasterWrite()
{
    VsmRasterWriteDepth( gl_FragCoord.z );
}

#endif // VIRTUAL_SHADOW_RASTER_GLSLH
