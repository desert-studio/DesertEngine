// THE WATER'S CAUSTICS (WATER-CAUSTICS; Evan Wallace's WebGL water / GPU Gems 1 ch. 2: the sun refracted through
// the wave field onto the floor, the light's density there = the area ratio of the beam it came in as; UE's water
// samples such a map in its lighting). One map per frame, made by Programs/Water/WaterCausticsSplat.shader +
// WaterCausticsResolve.shader (Graphic::System::WaterCaustics), read by every sun receiver (below).
//
// THE MAP: WATER_CAUSTICS_SIZE^2 texels of one world square (around the camera, on the body nearest it), texel
// (x, y) at world (X, Z) = lower + (x + 0.5, y + 0.5) * texel. Its value is the sun's irradiance where the refracted light LANDS
// over the irradiance through still water: 1 on still water, > 1 on the bright lines, < 1 between them. Its mean
// is 1, so it moves light around and adds none.
#ifndef DESERT_WATER_CAUSTICS_GLSLH
#define DESERT_WATER_CAUSTICS_GLSLH

// The map's side in texels (C++ twin: Graphic::System::WaterCaustics::kMapSize).
#define WATER_CAUSTICS_SIZE 512
// Fixed point of the splat's atomic accumulation: one unit of still-water irradiance per texel is this many
// counts (WaterCausticsSplat adds, WaterCausticsResolve divides).
#define WATER_CAUSTICS_ENERGY_SCALE 4096.0
// The index of refraction of water (air -> water: eta = 1 / 1.333).
#define WATER_CAUSTICS_IOR 1.333
// The map's border, in UV, over which a receiver blends to no caustics: light refracted in from outside the
// square is not in the map, so its edge is darker than the water around it.
#define WATER_CAUSTICS_BORDER_UV 0.08

// THE FRAME ROW (Graphic::System::WaterCausticsFrameHead + WaterCausticsBodyRow, its C++ twins). The includer
// declares, at a slot free in ITS layout, before including this file:
//
//     a std430 buffer WaterCausticsFrameUB { vec4 WaterCausticsWindow; vec4 WaterCausticsShape;
//                                            vec4 WaterCausticsBodies[]; }
//     #define WATER_CAUSTICS_FRAME
//
// WaterCausticsWindow: xy = world (X, Z) of the map's lower corner, z = 1 / its side (cm), w = 1 when this frame
// has a map. WaterCausticsShape: x = the bodies in the table, y = the depth over which the caustics come in under
// the surface (cm), z = the depth over which they fade (cm), w = their strength (1 = the map as computed).
// WaterCausticsBodies: two vec4 per body whose footprint meets the map's square - [2i] its footprint (xy = min
// (X, Z), zw = max), [2i + 1].x its still surface Y (cm), .y its wave lane (1 + the frame's wave set in WaterTiles'
// WaterWaveSets, 0 = a flat body; WaterRenderer::GetFrameBodyWaveLanes, the tiles' WaterTileRow.Body.z).
#ifdef WATER_CAUSTICS_FRAME
// The body whose still surface is the nearest one above @p worldPos (its footprint holds the point, the point
// lies under its level), or -1: the water the light reaching that point came down through.
int WaterCausticsBodyOver( vec3 worldPos )
{
    int   found = -1;
    float least = 3.0e38;
    const int count = int( WaterCausticsShape.x );
    for ( int i = 0; i < count; ++i )
    {
        const vec4 footprint = WaterCausticsBodies[2 * i];
        if ( any( lessThan( worldPos.xz, footprint.xy ) ) || any( greaterThan( worldPos.xz, footprint.zw ) ) )
            continue;
        const float depth = WaterCausticsBodies[2 * i + 1].x - worldPos.y;
        if ( depth > 0.0 && depth < least )
        {
            found = i;
            least = depth;
        }
    }
    return found;
}
// The still surface Y of body @p body (WaterCausticsBodyOver).
float WaterCausticsBodyLevel( int body )
{
    return WaterCausticsBodies[2 * body + 1].x;
}
// The TargetWaveMaskDepth of body @p body (cm; WaterMeshTiles.glslh WaterWaveAttenuation).
float WaterCausticsBodyWaveMaskDepth( int body )
{
    return WaterCausticsBodies[2 * body + 1].z;
}
// The wave lane of body @p body (the splat turns it into its wave set with WaterMeshTiles.glslh WaterWaveSetOf).
float WaterCausticsBodyWaveLane( int body )
{
    return WaterCausticsBodies[2 * body + 1].y;
}
#endif // WATER_CAUSTICS_FRAME

// THE RECEIVER (every sun receiver: the deferred direct pass, Mesh/Surface/Pass_Forward.glslh,
// Pass_Forward_Translucent.glslh, Programs/Terrain/Terrain.shader; Common/CloudShadowReceiver.glslh's contract,
// one binding pair of the scene/view inputs: SceneViewInputs::WaterCausticsMap / WaterCausticsFrame). The lit
// particles take none: their translucency lighting volume's cells average the map to its mean, 1. The includer declares the
// frame row above and, before including this file:
//
//     texture2D WaterCausticsTexture + #define WaterCausticsTexture sampler2D(WaterCausticsTexture, <a sampler>)
#ifdef WaterCausticsTexture
#ifndef WATER_CAUSTICS_FRAME
#error "Common/WaterCaustics.glslh: the receiver reads the frame row - declare WaterCausticsFrameUB first"
#endif
// The factor on the sun's light reaching @p worldPos: the map under a water body's surface, EXACTLY 1.0 anywhere
// else (above every body's water, outside every body or the map, and with no map this frame -
// Effects.WaterCaustics 0), so a frame without caustics is the frame before them, bit for bit.
float WaterCausticsFactor( vec3 worldPos )
{
    if ( WaterCausticsWindow.w < 0.5 )
        return 1.0;
    const vec2 uv = ( worldPos.xz - WaterCausticsWindow.xy ) * WaterCausticsWindow.z;
    if ( any( lessThan( uv, vec2( 0.0 ) ) ) || any( greaterThan( uv, vec2( 1.0 ) ) ) )
        return 1.0;
    const int body = WaterCausticsBodyOver( worldPos );
    if ( body < 0 )
        return 1.0;
    const float depth   = WaterCausticsBodyLevel( body ) - worldPos.y;
    const vec2  edge    = min( uv, vec2( 1.0 ) - uv );
    const float border  = smoothstep( 0.0, WATER_CAUSTICS_BORDER_UV, min( edge.x, edge.y ) );
    const float onset   = smoothstep( 0.0, max( WaterCausticsShape.y, 1.0 ), depth );
    const float fade    = exp( -depth / max( WaterCausticsShape.z, 1.0 ) );
    const float caustic = textureLod( WaterCausticsTexture, uv, 0.0 ).r;
    return mix( 1.0, caustic, border * onset * fade * WaterCausticsShape.w );
}
#endif // WaterCausticsTexture

#endif // DESERT_WATER_CAUSTICS_GLSLH
