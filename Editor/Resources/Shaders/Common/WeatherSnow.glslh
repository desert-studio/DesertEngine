#ifndef DESERT_WEATHER_SNOW_GLSLH
#define DESERT_WEATHER_SNOW_GLSLH

// THE WORLD'S SNOW LAYER (FIELD-WINTER): the weather layer a preset lays on every lit surface that faces the sky,
// read by the surface pass headers (Mesh/Surface/SurfaceWeather.glslh) and the landscape (Programs/Terrain/*.shader).
// WHAT the layer is — its look and where on a surface it lies — is the world's Surface Layer graph
// (Common/SurfaceLayer.glslh, SNOW-LAYER): the collection names the graph (M_SnowLayer, M_SnowLayer_Dirty), the graph
// reads SnowCover and samples its own textures. This file only gates it by the sky (the view's precipitation
// occlusion) and lays its normal in the surface's frame. Its DEPTH on open ground (SnowDepth, cm) is the grass
// generator's, which sinks every root by it (GrassRenderer reads the parameter into GrassGenerate's params).
#include <Generated/SurfaceLayers.glslh>

struct DesertSnowLayer
{
    vec3  Albedo;
    vec3  NormalWS; // world space
    float Roughness;
    float AO;
    float Metallic;
    float Weight; // 0 = no snow here, 1 = only snow
};

// The snow at @p worldPos on a surface whose WORLD normal is @p normalWS (the geometric one: snow buries the
// surface's own relief), with @p exposure the share of the open sky that reaches it (1 - the view's precipitation
// occlusion; 1 where the caller has none). The world's Surface Layer graph says what the snow looks like and how much
// of the surface it covers (Weight); the exposure scales that. The layer's normal (tangent space in the top-projected
// frame: T = +X and B = -Z projected onto the surface) is laid around @p normalWS, so snow on a pitched roof slopes
// with it. With no layer named, or its textures not resident, the weight is 0: nothing here invents a colour.
DesertSnowLayer DesertEvaluateSnow( const vec3 worldPos, const vec3 normalWS, const float exposure )
{
    DesertSnowLayer snow;
    snow.Albedo    = vec3( 0.0 );
    snow.NormalWS  = normalWS;
    snow.Roughness = 1.0;
    snow.AO        = 1.0;
    snow.Metallic  = 0.0;
    snow.Weight    = 0.0;
    if ( exposure <= 0.0 )
        return snow;

    DesertSurfaceLayerInput li;
    li.WorldPosition                 = worldPos;
    li.WorldNormal                   = normalWS;
    li.TopUV                         = vec2( worldPos.x, -worldPos.z );
    li.Up                            = normalWS.y;
    const DesertSurfaceLayerOutput o = DesertEvaluateSurfaceLayer( li );
    snow.Weight                      = clamp( o.Weight, 0.0, 1.0 ) * clamp( exposure, 0.0, 1.0 );
    if ( snow.Weight <= 0.0 )
        return snow;

    const vec3 n    = dot( o.Normal, o.Normal ) > 1e-8 ? normalize( o.Normal ) : vec3( 0.0, 0.0, 1.0 );
    const vec3 east = vec3( 1.0, 0.0, 0.0 ) - normalWS * normalWS.x;
    const vec3 t    = dot( east, east ) > 1e-4 ? normalize( east ) : vec3( 0.0, 0.0, 1.0 );
    const vec3 b    = cross( normalWS, t );
    snow.NormalWS   = normalize( t * n.x + b * n.y + normalWS * n.z );
    snow.Albedo     = o.BaseColor.rgb;
    snow.Roughness  = clamp( o.Roughness, 0.0, 1.0 );
    snow.AO         = clamp( o.Occlusion, 0.0, 1.0 );
    snow.Metallic   = clamp( o.Metallic, 0.0, 1.0 );
    return snow;
}

#endif
