DesertSurfaceLayerOutput DesertEvaluateSurfaceLayer( const DesertSurfaceLayerInput li )
{
    const uint layer = DesertSurfaceLayerSelected();
    if ( layer == 0x99f35fu )
        return DesertSurfaceLayer_M_SnowLayer( li );
    if ( layer == 0x2813c1u )
        return DesertSurfaceLayer_M_SnowLayer_Dirty( li );
