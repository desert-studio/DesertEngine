#ifndef AMBIENT_IBL_GLSLH
#define AMBIENT_IBL_GLSLH

// THE ambient term of this engine's lit — one text, compiled by every shader that has one.
//
// Why it is a header and not four copies: the forward mesh shaders and the deferred lighting pass shade
// the SAME materials in the SAME scene, and a scene picks which of them runs with a single enum field.
// While the deferred composite carried its own ambient (a flat `vec3(0.08)` that read no environment
// cube at all) the two paths disagreed catastrophically — the owner saw ground and buildings almost
// black under a bright sky, and flipping RenderingPath from 1 to 0 lit them. That is the "two
// implementations of one quantity" shape this project has now paid for several times; the cure is not a
// test that the copies still agree but a single copy that cannot disagree.
//
// It is split in two on purpose:
//   * EvaluateAmbientIBL is PURE ALGEBRA over already-fetched samples. It declares no sampler, so it
//     also compiles as C++ (see Desert/Tests/Engine/AmbientIBL) and the split-sum identity can be
//     asserted without a GPU.
//   * AmbientIBL does the three fetches and calls it. It names u_EnvIrradianceTex / u_EnvSpecularTex /
//     u_BRDFLUTTexture and the `skyLook` block (Common/SkyLook.glslh), which the includer must have
//     declared. Define AMBIENT_IBL_NO_SAMPLERS to take only the algebra half.
//

// The anti-black epsilon, and NOT an ambient model. Real ambient comes from the environment cubes above;
// this only keeps a fully-occluded face with no environment bound from reading as a pure-black hole. It
// is deliberately two orders of magnitude below the old deferred constant so it cannot double-count the
// sky the way that constant did. Multiply it by albedo * ao at the call site.
const vec3 SURFACE_AMBIENT_FLOOR = vec3(0.008, 0.009, 0.012);

// Split-sum image-based lighting (Karis 2013) from samples the caller already took:
//   irradiance    — the diffuse irradiance cube at N (exitant radiance for a Lambertian BRDF, so it is
//                   NOT divided by PI again here);
//   prefiltered   — the GGX-prefiltered radiance cube at reflect(-view, N), roughness-selected mip;
//   specularBRDF  — the .rg of the split-sum BRDF LUT at (max(0, N.V), roughness).
// The diffuse half keeps the energy the specular lobe did not take: 1 - E, E = F0 * scale + bias being the lobe's
// directional albedo from the same LUT sample (UE ComputeEnergyPreservation, ShadingEnergyConservationTemplate.ush:
// 1 - luminance(E)). It was (1 - F) with F = Schlick at N.V, which is 1 at a grazing or turned-away shading normal:
// the diffuse vanished there and the surface drew as its reflection alone - the pale fleck of every leaf seen
// edge-on and the white rim of every pavement joint (FOLIAGE-LOOK-3). With 1 - E the two halves sum to at most
// the environment (the split-sum's old 4 % white-furnace excess is gone).
// The two halves apart, for a model that occludes them differently (ComposeAmbient below).
vec3 EvaluateAmbientIBLDiffuse(vec3 irradiance, vec2 specularBRDF, vec3 F0, vec3 albedo, float metalness)
{
	const vec3 E  = F0 * specularBRDF.x + specularBRDF.y;
	const vec3 kd = vec3((1.0 - metalness) * (1.0 - dot(E, vec3(0.2126, 0.7152, 0.0722))));
	return kd * albedo * irradiance;
}

vec3 EvaluateAmbientIBLSpecular(vec3 prefiltered, vec2 specularBRDF, vec3 F0)
{
	return (F0 * specularBRDF.x + specularBRDF.y) * prefiltered;
}

vec3 EvaluateAmbientIBL(vec3 irradiance, vec3 prefiltered, vec2 specularBRDF, vec3 F0, vec3 albedo, float metalness)
{
	return EvaluateAmbientIBLDiffuse(irradiance, specularBRDF, F0, albedo, metalness) +
	       EvaluateAmbientIBLSpecular(prefiltered, specularBRDF, F0);
}

// UE GetSpecularOcclusion (DeferredShadingCommon.ush; ReflectionEnvironmentPixelShader.usf calls it with
// Pow2(GBuffer.Roughness) and AO = GBufferAO * the screen's AO): Lagarde & de Rousiers 2014, the share of the
// specular lobe an ambient occlusion of @p ao leaves visible from @p NoV. A smooth lobe takes the AO as it is
// (pow(.., 0) = 1); a rough one is occluded MORE than the AO where the view grazes - the lobe then leans into the
// occluded hemisphere - and less where the view is head-on. Without it a leaf deep in a canopy, its AO low but its
// grazing-view Fresnel near 1, mirrored the open sky as pale-blue flecks (FOLIAGE-SPEC-OCC).
float DesertSpecularOcclusion(float NoV, float roughness, float ao)
{
	// GLSL leaves pow(0, 0) undefined (a fully occluded mirror seen edge-on); the floor keeps it pow's 1.
	return clamp(pow(max(NoV + ao, 1e-6), roughness * roughness) - 1.0 + ao, 0.0, 1.0);
}

// The whole ambient contribution of a surface, assembled — and the reason this is a function rather
// than one line at each of the four call sites. The pieces are not interchangeable in how they meet
// albedo: EvaluateAmbientIBL has ALREADY folded albedo into its diffuse half (and deliberately not into
// its specular half, because a reflection is not tinted by the surface it leaves), while `indirect`
// arrives as INCIDENT light from a bounce gather and still has to be reflected. Getting that backwards
// is a whole-frame error that looks like a tuning problem.
//
//   diffuseIBL        — EvaluateAmbientIBLDiffuse for this surface;
//   specularIBL       — EvaluateAmbientIBLSpecular for this surface;
//   albedo            — linear base colour;
//   ao                — the occlusion factor, 1 = unoccluded. It attenuates the ENTIRE diffuse ambient, which is
//                       what makes it ambient occlusion and not a second albedo;
//   specularOcclusion — the same occlusion as the specular lobe sees it: DesertSpecularOcclusion(N.V, roughness,
//                       ao) (UE ReflectionEnvironment: SpecularOcclusion multiplies the reflection, AO the diffuse);
//   indirect          — one-bounce incident light, vec3(0.0) where the path has no GI (the forward mesh
//                       shaders); the deferred composite passes its screen-space or RSM gather here.
vec3 ComposeAmbient(vec3 diffuseIBL, vec3 specularIBL, vec3 albedo, float ao, float specularOcclusion, vec3 indirect)
{
	return diffuseIBL * ao + specularIBL * specularOcclusion + albedo * ao * (SURFACE_AMBIENT_FLOOR + indirect);
}

// THE CHAIN OF REFLECTION SOURCES, for one specular lobe: a traced source (screen-space reflections today; the
// hardware ray continued into the TLAS where the screen trace ran out, later) answers a share of the lobe -
// traced.a, its coverage, with traced.rgb the radiance of what it hit - and the reflection environment (the captures,
// then the sky: Common/ReflectionEnvironment.glslh) answers the remainder. A traced source never darkens a lobe it
// could not answer, and every source after it only fills what is left.
vec3 DesertComposeTracedReflection(vec4 traced, vec3 environment)
{
	// = traced.rgb * traced.a + environment * (1 - traced.a); written so it also compiles as C++ (the algebra half).
	return mix(environment, vec3(traced), traced.w);
}

#ifndef AMBIENT_IBL_NO_SAMPLERS

#include <Common/SkyLook.glslh>
#include <Common/ReflectionCaptureMip.glslh>

// The sampling half. `view` points from the surface toward the eye; `N` is the world-space shading
// normal; `roughness` must already be clamped away from 0 by the caller (the GGX mip selection is linear
// in it, so an unclamped 0 lands on mip 0 for a mirror, which is correct — the clamp is the NDF's).
//
// Both cube fetches go through the sky's look (Common/SkyLook.glslh): the cubes are the file as
// authored, and the scene's rotation and gain turn and scale the lookup — the same two calls the skybox
// pass draws the backdrop with, so a chrome ball reflects what is visible behind it.
// The two environment lookups a shading model may call for any direction (ShadingModelContract.glslh), and the
// ones the split sum below makes: the sky cubes through the sky look's rotation and gain.
vec3 DesertAmbientIrradiance(vec3 worldDirection)
{
	return ApplySkyGain(texture(u_EnvIrradianceTex, SkyLookDirection(worldDirection, skyLook.YawCosSin.xy)).rgb,
	                    skyLook.Gain.rgb);
}

vec3 DesertAmbientSpecular(vec3 worldDirection, float roughness)
{
	// The engine's one roughness -> mip ramp (Common/ReflectionCaptureMip.glslh), the inverse of PrefilterEnvMap's.
	const float lod =
	     ComputeReflectionCaptureMipFromRoughness(roughness, float(textureQueryLevels(u_EnvSpecularTex) - 1));
	return ApplySkyGain(
	     textureLod(u_EnvSpecularTex, SkyLookDirection(worldDirection, skyLook.YawCosSin.xy), lod).rgb,
	     skyLook.Gain.rgb);
}

vec3 AmbientIBL(vec3 view, vec3 N, vec3 F0, float metalness, float roughness, vec3 albedo)
{
	vec3  irradiance = DesertAmbientIrradiance(N);
	float cosLo      = max(0.0, dot(N, view));

	// reflect(-view, N) = 2*dot(N,view)*N - view (unclamped, correct specular reflection)
	vec3 specularIrradiance = DesertAmbientSpecular(reflect(-view, N), roughness);

	vec2 specularBRDF = texture(u_BRDFLUTTexture, vec2(cosLo, roughness)).rg;

	return EvaluateAmbientIBL(irradiance, specularIrradiance, specularBRDF, F0, albedo, metalness);
}

// The environment at a shaded point as a shading model receives it (DesertAmbient): the same three samples
// AmbientIBL takes, plus the pass's indirect bounce and occlusion. Both lighting passes build it here.
#include <ShadingModels/ShadingModelContract.glslh>

// THE REFLECTION CAPTURES (Common/ReflectionEnvironment.glslh): a pass that declares their two bindings defines
// DESERT_REFLECTION_CAPTURES, and its ambient specular is the captures around the point, parallax-corrected and
// normalised to the local diffuse ambient, over the sky's prefiltered radiance. A pass without them reads the sky.
#ifdef DESERT_REFLECTION_CAPTURES
#include <Common/ReflectionEnvironment.glslh>
#endif

// With the view's diffuse estimator stated: @p irradiance is the diffuse the pixel receives (/ pi) and @p remainder
// the specular the reflection environment falls back to where no capture covers the lobe - the sky's two cubes for
// the overload below, the traced GI's final gather in the deferred composite's GI mode 2.
DesertAmbient DesertSampleAmbient(DesertSurface S, vec3 irradiance, vec3 remainder, vec3 indirect, float occlusion)
{
	DesertAmbient A;
	A.Irradiance  = irradiance;
	A.Prefiltered = remainder;
#ifdef DESERT_REFLECTION_CAPTURES
	// UE's IndirectIrradiance for the normalisation: the diffuse this pixel receives under its occlusion, plus the
	// bounce, as luminance (Graphic ReflectionCaptureLighting: what the captures' stored side is under each
	// estimator). Where the view has a radiance cache it is the cache's SMOOTH read, not the final gather that
	// lights the pixel: the gather's visibility steps from cell to cell, and a ratio of it scaled a smooth cube into
	// wall patches (REFL-NORM-SMOOTH); UE reads the as smooth lightmap. The sky's irradiance cube is smooth already.
	vec3 estimator = A.Irradiance;
#ifdef DESERT_VIEW_RADIANCE_CACHE
	if (radianceCache.shape.x != 0u)
	{
		const vec4 smoothIrradiance = RadianceCacheSmoothIrradianceAt(S.WorldPosition, S.N);
		estimator                   = smoothIrradiance.a > 0.0 ? smoothIrradiance.rgb : vec3(0.0);
	}
#endif
	const float indirectIrradiance = dot(estimator * occlusion + indirect, vec3(0.2126, 0.7152, 0.0722));
	A.Prefiltered = DesertReflectionEnvironment(S.WorldPosition, reflect(-S.V, S.N), S.N, S.Roughness, A.Prefiltered,
	                                            indirectIrradiance);
#endif
	A.SpecularBRDF = texture(u_BRDFLUTTexture, vec2(max(0.0, dot(S.N, S.V)), S.Roughness)).rg;
	A.Indirect     = indirect;
	A.Occlusion    = occlusion;
	A.BackIrradiance = DesertAmbientIrradiance(-S.N);
	A.Traced       = 0.0; // the sky cubes (and the captures); DeferredLighting sets 1 where a traced gather replaces them
	return A;
}

// The sky's estimator: its irradiance cube lights the pixel, its prefiltered cube is the remainder.
DesertAmbient DesertSampleAmbient(DesertSurface S, vec3 indirect, float occlusion)
{
	return DesertSampleAmbient(S, DesertAmbientIrradiance(S.N), DesertAmbientSpecular(reflect(-S.V, S.N), S.Roughness),
	                           indirect, occlusion);
}

#ifdef DESERT_VIEW_RADIANCE_CACHE
// THE FORWARD PASSES' ESTIMATOR (Mesh/Surface/ViewIndirect.glslh): the view's world radiance cache where the view
// traces GI - read in place at the pixel, the irradiance about N and the cosine lobe about the reflection under the
// same eight probes and weights, exactly the ProbeVolume final gather the deferred composite takes in GI mode 2
// (Programs/GlobalIllumination/IrradianceFieldGather.shader), black where no traced probe answers as there (never
// the sky through a wall) - else the sky's two cubes. The cache with no clipmap is the view without traced GI.
// @p indirect is the pass's own indirect term (the forward cells': the MegaLights volume's isotropic local light,
// zero when the volume is off). @p pixel picks the clipmap fade's dither (gl_FragCoord.xy).
DesertAmbient DesertSampleViewAmbient(DesertSurface S, vec3 indirect, float occlusion, vec2 pixel)
{
	if (radianceCache.shape.x == 0u)
		return DesertSampleAmbient(S, indirect, occlusion);
	vec3       specular;
	const vec4 diffuse = RadianceCacheIrradianceAtImpl(S.WorldPosition, S.N, S.V, reflect(-S.V, S.N),
	                                                    RadianceCachePixelDither(pixel), true, specular);
	const bool answered = diffuse.a > 0.0;
	return DesertSampleAmbient(S, answered ? diffuse.rgb : vec3(0.0), answered ? specular : vec3(0.0), indirect,
	                           occlusion);
}
#endif

#endif // AMBIENT_IBL_NO_SAMPLERS

#endif // AMBIENT_IBL_GLSLH
