#ifndef BRDF_GLSLH
#define BRDF_GLSLH

const float PI = 3.141592;

float DistributionGGX(float cosLh, float roughness)
{
	float alpha   = roughness * roughness;
	float alphaSq = alpha * alpha;

	// Guard against degenerate denom when roughness and cosLh are both near zero.
	float denom = max((cosLh * cosLh) * (alphaSq - 1.0) + 1.0, 1e-6);
	return alphaSq / (PI * denom * denom);
}

// Distance attenuation with a selectable falloff model. Matches ECS::LightFalloff:
//   0 = Linear, 1 = Quadratic (default), 2 = InverseSquare (physical 1/d^2, windowed).
// Full intensity within minRadius; smoothly reaches exactly 0 at radius (no hard edge / no leak past it).
float LightFalloffFactor(float dist, float minRadius, float radius, int falloff)
{
    if (radius <= 0.0)      return 0.0;
    if (dist <= minRadius)  return 1.0;
    if (dist >= radius)     return 0.0;

    float band = max(radius - minRadius, 1e-4);
    float t    = clamp((dist - minRadius) / band, 0.0, 1.0); // 0 at minRadius -> 1 at radius

    float curve;
    if (falloff == 0)
    {
        curve = 1.0 - t;                           // Linear
    }
    else if (falloff == 2)
    {
        float d   = max(dist, 1e-3);
        float ref = max(minRadius, 0.05);
        curve = (ref * ref) / (d * d) * (1.0 - t); // Inverse-square, windowed to 0 at radius
    }
    else
    {
        curve = (1.0 - t) * (1.0 - t);             // Quadratic
    }
    return clamp(curve, 0.0, 1.0);
}

// Computes G/(4*NdotL*NdotV) analytically as 1/(4*(NdotL*(1-k)+k)*(NdotV*(1-k)+k)).
// This form is always bounded — no divide-by-near-zero when cosLi or cosLo approach 0.
//
// IT REPLACED `GeometrySchlickGGX` (and that function's helper `gaSchlickG1`), which stayed in this
// header, called by nothing, for as long as `-w` kept `-Wunused-function` quiet. The two are the same
// Smith term with the same `k`; the difference is that the old one divided by `4*NdotL*NdotV`
// afterwards and this one never forms that denominator. Anyone who reaches for the old name in a new
// shader reintroduces the divide-by-near-zero the comment above is about. `BRDFLut.cpp` has its own
// C++ `GeometrySchlickGGX` for the split-sum LUT and is untouched — different integral, no denominator
// problem, and no relation to this text.
float VisibilitySmith(float cosLi, float cosLo, float roughness)
{
	float r = roughness + 1.0;
	float k = (r * r) / 8.0;
	return 0.25 / max( (cosLi * (1.0 - k) + k) * (cosLo * (1.0 - k) + k), 1e-6 );
}

vec3 fresnelSchlick(vec3 F0, float cosTheta)
{
	return F0 + (vec3(1.0) - F0) * pow(1.0 - cosTheta, 5.0);
}

// MULTIPLE-SCATTERING ENERGY COMPENSATION of the GGX specular lobe (Kulla-Conty 2017, Fdez-Aguera 2019; UE's
// ShadingEnergyConservation: ComputeGGXSpecEnergyTermsRGB, W = 1 + F0 * (1 - E) / E).
//
// A single-scattering microfacet BRDF loses the light that bounces between microfacets more than once: its
// directional albedo E(N.V, roughness) for F0 = 1 - the white-furnace integral of the lobe - is 1 for a mirror and
// falls to 0.34 at roughness 1 seen head-on. A rough metal therefore drew up to three times darker than the light
// it receives, and darker the rougher it was. The missing share is restored by scaling the lobe by
// W = 1 + F0 * (1 / E - 1): for F0 = 1 the lobe then integrates to exactly 1 (W * E = 1), and a dielectric's small
// F0 takes only F0 * (1 - E) more - the multiply-scattered light is coloured by F0 (Kulla-Conty's F_avg term).
//
// THE PREINTEGRATED E. kGGXSpecularAlbedo is the split-sum LUT's scale + bias at F0 = 1 (Graphic/BRDFLut.cpp
// IntegrateBRDF: GGX D, Smith-Schlick G with k = roughness^2 / 2) on a 16 x 16 grid of texel centres - u = N.V,
// v = roughness, both (i + 0.5) / 16 - integrated from the same integrand at 16384 Hammersley samples by
// scripts/Dev/ggx_specular_albedo_table.py, which prints these rows. It is the PHYSICAL lobe's albedo, not the
// direct lobe's: VisibilitySmith's k = (roughness + 1)^2 / 8 is Karis' "hotness" remap for analytic lights, which
// darkens a smooth surface at grazing on purpose; compensating THAT would invert the remap (26x at N.V 0.03,
// roughness 0.03) instead of restoring inter-reflection. At roughness 1 the two k agree (0.5), and that is where
// the loss the compensation answers lives.
//
// WHY A CONSTANT TABLE AND NOT THE LUT TEXTURE. Every path that lights a surface reaches this file - the deferred
// composite, the forward passes, MegaLights' shade and volume programs, the GI hit lighting of every tracer - and
// most of them bind no BrdfLutTexture. Like DirectLighting.glslh this file declares no sampler, so it stays
// includable anywhere and compiles as C++ (the Desert/Tests/Engine references). The image-based half has the LUT
// texture at hand and takes E from its own sample (Mesh/AmbientIBL.glslh DesertAmbientSpecularAlbedo), which makes
// its white furnace exact.
const float kGGXSpecularAlbedo[256] = {
	0.9703f, 0.9906f, 0.9947f, 0.9965f, 0.9975f, 0.9981f, 0.9986f, 0.9989f,
	0.9991f, 0.9993f, 0.9995f, 0.9996f, 0.9997f, 0.9998f, 0.9999f, 1.0000f,
