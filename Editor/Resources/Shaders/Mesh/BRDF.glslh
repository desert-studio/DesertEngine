#ifndef BRDF_GLSLH
#define BRDF_GLSLH

const float PI = 3.141592;

float DistributionGGX(float cosLh, float roughness)
{
	float alpha   = roughness * roughness;
	float alphaSq = alpha * alpha;

	// Guard against degenerate denom when roughness and cosLh are both near zero.
	float denom = max((cosLh * cosLh) * (alphaSq - 1.0) + 1.0, 1e-6);
	return alphaSq / (PI * denom * denom);
}

// Distance attenuation with a selectable falloff model. Matches ECS::LightFalloff:
//   0 = Linear, 1 = Quadratic (default), 2 = InverseSquare (physical 1/d^2, windowed).
// Full intensity within minRadius; smoothly reaches exactly 0 at radius (no hard edge / no leak past it).
float LightFalloffFactor(float dist, float minRadius, float radius, int falloff)
{
    if (radius <= 0.0)      return 0.0;
    if (dist <= minRadius)  return 1.0;
    if (dist >= radius)     return 0.0;

    float band = max(radius - minRadius, 1e-4);
    float t    = clamp((dist - minRadius) / band, 0.0, 1.0); // 0 at minRadius -> 1 at radius

    float curve;
    if (falloff == 0)
    {
        curve = 1.0 - t;                           // Linear
    }
    else if (falloff == 2)
    {
        float d   = max(dist, 1e-3);
        float ref = max(minRadius, 0.05);
        curve = (ref * ref) / (d * d) * (1.0 - t); // Inverse-square, windowed to 0 at radius
    }
    else
    {
        curve = (1.0 - t) * (1.0 - t);             // Quadratic
    }
    return clamp(curve, 0.0, 1.0);
}

// G / (4 NoL NoV) of the GGX lobe: the HEIGHT-CORRELATED Smith masking-shadowing term (Heitz 2014, "Understanding
// the Masking-Shadowing Function in Microfacet-Based BRDFs", eq. 99; Filament V_SmithGGXCorrelated), exact for GGX,
// alpha = roughness^2:
//
//     Vis = 0.5 / ( NoL * sqrt( NoV^2 (1 - alpha^2) + alpha^2 ) + NoV * sqrt( NoL^2 (1 - alpha^2) + alpha^2 ) )
//
// It replaced the SEPARABLE Smith-Schlick term G1(L) G1(V) with Karis' k = (roughness + 1)^2 / 8 (UE4's 2013 "hotness"
// remap for analytic lights). Two things were wrong with that pair. The separable form treats masking and shadowing
// as independent although both are set by the same microfacet heights, so it double-counts their overlap and
// darkens every rough lobe (UE4 -> UE5, Filament and Frostbite all moved to the correlated form). And the remap made
// the analytic lobe a DIFFERENT lobe from the one the image-based half integrates (k = alpha / 2 in
// Graphic/BRDFLut.cpp), so the multiple-scattering table compensated a lobe the sun never drew. Now the sun, the
// local lights, MegaLights, the GI hit lighting, the path tracer's slab, the split-sum LUT (Graphic/BRDFLut.cpp) and
// the albedo table below integrate ONE lobe.
//
// UE5 ships the linear approximation of the two square roots here (BRDF.ush Vis_SmithJointApprox) but the exact
// form in its anisotropic lobe (Vis_SmithJointAniso). The exact form is taken on purpose: the approximation
// underestimates the lobe's albedo by up to 17 % at mid roughness (E = 0.70 instead of 0.84 at roughness 0.5,
// N.V 0.25 - scripts/Dev/ggx_specular_albedo_table.py's integrand), and with it the anisotropic slab
// (Mesh/SubstrateSlab.glslh DesertSlabAnisotropicVisibility) is exactly this term at anisotropy 0, so a material that
// animates its anisotropy to 0 does not change brightness.
//
// Bounded: with the caller's roughness floor (kDesertMinRoughness) alpha > 0, so Vis * NoL <= 0.5 / alpha stays
// finite as NoL and NoV reach 0; the floor on the denominator only keeps 0 / 0 at NoL = NoV = 0 from becoming a NaN
// (the caller multiplies by NoL = 0 there).
float VisibilitySmith(float cosLi, float cosLo, float roughness)
{
	float alpha  = roughness * roughness;
	float alpha2 = alpha * alpha;
	float smithV = cosLi * sqrt(cosLo * cosLo * (1.0f - alpha2) + alpha2);
	float smithL = cosLo * sqrt(cosLi * cosLi * (1.0f - alpha2) + alpha2);
	return 0.5f / max(smithV + smithL, 1e-7f);
}

vec3 fresnelSchlick(vec3 F0, float cosTheta)
{
	return F0 + (vec3(1.0) - F0) * pow(1.0 - cosTheta, 5.0);
}

// MULTIPLE-SCATTERING ENERGY COMPENSATION of the GGX specular lobe (Kulla-Conty 2017, Fdez-Aguera 2019; UE's
// ShadingEnergyConservation: ComputeGGXSpecEnergyTermsRGB, W = 1 + F0 * (1 - E) / E).
//
// A single-scattering microfacet BRDF loses the light that bounces between microfacets more than once: its
// directional albedo E(N.V, roughness) for F0 = 1 - the white-furnace integral of the lobe - is 1 for a mirror and
// falls to 0.35 at roughness 1 seen head-on. A rough metal therefore drew up to three times darker than the light
// it receives, and darker the rougher it was. The missing share is restored by scaling the lobe by
// W = 1 + F0 * (1 / E - 1): for F0 = 1 the lobe then integrates to exactly 1 (W * E = 1), and a dielectric's small
// F0 takes only F0 * (1 - E) more - the multiply-scattered light is coloured by F0 (Kulla-Conty's F_avg term).
//
// THE PREINTEGRATED E. kGGXSpecularAlbedo is the split-sum LUT's scale + bias at F0 = 1 (Graphic/BRDFLut.cpp
// IntegrateBRDF: GGX D, VisibilitySmith's height-correlated Smith term, alpha = roughness^2) on a 16 x 16 grid of
// texel centres - u = N.V, v = roughness, both (i + 0.5) / 16 - integrated from the same integrand at 16384
// Hammersley samples by scripts/Dev/ggx_specular_albedo_table.py, which prints these rows. It is the albedo of the
// very lobe EvaluateDirectLight draws (one Smith term for the analytic and the image-based half), so W * E = 1 holds
// for every light, not only for the sky.
//
// WHY A CONSTANT TABLE AND NOT THE LUT TEXTURE. Every path that lights a surface reaches this file - the deferred
// composite, the forward passes, MegaLights' shade and volume programs, the GI hit lighting of every tracer - and
// most of them bind no BrdfLutTexture. Like DirectLighting.glslh this file declares no sampler, so it stays
// includable anywhere and compiles as C++ (the Desert/Tests/Engine references). The image-based half has the LUT
// texture at hand and takes E from its own sample (Mesh/AmbientIBL.glslh DesertAmbientSpecularAlbedo), which makes
// its white furnace exact.
const float kGGXSpecularAlbedo[256] = {
	0.9995f, 1.0000f, 1.0000f, 1.0000f, 1.0000f, 1.0000f, 1.0000f, 1.0000f,
	1.0000f, 1.0000f, 1.0000f, 1.0000f, 1.0000f, 1.0000f, 1.0000f, 1.0000f,
	0.9564f, 0.9947f, 0.9982f, 0.9991f, 0.9995f, 0.9997f, 0.9998f, 0.9998f,
