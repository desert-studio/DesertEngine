// E(N.V, roughness) for F0 = 1, bilinear between the table's texel centres and clamped at its edges (a texture's
// clamp-to-edge). Written in the subset GLSL and C++ share: no literal is a double and no built-in is called.
float GGXSpecularAlbedo(float NoV, float roughness)
{
	float x = NoV * 16.0f - 0.5f;
	float y = roughness * 16.0f - 0.5f;
	if (x < 0.0f)
		x = 0.0f;
	if (x > 15.0f)
		x = 15.0f;
	if (y < 0.0f)
		y = 0.0f;
	if (y > 15.0f)
		y = 15.0f;
	int x0 = int(x);
	int y0 = int(y);
	if (x0 > 14)
		x0 = 14;
	if (y0 > 14)
		y0 = 14;
	const float fx  = x - float(x0);
	const float fy  = y - float(y0);
	const float e00 = kGGXSpecularAlbedo[y0 * 16 + x0];
	const float e10 = kGGXSpecularAlbedo[y0 * 16 + x0 + 1];
	const float e01 = kGGXSpecularAlbedo[(y0 + 1) * 16 + x0];
	const float e11 = kGGXSpecularAlbedo[(y0 + 1) * 16 + x0 + 1];
	const float e0  = e00 + (e10 - e00) * fx;
	const float e1  = e01 + (e11 - e01) * fx;
	return e0 + (e1 - e0) * fy;
}

// W = 1 + F0 * (1 / E - 1) for the lobe's F0 = 1 albedo @p specularAlbedo. Multiplies the specular lobe; the diffuse
// lobe under it gives up the same extra energy (GGXMultipleScatteringShare). The table's least entry is 0.34; the
// floor is for a split-sum sample of the frame graph's black stand-in LUT (FrameGraphRefs.hpp: BrdfLut or
// System.Black), whose lobe is 0 and must stay 0 rather than become 0 * inf = NaN.
vec3 GGXEnergyCompensation(vec3 F0, float specularAlbedo)
{
	float E = specularAlbedo;
	if (E < 1e-4f)
		E = 1e-4f;
	return 1.0f + F0 * (1.0f / E - 1.0f);
}

// What the compensated lobe reflects ON TOP of the single-scattering one, E * (W - 1) = F0 * (1 - E): the share of
// the incident energy the diffuse lobe under it can no longer receive.
vec3 GGXMultipleScatteringShare(vec3 F0, float specularAlbedo)
{
	return F0 * (1.0f - specularAlbedo);
}

#endif // BRDF_GLSLH