#ifndef CASCADED_SHADOW_GLSLH
#define CASCADED_SHADOW_GLSLH

// THE cascaded shadow of opaque geometry as a receiver sees it — one text, compiled by every shader
// that shades a surface with the sun.
//
// Why it is a header and not four copies. It WAS four copies, and by the time Д20 measured them two of
// them had already drifted: Programs/Surface/StaticMeshLit.shader and Programs/Deferred/DeferredLighting.shader
// carried the cascade CROSS-FADE (sampleCascade + a blend band at the tight cascade's border), while
// Programs/Surface/SkinnedMeshLit.shader and Programs/Surface/StaticMeshLit_Instanced.shader carried the version
// from before that fix and returned the tight cascade's PCF result raw. A skinned character and an
// instanced prop therefore carried the hard cascade seam the other two had had smoothed away, standing
// beside a non-instanced static mesh that did not, in the same frame, lit by the same sun, through the
// same maps. Nobody chose that; the fix was applied to the copy the fixer was looking at.
//
// Measured on Resources/Assets/Scenes/MAT_ProbeCascadeSeam.desce, which exists for this: a shadow edge
// crossing 100 instanced tiles at the cascade-0 border. Unifying the text moved 362 of 980 480 pixels
// (0.037 %), max delta 112/255, and inside a 100x60 window on the seam it took p95 from 0.577 to 0.494
// and contrast from 0.373 to 0.290 — the step flattening into the fade. The scene's repeat-shot noise
// floor is 0 pixels.
//
// This is the same cure Р16 (the ambient), Р20 (the direct-light BRDF) and Р21 (the cloud shadow) used
// on the same failure shape, and it is not "a test that the copies agree" — it is one copy that cannot
// disagree. The one place a caller may still differ is where it decides the answer applies (see the
// per-mesh Receive Shadows note under ShadowFactor), and that difference is at the CALL SITE where it
// can be read, not inside four bodies that look identical until you diff them.
//
// ------------------------------------------------------------------------------------------------
// WHAT THE INCLUDER OWES IT — the same contract Mesh/AmbientIBL.glslh has with its three environment
// bindings and Common/CloudShadowReceiver.glslh with its two. This file declares no binding of its
// own, because the slot numbers genuinely differ between the consumers: the deferred composite is a
// fullscreen material with a layout of its own (it already numbers the IBL trio 17/18/19 against the
// mesh shaders' 8/9/10), the mesh shaders share one layout with the G-buffer pass, and a shader-graph
// material's layout is generated. The includer must declare, at whatever slots are free in ITS layout:
//
//     Uniform(a) texture2DArray u_ShadowCascades; // layer c = cascade c
//     #define u_ShadowCascades sampler2DArray(u_ShadowCascades, u_LinearRepeatSampler) // a shared state of the pass
//     Uniform(e) ShadowUB {
//         mat4 u_LightViewProj[4];
//         vec4 u_ShadowParams;      // x = tan(sun source angle / 2), y = enabled (>0.5), z = debug mode (0/1/2), w = cascade count
//         vec4 u_DebugParams;       // x = show normals (>0.5), y = light debug (>0.5); z,w reserved
//         vec4 u_CascadeTexelWorld; // per-cascade world size of one shadow-map texel (x..w = cascade 0..3)
//         vec4 u_CascadeDepthRange; // per-cascade world length the [0,1] map depth spans (x..w = cascade 0..3)
//         vec4 u_ContactShadowView; // the view's contact shadow march (Common/ContactShadow.glslh); its z, the
//                                   // view's dither frame, also turns the soft filter's disc below
//         vec4 u_SunContactShadow;  // x = the sun's ContactShadowLength, y = in world space (>0.5)
//         vec4 u_ShadowFilter;      // x = PCSS blocker search taps, y = PCSS filter taps (SceneResources::PackShadowFilter)
//     };
//
// The cascades are the layers of ONE D32F DEPTH array (ViewTargetFormats::kShadowDepth; UE: the whole-scene
// shadow atlas of a directional light), so the shader indexes the cascade at run time and the lit passes spend
// one sampler slot on them, not four (MoltenVK caps a stage at 16). They are read raw — never through a comparison
// sampler — by textureGather, which needs no linear-filter support of the depth format.
//
// The NAMES are what has to match, and they do because every material binds by name — see
// Graphic::SceneShadowBind, which is the single C++ writer of the block and of the cascade array, and
// SceneResources::ShadowUBData, whose layout Desert/Tests/Engine/SceneFrameBinding asserts against the
// reflected GLSL block. The array length above is SceneResources::kMaxCascades and is not restated
// here as a number the includer may pick.
//
// CASCADES KEEP STANDARD Z. The rest of the engine is reversed-Z on DEPTH32F, and this text's `ndc.z`
// comparisons read the other way round from that on purpose: an orthographic light projection has no
// 1/z curve for the float exponent to cancel, so reversing it buys exactly zero. See
// Core/Projection.hpp.

// The 2x2 depths around uv in cascade c (gather order: (0,1) (1,1) (1,0) (0,0) of the footprint).
vec4 gatherShadowMap(int c, vec2 uv)
{
	return textureGather(u_ShadowCascades, vec3(uv, float(c)), 0);
}
ivec2 shadowMapSize(int c)
{
	return textureSize(u_ShadowCascades, 0).xy; // every layer has the array's extent
}
vec3 cascadeDebugColor(int c)
{
	if (c == 0) return vec3(1.0, 0.35, 0.35);
	if (c == 1) return vec3(0.35, 1.0, 0.35);
	if (c == 2) return vec3(0.35, 0.55, 1.0);
	if (c == 3) return vec3(1.0, 0.95, 0.35);
	return vec3(0.4); // outside all cascades
}

// First cascade (tightest→loosest) whose light-space projection contains worldPos. -1 = outside all.
int chooseCascade(vec3 worldPos)
{
	for (int c = 0; c < int(u_ShadowParams.w); ++c)
	{
		vec4 lc  = u_LightViewProj[c] * vec4(worldPos, 1.0);
		vec3 ndc = lc.xyz / lc.w;
		vec2 uv  = ndc.xy * 0.5 + 0.5;
		if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0 && ndc.z <= 1.0)
			return c;
	}
	return -1;
}

// ------------------------------------------------------------------------------------------------
// SOFT SHADOWS FROM THE SUN'S SIZE — PCSS (UE: ShadowFilteringCommon.ush / the directional PCSS of
// ShadowProjectionPixelShader.usf). The sun is a disc of angular diameter SourceAngle, so a shadow edge is a
// penumbra whose half-width grows by tan(SourceAngle / 2) per centimetre between the occluder and the receiver:
// sharp where an awning meets the wall, soft where its shadow lands metres away. Two steps:
//   1. blocker search - the mean depth of the occluders inside the widest kernel the receiver could need;
//   2. filter         - percentage-closer filtering with the kernel that mean gives.
// Both walk the shadow filters' Vogel disc turned per pixel by interleaved gradient noise
// (Common/ShadowFilterDisk.glslh, shared with the point and spot lights' PCF). Each tap is a bilinear 2x2
// comparison from one gather.
#include <Common/ShadowFilterDisk.glslh>

// UE's r.Shadow.MaxSoftKernelSize: the widest the soft kernel may get, in texels of its cascade.
const float kMaxSoftKernelTexels = 40.0;

// Bilinear percentage-closer comparison at uv: 1 lit, 0 shadowed. `depth` is the receiver's.
float shadowCompare2x2(int c, vec2 uv, vec2 size, float depth)
{
	vec4 d   = gatherShadowMap(c, uv);
	vec4 lit = step(vec4(depth), d); // depth <= occluder: lit
	vec2 f   = fract(uv * size - 0.5);
	return mix(mix(lit.w, lit.z, f.x), mix(lit.x, lit.y, f.x), f.y);
}

// Samples ONE cascade at worldPos. Returns 1 (lit) when outside the cascade so the caller's blend/fallback can
// take over. Factored out of ShadowFactor so cascades can be cross-faded.
float sampleCascade(int c, vec3 worldPos, vec3 N, float NdotL)
{
	// Normal-offset bias scaled by the cascade's world-per-texel (a few texels along the normal,
	// widening at grazing angles) — cascade-correct instead of fixed world-unit constants.
	float texelWorld   = u_CascadeTexelWorld[c];
	float normalOffset = (1.5 + 2.5 * (1.0 - NdotL)) * texelWorld;
	vec3  samplePos    = worldPos + N * normalOffset;

	vec4 lightClip = u_LightViewProj[c] * vec4(samplePos, 1.0);
	vec3 ndc = lightClip.xyz / lightClip.w;
	vec2 uv = ndc.xy * 0.5 + 0.5;
	// Shadow maps are rendered through the engine's negative-height (Y-flipped) viewport -> flip Y.
	uv.y = 1.0 - uv.y;

	if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || ndc.z > 1.0)
		return 1.0;

	// NO CONSTANT DEPTH BIAS HERE. The caster wrote its depth already pushed back by the light's bias in world
	// centimetres (Graphic::CascadeCasterBias: constant through the caster matrix, slope in
	// the caster's vertex stage, Common/ShadowCasterBias.glslh), as UE does in ShadowDepthVertexShader.usf. A bias in this
	// cascade's NDC depth was a world length of bias * 4R - 26 cm in cascade 0, 10 m in cascade 3.
	float currentDepth = ndc.z;

	vec2  size       = vec2(shadowMapSize(c));
	vec2  texel      = 1.0 / size;
	float depthRange = max(u_CascadeDepthRange[c], 1e-3);   // world cm per unit of map depth
	float tanHalf    = u_ShadowParams.x;                     // tan(sun source angle / 2)
	float phi        = 6.28318531 * shadowInterleavedGradientNoise(gl_FragCoord.xy, u_ContactShadowView.z);
	// The kernel's cost (Scalability Shadows.BlockerSearchTaps / Shadows.FilterTaps, the view's ShadowUB).
	int   blockerSearchTaps = int(u_ShadowFilter.x + 0.5);
	int   filterTaps        = int(u_ShadowFilter.y + 0.5);

	// THE RECEIVER PLANE across the kernel. A tap `r` centimetres from the centre reads a map texel of the
	// receiver's own plane that lies r * tan(theta) nearer the sun at most (theta: the receiver's angle to the
	// sun); that much, in map depth, is forgiven per tap, or a wide kernel shadows the lit surface it sits on.
	float tanTheta = min(sqrt(max(1.0 - NdotL * NdotL, 0.0)) / max(NdotL, 1e-3), 4.0);

	// 1. BLOCKER SEARCH, as wide as the farthest possible occluder could make the penumbra - capped by the kernel.
	float searchTexels = 1.0;
	if (tanHalf > 0.0)
		searchTexels = clamp(tanHalf * currentDepth * depthRange / texelWorld, 1.0, kMaxSoftKernelTexels);
	float blockerSum   = 0.0;
	float blockerCount = 0.0;
	for (int i = 0; i < blockerSearchTaps; ++i)
	{
		vec2  offset = shadowVogelDisk(i, blockerSearchTaps, phi) * searchTexels;
		float slack  = length(offset) * texelWorld * tanTheta / depthRange;
		vec4  d      = gatherShadowMap(c, uv + offset * texel);
		vec4  isBlocker = step(d, vec4(currentDepth - slack - 1e-6));
		blockerSum   += dot(d, isBlocker);
		blockerCount += dot(isBlocker, vec4(1.0));
	}
	if (blockerCount < 0.5)
		return 1.0;
	float blockerDepth = blockerSum / blockerCount;

	// 2. THE PENUMBRA from the occluder-receiver distance, in texels of this cascade. At least one texel: the
	// bilinear 2x2 taps over a one-texel disc are the contact-hard edge the map can resolve.
	float distanceWorld  = max(currentDepth - blockerDepth, 0.0) * depthRange;
	float penumbraTexels = clamp(tanHalf * distanceWorld / texelWorld, 1.0, kMaxSoftKernelTexels);

	float lit = 0.0;
	for (int i = 0; i < filterTaps; ++i)
	{
		vec2  offset = shadowVogelDisk(i, filterTaps, phi) * penumbraTexels;
		float slack  = length(offset) * texelWorld * tanTheta / depthRange;
		lit += shadowCompare2x2(c, uv + offset * texel, size, currentDepth - slack);
	}
	return lit / float(filterTaps);
}

// N = world-space surface normal, L = world-space direction TOWARD the sun (both normalized).
// Picks the cascade covering worldPos, PCF-samples it, and CROSS-FADES into the next (looser)
// cascade within a band at the tight cascade's edge so the boundary seam doesn't pop/flicker as
// the camera moves. `cascadeOut` returns the chosen cascade (-1 outside all / disabled) for debug.
//
// 1 = full sun, 0 = fully shadowed. A MULTIPLIER on the direct sun term and never on the ambient: the
// ambient is the whole sky dome and a cascade occludes one direction (the same reason
// Common/CloudShadowReceiver.glslh gives for the other occluder of this same sun; a surface can be in
// either, both or neither, and the two multiply).
//
// THE PER-MESH `Receive Shadows` FLAG IS NOT APPLIED HERE, and that is a property rather than an
// omission. It rides the material's ExtraParams.w, which the forward mesh shaders have and the G-buffer
// does not carry into the deferred composite — so the forward callers override this result to 1 after
// calling and the deferred one cannot. Folding it in here would either invent a uniform the deferred
// path has no value for, or silently give the deferred path a flag it cannot honour. It also has to be
// applied BEFORE the cloud shadow is multiplied in and not after: it is a CASCADE toggle, and a mesh
// that opted out of geometry shadows must not become the one surface in the scene whose cloud shading
// depends on which path drew it.
float ShadowFactor(vec3 worldPos, vec3 N, vec3 L, out int cascadeOut)
{
	cascadeOut = -1;
	if (u_ShadowParams.y < 0.5)
		return 1.0;

	int c = chooseCascade(worldPos);
	cascadeOut = c;
	if (c < 0)
		return 1.0;

	float NdotL  = max(dot(N, L), 0.0);
	float shadow = sampleCascade(c, worldPos, N, NdotL);

	// Cross-fade near the chosen cascade's border into the next one (which fully covers this
	// region). `edge` is the distance to the nearest UV border (0.5 at centre, 0 at the seam).
	const float kBand = 0.10;
	int cascadeCount = int(u_ShadowParams.w);
	if (c + 1 < cascadeCount)
	{
		vec4  lc  = u_LightViewProj[c] * vec4(worldPos, 1.0);
		vec2  uv  = (lc.xy / lc.w) * 0.5 + 0.5;
		float edge = min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y));
		if (edge < kBand)
		{
			float next = sampleCascade(c + 1, worldPos, N, NdotL);
			shadow = mix(next, shadow, clamp(edge / kBand, 0.0, 1.0));
		}
	}
	return shadow;
}

// THE SUN THROUGH A SUBSURFACE RECEIVER'S OCCLUDERS (DesertLight::TransmissionShadow). Ported from UE 5.8
// ShadowProjectionPixelShader.usf (the subsurface branch: the receiver's own depth, no normal offset, density times
// the projection's depth range) and ShadowFilteringCommon.ush CalculateShadowVisibilityTransmittanceFactor
// (transmittance exp( -thickness * density ) per texel, a texel never written transmits all), adapted: the caster
// bias is already in the map's depth (Graphic::CascadeCasterBias), so the receiver's depth is taken as is; the
// map depth turns into centimetres through the cascade's u_CascadeDepthRange; the four texels of one gather are
// filtered bilinearly, as shadowCompare2x2 filters the opaque comparison.
// A leaf's own far side reads the leaf at its own depth (thickness 0, the light passes); a leaf deep inside a hedge
// reads the hedge's sunward surface tens of centimetres nearer the sun and transmits nothing.
// `density`: per centimetre (Common/ContactShadow.glslh ContactShadowSubsurfaceDensity of the receiver's opacity).
float sampleCascadeTransmission(int c, vec3 worldPos, float density)
{
	vec4 lightClip = u_LightViewProj[c] * vec4(worldPos, 1.0);
	vec3 ndc       = lightClip.xyz / lightClip.w;
	vec2 uv        = ndc.xy * 0.5 + 0.5;
	uv.y           = 1.0 - uv.y; // the negative-height viewport, as sampleCascade
	if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || ndc.z > 1.0)
		return 1.0;

	const vec4  occluder   = gatherShadowMap(c, uv);
	const float depthRange = max(u_CascadeDepthRange[c], 1e-3); // world cm per unit of map depth
	const vec4  thickness  = max(vec4(ndc.z) - occluder, vec4(0.0)) * depthRange;
	vec4        through    = clamp(exp(-thickness * density), vec4(0.0), vec4(1.0));
	through                = mix(through, vec4(1.0), step(vec4(0.99), occluder)); // UE: depth > .99 never written
	const vec2  f          = fract(uv * vec2(shadowMapSize(c)) - 0.5);
	return mix(mix(through.w, through.z, f.x), mix(through.x, through.y, f.x), f.y);
}

// The cascades' TransmissionShadow at worldPos: the cascade ShadowFactor chooses, cross-faded into the next one
// across the same border band, so the transmitted light and the surface light change cascade together.
float TransmissionShadowFactor(vec3 worldPos, float density)
{
	if (u_ShadowParams.y < 0.5)
		return 1.0;
	const int c = chooseCascade(worldPos);
	if (c < 0)
		return 1.0;
	float     through      = sampleCascadeTransmission(c, worldPos, density);
	const int cascadeCount = int(u_ShadowParams.w);
	if (c + 1 < cascadeCount)
	{
		const float kBand = 0.10;
		vec4        lc    = u_LightViewProj[c] * vec4(worldPos, 1.0);
		vec2        uv    = (lc.xy / lc.w) * 0.5 + 0.5;
		float       edge  = min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y));
		if (edge < kBand)
			through = mix(sampleCascadeTransmission(c + 1, worldPos, density), through, clamp(edge / kBand, 0.0, 1.0));
	}
	return through;
}

#endif // CASCADED_SHADOW_GLSLH
