#ifndef LOCAL_LIGHT_SHADOW_GLSLH
#define LOCAL_LIGHT_SHADOW_GLSLH

// THE SHADOW OF A POINT OR SPOT LIGHT, read from the view's local shadow atlas (Graphic/LocalShadows.hpp says
// why it is one 2D pool of tiles). Declares no binding: the includer declares, at slots free in ITS layout,
//     LocalShadowAtlasTexture (a sampler2D, or a texture2D + #define over a shared point-clamped state) (R32F, standard-Z depth)
//     ReadBuffer LocalShadowViewsUB { LocalShadowView localShadowViews[]; };
// and the view's ShadowUB with ShadowFilter (y = Scalability Shadows.FilterTaps, the PCF's taps),
// (the row struct is Mesh/LocalLightShadowView.glslh, included BEFORE the buffer) and includes this AFTER
// them, the way Mesh/CascadedShadow.glslh is included. The lights' contact shadows (their ContactShadowLength)
// are applied here too: Common/ContactShadow.glslh, which the includer has included with its inputs - and with it declares
//     ClosestHzbTexture (a texture2D + #define over a shared point-clamped state; the closest-depth HZB, all mips).
//
// UNDER Shadows.Method VirtualMaps (DESERT_LOCAL_SHADOW_VSM) the atlas does not exist for this reader: a light reads
// its virtual map (UE: every receiver of a local light samples its VSM), through the reader the G-buffer's
// "VSM: Project Local" uses (Common/VirtualShadowMap.glslh, VsmLocalVisibility / VsmLocalTransmission). The light's
// shadowMaskSlot is its index in the frame's VsmLocalLights (SceneRenderer::AddFrameVirtualShadows: slot = layer =
// light), -1 = not shadowed this frame. The includer declares, instead of the atlas and its views, the reader's tables
// (VsmFrameData, VsmPageTable, PhysicalPoolTexture: Core::kVsmReadFrameDataBinding ..) and
//     readonly buffer VsmLocalLightsUB { VsmLocalLight vsmLocalLights[]; };
// and includes Common/VirtualShadowMap.glslh's reader (DESERT_VSM_READ) before this header.
#include <Common/ShadowFilterDisk.glslh>
#include <Mesh/LightSources.glslh>
#include <Mesh/LocalLightShadowView.glslh>

#include <Mesh/LocalLightShadowLookup.glslh>

// The lights as a shading model receives them, with their shadow and their contact shadow - offered to an includer
// that included Common/ContactShadow.glslh first (it marches the includer's screen depth). One with no screen
// depth (the surface cache's card lighting) reads PointLightShadow / SpotLightShadow above instead.
#ifdef CONTACT_SHADOW_GLSLH
// THE SHADOW OF A CASTING LIGHT WITHOUT A MAP (no room left for it in the shadow atlas this frame, or its mask alone is
// traced): the screen trace MegaLights' Screen source marches (UE 5.8 MegaLights.ScreenTraces: TraceHZB over the closest
// HZB), over the view's one HZB, which the frame builds when it has such a light
// (SceneRenderer::LocalLightsNeedScreenTrace). Its iterations are Scalability Shadows.LocalScreenTraceIterations
// (ShadowFilter.w; UE r.MegaLights.ScreenTraces.MaxIterations). 1 past what the screen holds. An orthographic view has
// no eye: unoccluded.
#define HzbTexture ClosestHzbTexture
#include <Common/HZBTrace.glslh>
#define MEGALIGHTS_SCREEN_TRACE_WORLD_TO_CLIP CONTACT_SHADOW_VP
#define MEGALIGHTS_SCREEN_TRACE_CLIP_TO_WORLD CONTACT_SHADOW_INV_VP
vec3 LocalLightScreenTraceEye()
{
    // The eye is the one world point with clip x = y = w = 0.
    const vec4 eye = CONTACT_SHADOW_INV_VP * vec4(0.0, 0.0, 1.0, 0.0);
    return eye.xyz / eye.w;
}
#define MEGALIGHTS_SCREEN_TRACE_EYE        LocalLightScreenTraceEye()
#define MEGALIGHTS_SCREEN_TRACE_ITERATIONS int(ShadowFilter.w + 0.5)
#include <Common/MegaLightsScreenTrace.glslh>

float LocalLightScreenShadow(vec3 worldPosition, vec3 N, vec3 lightPosition, float sourceRadius)
{
    const float bias     = 1.0; // cm off the receiver, on the side the ray leaves from
    const vec3  toLight  = lightPosition - worldPosition;
    const float distance = length(toLight);
    const vec3  dir      = toLight / max(distance, 1e-3);
    const vec3  origin   = worldPosition + N * (dot(N, dir) >= 0.0 ? bias : -bias);
    return MegaLightsScreenTraceOccluded(origin, dir, distance - sourceRadius - 2.0 * bias) ? 0.0 : 1.0;
}

// `subsurfaceOpacity`: the receiver's (DesertSubsurfaceOpacity; -1 = not a subsurface model), for its contact shadow.
DesertLight DesertShadowedPointLightAt(PointLight source, vec3 worldPosition, vec3 N, float subsurfaceOpacity)
{
    DesertLight light = DesertPointLightAt(source, worldPosition);
    // A receiver the light does not reach (past its radius, outside its cone) pays no filter.
    if (max(light.Radiance.r, max(light.Radiance.g, light.Radiance.b)) > 0.0)
    {
        const float contact =
             ContactShadowFactor(worldPosition, N, light.L, LightContactShadow(source), subsurfaceOpacity);
        // Only a term the light has no shadow source for pays the trace.
        const bool shadowed = LocalLightHasShadow(source.shadowView, source.shadowMaskSlot);
        const bool mapped   = LocalLightHasShadowMap(source.shadowView, source.shadowMaskSlot);
        const bool traced   = DesertLightShadowsInView(source.shadowFlags) && (!shadowed || (subsurfaceOpacity >= 0.0 && !mapped));
        const float screen = traced ? LocalLightScreenShadow(worldPosition, N, source.position, source.sourceRadius) : 1.0;
        light.Shadow = PointLightShadow(source, worldPosition, N) * contact;
        if (!shadowed)
            light.Shadow *= screen;
        // Only a subsurface receiver (opacity >= 0) has a model that reads the transmitted share.
        if (subsurfaceOpacity >= 0.0)
            light.TransmissionShadow =
                 PointLightTransmission(source, worldPosition, ContactShadowSubsurfaceDensity(subsurfaceOpacity)) *
                 contact * screen;
    }
    return light;
}

DesertLight DesertShadowedSpotLightAt(SpotLight source, vec3 worldPosition, vec3 N, float subsurfaceOpacity)
{
    DesertLight light = DesertSpotLightAt(source, worldPosition);
    // A receiver the light does not reach (past its radius, outside its cone) pays no filter.
    if (max(light.Radiance.r, max(light.Radiance.g, light.Radiance.b)) > 0.0)
    {
        const float contact =
             ContactShadowFactor(worldPosition, N, light.L, LightContactShadow(source), subsurfaceOpacity);
        // Only a term the light has no shadow source for pays the trace.
        const bool shadowed = LocalLightHasShadow(source.shadowView, source.shadowMaskSlot);
        const bool mapped   = LocalLightHasShadowMap(source.shadowView, source.shadowMaskSlot);
        const bool traced   = DesertLightShadowsInView(source.shadowFlags) && (!shadowed || (subsurfaceOpacity >= 0.0 && !mapped));
        const float screen = traced ? LocalLightScreenShadow(worldPosition, N, source.position, source.sourceRadius) : 1.0;
        light.Shadow = SpotLightShadow(source, worldPosition, N) * contact;
        if (!shadowed)
            light.Shadow *= screen;
        // Only a subsurface receiver (opacity >= 0) has a model that reads the transmitted share.
        if (subsurfaceOpacity >= 0.0)
            light.TransmissionShadow =
                 SpotLightTransmission(source, worldPosition, ContactShadowSubsurfaceDensity(subsurfaceOpacity)) *
                 contact * screen;
    }
    return light;
}
#endif // CONTACT_SHADOW_GLSLH

#endif // LOCAL_LIGHT_SHADOW_GLSLH
