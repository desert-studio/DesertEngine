#ifndef LOCAL_LIGHT_SHADOW_GLSLH
#define LOCAL_LIGHT_SHADOW_GLSLH

// THE SHADOW OF A POINT OR SPOT LIGHT, read from the view's local shadow atlas (Graphic/LocalShadows.hpp says
// why it is one 2D pool of tiles). Declares no binding: the includer declares, at slots free in ITS layout,
//     sampler2D u_LocalShadowAtlas;                         (R32F, standard-Z depth of each view's casters)
//     ReadBuffer LocalShadowViewsUB { LocalShadowView localShadowViews[]; };
// (the row struct is Mesh/LocalLightShadowView.glslh, included BEFORE the buffer) and includes this AFTER
// them, the way Mesh/CascadedShadow.glslh is included. The lights' contact shadows (their ContactShadowLength)
// are applied here too: Common/ContactShadow.glslh, which the includer has included with its inputs.
#include <Mesh/LightSources.glslh>
#include <Mesh/LocalLightShadowView.glslh>

#include <Mesh/LocalLightShadowLookup.glslh>

// The lights as a shading model receives them, with their shadow.
// `subsurfaceOpacity`: the receiver's (DesertSubsurfaceOpacity; -1 = not a subsurface model), for its contact shadow.
DesertLight DesertShadowedPointLightAt(PointLight source, vec3 worldPosition, vec3 N, float subsurfaceOpacity)
{
    DesertLight light = DesertPointLightAt(source, worldPosition);
    // A receiver the light does not reach (past its radius, outside its cone) pays no filter.
    if (max(light.Radiance.r, max(light.Radiance.g, light.Radiance.b)) > 0.0)
        light.Shadow = PointLightShadow(source, worldPosition, N) *
                       ContactShadowFactor(worldPosition, N, light.L, LightContactShadow(source), subsurfaceOpacity);
    return light;
}

DesertLight DesertShadowedSpotLightAt(SpotLight source, vec3 worldPosition, vec3 N, float subsurfaceOpacity)
{
    DesertLight light = DesertSpotLightAt(source, worldPosition);
    // A receiver the light does not reach (past its radius, outside its cone) pays no filter.
    if (max(light.Radiance.r, max(light.Radiance.g, light.Radiance.b)) > 0.0)
        light.Shadow = SpotLightShadow(source, worldPosition, N) *
                       ContactShadowFactor(worldPosition, N, light.L, LightContactShadow(source), subsurfaceOpacity);
    return light;
}

#endif // LOCAL_LIGHT_SHADOW_GLSLH
