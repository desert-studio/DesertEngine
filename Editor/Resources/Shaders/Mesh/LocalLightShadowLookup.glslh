#ifndef LOCAL_LIGHT_SHADOW_LOOKUP_GLSLH
#define LOCAL_LIGHT_SHADOW_LOOKUP_GLSLH

// THE LOOKUP of a point or spot light's shadow in the view's local shadow atlas, without the contact shadow:
// what a receiver with no screen position (a froxel of Programs/Fog/VolumetricFogLightScattering.shader) can
// read. Mesh/LocalLightShadow.glslh adds the contact shadow on top for surfaces. Declares no binding: the
// includer declares LocalShadowAtlasTexture, ReadBuffer LocalShadowViewsUB { LocalShadowView localShadowViews[]; }
// and the view's ShadowUB (ShadowFilter, unless LOCAL_SHADOW_FILTER_TAPS is defined) first (see Mesh/LocalLightShadow.glslh).
// UNDER Shadows.Method VirtualMaps (DESERT_LOCAL_SHADOW_VSM) the atlas half is compiled out and Point/SpotLightShadow
// and Point/SpotLightTransmission read the light's virtual map instead (see Mesh/LocalLightShadow.glslh for what the
// includer then declares). The froxel fog has the same two permutations (VolumetricFogRenderer picks by
// Graphic::LocalShadowsVirtual, the rule every local-shadow reader takes).
//
// The PCF disc's rotation is keyed on a pixel: LOCAL_SHADOW_FILTER_PIXEL, the fragment's gl_FragCoord.xy unless the
// includer names another (a compute receiver has no fragment: the froxel fog names its froxel's xy).
#ifndef LOCAL_SHADOW_FILTER_PIXEL
#define LOCAL_SHADOW_FILTER_PIXEL gl_FragCoord.xy
#endif
// The PCF's taps: the view's Shadows.FilterTaps (ShadowUB's ShadowFilter.y) unless the includer names a count (the
// froxel fog has no ShadowUB and takes one bilinear tap per froxel, its temporal reprojection filtering the rest).
#ifndef LOCAL_SHADOW_FILTER_TAPS
#define LOCAL_SHADOW_FILTER_TAPS ShadowFilter.y
#endif
// The PCSS blocker search's taps (LocalShadowPCSS): the view's Shadows.BlockerSearchTaps (ShadowUB's ShadowFilter.x)
// unless the includer names a count. 0 = no search: the light's source size is not read and every lookup is the
// fixed-width LocalShadowPCF (the froxel fog: one bilinear tap, its temporal reprojection filtering the rest).
#ifndef LOCAL_SHADOW_BLOCKER_SEARCH_TAPS
#define LOCAL_SHADOW_BLOCKER_SEARCH_TAPS ShadowFilter.x
#endif
#include <Common/ShadowFilterDisk.glslh>
#include <Mesh/LightSources.glslh>
#include <Mesh/LocalLightShadowView.glslh>
// The PCF disc's radius in shadow-map texels (the atlas tile's, or the virtual map mip's): the reach of the 4x4
// bilinear footprint of UE's Manual3x3PCF - the narrowest kernel of the soft filters too.
const float kLocalShadowFilterRadiusTexels = 1.5;
#ifndef DESERT_LOCAL_SHADOW_VSM
// The world distance along the view's axis a stored standard-Z depth stands for.
float LocalShadowLinearDepth(float z, float nearPlane, float farPlane)
{
    return nearPlane * farPlane / (farPlane - z * (farPlane - nearPlane));
}


// Bilinear percentage-closer comparison at the atlas texel position `texel` (texel centres at .5 removed): 1 lit,
// 0 shadowed. Each of the four texels is clamped into [lo, hi], the view's own tile, so a filter at its edge never
// reads the neighbouring view.
// The linear depths (world cm along the view's axis) of the 2x2 atlas texels a bilinear tap at `texel` reads, in
// the order x = (0,0), y = (1,0), z = (0,1), w = (1,1), each clamped into [lo, hi] - the view's own tile.
vec4 LocalShadowOccluders2x2(LocalShadowView v, vec2 texel, vec2 lo, vec2 hi)
{
    const vec2 base = floor(texel);
    vec4       occluder;
    for (int k = 0; k < 4; ++k)
    {
        const vec2 t = clamp(base + vec2(float(k & 1), float(k >> 1)), lo, hi);
        occluder[k]  = LocalShadowLinearDepth(texelFetch(LocalShadowAtlasTexture, ivec2(t), 0).r, v.params.x,
                                              v.params.y);
    }
    return occluder;
}

float LocalShadowCompare2x2(LocalShadowView v, vec2 texel, vec2 lo, vec2 hi, float receiverDepth)
{
    const vec2 f   = texel - floor(texel);
    const vec4 lit = step(vec4(receiverDepth), LocalShadowOccluders2x2(v, texel, lo, hi)); // receiver <= occluder
    return mix(mix(lit.x, lit.y, f.x), mix(lit.z, lit.w, f.x), f.y);
}

// PCF over the shadow filters' Vogel disc (Common/ShadowFilterDisk.glslh) with Shadows.FilterTaps taps - the
// count the sun's PCSS filter takes (ShadowFilter.y), so one quality level sets both - each tap a bilinear 2x2
// comparison, the disc kLocalShadowFilterRadiusTexels wide. 1 = lit.
float LocalShadowPCF(LocalShadowView v, vec2 tileUV, float receiverDepth)
{
    const float side  = 1.0 / v.params2.y;
    const vec2  lo    = v.atlasRect.xy * side;
    const vec2  hi    = lo + v.atlasRect.zw * side - 1.0;
    const vec2  texel = (v.atlasRect.xy + tileUV * v.atlasRect.zw) * side - 0.5;
    const int   taps  = int(LOCAL_SHADOW_FILTER_TAPS + 0.5);
    const float phi   = 6.28318531 * shadowInterleavedGradientNoise(LOCAL_SHADOW_FILTER_PIXEL);
    float       lit   = 0.0;
    for (int i = 0; i < taps; ++i)
        lit += LocalShadowCompare2x2(v, texel + shadowVogelDisk(i, taps, phi) * kLocalShadowFilterRadiusTexels, lo,
                                     hi, receiverDepth);
    return lit / float(taps);
}

// SOFT SHADOWS FROM THE LIGHT'S SIZE - PCSS on the atlas (UE r.Shadow.FilterMethod 1, PCSS for local lights from
// their SourceRadius; the sun's form is Mesh/CascadedShadow.glslh sampleCascade, this is its port to a perspective
// tile). The emitter is a sphere of `sourceRadius` cm, stretched into a capsule along `halfAxisTexels` (UE
// SourceLength: the tile-texel image, at the receiver, of the capsule's half-segment). An occluder at view depth
// d_b casts on a receiver at d_r a penumbra the source's size x (d_r - d_b) / d_b wide in world, which is that
// over texelAt tile texels (texelAt = params.z * d_r, one texel's world size at the receiver): sharp where the pole
// meets the floor, soft where its shadow lands far away. The kernel is the Vogel disc mapped onto that shape - a
// disc of the sphere's radius widened along the capsule's axis by its half-length - so a tube's shadow blurs along
// the tube and stays sharp across it.
//   1. blocker search - the mean depth of the occluders inside the widest kernel the receiver could need (an
//      occluder on the near plane), LOCAL_SHADOW_BLOCKER_SEARCH_TAPS taps;
//   2. filter         - LocalShadowCompare2x2 over the kernel that mean gives, its taps by the kernel's area
//      (kMinFilterTaps .. LOCAL_SHADOW_FILTER_TAPS, as the sun's adaptive kernel).
// Both are capped at kMaxSoftKernelTexels (UE r.Shadow.MaxSoftKernelSize) and read only the view's own tile (each
// texel clamped into it). The narrowest kernel is LocalShadowPCF's, so at contact the shadow is the PCF's.
// The receiver plane across the kernel: a tap r texels out reads the receiver's own surface up to
// r * texelAt * tan(theta) cm nearer the light (theta: the receiver's angle to it), forgiven per tap as the sun does.
float LocalShadowPCSS(LocalShadowView v, vec2 tileUV, float receiverDepth, float NdotL, float sourceRadius,
                      vec2 halfAxisTexels)
{
    const float side       = 1.0 / v.params2.y;
    const vec2  lo         = v.atlasRect.xy * side;
    const vec2  hi         = lo + v.atlasRect.zw * side - 1.0;
    const vec2  texel      = (v.atlasRect.xy + tileUV * v.atlasRect.zw) * side - 0.5;
    const float nearPlane  = v.params.x;
    const float texelAt    = v.params.z * receiverDepth;
    const float tanTheta   = min(sqrt(max(1.0 - NdotL * NdotL, 0.0)) / max(NdotL, 1e-3), 4.0);
    const float slackScale = texelAt * tanTheta;
    const float phi        = 6.28318531 * shadowInterleavedGradientNoise(LOCAL_SHADOW_FILTER_PIXEL);
    const int   searchTaps = int(LOCAL_SHADOW_BLOCKER_SEARCH_TAPS + 0.5);
    const int   filterTaps = int(LOCAL_SHADOW_FILTER_TAPS + 0.5);

    // The kernel's shape per unit of (d_r - d_b) / d_b: the sphere's radius and the capsule's half-axis, in texels.
    const float radiusTexels = sourceRadius / max(texelAt, 1e-6);
    const float axisLength   = length(halfAxisTexels);
    const vec2  axisDir      = axisLength > 1e-6 ? halfAxisTexels / axisLength : vec2(0.0);

    // 1. BLOCKER SEARCH, as wide as an occluder on the near plane could make the penumbra - capped by the kernel.
    const float searchScale  = max(receiverDepth - nearPlane, 0.0) / max(nearPlane, 1e-3);
    float       searchRadius = max(radiusTexels * searchScale, kLocalShadowFilterRadiusTexels);
    float       searchAxis   = axisLength * searchScale;
    const float searchFit    = min(kMaxSoftKernelTexels / (searchRadius + searchAxis), 1.0);
    searchRadius *= searchFit;
    searchAxis *= searchFit;
    float blockerSum   = 0.0;
    float blockerCount = 0.0;
    for (int i = 0; i < searchTaps; ++i)
    {
        const vec2  o         = shadowVogelDisk(i, searchTaps, phi);
        const vec2  offset    = o * searchRadius + axisDir * (dot(o, axisDir) * searchAxis);
        const float slack     = length(offset) * slackScale;
        const vec4  d         = LocalShadowOccluders2x2(v, texel + offset, lo, hi);
        const vec4  isBlocker = step(d, vec4(receiverDepth - slack - 1e-3));
        blockerSum += dot(d, isBlocker);
        blockerCount += dot(isBlocker, vec4(1.0));
    }
    // No occluder under the search: fully lit (the filter's kernel never reaches past the search's). All of them:
    // the umbra.
    if (blockerCount < 0.5)
        return 1.0;
    if (blockerCount > 4.0 * float(searchTaps) - 0.5)
        return 0.0;
    const float blockerDepth = max(blockerSum / blockerCount, max(nearPlane, 1e-3));

    // 2. THE PENUMBRA from the occluder-receiver distance.
    const float scale        = max(receiverDepth - blockerDepth, 0.0) / blockerDepth;
    float       kernelRadius = max(radiusTexels * scale, kLocalShadowFilterRadiusTexels);
    float       kernelAxis   = axisLength * scale;
    const float kernelFit    = min(kMaxSoftKernelTexels / (kernelRadius + kernelAxis), 1.0);
    kernelRadius *= kernelFit;
    kernelAxis *= kernelFit;
    // The filter's taps by the kernel's area (pi x the ellipse's two semi-axes).
    const int taps = clamp(int(ceil(3.14159265 * kernelRadius * (kernelRadius + kernelAxis))),
                           min(kMinFilterTaps, filterTaps), filterTaps);
    float     lit  = 0.0;
    for (int i = 0; i < taps; ++i)
    {
        const vec2  o      = shadowVogelDisk(i, taps, phi);
        const vec2  offset = o * kernelRadius + axisDir * (dot(o, axisDir) * kernelAxis);
        const float slack  = length(offset) * slackScale;
        lit += LocalShadowCompare2x2(v, texel + offset, lo, hi, receiverDepth - slack);
    }
    return lit / float(max(taps, 1));
}

// One view's verdict on a receiver. The receiver is moved along its normal by a fraction of a texel at its own
// distance (more as the light grazes it): one texel of a perspective map grows with the distance from the light,
// so the offset is measured in it rather than in centimetres. The depth bias is not applied here: every caster
// of the view drew its depth already pushed back by the light's Shadow Bias / Shadow Slope Bias
// (Graphic::LocalCasterBias, Common/ShadowCasterBias.glslh), the mesh cells and the terrain by one rule.
// The light's size - `sourceRadius` cm (UE SourceRadius) and `sourceHalfAxis` (UE SourceLength / 2 along the tube,
// cm; 0 = a sphere) - softens the shadow by LocalShadowPCSS; a point source (both 0) or a reader with no blocker
// search (LOCAL_SHADOW_BLOCKER_SEARCH_TAPS 0) takes the fixed-width LocalShadowPCF.
float LocalShadowAt(int viewIndex, vec3 worldPosition, vec3 N, vec3 L, float sourceRadius, vec3 sourceHalfAxis)
{
    const LocalShadowView v       = localShadowViews[viewIndex];
    const float           NdotL   = clamp(dot(N, L), 0.0, 1.0);
    const float           depth0  = (v.viewProj * vec4(worldPosition, 1.0)).w;
    const float           texelAt = v.params.z * max(depth0, 0.0);
    const vec3            sample_ = worldPosition + N * texelAt * (0.5 + 1.5 * (1.0 - NdotL));
    const vec4            clip    = v.viewProj * vec4(sample_, 1.0);
    if (clip.w <= v.params.x)
        return 1.0;
    const vec3 ndc = clip.xyz / clip.w;
    const vec2 uv  = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || ndc.z > 1.0)
        return 1.0;
    const float halfLength = length(sourceHalfAxis);
    if (int(LOCAL_SHADOW_BLOCKER_SEARCH_TAPS + 0.5) <= 0 || (sourceRadius <= 0.0 && halfLength <= 0.0))
        return LocalShadowPCF(v, uv, clip.w);
    // The capsule's half-segment as the tile sees it at the receiver: the tile texels the receiver's image moves by
    // for one texel's world length along the axis (foreshortened where the axis turns toward the light), times the
    // half-length in such steps.
    vec2 halfAxisTexels = vec2(0.0);
    if (halfLength > 0.0)
    {
        const float step_   = v.params.z * clip.w;
        const vec4  clipA   = v.viewProj * vec4(sample_ + sourceHalfAxis * (step_ / halfLength), 1.0);
        const vec2  uvA     = vec2(clipA.x / clipA.w * 0.5 + 0.5, 0.5 - clipA.y / clipA.w * 0.5);
        const vec2  perStep = (uvA - uv) * v.atlasRect.zw / v.params2.y;
        halfAxisTexels      = clipA.w > v.params.x ? perStep * (halfLength / step_) : vec2(0.0);
    }
    return LocalShadowPCSS(v, uv, clip.w, NdotL, max(sourceRadius, 0.0), halfAxisTexels);
}

// THE LIGHT THROUGH A SUBSURFACE RECEIVER'S OCCLUDERS (DesertLight::TransmissionShadow) for one view: the
// cascades' TransmissionShadowFactor (Mesh/CascadedShadow.glslh, ported from UE ShadowProjectionPixelShader.usf's
// subsurface branch) on the atlas - the receiver at its own position (no normal offset, no bias: the leaf's far
// side reads the leaf at its own depth and passes), its linear distance against each occluder's, in centimetres,
// as exp( -thickness * density ), filtered with LocalShadowPCF's 3x3 bilinear shape. A texel at the far plane was
// never written and transmits all (UE: depth > .99).
float LocalShadowTransmissionAt(int viewIndex, vec3 worldPosition, float density)
{
    const LocalShadowView v    = localShadowViews[viewIndex];
    const vec4            clip = v.viewProj * vec4(worldPosition, 1.0);
    if (clip.w <= v.params.x)
        return 1.0;
    const vec3 ndc = clip.xyz / clip.w;
    const vec2 uv  = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || ndc.z > 1.0)
        return 1.0;
    const float side    = 1.0 / v.params2.y;
    const vec2  lo      = v.atlasRect.xy * side;
    const vec2  hi      = lo + v.atlasRect.zw * side - 1.0;
    const vec2  texel   = (v.atlasRect.xy + uv * v.atlasRect.zw) * side - 0.5;
    const vec2  base    = floor(texel);
    const vec2  f       = texel - base;
    const vec4  wx      = vec4(1.0 - f.x, 1.0, 1.0, f.x);
    const vec4  wy      = vec4(1.0 - f.y, 1.0, 1.0, f.y);
    float       through = 0.0;
    for (int j = 0; j < 4; ++j)
    {
        for (int i = 0; i < 4; ++i)
        {
            const vec2  t        = clamp(base + vec2(float(i - 1), float(j - 1)), lo, hi);
            const float raw      = texelFetch(LocalShadowAtlasTexture, ivec2(t), 0).r;
            const float occluder = LocalShadowLinearDepth(raw, v.params.x, v.params.y);
            const float tap      = raw > 0.99 ? 1.0 : clamp(exp(-max(clip.w - occluder, 0.0) * density), 0.0, 1.0);
            through += wx[i] * wy[j] * tap;
        }
    }
    return through / 9.0;
}
#endif // !DESERT_LOCAL_SHADOW_VSM

#ifdef DESERT_LOCAL_SHADOW_VSM
// The bilinear verdict of the four texels of mip @p mip around map position @p at (texel centres on integers) of the
// view whose mip 0 is level @p first: each lit where its occluder is not nearer than @p receiver (view-axis cm).
float VsmLocalCompareBilinear(VsmLocalLight light, uint first, uint mip, vec2 at, float receiver)
{
    const vec2  base = floor(at);
    const vec2  f    = at - base;
    const ivec2 b    = ivec2(base);
    const float a00  = VsmLocalOccluderDistance(light, first, mip, b) >= receiver ? 1.0 : 0.0;
    const float a10  = VsmLocalOccluderDistance(light, first, mip, b + ivec2(1, 0)) >= receiver ? 1.0 : 0.0;
    const float a01  = VsmLocalOccluderDistance(light, first, mip, b + ivec2(0, 1)) >= receiver ? 1.0 : 0.0;
    const float a11  = VsmLocalOccluderDistance(light, first, mip, b + ivec2(1, 1)) >= receiver ? 1.0 : 0.0;
    return mix(mix(a00, a10, f.x), mix(a01, a11, f.x), f.y);
}

// SOFT SHADOWS FROM THE LIGHT'S SIZE ON THE VIRTUAL MAP - LocalShadowPCSS's rule (the same SourceRadius sphere
// stretched along LightSourceHalfAxis into a capsule; the same blocker search, penumbra (d_r - d_b) / d_b, Vogel
// ellipse, receiver-plane slack, adaptive taps and kMaxSoftKernelTexels cap) on the receiver's mip of the light's
// virtual map, so a pole's shadow hardens at its foot and softens away from it alike with Shadows.Method VirtualMaps
// on and off (UE: a local light's VSM shadow is softened by its SourceRadius - SMRT; the G-buffer's MegaLights path
// marches VsmLocalVisibilityRay along a capsule-sampled direction, this is the filter form for the forward, terrain
// and water receivers, which shade every light in one pass with no ray budget). Texels are the receiver's mip's:
// the kernel's world size is the same at any mip, its texel count shrinks on a coarser one. A tap outside the view
// is clamped onto its edge (VsmLocalOccluderDistance), as the atlas clamps into its tile. The receiver offset and
// the one-texel depth bias are VsmLocalVisibility's. SourceRadius 0 and SourceLength 0, or a reader with no blocker
// search, is VsmLocalVisibility itself.
float VsmLocalShadowSoft(VsmLocalLight light, vec3 world, vec3 normal, float sourceRadius, vec3 sourceHalfAxis)
{
    const float halfLength = length(sourceHalfAxis);
    const int   searchTaps = int(LOCAL_SHADOW_BLOCKER_SEARCH_TAPS + 0.5);
    if (searchTaps <= 0 || (sourceRadius <= 0.0 && halfLength <= 0.0))
        return VsmLocalVisibility(light, world, normal);
    uint first;
    uint mip;
    vec4 clip0;
    if (!VsmLocalReceiver(light, world, first, mip, clip0))
        return 1.0;
    const mat4  vp      = Levels[first].ViewProjection;
    const float texelAt = light.Params.z * float(1u << mip) * clip0.w;
    const vec3  L       = normalize(light.Position.xyz - world);
    const float NdotL   = clamp(dot(normal, L), 0.0, 1.0);
    const vec3  offset_ = world + normal * texelAt * (0.5 + 1.5 * (1.0 - NdotL));
    const vec4  clip    = vp * vec4(offset_, 1.0);
    if (clip.w <= light.Params.x)
        return 1.0;
    const vec2 ndc = clip.xy / clip.w;
    if (any(greaterThan(abs(ndc), vec2(1.0))))
        return 1.0;
    const float size      = float(Levels[first + mip].Pages.y * VSM_PAGE_SIZE);
    const vec2  texel     = (ndc * 0.5 + 0.5) * size - 0.5;
    const float nearPlane = light.Params.x;
    const float receiver  = clip.w - texelAt;
    // One texel of this mip at the receiver, and the receiver plane's slack per texel of kernel radius.
    const float texelHere  = light.Params.z * float(1u << mip) * clip.w;
    const float tanTheta   = min(sqrt(max(1.0 - NdotL * NdotL, 0.0)) / max(NdotL, 1e-3), 4.0);
    const float slackScale = texelHere * tanTheta;
    const float phi        = 6.28318531 * shadowInterleavedGradientNoise(LOCAL_SHADOW_FILTER_PIXEL);
    const int   filterTaps = int(LOCAL_SHADOW_FILTER_TAPS + 0.5);

    // The capsule's half-segment in this mip's texels at the receiver (LocalShadowAt's projection).
    vec2 halfAxisTexels = vec2(0.0);
    if (halfLength > 0.0)
    {
        const vec4 clipA = vp * vec4(offset_ + sourceHalfAxis * (texelHere / halfLength), 1.0);
        if (clipA.w > nearPlane)
            halfAxisTexels = (clipA.xy / clipA.w - ndc) * 0.5 * size * (halfLength / texelHere);
    }
    const float radiusTexels = max(sourceRadius, 0.0) / max(texelHere, 1e-6);
    const float axisLength   = length(halfAxisTexels);
    const vec2  axisDir      = axisLength > 1e-6 ? halfAxisTexels / axisLength : vec2(0.0);

    // 1. BLOCKER SEARCH, as wide as an occluder on the near plane could make the penumbra - capped by the kernel.
    const float searchScale  = max(receiver - nearPlane, 0.0) / max(nearPlane, 1e-3);
    float       searchRadius = max(radiusTexels * searchScale, kLocalShadowFilterRadiusTexels);
    float       searchAxis   = axisLength * searchScale;
    const float searchFit    = min(kMaxSoftKernelTexels / (searchRadius + searchAxis), 1.0);
    searchRadius *= searchFit;
    searchAxis *= searchFit;
    float blockerSum   = 0.0;
    float blockerCount = 0.0;
    for (int i = 0; i < searchTaps; ++i)
    {
        const vec2  o        = shadowVogelDisk(i, searchTaps, phi);
        const vec2  tap      = o * searchRadius + axisDir * (dot(o, axisDir) * searchAxis);
        const float occluder = VsmLocalOccluderDistance(light, first, mip, ivec2(floor(texel + tap + 0.5)));
        if (occluder < receiver - length(tap) * slackScale - 1e-3)
        {
            blockerSum += occluder;
            blockerCount += 1.0;
        }
    }
    if (blockerCount < 0.5)
        return 1.0;
    if (blockerCount > float(searchTaps) - 0.5)
        return 0.0;
    const float blockerDepth = max(blockerSum / blockerCount, max(nearPlane, 1e-3));

    // 2. THE PENUMBRA from the occluder-receiver distance.
    const float scale        = max(receiver - blockerDepth, 0.0) / blockerDepth;
    float       kernelRadius = max(radiusTexels * scale, kLocalShadowFilterRadiusTexels);
    float       kernelAxis   = axisLength * scale;
    const float kernelFit    = min(kMaxSoftKernelTexels / (kernelRadius + kernelAxis), 1.0);
    kernelRadius *= kernelFit;
    kernelAxis *= kernelFit;
    const int taps = clamp(int(ceil(3.14159265 * kernelRadius * (kernelRadius + kernelAxis))),
                           min(kMinFilterTaps, filterTaps), filterTaps);
    float     lit  = 0.0;
    for (int i = 0; i < taps; ++i)
    {
        const vec2 o   = shadowVogelDisk(i, taps, phi);
        const vec2 tap = o * kernelRadius + axisDir * (dot(o, axisDir) * kernelAxis);
        lit += VsmLocalCompareBilinear(light, first, mip, texel + tap, receiver - length(tap) * slackScale);
    }
    return lit / float(max(taps, 1));
}
#endif // DESERT_LOCAL_SHADOW_VSM

// The cube face a direction FROM the light falls in, in the order the faces were drawn
// (Graphic::PointShadowFaceViewProj): +X -X +Y -Y +Z -Z.
int PointShadowFace(vec3 fromLight)
{
    const vec3 a = abs(fromLight);
    if (a.x >= a.y && a.x >= a.z)
        return fromLight.x > 0.0 ? 0 : 1;
    if (a.y >= a.z)
        return fromLight.y > 0.0 ? 2 : 3;
    return fromLight.z > 0.0 ? 4 : 5;
}

// Whether a light has a map to answer a receiver (its transmission is the map's alone), and whether it has any shadow
// source here (the map, or its screen mask). A casting light (shadowCaster) with none got no room this frame: the
// readers below answer 1 for it and the surface readers (Mesh/LocalLightShadow.glslh) trace the screen instead.
bool LocalLightHasShadowMap(int shadowView, int shadowMaskSlot)
{
#ifdef DESERT_LOCAL_SHADOW_VSM
    return shadowMaskSlot >= 0;
#else
    return shadowView >= 0;
#endif
}

bool LocalLightHasShadow(int shadowView, int shadowMaskSlot)
{
#ifdef DESERT_LOCAL_SHADOW_SCREEN_MASK
    if (shadowMaskSlot >= 0)
        return true;
#endif
    return LocalLightHasShadowMap(shadowView, shadowMaskSlot);
}

float PointLightShadow(PointLight source, vec3 worldPosition, vec3 N)
{
#ifdef DESERT_LOCAL_SHADOW_SCREEN_MASK
    // The deferred composite under Shadows HardwareTraced: the light's ray-traced screen mask.
    if (source.shadowMaskSlot >= 0)
        return DesertLocalShadowScreenMask(source.shadowMaskSlot);
#endif
#ifdef DESERT_LOCAL_SHADOW_VSM
    return source.shadowMaskSlot >= 0 ? VsmLocalShadowSoft(vsmLocalLights[source.shadowMaskSlot], worldPosition, N,
                                                           source.sourceRadius, LightSourceHalfAxis(source))
                                      : 1.0;
#else
    if (source.shadowView < 0)
        return 1.0;
    const vec3 fromLight = worldPosition - source.position;
    return LocalShadowAt(source.shadowView + PointShadowFace(fromLight), worldPosition, N, normalize(-fromLight),
                         source.sourceRadius, LightSourceHalfAxis(source));
#endif
}

float SpotLightShadow(SpotLight source, vec3 worldPosition, vec3 N)
{
#ifdef DESERT_LOCAL_SHADOW_SCREEN_MASK
    if (source.shadowMaskSlot >= 0)
        return DesertLocalShadowScreenMask(source.shadowMaskSlot);
#endif
#ifdef DESERT_LOCAL_SHADOW_VSM
    return source.shadowMaskSlot >= 0 ? VsmLocalShadowSoft(vsmLocalLights[source.shadowMaskSlot], worldPosition, N,
                                                           source.sourceRadius, LightSourceHalfAxis(source))
                                      : 1.0;
#else
    if (source.shadowView < 0)
        return 1.0;
    return LocalShadowAt(source.shadowView, worldPosition, N, normalize(source.position - worldPosition),
                         source.sourceRadius, LightSourceHalfAxis(source));
#endif
}

// The light through a subsurface receiver's occluders (LocalShadowTransmissionAt / VsmLocalTransmission); 1 for a
// light without a map (LocalLightHasShadowMap).
float PointLightTransmission(PointLight source, vec3 worldPosition, float density)
{
#ifdef DESERT_LOCAL_SHADOW_VSM
    return source.shadowMaskSlot >= 0 ? VsmLocalTransmission(vsmLocalLights[source.shadowMaskSlot], worldPosition, density)
                                      : 1.0;
#else
    return source.shadowView >= 0
               ? LocalShadowTransmissionAt(source.shadowView + PointShadowFace(worldPosition - source.position),
                                           worldPosition, density)
               : 1.0;
#endif
}

float SpotLightTransmission(SpotLight source, vec3 worldPosition, float density)
{
#ifdef DESERT_LOCAL_SHADOW_VSM
    return source.shadowMaskSlot >= 0 ? VsmLocalTransmission(vsmLocalLights[source.shadowMaskSlot], worldPosition, density)
                                      : 1.0;
#else
    return source.shadowView >= 0 ? LocalShadowTransmissionAt(source.shadowView, worldPosition, density) : 1.0;
#endif
}

#endif // LOCAL_LIGHT_SHADOW_LOOKUP_GLSLH
