#ifndef DESERT_SHADOW_UB_GLSLH
#define DESERT_SHADOW_UB_GLSLH

// THE VIEW'S SHADOW BLOCK, declared once for every lit program that reads it as a uniform block: the deferred
// composite (Programs/Deferred/DeferredLighting.shader), the forward meshes (Mesh/Surface/Pass_Forward.glslh), the
// glass (Mesh/Surface/Pass_Forward_Translucent.glslh) and the forward ground (Programs/Terrain/Terrain.shader).
// Its one C++ statement is SceneResources::ShadowUBData, written whole by Graphic::SceneShadowBind
// (SceneFrameBinding::ApplyTo), so a member added there is added HERE and reaches every reader at once — the
// forward ground's hand copy once lagged a member behind (ShadowFilter) and the program stopped compiling.
// Binding 7 is the slot every one of those layouts gives it. The surface-cache cards read the same values as a
// storage block of their own (SurfaceCacheDirectLighting.shader: SurfaceCacheShadowUB), a different block.
//
// Read by Mesh/CascadedShadow.glslh, Common/ContactShadow.glslh and Mesh/LocalLightShadow.glslh by these names.
Uniform(7) ShadowUB
{
    mat4 LightViewProjection[8];  // [light * 4 + cascade] (SceneResources::kMaxCascadeViews)
    vec4 DirectionalShadow[2];    // per directional light slot (SceneResources::kMaxShadowedDirectionalLights; 0 the
                                  // sun, 1 the moon): x = tan(source angle / 2), y = casts shadows (>0.5),
                                  // z = cascades fitted, w = first layer in ShadowCascadesTexture
    vec4 CascadeTexelWorld[2];    // per slot: world size of one shadow-map texel (x..w = cascade 0..3)
    vec4 CascadeDepthRange[2];    // per slot: world length the [0,1] map depth spans (x..w = cascade 0..3)
    vec4 DebugParams;       // x = show normals (>0.5), y = light debug (>0.5), z = cascade debug mode (0/1/2)
    vec4 ContactShadowView; // x = contact shadow ray steps (0 = off), y = tan(fovY / 2), z = dither frame 0..7
    vec4 SunContactShadow;  // x = the sun's ContactShadowLength, y = in world space (>0.5),
                              // z = its Contact Shadow Casting Intensity, w = Non Casting Intensity
    vec4 ShadowFilter;      // x = PCSS blocker search taps, y = filter taps (sun PCSS + local lights PCF;
                              // SceneResources::PackShadowFilter)
};

#endif // DESERT_SHADOW_UB_GLSLH
