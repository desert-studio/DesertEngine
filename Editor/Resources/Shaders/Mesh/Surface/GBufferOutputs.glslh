#ifndef DESERT_GBUFFER_OUTPUTS_GLSLH
#define DESERT_GBUFFER_OUTPUTS_GLSLH
// THE G-BUFFER TEXEL'S ONE WRITER: the six colour slots of Graphic::GBufferLayout (ViewTargetLayouts.hpp) and how a
// surface fills them. Included by the two pass headers that write the G-buffer: the raster (Pass_GBuffer.glslh) and
// the visibility resolve (Pass_VisibilityResolve.glslh, GRASS-VIS), so a texel means the same whichever wrote it.
// Needs SurfaceInput / SurfaceOutput (SurfaceTypes.glslh) and DESERT_SHADING_MODEL_INDEX (the parser).
#include <Generated/ShadingModels.glslh>
// The raster G-buffer cell and the visibility resolve receive the view's DBuffer (DECALS-DBUFFER; defined by
// Pass_GBuffer.glslh and Pass_VisibilityResolve.glslh): the resolved grass's depth is rastered before the decals.
#ifdef DESERT_SURFACE_DBUFFER_RECEIVE
#include <Common/DBuffer.glslh>
#endif

layout( location = 0 ) out vec4 oGBufferA;            // BaseColor.rgb, Metallic.a
layout( location = 1 ) out vec4 oGBufferB;            // world Normal.rgb, Roughness.a
layout( location = 2 ) out uvec2 oGBufferShadingWord; // RG32_UINT shading word (ShadingModelContract.glslh); no
                                                      // world position: readers reconstruct it from the depth
layout( location = 3 ) out vec4 oGBufferEmissive;     // Emissive.rgb (HDR; the deferred resolve adds it), AO.a
// The view's velocity (Graphic::kVelocityFormat, slot 4 of the G-buffer target): the writer writes the view's depth,
// so it writes the same surface's motion.
#include <Common/Velocity.glslh>
layout( location = 4 ) out vec4 oVelocity;
// The view's thin-geometry coverage (slot 5 of the G-buffer target, Common/ThinGeometryCoverage.glslh): the writer
// writes the view's depth, so it says what material won it.
#include <Common/ThinGeometryCoverage.glslh>
layout( location = 5 ) out float oThinGeometryCoverage;
// The stored roughness is floored, then widened by the shading normal's spread across the pixel (the specular AA).
#include <Common/SpecularAA.glslh>

#if defined( DESERT_SURFACE_PASS_VisibilityResolve )
// THE RESOLVE'S NORMAL FOOTPRINT: a quad of the full-screen resolve spans several blades, so dFdx of its normal is
// not the surface's (as its UV0 gradient, SurfaceTypes.glslh g_DesertVisibilityUVdx). Pass_VisibilityResolve.glslh
// sets the analytic change of the TBN it interpolates across one pixel in x and y (each unit column's turn, through
// the barycentrics' derivative at the pixel), and the shading normal's change is that frame turn applied to the
// pixel's own tangent normal: the mesh's curvature across the pixel, which on a blade narrower than the pixel is
// the whole of its width's turn.
mat3 g_DesertVisibilityTBNdx = mat3( 0.0 );
mat3 g_DesertVisibilityTBNdy = mat3( 0.0 );
#endif

// The shading normal @p N's change across one pixel in x (@p dNdx) and y (@p dNdy), for the specular AA.
void DesertSurfaceNormalFootprint( const SurfaceInput i, const SurfaceOutput s, const vec3 N, out vec3 dNdx,
                                   out vec3 dNdy )
{
#if defined( DESERT_SURFACE_PASS_VisibilityResolve )
    // N = normalize( TBN t ): its derivative is the frame's turn of t with the part along N removed, over |TBN t|.
    const float frameLength = max( length( i.TBN * s.Normal ), 1.0e-4 );
    const vec3  turnX       = g_DesertVisibilityTBNdx * s.Normal;
    const vec3  turnY       = g_DesertVisibilityTBNdy * s.Normal;
    dNdx                    = ( turnX - N * dot( N, turnX ) ) / frameLength;
    dNdy                    = ( turnY - N * dot( N, turnY ) ) / frameLength;
#else
    dNdx = dFdx( N );
    dNdy = dFdy( N );
#endif
}

// @p castsContactShadow: the primitive's contact-shadow cast (UE bCastContactShadow), as its draw states it.
void DesertWriteGBuffer( const SurfaceInput i, const SurfaceOutput s, const vec4 clip, const vec4 prevClip,
                         const float objectMoved, const bool castsContactShadow )
{
    vec3  N         = DesertSurfaceWorldNormal( i, s );
    vec3  baseColor = s.BaseColor;
    float roughness = s.Roughness;
    float metallic  = s.Metallic;
    float ao        = s.AmbientOcclusion;
#ifdef DESERT_SURFACE_DBUFFER_RECEIVE
    // The frame's decals over this surface (UE ApplyDBufferData), before the specular AA widens the roughness.
    // No DBuffer on this view (no decal pass, or the card capture): no fetch at all.
    if ( DesertViewHasDBuffer() )
        DesertApplyDBuffer( DesertReadDBuffer( ivec2( gl_FragCoord.xy ) ), baseColor, N, roughness, metallic, ao );
#endif
    vec3 dNdx, dNdy;
    DesertSurfaceNormalFootprint( i, s, N, dNdx, dNdy );
    oGBufferA = vec4( baseColor, metallic );
    oGBufferB = vec4( N, DesertSpecularAA( max( roughness, kDesertMinRoughness ), dNdx, dNdy ) );
    const uvec2 word =
         DesertPackShadingWord( DESERT_SHADING_MODEL_INDEX, s.SampledTextureCount, s.Specular,
                                DesertPayload( s.CustomData0, s.CustomData1, s.CustomData2, s.CustomData3 ) );
    // The material's sun-shadow receive, then the primitive's contact-shadow cast.
    oGBufferShadingWord = DesertMarkContactShadowCast(
         DesertMarkSunSelfShadow( DesertMarkSunShadowReceive( word, s.ReceiveSunShadows ), s.SunSelfShadow ),
         castsContactShadow );
    oGBufferEmissive      = vec4( s.Emissive, ao );
    oVelocity             = DesertVelocity( clip, prevClip, objectMoved );
    oThinGeometryCoverage = DesertThinGeometryCoverage( DESERT_SHADING_MODEL_INDEX );
}
#endif
