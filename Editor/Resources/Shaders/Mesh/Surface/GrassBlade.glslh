// WHERE A GRASS BLADE IS - one statement shared by the raster's GrassBlade vertex path (Vertex_GrassBlade.glslh)
// and the ray-tracing blade compute (Programs/Grass/GrassBladeRayTracingVertices.shader), so the blade a ray hits
// is the blade the camera drew (as Programs/Terrain/LandscapeVertexEval.glslh is the landscape's). Ghost of
// Tsushima (GDC 2021 "Procedural Grass in Ghost of Tsushima"): the blade is a curve built from a few numbers.
#ifndef GRASS_BLADE_GLSLH
#define GRASS_BLADE_GLSLH

#include <Common/FoliageWind.glslh>

// The most cards a blade variety draws from (Assets::Serialization::kGrassBladeMaxCards).
#define GRASS_BLADE_MAX_CARDS 8

// Mirrors Graphic::System::GrassBladeShapeGpu (GrassBladeRayTracing.hpp), std430: a variety's shape. The blade's
// look is its material's (a scanned blade atlas: albedo, normal, ORM, opacity); the shape carries only where on
// that atlas each of its cards is and how the strip stands, bends and sways.
struct GrassBladeShapeData
{
    vec4 Size;                         // Height cm, Stiffness, Curvature, card count
    vec4 Bend;                         // CurvatureSpread, BendSpread, TrampledLength
    vec4 Cards[GRASS_BLADE_MAX_CARDS]; // atlas rect: u0, v tip, u1, v root (texture space, v down the image)
    // The view's visibility buffer (GRASS-VIS, Common/VisibilityBuffer.glslh): x = the variety's first raster-stream
    // row (instance i is row x + i), y = the strip's level-0 segments, z = its bucket (= strip level) count.
    uvec4 Visibility;
    uvec4 BucketFirst[2]; // the first instance of bucket b < 8, [b / 4][b % 4] (GrassRenderer's bucket table)
    uvec4 Lists;          // x = the camera list's first slot in the shared ids pool (CPU-GRASS-POOL-5)
    // FPS-GRASS-HULL: GrassBladeShapeGpu goes on with HullTexels and Hull[128] (the cards' cooked hulls). They are
    // NOT members here - a function takes this struct by value, and the hull is read only where the raster's
    // strip is placed: the raster's buffer blocks declare them after it (Mesh/Surface/GrassBladeHull.glslh).
};

// The strip level instance @p instance was drawn with (GrassGenerate's bucket = GrassRenderer::BladeStrip's
// submesh) and its segments: level 0 has Visibility.y, each next one half the last, down to one.
uint BladeLevelSegments( GrassBladeShapeData shape, uint instance )
{
    uint segments = max( shape.Visibility.y, 1u );
    for ( uint b = 1u; b < min( shape.Visibility.z, 8u ); ++b )
    {
        if ( instance < shape.BucketFirst[b / 4u][b % 4u] )
            break;
        segments = max( 1u, segments / 2u );
    }
    return segments;
}

// Triangle @p triangle of a level of @p segments segments (GrassBladeRayTracing.cpp MakeGrassBladeStripLevel: rows
// of two vertices (side -1, +1) at t = row / segments, triangles (a, a+1, a+2) and (a+1, a+3, a+2), a = 2 x row):
// its three vertices' (side, t), in the order the strip's index buffer names them.
void BladeTriangleCorners( uint segments, uint triangle, out vec2 c0, out vec2 c1, out vec2 c2 )
{
    const float row  = float( triangle >> 1u );
    const float s    = float( max( segments, 1u ) );
    const float t0   = row / s;
    const float t1   = ( row + 1.0 ) / s;
    if ( ( triangle & 1u ) == 0u )
    {
        c0 = vec2( -1.0, t0 );
        c1 = vec2( 1.0, t0 );
        c2 = vec2( -1.0, t1 );
    }
    else
    {
        c0 = vec2( 1.0, t0 );
        c1 = vec2( 1.0, t1 );
        c2 = vec2( -1.0, t1 );
    }
}

// The card a blade draws: its colour draw (instance column 0's w) picks one of the variety's cards, uniformly.
uint BladeCardIndex( GrassBladeShapeData shape, float draw )
{
    const uint count = max( uint( shape.Size.w ), 1u );
    return min( uint( draw * float( count ) ), count - 1u );
}
vec4 BladeCard( GrassBladeShapeData shape, float draw )
{
    return shape.Cards[BladeCardIndex( shape, draw )];
}

// The card's texture coordinate at @p side across (-1..1) and height share @p t (0 root, 1 tip).
vec2 BladeCardUV( vec4 card, float side, float t )
{
    return vec2( mix( card.x, card.z, 0.5 + 0.5 * side ), mix( card.w, card.y, t ) );
}

// The strip's width (cm) for the instance matrix @p model: as wide as its card is, at the blade's height - the scan
// keeps its proportions, and the card's opacity cuts the blade's outline (its taper, its ragged edge) out of the
// strip (or the card's cooked hull narrows it first, Mesh/Surface/GrassBladeHull.glslh).
float BladeWidth( GrassBladeShapeData shape, mat4 model )
{
    const vec4 card = BladeCard( shape, model[0].w );
    return shape.Size.x * ( card.z - card.x ) / max( card.w - card.y, 1e-4 ) * length( model[0].xyz );
}

struct BladePoint
{
    vec3 Position;
    vec3 Along; // d(position)/dt, up the blade
    vec3 Right; // unit, across the blade
};

// THE BLADE'S CURVE - one statement for the raster's BladeAt and the ray tracer's trampled TLAS rows
// (DEFORM-RT-TRAMPLE, Programs/RayTracing/RayTracingGpuInstances.shader). For the instance matrix @p model
// (GrassGenerate: root in column 3, the width axis in column 0 scaled by the width multiplier, the up and forward
// axes in columns 1 and 2 scaled by the height multiplier, the per-blade draws in the columns' w) and the variety's
// @p size, @p bend (GrassBladeShapeData's Size, Bend) the blade is Root + Up * (Rise * t) + Tip * t^Bend + across:
// a curve from the root whose tip leans forward by the curvature and sways with the wind, its upright reach
// shortened so the blade keeps its length as it bends. The lean grows as t^bend: 2 is an even arc, a larger power a
// straight stalk that bends near its tip (GoT's per-blade bend). Without wind the curve is affine in the matrix's
// columns: the blade of an identity matrix, transformed by the matrix, is the blade of that matrix (the ray
// tracer's shared BLAS).
// @p localAir is the scene's local wind at the root (Common/LocalWind.glslh LocalWindXZ of vec3( model[3] )).
// @p trample is the view's deformation field at the root (DEFORM-GRASS, Deformation/DeformationFieldTrample.glslh
// DeformationFieldTrampleFrom: xy the world X, Z direction a contact pressed the grass, z how flat, 0..1); (0, 0, 0)
// where nothing pressed it. A press with no direction (xy 0) lays the blade along its own forward axis: the ray
// tracer's pressed BLASes (GrassBladeRayTracing.hpp), which its TLAS rows turn to the field's direction.
struct BladeCurve
{
    vec3  Root;
    vec3  Up;    // unit
    vec3  Right; // unit, across the blade
    vec3  Tip;   // the tip's offset beyond the upright rise
    float Rise;  // the upright reach (cm)
    float Bend;  // the power t is raised to along Tip
};
BladeCurve BladeCurveAt( vec4 size, vec4 bend, mat4 model, vec4 windA, vec4 windB, vec4 gust, vec2 localAir,
                         vec3 trample )
{
    const float heightK = length( model[1].xyz );
    const vec3  up      = model[1].xyz / max( heightK, 1e-6 );
    const vec3  forward = model[2].xyz / max( length( model[2].xyz ), 1e-6 );
    const float height  = size.x * heightK;

    BladeCurve c;
    c.Root  = vec3( model[3] );
    c.Up    = up;
    c.Right = model[0].xyz / max( length( model[0].xyz ), 1e-6 );
    // The rest lean: the variety's curvature, varied per blade by CurvatureSpread either way. The bend's power
    // draws from the curvature draw's low 16 bits (it is a 24-bit fraction, so they are independent of the
    // top bits the lean mostly reads).
    const float lean = size.z * ( 1.0 + bend.x * ( 2.0 * model[1].w - 1.0 ) );
    // A pressed blade is a straight stalk laid from its root (the power goes to 1 as it is pressed flat).
    const float press = clamp( trample.z, 0.0, 1.0 );
    c.Bend            = mix( 2.0 + 3.0 * bend.y * fract( model[1].w * 256.0 ), 1.0, press );
    // DEFORM-LOOK-5 (Ghost of Tsushima, GDC 2021: a trampled blade bends to the ground AND its visible height
    // shrinks, so the ground shows between the laid blades): the blade's length goes from its height standing to
    // the variety's TrampledLength share of it pressed flat - the same field value as the bend, one statement for
    // every pass. A press of 0 keeps the length exactly (share 1): the untouched blade.
    const float share = mix( 1.0, bend.z, press );
    const float span  = height * share;
    vec3        tip   = forward * ( span * lean );
    // The wind at the tip, as a mesh vertex at the blade's height would sway, less what the stiffness resists
    // (a shortened blade sways by its share).
    tip += FoliageWindOffset( vec3( 0.0, height, 0.0 ), c.Root, windA, windB, gust, localAir ) *
           ( ( 1.0 - size.y ) * share );
    // THE TRAMPLE (DEFORM-GRASS; UE/Fortnite interactive grass, Ghost of Tsushima's trampled blades): the press lays
    // the tip along the field's direction, across the blade's own up (a blade on a slope lies along the slope), and
    // presses its wind sway out with it; a flat blade reaches farther than the standing cap (0.95 -> 0.995: its rise
    // falls to a tenth of its length) - it lies on the ground at its shortened length.
    if ( press > 0.0 )
    {
        vec3 lie = vec3( trample.x, 0.0, trample.y );
        lie -= up * dot( lie, up );
        lie = dot( lie, lie ) > 1e-6 ? normalize( lie ) : forward;
        tip = mix( tip, lie * span, press );
    }
    const float reach = min( length( tip ) / max( span, 1e-3 ), mix( 0.95, 0.995, press ) );
    c.Tip             = tip;
    c.Rise            = span * sqrt( 1.0 - reach * reach );
    return c;
}

// The point of curve @p c at height share @p t, @p side across a strip @p width wide: the one expression BladeAt
// and the resolve's setup record (BladeSetupCurve) place a blade's point with.
BladePoint BladeCurvePoint( BladeCurve c, float width, float side, float t )
{
    BladePoint p;
    p.Right    = c.Right;
    p.Position = c.Root + c.Up * ( c.Rise * t ) + c.Tip * pow( t, c.Bend ) + c.Right * ( 0.5 * width * side );
    p.Along    = c.Up * c.Rise + c.Tip * ( c.Bend * pow( t, c.Bend - 1.0 ) );
    return p;
}

// The blade of @p shape at height share @p t, @p side across, for the instance matrix @p model: BladeCurveAt's
// curve, as wide as the instance's card (BladeWidth).
BladePoint BladeAt( GrassBladeShapeData shape, mat4 model, float side, float t, vec4 windA, vec4 windB, vec4 gust,
                    vec2 localAir, vec3 trample )
{
    const BladeCurve c = BladeCurveAt( shape.Size, shape.Bend, model, windA, windB, gust, localAir, trample );
    return BladeCurvePoint( c, BladeWidth( shape, model ), side, t );
}

// THE BLADE'S SETUP RECORD (FPS-GRASS-RESOLVE-2; Ghost of Tsushima, GDC 2021: each visible blade is evaluated once
// into a compact record, shading reads it). Programs/Grass/GrassBladeSetup.shader writes one per drawn blade of
// the camera's list, at its raster-stream row, from the raster's own BladeCurveAt now and one wind step before;
// Mesh/Surface/Pass_VisibilityResolve.glslh rebuilds the pixel's triangle from it. The two curves share the root,
// the frame and the power (the press is the same field cell, the wind moves only the tip): only the tip and the
// rise differ. Mirrors GrassRenderer kBladeSetupRecordBytes (96), std430.
struct GrassBladeSetupData
{
    vec4  Root;    // xyz the root, w the rise now
    vec4  Up;      // xyz unit up, w the curve's power (Bend)
    vec4  Right;   // xyz unit across, w the strip's width (BladeWidth)
    vec4  Tip;     // xyz the tip now, w the rise one wind step before
    vec4  PrevTip; // xyz the tip one wind step before, w the clump draw (the instance's column 2 w, UV1.x)
    uvec4 Strip;   // x the card (BladeCardIndex), y the strip level's segments (BladeLevelSegments), zw 0
};

GrassBladeSetupData BladeSetupOf( BladeCurve now, BladeCurve before, float width, uint card, uint segments,
                                  float clumpDraw )
{
    GrassBladeSetupData s;
    s.Root    = vec4( now.Root, now.Rise );
    s.Up      = vec4( now.Up, now.Bend );
    s.Right   = vec4( now.Right, width );
    s.Tip     = vec4( now.Tip, before.Rise );
    s.PrevTip = vec4( before.Tip, clumpDraw );
    s.Strip   = uvec4( card, segments, 0u, 0u );
    return s;
}

// The record's curve now (@p previous false) or one wind step before.
BladeCurve BladeSetupCurve( GrassBladeSetupData s, bool previous )
{
    BladeCurve c;
    c.Root  = s.Root.xyz;
    c.Up    = s.Up.xyz;
    c.Right = s.Right.xyz;
    c.Tip   = previous ? s.PrevTip.xyz : s.Tip.xyz;
    c.Rise  = previous ? s.Tip.w : s.Root.w;
    c.Bend  = s.Up.w;
    return c;
}

// THE RAY TRACER'S BLADE INSTANCE (GrassBladeRayTracing.hpp): the identity instance with the median per-blade draws
// every shared and pressed BLAS is shaped for (GrassBladeRayTracingVertices.shader) and every trampled TLAS row is
// fitted against (RayTracingGpuInstances.shader). Column 0's w: the median card draw; column 1's w: the median
// curvature draw - a lean draw of 1/2 (the variety's Curvature, CurvatureSpread cancels to 1/256 of itself) and a
// bend draw of 1/2 (its low bits: fract(w * 256) = 1/2).
const float kGrassBladeRayTracingCardDraw      = 0.5;
const float kGrassBladeRayTracingCurvatureDraw = 0.5 + 0.5 / 256.0;
mat4        GrassBladeRayTracingModel()
{
    return mat4( vec4( 1.0, 0.0, 0.0, kGrassBladeRayTracingCardDraw ),
                 vec4( 0.0, 1.0, 0.0, kGrassBladeRayTracingCurvatureDraw ), vec4( 0.0, 0.0, 1.0, 0.0 ),
                 vec4( 0.0, 0.0, 0.0, 1.0 ) );
}
// The press the ray tracer's blade BLAS @p step of @p steps is shaped for: step 0 the standing blade (0), step
// @p steps flat (1).
float GrassBladeRayTracingPress( uint step, uint steps )
{
    return steps > 0u ? float( min( step, steps ) ) / float( steps ) : 0.0;
}

// The blade's shading normal at @p side: its face normal, tilted across its width so the flat strip shades as a
// rounded blade (GoT).
vec3 BladeNormal( BladePoint blade, float side )
{
    const vec3 along = normalize( blade.Along );
    const vec3 face  = normalize( cross( blade.Right, along ) );
    return normalize( face + blade.Right * ( 0.45 * side ) );
}

#endif
