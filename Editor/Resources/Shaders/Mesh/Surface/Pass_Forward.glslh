// Surface cell pass: forward colour. Unlit BaseColor + Emissive until SURF1b brings the PBR lighting here.
DESERT_SURFACE_VARYINGS( in )

layout( location = 0 ) out vec4 o_Color;

void main()
{
    const SurfaceOutput s =
         EvaluateSurface( DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0 ) );
    DESERT_SURFACE_CLIP( s );
    o_Color = vec4( s.BaseColor + s.Emissive, 1.0 );
}
