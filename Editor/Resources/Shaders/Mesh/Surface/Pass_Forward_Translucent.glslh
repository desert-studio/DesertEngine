// Surface cell pass: forward TRANSLUCENT (UE's translucency base pass) — the Forward cell of a `BlendMode
// Translucent` template. It is drawn by MeshRenderer::RenderGlassManual over the composited opaque scene and
// nowhere else: the renderer sends an object here because its material's TEMPLATE is translucent
// (ShaderProgramMeta::Blend), never because of a parameter value. The surface is clear glass: the scene behind
// it (SceneColorTexture, bent by the normal and s.Refraction) tinted by s.BaseColor, mixed by Schlick Fresnel into
// the reflection (the front layer's traced one where this fragment is the front layer, elsewhere the view's
// reflection environment: the captures over the sky, or over the radiance cache where the view traces GI -
// Mesh/Surface/ViewIndirect.glslh), plus the specular hotspot of the sun (under the cloud shadow) and of the local
// lights: under Shadows Stochastic the MegaLights volume's, otherwise every point and spot light of the pixel's
// froxel under its shadow (Mesh/ForwardLocalLights.glslh), as the opaque forward cells shade them. Written opaque:
// the refracted scene already carries the background; the highlights also lose their lights' contact shadows. It
// declares no cascade maps; the slots keep the numbers the rest of the mesh family uses.
DESERT_SURFACE_VARYINGS( in )

layout( location = 0 ) out vec4 oColor;
#ifdef DESERT_SURFACE_RESPONSIVE_AA
// The scene target's responsive-AA slot (Graphic::kSceneTargetResponsiveAASlot): this surface covers the pixel
// whole (it is written opaque), so the temporal resolve takes UE's responsive 1/4 of the current frame there - the
// refracted scene behind glass moves with no velocity of its own.
layout( location = 2 ) out vec4 oResponsiveAA;
#endif

// The scene directional light (struct DirectionLight + DirectionLightsUB, binding 14): GENERATED from
// Engine/Graphic/ShaderProtocols/LightLayout.hpp by Tools/ShaderProtocolGen.
#include <Common/DirectionLightsUB.glslh>

// Shared sampler states (UE's shared samplers): each scene input below is a separate texture read through one of
// these, bound by the pass with the inputs; 13 and 14, as in Pass_Forward.glslh.
// The repeat state is numbered by the program build (`Uniform sampler`, ShaderMapBuild AssignSharedSamplerBindings):
// a fixed 13 collided with the grass blade path's GrassBladeShape (Vertex_GrassBlade.glslh) in GrassBlade.Forward.
// The clamp state too: a fixed 14 collided with the generated DirectionLightsUB (Engine/Graphic/ShaderProtocols/
// LightLayout.hpp, kDirectionLightsUBBlock), which every lit program includes (TERRAIN-BIND14).
Uniform sampler LinearRepeatSampler;
Uniform sampler LinearClampSampler;
// THE MEGALIGHTS TRANSLUCENCY VOLUME (UE MegaLights' translucency volume, Shadows Stochastic): the local lights'
// highlights on the glass, shadowed by MegaLights' traced samples. Off (any other Shadows method) it reads as no
// light: the glass has no other local light.
#include <Common/MegaLightsVolume.glslh>

// The reflection at grazing angles is the forward passes' reflection environment (Mesh/AmbientIBL.glslh
// DesertSampleViewAmbient): its sky remainder is the specular cube, and the captures over it are normalised by the
// view's diffuse estimator - the irradiance cube where the view has no radiance cache. The BRDF LUT is read by the
// same sampling call.
layout( binding = 8 ) uniform textureCube EnvironmentSpecularTexture;
#define EnvironmentSpecularTexture samplerCube(EnvironmentSpecularTexture, LinearClampSampler)
layout( binding = 9 ) uniform textureCube EnvironmentIrradianceTexture;
#define EnvironmentIrradianceTexture samplerCube(EnvironmentIrradianceTexture, LinearClampSampler)
layout( binding = 10 ) uniform texture2D BrdfLutTexture;
#define BrdfLutTexture sampler2D(BrdfLutTexture, LinearClampSampler)
#include <Generated/Environment/SkyLook.glslh>
layout( binding = 22 ) uniform SkyLookUB
{
    DESERT_SkyLookGPU_MEMBERS
}
skyLook;
#include <Common/SkyLook.glslh>

// A copy of the composited opaque scene, for refraction (bound by the translucency pass only).
layout( binding = 19 ) uniform texture2D SceneColorTexture;
#define SceneColorTexture sampler2D(SceneColorTexture, LinearRepeatSampler)

// The front layer's traced reflection (Reflections.TranslucentFrontLayer), shared with the water.
#include <Mesh/Surface/FrontLayerReflection.glslh>
// The front layer's traced refraction (Translucency.Refraction HardwareTraced), tested against the same depth.
#include <Mesh/Surface/TranslucencyRefraction.glslh>
#include <Common/ReconstructPosition.glslh>

// The cloud layer's shadow on the world: it takes the sun's highlight away with it.
layout( binding = 20 ) uniform texture2D CloudShadowMapTexture;
#define CloudShadowMapTexture sampler2D(CloudShadowMapTexture, LinearRepeatSampler)
#include <Generated/Clouds/CloudShadow.glslh>
layout( binding = 21 ) uniform CloudShadowUB
{
    DESERT_CloudShadowUniforms_MEMBERS
};

#include <Common/CloudShadowReceiver.glslh>

// The water's caustics on the sun under a water body (Common/WaterCaustics.glslh; SceneViewInputs::WaterCausticsMap /
// WaterCausticsFrame, bound by name). Set 1 after ViewIndirect's 0..6.
layout( set = 1, binding = 7 ) uniform texture2D WaterCausticsTexture;
#define WaterCausticsTexture sampler2D(WaterCausticsTexture, LinearRepeatSampler)
#include <Generated/Water/WaterCaustics.glslh>
layout( std430, set = 1, binding = 8 ) readonly buffer WaterCausticsFrameUB
{
    DESERT_WaterCausticsFrameHead_MEMBERS
    WaterCausticsBody WaterCausticsBodies[];
};
#define WATER_CAUSTICS_FRAME
#include <Common/WaterCaustics.glslh>

// The sun's contact shadow takes its highlight away too (Common/ContactShadow.glslh, through the opaque scene depth,
// SceneDepthTexture of Mesh/Surface/SurfaceTypes.glslh). The block is the view's one ShadowUB (Mesh/ShadowUB.glslh,
// SceneResources::ShadowUBData); the glass reads only its contact-shadow members.
#include <Mesh/ShadowUB.glslh> // the view's ShadowUB, binding 7 (SceneResources::ShadowUBData)
// The hit texel's caster bit: the opaque scene's shading word (SceneShadingWordTexture, SurfaceTypes.glslh).
#include <ShadingModels/ShadingModelContract.glslh>
#define CONTACT_SHADOW_DEPTH        SceneDepthTexture
#define CONTACT_SHADOW_VP           cameraUB.JitteredViewProjection
#define CONTACT_SHADOW_INV_VP       cameraUB.InvJitteredViewProjection
#define CONTACT_SHADOW_SHADING_WORD SceneShadingWordTexture
#include <Common/ContactShadow.glslh>
// The view's fog at this fragment's own depth (the opaque scene behind it, and so the refraction, is already fogged).
#include <Mesh/Surface/SceneFog.glslh>

// The point and spot lights, through the same statement the opaque forward cells shade them with.
#include <Mesh/ForwardLocalLights.glslh>

// Glass is smooth: a light's specular is a tight hotspot.
float GlassHotspot( vec3 N, vec3 V, vec3 L )
{
    return pow( max( dot( N, normalize( V + L ) ), 0.0 ), 128.0 );
}

#include <Mesh/Surface/ViewIndirect.glslh>
// The split-sum's Fresnel (Mesh/AmbientIBL.glslh EvaluateAmbientIBL) is the BRDF's.
#include <Mesh/BRDF.glslh>
#include <Mesh/AmbientIBL.glslh>

void main()
{
    const SurfaceInput i =
         DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, DESERT_SURFACE_VARYING_TBN, v_Surface.UV1,
                              DESERT_SURFACE_VARYING_VERTEX_COLOR, gl_FrontFacing );
    const SurfaceOutput s = EvaluateSurface( i );

    const vec3  N   = DesertSurfaceWorldNormal( i, s );
    const vec3  V   = normalize( i.CameraPosition - i.WorldPosition );
    const float ior = max( s.Refraction, 1.0 );

    // Schlick Fresnel with the IOR-derived normal reflectance (glass F0 ~0.04, water ~0.02).
    const float f0      = pow( ( ior - 1.0 ) / ( ior + 1.0 ), 2.0 );
    const float fresnel = f0 + ( 1.0 - f0 ) * pow( 1.0 - max( dot( N, V ), 0.0 ), 5.0 );

    // Sun specular highlight (glass is smooth -> a tight hotspot).
    const vec3 L    = normalize( -directionLights.directionLights.Direction.xyz );
    vec3       spec = vec3( GlassHotspot( N, V, L ) * directionLights.directionLights.ColorIntensity.a *
                            CloudShadowFactor( v_Surface.WorldPosition ) * WaterCausticsFactor( v_Surface.WorldPosition ) *
                            ContactShadowFactor( v_Surface.WorldPosition, N, L, SunContactShadow,
                                                 /*not a subsurface receiver*/ -1.0 ) );
    // ...and each point and spot light's, by its radiance and its shadow.
    // (Under Shadows Stochastic the MegaLights volume lights them instead, below.)
    if ( !MegaLightsVolumeOn() )
    {
        const ForwardLightList lights = ForwardLightListAt( gl_FragCoord.xy, v_Surface.WorldPosition );
        for ( uint j = 0u; j < lights.Count; j++ )
        {
            const DesertLight local = ForwardLocalLightAt( lights, j, v_Surface.WorldPosition, N, -1.0 );
            spec += GlassHotspot( N, V, local.L ) * local.Radiance * local.Shadow;
        }
    }

    // THE SCREEN-SPACE TIER (Translucency.Refraction ScreenSpace): the view ray bent by Snell at this interface,
    // followed as far as the opaque scene straight behind the fragment lies, projected back onto the scene copy. A
    // bent texel whose opaque surface stands IN FRONT of the glass is not behind it: the straight-through texel
    // answers there, as off the screen. Tinted by the surface colour.
    const vec2  screenUV   = gl_FragCoord.xy / vec2( textureSize( SceneColorTexture, 0 ) );
    const ivec2 depthSize  = textureSize( SceneDepthTexture, 0 );
    const float behindDev  = texelFetch( SceneDepthTexture, min( ivec2( gl_FragCoord.xy ), depthSize - 1 ), 0 ).r;
    const vec3  behindPos  = ReconstructWorldPosition( screenUV, behindDev, cameraUB.InvJitteredViewProjection );
    const vec3  bentDir    = refract( -V, N, 1.0 / ior );
    const vec3  bentPos    = i.WorldPosition + bentDir * distance( i.WorldPosition, behindPos );
    const vec4  bentClip   = cameraUB.JitteredViewProjection * vec4( bentPos, 1.0 );
    vec2        refractUV  = screenUV;
    if ( bentClip.w > 0.0 && dot( bentDir, bentDir ) > 0.0 )
    {
        const vec2 bentNdc = bentClip.xy / bentClip.w;
        const vec2 bentUV  = vec2( bentNdc.x * 0.5 + 0.5, 0.5 - bentNdc.y * 0.5 );
        // Reversed-Z: a larger device depth is nearer the camera than this fragment.
        if ( all( greaterThanEqual( bentUV, vec2( 0.0 ) ) ) && all( lessThan( bentUV, vec2( 1.0 ) ) ) &&
             texelFetch( SceneDepthTexture, ivec2( bentUV * vec2( depthSize ) ), 0 ).r <= gl_FragCoord.z )
            refractUV = bentUV;
    }
    const vec3 screenRefracted = textureLod( SceneColorTexture, refractUV, 0.0 ).rgb * s.BaseColor;
    // THE TRACED TIER (HardwareTraced) where this fragment is the front layer: the trace's transmittance already holds
    // the tint of every interface it crossed; where it did not answer (a = 0) the screen tier does.
    const vec4 traced    = DesertTranslucencyRefraction( gl_FragCoord.xy, gl_FragCoord.z );
    const vec3 refracted = mix( screenRefracted, traced.rgb, traced.a );

    // The reflection at grazing edges, of clear glass (a mirror: roughness 0, which a capture never normalises);
    // Fresnel mixes refraction (centre) into reflection (edge).
    const DesertSurface surface = DesertMakeSurface( i.WorldPosition, N, V, s.BaseColor, 0.0, 0.0, s.Specular );
    vec3 envRefl = DesertSampleViewAmbient( surface, vec3( 0.0 ), 1.0, gl_FragCoord.xy ).Prefiltered;
    // The traced reflection where this fragment is the front layer (a glass behind the nearest one keeps the
    // environment): it answers its share of the lobe, the environment the rest.
    envRefl = DesertComposeTracedReflection( DesertFrontLayerTracedReflection( gl_FragCoord.xy, gl_FragCoord.z ),
                                             envRefl );

    // The local lights' hotspot under Shadows Stochastic: the volume's dominant light with the same tight lobe as the
    // sun's (its isotropic rest has no highlight to give clear glass). Otherwise the froxel's lights are in `spec`.
    vec3 localSpec = vec3( 0.0 );
    if ( MegaLightsVolumeOn() )
    {
        const MegaLightsVolumeLighting local = MegaLightsVolumeLightingAt( gl_FragCoord.xy, v_Surface.WorldPosition, N );
        localSpec = GlassHotspot( N, V, local.L ) * local.Radiance;
    }

    // Fogged as UE fogs a translucent surface, at its own depth: the surface's own light (the sky's reflection
    // weighted by its Fresnel coverage, the hotspots, the emissive) is attenuated by the fog in front of it and the
    // reflection's coverage gains the fog's inscattering; the refracted scene is the fogged scene copy already (the
    // opaque fog ran before the copy), so it is not fogged a second time. `refracted` is read from this frame's
    // scene colour, already pre-exposed, as is the fog's inscattering (FogGates.z); only the terms lit here are
    // scaled.
    const float preExposure = cameraUB.PreExposure;
    const vec4  fog         = DesertSceneFog( v_Surface.WorldPosition );
    const vec3  ownLight    = ( envRefl * fresnel + spec + localSpec + s.Emissive ) * preExposure;
    oColor = vec4( refracted * ( 1.0 - fresnel ) + ownLight * fog.a + fog.rgb * fresnel, 1.0 );
#ifdef DESERT_SURFACE_RESPONSIVE_AA
    oResponsiveAA = vec4( 1.0, 0.0, 0.0, 1.0 );
#endif
}
