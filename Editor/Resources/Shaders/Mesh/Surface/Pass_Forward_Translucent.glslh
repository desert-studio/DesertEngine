// Surface cell pass: forward TRANSLUCENT (UE's translucency base pass) — the Forward cell of a `BlendMode
// Translucent` template. It is drawn by MeshRenderer::RenderGlassManual over the composited opaque scene and
// nowhere else: the renderer sends an object here because its material's TEMPLATE is translucent
// (ShaderProgramMeta::Blend), never because of a parameter value. The surface is clear glass: the scene behind
// it (SceneColorTexture, bent by the normal and s.Refraction) tinted by s.BaseColor, mixed by Schlick Fresnel into
// the reflection (the front layer's traced one where this fragment is the front layer, elsewhere the view's
// reflection environment: the captures over the sky, or over the radiance cache where the view traces GI -
// Mesh/Surface/ViewIndirect.glslh), plus the sun's specular hotspot under the cloud shadow and, under Shadows
// Stochastic, the local lights' hotspot from the MegaLights volume. Written opaque: the refracted scene already
// carries the background; the highlight also loses the sun's contact shadow. It declares what it reads and nothing
// else (no cascade maps, no light grid); the slots keep the numbers the rest of the mesh family uses.
DESERT_SURFACE_VARYINGS( in )

layout( location = 0 ) out vec4 oColor;
#ifdef DESERT_SURFACE_RESPONSIVE_AA
// The scene target's responsive-AA slot (Graphic::kSceneTargetResponsiveAASlot): this surface covers the pixel
// whole (it is written opaque), so the temporal resolve takes UE's responsive 1/4 of the current frame there - the
// refracted scene behind glass moves with no velocity of its own.
layout( location = 2 ) out vec4 oResponsiveAA;
#endif

struct DirectionLight
{
    vec4 Direction;      // xyz = normalized direction
    vec4 ColorIntensity; // rgb = color, a = intensity
};

layout( binding = 3 ) uniform DirectionLightsUB
{
    DirectionLight directionLights;
}
directionLights;

// Shared sampler states (UE's shared samplers): each scene input below is a separate texture read through one of
// these, bound by the pass with the inputs; 13 and 14, as in Pass_Forward.glslh.
layout( binding = 13 ) uniform sampler LinearRepeatSampler;
layout( binding = 14 ) uniform sampler LinearClampSampler;
// THE MEGALIGHTS TRANSLUCENCY VOLUME (UE MegaLights' translucency volume, Shadows Stochastic): the local lights'
// highlights on the glass, shadowed by MegaLights' traced samples. Off (any other Shadows method) it reads as no
// light: the glass has no other local light.
#include <Common/MegaLightsVolume.glslh>

// The reflection at grazing angles is the forward passes' reflection environment (Mesh/AmbientIBL.glslh
// DesertSampleViewAmbient): its sky remainder is the specular cube, and the captures over it are normalised by the
// view's diffuse estimator - the irradiance cube where the view has no radiance cache. The BRDF LUT is read by the
// same sampling call.
layout( binding = 8 ) uniform textureCube EnvironmentSpecularTexture;
#define EnvironmentSpecularTexture samplerCube(EnvironmentSpecularTexture, LinearClampSampler)
layout( binding = 9 ) uniform textureCube EnvironmentIrradianceTexture;
#define EnvironmentIrradianceTexture samplerCube(EnvironmentIrradianceTexture, LinearClampSampler)
layout( binding = 10 ) uniform texture2D BrdfLutTexture;
#define BrdfLutTexture sampler2D(BrdfLutTexture, LinearClampSampler)
layout( binding = 22 ) uniform SkyLookUB
{
    vec4 YawCosSin; // xy = (cos yaw, sin yaw) — Graphic::SkyLookGPU
    vec4 Gain;      // rgb = tint * intensity
}
skyLook;
#include <Common/SkyLook.glslh>

// A copy of the composited opaque scene, for refraction (bound by the translucency pass only).
layout( binding = 19 ) uniform texture2D SceneColorTexture;
#define SceneColorTexture sampler2D(SceneColorTexture, LinearRepeatSampler)

// THE FRONT LAYER'S REFLECTION (UE FrontLayerTranslucencyShared.ush, Reflections.TranslucentFrontLayer): the nearest
// translucent surface of each pixel wrote its normal, roughness and depth ("Translucency: Front Layer G-buffer"), and
// the opaque surfaces' tracer and denoiser reflected it ("Translucency: Front Layer Reflections"). rgb = the
// reflected radiance, a = how much of it the trace answered (the sky's cube fills the rest, as the deferred composite
// fills SSR's, Mesh/AmbientIBL.glslh DesertComposeTracedReflection). Both are the graph's black texture when the
// frame has no front layer: a = 0 and a depth that matches no surface, so the sky alone reflects.
layout( binding = 11 ) uniform texture2D FrontLayerReflectionTexture;
#define FrontLayerReflectionTexture sampler2D(FrontLayerReflectionTexture, LinearClampSampler)
layout( binding = 12 ) uniform texture2D FrontLayerDepthTexture;
#define FrontLayerDepthTexture sampler2D(FrontLayerDepthTexture, LinearClampSampler)
// UE r.FrontLayerTranslucency.DepthThreshold: a fragment IS the front layer when its device depth is within this many
// float ULPs of the front layer's - the two cells transform the same vertices in two programs, so the depths agree to
// rounding, while a surface behind the front layer lies orders of magnitude more ULPs away.
const int kFrontLayerDepthThresholdUlps = 1024;

// The cloud layer's shadow on the world: it takes the sun's highlight away with it.
layout( binding = 20 ) uniform texture2D CloudShadowMapTexture;
#define CloudShadowMapTexture sampler2D(CloudShadowMapTexture, LinearRepeatSampler)
layout( binding = 21 ) uniform CloudShadowUB
{
    mat4 CloudShadowWorldToMap;
    vec4 CloudShadowParams;
};

#include <Common/CloudShadowReceiver.glslh>

// The sun's contact shadow takes its highlight away too (Common/ContactShadow.glslh, through the opaque scene depth,
// SceneDepthTexture of Mesh/Surface/SurfaceTypes.glslh). The block is the cascades' ShadowUB, declared whole because it
// is one layout (SceneResources::ShadowUBData); the glass reads only its contact-shadow members.
layout( binding = 7 ) uniform ShadowUB
{
    mat4 LightViewProjection[4];
    vec4 ShadowParams;
    vec4 DebugParams;
    vec4 CascadeTexelWorld;
    vec4 CascadeDepthRange;
    vec4 ContactShadowView; // x = contact shadow ray steps (0 = off), y = tan(fovY / 2), z = dither frame 0..7
    vec4 SunContactShadow;  // x = the sun's ContactShadowLength, y = in world space (>0.5),
                              // z = its Contact Shadow Casting Intensity, w = Non Casting Intensity
    vec4 ShadowFilter;
};
// The hit texel's caster bit: the opaque scene's shading word (SceneShadingWordTexture, SurfaceTypes.glslh).
#include <ShadingModels/ShadingModelContract.glslh>
#define CONTACT_SHADOW_DEPTH        SceneDepthTexture
#define CONTACT_SHADOW_VP           cameraUB.JitteredViewProjection
#define CONTACT_SHADOW_INV_VP       cameraUB.InvJitteredViewProjection
#define CONTACT_SHADOW_SHADING_WORD SceneShadingWordTexture
#include <Common/ContactShadow.glslh>

#include <Mesh/Surface/ViewIndirect.glslh>
// The split-sum's Fresnel (Mesh/AmbientIBL.glslh EvaluateAmbientIBL) is the BRDF's.
#include <Mesh/BRDF.glslh>
#include <Mesh/AmbientIBL.glslh>

void main()
{
    const SurfaceInput i =
         DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, v_Surface.TBN, v_Surface.UV1,
                              v_Surface.VertexColor, gl_FrontFacing );
    const SurfaceOutput s = EvaluateSurface( i );

    const vec3  N   = DesertSurfaceWorldNormal( i, s );
    const vec3  V   = normalize( i.CameraPosition - i.WorldPosition );
    const float ior = max( s.Refraction, 1.0 );

    // Schlick Fresnel with the IOR-derived normal reflectance (glass F0 ~0.04, water ~0.02).
    const float f0      = pow( ( ior - 1.0 ) / ( ior + 1.0 ), 2.0 );
    const float fresnel = f0 + ( 1.0 - f0 ) * pow( 1.0 - max( dot( N, V ), 0.0 ), 5.0 );

    // Sun specular highlight (glass is smooth -> a tight hotspot).
    const vec3  L    = normalize( -directionLights.directionLights.Direction.xyz );
    const vec3  H    = normalize( V + L );
    const float spec = pow( max( dot( N, H ), 0.0 ), 128.0 ) * directionLights.directionLights.ColorIntensity.a *
                       CloudShadowFactor( v_Surface.WorldPosition ) *
                       ContactShadowFactor( v_Surface.WorldPosition, N, L, SunContactShadow,
                                            /*not a subsurface receiver*/ -1.0 );

    // Screen-space refraction: the composited scene behind the surface, bent by the normal (more for a higher
    // IOR) and tinted by the surface colour.
    const vec2  screenUV  = gl_FragCoord.xy / vec2( textureSize( SceneColorTexture, 0 ) );
    const float bendScale = ( 1.0 - 1.0 / ior ) * 0.35;
    const vec2  refractUV = clamp( screenUV + N.xy * bendScale, vec2( 0.001 ), vec2( 0.999 ) );
    const vec3  refracted = texture( SceneColorTexture, refractUV ).rgb * s.BaseColor;

    // The reflection at grazing edges, of clear glass (a mirror: roughness 0, which a capture never normalises);
    // Fresnel mixes refraction (centre) into reflection (edge).
    const DesertSurface surface = DesertMakeSurface( i.WorldPosition, N, V, s.BaseColor, 0.0, 0.0, s.Specular );
    vec3 envRefl = DesertSampleViewAmbient( surface, vec3( 0.0 ), 1.0, gl_FragCoord.xy ).Prefiltered;
    // The traced reflection where this fragment is the front layer (a glass behind the nearest one keeps the
    // environment). The graph's black texture (no front layer this frame) is 1x1: a texel outside it is no front
    // layer, never a fetch out of bounds.
    const ivec2 frontTexel = ivec2( gl_FragCoord.xy );
    const bool  frontInside =
         all( lessThan( frontTexel, textureSize( FrontLayerDepthTexture, 0 ) ) ) &&
         all( lessThan( frontTexel, textureSize( FrontLayerReflectionTexture, 0 ) ) );
    const float frontDepth = frontInside ? texelFetch( FrontLayerDepthTexture, frontTexel, 0 ).r : 0.0;
    if ( frontInside &&
         abs( floatBitsToInt( frontDepth ) - floatBitsToInt( gl_FragCoord.z ) ) <= kFrontLayerDepthThresholdUlps )
    {
        const vec4 traced = texelFetch( FrontLayerReflectionTexture, frontTexel, 0 );
        envRefl           = mix( envRefl, traced.rgb, traced.a );
    }

    // The local lights' hotspot: the volume's dominant light with the same tight lobe as the sun's (its isotropic
    // rest has no highlight to give clear glass).
    const MegaLightsVolumeLighting local = MegaLightsVolumeLightingAt( gl_FragCoord.xy, v_Surface.WorldPosition, N );
    const vec3 localSpec = pow( max( dot( N, normalize( V + local.L ) ), 0.0 ), 128.0 ) * local.Radiance;

    // `refracted` is read from this frame's scene colour, already pre-exposed; only the terms lit here are scaled.
    const float preExposure = cameraUB.PreExposure;
    oColor = vec4( mix( refracted, envRefl * preExposure, fresnel ) + ( vec3( spec ) + localSpec + s.Emissive ) * preExposure,
                   1.0 );
#ifdef DESERT_SURFACE_RESPONSIVE_AA
    oResponsiveAA = vec4( 1.0, 0.0, 0.0, 1.0 );
#endif
}
