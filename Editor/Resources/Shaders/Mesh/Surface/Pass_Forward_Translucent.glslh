// Surface cell pass: forward TRANSLUCENT (UE's translucency base pass) — the Forward cell of a `BlendMode
// Translucent` template. It is drawn by MeshRenderer::RenderGlassManual over the composited opaque scene and
// nowhere else: the renderer sends an object here because its material's TEMPLATE is translucent
// (ShaderProgramMeta::Blend), never because of a parameter value. The surface is clear glass: the scene behind
// it (u_SceneColor, bent by the normal and s.Refraction) tinted by s.BaseColor, mixed by Schlick Fresnel into
// the environment's reflection (the reflection captures over the sky, as a forward mesh reflects it), plus the specular hotspot of the sun (under the cloud shadow) and of every point and spot
// light of the pixel's froxel (under its shadow, Mesh/ForwardLocalLights.glslh). Written opaque: the refracted
// scene already carries the background; the highlights also lose their lights' contact shadows. It declares no cascade maps; the
// environment trio and the captures are the shared reflection text's (Mesh/AmbientIBL.glslh); the slots keep the
// numbers the rest of the mesh family uses.
DESERT_SURFACE_VARYINGS( in )

layout( location = 0 ) out vec4 oColor;
#ifdef DESERT_SURFACE_RESPONSIVE_AA
// The scene target's responsive-AA slot (Graphic::kSceneTargetResponsiveAASlot): this surface covers the pixel
// whole (it is written opaque), so the temporal resolve takes UE's responsive 1/4 of the current frame there - the
// refracted scene behind glass moves with no velocity of its own.
layout( location = 2 ) out vec4 oResponsiveAA;
#endif

struct DirectionLight
{
    vec4 Direction;      // xyz = normalized direction
    vec4 ColorIntensity; // rgb = color, a = intensity
};

layout( binding = 3 ) uniform DirectionLightsUB
{
    DirectionLight directionLights;
}
directionLights;

// The environment, at the numbers the opaque forward cells use: the glass's mirror term at grazing angles is the
// reflection a forward mesh's ambient specular is (Mesh/AmbientIBL.glslh DesertReflectionSpecular) - the reflection
// captures around the point over the sky, normalised by the local diffuse ambient (the irradiance cube). The LUT is
// declared because the shared text names it; the glass's Schlick term below does not read it.
layout( binding = 8 ) uniform samplerCube u_EnvSpecularTex;
layout( binding = 9 ) uniform samplerCube u_EnvIrradianceTex;
layout( binding = 10 ) uniform sampler2D u_BRDFLUTTexture;
layout( binding = 22 ) uniform SkyLookUB
{
    vec4 YawCosSin; // xy = (cos yaw, sin yaw) — Graphic::SkyLookGPU
    vec4 Gain;      // rgb = tint * intensity
}
skyLook;
#include <Common/SkyLook.glslh>

// A copy of the composited opaque scene, for refraction (bound by the translucency pass only).
layout( binding = 19 ) uniform sampler2D u_SceneColor;

// The cloud layer's shadow on the world: it takes the sun's highlight away with it.
layout( binding = 20 ) uniform sampler2D u_CloudShadowMap;
layout( binding = 21 ) uniform CloudShadowUB
{
    mat4 u_CloudShadowWorldToMap;
    vec4 u_CloudShadowParams;
};

#include <Common/CloudShadowReceiver.glslh>

// The sun's contact shadow takes its highlight away too (Common/ContactShadow.glslh, through the opaque scene depth,
// u_SceneDepth of Mesh/Surface/SurfaceTypes.glslh). The block is the cascades' ShadowUB, declared whole because it
// is one layout (SceneResources::ShadowUBData); the glass reads only its contact-shadow members.
layout( binding = 7 ) uniform ShadowUB
{
    mat4 u_LightViewProj[4];
    vec4 u_ShadowParams;
    vec4 u_DebugParams;
    vec4 u_CascadeTexelWorld;
    vec4 u_CascadeDepthRange;
    vec4 u_ContactShadowView; // x = contact shadow ray steps (0 = off), y = tan(fovY / 2), z = dither frame 0..7
    vec4 u_SunContactShadow;  // x = the sun's ContactShadowLength, y = in world space (>0.5),
                              // z = its Contact Shadow Casting Intensity, w = Non Casting Intensity
};
// The hit texel's caster bit: the opaque scene's shading word (u_SceneShadingWord, SurfaceTypes.glslh).
#include <ShadingModels/ShadingModelContract.glslh>
#define CONTACT_SHADOW_DEPTH        u_SceneDepth
#define CONTACT_SHADOW_VP           cameraUB.JitteredViewProjection
#define CONTACT_SHADOW_SHADING_WORD u_SceneShadingWord
#include <Common/ContactShadow.glslh>
// The point and spot lights, through the same statement the opaque forward cells shade them with.
#include <Mesh/ForwardLocalLights.glslh>

// The view's reflection captures, declared as Pass_Forward, the forward terrain and the deferred composite declare
// them (SET 1, bindings 0 and 1; bound by name by BindSceneViewInputs).
#define DESERT_REFLECTION_CAPTURES
#include <Common/ReflectionCaptureGpu.glslh>
layout( std430, set = 1, binding = 0 ) readonly buffer ReflectionCapturesUB
{
    uvec4                u_ReflectionCaptureHeader; // x = capture count
    ReflectionCaptureGpu u_ReflectionCaptures[];
};
layout( set = 1, binding = 1 ) uniform samplerCubeArray u_ReflectionCaptureCubes;
#include <Mesh/BRDF.glslh>
#include <Mesh/AmbientIBL.glslh>

// Glass is smooth: a light's specular is a tight hotspot.
float GlassHotspot( vec3 N, vec3 V, vec3 L )
{
    return pow( max( dot( N, normalize( V + L ) ), 0.0 ), 128.0 );
}

void main()
{
    const SurfaceInput i =
         DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, v_Surface.TBN, v_Surface.UV1,
                              v_Surface.VertexColor, gl_FrontFacing );
    const SurfaceOutput s = EvaluateSurface( i );

    const vec3  N   = DesertSurfaceWorldNormal( i, s );
    const vec3  V   = normalize( i.CameraPosition - i.WorldPosition );
    const float ior = max( s.Refraction, 1.0 );

    // Schlick Fresnel with the IOR-derived normal reflectance (glass F0 ~0.04, water ~0.02).
    const float f0      = pow( ( ior - 1.0 ) / ( ior + 1.0 ), 2.0 );
    const float fresnel = f0 + ( 1.0 - f0 ) * pow( 1.0 - max( dot( N, V ), 0.0 ), 5.0 );

    // Sun specular highlight (glass is smooth -> a tight hotspot).
    const vec3 L    = normalize( -directionLights.directionLights.Direction.xyz );
    vec3       spec = vec3( GlassHotspot( N, V, L ) * directionLights.directionLights.ColorIntensity.a *
                            CloudShadowFactor( v_Surface.WorldPosition ) *
                            ContactShadowFactor( v_Surface.WorldPosition, N, L, u_SunContactShadow,
                                                 /*not a subsurface receiver*/ -1.0 ) );
    // ...and each point and spot light's, by its radiance and its shadow.
    const ForwardLightList lights = ForwardLightListAt( gl_FragCoord.xy, v_Surface.WorldPosition );
    for ( uint j = 0u; j < lights.Count; j++ )
    {
        const DesertLight local = ForwardLocalLightAt( lights, j, v_Surface.WorldPosition, N, -1.0 );
        spec += GlassHotspot( N, V, local.L ) * local.Radiance * local.Shadow;
    }

    // Screen-space refraction: the composited scene behind the surface, bent by the normal (more for a higher
    // IOR) and tinted by the surface colour.
    const vec2  screenUV  = gl_FragCoord.xy / vec2( textureSize( u_SceneColor, 0 ) );
    const float bendScale = ( 1.0 - 1.0 / ior ) * 0.35;
    const vec2  refractUV = clamp( screenUV + N.xy * bendScale, vec2( 0.001 ), vec2( 0.999 ) );
    const vec3  refracted = texture( u_SceneColor, refractUV ).rgb * s.BaseColor;

    // The environment's reflection at grazing edges (a mirror: roughness 0), the captures around the point over the
    // sky as a forward mesh reflects them; Fresnel mixes refraction (centre) into reflection (edge).
    const vec3 envRefl =
         DesertReflectionSpecular( v_Surface.WorldPosition, reflect( -V, N ), 0.0, DesertAmbientIrradiance( N ) );

    oColor = vec4( mix( refracted, envRefl, fresnel ) + spec + s.Emissive, 1.0 );
#ifdef DESERT_SURFACE_RESPONSIVE_AA
    oResponsiveAA = vec4( 1.0, 0.0, 0.0, 1.0 );
#endif
}
