// Surface cell pass: the deferred G-buffer write — the fragment stage of Programs/Surface/StaticMeshGBuffer.shader.
// It shades nothing and declares nothing of its own: every binding it has is the surface's. Every shading model
// writes through it: the texel carries the template's model index (DESERT_SHADING_MODEL_INDEX, defined by the
// parser) and payload in the shading word, and the deferred composite lights it through the generated dispatch.
#include <Generated/ShadingModels.glslh>
// The ONE engine push block (its PrimitiveFlags below): included here as well, since a template with no Properties
// block (DefaultSurface) gets no injected copy in this stage; the guard keeps it single where it is injected.
// A binned cell pushes nothing: its flags arrive as the varying the vertex stage resolved (SurfaceTypes.glslh).
#ifdef DESERT_SURFACE_BINNED
#include <Common/GpuScene.glslh>
#else
#include <Common/MaterialTransport.glslh>
#endif

DESERT_SURFACE_VARYINGS( in )
#ifdef DESERT_SURFACE_PARTICLE_SPRITE
// An opaque / masked particle's G-buffer cell (ParticleSprite.GBuffer / ParticleRibbon.GBuffer, drawn by
// ParticleRenderer::GBufferPass; UE's base pass for Opaque/Masked particle materials): the particle half of the input,
// as the vertex factory wrote it for the Forward cell (Pass_ParticleSprite.glslh).
layout( location = 12 ) in flat vec4 v_ParticleColor;
layout( location = 13 ) in flat vec2 v_ParticleTimeRandom;
#endif
#ifdef DESERT_SURFACE_WEATHER
#include <Mesh/Surface/SurfaceWeather.glslh>
#endif

// The view's decals (DECALS-DBUFFER, Common/DBuffer.glslh), folded in by the one writer below: every mesh G-buffer
// cell but the particles' (a sprite is not in the prepass depth the decals project onto; UE: no DBuffer on
// translucent-sorted or particle vertex factories).
#ifndef DESERT_SURFACE_PARTICLE_SPRITE
#define DESERT_SURFACE_DBUFFER_RECEIVE
#endif
// The six G-buffer slots and their one writer (shared with the visibility resolve, Pass_VisibilityResolve.glslh).
#include <Mesh/Surface/GBufferOutputs.glslh>
#ifdef DESERT_SURFACE_PARALLAX
// The Pixel Depth Offset only moves the fragment away from the eye: in this reverse-Z view a smaller depth, which the
// layout promises so the depth test can still reject against the rasterised depth before the fragment runs.
layout( depth_less ) out float gl_FragDepth;
#endif

#ifdef DESERT_SURFACE_CLIP_FROM_PIXEL
// The pixel's UNJITTERED clip position (SurfaceTypes.glslh DESERT_SURFACE_CLIP_FROM_PIXEL; UE
// SvPositionToScreenPosition): gl_FragCoord is where the jittered raster put the fragment, PixelToNdc maps it to the
// jittered NDC through the view's raster viewport (ShaderProtocols::MakeCameraUB of ViewFrame::RasterRect: its
// origin, its size and the flipped y of the engine's negative-height viewport), and the jitter is a pure NDC
// translation (ViewFrame.cpp ApplyJitter), so the unjittered NDC is that less JitterNdc. The depth is the raster's
// own (the jitter leaves z alone, the viewport's depth range is [0, 1]). w = 1: the w-divide the interpolated clip
// position needed is the one the raster already did.
vec4 DesertGBufferClipFromPixel()
{
    const vec2 jitteredNdc = DesertPixelToJitteredNdc( gl_FragCoord.xy );
    return vec4( jitteredNdc - cameraUB.JitterNdc, gl_FragCoord.z, 1.0 );
}
#endif

void main()
{
    DESERT_SURFACE_BEGIN_FRAGMENT();
#ifdef DESERT_SURFACE_PARTICLE_SPRITE
    SurfaceInput i =
         DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, DESERT_SURFACE_VARYING_TBN,
                             v_Surface.UV1, DESERT_SURFACE_VARYING_VERTEX_COLOR, gl_FrontFacing );
    i.Particle.Color        = v_ParticleColor;
    i.Particle.RelativeTime = v_ParticleTimeRandom.x;
    i.Particle.Random       = v_ParticleTimeRandom.y;
#else
    SurfaceInput i =
         DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, DESERT_SURFACE_VARYING_TBN,
                             v_Surface.UV1, DESERT_SURFACE_VARYING_VERTEX_COLOR, gl_FrontFacing );
#endif
    // DESERT_SURFACE_DEPTH_EQUAL (Graphic::kSurfaceDepthEqualDefine): a Masked section the masked depth prepass
    // (Pass_Depth.glslh) already drew - its clip wrote the depth - is drawn here with an EQUAL depth test and no writes
    // (MeshRenderer::BuildGpuInstancedDraws), so a texel the mask cut has the depth of what lies behind it and fails the
    // test: the clip is not repeated, and with no discard in the stage early depth testing stays on (UE: the base pass
    // of a masked material after its early-Z pass, DepthEqual, no clip).
#ifndef DESERT_SURFACE_DEPTH_EQUAL
    DESERT_SURFACE_CLIP( i );
#endif
#ifdef DESERT_SURFACE_WEATHER
    i.ObjectScaleUp = v_Surface.ObjectScaleUp;
    // The material's weather response (Mesh/Surface/SurfaceWeather.glslh), before anything reads the surface.
    const SurfaceOutput s = DesertApplySurfaceWeather( i, EvaluateSurface( i ) );
#else
    const SurfaceOutput s = EvaluateSurface( i );
#endif
#ifdef DESERT_SURFACE_CLIP_FROM_PIXEL
    vec4 clip     = DesertGBufferClipFromPixel();
#else
    vec4 clip     = v_Surface.Clip;
#endif
    vec4 prevClip = v_Surface.PrevClip;
#ifdef DESERT_SURFACE_PARALLAX
    // The relief's depth and motion (SurfaceParallax.glslh); the composite reconstructs the moved position from it.
    gl_FragDepth = DesertPixelDepthOffsetDepth( i, s );
    DesertPixelDepthOffsetVelocity( i, s, clip, prevClip );
#endif
    // The primitive's contact-shadow cast (UE bCastContactShadow): the draw pushes it (PrimitiveFlags,
    // Common/MaterialTransport.glslh), as UE's primitive data carries it.
    DesertWriteGBuffer( i, s, clip, prevClip, v_Surface.ObjectMoved,
#ifdef DESERT_SURFACE_BINNED
                        ( v_Surface.PrimitiveFlags & DESERT_GPU_PRIMITIVE_NO_CONTACT_SHADOW ) == 0u );
#else
                        ( m_PushConstants.PrimitiveFlags & DESERT_PRIMITIVE_FLAG_NO_CONTACT_SHADOW ) == 0u );
#endif
}
