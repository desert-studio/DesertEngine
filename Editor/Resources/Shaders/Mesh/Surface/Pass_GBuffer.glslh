// Surface cell pass: the deferred G-buffer, same four targets as Programs/PBR/StaticMeshGBuffer.shader.
DESERT_SURFACE_VARYINGS( in )

layout( location = 0 ) out vec4 oGBufferA;        // BaseColor.rgb, Metallic.a
layout( location = 1 ) out vec4 oGBufferB;        // Normal.rgb, Roughness.a
layout( location = 2 ) out vec4 oGBufferC;        // WorldPosition.xyz
layout( location = 3 ) out vec4 oGBufferEmissive; // Emissive.rgb

void main()
{
    const SurfaceInput  i = DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0 );
    const SurfaceOutput s = EvaluateSurface( i );
    DESERT_SURFACE_CLIP( s );
    oGBufferA        = vec4( s.BaseColor, s.Metallic );
    oGBufferB        = vec4( i.Normal, s.Roughness );
    oGBufferC        = vec4( i.WorldPosition, 0.0 );
    oGBufferEmissive = vec4( s.Emissive, 1.0 );
}
