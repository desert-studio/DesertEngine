// Surface cell pass: the deferred G-buffer write — the fragment stage of Programs/PBR/StaticMeshGBuffer.shader.
// It shades nothing and declares nothing of its own: every binding it has is the surface's. Every shading model
// writes through it: the texel carries the template's model index (DESERT_SHADING_MODEL_INDEX, defined by the
// parser) and payload in the shading word, and the deferred composite lights it through the generated dispatch.
#include <Generated/ShadingModels.glslh>

DESERT_SURFACE_VARYINGS( in )

layout( location = 0 ) out vec4 oGBufferA;        // BaseColor.rgb, Metallic.a
layout( location = 1 ) out vec4 oGBufferB;        // world Normal.rgb, Roughness.a
layout( location = 2 ) out vec4 oGBufferC;        // WorldPosition.xyz, shading word.w (ShadingModelContract.glslh)
layout( location = 3 ) out vec4 oGBufferEmissive; // Emissive.rgb (HDR; the deferred resolve adds it), AO.a

void main()
{
    const SurfaceInput i =
         DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, v_Surface.TBN, v_Surface.UV1,
                              v_Surface.VertexColor );
    const SurfaceOutput s = EvaluateSurface( i );
    DESERT_SURFACE_CLIP( s );
    const float word = DesertPackShadingWord( DESERT_SHADING_MODEL_INDEX, s.SampledTextureCount,
                                              DesertPayload( s.CustomData0, s.CustomData1 ) );
    oGBufferA        = vec4( s.BaseColor, s.Metallic );
    oGBufferB        = vec4( DesertSurfaceWorldNormal( i, s ), max( s.Roughness, 0.04 ) );
    oGBufferC        = vec4( i.WorldPosition, DesertMarkSunShadowReceive( word, s.ReceiveSunShadows ) );
    oGBufferEmissive = vec4( s.Emissive, s.AmbientOcclusion );
}
