// Surface cell pass: the G-buffer write of ShadingModel Unlit (UE's MSM_Unlit in the base pass) — emission only.
// The attachments are Pass_GBuffer's. The texel carries SHADING_MODEL_ID_UNLIT (Mesh/Surface/ShadingModels.glslh),
// and the deferred composite branches on it: an Unlit texel is its emission and nothing else — no BRDF, no
// ambient, no occlusion — as UE's lighting skips MSM_Unlit. Albedo and metalness are written black so the
// debug views and the screen-space bounce (which reads albedo) see no reflector here either.
#include <Mesh/Surface/ShadingModels.glslh>

DESERT_SURFACE_VARYINGS( in )

layout( location = 0 ) out vec4 oGBufferA;        // BaseColor.rgb, Metallic.a
layout( location = 1 ) out vec4 oGBufferB;        // world Normal.rgb, Roughness.a
layout( location = 2 ) out vec4 oGBufferC;        // WorldPosition.xyz, ShadingModelID | texture count.w
layout( location = 3 ) out vec4 oGBufferEmissive; // Emissive.rgb (HDR; the deferred resolve adds it), AO.a

void main()
{
    const SurfaceInput i =
         DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, v_Surface.TBN );
    const SurfaceOutput s = EvaluateSurface( i );
    DESERT_SURFACE_CLIP( s );
    oGBufferA        = vec4( vec3( 0.0 ), 0.0 );
    oGBufferB        = vec4( i.Normal, 1.0 );
    oGBufferC        = vec4( i.WorldPosition, DesertPackShadingWord( SHADING_MODEL_ID_UNLIT, s.SampledTextureCount ) );
    oGBufferEmissive = vec4( s.Emissive, 1.0 );
}
