// Surface cell pass: the G-buffer write of ShadingModel Unlit (UE's MSM_Unlit in the base pass) — emission only.
// The attachments are Pass_GBuffer's; no albedo and no metalness, so the deferred lighting has nothing to reflect
// and the resolve adds the emission. (The G-buffer has no shading-model channel yet, so the lighting still runs
// over the texel: the fully-rough non-metal black keeps its contribution at the dielectric floor.)
DESERT_SURFACE_VARYINGS( in )

layout( location = 0 ) out vec4 oGBufferA;        // BaseColor.rgb, Metallic.a
layout( location = 1 ) out vec4 oGBufferB;        // world Normal.rgb, Roughness.a
layout( location = 2 ) out vec4 oGBufferC;        // WorldPosition.xyz, sampled-texture count.w
layout( location = 3 ) out vec4 oGBufferEmissive; // Emissive.rgb (HDR; the deferred resolve adds it)

void main()
{
    const SurfaceInput i =
         DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, v_Surface.TBN, v_Surface.UV1,
                              v_Surface.VertexColor );
    const SurfaceOutput s = EvaluateSurface( i );
    DESERT_SURFACE_CLIP( s );
    oGBufferA        = vec4( vec3( 0.0 ), 0.0 );
    oGBufferB        = vec4( i.Normal, 1.0 );
    oGBufferC        = vec4( i.WorldPosition, s.SampledTextureCount );
    oGBufferEmissive = vec4( s.Emissive, 1.0 );
}
