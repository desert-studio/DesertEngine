// Surface cell pass: particle SPRITES — the Forward cell of the ParticleSprite vertex path (DShaderParser
// kSurfaceParticleSpritePassInclude). Drawn by ParticleRenderer::DrawPass in the translucency, depth-TESTED against
// the scene depth and never writing it. The material's own surface function shades the sprite UNLIT (UE's default
// for particle materials): the colour is BaseColor + Emissive, the coverage is Opacity — a graph that wants soft
// particles multiplies its opacity through Depth Fade (SurfaceTypes.glslh DesertDepthFade, which reads the scene
// depth this cell declares at binding 27). Every sprite fogs ITSELF at its own depth (Mesh/Surface/SceneFog.glslh;
// UE's translucency fogging): it is drawn after the opaque fog composite, which fogged only what is behind it. Translucent templates blend it over the scene (sorted back to front per
// view); Opaque and Masked write it as a solid card, Masked discarding below the material's clip value.
DESERT_SURFACE_VARYINGS( in )

layout( location = 12 ) in flat vec4 v_ParticleColor;
layout( location = 13 ) in flat vec2 v_ParticleTimeRandom;

// The fog's three images are read through this sampler (Mesh/Surface/SceneFog.glslh).
Uniform sampler LinearClampSampler;
#include <Mesh/Surface/SceneFog.glslh>

layout( location = 0 ) out vec4 oColor;
#ifdef DESERT_SURFACE_RESPONSIVE_AA
// The scene target's responsive-AA slot (Graphic::kSceneTargetResponsiveAASlot): the sprite's coverage, blended
// exactly as its colour is (the alpha is the same Opacity), so the mask is what the sprite composited.
layout( location = 2 ) out vec4 oResponsiveAA;
#endif

void main()
{
    SurfaceInput i = DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, v_Surface.TBN,
                                         v_Surface.UV1, v_Surface.VertexColor, gl_FrontFacing );
    i.Particle.Color        = v_ParticleColor;
    i.Particle.RelativeTime = v_ParticleTimeRandom.x;
    i.Particle.Random       = v_ParticleTimeRandom.y;

    DESERT_SURFACE_CLIP( i );
    const SurfaceOutput s = EvaluateSurface( i );
    DESERT_SURFACE_CLIP( s );
    // The sprite fogs itself at its own depth (Mesh/Surface/SceneFog.glslh); the fog's inscattering is pre-exposed
    // by the fog block (FogGates.z), the sprite's own light by the camera's pre-exposure.
    const vec4 fog = DesertSceneFog( v_Surface.WorldPosition );
    const vec3 lit = ( s.BaseColor + s.Emissive ) * cameraUB.PreExposure;
#ifdef DESERT_SURFACE_TRANSLUCENT
    if ( s.Opacity <= 0.0 )
        discard;
#ifdef DESERT_SURFACE_ADDITIVE
    // Added light: attenuated by the fog in front of it, and none of the fog's own light (that is already in the
    // scene it is added to).
    oColor = vec4( lit * fog.a, clamp( s.Opacity, 0.0, 1.0 ) );
#else
    // Blended by its coverage (SrcAlpha): colour * transmittance + inscattering, both scaled by the coverage.
    oColor = vec4( lit * fog.a + fog.rgb, clamp( s.Opacity, 0.0, 1.0 ) );
#endif
#ifdef DESERT_SURFACE_RESPONSIVE_AA
    oResponsiveAA = vec4( 1.0, 0.0, 0.0, oColor.a );
#endif
#else
    oColor = vec4( lit * fog.a + fog.rgb, 1.0 );
#endif
}
