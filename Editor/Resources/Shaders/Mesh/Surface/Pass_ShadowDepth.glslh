// Surface cell pass: shadow depth, the R32F target Programs/Shadow/Shadow.shader writes. The surface is
// evaluated only for its clip (BlendMode Masked); an opaque cell's call is dead code the compiler drops.
DESERT_SURFACE_VARYINGS( in )

layout( location = 0 ) out vec4 o_Depth;

void main()
{
    const SurfaceOutput s =
         EvaluateSurface( DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0 ) );
    DESERT_SURFACE_CLIP( s );
    o_Depth = vec4( gl_FragCoord.z, 0.0, 0.0, 1.0 );
}
