// Surface cell pass: shadow depth, DEPTH ONLY (ViewTargetFormats::kShadowDepth, D32F; no colour target — UE's
// ShadowDepthPixelShader.usf writes depth and nothing else). The receivers sample the depth attachment itself. An opaque template's
// cell reads no varyings and evaluates no surface — its layout is Shadow*'s; a Masked one evaluates only its
// generated opacity mask (UE's masked FShadowDepthPS), so it carries the surface's bindings and the varyings.
//
// No gl_FragDepth: the whole caster bias is in the vertex stage's clip depth (constant through the caster matrix,
// Graphic::CasterViewProj; slope through Common/ShadowCasterBias.glslh, as UE's ShadowDepthVertexShader.usf), so
// the rasterised depth IS the depth tested and stored, and early depth testing stays on. The one exception is a
// template's `.Parallax` cell: it evaluates the surface and writes the relief's depth (Pixel Depth Offset,
// Mesh/Surface/SurfaceParallax.glslh) as the rasterised depth plus the projected move, so the bias is kept.
#ifdef DESERT_SURFACE_HAS_VARYINGS
DESERT_SURFACE_VARYINGS( in )
#endif
#ifdef DESERT_SURFACE_PARALLAX
// A light view is standard-Z: the offset, away from the light, only increases the depth.
layout( depth_greater ) out float gl_FragDepth;
#endif

void main()
{
#ifdef DESERT_SURFACE_HAS_VARYINGS
    DESERT_SURFACE_BEGIN_FRAGMENT();
#endif
#if defined( DESERT_SURFACE_MASKED ) || defined( DESERT_SURFACE_PARALLAX )
    const SurfaceInput i = DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, v_Surface.TBN,
                                               v_Surface.UV1, v_Surface.VertexColor, gl_FrontFacing );
    DESERT_SURFACE_CLIP( i );
#endif
#ifdef DESERT_SURFACE_PARALLAX
    gl_FragDepth = DesertPixelDepthOffsetDepth( i, EvaluateSurface( i ) );
#endif
}
