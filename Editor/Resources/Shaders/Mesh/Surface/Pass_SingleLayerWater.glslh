// Surface cell pass: SINGLE LAYER WATER (UE SingleLayerWater.usf + SingleLayerWaterComposite.usf, folded into one
// forward draw) - the `WaterMesh.SingleLayerWater` cell of a `ShadingModel SingleLayerWater` / `Usage WaterMesh`
// template (DShaderParser kSurfaceSingleLayerWaterPass). Graphic::System::WaterRenderer draws it after the opaque
// scene's copy and before the glass, into the scene target with depth.
//
// The surface (EvaluateSurface: the ripple normal, roughness, specular) and the volume (EvaluateSingleLayerWater:
// scattering, absorption, phase, the tint behind) are the MATERIAL's; this header is the physics, stating no colour:
//   - the scene behind (the opaque copy, without water) refracted by the surface normal, refused where the bent
//     sample lands in front of the surface;
//   - Beer-Lambert transmittance over the view ray's length through the water (the opaque depth is the bottom: UE's
//     SceneDepthWithoutSingleLayerWater) plus the single-scattered sun (Henyey-Greenstein) and sky;
//   - the FOAM, where the waves made it: the view's foam map (WaterFoamSample), which remembers what broke, carries
//     it on the current and lets it decay. Its look is the material's;
//   - the interface through the SHADING MODEL (ShadingModels/SingleLayerWater.shadingmodel): the sun's specular and
//     the reflection, the volume weighted by what the split-sum Fresnel lets through; the point and spot lights of
//     the froxel through the same model, each under its shadow; the sun under its shadow maps;
//   - the REFLECTION through the view's chain (UE single layer water: SSR / Lumen reflections traced from the water's
//     own G-buffer, then the reflection captures, then the sky): the front layer's trace where the water is the
//     front layer (WaterRenderer draws its `WaterMesh.FrontLayer` cell into "Translucency: Front Layer G-buffer"),
//     the view's reflection environment - the captures over the radiance cache or the sky - for the rest of the
//     lobe, both along the one mirror direction of Mesh/Surface/WaterInterface.glslh.
#include <Common/Velocity.glslh>

DESERT_SURFACE_VARYINGS( in )

layout( location = 0 ) out vec4 oColor;
layout( location = 1 ) out vec4 oVelocity; // the view's velocity, slot 1 of the scene target
// The view's thin-geometry coverage, slot 3 of the scene target: water counts as a regular surface (UE).
layout( location = 3 ) out float oThinGeometryCoverage;

#include <Common/DirectionLightsUB.glslh>

Uniform sampler LinearClampSampler;
Uniform sampler PointClampSampler;
// The cascades and the cloud layer's map are read linear, repeat (Graphic::SceneViewDetail::BindWhere's states).
#define DESERT_LINEAR_REPEAT_SAMPLER
Uniform sampler LinearRepeatSampler;
#include <Generated/SceneBindings.glslh> // the set-0 slot table (Core::kSceneBindingNames)

// THE LIGHTS AND SHADOWS OF EVERY TRANSLUCENT SURFACE (UE: single layer water reads the view's forward light grid and
// the directional light's forward shadow, as every translucency does). The water is not in the opaque depth the
// screen shadow masks were traced against, so it reads the shadow MAPS: the sun's cascades (Mesh/CascadedShadow
// .glslh, the forward cells' reader), its contact shadow and the cloud layer's; the point and spot lights of its
// froxel through Mesh/ForwardLocalLights.glslh (Point/SpotLightShadow over the atlas, or DESERT_LOCAL_SHADOW_VSM's
// virtual map under Shadows.Method VirtualMaps), or the MegaLights volume under Stochastic. Each is a program input
// the shadow gates count (WaterRenderer::FrameSamples -> SceneRenderer ShadowMapReadersOutsideMeshes), so the maps
// are drawn while the water reads them.
#include <Common/MegaLightsVolume.glslh>
layout( binding = 5 ) uniform texture2DArray ShadowCascadesTexture;
#define ShadowCascadesTexture sampler2DArray(ShadowCascadesTexture, LinearRepeatSampler)
#include <Mesh/ShadowUB.glslh> // the view's ShadowUB, binding 7 (SceneResources::ShadowUBData)
#include <Mesh/CascadedShadow.glslh>
layout( binding = 20 ) uniform texture2D CloudShadowMapTexture;
#define CloudShadowMapTexture sampler2D(CloudShadowMapTexture, LinearRepeatSampler)
layout( binding = 21 ) uniform CloudShadowUB
{
    mat4 CloudShadowWorldToMap;
    vec4 CloudShadowParams;
};
#include <Common/CloudShadowReceiver.glslh>

layout( binding = 8 ) uniform textureCube EnvironmentSpecularTexture;
#define EnvironmentSpecularTexture samplerCube(EnvironmentSpecularTexture, LinearClampSampler)
layout( binding = 9 ) uniform textureCube EnvironmentIrradianceTexture;
#define EnvironmentIrradianceTexture samplerCube(EnvironmentIrradianceTexture, LinearClampSampler)
layout( binding = 10 ) uniform texture2D BrdfLutTexture;
#define BrdfLutTexture sampler2D(BrdfLutTexture, LinearClampSampler)
layout( binding = 22 ) uniform SkyLookUB
{
    vec4 YawCosSin; // xy = (cos yaw, sin yaw) - Graphic::SkyLookGPU
    vec4 Gain;      // rgb = tint * intensity
}
skyLook;
#include <Common/SkyLook.glslh>

// The composited opaque scene, pre-exposed, without the water (SceneRenderer::AddFrameSceneCopy).
layout( binding = 19 ) uniform texture2D SceneColorTexture;
#define SceneColorTexture sampler2D(SceneColorTexture, LinearClampSampler)
// The opaque scene's device depth (reversed-Z): the water's bottom (SceneViewInputs::SceneDepth, Core::kSceneDepthBinding).
#ifndef DESERT_SURFACE_DEPTH_FADE
layout( binding = kSceneDepthBinding ) uniform texture2D SceneDepthTexture;
#endif
#define WaterSceneDepth sampler2D(SceneDepthTexture, PointClampSampler)
// The opaque scene's shading word beside it: the contact-shadow ray's hit texel's caster bit (as the forward cells).
layout( binding = kSceneShadingWordBinding ) uniform utexture2D SceneShadingWordTexture;
#define SceneShadingWordTexture usampler2D(SceneShadingWordTexture, PointClampSampler)

// The lights' contact shadows march the opaque depth, the water's bottom (Common/ContactShadow.glslh), then the
// point and spot lights of the froxel with their shadows.
#include <ShadingModels/ShadingModelContract.glslh>
#define CONTACT_SHADOW_DEPTH        WaterSceneDepth
#define CONTACT_SHADOW_VP           cameraUB.JitteredViewProjection
#define CONTACT_SHADOW_INV_VP       cameraUB.InvJitteredViewProjection
#define CONTACT_SHADOW_SHADING_WORD SceneShadingWordTexture
#include <Common/ContactShadow.glslh>
#include <Mesh/ForwardLocalLights.glslh>

// The view's fog at the surface's own depth: the water is drawn after the opaque fog composite, so the copy it
// refracts is already fogged and the surface's own light is fogged here (as Pass_Forward_Translucent.glslh).
#include <Mesh/Surface/SceneFog.glslh>

// The view's reflection environment as every forward pass reads it (the captures, the radiance cache where the view
// traces GI), declared before Mesh/AmbientIBL.glslh, which samples it; then the front layer's traced reflection.
#include <Mesh/Surface/ViewIndirect.glslh>
#include <Mesh/Surface/FrontLayerReflection.glslh>
#include <Mesh/Surface/WaterInterface.glslh>
#include <Mesh/BRDF.glslh>
#include <Mesh/AmbientIBL.glslh>
#include <Generated/ShadingModels.glslh>
// The point and spot lights through the shading model: the statement every forward-lit cell shares.
#include <Mesh/ForwardSceneLighting.glslh>
// After the lighting half of Mesh/AmbientIBL.glslh: this header includes the generated models, whose own
// include of AmbientIBL would otherwise take its sampler-less half first (as Pass_Forward.glslh orders it).
#include <Common/ThinGeometryCoverage.glslh>
// The body's waves (binding 24, ahead of the tiles): the one surface, here per pixel.
#include <Mesh/Surface/WaterMeshTiles.glslh>
#include <Water/WaterUnderwater.glslh>
// The scene's air (WIND-FIELD-GPU): the gust fronts and the local sources the foliage sways by roughen the
// ripples.
#include <Common/WindGust.glslh>
#include <Common/LocalWind.glslh>

const float kWaterPi = 3.14159265;

// THE WIND ON THE RIPPLES (WIND-FIELD-GPU; Ghost of Tsushima's gust fronts seen as cat's paws on water): the
// factor the material's ripple tilt is scaled by at a world point - the scene's ONE wind field, the one the
// foliage sways by. The gust fronts (WindGustScale, in [1 - Gustiness, 1]) calm the water in a lull as they still
// a plant; a local source (LocalWindXZ, in units of the frame's reference speed) roughens it by its air, up to the
// material's WindRippleMaxGain times its tilt at the reference speed and above. No wind (Gustiness 0, no local
// source): exactly
// 1, the material's look.
float WaterWindRippleScale( vec3 worldPosition, float maxGain )
{
    const float gust  = WindGustScale( worldPosition.x, worldPosition.z, cameraUB.WindGust );
    const float local = min( length( LocalWindXZ( worldPosition, false ) ), 1.0 );
    return gust * ( 1.0 + ( maxGain - 1.0 ) * local );
}

vec3 WaterWorldAt( vec2 uv, float deviceDepth )
{
    // Texture v runs down the screen, clip y up (the view's flipped viewport): NDC y is 1 - 2v.
    const vec4 w = cameraUB.InvJitteredViewProjection * vec4( uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, deviceDepth, 1.0 );
    return w.xyz / w.w;
}

float WaterHenyeyGreenstein( float cosTheta, float g )
{
    const float g2 = g * g;
    return ( 1.0 - g2 ) / ( 4.0 * kWaterPi * pow( max( 1.0 + g2 - 2.0 * g * cosTheta, 1e-4 ), 1.5 ) );
}

// THE FOAM (Water/WaterFoamField.glslh): what the view's foam map holds at this particle of still water.
layout( set = 1, binding = 10 ) uniform texture2D WaterFoamTexture;
#define WATER_FOAM_FETCH( t ) texelFetch( WaterFoamTexture, t, 0 )
#define WATER_FOAM_ORIGIN( l ) WaterFoamOrigin[l].xyz
#define WATER_FOAM_SIDE WaterFoamShape.x
#include <Water/WaterFoamField.glslh>
#include <Mesh/Surface/WaterFallSheet.glslh>

// Water's index of refraction, and how much one centimetre's crossing of aerated water scatters (1/m at full bubbles).
const float kWaterIor             = 1.333;
const float kWaterBubbleScatter   = 4.0;
const float kWaterFoamMaxCoverage = 0.85; // holes always stay in the lace
// A water film this thin (cm) no longer hides the ground it wets.
const float kWaterFilmCm = 3.0;

void main()
{
    SurfaceInput i =
         DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, DESERT_SURFACE_VARYING_TBN, v_Surface.UV1,
                              DESERT_SURFACE_VARYING_VERTEX_COLOR, gl_FrontFacing );
    // A river's tile past its banks (the quadtree leaf overshoots the ribbon): no water there; an ocean drawn under
    // a river's cut leaf inside them: the river is drawn there (WaterBankClipped).
    if ( WaterBankClipped( i.WorldPosition.xz, i.VertexColor.b ) )
        discard;
    // A river's fall gives way where the river's own surface is drawn (its overlap at the lip and the foot).
    if ( WaterTileIsFall( i.VertexColor.b ) && WaterFallUnderRiver( i.WorldPosition ) )
        discard;
    // THE SURFACE PER PIXEL (WaterPixelSurface): the glint is as sharp as the finest wave, not the grid, and what is
    // finer than the pixel widens the lobe. The ripple maps then bend THIS frame (EvaluateSurface's tangent-space
    // normal goes through i.TBN). A fall's sheet keeps its mesh's frame, bent by its strands.
    const bool  fall      = WaterTileIsFall( i.VertexColor.b );
    const float footprint = sqrt( length( dFdx( i.WorldPosition.xz ) ) * length( dFdy( i.WorldPosition.xz ) ) );
    const int   waveSet   = WaterWaveSetOf( WaterFragmentTile( i.VertexColor ).Body.z );
    const float facing    = gl_FrontFacing ? 1.0 : -1.0; // DesertSurfaceInput's two-sided turn
    WaterSurface   field  = WaterPixelSurface( i.UV1, i.VertexColor, i.Time, i.Time, footprint );
    WaterFallSheet sheet  = WaterFallSheetNone();
    if ( fall )
    {
        field.Variance = 0.0;
        sheet          = WaterFallSheetAt( i.UV0, i.VertexColor, i.Time );
        i.TBN          = mat3( i.TBN[0], i.TBN[1], normalize( i.TBN * sheet.Normal ) );
        i.Normal       = i.TBN[2];
    }
    else
    {
        // The beach: the sheet lies under the sand the run-up does not reach.
        if ( waveSet >= 0 && field.Depth + field.Displacement.y < 0.0 )
            discard;
        vec3 waveN = WaterSurfaceNormal( field.Slope );
        if ( i.VertexColor.b > 0.5 )
        {
            const vec3 riverN = WaterRiverSurfaceNormal( i.WorldPosition.xz );
            waveN = normalize( vec3( waveN.xz / max( waveN.y, 0.05 ) + riverN.xz / max( riverN.y, 0.05 ), 1.0 ).xzy );
        }
        i.TBN    = WaterSurfaceFrame( waveN ) * facing;
        i.Normal = i.TBN[2];
    }
    SurfaceOutput                s = EvaluateSurface( i );
    const SingleLayerWaterOutput w = EvaluateSingleLayerWater( i );
    // GGX alpha^2 is twice the per-axis slope variance the pixel does not resolve.
    const float alpha = s.Roughness * s.Roughness;
    s.Roughness       = sqrt( sqrt( alpha * alpha + 2.0 * field.Variance ) );
    const float                  windRipple = WaterWindRippleScale( i.WorldPosition, w.WindRippleMaxGain );
    if ( windRipple != 1.0 )
        s.Normal = SurfaceScaleTangentNormal( s.Normal, windRipple );

    const vec3 V = normalize( i.CameraPosition - i.WorldPosition );
    const vec3 N = WaterFacingNormal( DesertSurfaceWorldNormal( i, s ), V );

    const float exposure = cameraUB.PreExposure;
    const vec3  L        = normalize( -directionLights.directionLights.Direction.xyz );
    const vec3  sunLit   = directionLights.directionLights.ColorIntensity.rgb *
                     directionLights.directionLights.ColorIntensity.a; // not yet pre-exposed
    // The sun's shadow at the surface, as the ground beside it is shadowed: the cascades, the contact shadow through
    // the opaque depth, the cloud layer. One factor for the interface, the volume's scattered sun and the foam (UE
    // single layer water: the directional light's forward shadow at the surface lights its volume too). Judged with
    // the mesh's normal: a ripple is no surface the cascades were biased for.
    const vec3  geomN    = normalize( i.Normal );
    int         cascade;
    const float sunShadow = ShadowFactor( kShadowLightSun, i.WorldPosition, geomN, L, cascade ) *
                            ContactShadowFactor( i.WorldPosition, geomN, L, SunContactShadow,
                                                 /*not a subsurface receiver*/ -1.0 ) *
                            CloudShadowFactor( i.WorldPosition );
    const vec3  sun = sunLit * sunShadow;

    // --- The scene behind, refracted (Snell): the eye's ray bends into the water and meets the bottom at the water's
    // VERTICAL depth there - a calm flat bottom shifts as it does in the sea, not by a share of the view's length.
    const vec2  screen   = vec2( textureSize( WaterSceneDepth, 0 ) );
    const vec2  uv       = gl_FragCoord.xy / screen;
    const float baseDev  = texture( WaterSceneDepth, uv ).r;
    const vec3  baseBack = WaterWorldAt( uv, baseDev );
    const float baseLen  = baseDev <= 0.0 ? 1e7 : distance( i.WorldPosition, baseBack );
    const float baseDown = baseDev <= 0.0 ? 1e7 : max( i.WorldPosition.y - baseBack.y, 0.0 );
    const vec3  bentDir  = refract( -V, gl_FrontFacing ? N : -N, 1.0 / kWaterIor );
    vec2        refrUv   = uv;
    float       refrDev  = baseDev;
    vec3        refrBack = baseBack;
    vec3        behind   = texture( SceneColorTexture, uv ).rgb; // pre-exposed
    if ( baseDev > 0.0 && dot( bentDir, bentDir ) > 0.5 )
    {
        const vec3 bent    = i.WorldPosition + bentDir * min( baseDown / max( -bentDir.y, 0.2 ), baseLen );
        const vec4 clipOff = cameraUB.JitteredViewProjection * vec4( bent, 1.0 );
        const vec2 bentUv  = clamp( vec2( 0.5, -0.5 ) * ( clipOff.xy / clipOff.w ) + 0.5, vec2( 0.0 ), vec2( 1.0 ) );
        // Four taps about the bent point; each that lies in front of the surface is refused (a swimmer's silhouette
        // never bleeds into the water beside it). None left: the straight view.
        const float surfaceAhead = dot( i.WorldPosition - i.CameraPosition, -V );
        const vec2  base  = floor( bentUv * screen - 0.5 );
        const vec2  frac2 = bentUv * screen - 0.5 - base;
        vec3  sum   = vec3( 0.0 );
        vec3  back  = vec3( 0.0 );
        float total = 0.0;
        for ( int k = 0; k < 4; ++k )
        {
            const vec2  d   = vec2( float( k & 1 ), float( k >> 1 ) );
            const vec2  tap = ( base + d + 0.5 ) / screen;
            const float dev = texture( WaterSceneDepth, tap ).r;
            const vec3  at  = WaterWorldAt( tap, dev );
            if ( dev <= 0.0 || dot( at - i.CameraPosition, -V ) < surfaceAhead )
                continue;
            const float weight = ( d.x > 0.5 ? frac2.x : 1.0 - frac2.x ) * ( d.y > 0.5 ? frac2.y : 1.0 - frac2.y ) + 1e-4;
            sum   += weight * texture( SceneColorTexture, tap ).rgb;
            back  += weight * at;
            total += weight;
        }
        if ( total > 0.0 )
        {
            behind   = sum / total;
            refrBack = back / total;
        }
    }
    // The falling sheet is as thick as its flow leaves it; a body of water, as deep as its bottom.
    const float downCm = fall ? sheet.ThicknessCm : ( baseDev <= 0.0 ? 1e7 : max( i.WorldPosition.y - refrBack.y, 0.0 ) );
    const float pathCm = fall ? sheet.ThicknessCm : ( baseDev <= 0.0 ? 1e7 : distance( i.WorldPosition, refrBack ) );

    // --- The foam map at this particle: R what covers the surface, G the bubbles under it.
    const vec4  foamMap = !fall && WaterFoamShape.y > 0.5 ? WaterFoamSample( i.UV1, footprint ) : vec4( 0.0 );
    const float amount  = fall ? sheet.Foam : foamMap.r;

    // --- The water volume: Beer-Lambert over the path, plus the single-scattered sun and sky. The sun's own way down
    // to each point of the path is lost too: with k = the metres the light makes per metre of view, the integral of
    // exp(-s t (1 + k)) over the path.
    const vec3  sigmaS   = w.ScatteringCoefficients + vec3( kWaterBubbleScatter * foamMap.g );
    const vec3  sigmaT   = max( w.AbsorptionCoefficients + sigmaS, vec3( 1e-5 ) );
    const float pathM    = pathCm * 0.01;
    const float downM    = downCm * 0.01;
    const vec3  trans    = exp( -sigmaT * pathM );
    const vec3  albedo   = sigmaS / sigmaT;
    const vec3  skyIrr   = DesertAmbientIrradiance( vec3( 0.0, 1.0, 0.0 ) );
    const float phase    = WaterHenyeyGreenstein( dot( -V, L ), w.PhaseG );
    const float sunDownY = max( -refract( -L, vec3( 0.0, 1.0, 0.0 ), 1.0 / kWaterIor ).y, 0.2 );
    const float sunWay   = downM / ( sunDownY * max( pathM, 1e-4 ) );
    const vec3  sunIn    = ( 1.0 - exp( -sigmaT * pathM * ( 1.0 + sunWay ) ) ) / ( 1.0 + sunWay );
    // A crest with the sun behind it glows: the light crosses the crest's own thickness (its height over its slope).
    const float crest    = fall ? sheet.ThicknessCm : max( field.Displacement.y, 0.0 );
    const float thinCm   = fall ? sheet.ThicknessCm : crest / max( length( field.Slope ), 0.05 );
    const float swellCm  = waveSet >= 0 ? max( WaterWaveSets[waveSet].Swell.y, 1.0 ) : 1.0;
    const float crestW   = fall ? 1.0 : ( waveSet >= 0 ? smoothstep( 0.1, 0.6, crest / swellCm ) : 0.0 );
    const float through4 = pow( clamp( dot( -V, normalize( L + N * 0.3 ) ), 0.0, 1.0 ), 4.0 );
    const vec3  glow     = sun * albedo * exp( -sigmaT * thinCm * 0.01 ) * ( through4 * crestW / ( 4.0 * kWaterPi ) );
    const vec3  inscat   = ( sun * max( L.y, 0.0 ) * phase * sunIn + skyIrr * 0.25 * ( 1.0 - trans ) ) * albedo + glow;
    // The bottom is lit through the water above it: what the light lost on its way down.
    behind *= fall ? vec3( 1.0 ) : exp( -sigmaT * min( downM, 100.0 ) );

    // --- The interface, through the shading model: the sun's specular and the environment's reflection (the
    // reflection of a surface seen from above is of the upper hemisphere).
    const DesertSurface S = DesertMakeSurface( i.WorldPosition, N, V, vec3( 0.0 ), 0.0, s.Roughness, s.Specular );
    const DesertPayload P = DesertQuantizePayload( DesertPayload( 0.0, 0.0, 0.0, 0.0 ) );
    // L points toward the sun; DesertSunLight takes the direction its light travels.
    const DesertLight   sunLight = DesertSunLight( -L, sunLit, sunShadow, sunShadow,
                                                         directionLights.directionLights.Direction.w );
    // ...and each point and spot light of the froxel under its shadow (or the MegaLights volume's), through the same
    // model. The volume's scattering stays the sun's and the sky's (UE SingleLayerWater's), so the local lights'
    // isotropic remainder (Indirect) has no diffuse surface to light here.
    const vec3 direct = DesertEvaluateShadingModel( DESERT_SHADING_MODEL_INDEX, sunLight, S, P ) +
                        DesertForwardLocalLights( DESERT_SHADING_MODEL_INDEX, gl_FragCoord.xy, i.WorldPosition, N,
                                                  /*not a subsurface receiver*/ -1.0, S, P )
                             .Light;

    // The reflection, along the mirror normal (the ray off a near wave face folded above the horizon): the view's
    // reflection environment answers the lobe, the front layer's trace - where this fragment is the front layer -
    // its own share over it (Mesh/AmbientIBL.glslh DesertComposeTracedReflection), and the split sum's Fresnel of
    // the view angle weighs the result, as it weighs what the interface lets through below.
    const DesertSurface SR =
         DesertMakeSurface( i.WorldPosition, WaterMirrorNormal( N, V ), V, vec3( 0.0 ), 0.0, s.Roughness, s.Specular );
    DesertAmbient A = DesertSampleViewAmbient( SR, vec3( 0.0 ), 1.0, gl_FragCoord.xy );
    A.Prefiltered   = DesertComposeTracedReflection(
         DesertFrontLayerTracedReflection( gl_FragCoord.xy, gl_FragCoord.z ), A.Prefiltered );
    const vec3 reflected = DesertEvaluateShadingModelAmbient( DESERT_SHADING_MODEL_INDEX, A, SR, P );

    // What the interface does not reflect enters the eye from the volume (UE: 1 - EnvBRDF), the reflection being the
    // multiply-scattered lobe the model's ambient specular draws (Mesh/AmbientIBL.glslh DesertAmbientSpecularAlbedo).
    const vec3 F0      = DesertSpecularF0( SR );
    const vec3 through = vec3( 1.0 ) - DesertAmbientSpecularAlbedo( F0, A.SpecularBRDF );

    // The fog in front of the surface (pre-exposed inscattering, transmittance): the refracted scene behind is the
    // fogged copy, so only the light the water itself sends (its inscattering, the interface) is attenuated, and the
    // fog's own inscattering fills what the fogged scene behind no longer covers.
    const vec4 fog        = DesertSceneFog( i.WorldPosition );
    const vec3 seenBehind = w.ColorScaleBehindWater * trans * through;
    const vec3 ownLight   = inscat * exposure * through + ( direct + reflected ) * exposure;
    const vec3 water      = behind * seenBehind + ownLight * fog.a + fog.rgb * ( vec3( 1.0 ) - trans * through );

    // --- The foam: where the waves made it (the map), how it looks (the material). The amount is the share of the
    // structure's height field under water: a little shows its tallest walls, more fills the cells. A rough diffuse
    // layer on top, lit by the sun and sky. It is opaque, so the fog in front of it is the full fog.
    const float lace    = kWaterFoamMaxCoverage * clamp( amount, 0.0, 1.0 );
    const float foam    = smoothstep( 1.0 - lace, 1.0 - lace + 0.2, w.FoamHeight ) * smoothstep( 0.0, 0.05, amount );
    const vec3  foamN   = normalize( i.TBN * w.FoamNormal );
    const vec3  foamLit = w.FoamAlbedo * ( sun * max( dot( foamN, L ), 0.0 ) / kWaterPi + DesertAmbientIrradiance( foamN ) );

    // --- THE SURFACE SEEN FROM BELOW (WATER-UNDERWATER; UE SingleLayerWater's back face): the eye is in the water,
    // so the interface refracts the air above into Snell's window (the sky and the scene over the water, bent toward
    // the zenith) and past the critical angle (48.6 deg off the normal) reflects the water below in full (total
    // internal reflection). Then the same medium as the underwater volume (Water/WaterUnderwater.glslh) from the eye
    // to the surface. No shore fade and no air fog: the eye is under the water.
    if ( !gl_FrontFacing )
    {
        // N faces the eye (WaterFacingNormal): down, into the water. Water to air: eta = 1.333 / 1.0.
        const vec3  up     = -V;
        const vec3  T      = refract( up, N, 1.333 );
        const bool  tir    = dot( T, T ) < 1e-6;
        const float F0w    = 0.0204; // ((1.333 - 1) / (1.333 + 1))^2
        const float cosAir = tir ? 0.0 : clamp( dot( T, -N ), 0.0, 1.0 );
        const float Fw     = tir ? 1.0 : F0w + ( 1.0 - F0w ) * pow( 1.0 - cosAir, 5.0 );

        // What the window lets through: the scene over the water where the bent ray meets it (the opaque copy at
        // that point's projection, when it is in view and above the water), else the sky along the bent ray; plus
        // the sun's disc seen through the rough interface.
        vec3 window = vec3( 0.0 );
        if ( !tir )
        {
            window = ApplySkyGain(
                          textureLod( EnvironmentSpecularTexture, SkyLookDirection( T, skyLook.YawCosSin.xy ), 0.0 ).rgb,
                          skyLook.Gain.rgb ) *
                     exposure;
            if ( baseDev > 0.0 && baseBack.y > i.WorldPosition.y )
            {
                const vec3 aboveAt = i.WorldPosition + T * distance( i.WorldPosition, baseBack );
                const vec4 aClip   = cameraUB.JitteredViewProjection * vec4( aboveAt, 1.0 );
                const vec2 aUv     = vec2( 0.5, -0.5 ) * ( aClip.xy / aClip.w ) + 0.5;
                if ( aClip.w > 0.0 && all( greaterThanEqual( aUv, vec2( 0.0 ) ) ) && all( lessThanEqual( aUv, vec2( 1.0 ) ) ) )
                {
                    const float aDev = texture( WaterSceneDepth, aUv ).r;
                    if ( aDev > 0.0 && WaterWorldAt( aUv, aDev ).y > i.WorldPosition.y )
                        window = texture( SceneColorTexture, aUv ).rgb; // pre-exposed
                }
            }
            const float r2   = max( s.Roughness * s.Roughness, 2e-3 );
            const float lobe = exp( ( dot( T, L ) - 1.0 ) / r2 ) / ( kWaterPi * r2 );
            window += sunLit * sunShadow * lobe * exposure;
        }
        // What the interface reflects back down: the water itself (its light scattered at the surface, looking down).
        const vec3 sigmaSw  = w.ScatteringCoefficients;
        const vec3 sigmaTw  = max( w.AbsorptionCoefficients + sigmaSw, vec3( 1e-5 ) );
        const vec3 skyIrrW  = DesertAmbientIrradiance( vec3( 0.0, 1.0, 0.0 ) );
        const vec3 mirrored = UnderwaterInscatterRadiance( sigmaSw, sigmaTw, w.PhaseG, reflect( up, N ), L, sun,
                                                           skyIrrW, 0.0 ) *
                              exposure;
        vec3 under = window * ( 1.0 - Fw ) + mirrored * Fw;
        // The foam on top, seen against the light: its lit layer over the window.
        under = mix( under, foamLit * exposure, foam );
        // The medium from the eye up to the surface.
        vec3       fogIn;
        const vec3 fogT = UnderwaterSegment( sigmaSw, sigmaTw, w.PhaseG, up,
                                             max( i.WorldPosition.y - i.CameraPosition.y, 0.0 ),
                                             distance( i.CameraPosition, i.WorldPosition ), L, sun, skyIrrW, fogIn );
        oColor = vec4( under * fogT + fogIn * exposure, 1.0 );
        if ( w.DebugFoamMask > 0.5 )
            oColor = vec4( vec3( amount ) * exposure * 4.0, 1.0 );
        oVelocity             = DesertVelocity( v_Surface.Clip, v_Surface.PrevClip, v_Surface.ObjectMoved );
        oThinGeometryCoverage = kThinGeometryCoverageSurface;
        return;
    }

    // --- The shore: the water column goes to zero where the surface meets the ground, and the surface thins into the
    // unbent scene behind it.
    // A river's surface also fades in over the bank mask's bilinear edge (WATER_RIVER_BANK_CLIP = the clip line,
    // WaterOutsideBank; 1 a half 50 cm texel inside), so the clip is never a hard edge where the bank's ground stands
    // below the baked level.
    const float bankFade = i.VertexColor.b > 0.5 && !WaterTileIsFall( i.VertexColor.b )
                               ? smoothstep( WATER_RIVER_BANK_CLIP, 1.0, WaterFlowAt( i.WorldPosition.xz ).z )
                               : 1.0;
    // Where the column runs out the surface is a film, then nothing.
    const float shore    = ( fall ? sheet.Opacity : 1.0 - exp( -baseDown / kWaterFilmCm ) ) * bankFade;
    const vec3  plain = texture( SceneColorTexture, uv ).rgb;

    oColor = vec4( mix( plain, mix( water, foamLit * exposure * fog.a + fog.rgb, foam ), shore ), 1.0 );
    if ( w.DebugFoamMask > 0.5 )
        oColor = vec4( vec3( amount ) * exposure * 4.0, 1.0 ); // the physics mask alone: white = foam, black = water
    oVelocity             = DesertVelocity( v_Surface.Clip, v_Surface.PrevClip, v_Surface.ObjectMoved );
    oThinGeometryCoverage = kThinGeometryCoverageSurface;
}
