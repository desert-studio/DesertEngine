// Surface cell pass: the virtual shadow map's casters ("VSM: Raster", MeshRenderer::AddVirtualShadowRasterPasses; UE:
// the VSM page raster of a non-Nanite mesh, VirtualShadowMapPageCacheCommon / ShadowDepthPixelShader.usf with
// VIRTUAL_TEXTURE_TARGET). The pass has NO attachment (RDG PassBuilder::RenderArea, 16384 x 16384): the fragment maps
// its virtual texel to the page the page table gives it and atomic-maxes its depth into the physical pool
// (Common/VirtualShadowRaster.glslh, shared with the terrain's caster).
//
// The vertex stage is the ShadowDepth cell's (DESERT_SURFACE_CASTER_PASS: the caster matrix of the level in the camera
// block, the slope bias), so the rasterised depth is the level's standard-Z clip depth, 0 toward the sun.
//
// An opaque template's cell reads no varyings and evaluates no surface; a Masked one evaluates the surface for its
// clip first, as Pass_ShadowDepth does.
#ifdef DESERT_SURFACE_VIRTUAL_GEOMETRY
// "VSM: Raster VirtualGeometry" rasters the clusters of every level and both layers in one pass: the level and the
// layer are the cluster's cut view's (Common/VirtualShadowMap.glslh VsmCutViewLevel / VsmCutViewLayer), handed down
// by the vertex stage (Mesh/Surface/Vertex_Static.glslh v_VsmCutView): a still cluster writes both layers of a page
// whose cached layer is redrawn, a swaying one the merged layer of every drawn page.
layout( location = 15 ) flat in uint v_VsmCutView;
#define VSM_RASTER_LEVEL VsmCutViewLevel( v_VsmCutView, uint( Frame.Lod.y ) )
#define VSM_RASTER_LAYER VsmCutViewLayer( v_VsmCutView, uint( Frame.Lod.y ) )
#endif
#include <Common/VirtualShadowRaster.glslh>

#ifdef DESERT_SURFACE_HAS_VARYINGS
DESERT_SURFACE_VARYINGS( in )
#endif

void main()
{
#ifdef DESERT_SURFACE_HAS_VARYINGS
    // A binned cell (and its `.VirtualGeometry` twin) reads the material row its vertex stage resolved: without it
    // `Material` is row 0, so a Masked caster clipped with another material's mask and cutoff.
    DESERT_SURFACE_BEGIN_FRAGMENT();
#endif
#if defined( DESERT_SURFACE_MASKED ) || defined( DESERT_SURFACE_PARALLAX )
    const SurfaceInput i = DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, DESERT_SURFACE_VARYING_TBN,
                                               v_Surface.UV1, DESERT_SURFACE_VARYING_VERTEX_COLOR, gl_FrontFacing );
    DESERT_SURFACE_CLIP( i );
#endif
#ifdef DESERT_SURFACE_PARALLAX
    // A `.Parallax` cell stores the relief's depth (Pixel Depth Offset, Mesh/Surface/SurfaceParallax.glslh), so the
    // page holds what the cascades and the view see.
    VsmRasterWriteDepth( DesertPixelDepthOffsetDepth( i, EvaluateSurface( i ) ) );
#else
    VsmRasterWrite();
#endif
}
