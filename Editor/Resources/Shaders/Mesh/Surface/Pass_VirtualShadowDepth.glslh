// Surface cell pass: the virtual shadow map's casters ("VSM: Raster", MeshRenderer::VirtualShadowRasterPasses; UE:
// the VSM page raster of a non-Nanite mesh, VirtualShadowMapPageCacheCommon / ShadowDepthPixelShader.usf with
// VIRTUAL_TEXTURE_TARGET). The pass has NO attachment (RDG PassBuilder::RenderArea, 16384 x 16384): the fragment maps
// its virtual texel to the page the page table gives it and atomic-maxes its depth into the physical pool. Only a
// page that is allocated, dirty and requested this frame is written - "VSM: Clear Pages" cleared exactly those; a
// clean page keeps its cached depth and a page no pixel asked for has no physical page.
//
// The vertex stage is the ShadowDepth cell's (DESERT_SURFACE_CASTER_PASS: the caster matrix of the level in the camera
// block, the slope bias), so the rasterised depth is the level's standard-Z clip depth, 0 toward the sun. The pool
// stores 1 - depth so the atomic max keeps the occluder nearest the sun and a cleared texel (0) reads as no occluder
// (VirtualShadowMapProject: occluder = 1 - bits).
//
// An opaque template's cell reads no varyings and evaluates no surface; a Masked one evaluates the surface for its
// clip first, as Pass_ShadowDepth does.
#include <Common/VirtualShadowMap.glslh>

layout( std430, binding = 40 ) restrict readonly buffer VsmFrameData
{
    VsmFrame u_Frame;
    VsmLevel u_Levels[];
};
layout( std430, binding = 41 ) restrict readonly buffer VsmPageTable
{
    VsmPageEntry u_Entries[];
};
layout( binding = 42, r32ui ) restrict uniform uimage2D u_PhysicalPool;
// The level this draw rasterizes (VirtualShadowMapFrame::RasterLevel): x = level index.
layout( std430, binding = 43 ) restrict readonly buffer VsmRasterLevel
{
    uvec4 u_RasterLevel;
};

#ifdef DESERT_SURFACE_HAS_VARYINGS
DESERT_SURFACE_VARYINGS( in )
#endif

void main()
{
#ifdef DESERT_SURFACE_MASKED
    const SurfaceInput i = DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, v_Surface.TBN,
                                               v_Surface.UV1, v_Surface.VertexColor, gl_FrontFacing );
    DESERT_SURFACE_CLIP( i );
#endif
    // The engine's viewport is flipped (negative height, VulkanRdgBackend::BeginRenderPass), so framebuffer y runs
    // down while the map's texel y (VsmProject: (clip.y * 0.5 + 0.5) * resolution) runs up.
    const ivec2 texel = ivec2( int( gl_FragCoord.x ), int( VSM_VIRTUAL_RESOLUTION - gl_FragCoord.y ) );
    if ( any( lessThan( texel, ivec2( 0 ) ) ) || any( greaterThanEqual( texel, ivec2( int( VSM_VIRTUAL_RESOLUTION ) ) ) ) )
        return;
    const uint         level = u_RasterLevel.x;
    const VsmPageEntry entry = u_Entries[VsmEntryIndex( level, u_Levels[level].Window.xy + texel / int( VSM_PAGE_SIZE ) )];
    const uint         drawn = VSM_FLAG_ALLOCATED | VSM_FLAG_DIRTY | VSM_FLAG_REQUESTED;
    if ( ( entry.Flags & drawn ) != drawn )
        return;
    imageAtomicMax( u_PhysicalPool, VsmPoolPageOrigin( entry.Physical ) + ( texel & ivec2( int( VSM_PAGE_SIZE ) - 1 ) ),
                    floatBitsToUint( 1.0 - clamp( gl_FragCoord.z, 0.0, 1.0 ) ) );
}
