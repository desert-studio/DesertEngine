// Surface cell pass: the virtual shadow map's casters ("VSM: Raster", MeshRenderer::AddVirtualShadowRasterPasses; UE:
// the VSM page raster of a non-Nanite mesh, VirtualShadowMapPageCacheCommon / ShadowDepthPixelShader.usf with
// VIRTUAL_TEXTURE_TARGET). The pass has NO attachment (RDG PassBuilder::RenderArea, 16384 x 16384): the fragment maps
// its virtual texel to the page the page table gives it and atomic-maxes its depth into the physical pool
// (Common/VirtualShadowRaster.glslh, shared with the terrain's caster).
//
// The vertex stage is the ShadowDepth cell's (DESERT_SURFACE_CASTER_PASS: the caster matrix of the level in the camera
// block, the slope bias), so the rasterised depth is the level's standard-Z clip depth, 0 toward the sun.
//
// An opaque template's cell reads no varyings and evaluates no surface; a Masked one evaluates the surface for its
// clip first, as Pass_ShadowDepth does.
#include <Common/VirtualShadowRaster.glslh>

#ifdef DESERT_SURFACE_HAS_VARYINGS
DESERT_SURFACE_VARYINGS( in )
#endif

void main()
{
#ifdef DESERT_SURFACE_MASKED
    const SurfaceInput i = DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, v_Surface.TBN,
                                               v_Surface.UV1, v_Surface.VertexColor, gl_FrontFacing );
    DESERT_SURFACE_CLIP( i );
#endif
    VsmRasterWrite();
}
