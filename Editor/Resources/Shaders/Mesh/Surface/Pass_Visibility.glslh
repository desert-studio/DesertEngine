// Surface cell pass: THE VISIBILITY BUFFER RASTER (GRASS-VIS, MeshRenderer "Grass: Visibility Raster"; UE 5 Nanite's
// programmable raster into VisBuffer64, NaniteRasterizer.usf WritePixel). No colour attachment: the view's depth is
// bound read-only and tested before this stage runs (early fragment tests, nothing written), so a blade behind the
// opaque scene costs no atomic; a surviving fragment of a Masked template clips by the material's own opacity mask
// (DESERT_SURFACE_CLIP, the line every masked cell clips with), then atomic-maxes its reversed-Z depth over its
// raster-stream row and triangle into the pixel's word (Common/VisibilityBuffer.glslh). The nearest blade wins the
// word whatever order the draws ran in: no overdraw is ever SHADED - the material runs once per pixel, in the
// resolve (Pass_VisibilityResolve.glslh).
#include <Common/MaterialTransport.glslh>
#include <Common/VisibilityBuffer.glslh>

layout( early_fragment_tests ) in;

DESERT_SURFACE_VARYINGS( in )
layout( location = 15 ) flat in uint v_VisibilityRow;

void main()
{
    DESERT_SURFACE_BEGIN_FRAGMENT();
#ifdef DESERT_SURFACE_MASKED
    const SurfaceInput i = DesertSurfaceInput( v_Surface.WorldPosition, v_Surface.Normal, v_Surface.UV0, DESERT_SURFACE_VARYING_TBN,
                                               v_Surface.UV1, DESERT_SURFACE_VARYING_VERTEX_COLOR, gl_FrontFacing );
    // FPS-GRASS-COST: the mask fetch only for a fragment that can still win its word. The UV's gradients are taken
    // here, in uniform control flow (a quad whose neighbour leaves below has no implicit derivative), scaled by the
    // view's material bias as SurfaceSampleMaterial's bias form scales the level; a fragment behind its pixel's
    // nearest blade (the field's overdraw) skips the fetch and the atomic - the word is the one it would have been.
    const vec2  maskUV   = DesertSurfaceOpacityMaskUV( i );
    const float mipScale = exp2( cameraUB.MaterialMipBias );
    const vec2  maskDx   = dFdxCoarse( maskUV ) * mipScale;
    const vec2  maskDy   = dFdyCoarse( maskUV ) * mipScale;
    if ( DesertVisibilityHidden( ivec2( gl_FragCoord.xy ), gl_FragCoord.z ) )
        return;
    if ( DesertSurfaceOpacityMaskGrad( maskUV, maskDx, maskDy ) < DESERT_SURFACE_CLIP_THRESHOLD() )
        discard;
#endif
    // A row holds 128 triangles of one instance: a blade strip has fewer (its row is v_VisibilityRow), a mesh
    // instance's draw one row per 128 of its triangles (GRASS-VIS-MESH-1, Mesh/Surface/GrassMeshVisibility.glslh).
    const uint primitive = uint( gl_PrimitiveID );
    DesertWriteVisibility( ivec2( gl_FragCoord.xy ), gl_FragCoord.z, v_VisibilityRow + ( primitive >> kVisTriangleBits ),
                           primitive & kVisTriangleMask );
}
