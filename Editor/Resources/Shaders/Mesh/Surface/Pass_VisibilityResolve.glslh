// Surface cell pass: THE VISIBILITY BUFFER RESOLVE (GRASS-VIS, MeshRenderer "Grass: Visibility Resolve"; UE 5 Nanite's
// material pass over VisBuffer64, NaniteVertexFactory.ush FetchNaniteMaterialPixelParameters + the base pass PS).
// Two triangles per tile holding the variety's rows (Vertex_GrassBlade.glslh's resolve branch; FPS-GRASS-RESOLVE
// tiles, Common/VisibilityTiles.glslh - a tile it misses runs no fragment) into the G-buffer: a pixel
// whose word (Common/VisibilityBuffer.glslh) names a row of THIS variety (Blade.Visibility.x, + its capacity) rebuilds
// the blade triangle that won it - the same BladeAt the raster placed it with, the same wind push, the level from the
// bucket table - takes the perspective-correct barycentrics of the pixel centre, evaluates the surface ONCE and
// writes the texel through the G-buffer's one writer (GBufferOutputs.glslh). No depth is written here
// (FPS-GRASS-RESOLVE, UE Nanite's material pass): the pass's depth target is the material depth
// ("Grass: Visibility Material Depth", Common/VisibilityTiles.glslh DesertVisibilityMaterialDepth), tested EQUAL
// against the section's own value before this stage runs, so another section's pixel and a pixel a nearer mesh
// holds never reach it; the words' depth reaches the G-buffer depth through "Grass: Visibility Depth
// Post-Occlusion". The row checks below stay as the guard of the bounds they index. Texture LOD: the analytic gradient of UV0 across one pixel (g_DesertVisibilityUVdx / dy, read by
// SurfaceTypes.glslh SurfaceSampleMaterial) - a quad of this pass spans several blades, its implicit derivatives
// would not be the surface's.
#include <Common/MaterialTransport.glslh>
#define DESERT_VISIBILITY_READ_ONLY // the resolve reads the words (and its vertex stage the tiles), writes none
#include <Common/VisibilityBuffer.glslh>

layout( std430, binding = 17 ) readonly buffer InstanceTransforms
{
    mat4 transforms[];
};
#ifdef DESERT_SURFACE_INSTANCE_IDS
// The camera's list of ids (GPU-COST-22, as Vertex_GrassBlade.glslh): a row names a SLOT of it (the raster wrote
// Visibility.x + its instance index), the slot the blade's row of InstanceTransforms.
layout( std430, binding = 18 ) readonly buffer GpuInstanceIds
{
    uint instanceIds[];
};
#endif
#ifdef DESERT_SURFACE_PATH_GrassBlade
#include <Mesh/Surface/GrassBlade.glslh>
layout( std430, binding = 13 ) readonly buffer GrassBladeShape
{
    GrassBladeShapeData Blade;
};
#else
// The Instanced path (GRASS-VIS-MESH-1): the mesh grass section's rows and its mesh's buffers.
#include <Mesh/Surface/GrassMeshVisibility.glslh>
#include <Common/FoliageWind.glslh>
#include <Mesh/MeshVertexAccess.glslh>
#endif

#ifdef DESERT_SURFACE_WEATHER
#include <Mesh/Surface/SurfaceWeather.glslh>
#endif
// The view's decals (DECALS-DBUFFER, Common/DBuffer.glslh), folded in by the one writer as the raster G-buffer
// cell does: a view that draws decals rasters the words' depth before "Deferred: Decals"
// (SceneRenderer::AddFrameGBuffer, FPS-GRASS-VISBUF-DECALS), so the DBuffer at this pixel is the blade's. A view
// without one binds System.Black and the writer reads nothing (DesertViewHasDBuffer).
#define DESERT_SURFACE_DBUFFER_RECEIVE
#include <Mesh/Surface/GBufferOutputs.glslh>

// Perspective-correct barycentrics of the pixel at @p ndc in the triangle of clip positions @p c0..c2.
vec3 VisibilityBarycentrics( const vec4 c0, const vec4 c1, const vec4 c2, const vec2 ndc )
{
    const vec2  p0 = c0.xy / c0.w, p1 = c1.xy / c1.w, p2 = c2.xy / c2.w;
    const float area = ( p1.x - p0.x ) * ( p2.y - p0.y ) - ( p2.x - p0.x ) * ( p1.y - p0.y );
    if ( abs( area ) < 1.0e-20 )
        return vec3( 1.0, 0.0, 0.0 );
    const float l1 = ( ( ndc.x - p0.x ) * ( p2.y - p0.y ) - ( p2.x - p0.x ) * ( ndc.y - p0.y ) ) / area;
    const float l2 = ( ( p1.x - p0.x ) * ( ndc.y - p0.y ) - ( ndc.x - p0.x ) * ( p1.y - p0.y ) ) / area;
    const vec3  w  = vec3( 1.0 - l1 - l2, l1, l2 ) / vec3( c0.w, c1.w, c2.w );
    return w / ( w.x + w.y + w.z );
}

// A guard, not the rebuild: the pixel centre the raster covered lies in the triangle rebuilt through the raster's own
// projection and viewport (DesertPixelToJitteredNdc) up to float rounding, so its barycentrics are held to the
// triangle - an interpolant (the blade's height share, the material's root occlusion) never extrapolates past a vertex.
vec3 VisibilityInside( const vec3 b )
{
    const vec3 c = max( b, vec3( 0.0 ) );
    return c / max( c.x + c.y + c.z, 1.0e-20 );
}

// The derivative of the perspective-correct barycentrics @p b (VisibilityBarycentrics at this pixel) across one pixel
// in x (@p dbdx) and y (@p dbdy), one pixel being @p pixel in NDC (CameraUB::PixelToNdc.xy, y negative: the
// flipped viewport) (UE Nanite CalculateTriangleDerivatives): taken AT
// the pixel, where the triangle is, never as a difference to the neighbour's centre, which on a blade seen edge-on
// can lie past the vanishing line of the blade's plane, where the perspective division has no value.
void VisibilityBarycentricDerivatives( const vec4 c0, const vec4 c1, const vec4 c2, const vec3 b, const vec2 pixel,
                                       out vec3 dbdx, out vec3 dbdy )
{
    dbdx = vec3( 0.0 );
    dbdy = vec3( 0.0 );
    const vec2  p0 = c0.xy / c0.w, p1 = c1.xy / c1.w, p2 = c2.xy / c2.w;
    const float area = ( p1.x - p0.x ) * ( p2.y - p0.y ) - ( p2.x - p0.x ) * ( p1.y - p0.y );
    if ( abs( area ) < 1.0e-20 )
        return;
    // The screen-space barycentrics l1, l2 of VisibilityBarycentrics are affine in NDC: their gradients, per pixel.
    const vec2 dl1   = vec2( p2.y - p0.y, p0.x - p2.x ) * pixel / area;
    const vec2 dl2   = vec2( p0.y - p1.y, p1.x - p0.x ) * pixel / area;
    const vec2 dl0   = -( dl1 + dl2 );
    // b_k = l_k q_k / S with q_k = 1 / w_k and S = sum l_j q_j = 1 / (b . w): d b_k = (q_k d l_k - b_k dS) / S.
    const vec3  q        = 1.0 / vec3( c0.w, c1.w, c2.w );
    const float inverseS = dot( b, vec3( c0.w, c1.w, c2.w ) );
    const vec2  dS       = q.x * dl0 + q.y * dl1 + q.z * dl2;
    dbdx = ( q * vec3( dl0.x, dl1.x, dl2.x ) - b * dS.x ) * inverseS;
    dbdy = ( q * vec3( dl0.y, dl1.y, dl2.y ) - b * dS.y ) * inverseS;
}

// The change of the unit interpolant normalize( b . (v0, v1, v2) ) when the barycentrics change by @p db.
vec3 VisibilityUnitTurn( const vec3 v0, const vec3 v1, const vec3 v2, const vec3 b, const vec3 db )
{
    const vec3 v  = b.x * v0 + b.y * v1 + b.z * v2;
    const vec3 dv = db.x * v0 + db.y * v1 + db.z * v2;
    const vec3 u  = normalize( v );
    return ( dv - u * dot( u, dv ) ) / length( v );
}

#ifdef DESERT_SURFACE_PATH_GrassBlade
void main()
{
    float depth;
    uint  row, triangle;
    if ( !DesertReadVisibility( ivec2( gl_FragCoord.xy ), depth, row, triangle ) )
        discard;
    // The variety owns rows [x, x + w) (GrassRenderer::PrepareVariety): the mesh grass's rows follow in the same
    // stream (GRASS-VIS-MESH-1), so a row past w is another section's, never this blade's - the ids' length is
    // no bound (a list's buffer may hold more than the variety's rows).
    if ( row < Blade.Visibility.x || row - Blade.Visibility.x >= Blade.Visibility.w )
        discard;
    const uint instance = row - Blade.Visibility.x;
#ifdef DESERT_SURFACE_INSTANCE_IDS
    // CPU-GRASS-POOL-6: the ids are the shared pool's (binding 18 is the whole pool), the camera list's slot
    // `instance` lies at Lists.x + instance; the id is absolute in the instances pool (UE GPUScene's InstanceId).
    const uint idSlot = Blade.Lists.x + instance;
    if ( idSlot >= uint( instanceIds.length() ) )
        discard;
    const mat4 model    = transforms[instanceIds[idSlot]];
#else
    if ( instance >= uint( transforms.length() ) )
        discard;
    const mat4 model    = transforms[instance];
#endif
    const uint segments = BladeLevelSegments( Blade, instance );
    vec2       corner[3];
    BladeTriangleCorners( segments, triangle, corner[0], corner[1], corner[2] );
    const vec4 windPrev = vec4( m_PushConstants.WindB.x, m_PushConstants.WindB.z, 0.0, 0.0 );
    BladePoint point[3];
    vec3       previous[3];
    vec4       jittered[3];
    for ( int k = 0; k < 3; ++k )
    {
        point[k]    = BladeAt( Blade, model, corner[k].x, corner[k].y, m_PushConstants.WindA, m_PushConstants.WindB );
        previous[k] = BladeAt( Blade, model, corner[k].x, corner[k].y, m_PushConstants.WindA, windPrev ).Position;
        jittered[k] = cameraUB.JitteredViewProjection * vec4( point[k].Position, 1.0 );
    }

    // The pixel centre and its two neighbours in NDC through the raster's own viewport (DesertPixelToJitteredNdc: its
    // origin and flipped y, one pixel PixelToNdc.xy), so UV0's gradient across one pixel is analytic.
    const vec2 ndc   = DesertPixelToJitteredNdc( gl_FragCoord.xy );
    const vec2 pixel = cameraUB.PixelToNdc.xy;
    const vec3 b     = VisibilityInside( VisibilityBarycentrics( jittered[0], jittered[1], jittered[2], ndc ) );
    const vec3 bx    = VisibilityBarycentrics( jittered[0], jittered[1], jittered[2], ndc + vec2( pixel.x, 0.0 ) );
    const vec3 by    = VisibilityBarycentrics( jittered[0], jittered[1], jittered[2], ndc + vec2( 0.0, pixel.y ) );

    const vec4 card = BladeCard( Blade, model[0].w );
    vec2       uv[3];
    vec3       normal[3];
    for ( int k = 0; k < 3; ++k )
    {
        uv[k]     = BladeCardUV( card, corner[k].x, corner[k].y );
        normal[k] = BladeNormal( point[k], corner[k].x );
    }
    const vec2 uv0 = b.x * uv[0] + b.y * uv[1] + b.z * uv[2];
    g_DesertVisibilityUVdx = ( bx.x * uv[0] + bx.y * uv[1] + bx.z * uv[2] ) - uv0;
    g_DesertVisibilityUVdy = ( by.x * uv[0] + by.y * uv[1] + by.z * uv[2] ) - uv0;

    const vec3 position = b.x * point[0].Position + b.y * point[1].Position + b.z * point[2].Position;
    const vec3 n        = normalize( b.x * normal[0] + b.y * normal[1] + b.z * normal[2] );
    const vec3 right    = normalize( b.x * point[0].Right + b.y * point[1].Right + b.z * point[2].Right );
    const vec3 along    = normalize( b.x * point[0].Along + b.y * point[1].Along + b.z * point[2].Along );
    // The TBN's turn across one pixel (GBufferOutputs.glslh g_DesertVisibilityTBNdx, the specular AA's footprint).
    vec3 dbdx, dbdy;
    VisibilityBarycentricDerivatives( jittered[0], jittered[1], jittered[2], b, pixel, dbdx, dbdy );
    g_DesertVisibilityTBNdx =
         mat3( VisibilityUnitTurn( point[0].Right, point[1].Right, point[2].Right, b, dbdx ),
               VisibilityUnitTurn( point[0].Along, point[1].Along, point[2].Along, b, dbdx ),
               VisibilityUnitTurn( normal[0], normal[1], normal[2], b, dbdx ) );
    g_DesertVisibilityTBNdy =
         mat3( VisibilityUnitTurn( point[0].Right, point[1].Right, point[2].Right, b, dbdy ),
               VisibilityUnitTurn( point[0].Along, point[1].Along, point[2].Along, b, dbdy ),
               VisibilityUnitTurn( normal[0], normal[1], normal[2], b, dbdy ) );
    const float t       = b.x * corner[0].y + b.y * corner[1].y + b.z * corner[2].y;
    // The raster's facing (two-sided blades): the triangle's winding as the jittered projection put it on screen.
    const vec2 s0 = jittered[0].xy / jittered[0].w, s1 = jittered[1].xy / jittered[1].w,
               s2 = jittered[2].xy / jittered[2].w;
    const bool frontFacing = ( ( s1.x - s0.x ) * ( s2.y - s0.y ) - ( s2.x - s0.x ) * ( s1.y - s0.y ) ) > 0.0;

    // The vertex stage's interpolants (Vertex_GrassBlade.glslh), at this pixel.
    SurfaceInput i = DesertSurfaceInput( position, n, uv0, mat3( right, along, n ), vec2( model[2].w, t ), vec4( 1.0 ),
                                         frontFacing );
#ifdef DESERT_SURFACE_WEATHER
    i.ObjectScaleUp       = 1.0;
    const SurfaceOutput s = DesertApplySurfaceWeather( i, EvaluateSurface( i ) );
#else
    const SurfaceOutput s = EvaluateSurface( i );
#endif
    const vec3 prevPosition = b.x * previous[0] + b.y * previous[1] + b.z * previous[2];
    DesertWriteGBuffer( i, s, cameraUB.ViewProjection * vec4( position, 1.0 ),
                        cameraUB.PrevViewProjection * vec4( prevPosition, 1.0 ), 0.0,
                        ( m_PushConstants.PrimitiveFlags & DESERT_PRIMITIVE_FLAG_NO_CONTACT_SHADOW ) == 0u );
}
#else
// THE INSTANCED PATH'S RESOLVE (GRASS-VIS-MESH-1; UE 5 Nanite's FetchNaniteMaterialPixelParameters over a mesh's
// own index and vertex buffers): the row names a slot of the section's list and a block of 128 triangles of the
// level and submesh it drew (GrassMeshVisibility.glslh); the triangle's three vertices are fetched from the mesh's
// buffers and placed by the same InstancedWorldPosition and wind the raster drew them with
// (Vertex_Instanced.glslh), then interpolated at the pixel centre as that stage's interpolants would be.
void main()
{
    float depth;
    uint  row, triangle;
    if ( !DesertReadVisibility( ivec2( gl_FragCoord.xy ), depth, row, triangle ) )
        discard;
    const uint perInstance = MeshRows.Visibility.y;
    if ( perInstance == 0u || row < MeshRows.Visibility.x )
        discard;
    const uint local = row - MeshRows.Visibility.x;
    const uint slot  = local / perInstance;
    if ( slot >= MeshRows.Slots.x )
        discard; // another section's row
    const uint inside = local - slot * perInstance;
#ifdef DESERT_SURFACE_INSTANCE_IDS
    // CPU-GRASS-POOL-6: the section's slot in the shared ids pool is the camera list's first (Slots.y) + slot.
    const uint idSlot = MeshRows.Slots.y + slot;
    if ( idSlot >= uint( instanceIds.length() ) )
        discard;
    const uint instance = instanceIds[idSlot];
#else
    const uint instance = slot;
#endif
    const uint prevInstance = instance + floatBitsToUint( m_PushConstants.WindB.w );
    if ( instance >= uint( transforms.length() ) || prevInstance >= uint( transforms.length() ) )
        discard;
    const mat4 model     = transforms[instance];
    const mat4 prevModel = transforms[prevInstance];

    // The level the slot was drawn with, then this section's submesh whose rows hold `inside`.
    const uint level   = GrassMeshVisibilityLevel( slot );
    const uint count   = min( MeshRows.Visibility.w, GRASS_MESH_VISIBILITY_MAX_SUBMESHES );
    uint       submesh = count;
    uvec4      range   = uvec4( 0u );
    for ( uint s = 0u; s < count; ++s )
    {
        const uint r = level * MeshRows.Visibility.w + s;
        if ( MeshRows.Submeshes[s].z == 0u || r >= GRASS_MESH_VISIBILITY_MAX_RANGES )
            continue;
        const uvec4 candidate = MeshRows.Ranges[r];
        const uint  rows      = ( candidate.y + kVisTriangleMask ) >> kVisTriangleBits;
        if ( inside >= candidate.z && inside - candidate.z < rows )
        {
            submesh = s;
            range   = candidate;
            break;
        }
    }
    if ( submesh >= count )
        discard;
    const uint primitive = ( ( inside - range.z ) << kVisTriangleBits ) + triangle;
    if ( primitive >= range.y )
        discard;

    // The triangle's vertices (Desert::Vertex: position 0, normal 12, tangent 24, bitangent 36, UV 48; the streams:
    // RGBA8 colour 0, UV1 4), placed as the raster placed them.
    const uvec2 vertexAddress = MeshRows.Geometry[0].xy;
    const uvec2 streamAddress = MeshRows.Geometry[0].zw;
    const uvec2 indexAddress  = MeshRows.Geometry[1].xy;
    const uint  vertexStride  = MeshRows.Geometry[1].z;
    const uint  streamStride  = MeshRows.Geometry[1].w;
    const vec4  windPrev      = vec4( m_PushConstants.WindB.x, m_PushConstants.WindB.z, 0.0, 0.0 );
    // The normal matrix as the cofactor matrix of the model's 3x3 (transpose( inverse ) x det: three cross
    // products, no inverse or division per pixel - FPS-GRASS-RESOLVE), signed by det so a mirrored instance's
    // normals face as the inverse's would; every use is normalized, so the dropped 1 / |det| changes nothing.
    const mat3  linear        = mat3( model );
    const mat3  cofactor      = mat3( cross( linear[1], linear[2] ), cross( linear[2], linear[0] ),
                                      cross( linear[0], linear[1] ) );
    const mat3  normalMatrix  = dot( linear[0], cofactor[0] ) < 0.0 ? -cofactor : cofactor;
    vec3        world[3];
    vec3        previous[3];
    vec4        jittered[3];
    vec3        normal[3];
    vec3        tangent[3];
    vec3        bitangent[3];
    vec2        uv[3];
    vec2        uv1[3];
    vec4        colour[3];
    for ( int k = 0; k < 3; ++k )
    {
        const uint index =
             GrassMeshUint( GrassMeshAddressAdd( indexAddress, ( range.x + primitive * 3u + uint( k ) ) * 4u ) ) +
             MeshRows.Submeshes[submesh].x;
        const uvec2 at     = GrassMeshAddressAdd( vertexAddress, index * vertexStride );
        const uvec2 stream = GrassMeshAddressAdd( streamAddress, index * streamStride );
        const vec3  local3 = GrassMeshVec3( at, 0u );
        world[k]     = InstancedWorldPosition( model, local3, m_PushConstants.WindA, m_PushConstants.WindB );
        previous[k]  = InstancedWorldPosition( prevModel, local3, m_PushConstants.WindA, windPrev );
        jittered[k]  = cameraUB.JitteredViewProjection * vec4( world[k], 1.0 );
        normal[k]    = normalize( normalMatrix * GrassMeshVec3( at, 12u ) );
        tangent[k]   = normalize( normalMatrix * GrassMeshVec3( at, 24u ) );
        bitangent[k] = normalize( normalMatrix * GrassMeshVec3( at, 36u ) );
        uv[k]        = DesertMeshTextureUV( GrassMeshVec2( at, 48u ) );
        // A mesh without streams reads the defaults (MeshVertexStreams: white, UV1 0,0), as the raster's binding 1.
        colour[k] = vec4( 1.0 );
        uv1[k]    = DesertMeshTextureUV( vec2( 0.0 ) );
        if ( streamAddress != uvec2( 0u ) )
        {
            colour[k] = unpackUnorm4x8( GrassMeshUint( stream ) );
            uv1[k]    = DesertMeshTextureUV( GrassMeshVec2( stream, 4u ) );
        }
    }

    // The pixel centre and its two neighbours in NDC, as the blade's resolve: UV0's gradient across one pixel.
    const vec2 ndc   = DesertPixelToJitteredNdc( gl_FragCoord.xy );
    const vec2 pixel = cameraUB.PixelToNdc.xy;
    const vec3 b     = VisibilityInside( VisibilityBarycentrics( jittered[0], jittered[1], jittered[2], ndc ) );
    const vec3 bx    = VisibilityBarycentrics( jittered[0], jittered[1], jittered[2], ndc + vec2( pixel.x, 0.0 ) );
    const vec3 by    = VisibilityBarycentrics( jittered[0], jittered[1], jittered[2], ndc + vec2( 0.0, pixel.y ) );
    const vec2 uv0 = b.x * uv[0] + b.y * uv[1] + b.z * uv[2];
    g_DesertVisibilityUVdx = ( bx.x * uv[0] + bx.y * uv[1] + bx.z * uv[2] ) - uv0;
    g_DesertVisibilityUVdy = ( by.x * uv[0] + by.y * uv[1] + by.z * uv[2] ) - uv0;

    const vec3 position = b.x * world[0] + b.y * world[1] + b.z * world[2];
    const vec3 n        = normalize( b.x * normal[0] + b.y * normal[1] + b.z * normal[2] );
    const vec3 t        = normalize( b.x * tangent[0] + b.y * tangent[1] + b.z * tangent[2] );
    const vec3 bt       = normalize( b.x * bitangent[0] + b.y * bitangent[1] + b.z * bitangent[2] );
    // The TBN's turn across one pixel, as the blade's resolve (GBufferOutputs.glslh g_DesertVisibilityTBNdx).
    vec3 dbdx, dbdy;
    VisibilityBarycentricDerivatives( jittered[0], jittered[1], jittered[2], b, pixel, dbdx, dbdy );
    g_DesertVisibilityTBNdx = mat3( VisibilityUnitTurn( tangent[0], tangent[1], tangent[2], b, dbdx ),
                                    VisibilityUnitTurn( bitangent[0], bitangent[1], bitangent[2], b, dbdx ),
                                    VisibilityUnitTurn( normal[0], normal[1], normal[2], b, dbdx ) );
    g_DesertVisibilityTBNdy = mat3( VisibilityUnitTurn( tangent[0], tangent[1], tangent[2], b, dbdy ),
                                    VisibilityUnitTurn( bitangent[0], bitangent[1], bitangent[2], b, dbdy ),
                                    VisibilityUnitTurn( normal[0], normal[1], normal[2], b, dbdy ) );
    const vec2 secondUV = b.x * uv1[0] + b.y * uv1[1] + b.z * uv1[2];
    const vec4 tint     = b.x * colour[0] + b.y * colour[1] + b.z * colour[2];
    // The raster's facing: the triangle's winding as the jittered projection put it on screen (the same carrier,
    // the same test as the blade's resolve).
    const vec2 s0 = jittered[0].xy / jittered[0].w, s1 = jittered[1].xy / jittered[1].w,
               s2 = jittered[2].xy / jittered[2].w;
    const bool frontFacing = ( ( s1.x - s0.x ) * ( s2.y - s0.y ) - ( s2.x - s0.x ) * ( s1.y - s0.y ) ) > 0.0;

    // The vertex stage's interpolants (Vertex_Instanced.glslh's full cell), at this pixel.
    SurfaceInput i = DesertSurfaceInput( position, n, uv0, mat3( t, bt, n ), secondUV, tint, frontFacing );
#ifdef DESERT_SURFACE_WEATHER
    i.ObjectScaleUp       = length( mat3( model )[1] );
    const SurfaceOutput s = DesertApplySurfaceWeather( i, EvaluateSurface( i ) );
#else
    const SurfaceOutput s = EvaluateSurface( i );
#endif
    const vec3 prevPosition = b.x * previous[0] + b.y * previous[1] + b.z * previous[2];
    const float moved       = prevModel != model ? 1.0 : 0.0;
    DesertWriteGBuffer( i, s, cameraUB.ViewProjection * vec4( position, 1.0 ),
                        cameraUB.PrevViewProjection * vec4( prevPosition, 1.0 ), moved,
                        ( m_PushConstants.PrimitiveFlags & DESERT_PRIMITIVE_FLAG_NO_CONTACT_SHADOW ) == 0u );
}
#endif
