#ifndef DESERT_SURFACE_TYPES_GLSLH
#define DESERT_SURFACE_TYPES_GLSLH

// The contract between a surface template and the engine (Core/ShaderCompiler/DShader/DShaderParser.hpp):
// the author writes `SurfaceOutput EvaluateSurface( SurfaceInput )`, the engine's vertex header for the
// path fills the varyings, and the engine's pass header builds the input, calls the function and writes
// the pass's targets. Every cell of every template compiles this file, so it is hashed into their keys.

struct SurfaceInput
{
    vec3 WorldPosition;
    vec3 Normal; // world space, normalized
    vec2 UV0;
};

struct SurfaceOutput
{
    vec3  BaseColor;
    float Metallic;
    float Roughness;
    vec3  Emissive;
    float AmbientOcclusion; // 1 = unoccluded; scales the ambient term only
    float Opacity; // read only by BlendMode Masked, against u_Material.OpacityMaskClipValue
};

// What an author starts from, so a surface that sets only BaseColor still returns a defined value.
SurfaceOutput DefaultSurfaceOutput()
{
    SurfaceOutput s;
    s.BaseColor = vec3( 1.0 );
    s.Metallic  = 0.0;
    s.Roughness = 0.5;
    s.Emissive  = vec3( 0.0 );
    s.AmbientOcclusion = 1.0;
    s.Opacity   = 1.0;
    return s;
}

// The one interface between a cell's two stages; `q` is `out` in the vertex header, `in` in the pass header.
#define DESERT_SURFACE_VARYINGS( q ) \
    layout( location = 0 ) q SurfaceVaryings \
    { \
        vec3 WorldPosition; \
        vec3 Normal; \
        vec2 UV0; \
    } v_Surface;

SurfaceInput DesertSurfaceInput( vec3 worldPosition, vec3 normal, vec2 uv0 )
{
    SurfaceInput i;
    i.WorldPosition = worldPosition;
    i.Normal        = normalize( normal );
    i.UV0           = uv0;
    return i;
}

// BlendMode Masked: the parser defines DESERT_SURFACE_MASKED in the fragment stage and has already refused a
// template without the Float parameter the threshold is read from.
#ifdef DESERT_SURFACE_MASKED
#define DESERT_SURFACE_CLIP( s ) \
    if ( ( s ).Opacity < u_Material.OpacityMaskClipValue ) \
        discard
#else
#define DESERT_SURFACE_CLIP( s )
#endif

#endif
