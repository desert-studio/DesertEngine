#ifndef DESERT_SURFACE_TYPES_GLSLH
#define DESERT_SURFACE_TYPES_GLSLH
#include <Generated/SceneBindings.glslh> // the set-0 slot table (Core::kSceneBindingNames)

// The contract between a surface template and the engine (Core/ShaderCompiler/DShader/DShaderParser.hpp):
// the author writes `SurfaceOutput EvaluateSurface( SurfaceInput )`, the engine's vertex header for the
// path fills the varyings, and the engine's pass header builds the input, calls the function and writes
// the pass's targets. Every cell of every template compiles this file, so it is hashed into their keys.
//
// The parser defines, in BOTH stages of a cell: DESERT_SURFACE_PASS_<Pass> (Forward | GBuffer | ShadowDepth |
// VirtualShadowDepth | Depth - the view's depth prepass, a VIEW pass),
// DESERT_SHADING_MODEL_INDEX (the template's model, a SHADING_MODEL_INDEX_<NAME> of the generated
// Generated/ShadingModels.glslh), for `BlendMode Masked`, DESERT_SURFACE_MASKED and, in the `.Parallax` cells of
// a template that declares `Height <Texture2D> ... Scale(<Float>)`, DESERT_SURFACE_PARALLAX (SurfaceParallax.glslh). The headers shape their declarations on these so each
// cell declares exactly what the shader it replaces declared (SurfaceTemplate holds them equal by reflection).

// The source-to-surface arithmetic a surface function is written in (UV transform, base colour, ORM, normal
// strength, emission, tangent-normal decode) — the same text the lit shaders compiled.
#include <Common/TangentNormal.glslh>
#include <Common/SurfaceInputs.glslh>

// THE MATERIAL TEXTURE FETCH, in one place for every surface template and every graph surface. Only a stage
// that evaluates the surface defines DESERT_SURFACE_SAMPLES_MATERIAL (DShaderParser): a bias argument is a
// fragment-stage form, and an opaque depth cell declares no camera block. MaterialMipBias is the view's
// log2(render / output width) under an upscaler, 0 otherwise (SceneViewState::BeginFrame): a TAAU frame at
// 50 % samples material textures one level sharper, as the output resolution would. Only MATERIAL textures:
// G-buffer, post and screen-space reads are at the render resolution and keep the implicit level.
#ifdef DESERT_SURFACE_SAMPLES_MATERIAL
#include <Common/CameraUB.glslh>
#include <Common/BindlessTextures.glslh>

#if defined( DESERT_SURFACE_PASS_VisibilityResolve )
// THE VISIBILITY RESOLVE (GRASS-VIS, Pass_VisibilityResolve.glslh): a quad of the full-screen pass spans several
// blades, so its implicit derivatives are not the surface's. The pass sets the analytic gradient of UV0 across one
// pixel before it evaluates the surface; a fetch uses it, scaled by the view's material bias as the raster's bias
// form scales it (UE Nanite: analytic UV derivatives in the material pass).
vec2 g_DesertVisibilityUVdx = vec2( 0.0 );
vec2 g_DesertVisibilityUVdy = vec2( 0.0 );
vec4 SurfaceSampleMaterial( BindlessTexture materialTexture, vec2 uv )
{
    const float scale = exp2( cameraUB.MaterialMipBias );
    return SampleBindlessGrad( materialTexture, uv, g_DesertVisibilityUVdx * scale, g_DesertVisibilityUVdy * scale );
}
#elif defined( DESERT_SURFACE_PASS_Hit )
// A ray hit samples at the ray cone's mip (Common/BindlessTextures.glslh RayHitTextureLod, g_DesertRayHitLod).
vec4 SurfaceSampleMaterial( BindlessTexture materialTexture, vec2 uv )
{
    return SampleBindless( materialTexture, uv );
}
#else
// A material texture is its row slot (Material.<name>, a BindlessTexture), read through the bindless table.
vec4 SurfaceSampleMaterial( BindlessTexture materialTexture, vec2 uv )
{
    return SampleBindlessBias( materialTexture, uv, cameraUB.MaterialMipBias );
}
#endif

// A material's normal map: the biased fetch, decoded as Common/TangentNormal.glslh decodes any normal map.
vec3 SurfaceSampleTangentNormal( BindlessTexture normalMap, vec2 uv )
{
    return DecodeTangentNormal( SurfaceSampleMaterial( normalMap, uv ).rg );
}
#endif

// The particle half of the input (UE: the Particle Color / Particle Relative Time / Particle Random material
// expressions, which the sprite vertex factory feeds). Filled by the ParticleSprite vertex path
// (Vertex_ParticleSprite.glslh) from the particle the quad was expanded from; every mesh path gets the
// neutral values below (DesertSurfaceInput), as UE's mesh vertex factories evaluate those expressions to
// their defaults, so one surface function compiles into every cell of a `Usage ParticleSprites` template.
struct SurfaceParticleInput
{
    vec4  Color;        // the particle's simulated colour, linear RGBA (alpha = the over-life alpha)
    float RelativeTime; // age / lifetime in [0, 1]
    float Random;       // [0, 1), constant over the particle's life, different per particle
};

struct SurfaceInput
{
    vec3 WorldPosition;
    vec3 Normal; // world space, normalized: the geometric normal
    vec2 UV0;
    mat3 TBN; // tangent -> world; SurfaceOutput.Normal goes through it
    vec2 UV1;         // the mesh's second UV set; (0,0) when it has none
    vec4 VertexColor; // linear RGBA; white when the mesh has none (UE's VertexColor node)
    // World cm per mesh cm along the object's up axis (the vertex stage's |world * (0,1,0)|; 1 where no object
    // scale applies). A canopy depth is baked in the mesh's cm and read against world quantities through it.
    float ObjectScaleUp;
    // From the view block, not the vertex: the drawing view's eye (world cm; a light's eye in a shadow-depth cell,
    // as UE's View.WorldCameraOrigin in a shadow view) and the world clock in seconds (UE's View.GameTime — the
    // scene's game time, so a paused world holds still; the same value in every view of the frame).
    vec3  CameraPosition;
    float Time;
    SurfaceParticleInput Particle;
};

// Particle SubUV (UE's ParticleSubUV expression): the flipbook cell of a `columns x rows` sheet the particle is at,
// stepped linearly over its life, and the next cell with the fraction between them for an optional frame blend.
// Cells run left to right, top to bottom (UV (0,0) top-left, as every surface UV here).
struct SurfaceSubUV
{
    vec2  UV0;   // the current cell
    vec2  UV1;   // the next cell (the last cell's next is itself)
    float Blend; // 0 = UV0 only, 1 = UV1 only
};

SurfaceSubUV DesertParticleSubUV( SurfaceParticleInput p, vec2 uv, float columns, float rows )
{
    const float cols   = max( floor( columns ), 1.0 );
    const float rws    = max( floor( rows ), 1.0 );
    const float frames = cols * rws;
    const float index  = clamp( p.RelativeTime, 0.0, 1.0 ) * ( frames - 1.0 );
    const float first  = floor( index );
    const float second = min( first + 1.0, frames - 1.0 );
    const vec2  cell   = vec2( 1.0 / cols, 1.0 / rws );

    SurfaceSubUV s;
    s.UV0   = ( vec2( mod( first, cols ), floor( first / cols ) ) + uv ) * cell;
    s.UV1   = ( vec2( mod( second, cols ), floor( second / cols ) ) + uv ) * cell;
    s.Blend = index - first;
    return s;
}

// Depth Fade (UE's DepthFade expression, "soft particles"): @p opacity scaled by how far the scene behind the pixel
// is, over @p fadeDistance CENTIMETRES — 0 where the pixel touches the scene, @p opacity at fadeDistance or more.
// Only the ParticleSprite cell fades by the scene depth (the parser defines DESERT_SURFACE_PARTICLE_SPRITE in both
// stages of that cell); a mesh cell returns the opacity unchanged, as UE's DepthFade does outside translucency.
//
// THE SCENE DEPTH, declared here once for every fragment stage that reads it: the particle sprites (Depth Fade) and
// the Forward cells (opaque and translucent), whose contact shadows march it (Common/ContactShadow.glslh; bound as
// SceneViewInputs::SceneDepth, the opaque G-buffer depth, or a black texture where the view has none). A separate
// texture read through the point-clamped shared state (ParticleRenderer / Graphic::BindSceneViewInputs bind both),
// numbered by the program build (SharedSamplerBinding.hpp).
// A sprite cell declares it only when its surface calls DesertDepthFade (DESERT_SURFACE_DEPTH_FADE, defined by the
// parser like UE's material compiler noting a scene-depth read): an unread shared sampler is refused by the build.
#if defined( DESERT_SURFACE_SAMPLES_MATERIAL ) &&                                                                    \
     ( ( defined( DESERT_SURFACE_PARTICLE_SPRITE ) && defined( DESERT_SURFACE_DEPTH_FADE ) ) ||                      \
       ( defined( DESERT_SURFACE_PASS_Forward ) && !defined( DESERT_SURFACE_PARTICLE_SPRITE ) ) )
Uniform sampler PointClampSampler;
layout( binding = kSceneDepthBinding ) uniform texture2D SceneDepthTexture; // the scene-read range's third slot (ShaderGraphBindings.hpp)
#define SceneDepthTexture sampler2D(SceneDepthTexture, PointClampSampler)
#endif
// THE SCENE SHADING WORD beside it, for the Forward cells only: the contact-shadow ray's hit texel's NO_CONTACT_SHADOW
// bit (UE CastContactShadow( GBuffer ); SceneViewInputs::SceneShadingWord, the G-buffer's, or an integer zero). Read
// with texelFetch through the same point-clamped state.
#if defined( DESERT_SURFACE_SAMPLES_MATERIAL ) && defined( DESERT_SURFACE_PASS_Forward ) &&                          \
     !defined( DESERT_SURFACE_PARTICLE_SPRITE )
layout( binding = kSceneShadingWordBinding ) uniform utexture2D SceneShadingWordTexture; // the range's fourth slot
#define SceneShadingWordTexture usampler2D(SceneShadingWordTexture, PointClampSampler)
#endif

#if defined( DESERT_SURFACE_PARTICLE_SPRITE ) && defined( DESERT_SURFACE_SAMPLES_MATERIAL ) &&                     \
     defined( DESERT_SURFACE_DEPTH_FADE )
#include <Common/ReconstructPosition.glslh>
float DesertDepthFade( vec3 worldPosition, float opacity, float fadeDistance )
{
    const vec2  uv     = gl_FragCoord.xy / vec2( textureSize( SceneDepthTexture, 0 ) );
    const float depth  = texture( SceneDepthTexture, uv ).r;
    // Common/ReconstructPosition.glslh: (0,0) is the top-left pixel and NDC +y is up - the one convention.
    const vec3  scene  = ReconstructWorldPosition( uv, depth, cameraUB.InvJitteredViewProjection );
    const float behind = -( cameraUB.View * vec4( scene, 1.0 ) ).z;
    const float self   = -( cameraUB.View * vec4( worldPosition, 1.0 ) ).z;
    return opacity * clamp( ( behind - self ) / max( fadeDistance, 0.001 ), 0.0, 1.0 );
}
#else
float DesertDepthFade( vec3 worldPosition, float opacity, float fadeDistance )
{
    return opacity;
}
#endif

struct SurfaceOutput
{
    vec3  BaseColor; // linear
    float Metallic;
    float Roughness; // the pass clamps it to 0.04 so the GGX lobe stays finite
    // UE's Specular pin: the dielectric reflectance, F0 = 0.08 x Specular (0.5, the default, = 4 %). It reaches the
    // model through the shading word's 8-bit field (deferred) or quantized the same way (forward).
    float Specular;
    vec3  Emissive;  // linear, HDR, added unlit
    float Opacity;   // read by the translucency passes (BlendMode Translucent / Additive) and the sprite cell
    vec3  Normal;    // TANGENT space, as UE's Normal pin: (0,0,1) is the geometric normal
    float AmbientOcclusion;
    // The sun-shadow receive half the material owns (the renderer zeroes a mesh's row value when its Receive
    // Shadows toggle is off; a template that exposes it forwards Material.ReceiveSunShadows here). < 0.5 =
    // the cascades do not shadow this surface.
    float ReceiveSunShadows;
    // The material-complexity proxy the deferred debug view heat-maps (G-buffer C.w): real textures sampled.
    float SampledTextureCount;
    float Refraction; // index of refraction (UE's Refraction pin), read only by the translucency pass
    // The shading model's payload (UE's GBufferD CustomData.rgba), in [0, 1]: the floats a model's `Payload` block names
    // (ShadingModels/ShadingModelContract.glslh). They reach the model as DesertPayload, through the G-buffer shading word's
    // 8-bit fields in the deferred path and quantized the same way in the forward one.
    float CustomData0;
    float CustomData1;
    float CustomData2;
    float CustomData3;
    // UE's Pixel Depth Offset pin: centimetres along the view ray the pass headers push the fragment's depth, shaded
    // position and velocity (>= 0, away from the eye). Written by SurfaceParallaxOcclusion (SurfaceParallax.glslh) and
    // applied only by a template's `.Parallax` cells; every other cell keeps its rasterised depth.
    float PixelDepthOffset;
    // The relief's own shadow from the main directional light (1 = lit), multiplied into the sun's shadow by the
    // forward pass and, through the G-buffer shading word's SUN_SELF_SHADOW field, by the deferred composite.
    float SunSelfShadow;
};

// UE's Single Layer Water material output (the SingleLayerWaterMaterialOutput node): the water VOLUME under a
// `ShadingModel SingleLayerWater` surface, returned by the template's EvaluateSingleLayerWater and read by
// Pass_SingleLayerWater.glslh alone. Coefficients per METRE, as UE states them.
struct SingleLayerWaterOutput
{
    vec3  ScatteringCoefficients; // 1/m
    vec3  AbsorptionCoefficients; // 1/m
    float PhaseG;                 // Henyey-Greenstein anisotropy of the in-scatter
    vec3  ColorScaleBehindWater;  // tints the scene seen through the water before the absorption
    float RefractionOffset;       // cm the scene behind shifts per unit of the normal's horizontal tilt
    // THE FOAM (UE's water material Foam inputs): where it forms is physics (Pass_SingleLayerWater.glslh: the waves'
    // Jacobian at the crests, the breaker depth at the shore); what it looks like and its thresholds are the
    // material's.
    vec3  FoamAlbedo;             // the foam's diffuse colour (its texture times its tint)
    float FoamCoverage;           // 0..1 the foam texture's structure at this point: where a forming sheet shows
    float FoamJacobianThreshold;  // whitecaps form where the surface's Jacobian falls below this (1 = still)
    float FoamJacobianSoftness;   // the Jacobian range over which the whitecap fades in
    float FoamDecaySeconds;       // e-folding time of foam left behind on the water particle that broke
    float FoamBreakerIndex;       // gamma = H / d at which a wave breaks on the shallows (McCowan 0.78)
    float ShoreFadeCm;            // the water column (cm) over which the surface fades in from where it meets
                                  // the ground (UE's water material depth fade): no hard intersection line
    float DebugFoamMask;          // 1 = draw only the foam mask (white foam, black water) - a debug material
};

// What an author starts from, so a surface that sets only BaseColor still returns a defined value.
SurfaceOutput DefaultSurfaceOutput()
{
    SurfaceOutput s;
    s.BaseColor           = vec3( 1.0 );
    s.Metallic            = 0.0;
    s.Roughness           = 0.5;
    s.Specular            = 0.5;
    s.Emissive            = vec3( 0.0 );
    s.Opacity             = 1.0;
    s.Normal              = vec3( 0.0, 0.0, 1.0 );
    s.AmbientOcclusion    = 1.0;
    s.ReceiveSunShadows   = 1.0;
    s.SampledTextureCount = 0.0;
    s.Refraction          = 1.0;
    s.CustomData0         = 0.0;
    s.CustomData1         = 0.0;
    s.CustomData2         = 0.0;
    s.CustomData3         = 0.0;
    s.PixelDepthOffset    = 0.0;
    s.SunSelfShadow       = 1.0;
    return s;
}

// The two caster passes: a cascade's depth attachment (ShadowDepth) and the virtual shadow map's physical pool
// (VirtualShadowDepth). Both project through the caster matrix with the caster's slope bias and draw a light view.
#if defined( DESERT_SURFACE_PASS_ShadowDepth ) || defined( DESERT_SURFACE_PASS_VirtualShadowDepth )
#define DESERT_SURFACE_CASTER_PASS 1
#endif

// Whether this cell's stages talk at all: a shadow-depth cell of an opaque template writes gl_FragCoord.z
// and nothing else, exactly as Programs/Shadow/Shadow*.shader.
// A parallax cell's caster evaluates the surface too: its depth is the relief's (Pixel Depth Offset), not the flat
// triangle's.
#if !defined( DESERT_SURFACE_CASTER_PASS ) || defined( DESERT_SURFACE_MASKED ) || defined( DESERT_SURFACE_PARALLAX )
#define DESERT_SURFACE_HAS_VARYINGS 1
#endif

// A cell of a VIEW pass (G-buffer, forward, translucent — the camera's own frame) reads its object's motion row and
// hands the fragment stage both unjittered clip positions; a shadow-depth cell draws a light view, which has no
// previous frame, and keeps its world transform in the push block.
#if defined( DESERT_SURFACE_HAS_VARYINGS ) && !defined( DESERT_SURFACE_CASTER_PASS )
#define DESERT_SURFACE_VIEW_PASS 1
#endif

// THE view block (UE's View uniform buffer): one per view per frame, filled from the ViewFrame by its one writer
// (ShaderProtocols::MakeCameraUB). Every vertex header reads it for its matrices; every stage that evaluates the
// surface reads it here for the time and camera position SurfaceInput carries. An opaque depth cell's fragment
// stage evaluates nothing and declares nothing, so its layout stays the shadow casters' (vertex-only block).
#ifdef DESERT_SURFACE_HAS_VARYINGS
#include <Common/CameraUB.glslh>
#endif

// THE BINNED CELL (DESERT_SURFACE_BINNED, the generator's `.Binned` permutation, DShaderParser kSurfaceBinnedCellSuffix):
// the draw is a row of a GPU-driven bin (GpuDriven::DrawCommandCache) and pushes nothing. The vertex stage resolves
// World / PrevWorld / material row / primitive flags from its instance id (Common/GpuScene.glslh DesertResolveMeshDraw)
// and hands the fragment stage the two per-draw words the push block carried (MaterialTransport.glslh MaterialIndex
// and PrimitiveFlags; the flags here in GpuDriven::PrimitiveFlags' layout, DESERT_GPU_PRIMITIVE_*). UE: the primitive
// id the base pass vertex factory forwards to the pixel shader.
#ifdef DESERT_SURFACE_BINNED
#define DESERT_SURFACE_BINNED_VARYINGS \
    flat uint MaterialRow;             \
    flat uint PrimitiveFlags;
#else
#define DESERT_SURFACE_BINNED_VARYINGS
#endif

// The one interface between a cell's two stages; `q` is `out` in the vertex header, `in` in the pass header.
// What only the vertex can know; what the view knows (camera position, time) the fragment reads from the view block.
#define DESERT_SURFACE_VARYINGS( q ) \
    layout( location = 0 ) q SurfaceVaryings \
    { \
        vec3 WorldPosition; \
        vec3 Normal; \
        vec2 UV0; \
        mat3 TBN; \
        vec2 UV1; \
        vec4 VertexColor; \
        vec4 Clip; \
        vec4 PrevClip; \
        flat float ObjectMoved; \
        flat float ObjectScaleUp; \
        DESERT_SURFACE_BINNED_VARYINGS \
    } v_Surface;

// The material row the generated `Material` reads (DShaderParser: `MaterialRows[DESERT_SURFACE_MATERIAL_ROW]`): the
// push block's MaterialIndex, or in a binned cell the row its vertex stage resolved. A global in a binned cell, set
// by DESERT_SURFACE_BEGIN_FRAGMENT() first thing in every pass header's main(): the surface function that reads
// `Material` is compiled before the pass header that declares v_Surface.
#if defined( DESERT_SURFACE_BINNED ) && defined( DESERT_SURFACE_SAMPLES_MATERIAL )
uint g_SurfaceMaterialRow = 0u;
#define DESERT_SURFACE_BEGIN_FRAGMENT() g_SurfaceMaterialRow = v_Surface.MaterialRow
#else
#define DESERT_SURFACE_BEGIN_FRAGMENT()
#endif

// A CANOPY VERTEX (FIELD-WINTER p9). A tree's leaf cards whose normal is its crown's VOLUME normal (UE / SpeedTree
// foliage: the card normals are transferred from a proxy around the crown, so the crown shades and takes snow as one
// volume) carry the canopy in COLOR_0.a: alpha in [0, kDesertCanopyAlphaMax] is a canopy vertex, its depth below the
// crown's top surface = (1 - alpha / kDesertCanopyAlphaMax) * kDesertCanopyDepthRangeCm; a mesh without vertex
// colours reads white (alpha 1) = not a canopy. Derived at the mesh build from MeshImportSettings::Canopy
// (Editor/Import/MeshDeriver.cpp BakeCanopy, whose kCanopyDepthRangeCm / kCanopyAlphaMax equal these).
const float kDesertCanopyDepthRangeCm = 1024.0;
const float kDesertCanopyAlphaMax     = 0.5;

bool DesertIsCanopyVertex( const vec4 vertexColor )
{
    return vertexColor.a <= kDesertCanopyAlphaMax + 0.5 / 255.0;
}

// How far (cm) a canopy vertex hangs below its crown's top surface; 0 for any other vertex.
float DesertCanopyDepthCm( const vec4 vertexColor )
{
    return DesertIsCanopyVertex( vertexColor )
              ? ( 1.0 - clamp( vertexColor.a / kDesertCanopyAlphaMax, 0.0, 1.0 ) ) * kDesertCanopyDepthRangeCm
              : 0.0;
}


#ifdef DESERT_SURFACE_HAS_VARYINGS
SurfaceInput DesertSurfaceInput( vec3 worldPosition, vec3 normal, vec2 uv0, mat3 tbn, vec2 uv1, vec4 vertexColor,
                                 bool frontFacing )
{
    // THE BACK FACE OF A TWO-SIDED MATERIAL faces the viewer through the surface's other side, so its normal is
    // the interpolated one negated (UE MaterialTemplate.ush: `WorldNormal *= TwoSidedSign`, the sign being the
    // facing of a TWO_SIDED draw). Two-sidedness here is the draw's cull state (MeshRenderer::CullPermutation),
    // not a shader permutation, but a one-sided draw culls every back face, so a back-facing fragment can only
    // come from a two-sided one: the fragment's gl_FrontFacing alone is UE's sign. It is passed in because this
    // header is compiled into the vertex stage too, where the built-in does not exist. Without the flip a leaf
    // card seen from behind was lit as the side facing away (no sun, the far hemisphere's ambient, a grazing sky
    // reflection). The whole TBN turns, so a tangent-space normal map lands on the visible side as well.
    // A CANOPY vertex is the exception: its normal is the crown's volume normal, the same for both faces of the card
    // (the crown's top faces up whichever side of a card the viewer sees), so it is not negated - negated, every
    // card seen from its back read the crown's top as facing down: dark, and bare of snow (FIELD-WINTER p9 debug
    // frame: the crowns' tops back-facing with the normal pointing down).
    const float facing = ( frontFacing || DesertIsCanopyVertex( vertexColor ) ) ? 1.0 : -1.0;
    SurfaceInput i;
    i.WorldPosition = worldPosition;
    i.Normal        = facing * normalize( normal );
    i.UV0           = uv0;
    i.TBN           = facing * tbn;
    i.UV1           = uv1;
    i.VertexColor   = vertexColor;
    i.ObjectScaleUp = 1.0; // the passes that read it set v_Surface.ObjectScaleUp after this
    i.CameraPosition = cameraUB.CameraPos;
    i.Time           = cameraUB.Time;
    // A mesh is not a particle: white, the start of a life, no per-particle variation (the sprite pass overwrites).
    i.Particle.Color        = vec4( 1.0 );
    i.Particle.RelativeTime = 0.0;
    i.Particle.Random       = 0.0;
    return i;
}
#endif

// The shading normal: the tangent-space output through the interpolated TBN. For the default (0,0,1) this is
// the TBN's third column, the interpolated geometric normal — what the lit shaders used without a normal map.
vec3 DesertSurfaceWorldNormal( SurfaceInput i, SurfaceOutput s )
{
    return normalize( i.TBN * s.Normal );
}

// BlendMode Masked (UE's OpacityMask < OpacityMaskClipValue): the parser defines DESERT_SURFACE_MASKED, has refused
// a template without its `OpacityMask` line or the Float threshold, and GENERATES DesertSurfaceOpacityMask( i ) from
// that line (DShaderParser OpacityMaskFunction) between the surface block and the pass header. Every cell clips
// with it, BEFORE evaluating the surface; ray tracing reads the same line from ShaderProgramMeta::OpacityMask.
// A hit cell clips in its any-hit stage (ignoreIntersectionEXT), never in closest hit: a hit has no discard.
// UE's Dither Opacity Mask (MaterialTemplate.ush GetMaterialCoverageAndClipping, MATERIAL_DITHER_OPACITY_MASK): the
// 5-value screen dither plus noise, stepped by View.StateFrameIndexMod8 so TAA integrates it. Returned in [0, 1).
float DesertOpacityMaskDither( const vec2 svPosition, const float frameIndexMod8 )
{
    const float dither5 = fract( ( svPosition.x + svPosition.y * 2.0 - 1.5 + frameIndexMod8 ) / 5.0 );
    const float noise   = fract( dot( vec2( 171.0, 231.0 ) / 71.0, svPosition ) );
    return ( dither5 * 5.0 + noise ) * ( 1.0 / 6.0 );
}

#if defined( DESERT_SURFACE_MASKED ) && !defined( DESERT_SURFACE_PASS_Hit )
#if defined( DESERT_SURFACE_OPACITY_DITHER )
// A dithering material (DESERT_SURFACE_OPACITY_DITHER > 0.5) cuts below 1 - dither: a pixel is kept with
// probability = mask, so a mip texel holding the MEAN coverage of leaves smaller than itself keeps their share of
// the pixel (UE's spelling clips mask - clip + dither - 1; ours drops the clip so a fully opaque texel always stays
// and the kept share is the mask itself, Wyman & McGuire's hashed alpha test). The clip value is unused then.
#define DESERT_SURFACE_CLIP( i ) \
    if ( DesertSurfaceOpacityMask( i ) < ( DESERT_SURFACE_OPACITY_DITHER > 0.5 \
                                               ? 1.0 - DesertOpacityMaskDither( gl_FragCoord.xy, cameraUB.FrameIndexMod8 ) \
                                               : Material.OpacityMaskClipValue ) ) \
        discard
#else
#define DESERT_SURFACE_CLIP( i ) \
    if ( DesertSurfaceOpacityMask( i ) < Material.OpacityMaskClipValue ) \
        discard
#endif
#else
#define DESERT_SURFACE_CLIP( i )
#endif

// Parallax occlusion mapping and the Pixel Depth Offset (needs SurfaceInput / SurfaceOutput and the view block).
#include <Mesh/Surface/SurfaceParallax.glslh>

#endif
