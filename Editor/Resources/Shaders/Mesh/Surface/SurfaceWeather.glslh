#ifndef DESERT_SURFACE_WEATHER_GLSLH
#define DESERT_SURFACE_WEATHER_GLSLH

// THE SURFACE'S RESPONSE TO THE WEATHER (UE: CitySample's wet material functions, after Lagarde's "Water drop 2b —
// Dynamic rain and its effects"). Included by the two lit pass headers (Pass_Forward.glslh, Pass_GBuffer.glslh) of a
// cell the parser compiled with DESERT_SURFACE_WEATHER, and applied to EvaluateSurface's output BEFORE anything reads
// it, so the forward pixel and the G-buffer texel of one surface are wetted by the same text.
//
// The parser defines DESERT_SURFACE_WEATHER in the Forward and GBuffer cells of every Opaque / Masked template with a
// material row, and gives that row the two engine-owned parameters this reads (kSurfaceRespondsToWeatherParam,
// kSurfacePorosityParam in DShaderParser.hpp): a material states them like any other parameter (an instance overrides
// them), so the response is the MATERIAL's, not the template's. DESERT_WORLD_PARAMETER_WETNESS is the key of the
// world parameter kSurfaceWetnessParameter ("Wetness"), and the cell declares the world's table
// (Common/WorldParameters.glslh) for it.

// THE VIEW'S RAIN OCCLUSION (Graphic/RainOcclusion.hpp): the top-down depth of every caster in a box around the
// camera (MeshRenderer::RainOcclusionPass, "Weather: RainOcclusion"), standard-Z and orthographic, so depth is the
// height under the box's top, linear (0 at the top, 1 at the bottom; 1 = nothing overhead). The two scene-read slots
// Core::kRainOcclusionMapBinding / kRainOcclusionBlockBinding (ShaderGraphBindings.hpp); the map is bound from the
// frame graph (SceneViewInputs::RainOcclusionMap, System.White when the view has none), the block by
// SceneFrameBinding::ApplyTo.
layout( binding = 32 ) uniform texture2D u_RainOcclusionMap;
Uniform sampler u_RainOcclusionSampler;
layout( std140, binding = 33 ) uniform RainOcclusionUB
{
    mat4 u_RainOcclusionWorldToMap; // world -> the map's clip (uv = ndc.xy * 0.5 + 0.5, z = depth)
    vec4 u_RainOcclusionParams;     // x = depth range (cm), y = valid (>0.5), z = bias (cm), w = texel (cm)
};

// How covered from the sky this surface is, in [0, 1]: 1 under a roof, 0 in the open. Looked up a texel and a half out
// along the geometric normal, so a wall facing the open sky reads the ground beside it rather than its own top; a
// 2x2 gather, each texel compared with the bias and ramped over one more bias, filtered bilinearly (a soft edge one
// texel wide). Outside the box nothing is known, so nothing covers.
float DesertRainOcclusion( SurfaceInput i )
{
    if ( u_RainOcclusionParams.y < 0.5 )
        return 0.0;
    const vec3 p   = i.WorldPosition + i.Normal * ( 1.5 * u_RainOcclusionParams.w );
    const vec4 c   = u_RainOcclusionWorldToMap * vec4( p, 1.0 );
    const vec3 ndc = c.xyz / c.w;
    const vec2 uv  = ndc.xy * 0.5 + 0.5;
    if ( any( lessThan( uv, vec2( 0.0 ) ) ) || any( greaterThan( uv, vec2( 1.0 ) ) ) || ndc.z < 0.0 || ndc.z > 1.0 )
        return 0.0;
    const float range    = u_RainOcclusionParams.x;
    const float bias     = u_RainOcclusionParams.z;
    const float receiver = ndc.z * range; // cm under the box's top
    const vec4  occluder = textureGather( sampler2D( u_RainOcclusionMap, u_RainOcclusionSampler ), uv ) * range;
    const vec4  covered  = clamp( ( receiver - occluder - bias ) / bias, 0.0, 1.0 );
    // Gather order: (0,1) (1,1) (1,0) (0,0).
    const vec2 size = vec2( textureSize( sampler2D( u_RainOcclusionMap, u_RainOcclusionSampler ), 0 ) );
    const vec2 f    = fract( uv * size - 0.5 );
    return mix( mix( covered.w, covered.z, f.x ), mix( covered.x, covered.y, f.x ), f.y );
}

// HOW WET THE WORLD IS AT THIS SURFACE, in [0, 1]. THE ONE ACCESSOR: today the scene's world parameter (one value
// for the level, written by the weather state) where the sky reaches the surface, nothing under a roof; a zone field
// replaces the world value here, and only here, by position.
float DesertSurfaceWetness( SurfaceInput i )
{
    const float world = clamp( DesertWorldParameter( DESERT_WORLD_PARAMETER_WETNESS ).x, 0.0, 1.0 );
    return world * ( 1.0 - DesertRainOcclusion( i ) );
}

// Wets @p s by @p wetness. Water fills a dielectric's pores: the diffuse darkens (light refracted into the water
// film is absorbed over a longer path) and the surface smooths, both scaled by porosity; a metal has no pores and
// no diffuse, so it is left as it was. A non-porous surface only wets by STANDING water (puddles, a water film),
// which is not this function's — it is the puddle pass's (WTH-PUDDLES).
//   factor    = lerp( 1, 0.2, dielectric * porosity )           (Lagarde's porosity factor)
//   BaseColor *= lerp( 1, factor, wet )
//   Roughness *= lerp( 1, factor, 0.5 * wet )                   (gloss rises half as fast as the albedo falls)
SurfaceOutput ApplyWetness( SurfaceOutput s, const float wetness, const float porosity )
{
    const float dielectric = 1.0 - clamp( s.Metallic, 0.0, 1.0 );
    const float factor     = mix( 1.0, 0.2, dielectric * clamp( porosity, 0.0, 1.0 ) );
    const float wet        = clamp( wetness, 0.0, 1.0 );
    s.BaseColor *= mix( 1.0, factor, wet );
    s.Roughness *= mix( 1.0, factor, 0.5 * wet );
    return s;
}

// The pass headers' one call: the material's response (RespondsToWeather, a weight in [0, 1]) times the world's
// wetness here, at the material's porosity.
SurfaceOutput DesertApplySurfaceWeather( SurfaceInput i, SurfaceOutput s )
{
    const float response = clamp( u_Material.RespondsToWeather, 0.0, 1.0 );
    return ApplyWetness( s, response * DesertSurfaceWetness( i ), u_Material.Porosity );
}

#endif
