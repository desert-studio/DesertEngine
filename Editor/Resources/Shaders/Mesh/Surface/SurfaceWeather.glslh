#ifndef DESERT_SURFACE_WEATHER_GLSLH
#define DESERT_SURFACE_WEATHER_GLSLH

// THE SURFACE'S RESPONSE TO THE WEATHER (UE: CitySample's wet material functions, after Lagarde's "Water drop 2b —
// Dynamic rain and its effects"). Included by the two lit pass headers (Pass_Forward.glslh, Pass_GBuffer.glslh) of a
// cell the parser compiled with DESERT_SURFACE_WEATHER, and applied to EvaluateSurface's output BEFORE anything reads
// it, so the forward pixel and the G-buffer texel of one surface are wetted by the same text.
//
// The parser defines DESERT_SURFACE_WEATHER in the Forward and GBuffer cells of every Opaque / Masked template with a
// material row, and gives that row the two engine-owned parameters this reads (kSurfaceRespondsToWeatherParam,
// kSurfacePorosityParam in DShaderParser.hpp): a material states them like any other parameter (an instance overrides
// them), so the response is the MATERIAL's, not the template's. DESERT_WORLD_PARAMETER_WETNESS is the key of the
// world parameter kSurfaceWetnessParameter ("Wetness"), and the cell declares the world's table
// (Common/WorldParameters.glslh) for it.

// THE VIEW'S RAIN OCCLUSION: the map, its block and the position lookup are Common/RainOcclusion.glslh (shared with
// the precipitation). A surface is looked up a texel and a half out along its geometric normal, so a wall facing the
// open sky reads the ground beside it rather than its own top. A SLOPED face is also lifted by a slope-scaled bias
// (the shadow map's slope-scaled depth bias, for the same reason): the map's 2x2 footprint reaches a texel up the
// slope, where the face itself stands higher by texel * tan(slope), so a pitched roof or a tilted branch read itself
// as its own roof and stayed bare (FIELD-WINTER p6: grey barn roof, snow in specks on the branches). The lift is
// capped at 4 texels (76 degrees); a face that looks sideways or down (up <= 0) is not lifted.
#include <Common/RainOcclusion.glslh>
#include <Common/WeatherSnow.glslh>

// A CANOPY VERTEX IS LOOKED UP AT ITS CROWN'S SURFACE (FIELD-WINTER p8). A tree's crown is one volume to the sky
// (UE / SpeedTree foliage: the leaf cards carry the crown's normal), but the map is a top-down depth of the casters,
// and the crown is its own caster: every card under the crown's top read the crown above it as its roof, so only
// the topmost specks took snow. The asset carries, per leaf vertex, how far below its crown's top surface it hangs
// (SurfaceTypes.glslh DesertCanopyDepthCm), and the lookup is lifted by that depth: the card reads the occlusion at
// the crown's surface above it - what OTHER casters hold over the crown - and the canopy normal decides how much of
// the volume faces the sky (the crown's underside faces down and stays bare). Any other vertex: no lift.
// The lift also clears the crown's own peak inside the map's footprint by kDesertCanopyClearTexels: the baked top
// surface is the crown's highest leaf per 25 cm cell, the map's texel is wider, so a card on the crown's flank read
// the peak beside it as its roof (FIELD-WINTER p9: snow in specks on the near tree, not a layer).
const float kDesertCanopyClearTexels = 2.0;
float DesertCanopyLift( SurfaceInput i, const float texel )
{
    return DesertIsCanopyVertex( i.VertexColor ) ? DesertCanopyDepthCm( i.VertexColor ) + kDesertCanopyClearTexels * texel
                                                 : 0.0;
}

// Snow lies on the crown's OUTER SHELL: a leaf deeper than kDesertCanopyShellCm under the crown's top surface is
// sheltered by the leaves above it (they hold the snow), so its weight falls to 0 over the next shell - the crown's
// inside stays green. Only a canopy vertex has a depth; any other surface: 1.
const float kDesertCanopyShellCm = 40.0;
float DesertCanopyShelter( SurfaceInput i )
{
    return 1.0 - smoothstep( kDesertCanopyShellCm, 2.0 * kDesertCanopyShellCm, DesertCanopyDepthCm( i.VertexColor ) );
}

float DesertRainOcclusion( SurfaceInput i )
{
    const float texel = DesertRainOcclusionTexel();
    const vec3  n     = normalize( i.Normal );
    const float tanSlope =
         n.y > 0.0 ? min( sqrt( max( 1.0 - n.y * n.y, 0.0 ) ) / max( n.y, 1e-3 ), 4.0 ) : 0.0;
    return DesertRainOcclusionAt( i.WorldPosition + n * ( 1.5 * texel ) +
                                  vec3( 0.0, 1.5 * texel * tanSlope + DesertCanopyLift( i, texel ), 0.0 ) );
}

// HOW WET THE WORLD IS AT THIS SURFACE, in [0, 1]. THE ONE ACCESSOR: today the scene's world parameter (one value
// for the level, written by the weather state) where the sky reaches the surface, nothing under a roof; a zone field
// replaces the world value here, and only here, by position.
float DesertSurfaceWetness( SurfaceInput i )
{
    const float world = clamp( DesertWorldParameter( DESERT_WORLD_PARAMETER_WETNESS ).x, 0.0, 1.0 );
    return world * ( 1.0 - DesertRainOcclusion( i ) );
}

// Wets @p s by @p wetness. Water fills a dielectric's pores: the diffuse darkens (light refracted into the water
// film is absorbed over a longer path) and the surface smooths, both scaled by porosity; a metal has no pores and
// no diffuse, so it is left as it was. A non-porous surface only wets by STANDING water (puddles, a water film),
// which is not this function's — it is the puddle pass's (WTH-PUDDLES).
//   factor    = lerp( 1, 0.2, dielectric * porosity )           (Lagarde's porosity factor)
//   BaseColor *= lerp( 1, factor, wet )
//   Roughness *= lerp( 1, factor, 0.5 * wet )                   (gloss rises half as fast as the albedo falls)
SurfaceOutput ApplyWetness( SurfaceOutput s, const float wetness, const float porosity )
{
    const float dielectric = 1.0 - clamp( s.Metallic, 0.0, 1.0 );
    const float factor     = mix( 1.0, 0.2, dielectric * clamp( porosity, 0.0, 1.0 ) );
    const float wet        = clamp( wetness, 0.0, 1.0 );
    s.BaseColor *= mix( 1.0, factor, wet );
    s.Roughness *= mix( 1.0, factor, 0.5 * wet );
    return s;
}

// Lays the world's snow (Common/WeatherSnow.glslh) over @p s where the face looks up at the open sky: the snow's
// scanned albedo, roughness and occlusion replace the surface's by the layer's weight, metal is buried, and the
// snow's normal (world space) is brought into the surface's tangent frame and blended with its own.
SurfaceOutput ApplySnow( SurfaceInput i, SurfaceOutput s, const float response )
{
    // The geometric world normal (the TBN's third column): the mask is how the FACE meets the sky, and the snow
    // buries the surface's own normal-map relief rather than following it.
    const vec3            normalWS = normalize( i.TBN[2] );
    const DesertSnowLayer snow     = DesertEvaluateSnow( i.WorldPosition, normalWS, 1.0 - DesertRainOcclusion( i ) );
    const float           w        = snow.Weight * response * DesertCanopyShelter( i );
    if ( w <= 0.0 )
        return s;
    const vec3 snowTS  = normalize( transpose( i.TBN ) * snow.NormalWS );
    s.BaseColor        = mix( s.BaseColor, snow.Albedo, w );
    s.Roughness        = mix( s.Roughness, snow.Roughness, w );
    s.AmbientOcclusion = mix( s.AmbientOcclusion, snow.AO, w );
    s.Metallic         = mix( s.Metallic, 0.0, w );
    s.Normal           = normalize( mix( s.Normal, snowTS, w ) );
    return s;
}

// The pass headers' one call: the material's response (RespondsToWeather, a weight in [0, 1]) times the world's
// wetness here, at the material's porosity.
SurfaceOutput DesertApplySurfaceWeather( SurfaceInput i, SurfaceOutput s )
{
    const float response = clamp( Material.RespondsToWeather, 0.0, 1.0 );
    s = ApplyWetness( s, response * DesertSurfaceWetness( i ), Material.Porosity );
    return ApplySnow( i, s, response );
}

#endif
