#ifndef DESERT_SURFACE_WEATHER_GLSLH
#define DESERT_SURFACE_WEATHER_GLSLH

// THE SURFACE'S RESPONSE TO THE WEATHER (UE: CitySample's wet material functions, after Lagarde's "Water drop 2b —
// Dynamic rain and its effects"). Included by the two lit pass headers (Pass_Forward.glslh, Pass_GBuffer.glslh) of a
// cell the parser compiled with DESERT_SURFACE_WEATHER, and applied to EvaluateSurface's output BEFORE anything reads
// it, so the forward pixel and the G-buffer texel of one surface are wetted by the same text.
//
// The ray tracing closest hit (Pass_RayHit.glslh) applies it too, so reflections and the path tracer see it.
// The parser defines DESERT_SURFACE_WEATHER in the Forward, GBuffer and RayTracing.Hit cells of every Opaque / Masked
// template with a material row, and gives that row the two engine-owned parameters this reads (kSurfaceRespondsToWeatherParam,
// kSurfacePorosityParam in DShaderParser.hpp): a material states them like any other parameter (an instance overrides
// them), so the response is the MATERIAL's, not the template's. What the rain does (the film, standing water,
// ripples, streaks) and the world's values it reads by key are Common/WeatherRain.glslh, one text with the landscape.

// THE VIEW'S RAIN OCCLUSION: the map, its block and the position lookup are Common/RainOcclusion.glslh (shared with
// the precipitation); the lifted lookup (a texel and a half out along the geometric normal, plus the slope-scaled
// bias that kept a pitched roof or a tilted branch from reading itself as its own roof - FIELD-WINTER p6) is
// Common/WeatherRain.glslh DesertRainExposure.
#include <Common/RainOcclusion.glslh>
#include <Common/WeatherSnow.glslh>
#include <Common/WeatherRain.glslh>

// A CANOPY VERTEX IS LOOKED UP AT ITS CROWN'S SURFACE (FIELD-WINTER p8). A tree's crown is one volume to the sky
// (UE / SpeedTree foliage: the leaf cards carry the crown's normal), but the map is a top-down depth of the casters,
// and the crown is its own caster: every card under the crown's top read the crown above it as its roof, so only
// the topmost specks took snow. The asset carries, per leaf vertex, how far below its crown's top surface it hangs
// (SurfaceTypes.glslh DesertCanopyDepthCm), and the lookup is lifted by that depth: the card reads the occlusion at
// the crown's surface above it - what OTHER casters hold over the crown - and the canopy normal decides how much of
// the volume faces the sky (the crown's underside faces down and stays bare). Any other vertex: no lift.
// The lift also clears the crown's own peak inside the map's footprint by the mesh's clearance texels
// (MeshCanopySettings::ClearTexels, DesertCanopySnowData .y): the baked top surface is the crown's highest leaf per
// 25 cm cell, the map's texel is wider, so a card on the crown's flank read the peak beside it as its roof
// (FIELD-WINTER p9: snow in specks on the near tree, not a layer).
float DesertCanopyLift( SurfaceInput i, const float texel )
{
    // The depth is the mesh's cm, the lift is world cm: a tree placed at scale 3 hangs its leaves three times deeper
    // (FIELD-WINTER p11: Tree 1 at scale 3, lifted by its mesh depth, read its own crown as its roof - all green).
    return DesertIsCanopyVertex( i.VertexColor )
              ? DesertCanopyDepthCm( i.VertexColor ) * i.ObjectScaleUp +
                     DesertCanopySnowData( i.VertexColor, i.UV1 ).y * texel
              : 0.0;
}

// Snow lies on the crown's OUTER SHELL: a leaf deeper than the mesh's shell (MeshCanopySettings::ShellCm) under the
// crown's top surface is sheltered by the leaves above it (they hold the snow), so its weight falls to 0 over the
// next shell - the crown's inside stays green. The weight is baked per leaf vertex by the mesh build in the mesh's
// cm (it grows with the tree's scale), DesertCanopySnowData .x; any other surface: 1.
float DesertCanopyShelter( SurfaceInput i )
{
    return DesertCanopySnowData( i.VertexColor, i.UV1 ).x;
}

float DesertRainOcclusion( SurfaceInput i )
{
    // The lifted lookup is Common/WeatherRain.glslh's (one text with the landscape's); the canopy adds its crown.
    return 1.0 - DesertRainExposure( i.WorldPosition, normalize( i.Normal ),
                                     DesertCanopyLift( i, DesertRainOcclusionTexel() ) );
}

// Lays the world's snow (Common/WeatherSnow.glslh) over @p s where the face looks up at the open sky: the snow's
// scanned albedo, roughness and occlusion replace the surface's by the layer's weight, metal is buried, and the
// snow's normal (world space) is brought into the surface's tangent frame and blended with its own.
SurfaceOutput ApplySnow( SurfaceInput i, SurfaceOutput s, const float response )
{
    // The geometric world normal (the TBN's third column): the mask is how the FACE meets the sky, and the snow
    // buries the surface's own normal-map relief rather than following it.
    const vec3            normalWS = normalize( i.TBN[2] );
    const DesertSnowLayer snow     = DesertEvaluateSnow( i.WorldPosition, normalWS, 1.0 - DesertRainOcclusion( i ) );
    const float           w        = snow.Weight * response * DesertCanopyShelter( i );
    if ( w <= 0.0 )
        return s;
    const vec3 snowTS  = normalize( transpose( i.TBN ) * snow.NormalWS );
    s.BaseColor        = mix( s.BaseColor, snow.Albedo, w );
    s.Roughness        = mix( s.Roughness, snow.Roughness, w );
    s.AmbientOcclusion = mix( s.AmbientOcclusion, snow.AO, w );
    s.Metallic         = mix( s.Metallic, snow.Metallic, w );
    s.Normal           = normalize( mix( s.Normal, snowTS, w ) );
    return s;
}

// The pass headers' one call: the world's rain (Common/WeatherRain.glslh: the film, standing water, ripples, streaks)
// at the material's response (RespondsToWeather, a weight in [0, 1]) and porosity, where the sky reaches the surface,
// then the world's snow. The rain works in the world's frame: the surface's tangent normal goes out through the TBN
// and comes back through its transpose, as the snow's does. The grass's full-screen resolve has no implicit
// derivatives of the world position (a quad spans several blades), so it fetches no ripple or streak map; its blades
// still wet.
SurfaceOutput DesertApplySurfaceWeather( SurfaceInput i, SurfaceOutput s )
{
    const float response = clamp( Material.RespondsToWeather, 0.0, 1.0 );
#if defined( DESERT_SURFACE_PASS_VisibilityResolve )
    const bool sampledLayers = false;
#else
    const bool sampledLayers = true;
#endif
    // The geometric world normal (the TBN's third column): the water lies on the face, not on its normal map.
    const vec3       geomN = normalize( i.TBN[2] );
    DesertWetSurface w;
    w.BaseColor = s.BaseColor;
    w.NormalWS  = normalize( i.TBN * s.Normal );
    w.Roughness = s.Roughness;
    w.Metallic  = s.Metallic;
    w.Specular  = s.Specular;
    w.AO        = s.AmbientOcclusion;
    w           = DesertApplyRain( w, i.WorldPosition, geomN, 1.0 - DesertRainOcclusion( i ), response,
                                   Material.Porosity, sampledLayers );
    s.BaseColor = w.BaseColor;
    s.Normal    = normalize( transpose( i.TBN ) * w.NormalWS );
    s.Roughness = w.Roughness;
    s.Metallic  = w.Metallic;
    s.Specular  = w.Specular;
    return ApplySnow( i, s, response );
}

#endif
