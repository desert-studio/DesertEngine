// Surface cell vertex path: a procedural grass blade per instance (GRASS-BLADE; Ghost of Tsushima, GDC 2021
// "Procedural Grass in Ghost of Tsushima": the blade is a curve built in the vertex stage from a few numbers, no
// mesh). The drawn mesh is GrassRenderer's blade strip, whose position is (side -1/+1, height share t 0..1, 0); the
// instance's matrix (InstanceTransforms, written by Programs/Grass/GrassGenerate.shader) carries the blade's root,
// its width axis (column 0, scaled by the width multiplier), its up and forward axes (columns 1 and 2, scaled by
// the height multiplier) and three per-blade draws in the columns' w: the card draw, the curvature (and bend) draw
// and the clump tint. The variety's shape (GrassBladeShape) picks its card and bends it; its look - outline,
// colour, veins, dry tips - is the material's scanned atlas (Ghost of Tsushima's blade is coloured in code; here
// the scan is the asset, the code only places, bends and sways it); the
// scene's wind sways it as FoliageWind.glslh sways a mesh, resisted by the blade's stiffness. One function places
// the blade for every pass, so the shadow and the depth a blade leaves are the blade that is drawn.
// The vertex inputs — binding 0 (position, normal, tangent, bitangent, UV0) and the optional streams at binding 1
// (vertex colour, UV1; a mesh without them binds the shared white / (0,0) buffer at the same stride) — and
// DesertMeshTextureUV, GENERATED from the C++ vertex format (Graphic/ShaderProtocols/VertexInputs.hpp). The full
// set in every pass: an input a depth cell does not read costs nothing, a subset would be a second list.
#include <Mesh/MeshVertexInputs.glslh>

#include <Common/CameraUB.glslh>
#ifdef DESERT_SURFACE_VIEW_PASS
// The view's depth prepass (Mesh/Surface/Pass_Depth.glslh) and the base pass test each other's depth for equality:
// one gl_Position, bit for bit, whichever cell computes it (GLSL invariance, UE's precise position).
invariant gl_Position;
#endif
#ifdef DESERT_SURFACE_PASS_ShadowDepth
#include <Common/ShadowCasterBias.glslh>
#endif
#include <Common/Velocity.glslh>

layout( std430, binding = 17 ) readonly buffer InstanceTransforms
{
    mat4 transforms[];
};

// The blade's shape and placement: one statement for this stage and the ray tracer's blade BLAS.
#include <Mesh/Surface/GrassBlade.glslh>

// The variety's shape (GrassBladeShapeGpu), std430.
layout( std430, binding = 13 ) readonly buffer GrassBladeShape
{
    GrassBladeShapeData Blade;
};

#include <Common/MaterialTransport.glslh>
#ifdef DESERT_SURFACE_PASS_ShadowDepth
// A cached cascade's layers split the blades by the shadow wind distance (CasterWindLayer.glslh).
#include <Mesh/Surface/CasterWindLayer.glslh>
#endif

#ifdef DESERT_SURFACE_PASS_VisibilityResolve
// THE VISIBILITY RESOLVE (GRASS-VIS, Mesh/Surface/Pass_VisibilityResolve.glslh): no blade is placed here - the draw
// is one full-screen triangle (the strip's first three indices, GrassRenderer's resolve record), the fragment stage
// rebuilds the blade triangle its pixel's visibility word names with the same BladeAt.
void main()
{
    const vec2 corner = vec2( float( ( gl_VertexIndex << 1 ) & 2 ), float( gl_VertexIndex & 2 ) );
    gl_Position       = vec4( corner * 2.0 - 1.0, 0.0, 1.0 );
}
#else
#ifdef DESERT_SURFACE_HAS_VARYINGS
DESERT_SURFACE_VARYINGS( out )
#endif
#ifdef DESERT_SURFACE_PASS_Visibility
// The blade's raster-stream row (Common/VisibilityBuffer.glslh): the variety's first row + the instance index.
layout( location = 15 ) flat out uint v_VisibilityRow;
#endif

void main()
{
#ifdef DESERT_SURFACE_PASS_Visibility
    v_VisibilityRow = Blade.Visibility.x + uint( gl_InstanceIndex );
#endif
    const mat4       model  = transforms[gl_InstanceIndex];
    const float      side   = a_Position.x;
    const float      t      = a_Position.y;
    vec4             windA  = m_PushConstants.WindA;
#ifdef DESERT_SURFACE_PASS_ShadowDepth
    if ( !DesertCasterWindLayer( model[3].xyz, windA ) )
    {
        gl_Position = vec4( 0.0, 0.0, -2.0, 1.0 ); // the other layer's blade: a degenerate, clipped
        return;
    }
#endif
    const BladePoint blade = BladeAt( Blade, model, side, t, windA, m_PushConstants.WindB );
#if defined( DESERT_SURFACE_PASS_Depth ) || defined( DESERT_SURFACE_PASS_ShadowDepth )
#define GRASS_BLADE_DEPTH_CELL 1
#endif
#if defined( GRASS_BLADE_DEPTH_CELL ) && defined( DESERT_SURFACE_HAS_VARYINGS ) && !defined( DESERT_SURFACE_PARALLAX )
    // THE MASKED DEPTH CELLS - the view's depth prepass and a cascade's caster (UE's depth-only / shadow-depth vertex
    // factory: position and the masked UV, no normal, tangent or velocity) - read one thing of the blade but its
    // place: the opacity mask's UV (Pass_Depth.glslh / Pass_ShadowDepth.glslh: DESERT_SURFACE_CLIP, DShaderParser
    // OpacityMaskFunction samples `i.UV<set>` and nothing else of SurfaceInput) - no shading frame, no velocity
    // ("No velocity", Pass_Depth.glslh:11; a light view has no previous frame). The cells build only that; the frame
    // and the previous wind step are the G-buffer cell's, the pass that reads them. The place itself is the one
    // expression every cell evaluates, so gl_Position stays invariant against the base pass and a blade's shadow is
    // the blade drawn. (A `.Parallax` depth cell evaluates the surface, so it takes the full set below.)
    v_Surface.WorldPosition = blade.Position;
    v_Surface.Normal        = vec3( 0.0, 1.0, 0.0 ); // not read by the depth cells' fragment stage
    v_Surface.UV0           = BladeCardUV( BladeCard( Blade, model[0].w ), side, t );
    v_Surface.UV1           = vec2( model[2].w, t );
    v_Surface.VertexColor   = a_Color;
    v_Surface.ObjectScaleUp = 1.0;
    v_Surface.TBN           = mat3( 1.0 ); // not read by the depth cells' fragment stage
    v_Surface.Clip          = vec4( 0.0, 0.0, 0.0, 1.0 );
    v_Surface.PrevClip      = vec4( 0.0, 0.0, 0.0, 1.0 );
    v_Surface.ObjectMoved   = 0.0;
#ifdef DESERT_SURFACE_PASS_ShadowDepth
    // The caster's slope bias reads the blade's normal - the vertex stage's own use, not a varying.
    const vec3 normal = BladeNormal( blade, side );
#endif
#else
    const vec3 along  = normalize( blade.Along );
    const vec3 normal = BladeNormal( blade, side );
#ifdef DESERT_SURFACE_HAS_VARYINGS
    // The blade's look is its material's: UV0 is the card's place on the scanned atlas (texture space, set
    // directly, not a stored mesh UV), UV1 carries the clump's draw and the height share for the material's clump
    // tint and root occlusion (GrassBladeSurface.shader), so neither is a colour decided here.
    const vec4 card = BladeCard( Blade, model[0].w );
    v_Surface.WorldPosition = blade.Position;
    v_Surface.Normal        = normal;
    v_Surface.UV0           = BladeCardUV( card, side, t );
    v_Surface.UV1           = vec2( model[2].w, t );
    v_Surface.VertexColor   = a_Color;
    v_Surface.ObjectScaleUp = 1.0;
    v_Surface.TBN           = mat3( blade.Right, along, normal );
#endif
#ifdef DESERT_SURFACE_VIEW_PASS
    // The blade is world-static but for the wind, evaluated again at the wind clock's previous step (WindB.z,
    // Graphic::InstanceWindPush), as Vertex_Instanced.glslh.
    const BladePoint previous = BladeAt( Blade, model, side, t, windA,
                                         vec4( m_PushConstants.WindB.x, m_PushConstants.WindB.z, 0.0, 0.0 ) );
    v_Surface.Clip     = cameraUB.ViewProjection * vec4( blade.Position, 1.0 );
    v_Surface.PrevClip = cameraUB.PrevViewProjection * vec4( previous.Position, 1.0 );
    // The object-motion flag (Common/Velocity.glslh DesertVelocity w): a blade never moves, only the wind bends it.
    v_Surface.ObjectMoved = 0.0;
#elif defined( DESERT_SURFACE_HAS_VARYINGS )
    v_Surface.Clip     = vec4( 0.0, 0.0, 0.0, 1.0 ); // light view: no velocity
    v_Surface.PrevClip = vec4( 0.0, 0.0, 0.0, 1.0 );
    v_Surface.ObjectMoved = 0.0;
#endif
#endif // the masked depth cells
    gl_Position = cameraUB.JitteredViewProjection * vec4( blade.Position, 1.0 );
#ifdef DESERT_SURFACE_PASS_ShadowDepth
    gl_Position = ShadowCasterSlopeBias( gl_Position, cameraUB.JitteredViewProjection, normal,
                                         cameraUB.ShadowSlopeBias, cameraUB.ShadowSlopeClamp );
#endif
}
#endif // DESERT_SURFACE_PASS_VisibilityResolve
