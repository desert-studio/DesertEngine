// Surface cell vertex path: a procedural grass blade per instance (GRASS-BLADE; Ghost of Tsushima, GDC 2021
// "Procedural Grass in Ghost of Tsushima": the blade is a curve built in the vertex stage from a few numbers, no
// mesh). The drawn mesh is GrassRenderer's blade strip, whose position is (side -1/+1, height share t 0..1, 0); the
// instance's matrix (InstanceTransforms, written by Programs/Grass/GrassGenerate.shader) carries the blade's root,
// its width axis (column 0, scaled by the width multiplier), its up and forward axes (columns 1 and 2, scaled by
// the height multiplier) and three per-blade draws in the columns' w: the colour / dry draw, the curvature draw and
// the clump tint. The variety's shape (GrassBladeShape) bends, tapers and colours it; the scene's wind sways it as
// FoliageWind.glslh sways a mesh, resisted by the blade's stiffness. One function places the blade for every pass,
// so the shadow and the depth a blade leaves are the blade that is drawn.
layout( location = 0 ) in vec3 a_Position;
layout( location = 1 ) in vec3 a_Normal;
layout( location = 2 ) in vec3 a_Tangent;
layout( location = 3 ) in vec3 a_Bitangent;
layout( location = 4 ) in vec2 a_TextureCoord;
#ifdef DESERT_SURFACE_HAS_VARYINGS
layout( location = 7 ) in vec4 a_Color;
layout( location = 8 ) in vec2 a_TexCoord1;
#endif

#include <Common/CameraUB.glslh>
#ifdef DESERT_SURFACE_PASS_ShadowDepth
#include <Common/ShadowCasterBias.glslh>
#endif
#include <Common/ObjectMotion.glslh>

layout( std430, binding = 17 ) readonly buffer InstanceTransforms
{
    mat4 transforms[];
};

// Mirrors Graphic::System::GrassBladeShapeGpu (GrassRenderer.cpp), std430.
layout( std430, binding = 16 ) readonly buffer GrassBladeShape
{
    vec4 Size; // Height cm, Width cm, Taper, Curvature
    vec4 Base; // BaseColor, Stiffness
    vec4 Tip;  // TipColor, DryTipShare
    vec4 Dry;  // DryTipColor, DryTipLength
}
u_Blade;

#include <Common/MaterialTransport.glslh>
#include <Common/FoliageWind.glslh>

#ifdef DESERT_SURFACE_HAS_VARYINGS
DESERT_SURFACE_VARYINGS( out )
#endif

struct BladePoint
{
    vec3 Position;
    vec3 Along; // d(position)/dt, up the blade
    vec3 Right; // unit, across the blade
};

// The blade at height share @p t, @p side across: a quadratic curve from the root whose tip leans forward by the
// curvature and sways with the wind, its upright reach shortened so the blade keeps its length as it bends.
BladePoint BladeAt( mat4 model, float side, float t, vec4 windA, vec4 windB )
{
    const vec3  root    = vec3( model[3] );
    const float heightK = length( model[1].xyz );
    const vec3  up      = model[1].xyz / max( heightK, 1e-6 );
    const vec3  right   = model[0].xyz / max( length( model[0].xyz ), 1e-6 );
    const vec3  forward = model[2].xyz / max( length( model[2].xyz ), 1e-6 );
    const float height  = u_Blade.Size.x * heightK;
    const float width   = u_Blade.Size.y * length( model[0].xyz );

    // The rest lean: the variety's curvature, varied per blade by +-40 %.
    const float lean = u_Blade.Size.w * ( 0.6 + 0.8 * model[1].w );
    vec3        tip  = forward * ( height * lean );
    // The wind at the tip, as a mesh vertex at the blade's height would sway, less what the stiffness resists.
    tip += FoliageWindOffset( vec3( 0.0, height, 0.0 ), root, windA, windB ) * ( 1.0 - u_Blade.Base.w );
    const float reach = min( length( tip ) / max( height, 1e-3 ), 0.95 );
    const float rise  = height * sqrt( 1.0 - reach * reach );

    BladePoint p;
    p.Right    = right;
    p.Position = root + up * ( rise * t ) + tip * ( t * t ) + right * ( 0.5 * width * side * ( 1.0 - u_Blade.Size.z * t ) );
    p.Along    = up * rise + tip * ( 2.0 * t );
    return p;
}

void main()
{
    const mat4  model = transforms[gl_InstanceIndex];
    const float side  = a_Position.x;
    const float t     = a_Position.y;
    const BladePoint blade = BladeAt( model, side, t, m_PushConstants.WindA, m_PushConstants.WindB );
    // The blade's face normal, tilted across its width so the flat strip shades as a rounded blade (GoT).
    const vec3 along  = normalize( blade.Along );
    const vec3 face   = normalize( cross( blade.Right, along ) );
    const vec3 normal = normalize( face + blade.Right * ( 0.45 * side ) );
#ifdef DESERT_SURFACE_HAS_VARYINGS
    // Root to tip, then the dry tip on the blades that drew one; the clump's tint varies the whole blade.
    vec3 colour = mix( u_Blade.Base.rgb, u_Blade.Tip.rgb, t );
    if ( model[0].w < u_Blade.Tip.w )
        colour = mix( colour, u_Blade.Dry.rgb, smoothstep( 1.0 - u_Blade.Dry.w, 1.0, t ) );
    // Cool and dark to warm and light, so clumps read as patches of one meadow and not as one green
    colour *= mix( vec3( 0.75, 0.9, 0.85 ), vec3( 1.2, 1.1, 0.8 ), model[2].w );
    v_Surface.WorldPosition = blade.Position;
    v_Surface.Normal        = normal;
    v_Surface.UV0           = vec2( a_TextureCoord.x, 1.0 - a_TextureCoord.y );
    v_Surface.UV1           = vec2( a_TexCoord1.x, 1.0 - a_TexCoord1.y );
    v_Surface.VertexColor   = vec4( colour, 1.0 ) * a_Color;
    v_Surface.TBN           = mat3( blade.Right, along, normal );
#endif
#ifdef DESERT_SURFACE_VIEW_PASS
    // The blade is world-static but for the wind, evaluated again at the wind clock's previous step (WindB.z,
    // Graphic::InstanceWindPush), as Vertex_Instanced.glslh.
    const BladePoint previous = BladeAt( model, side, t, m_PushConstants.WindA,
                                         vec4( m_PushConstants.WindB.x, m_PushConstants.WindB.z, 0.0, 0.0 ) );
    v_Surface.Clip     = cameraUB.ViewProjection * vec4( blade.Position, 1.0 );
    v_Surface.PrevClip = cameraUB.PrevViewProjection * vec4( previous.Position, 1.0 );
#elif defined( DESERT_SURFACE_HAS_VARYINGS )
    v_Surface.Clip     = vec4( 0.0, 0.0, 0.0, 1.0 ); // light view: no velocity
    v_Surface.PrevClip = vec4( 0.0, 0.0, 0.0, 1.0 );
#endif
    gl_Position = cameraUB.JitteredViewProjection * vec4( blade.Position, 1.0 );
#ifdef DESERT_SURFACE_PASS_ShadowDepth
    gl_Position = ShadowCasterSlopeBias( gl_Position, cameraUB.JitteredViewProjection, normal,
                                         cameraUB.ShadowSlopeBias, cameraUB.ShadowSlopeClamp );
#endif
}
