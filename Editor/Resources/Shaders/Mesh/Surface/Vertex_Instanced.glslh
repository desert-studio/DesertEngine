// Surface cell vertex path: instanced static mesh, one transform per instance in InstanceTransforms (binding 17),
// bent by the foliage wind the push block carries — the vertex stage of Programs/Surface/StaticMeshLit_Instanced.shader,
// StaticMeshGBuffer_Instanced.shader and Programs/Shadow/Shadow_Instanced.shader (which share one push block).
// The vertex inputs — binding 0 (position, normal, tangent, bitangent, UV0) and the optional streams at binding 1
// (vertex colour, UV1; a mesh without them binds the shared white / (0,0) buffer at the same stride) — and
// DesertMeshTextureUV, GENERATED from the C++ vertex format (Graphic/ShaderProtocols/VertexInputs.hpp). The full
// set in every pass: an input a depth cell does not read costs nothing, a subset would be a second list.
#ifdef DESERT_SURFACE_VIRTUAL_GEOMETRY
// THE VIRTUAL GEOMETRY CELL (`.VirtualGeometry`, DShaderParser kSurfaceVirtualGeometryPaths; a binned cell; UE:
// Nanite's instanced static mesh): no vertex buffer - one draw instance is one visible cluster of ONE instance of
// the field (Common/GpuScene.glslh DesertResolveVgDraw: the cut's (instance, cluster) row; the instance's GpuScene
// row carries its transform), the vertex is triangle x 3 + corner of it, fetched through the cluster's DAG
// (Common/VirtualGeometry.glslh VgFetchMeshVertex) into the very names the vertex inputs carry; the wind, the
// velocity and the rest of this stage are the binned cell's. The cut tested the clusters' boxes widened by the
// row's wind pad (Programs/VirtualGeometry/ClusterCut.shader, InstanceCull's WindExpandedBounds).
#define DESERT_GPU_SCENE_VIRTUAL_GEOMETRY 1
#include <Mesh/MeshVertexAccess.glslh>
#else
#include <Mesh/MeshVertexInputs.glslh>
#endif

#include <Common/CameraUB.glslh>
#ifdef DESERT_SURFACE_VIEW_PASS
// The view's depth prepass (Mesh/Surface/Pass_Depth.glslh) and the base pass test each other's depth for equality:
// one gl_Position, bit for bit, whichever cell computes it (GLSL invariance, UE's precise position).
invariant gl_Position;
#endif
#ifdef DESERT_SURFACE_CASTER_PASS
#include <Common/ShadowCasterBias.glslh>
#endif
#include <Common/Velocity.glslh>

#ifdef DESERT_SURFACE_BINNED
// Binned (SurfaceTypes.glslh): the instance id names the GpuScene instance, whose world is Primitive.LocalToWorld x
// Instance.InstanceToPrimitive x the submesh's transform, and whose primitive row carries the field's wind
// (GpuScene_WindA / GpuScene_WindB). No InstanceTransforms, nothing pushed.
#define DESERT_GPU_SCENE_PRIMITIVES 1
#define DESERT_GPU_SCENE_DRAWS 1
#include <Common/GpuScene.glslh>
#elif defined( DESERT_SURFACE_DRAW_ROWS )
// GRASS-GPU-DRIVEN-DRAWS, A COMPACTED BIN'S DRAW (DESERT_SURFACE_DRAW_ROWS, MeshRenderer::SurfaceDrawRowsVariant;
// as Vertex_GrassBlade.glslh's): one vkCmdDrawIndexedIndirectCount draws every mesh grass section of the bin - per
// section its records of each drawn submesh and LOD level - so nothing is bound per section; draw gl_DrawID finds
// its section's row (Common/GpuInstanceDrawRow.glslh) and reads the transforms, the list's ids, the mesh
// visibility rows, the material row and the wind through it (UE GPU Scene: the primitive's data by the draw's
// index).
#include <Common/GpuInstanceDrawRow.glslh>
layout( buffer_reference, std430, buffer_reference_align = 16 ) readonly buffer MeshDrawRowTransforms
{
    mat4 Rows[];
};
layout( buffer_reference, std430, buffer_reference_align = 4 ) readonly buffer MeshDrawRowIds
{
    uint Rows[];
};
GpuInstanceDrawRow g_MeshDrawRow; // set first thing in main()
#define transforms MeshDrawRowTransforms( g_MeshDrawRow.Instances ).Rows
#elif defined( DESERT_SURFACE_SCENE_INSTANCES )
// AN ISM's CPU-INSTANCED DRAW BY GPU SCENE ID (Graphic::kSurfaceSceneInstancesDefine, MeshRenderer::
// SurfaceSceneInstancesVariant; UE GPU Scene: the draw reads its instance's transform from the scene by
// InstanceId):
// InstanceTransforms holds, per instance, the GpuScene instance row (the field's FirstGpuInstance + its index), so
// the CPU copies 4 bytes per drawn instance, not a mat4; the world is Primitive.LocalToWorld x
// Instance.InstanceToPrimitive (no submesh transform: the CPU path never applied one), the previous world the
// primitive's previous one x the same InstanceToPrimitive.
#define DESERT_GPU_SCENE_PRIMITIVES 1
#define DESERT_GPU_SCENE_INSTANCES 1
#include <Common/GpuScene.glslh>
layout( std430, binding = 17 ) readonly buffer InstanceTransforms
{
    uint sceneInstanceIds[];
};
#else
layout( std430, binding = 17 ) readonly buffer InstanceTransforms
{
    mat4 transforms[];
};
#endif

#if defined( DESERT_SURFACE_VIRTUAL_GEOMETRY ) && defined( DESERT_SURFACE_PASS_VirtualShadowDepth )
// "VSM: Raster VirtualGeometry" (MeshRenderer::AddVirtualShadowRasterPasses): one pass for every level, the level is
// the cluster's cut view; its matrix is the level's (Common/VirtualShadowRaster.glslh's VsmFrameData, binding 53),
// not the carrier's camera block, and the fragment stage takes the level and layer from v_VsmCutView (as Vertex_Static.glslh).
#define DESERT_VSM_CLUSTER_RASTER 1
#include <Common/VirtualShadowMap.glslh>
#include <Generated/SceneBindings.glslh> // the set-0 slot table (Core::kSceneBindingNames)
layout( std430, binding = kVsmFrameDataBinding ) restrict readonly buffer VsmFrameData
{
    VsmFrame Frame;
    VsmLevel Levels[];
};
layout( location = 15 ) flat out uint v_VsmCutView; // the level and the layer (VsmCutViewLevel / Layer)
#endif

#if defined( DESERT_SURFACE_PASS_VirtualShadowDepth ) && !defined( DESERT_SURFACE_BINNED )
// The virtual shadow map's CPU walk draws only the instances "VSM: Cull Casters" kept for this level: gl_InstanceIndex
// is a slot of the draw's compacted list (the records' first instance is the draw's remap base), the slot holds the
// instance to fetch (UE: the per-page draw's instance id list). A binned cell resolves its instance through
// a_VisibleRow (Common/GpuScene.glslh) and reads no remap.
#include <Generated/SceneBindings.glslh> // the set-0 slot table (Core::kSceneBindingNames)
layout( std430, binding = kVsmInstanceRemapBinding ) restrict readonly buffer VsmInstanceRemap
{
    uint InstanceRemap[];
};
#define DESERT_INSTANCE_INDEX InstanceRemap[gl_InstanceIndex]
#elif defined( DESERT_SURFACE_INSTANCE_IDS ) && defined( DESERT_SURFACE_DRAW_ROWS )
// A bin's draw of a list of ids: the section's ids by address from its draw row (the slot is gl_InstanceIndex).
#define DESERT_INSTANCE_INDEX MeshDrawRowIds( g_MeshDrawRow.Ids ).Rows[gl_InstanceIndex]
#elif defined( DESERT_SURFACE_INSTANCE_IDS ) && !defined( DESERT_SURFACE_BINNED )
// A GPU-instanced list of ids (GPU-COST-22, Graphic::kSurfaceInstanceIdsDefine; UE GPU Scene's InstanceIdBuffer): the
// landscape grass's camera list or a cascade's holds, per slot, the row of InstanceTransforms it draws, so an
// instance's transform lies once in the producer's buffer however many views draw it (Programs/Grass/
// GrassGenerate.shader CameraIds / CascadeIds). gl_InstanceIndex is the slot (the records count slots).
layout( std430, binding = 18 ) readonly buffer GpuInstanceIds
{
    uint instanceIds[];
};
#define DESERT_INSTANCE_INDEX instanceIds[gl_InstanceIndex]
#else
#define DESERT_INSTANCE_INDEX gl_InstanceIndex
#endif

// The one push block (m_PushConstants): under DESERT_SURFACE_DRAW_ROWS it declares DrawRowsLo / DrawRowsHi at
// offset 112 in ShadowSlope's place, the bin's first slot that main() reads the draw row through.
#include <Common/MaterialTransport.glslh>
#include <Common/FoliageWind.glslh>
// The section's wind: its push (a per-variety draw) or its draw row (a bin's draw).
#ifdef DESERT_SURFACE_DRAW_ROWS
#define INSTANCED_WIND_A g_MeshDrawRow.WindA
#define INSTANCED_WIND_B g_MeshDrawRow.WindB
#else
#define INSTANCED_WIND_A m_PushConstants.WindA
#define INSTANCED_WIND_B m_PushConstants.WindB
#endif
#if defined( DESERT_SURFACE_PASS_ShadowDepth ) && !defined( DESERT_SURFACE_BINNED )
// A GPU-instanced still section's cascade layers split its instances by the shadow wind distance
// (CasterWindLayer.glslh); every other caster draw pushes no split. A cascade's bin (GRASS-SHADOW-BINS-1, as
// Vertex_GrassBlade.glslh's): the split and the ring's inner distance are the section's words in its draw row; the
// rule's origin and distance are the bin cell's light camera (the cascade's, as every mesh section's own cell).
#ifdef DESERT_SURFACE_DRAW_ROWS
#define DESERT_CASTER_WIND_SPLIT INSTANCED_WIND_B.w
#define DESERT_CASTER_WIND_INNER g_MeshDrawRow.Caster.w
#endif
#include <Mesh/Surface/CasterWindLayer.glslh>
#endif

#ifdef DESERT_SURFACE_PASS_VisibilityResolve
// THE VISIBILITY RESOLVE (GRASS-VIS-MESH-1, Mesh/Surface/Pass_VisibilityResolve.glslh): no instance is placed here -
// the draw is two triangles per screen tile (the first three indices, 0 1 2, of the producer's resolve mesh,
// GpuInstancedRenderData::ResolveMesh, as Vertex_GrassBlade.glslh's); a tile whose rows miss the section's
// [Visibility.x, + Slots.x x Visibility.y) collapses (FPS-GRASS-RESOLVE, Common/VisibilityBuffer.glslh
// DesertVisibilityTilePosition), so the fragment stage fetches the mesh triangle its pixel's visibility word names
// only over the tiles that hold the section's rows.
#include <Mesh/Surface/GrassMeshVisibility.glslh>
#define DESERT_VISIBILITY_READ_ONLY
#include <Common/VisibilityBuffer.glslh>
void main()
{
    gl_Position = DesertVisibilityTilePosition( uint( gl_InstanceIndex ), uint( gl_VertexIndex ),
                                                MeshRows.Visibility.x, MeshRows.Slots.x * MeshRows.Visibility.y );
}
#else
#ifdef DESERT_SURFACE_HAS_VARYINGS
DESERT_SURFACE_VARYINGS( out )
#endif
#ifdef DESERT_SURFACE_PASS_Visibility
// THE VISIBILITY RASTER (GRASS-VIS-MESH-1, Mesh/Surface/Pass_Visibility.glslh): the mesh grass section's rows
// (GrassMeshVisibility.glslh). The vertex stage is the masked depth cell's (position and the mask's UV, below).
// A bin's draw reads them by address from its draw row.
#ifdef DESERT_SURFACE_DRAW_ROWS
#define GRASS_MESH_VISIBILITY_ROWS g_MeshDrawRow.MeshVisibility
#endif
#include <Mesh/Surface/GrassMeshVisibility.glslh>
layout( location = 15 ) flat out uint v_VisibilityRow;

// The first row of this draw for slot @p slot: the slot's block, then the offset of the level's and the
// submesh's triangles in it. The submesh is the one of THIS section's drawn submeshes whose vertices hold @p vertex
// (the records are mesh-relative: gl_VertexIndex = index + the submesh's VertexOffset); a hidden one may share its
// vertices, the drawn ones never do (GrassRenderer::PrepareVariety tables no section whose drawn ranges overlap).
// A triangle's three corners agree, the row is flat.
uint GrassMeshVisibilityRow( const uint slot, const uint vertex )
{
    const uint level   = GrassMeshVisibilityLevel( slot );
    const uint count   = min( MeshRows.Visibility.w, GRASS_MESH_VISIBILITY_MAX_SUBMESHES );
    uint       submesh = 0u;
    for ( uint s = 0u; s < count; ++s )
    {
        if ( MeshRows.Submeshes[s].z != 0u && vertex >= MeshRows.Submeshes[s].x &&
             vertex - MeshRows.Submeshes[s].x < MeshRows.Submeshes[s].y )
        {
            submesh = s;
            break;
        }
    }
    const uint range = min( level * MeshRows.Visibility.w + submesh, GRASS_MESH_VISIBILITY_MAX_RANGES - 1u );
    return MeshRows.Visibility.x + slot * MeshRows.Visibility.y + MeshRows.Ranges[range].z;
}
#endif

void main()
{
#ifdef DESERT_SURFACE_DRAW_ROWS
    g_MeshDrawRow = GpuInstanceDrawRowOf( uvec2( m_PushConstants.DrawRowsLo, m_PushConstants.DrawRowsHi ),
                                          uint( gl_DrawID ) );
#ifdef DESERT_SURFACE_HAS_VARYINGS
    v_Surface.MaterialRow    = g_MeshDrawRow.MaterialRow; // the fragment's `Material` (SurfaceTypes.glslh)
    v_Surface.PrimitiveFlags = g_MeshDrawRow.PrimitiveFlags;
#endif
#endif
#ifdef DESERT_SURFACE_VIRTUAL_GEOMETRY
    const DesertVgDraw vg       = DesertResolveVgDraw();
    const uint         triangle = uint( gl_VertexIndex ) / 3u;
    if ( triangle >= VgClusterTriangleCount( vg.Cluster ) )
    {
        // Past the cluster's triangles (the draw is kClusterMaxTriangles x 3 vertices): a degenerate, clipped.
        gl_Position = vec4( 0.0, 0.0, -2.0, 1.0 );
        return;
    }
    const VgMeshVertex vertex =
         VgFetchMeshVertex( vg.Dag, VgClusterCornerVertex( vg.Dag, vg.Cluster, triangle, uint( gl_VertexIndex ) % 3u ) );
    const vec3              a_Position     = vertex.Position;
    const vec3              a_Normal       = vertex.Normal;
    const vec3              a_Tangent      = vertex.Tangent;
    const vec3              a_Bitangent    = vertex.Bitangent;
    const vec2              a_TextureCoord = vertex.TextureCoord;
    const vec4              a_Color        = vertex.Color;
    const vec2              a_TexCoord1    = vertex.TexCoord1;
    const DesertMeshDraw    draw           = vg.Draw;
    const GpuScenePrimitive row            = gpuScene.Primitives[draw.Primitive];
    const mat4              model          = draw.World;
    // The cut's rest pose (a caster view past the shadow wind distance, ClusterCut's CutFrame.RestPose): no wind,
    // as the binned cell below - the cut grew such a cluster's box by nothing.
    const vec4              windA          = draw.RestPose ? vec4( 0.0 ) : GpuScene_WindA( row );
    const vec4              windB          = GpuScene_WindB( row, false );
#elif defined( DESERT_SURFACE_BINNED )
    const DesertMeshDraw    draw  = DesertResolveMeshDraw();
    const GpuScenePrimitive row   = gpuScene.Primitives[draw.Primitive];
    const mat4              model = draw.World;
    // A swaying instance the cull drew in its rest pose (a caster view past the shadow wind distance,
    // GpuCull_CastsRestPose): Strength 0 is FoliageWindOffset's "no offset".
    const vec4              windA = draw.RestPose ? vec4( 0.0 ) : GpuScene_WindA( row );
    const vec4              windB = GpuScene_WindB( row, false );
#elif defined( DESERT_SURFACE_SCENE_INSTANCES )
    const GpuSceneInstance  sceneInstance  = gpuSceneInstances.Instances[sceneInstanceIds[DESERT_INSTANCE_INDEX]];
    const GpuScenePrimitive scenePrimitive = gpuScene.Primitives[sceneInstance.Primitive];
    const mat4              sceneLocal     = GpuScene_InstanceToPrimitive( sceneInstance );
    const mat4              model          = GpuScene_LocalToWorld( scenePrimitive ) * sceneLocal;
    vec4                    windA          = INSTANCED_WIND_A;
    const vec4              windB          = INSTANCED_WIND_B;
#ifdef DESERT_SURFACE_PASS_ShadowDepth
    if ( !DesertCasterWindLayer( model[3].xyz, windA ) )
    {
        gl_Position = vec4( 0.0, 0.0, -2.0, 1.0 ); // the other layer's instance: a degenerate, clipped
        return;
    }
#endif
#else
    const mat4 model = transforms[DESERT_INSTANCE_INDEX];
    vec4       windA = INSTANCED_WIND_A;
    const vec4 windB = INSTANCED_WIND_B;
#ifdef DESERT_SURFACE_PASS_ShadowDepth
    if ( !DesertCasterWindLayer( model[3].xyz, windA ) )
    {
        gl_Position = vec4( 0.0, 0.0, -2.0, 1.0 ); // the other layer's instance: a degenerate, clipped
        return;
    }
#endif
#endif
#ifdef DESERT_SURFACE_PASS_Visibility
    // CPU-GRASS-POOL-5: the slot in the shared ids pool less the camera list's first (Slots.y): the section's.
    v_VisibilityRow =
         GrassMeshVisibilityRow( uint( gl_InstanceIndex ) - MeshRows.Slots.y, uint( gl_VertexIndex ) );
#endif
    const vec3 worldPosition = InstancedWorldPosition( model, a_Position, windA, windB );
#if ( defined( DESERT_SURFACE_PASS_Depth ) || defined( DESERT_SURFACE_CASTER_PASS ) || defined( DESERT_SURFACE_PASS_Visibility ) ) &&                           \
     defined( DESERT_SURFACE_HAS_VARYINGS ) && !defined( DESERT_SURFACE_PARALLAX )
    // THE MASKED DEPTH CELLS - the view's early-Z pass and the casters (UE's depth-only / shadow-depth vertex factory:
    // position and the masked UV; MESH-GRASS-COST, as the blade's, Vertex_GrassBlade.glslh) - read one thing of the
    // instance but its place: the opacity mask's UV (Pass_Depth / Pass_ShadowDepth / Pass_VirtualShadowDepth:
    // DESERT_SURFACE_CLIP, DShaderParser OpacityMaskFunction samples `i.UV<set>` and nothing else of SurfaceInput).
    // No shading frame (the normal matrix's inverse, three normalised axes), no previous world nor the wind's second
    // step at the previous clock, no clip pair: the G-buffer cell builds them, the pass that reads them. The place is
    // the one expression every cell evaluates, so gl_Position stays invariant against the base pass. (A `.Parallax`
    // cell evaluates the surface, so it takes the full set below.)
    v_Surface.WorldPosition = worldPosition;
    v_Surface.Normal        = vec3( 0.0, 1.0, 0.0 ); // not read by the depth cells' fragment stage
    v_Surface.UV0           = DesertMeshTextureUV( a_TextureCoord );
    v_Surface.UV1           = DesertMeshTextureUV( a_TexCoord1 );
    v_Surface.VertexColor   = a_Color;
    v_Surface.ObjectScaleUp = 1.0;
    v_Surface.TBN           = mat3( 1.0 ); // not read by the depth cells' fragment stage
    v_Surface.Clip          = vec4( 0.0, 0.0, 0.0, 1.0 );
    v_Surface.PrevClip      = vec4( 0.0, 0.0, 0.0, 1.0 );
    v_Surface.ObjectMoved   = 0.0;
#ifdef DESERT_SURFACE_BINNED
    v_Surface.MaterialRow    = draw.MaterialRow;
    v_Surface.PrimitiveFlags = draw.Flags;
    v_Surface.LodFadeSide    = draw.LodFadeSide;
#endif
#else // the full cell
#ifdef DESERT_SURFACE_HAS_VARYINGS
    const mat3 normalMatrix  = transpose( inverse( mat3( model ) ) );
    const vec3 T             = normalize( normalMatrix * a_Tangent );
    const vec3 B             = normalize( normalMatrix * a_Bitangent );
    const vec3 N             = normalize( normalMatrix * a_Normal );
    v_Surface.WorldPosition  = worldPosition;
    v_Surface.Normal         = N;
    v_Surface.UV0            = DesertMeshTextureUV( a_TextureCoord );
    v_Surface.UV1            = DesertMeshTextureUV( a_TexCoord1 );
    v_Surface.VertexColor    = a_Color;
    v_Surface.ObjectScaleUp = length( mat3( model )[1] );
    v_Surface.TBN            = mat3( T, B, N );
#endif
#if defined( DESERT_SURFACE_BINNED ) && defined( DESERT_SURFACE_HAS_VARYINGS )
    v_Surface.MaterialRow    = draw.MaterialRow;
    v_Surface.PrimitiveFlags = draw.Flags;
    v_Surface.LodFadeSide    = draw.LodFadeSide;
#endif
#ifdef DESERT_SURFACE_VIEW_PASS
    // The instance's previous world: transforms[i + offset], the offset in WindB.w's bits
    // (Graphic::InstanceWindPush, GpuInstancedRenderData::PrevInstanceOffset). A producer whose instances move
    // (particle Mesh rows: ParticleMeshInstances writes last frame's transforms after this frame's, UE
    // NiagaraMeshVertexFactory's PrevPosition) states it; a batch that is world-static by construction (moving an
    // instance rebuilds it; grass) pushes 0 = its own transform. The wind is evaluated again at the view's previous
    // time (WindB.z). No motion row is read.
#ifdef DESERT_SURFACE_BINNED
    // Binned: the primitive's previous world x the same instance / submesh transforms; the wind at the row's previous clock.
    const mat4 prevModel         = draw.PrevWorld;
    const vec3 prevWorldPosition = InstancedWorldPosition( prevModel, a_Position, windA, GpuScene_WindB( row, true ) );
#elif defined( DESERT_SURFACE_SCENE_INSTANCES )
    // By GpuScene id: the primitive's previous world x the instance's (a moved field's rows carry it, no offset).
    const mat4 prevModel         = GpuScene_PrevLocalToWorld( scenePrimitive ) * sceneLocal;
    const vec4 prevWind          = vec4( INSTANCED_WIND_B.x, INSTANCED_WIND_B.z, 0.0, 0.0 );
    const vec3 prevWorldPosition = InstancedWorldPosition( prevModel, a_Position, INSTANCED_WIND_A, prevWind );
#else
    const mat4 prevModel         = transforms[DESERT_INSTANCE_INDEX + floatBitsToUint( INSTANCED_WIND_B.w )];
    const vec4 prevWind          = vec4( INSTANCED_WIND_B.x, INSTANCED_WIND_B.z, 0.0, 0.0 );
    const vec3 prevWorldPosition = InstancedWorldPosition( prevModel, a_Position, INSTANCED_WIND_A, prevWind );
#endif
    v_Surface.Clip     = cameraUB.ViewProjection * vec4( worldPosition, 1.0 );
    v_Surface.PrevClip = cameraUB.PrevViewProjection * vec4( prevWorldPosition, 1.0 );
    // The object-motion flag (Common/Velocity.glslh DesertVelocity w): the INSTANCE moved (a producer whose
    // instances move states their previous transforms); the wind bends the vertices of a still instance and leaves it 0.
    v_Surface.ObjectMoved = prevModel != model ? 1.0 : 0.0;
#elif defined( DESERT_SURFACE_HAS_VARYINGS )
    v_Surface.Clip     = vec4( 0.0, 0.0, 0.0, 1.0 ); // light view: no velocity
    v_Surface.PrevClip = vec4( 0.0, 0.0, 0.0, 1.0 );
    v_Surface.ObjectMoved = 0.0;
#endif
#endif // the masked depth cells
    // Raster with the JITTERED matrix (CameraUB.glslh: raster geometry = JitteredViewProjection); Clip/PrevClip above stay
    // unjittered for velocity. An unjittered gl_Position leaves TAA/TAAU nothing to accumulate.
#ifdef DESERT_VSM_CLUSTER_RASTER
    v_VsmCutView                    = vg.View;
    const mat4 rasterViewProjection = Levels[VsmCutViewLevel( vg.View, uint( Frame.Lod.y ) )].ViewProjection;
#else
    const mat4 rasterViewProjection = cameraUB.JitteredViewProjection;
#endif
    gl_Position = rasterViewProjection * vec4( worldPosition, 1.0 );
#ifdef DESERT_SURFACE_CASTER_PASS
    // The caster's slope depth bias, from the instance's vertex normal (UE: ShadowDepthVertexShader.usf); the
    // wind bends the position, not the normal, as the shading normal above.
    gl_Position = ShadowCasterSlopeBias( gl_Position, rasterViewProjection,
                                         transpose( inverse( mat3( model ) ) ) * a_Normal, cameraUB.ShadowSlopeBias,
                                         cameraUB.ShadowSlopeClamp );
#endif
}
#endif // DESERT_SURFACE_PASS_VisibilityResolve
