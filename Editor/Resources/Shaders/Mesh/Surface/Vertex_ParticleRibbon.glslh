// Surface cell vertex path: particle RIBBONS (UE: the Niagara ribbon vertex factory, a material's "Used with Niagara
// Ribbons" usage). A cell of this path exists only in a template that declares `Usage ParticleRibbons`
// (DShaderParser kSurfaceParticleRibbonPath), and only for the Forward pass: ribbons are drawn by the particle pass
// (ParticleRenderer::DrawPass) and by nothing else. The fragment half is the sprite's (Pass_ParticleSprite.glslh).
//
// Vertexless, on the SAME indirect draw as a sprite row (six vertices per alive particle): the n-th alive particle
// of the drawn half draws the strip SEGMENT between the n-th and (n+1)-th particle of the ribbon's LINK ORDER. The
// order is the GPU's (Programs/Particles/ParticleSort.shader, key 1 = (ParticleRibbonId, ParticleRibbonLinkOrder)
// ascending; UE: the ribbon's sort by RibbonId then RibbonLinkOrder, default the age, so the youngest is the head):
// RibbonOrder holds, at the alive list's offsets, (pool index, length from its ribbon's head, place / (its ribbon's
// count - 1), flags 1 | 2 head | 4 tail), so the neighbours are the next entries of the same ribbon - no search; the
// ribbons of an emitter (the Ribbon row's RibbonIdBinding, UE: one strip per RibbonId) are never joined. Width = the row's Width x the particle's RibbonWidth (UE RibbonWidth), colour =
// its Color, facing = the view (UE FacingMode Screen), U by the row's UV mode: Stretch = 0..1 head to tail (UE
// ScaledUniformly), TileByDistance = length from the head / UVTileDistance (UE TiledOverRibbonLength); V = 0 / 1
// across the width.
#include <Common/CameraUB.glslh>
#include <Common/VFXRandom.glslh>
#include <Common/ParticleDrawLayout.glslh>

// The sprite path's attribute and layout slots (Vertex_ParticleSprite.glslh), read-only.
layout( std430, binding = 9 ) readonly buffer AttributeFloats
{
    float u_DrawFloats[];
};

layout( std430, binding = 11 ) readonly buffer DrawLayout
{
    ParticleDrawLayout u_DrawLayout;
};

// ParticleSort's stage 5 output (uvec4 per alive-list entry, see the header).
layout( std430, binding = 13 ) readonly buffer RibbonOrder
{
    uvec4 u_Ribbon[];
};

#include <Common/ParticleDrawRead.glslh>

#include <Common/MaterialTransport.glslh>
DESERT_SURFACE_VARYINGS( out )

layout( location = 12 ) out flat vec4 v_ParticleColor;
layout( location = 13 ) out flat vec2 v_ParticleTimeRandom; // x = relative time, y = random

#define RIBBON_NONE 0xFFFFFFFFu
#define RIBBON_HEAD 2u // RibbonOrder .w flags: 1 = an entry, 2 = its ribbon's head, 4 = its ribbon's tail
#define RIBBON_TAIL 4u

// The RibbonOrder entry after / before entry @p e in the same ribbon, RIBBON_NONE past its tail / head: two ribbons
// of one emitter sit back to back in the order and are never linked.
uint RibbonNext( uint e )
{
    return e == RIBBON_NONE || ( u_Ribbon[e].w & RIBBON_TAIL ) != 0u ? RIBBON_NONE : e + 1u;
}

uint RibbonPrevious( uint e )
{
    return e == RIBBON_NONE || ( u_Ribbon[e].w & RIBBON_HEAD ) != 0u ? RIBBON_NONE : e - 1u;
}

float RibbonRelativeTime( uint n )
{
    const float lifetime = ParticleLifetime( n );
    return lifetime > 0.0 ? clamp( ParticleAge( n ) / lifetime, 0.0, 1.0 ) : 0.0;
}

float RibbonU( uint e )
{
    const uvec4 entry = u_Ribbon[e];
    return u_DrawLayout.Ribbon.y > 0.5 ? uintBitsToFloat( entry.y ) / u_DrawLayout.Ribbon.z
                                       : uintBitsToFloat( entry.z );
}

void main()
{
    const uint corner = uint( gl_VertexIndex ) % 6u;
    // The drawn alive half starts at 2 Base + h Count (the draw slot's FirstVertex / 6): e = this entry.
    const uint e      = uint( gl_VertexIndex ) / 6u;
    const uint next   = RibbonNext( e );

    // x: -1 = this particle's end of the segment, +1 = the next one's; y: the two edges.
    const vec2 corners[6] = vec2[6]( vec2( -1.0, -1.0 ), vec2( 1.0, -1.0 ), vec2( -1.0, 1.0 ), vec2( 1.0, -1.0 ),
                                     vec2( 1.0, 1.0 ), vec2( -1.0, 1.0 ) );
    const vec2 c          = corners[corner];
    const vec3 facing     = vec3( cameraUB.View[0][2], cameraUB.View[1][2], cameraUB.View[2][2] ); // towards the eye
    const vec3 viewUp     = vec3( cameraUB.View[0][1], cameraUB.View[1][1], cameraUB.View[2][1] );

    // The end this vertex sits on and its two neighbours along the ribbon: the tangent there spans them, so the
    // two segments meeting at a particle share its edge vertices (no cracks at the joints).
    const bool farEnd  = c.x > 0.0 && next != RIBBON_NONE;
    const uint atE     = farEnd ? next : e;
    const uint beforeE = farEnd ? e : RibbonPrevious( e );
    const uint afterE  = farEnd ? RibbonNext( next ) : next;
    const uint at      = ParticleLocalIndex( u_Ribbon[atE].x );

    const vec3 position = ParticleWorldPosition( at );
    const vec3 pBefore  = beforeE != RIBBON_NONE ? ParticleWorldPosition( ParticleLocalIndex( u_Ribbon[beforeE].x ) )
                                                 : position;
    const vec3 pAfter   = afterE != RIBBON_NONE ? ParticleWorldPosition( ParticleLocalIndex( u_Ribbon[afterE].x ) )
                                                : position;
    vec3       tangent  = pAfter - pBefore;
    vec3       side     = cross( tangent, facing );
    side                = dot( side, side ) > 1e-8 ? normalize( side ) : viewUp;
    tangent             = cross( facing, side );

    const float width    = u_DrawLayout.Ribbon.x * ParticleRibbonWidth( at );
    const vec4  colour   = ParticleColor( at );
    // The tail particle has no segment: all six vertices on one point, nothing rasterised.
    const vec3  worldPos = next == RIBBON_NONE ? position : position + side * ( c.y * width * 0.5 );
    const float relative = RibbonRelativeTime( at );

    v_Surface.WorldPosition = worldPos;
    v_Surface.Normal        = facing;
    v_Surface.UV0           = vec2( RibbonU( atE ), 0.5 - c.y * 0.5 );
    v_Surface.UV1           = v_Surface.UV0;
    v_Surface.VertexColor   = colour;
    v_Surface.TBN           = mat3( tangent, -side, facing );
    v_Surface.Clip          = cameraUB.ViewProjection * vec4( worldPos, 1.0 );
    v_Surface.PrevClip      = cameraUB.PrevViewProjection * vec4( worldPos, 1.0 );

    v_ParticleColor      = colour;
    v_ParticleTimeRandom = vec2( relative, VFXRandomFloat4( uvec4( at + u_DrawLayout.Range.y,
                                                                   floatBitsToUint( ParticleLifetime( at ) ), 0u,
                                                                   0u ) ).x );

    gl_Position = cameraUB.JitteredViewProjection * vec4( worldPos, 1.0 );
}
