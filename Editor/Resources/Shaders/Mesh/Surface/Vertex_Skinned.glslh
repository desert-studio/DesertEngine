// Surface cell vertex path: skinned mesh, this draw's bones from BoneMatrices[BoneOffset...] (binding 1).
#include <Common/CameraUB.glslh>
#include <Common/MaterialTransport.glslh>

layout( location = 0 ) in vec3 a_Position;
layout( location = 1 ) in vec3 a_Normal;
layout( location = 4 ) in vec2 a_TextureCoord;
layout( location = 5 ) in ivec4 a_BoneIndices;
layout( location = 6 ) in vec4 a_BoneWeights;

layout( std430, binding = 1 ) readonly buffer Bones
{
    mat4 BoneMatrices[];
}
bones;

DESERT_SURFACE_VARYINGS( out )

void main()
{
    const int  b    = int( m_PushConstants.BoneOffset );
    const mat4 skin = bones.BoneMatrices[b + a_BoneIndices.x] * a_BoneWeights.x +
                      bones.BoneMatrices[b + a_BoneIndices.y] * a_BoneWeights.y +
                      bones.BoneMatrices[b + a_BoneIndices.z] * a_BoneWeights.z +
                      bones.BoneMatrices[b + a_BoneIndices.w] * a_BoneWeights.w;
    const mat4 world        = m_PushConstants.Transform * skin;
    const vec4 worldPos     = world * vec4( a_Position, 1.0 );
    v_Surface.WorldPosition = worldPos.xyz;
    v_Surface.Normal        = normalize( transpose( inverse( mat3( world ) ) ) * a_Normal );
    v_Surface.UV0           = vec2( a_TextureCoord.x, 1.0 - a_TextureCoord.y );
    gl_Position             = cameraUB.Projection * cameraUB.View * worldPos;
}
