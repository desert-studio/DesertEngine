// Surface cell vertex path: one static mesh, its transform in the push block — the vertex stage of
// Programs/Surface/StaticMeshLit.shader and StaticMeshGBuffer.shader, and of Programs/Shadow/Shadow.shader for the
// depth cell of an opaque template.
// The vertex inputs — binding 0 (position, normal, tangent, bitangent, UV0) and the optional streams at binding 1
// (vertex colour, UV1; a mesh without them binds the shared white / (0,0) buffer at the same stride) — and
// DesertMeshTextureUV, GENERATED from the C++ vertex format (Graphic/ShaderProtocols/VertexInputs.hpp). The full
// set in every pass: an input a depth cell does not read costs nothing, a subset would be a second list.
#include <Mesh/MeshVertexInputs.glslh>

#include <Common/CameraUB.glslh>
#ifdef DESERT_SURFACE_CASTER_PASS
#include <Common/ShadowCasterBias.glslh>
#endif
#if defined( DESERT_SURFACE_VIEW_PASS ) || defined( DESERT_SURFACE_BINNED )
#define DESERT_GPU_SCENE_PRIMITIVES 1 // this stage reads its primitive's GpuScene row
#endif
#ifdef DESERT_SURFACE_BINNED
#define DESERT_GPU_SCENE_DRAWS 1 // ...through its instance id: the draw pushes nothing (SurfaceTypes.glslh)
#endif
#include <Common/GpuScene.glslh>
#include <Common/Velocity.glslh>

#ifdef DESERT_SURFACE_HAS_VARYINGS
// The ONE engine push block, as the fragment stage's material row index reads it.
#include <Common/MaterialTransport.glslh>
DESERT_SURFACE_VARYINGS( out )
#elif !defined( DESERT_SURFACE_BINNED )
// The shadow pass pushes the transform alone (Programs/Shadow/Shadow.shader, 64 bytes).
layout( push_constant ) uniform constants
{
    mat4 Transform;
}
m_PushConstants;
#endif

void main()
{
#ifdef DESERT_SURFACE_BINNED
    // Binned: the instance id names the instance, its primitive and its cached draw slot (Common/GpuScene.glslh).
    const DesertMeshDraw draw      = DesertResolveMeshDraw();
    const mat4           world     = draw.World;
    const mat4           prevWorld = draw.PrevWorld;
#elif defined( DESERT_SURFACE_VIEW_PASS )
    // View pass: the object's row holds its current and previous world; Transform is the submesh's transform
    // relative to it (identical in both frames), so a still object gives PrevWorld == World bit for bit.
    const GpuScenePrimitive row       = gpuScene.Primitives[m_PushConstants.PrimitiveIndex];
    const mat4            world     = GpuScene_LocalToWorld( row ) * m_PushConstants.Transform;
    const mat4            prevWorld = GpuScene_PrevLocalToWorld( row ) * m_PushConstants.Transform;
#else
    const mat4 world = m_PushConstants.Transform;
#endif
    const vec4 worldPos = world * vec4( a_Position, 1.0 );
#ifdef DESERT_SURFACE_HAS_VARYINGS
    const mat3 normalMatrix  = transpose( inverse( mat3( world ) ) );
    const vec3 T             = normalize( normalMatrix * a_Tangent );
    const vec3 B             = normalize( normalMatrix * a_Bitangent );
    const vec3 N             = normalize( normalMatrix * a_Normal );
    v_Surface.WorldPosition  = worldPos.xyz;
    v_Surface.Normal         = N;
    v_Surface.UV0            = DesertMeshTextureUV( a_TextureCoord );
    v_Surface.UV1            = DesertMeshTextureUV( a_TexCoord1 );
    v_Surface.VertexColor    = a_Color;
    v_Surface.TBN            = mat3( T, B, N );
#endif
#if defined( DESERT_SURFACE_BINNED ) && defined( DESERT_SURFACE_HAS_VARYINGS )
    v_Surface.MaterialRow    = draw.MaterialRow;
    v_Surface.PrimitiveFlags = draw.Flags;
#endif
#ifdef DESERT_SURFACE_VIEW_PASS
    // Velocity's two clip positions, both UNJITTERED (Common/Velocity.glslh DesertVelocity).
    v_Surface.Clip     = cameraUB.ViewProjection * worldPos;
    v_Surface.PrevClip = cameraUB.PrevViewProjection * ( prevWorld * vec4( a_Position, 1.0 ) );
    // The object-motion flag (Common/Velocity.glslh DesertVelocity w): the transform changed since last frame.
    v_Surface.ObjectMoved = world != prevWorld ? 1.0 : 0.0;
#elif defined( DESERT_SURFACE_HAS_VARYINGS )
    v_Surface.Clip     = vec4( 0.0, 0.0, 0.0, 1.0 ); // light view: no velocity
    v_Surface.PrevClip = vec4( 0.0, 0.0, 0.0, 1.0 );
    v_Surface.ObjectMoved = 0.0;
#endif
    // Raster with the JITTERED matrix (CameraUB.glslh: raster geometry = JitteredViewProjection); Clip/PrevClip above stay
    // unjittered for velocity. An unjittered gl_Position leaves TAA/TAAU nothing to accumulate.
    gl_Position = cameraUB.JitteredViewProjection * worldPos;
#ifdef DESERT_SURFACE_CASTER_PASS
    // The caster's slope depth bias, from the vertex normal (UE: ShadowDepthVertexShader.usf).
    gl_Position = ShadowCasterSlopeBias( gl_Position, cameraUB.JitteredViewProjection,
                                         transpose( inverse( mat3( world ) ) ) * a_Normal, cameraUB.ShadowSlopeBias,
                                         cameraUB.ShadowSlopeClamp );
#endif
}
