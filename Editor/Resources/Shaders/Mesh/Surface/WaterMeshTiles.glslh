// The water mesh's tile rows (Water::WaterTileInstance; UE's FStagingInstanceData, unpacked), read by the
// WaterMesh vertex path (Mesh/Surface/Vertex_WaterMesh.glslh) and mirrored on the CPU by
// Graphic/Systems/Scene/Water/WaterRenderer.cpp (WaterTileRow).
#ifndef DESERT_WATER_MESH_TILES_GLSLH
#define DESERT_WATER_MESH_TILES_GLSLH

// WaterGroundDepth reads the WaterInfo texture (a texture2D, no sampler) with textureSize/texelFetch.
#extension GL_EXT_samplerless_texture_functions : require

struct WaterTileRow
{
    vec4 Tile; // xy = lower (X, Z) corner relative to the zone origin, z = still level Y, w = side length
    vec4 Lod;  // x = LOD level, y = 1 if it morphs, z = 1 if it can morph twice, w = height LOD factor
    vec4 Zone; // xy = the zone's world (X, Z) origin, z = LOD scale (cm), w = quads per side
    // The tile's body (UE: the water mesh tile's WaterBodyIndex): x = its material's row (the draw's MaterialIndex),
    // y = 1 for a river (its surface is clipped to the bank mask, WaterOutsideBank), -1 for an ocean drawn under a
    // river's cut leaf (clipped to the mask's complement, WaterBankClipped), 0 otherwise, z = 1 + its wave set in
    // WaterWaveSets (0 = a flat body; WaterWaveSetOf), w = the body's index in its zone.
    vec4 Body;
};

// One Gerstner wave of a wave set (Water::GerstnerWave; C++ twin WaterRenderer.cpp WaterWaveRow).
struct WaterWaveRow
{
    vec4 Wave; // xy = direction on the (X, Z) plane, z = wavelength (cm), w = amplitude (cm)
    vec4 Form; // x = steepness, yzw unused
};

// The most waves one set draws (UE's generator stops at 128; its presets use 16-32). WaterRenderer refuses more,
// out loud.
#define WATER_MAX_WAVES 32
// The most wave sets one frame draws (UE: each water body owns its wave buffer; here the frame's bodies share up to
// this many distinct sets, a tile picks its body's through WaterTileRow.Body.z). WaterRenderer refuses more, out
// loud: a body past the last set draws flat.
#define WATER_MAX_WAVE_SETS 4

// One body wave set (UE: the water body's wave buffer the water vertex factory reads; C++ twin WaterRenderer.cpp
// WaterWaveSet).
struct WaterWaveSet
{
    vec4         Header; // x = Gerstner wave count, y = 1 when this set IS the frame's FFT ocean, zw = WaveOrigin (X, Z)
    WaterWaveRow Rows[WATER_MAX_WAVES];
};

// Binding 24: free in every surface cell (the mesh paths' own are 1, 13, 17; the pass headers' 7-22, 27). The
// frame's wave sets lead the buffer (read by the vertex path to displace the surface and by Pass_SingleLayerWater
// for the foam and the per-pixel normal), the tiles follow.
layout( std430, binding = 24 ) readonly buffer WaterTiles
{
    vec4         WaterWaveHeader; // x = the frame's wave set count, y = the FFT atlas's first band of THIS frame (0 or WATER_FFT_BANDS_PER_FRAME), z = the WaterInfo atlas's ground region side in texels (= the river region's first row; 0 = no ground), w unused
    vec4         WaterInfoFrame;  // WaterInfoTexture's ground region: xy = lower world (X, Z), z = 1 / side (cm), w = the first set's TargetWaveMaskDepth (cm), 0 = none baked
    vec4         WaterFFTFrame;   // the FFT ocean: xyz = 1 / patch side of cascades 0..2 (1/cm), w = 1 + the atlas's first band of the PREVIOUS frame when a set of this frame IS the FFT ocean (WaterFFTTexture), 0 = no FFT ocean
    vec4         WaterFlowFrame;  // a river's flow (WATER-RIVERS-FFT): x = 1 when a river is in the frame (WaterInfoTexture's river region carries it), y = the two-phase flow's period (s), zw = the river region's size in texels (columns, rows)
    vec4         WaterRiverFrame; // the WaterInfo atlas's river region: xy = lower world (X, Z), zw = 1 / texel along X and Z (1/cm)
    WaterWaveSet WaterWaveSets[WATER_MAX_WAVE_SETS];
    WaterTileRow WaterTileRows[];
};

#include <Common/GerstnerWave.glslh>

// A tile's wave set from its WaterTileRow.Body.z (1 + the set, 0 = a flat body; carried to the fragment in
// VertexColor.a): the set index, or -1 for a flat body.
int WaterWaveSetOf( float bodyWaves )
{
    return bodyWaves > 0.5 ? clamp( int( bodyWaves + 0.5 ) - 1, 0, WATER_MAX_WAVE_SETS - 1 ) : -1;
}

// THE FFT OCEAN'S CASCADES (WATER-RIVERS-FFT; Programs/Water/WaterFFTFinalize.shader writes it each frame): one
// persistent rgba16f atlas of 256 x 3584 texels in two halves of seven bands, written in turn (WaterRenderer's
// ping-pong): this frame's half starts at band WaterWaveHeader.y, the previous frame's at WaterFFTFrame.w - 1, so the
// velocity reads the surface one frame earlier with no copy. Within a half: band c the displacement of cascade c
// (xyz, cm) and its lambda dDx/dz (w), band 3 + c its slopes (xy) and lambda dDx/dx, lambda dDz/dz (zw), band 6
// THE FOAM HISTORY (xyz = cascades 0..2's decayed compression, w unused; WaterFFTFoamHistory). Binding 23: free in
// every surface cell (the list below). Fetched by texel and filtered here with a wrapping bilinear (the patch
// tiles), so it brings no sampler. When WaterFFTFrame.w is 0 the graph's black texture is bound and never read.
// Both WaterMesh cells (SingleLayerWater, FrontLayer) bind it (WaterRenderer::DeclareDraws /
// DeclareFrontLayerDraws).
#define WATER_FFT_SIZE_TILES 256
#define WATER_FFT_CASCADES_TILES 3
#define WATER_FFT_BANDS_PER_FRAME 7
#define WATER_FFT_FOAM_BAND 6
layout( binding = 23 ) uniform texture2D WaterFFTTexture;

// One atlas band (0..13) at a plane point, `invPatch` = 1 / its cascade's side: wrapped bilinear.
vec4 WaterFFTSample( int band, vec2 plane, float invPatch )
{
    const vec2  p  = plane * invPatch * float( WATER_FFT_SIZE_TILES ) - 0.5;
    const ivec2 i0 = ivec2( floor( p ) ) & ( WATER_FFT_SIZE_TILES - 1 );
    const ivec2 i1 = ( i0 + 1 ) & ( WATER_FFT_SIZE_TILES - 1 );
    const vec2  f  = p - floor( p );
    const int   row = band * WATER_FFT_SIZE_TILES;
    const vec4  a  = texelFetch( WaterFFTTexture, ivec2( i0.x, row + i0.y ), 0 );
    const vec4  b  = texelFetch( WaterFFTTexture, ivec2( i1.x, row + i0.y ), 0 );
    const vec4  c  = texelFetch( WaterFFTTexture, ivec2( i0.x, row + i1.y ), 0 );
    const vec4  d  = texelFetch( WaterFFTTexture, ivec2( i1.x, row + i1.y ), 0 );
    return mix( mix( a, b, f.x ), mix( c, d, f.x ), f.y );
}

// The set draws the FFT ocean (the frame has one and this set is it).
bool WaterWavesAreFFT( int waveSet )
{
    return waveSet >= 0 && WaterFFTFrame.w > 0.5 && WaterWaveSets[waveSet].Header.y > 0.5;
}

// This frame's half of the atlas, and the previous frame's (the same half on the first FFT frame).
int WaterFFTCurrentBase()
{
    return int( WaterWaveHeader.y + 0.5 );
}
int WaterFFTPreviousBase()
{
    return int( WaterFFTFrame.w - 0.5 );
}

// THE CASCADES' DISTANCE FADE (UE's water material fades its far detail; Tessendorf's cascades alias into moire
// once a patch spans few pixels): cascade 0 (the swell) always, cascades 1-2 fade out between 4 and 8 of their patch
// sides from the eye. `viewDist` = the still particle's distance to the eye (cm), the same number in both stages
// (Vertex_WaterMesh and Pass_SingleLayerWater measure it from the particle's still position, WaterViewDistance).
vec3 WaterFFTCascadeWeights( float viewDist )
{
    return vec3( 1.0, 1.0 - smoothstep( 4.0, 8.0, viewDist * WaterFFTFrame.y ),
                 1.0 - smoothstep( 4.0, 8.0, viewDist * WaterFFTFrame.z ) );
}

// The eye's distance to a water particle's still position (world (X, Z) `still`, still level `stillY`).
float WaterViewDistance( vec2 still, float stillY, vec3 eye )
{
    return distance( vec3( still.x, stillY, still.y ), eye );
}

// The three cascades' displacement summed (xyz, cm) and their summed lambda dDx/dz (w), from the half at `base`,
// each cascade weighted by its distance fade.
vec4 WaterFFTDisplacementSumAt( int base, vec2 plane, vec3 weight )
{
    return WaterFFTSample( base + 0, plane, WaterFFTFrame.x ) * weight.x +
           WaterFFTSample( base + 1, plane, WaterFFTFrame.y ) * weight.y +
           WaterFFTSample( base + 2, plane, WaterFFTFrame.z ) * weight.z;
}
vec4 WaterFFTDisplacementSum( vec2 plane, vec3 weight )
{
    return WaterFFTDisplacementSumAt( WaterFFTCurrentBase(), plane, weight );
}

// The three cascades' slopes (xy) and choppy derivatives (zw) summed, each weighted by its distance fade.
vec4 WaterFFTSlopeSum( vec2 plane, vec3 weight )
{
    const int base = WaterFFTCurrentBase();
    return WaterFFTSample( base + 3, plane, WaterFFTFrame.x ) * weight.x +
           WaterFFTSample( base + 4, plane, WaterFFTFrame.y ) * weight.y +
           WaterFFTSample( base + 5, plane, WaterFFTFrame.z ) * weight.z;
}

// THE FOAM HISTORY (WaterFFTFinalize: each cascade's compression 1 - J_c, kept as the max of now and the last
// frame's decayed by the set's FFT.FoamDecaySeconds - the accumulate-and-decay foam buffer of AAA FFT oceans): the
// cascades' decayed compression summed under the distance fade. The summed sea's Jacobian is ~1 minus the summed
// compression (the cross terms are second order), so `1 - WaterFFTFoamHistory` is the most folded the surface over
// the particle has lately been, faded by its age.
float WaterFFTFoamHistory( vec2 plane, vec3 weight )
{
    const int  band = WaterFFTCurrentBase() + WATER_FFT_FOAM_BAND;
    const vec3 h    = vec3( WaterFFTSample( band, plane, WaterFFTFrame.x ).x,
                            WaterFFTSample( band, plane, WaterFFTFrame.y ).y,
                            WaterFFTSample( band, plane, WaterFFTFrame.z ).z );
    return dot( max( h, vec3( 0.0 ) ), weight );
}

// The plane point of a world (X, Z): relative to the set's WaveOrigin, as every Gerstner query takes it.
vec2 WaterWavePlane( int waveSet, vec2 worldXZ )
{
    return waveSet >= 0 ? worldXZ - WaterWaveSets[waveSet].Header.zw : worldXZ;
}

// The summed displacement of the plane point at `time` (Engine/Water/GerstnerWaterWaves.cpp WaveDisplacement).
// THE FFT OCEAN carries this frame and the previous one only (the cascades are evaluated at cameraUB.Time): asked at
// any other time it answers the current surface (its foam reads the history band instead, WaterFFTFoamHistory).
// `viewDist`: the cascades' distance fade (WaterFFTCascadeWeights); the Gerstner sets ignore it. A flat body
// (`set` < 0) does not move.
vec3 WaterWavesDisplacement( int waveSet, vec2 plane, float time, float viewDist )
{
    if ( waveSet < 0 )
        return vec3( 0.0 );
    if ( WaterWavesAreFFT( waveSet ) )
        return WaterFFTDisplacementSum( plane, WaterFFTCascadeWeights( viewDist ) ).xyz;
    vec3 d = vec3( 0.0 );
    for ( int k = 0; k < int( WaterWaveSets[waveSet].Header.x ); ++k )
        d += GerstnerWaveOffset( plane, WaterWaveSets[waveSet].Rows[k].Wave.xy, WaterWaveSets[waveSet].Rows[k].Wave.z,
                                 WaterWaveSets[waveSet].Rows[k].Wave.w, WaterWaveSets[waveSet].Rows[k].Form.x, time );
    return d;
}

// The displacement one frame earlier (`prevTime` = cameraUB.PrevTime): the velocity's previous position (UE's
// water writes velocity from the previous frame's waves). The FFT reads the atlas's other half.
vec3 WaterWavesPreviousDisplacement( int waveSet, vec2 plane, float prevTime, float viewDist )
{
    if ( WaterWavesAreFFT( waveSet ) )
        return WaterFFTDisplacementSumAt( WaterFFTPreviousBase(), plane, WaterFFTCascadeWeights( viewDist ) ).xyz;
    return WaterWavesDisplacement( waveSet, plane, prevTime, viewDist );
}

// The displaced surface's normal at the plane point.
vec3 WaterWavesNormal( int waveSet, vec2 plane, float time, float viewDist )
{
    if ( waveSet < 0 )
        return vec3( 0.0, 1.0, 0.0 );
    if ( WaterWavesAreFFT( waveSet ) )
    {
        // Tessendorf 3.4: the height's slope over the choppy-squeezed plane.
        const vec4 s = WaterFFTSlopeSum( plane, WaterFFTCascadeWeights( viewDist ) );
        return normalize( vec3( -s.x / max( 1.0 + s.z, 0.05 ), 1.0, -s.y / max( 1.0 + s.w, 0.05 ) ) );
    }
    vec3 n = vec3( 0.0 );
    for ( int k = 0; k < int( WaterWaveSets[waveSet].Header.x ); ++k )
        n += GerstnerWaveNormalTerm( plane, WaterWaveSets[waveSet].Rows[k].Wave.xy, WaterWaveSets[waveSet].Rows[k].Wave.z,
                                     WaterWaveSets[waveSet].Rows[k].Wave.w, WaterWaveSets[waveSet].Rows[k].Form.x, time );
    return GerstnerFinalizeNormal( n );
}

// The Jacobian determinant of the surface over the plane point at `time` (1 = still, <= 0 = folded over).
float WaterWavesJacobian( int waveSet, vec2 plane, float time, float viewDist )
{
    if ( waveSet < 0 )
        return 1.0;
    if ( WaterWavesAreFFT( waveSet ) )
    {
        // J = (1 + Jxx)(1 + Jzz) - Jxz^2 over the summed cascades.
        const vec3  weight = WaterFFTCascadeWeights( viewDist );
        const vec4  s      = WaterFFTSlopeSum( plane, weight );
        const float xz     = WaterFFTDisplacementSum( plane, weight ).w;
        return ( 1.0 + s.z ) * ( 1.0 + s.w ) - xz * xz;
    }
    vec3 j = vec3( 0.0 );
    for ( int k = 0; k < int( WaterWaveSets[waveSet].Header.x ); ++k )
        j += GerstnerWaveJacobianTerm( plane, WaterWaveSets[waveSet].Rows[k].Wave.xy, WaterWaveSets[waveSet].Rows[k].Wave.z,
                                       WaterWaveSets[waveSet].Rows[k].Wave.w, WaterWaveSets[waveSet].Rows[k].Form.x, time );
    return GerstnerJacobian( j );
}

// THE WATER INFO ATLAS (UE WaterInfo texture: ground depth + river height and velocity; WaterRenderer.cpp
// CreateWaterInfoImage): one RGBA32F image of two regions, each on its own grid so neither is resampled. Read by
// BOTH stages: the vertex path damps the waves by the ground and lays a river on its baked level, the pass judges
// the surf and the banks. Binding 25: free in every surface cell (the list above). Fetched texel by texel and filtered
// here, so neither stage needs a sampler of its own.
//   rows [0, G)        the ground region, G x G (G = WaterWaveHeader.z): .r = the ground's world Y (cm), over the
//                      square WaterInfoFrame names (Water::WaterInfoGround);
//   rows [G, G + R.y)  the river region, R = WaterFlowFrame.zw texels over WaterRiverFrame: (flow x, flow z cm/s,
//                      bank mask, still surface Y cm) - one river's region IS its bake's grid
//                      (Water::RiverFlowField), so the height here and Water::SampleRiverSurfaceY's are one source.
layout( binding = 25 ) uniform texture2D WaterInfoTexture;

// The still water column at a world (X, Z): the still level minus the ground below it, from above - not the scene
// depth behind the pixel, so a mesh in the water is no shallows and the depth does not move with the camera.
// 0 = no ground under it (open sea, or a zone without a landscape).
float WaterGroundDepth( vec2 worldXZ, float stillY )
{
    if ( WaterInfoFrame.w < 0.5 || WaterWaveHeader.z < 0.5 )
        return 0.0;
    const vec2 uv = ( worldXZ - WaterInfoFrame.xy ) * WaterInfoFrame.z;
    if ( any( lessThan( uv, vec2( 0.0 ) ) ) || any( greaterThan( uv, vec2( 1.0 ) ) ) )
        return 0.0;
    const ivec2 size = ivec2( int( WaterWaveHeader.z + 0.5 ) );
    const vec2  p    = clamp( uv * vec2( size ) - 0.5, vec2( 0.0 ), vec2( size - 1 ) );
    const ivec2 i0   = ivec2( floor( p ) );
    const ivec2 i1   = min( i0 + 1, size - 1 );
    const vec2  f    = p - floor( p );
    const float h00  = texelFetch( WaterInfoTexture, i0, 0 ).r;
    const float h10  = texelFetch( WaterInfoTexture, ivec2( i1.x, i0.y ), 0 ).r;
    const float h01  = texelFetch( WaterInfoTexture, ivec2( i0.x, i1.y ), 0 ).r;
    const float h11  = texelFetch( WaterInfoTexture, i1, 0 ).r;
    if ( min( min( h00, h10 ), min( h01, h11 ) ) < -0.5e6 )
        return 0.0; // the landscape's edge: no ground to break on
    const float ground = mix( mix( h00, h10, f.x ), mix( h01, h11, f.x ), f.y );
    return max( stillY - ground, 1.0 ); // over the ground's own level: the thinnest film
}

// The river region's texel at (x, z) of that region; zero (no flow, outside every bank) off it.
vec4 WaterRiverTexel( ivec2 texel )
{
    const ivec2 size = ivec2( WaterFlowFrame.zw + 0.5 );
    if ( any( lessThan( texel, ivec2( 0 ) ) ) || any( greaterThanEqual( texel, size ) ) )
        return vec4( 0.0 );
    return texelFetch( WaterInfoTexture, ivec2( texel.x, int( WaterWaveHeader.z + 0.5 ) + texel.y ), 0 );
}

// The river region's texel space at a world (X, Z): texel centres on integers (Water::SampleRiverSurfaceY's p).
vec2 WaterRiverTexelSpace( vec2 worldXZ )
{
    return ( worldXZ - WaterRiverFrame.xy ) * WaterRiverFrame.zw - 0.5;
}

// THE RIVER FLOW (UE: the river velocity the WaterInfo texture carries): xy = the surface velocity on the (X, Z)
// plane (cm/s), z = the bank mask (1 inside a river's ribbon). Bilinear. Zero off the region or with no river.
vec3 WaterFlowAt( vec2 worldXZ )
{
    if ( WaterFlowFrame.x < 0.5 )
        return vec3( 0.0 );
    const vec2  p  = WaterRiverTexelSpace( worldXZ );
    const ivec2 i0 = ivec2( floor( p ) );
    const vec2  f  = p - floor( p );
    const vec3  a  = WaterRiverTexel( i0 ).rgb;
    const vec3  b  = WaterRiverTexel( i0 + ivec2( 1, 0 ) ).rgb;
    const vec3  c  = WaterRiverTexel( i0 + ivec2( 0, 1 ) ).rgb;
    const vec3  d  = WaterRiverTexel( i0 + ivec2( 1, 1 ) ).rgb;
    return mix( mix( a, b, f.x ), mix( c, d, f.x ), f.y );
}

// THE RIVER'S STILL LEVEL (UE: the river spline's height baked into WaterInfo, read by the water mesh and by the
// CPU query alike): the baked surface Y filtered bilinearly over the in-bank texels only, exactly as the CPU's
// Water::SampleRiverSurfaceY filters the same texels - a bank texel's 0 never drags the level down. `fallbackY`
// (the tile's mean level) where no in-bank texel is near. A function of the world (X, Z) alone, so two tiles that
// share an edge, or a vertex morphing between LODs, read the same level: no step at the tile edges.
bool WaterRiverLevel( vec2 worldXZ, out float level )
{
    level = 0.0;
    if ( WaterFlowFrame.x < 0.5 )
        return false;
    const vec2  p      = WaterRiverTexelSpace( worldXZ );
    const ivec2 i0     = ivec2( floor( p ) );
    const vec2  f      = p - floor( p );
    float       sum    = 0.0;
    float       weight = 0.0;
    for ( int dz = 0; dz < 2; ++dz )
        for ( int dx = 0; dx < 2; ++dx )
        {
            const vec4 t = WaterRiverTexel( i0 + ivec2( dx, dz ) );
            if ( t.b <= 0.5 )
                continue;
            const float w = ( dx == 1 ? f.x : 1.0 - f.x ) * ( dz == 1 ? f.y : 1.0 - f.y );
            sum += w * t.a;
            weight += w;
        }
    if ( !( weight > 0.0 ) )
        return false;
    level = sum / weight;
    return true;
}
float WaterRiverSurfaceY( vec2 worldXZ, float fallbackY )
{
    float level;
    return WaterRiverLevel( worldXZ, level ) ? level : fallbackY;
}

// The river's still surface normal at a world (X, Z): the level's slope across one texel (the CPU's
// Water::QueryWaterBody tilts its PlaneNormal by the same difference, flat along an axis where either side is off
// the banks), up off the river.
float WaterRiverSlope( vec2 worldXZ, vec2 d )
{
    float a;
    float b;
    return WaterRiverLevel( worldXZ + d, a ) && WaterRiverLevel( worldXZ - d, b ) ? ( a - b ) / ( 2.0 * length( d ) ) : 0.0;
}
vec3 WaterRiverSurfaceNormal( vec2 worldXZ )
{
    const vec2 e = 1.0 / max( WaterRiverFrame.zw, vec2( 1e-6 ) );
    return normalize( vec3( -WaterRiverSlope( worldXZ, vec2( e.x, 0.0 ) ), 1.0, -WaterRiverSlope( worldXZ, vec2( 0.0, e.y ) ) ) );
}

// THE BANK BAND (UE's river material: the shore foam and the opacity fade along the spline's edges): 1 at the bank
// line, 0 from WATER_BANK_BAND_CM inside it - the bank mask's worst of the point and its four neighbours that far
// out, so the band is the band's width whatever the 50 cm texel's bilinear edge. 0 on a tile that is not a river.
#define WATER_BANK_BAND_CM 50.0
float WaterRiverBankBand( vec2 worldXZ, float riverTile )
{
    if ( riverTile < 0.5 || WaterFlowFrame.x < 0.5 )
        return 0.0;
    const float r    = WATER_BANK_BAND_CM;
    const float mask = min( min( WaterFlowAt( worldXZ ).z, min( WaterFlowAt( worldXZ + vec2( r, 0.0 ) ).z,
                                                                 WaterFlowAt( worldXZ - vec2( r, 0.0 ) ).z ) ),
                            min( WaterFlowAt( worldXZ + vec2( 0.0, r ) ).z, WaterFlowAt( worldXZ - vec2( 0.0, r ) ).z ) );
    return 1.0 - smoothstep( 0.0, 1.0, mask );
}

// A river tile's fragment outside its banks (UE draws a river as a spline mesh of the ribbon's width; here the
// quadtree leaf overshoots the banks and is clipped to the baked mask). `riverTile` = WaterTileRow.Body.y, carried
// to the fragment in VertexColor.b (Vertex_WaterMesh.glslh). The clip is THE one the CPU queries answer by
// (Water::RiverInsideBank: the same bilinear mask, Water::SampleRiverFlowBilinear, against Water::kRiverBankClip),
// so a body is never told it floats where no water is drawn. The bank band's outer edge (WaterRiverBankBand = 1)
// sits on this line: the foam runs along the cut.
#define WATER_RIVER_BANK_CLIP 0.5
bool WaterOutsideBank( vec2 worldXZ, float riverTile )
{
    return riverTile > 0.5 && WaterFlowAt( worldXZ ).z < WATER_RIVER_BANK_CLIP;
}

// THE RIVER-TO-OCEAN LEAF (UE draws the ocean under the river): a quadtree leaf a river's banks cut, over an ocean,
// is drawn by both bodies (Water::WaterQuadTree TileOwner::HasUnder) - the river clipped to the mask
// (WaterOutsideBank), the ocean (`riverTile` = -1, Water::WaterTileInstance::UnderRiver) to its complement - so
// the leaf is partitioned by the one mask and threshold the CPU answers by (Water::QueryWater: inside the banks
// the river, outside them the ocean): no hole beyond the bank, no double surface inside it.
bool WaterBankClipped( vec2 worldXZ, float riverTile )
{
    if ( riverTile < -0.5 )
        return WaterFlowAt( worldXZ ).z >= WATER_RIVER_BANK_CLIP;
    return WaterOutsideBank( worldXZ, riverTile );
}

// THE TWO-PHASE FLOW (UE's water material FlowMap: two copies of a texture advected along the flow, half a period
// apart, each faded out as it resets): the two advected positions of `worldXZ` at `time` and the second's weight.
// No flow here: both positions are `worldXZ`, the weight 0.
void WaterFlowPhases( vec2 worldXZ, float time, out vec2 p0, out vec2 p1, out float w1 )
{
    p0 = worldXZ;
    p1 = worldXZ;
    w1 = 0.0;
    const vec3 flow = WaterFlowAt( worldXZ );
    if ( flow.z <= 0.0 )
        return;
    const float period = max( WaterFlowFrame.y, 0.05 );
    const float ph0    = fract( time / period );
    const float ph1    = fract( time / period + 0.5 );
    p0                 = worldXZ - flow.xy * ph0 * period;
    p1                 = worldXZ - flow.xy * ph1 * period;
    w1                 = abs( ph0 - 0.5 ) * 2.0;
}

// How much of the body's waves survives over the ground at a world (X, Z) (UE: the water vertex factory's
// GetWaveAttenuationFactor over the WaterInfo depth; the CPU's Water::QueryWaterBody damps by the same function, so
// what floats rides the surface drawn). 1 over open sea.
float WaterWaveAttenuation( vec2 worldXZ, float stillY )
{
    const float depth = WaterGroundDepth( worldXZ, stillY );
    return depth > 0.0 ? GerstnerDepthAttenuation( depth, WaterInfoFrame.w ) : 1.0;
}

// THE PER-PIXEL WAVE FRAME (WATER-RIVERS-FFT R3 3; UE's water material reads the FFT/wave normals per pixel): on the
// FFT ocean the vertex normal is the cascades' slope at the vertex, so the finest cascade (17 m patch, 6.8 cm
// texels) is undersampled by every grid coarser than it and the sun's glint smears across quads. The fragment
// re-reads the slopes at its own particle (`still` = SurfaceInput.UV1, the still (X, Z); `vertexColor` its g = the
// still level, a = 1 + the wave set; Vertex_WaterMesh.glslh) with the same damping and distance fade the vertex
// path used, and builds the same frame (tangent along +X, bitangent along -Z). False (frame untouched) for a
// Gerstner or flat body: their vertex normal is analytic and the grid follows their wavelengths.
bool WaterPixelWaveFrame( vec2 still, vec4 vertexColor, vec3 eye, float time, out mat3 tbn )
{
    tbn = mat3( 1.0 );
    const int waveSet = WaterWaveSetOf( vertexColor.a );
    if ( !WaterWavesAreFFT( waveSet ) )
        return false;
    const float atten = WaterWaveAttenuation( still, vertexColor.g );
    const float dist  = WaterViewDistance( still, vertexColor.g, eye );
    const vec3  N =
         normalize( mix( vec3( 0.0, 1.0, 0.0 ), WaterWavesNormal( waveSet, WaterWavePlane( waveSet, still ), time, dist ), atten ) );
    const vec3 T = normalize( vec3( N.y, -N.x, 0.0 ) );
    const vec3 B = normalize( cross( N, T ) );
    tbn          = mat3( T, B, N );
    return true;
}

#endif // DESERT_WATER_MESH_TILES_GLSLH
