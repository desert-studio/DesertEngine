// LANDSCAPE DISPLACEMENT — the ground's relief as geometry: the landscape material's layer heights (the same height
// maps the height blend reads) moved into the vertex positions, so the silhouette breaks, a bump casts a shadow and
// the depth every pass writes is the displaced surface. UE 5.4+ does this with Nanite tessellation of the landscape
// (the material's Displacement output = height x Magnitude around Center, faded out with distance); here the dicing
// is the tile's own decoded grid: the cells of the tile's DiceWindow (the cells the fade reaches, chosen on the CPU
// from the MAIN camera, TerrainRenderer) are split into dice x dice sub-cells, and every sub-vertex is the
// barycentric point of the cell's own triangle (LandscapeVertexEval.glslh's morphed corners) pushed along the
// smooth base normal. Mac has no tessellation stage worth using (MoltenVK emulates it, see TerrainVertex.glslh),
// and the decode keeps one draw per tile with no vertex or index buffer.
//
// WHY NO CRACKS:
//  - With the displacement at zero the diced cell IS the undiced cell: its sub-vertices lie on its two triangles.
//  - A sub-vertex on a cell edge is a weighted sum of that edge's two corners only (the third weight is an exact
//    zero), in the same order from both cells, and the corners are LandscapeEvaluateVertex's bit-exact points.
//  - The window's border lies outside the fade (its cells cover the fade's disc), so diced and undiced cells meet
//    where nothing is displaced.
//  - The displacement is zero wherever a vertex's continuous LOD reaches 1 (LandscapeDisplacementLodScale): a LOD
//    >= 1 snaps to the coarser grid, where two tiles of different grids meet with different vertices, so nothing
//    is moved there; LOD < 1 is the LOD-0 grid on both sides of every border, diced alike (one dice per frame).
//
// The includer declares CurrentTerrain, HeightmapTexture, WeightmapTexture and LayerHeightTexture, and includes
// LandscapeHeight.glslh, LandscapeLod.glslh, LandscapeWeights.glslh and LandscapeVertexEval.glslh first.
#ifndef LANDSCAPE_DISPLACEMENT_GLSLH
#define LANDSCAPE_DISPLACEMENT_GLSLH

// A decoded vertex of the tile's draw: the cell (on the tile's LOD grid) and the sub-vertex in it, 0..Dice.
struct LandscapeDrawVertex
{
    int CellX;
    int CellZ;
    int SubX;
    int SubZ;
    int Dice;
};

// Draw vertex @p vertex of a tile whose grid has @p cells per side: first the window's cells, dice x dice sub-cells
// each, six vertices a sub-cell in LandscapeLod's corner order; then every other cell, six vertices each, rows below
// the window, the window's rows outside it, rows above (TerrainBatch.hpp LandscapeDicedVertexCount counts the same).
LandscapeDrawVertex LandscapeDecodeDrawVertex( int vertex, int cells )
{
    LandscapeDrawVertex d;
    d.Dice     = max( int( CurrentTerrain.DisplacementView.w + 0.5 ), 1 );
    ivec4 win  = ivec4( CurrentTerrain.DiceWindow + vec4( 0.5 ) );
    int   wx   = d.Dice > 1 ? max( win.z - win.x, 0 ) : 0;
    int   wz   = d.Dice > 1 ? max( win.w - win.y, 0 ) : 0;
    int   diced = wx * wz * d.Dice * d.Dice * 6;
    if ( vertex < diced )
    {
        int sub    = vertex / 6;
        int corner = vertex - sub * 6;
        int per    = d.Dice * d.Dice;
        int cell   = sub / per;
        int s      = sub - cell * per;
        int sz     = s / d.Dice;
        int cz     = cell / wx;
        d.CellX    = win.x + ( cell - cz * wx );
        d.CellZ    = win.y + cz;
        d.SubX     = ( s - sz * d.Dice ) + LandscapeLodCornerX( corner );
        d.SubZ     = sz + LandscapeLodCornerZ( corner );
        return d;
    }
    int r      = vertex - diced;
    int cell   = r / 6;
    int corner = r - cell * 6;
    d.Dice     = 1;
    d.SubX     = LandscapeLodCornerX( corner );
    d.SubZ     = LandscapeLodCornerZ( corner );
    int below  = win.y * cells;
    int side   = cells - wx;
    if ( wx == 0 || wz == 0 || cell < below )
    {
        d.CellZ = cell / cells;
        d.CellX = cell - d.CellZ * cells;
        return d;
    }
    int r2 = cell - below;
    if ( r2 < wz * side )
    {
        int row = r2 / side;
        int k   = r2 - row * side;
        d.CellZ = win.y + row;
        d.CellX = k < win.x ? k : k + wx;
        return d;
    }
    int r3  = r2 - wz * side;
    int row = r3 / cells;
    d.CellZ = win.w + row;
    d.CellX = r3 - row * cells;
    return d;
}

// The tile-local grid coordinate of cell corner @p c (stride of the tile's grid LOD; the last cell is narrower).
int LandscapeCellCorner( int c, int stride, int quads )
{
    return c * stride < quads ? c * stride : quads;
}

// One layer height map fetch (TerrainInstance.InputSlices' w) at @p uv, at the mip the sub-cell's footprint reads.
float LandscapeLayerHeightFetch( float slice, vec2 uv, float uvPerCm, float edgeCm )
{
    float texels = edgeCm * uvPerCm * float( textureSize( LayerHeightTexture, 0 ).x );
    return textureLod( LayerHeightTexture, vec3( uv, slice ), log2( max( texels, 1.0 ) ) ).r;
}

// Input @p k's height at @p worldPos, with the surface's distance-blended far fetch (LandscapeSurface.glslh
// TerrainSampleInput): the relief the geometry carries is the relief the normal map shades. 0.5 = no height map.
float LandscapeInputHeight( int k, vec3 worldPos, float farMix, float edgeCm )
{
    if ( k < 0 )
        return 0.5;
    int   i     = clamp( k, 0, 7 );
    float slice = CurrentTerrain.InputSlices[i].w;
    if ( slice < 0.0 || CurrentTerrain.InputSlices[i].x < 0.0 )
        return 0.5;
    float uvPerCm = 1.0 / max( CurrentTerrain.InputTileSize[i / 4][i % 4], 1.0 );
    vec2  uv      = worldPos.xz * uvPerCm;
    float nearH   = farMix < 1.0 ? LandscapeLayerHeightFetch( slice, uv, uvPerCm, edgeCm ) : 0.0;
    if ( farMix <= 0.0 )
        return nearH;
    float farScale = max( CurrentTerrain.DisplacementTiling.y, 1.0 );
    float farH = LandscapeLayerHeightFetch( slice, uv / farScale + vec2( 0.37, 0.61 ), uvPerCm / farScale, edgeCm );
    return mix( nearH, farH, farMix );
}

int LandscapeInputBlendOf( int k )
{
    return k < 0 ? 0 : int( floor( CurrentTerrain.InputBlend[clamp( k, 0, 7 ) / 4][clamp( k, 0, 7 ) % 4] + 0.5 ) );
}

// THE MATERIAL'S DISPLACEMENT INPUT at @p worldPos (0..1): the layer heights blended by the tile's weights, the
// height blend included — EvaluateLandscapeSurface's blend, run on the height alone.
float LandscapeDisplacementHeight( vec3 worldPos, vec2 tileSample, float viewDistance, float edgeCm )
{
    float start       = CurrentTerrain.DisplacementTiling.x;
    float farMix      = clamp( ( viewDistance - 0.5 * start ) / max( start, 1.0 ), 0.0, 1.0 );
    int   groundInput = int( floor( CurrentTerrain.GroundInput.x + 0.5 ) );
    bool  hasGround   = CurrentTerrain.GroundColor.a > 0.5;
    float groundH     = hasGround ? LandscapeInputHeight( groundInput, worldPos, farMix, edgeCm ) : 0.5;
    if ( CurrentTerrain.Params2.y <= 0.5 )
        return groundH;

    vec2  size  = vec2( textureSize( WeightmapTexture, 0 ) );
    float pages = CurrentTerrain.Params2.z;
    vec4  w0    = textureLod( WeightmapTexture, LandscapeWeightmapPageUV( tileSample, 0.0, size, pages ), 0.0 );
    vec4  w1    = pages > 1.5 ? textureLod( WeightmapTexture, LandscapeWeightmapPageUV( tileSample, 1.0, size, pages ), 0.0 )
                              : vec4( 0.0 );
    vec4 drawn0 = vec4( CurrentTerrain.LayerColors[0].a, CurrentTerrain.LayerColors[1].a, CurrentTerrain.LayerColors[2].a,
                        CurrentTerrain.LayerColors[3].a );
    vec4 drawn1 = vec4( CurrentTerrain.LayerColors[4].a, CurrentTerrain.LayerColors[5].a, CurrentTerrain.LayerColors[6].a,
                        CurrentTerrain.LayerColors[7].a );
    vec4 a0 = vec4( 0.0 ), a1 = vec4( 0.0 ), hb0 = vec4( 0.0 ), hb1 = vec4( 0.0 ), h0 = vec4( 0.5 ), h1 = vec4( 0.5 );
    for ( int i = 0; i < 8; ++i )
    {
        int   k    = int( floor( CurrentTerrain.LayerInput[i / 4][i % 4] + 0.5 ) );
        int   type = k >= 0 ? LandscapeInputBlendOf( k ) : ( CurrentTerrain.LayerAlphaBlend[i / 4][i % 4] > 0.5 ? 2 : 0 );
        float w    = i < 4 ? w0[i] : w1[i - 4];
        float h    = w > 0.0 && CurrentTerrain.LayerColors[i].a > 0.5 ? LandscapeInputHeight( k, worldPos, farMix, edgeCm ) : 0.5;
        if ( i < 4 )
        {
            a0[i]  = type == 2 ? 1.0 : 0.0;
            hb0[i] = type == 1 ? 1.0 : 0.0;
            h0[i]  = h;
        }
        else
        {
            a1[i - 4]  = type == 2 ? 1.0 : 0.0;
            hb1[i - 4] = type == 1 ? 1.0 : 0.0;
            h1[i - 4]  = h;
        }
    }
    float groundHB = hasGround && groundInput >= 0 && LandscapeInputBlendOf( groundInput ) == 1 ? 1.0 : 0.0;
    if ( dot( hb0, drawn0 ) + dot( hb1, drawn1 ) + groundHB > 0.0 )
    {
        LandscapeBlendWeights hb = LandscapeHeightBlend( w0, w1, drawn0, drawn1, a0, a1, hb0, hb1, h0, h1, groundH, groundHB );
        w0 = hb.W0;
        w1 = hb.W1;
    }
    return LandscapeWeightBlend( w0, w1, vec4( h0.x, 0.0, 0.0, drawn0.x ), vec4( h0.y, 0.0, 0.0, drawn0.y ),
                                 vec4( h0.z, 0.0, 0.0, drawn0.z ), vec4( h0.w, 0.0, 0.0, drawn0.w ),
                                 vec4( h1.x, 0.0, 0.0, drawn1.x ), vec4( h1.y, 0.0, 0.0, drawn1.y ),
                                 vec4( h1.z, 0.0, 0.0, drawn1.z ), vec4( h1.w, 0.0, 0.0, drawn1.w ), a0, a1,
                                 vec3( groundH, 0.0, 0.0 ) ).x;
}

// How much of the displacement a vertex at continuous LOD @p lod keeps: all of it on the LOD-0 grid, none from
// LOD 1 on (see WHY NO CRACKS), a smooth ramp between so a LOD change never pops the relief.
float LandscapeDisplacementLodScale( float lod )
{
    return 1.0 - smoothstep( 0.5, 1.0, lod );
}

// A displaced landscape vertex: where it is, its base (smooth) normal and the tile-local sample it stands on.
struct LandscapeDisplacedVertex
{
    vec3 WorldPos;
    vec3 Normal;
    vec2 Local;
};

LandscapeDisplacedVertex LandscapeDisplacedEvaluate( int vertex )
{
    int iquads  = int( CurrentTerrain.LandscapeTile.z + 0.5 );
    int gridLod = int( CurrentTerrain.Params.w + 0.5 );
    int stride  = LandscapeLodStride( gridLod );
    int cells   = ( iquads + stride - 1 ) / stride;
    LandscapeDrawVertex d = LandscapeDecodeDrawVertex( vertex, cells );

    int x0 = LandscapeCellCorner( d.CellX, stride, iquads );
    int z0 = LandscapeCellCorner( d.CellZ, stride, iquads );
    int x1 = LandscapeCellCorner( d.CellX + 1, stride, iquads );
    int z1 = LandscapeCellCorner( d.CellZ + 1, stride, iquads );

    // An undiced cell's vertex is its grid vertex, as TerrainVertex.glslh always drew it, and is never displaced:
    // undiced cells lie outside the fade (or the tile's grid is past LOD 0, or displacement is off).
    if ( d.Dice == 1 )
    {
        LandscapeMorphedVertex m = LandscapeEvaluateVertex( d.SubX == 1 ? x1 : x0, d.SubZ == 1 ? z1 : z0 );
        vec2 g0 = LandscapeVertexGradient( m );
        LandscapeDisplacedVertex u;
        u.WorldPos = m.WorldPos;
        u.Normal   = normalize( vec3( -g0.x, 1.0, -g0.y ) );
        u.Local    = m.Local;
        return u;
    }

    // The cell's triangle the sub-vertex is on — (00, 10, 11) where SubX >= SubZ, (00, 01, 11) otherwise, the
    // cell's diagonal being (00)-(11) — and its barycentric weights; a corner of the cell is exactly its corner.
    bool  lower = d.SubX >= d.SubZ;
    float fx    = float( d.SubX ) / float( d.Dice );
    float fz    = float( d.SubZ ) / float( d.Dice );
    float wa    = lower ? 1.0 - fx : 1.0 - fz;
    float wb    = lower ? fx - fz : fz - fx;
    float wc    = lower ? fz : fx;
    LandscapeMorphedVertex a = LandscapeEvaluateVertex( x0, z0 );
    LandscapeMorphedVertex b = lower ? LandscapeEvaluateVertex( x1, z0 ) : LandscapeEvaluateVertex( x0, z1 );
    LandscapeMorphedVertex c = LandscapeEvaluateVertex( x1, z1 );
    // One sum, a then b then c: a point on a cell edge has an exact zero weight on the third corner, so both cells
    // of the edge round the same two products the same way.
    LandscapeDisplacedVertex v;
    v.WorldPos = a.WorldPos * wa + b.WorldPos * wb + c.WorldPos * wc;
    v.Local    = a.Local * wa + b.Local * wb + c.Local * wc;
    vec2 g     = LandscapeVertexGradient( a ) * wa + LandscapeVertexGradient( b ) * wb + LandscapeVertexGradient( c ) * wc;
    v.Normal   = normalize( vec3( -g.x, 1.0, -g.y ) ); // the surface y = h(x, z)

    float magnitude = CurrentTerrain.Displacement.x;
    if ( magnitude == 0.0 )
        return v;
    float lod   = a.Lod * wa + b.Lod * wb + c.Lod * wc;
    float dist  = length( v.WorldPos - CurrentTerrain.DisplacementView.xyz );
    float fade  = 1.0 - smoothstep( CurrentTerrain.Displacement.z, max( CurrentTerrain.Displacement.w, CurrentTerrain.Displacement.z + 1.0 ), dist );
    float scale = fade * LandscapeDisplacementLodScale( lod );
    if ( scale <= 0.0 )
        return v;
    float edgeCm = float( x1 - x0 ) * CurrentTerrain.LandscapeFrame.w / float( d.Dice );
    float h      = LandscapeDisplacementHeight( v.WorldPos, v.Local, dist, max( edgeCm, 1.0 ) );
    v.WorldPos += v.Normal * ( ( h - CurrentTerrain.Displacement.y ) * magnitude * scale );
    return v;
}

#endif // LANDSCAPE_DISPLACEMENT_GLSLH
