// WHERE A LANDSCAPE VERTEX IS — one statement shared by the raster vertex stage (TerrainVertex.glslh) and the
// ray-tracing vertex compute (LandscapeRayTracingVertices.shader), so the BLAS a ray hits is the surface the
// camera drew: same grid, same LOD, same morph, same height decode (UE evaluates its landscape vertex factory for
// ray tracing the same way, FLandscapeRayTracingImpl). The includer declares `CurrentTerrain` (its TerrainInstance row) and
// `HeightmapTexture` and includes LandscapeHeight.glslh and LandscapeLod.glslh first.
#ifndef LANDSCAPE_VERTEX_EVAL_GLSLH
#define LANDSCAPE_VERTEX_EVAL_GLSLH

// One sample of this tile in centimetres above the root's base, x and z in [-1, last + 1]. The heightmap carries
// a one-sample ring from the four neighbouring tiles (LandscapeBorderedSamples in LandscapeData.hpp), so texel
// (x + 1, z + 1) is sample (x, z).
float TileHeightCm( int x, int z )
{
    return LandscapeHeightCmFromSample( LandscapeSampleFromUnorm( texelFetch( HeightmapTexture, ivec2( x + 1, z + 1 ), 0 ).r ),
                                        CurrentTerrain.LandscapeTile.w );
}

// 1 when this tile's neighbour on a side is loaded (its row is in the ring), 0 on the landscape's own edge.
// Params2.w is LandscapeNeighbourMask: West, East, South, North in bits 0..3.
float NeighbourPresent( int bit )
{
    return float( ( int( CurrentTerrain.Params2.w + 0.5 ) >> bit ) & 1 );
}

// dh/dx, dh/dz at a sample — the CPU's GradientAt (LandscapeData.cpp), the same .glslh functions on the same
// bordered samples. Central on a seam, so both tiles give it the same bits.
vec2 TileGradient( int x, int z )
{
    float last    = CurrentTerrain.LandscapeTile.z;
    float xa      = LandscapeGradientLow( float( x ), NeighbourPresent( 0 ) );
    float xb      = LandscapeGradientHigh( float( x ), last, NeighbourPresent( 1 ) );
    float za      = LandscapeGradientLow( float( z ), NeighbourPresent( 2 ) );
    float zb      = LandscapeGradientHigh( float( z ), last, NeighbourPresent( 3 ) );
    float spacing = CurrentTerrain.LandscapeFrame.w;
    return vec2( LandscapeGradient( TileHeightCm( int( xa ), z ), TileHeightCm( int( xb ), z ), xb - xa, spacing ),
                 LandscapeGradient( TileHeightCm( x, int( za ) ), TileHeightCm( x, int( zb ) ), zb - za, spacing ) );
}

// A grid vertex after its geomorph: the two grid samples it blends, by how much, and where it lands.
struct LandscapeMorphedVertex
{
    int   X0;
    int   Z0;
    int   X1;
    int   Z1;
    float Morph;
    float Lod;      // the continuous LOD the morph came from (LandscapeDisplacement.glslh fades the relief out by it)
    vec2  Local;    // the sample coordinate within the tile (what the hole test and the weightmap read)
    vec3  WorldPos; // cm
};

// The continuous LOD of section (sx, sz) of the row's table, sx and sz in [-1, sections] (TerrainBatch.hpp
// LandscapeSectionLodAt; 0 where no neighbour is: max() with it is the section's own).
float LandscapeSectionLodAt( int sx, int sz )
{
    int i = ( sz + 1 ) * LANDSCAPE_SECTION_TABLE + sx + 1;
    int k = i / 4;
    return CurrentTerrain.SectionLods[k][i - k * 4];
}

// THE VERTEX'S LOD (TERRAIN-LOD-1; UE LandscapeVertexFactory.ush CalcLOD per section): its section's own LOD,
// blended toward each border's max() with the section across it - in this tile or in the neighbour's (the table's
// ring) - and on a corner the max of the four sections there. The section is the vertex's tile-local coordinate's
// (a vertex on a section line is the next section's first; either side's formula gives its border value, the same
// max() of the same two floats), so every draw of every view that evaluates a vertex gives it one LOD.
float LandscapeVertexLod( int ix, int iz, int iquads )
{
    int   sq      = max( int( CurrentTerrain.Sections.x + 0.5 ), 1 );
    int   ns      = max( int( CurrentTerrain.Sections.y + 0.5 ), 1 );
    int   sx      = min( ix / sq, ns - 1 );
    int   sz      = min( iz / sq, ns - 1 );
    int   x0      = sx * sq;
    int   z0      = sz * sq;
    float center  = LandscapeSectionLodAt( sx, sz );
    vec4  edges   = vec4( max( center, LandscapeSectionLodAt( sx - 1, sz ) ), max( center, LandscapeSectionLodAt( sx + 1, sz ) ),
                          max( center, LandscapeSectionLodAt( sx, sz - 1 ) ), max( center, LandscapeSectionLodAt( sx, sz + 1 ) ) );
    vec4  corners = vec4( max( max( edges.x, edges.z ), LandscapeSectionLodAt( sx - 1, sz - 1 ) ),
                          max( max( edges.y, edges.z ), LandscapeSectionLodAt( sx + 1, sz - 1 ) ),
                          max( max( edges.x, edges.w ), LandscapeSectionLodAt( sx - 1, sz + 1 ) ),
                          max( max( edges.y, edges.w ), LandscapeSectionLodAt( sx + 1, sz + 1 ) ) );
    return LandscapeCalcSectionLod( float( ix - x0 ), float( iz - z0 ), float( min( x0 + sq, iquads ) - x0 ),
                                    float( min( z0 + sq, iquads ) - z0 ), center, edges, corners, CurrentTerrain.Params2.x );
}

// The vertex at tile-local grid coordinate (ix, iz) of the tile's LOD grid. Everything that decides a vertex on
// a shared tile edge is exact and symmetric: the tile-local coordinate is an integer, the edge's LOD is the same
// max() on both sides, the snap keeps the last sample, the far column of one tile is the near column of the next.
// So both tiles place the vertex at the same bits, and no crack can open between LODs either.
LandscapeMorphedVertex LandscapeEvaluateVertex( int ix, int iz )
{
    int   iquads = int( CurrentTerrain.LandscapeTile.z + 0.5 );
    float lod    = LandscapeVertexLod( ix, iz, iquads );
    int   lodLo  = int( floor( lod ) );
    int   stride = LandscapeLodStride( lodLo );

    LandscapeMorphedVertex v;
    v.Morph = lod - float( lodLo );
    v.Lod   = lod;
    v.X0    = LandscapeLodSnap( ix, stride, iquads );
    v.Z0    = LandscapeLodSnap( iz, stride, iquads );
    v.X1    = LandscapeLodSnap( ix, stride * 2, iquads );
    v.Z1    = LandscapeLodSnap( iz, stride * 2, iquads );
    // Morph toward the next LOD's vertex. At morph 0 this is the sample itself, bit for bit — the vertex Jolt's
    // heightfield has there.
    float h = LandscapeLodMorph( TileHeightCm( v.X0, v.Z0 ), TileHeightCm( v.X1, v.Z1 ), v.Morph );
    v.Local = vec2( LandscapeLodMorph( float( v.X0 ), float( v.X1 ), v.Morph ),
                    LandscapeLodMorph( float( v.Z0 ), float( v.Z1 ), v.Morph ) );
    vec2 worldXZ = CurrentTerrain.LandscapeFrame.xz + ( CurrentTerrain.LandscapeTile.xy + v.Local ) * CurrentTerrain.LandscapeFrame.w;
    v.WorldPos   = vec3( worldXZ.x, CurrentTerrain.LandscapeFrame.y + h, worldXZ.y );
    return v;
}

// dh/dx, dh/dz of the morphed vertex: the two grid samples' gradients, morphed like the position.
vec2 LandscapeVertexGradient( LandscapeMorphedVertex v )
{
    vec2 d0 = TileGradient( v.X0, v.Z0 );
    vec2 d1 = TileGradient( v.X1, v.Z1 );
    return vec2( LandscapeLodMorph( d0.x, d1.x, v.Morph ), LandscapeLodMorph( d0.y, d1.y, v.Morph ) );
}

#endif // LANDSCAPE_VERTEX_EVAL_GLSLH
