// The terrain's fragment surface, shared by the two Terrain programs that shade it (Terrain = forward,
// TerrainGBuffer = deferred): ONE statement of what the ground IS at a pixel — normal and albedo — before
// any light. The forward program lights it itself; the G-buffer program hands it to the deferred
// composite, which is what lights (and shadows) every other opaque surface.
        // The ground is the landscape's painted layer infos and nothing built in (UE's landscape): where no
        // layer is painted the root's FIRST layer shows, as UE's first layer does, and a root that names no
        // layer is white ground under the material's Tint. Lit with the analytic normal from the vertex stage.

        In(0) vec3 v_WorldPos;
        In(1) vec3 v_Normal;


        // Engine-filled terrain UB (binding 0) — shared frame data only; the per-terrain half (Model,
        // Params, ground and layer colours) is this draw's TerrainInstances row, see the note above Vertex.
        Uniform(0) TerrainUB
        {
            mat4 View;
            mat4 Projection;
            vec4 SunDir;     // xyz = normalized light direction (scene directional light)
            vec4 SunColor;   // rgb = color, a = intensity
        }
        u;

        #include <Common/TerrainInstance.glslh>
        ReadBuffer(8) TerrainInstances
        {
            TerrainInstance u_Terrains[];
        };
        // m_PushConstants is already declared here: the generated Materials[] transport injects
        // MaterialTransport.glslh at the top of the fragment stage, and its include guard makes this
        // stage's declaration one with the other stages' explicit includes.
        #define u_T u_Terrains[m_PushConstants.MaterialIndex]

        // Data-driven material params (binding 1) are generated from the Properties block above and read
        // through `u_Material`; nothing is declared here.

        // The tile's painted weight layers, one per RGBA8 channel, four to a page and the pages stacked along
        // the image's height (LandscapeECSSystem's copy of the tile's LandscapeWeightLayer weights, one texel
        // per sample, no neighbour ring; Params2.z pages). Read only when the row says the tile has layers
        // (Params2.y > 0); otherwise the binding holds the backend's white fallback.
        Uniform(10) sampler2D u_Weightmap;

        #include <Common/LandscapeWeights.glslh>

        struct TerrainSurface
        {
            vec3 N;
            vec3 Albedo; // untinted: the forward program tints its lit result, the G-buffer its albedo
        };

        TerrainSurface EvaluateTerrainSurface()
        {
            vec3 N      = normalize( v_Normal );
            vec3 albedo = u_T.GroundColor.a > 0.5 ? u_T.GroundColor.rgb : vec3( 1.0 );

            // Painted layers over the ground. g = this pixel's sample coordinate within the tile (the
            // same global-sample frame the vertex stage places the tile by), and the texel centre of sample
            // i is (i + 0.5) / size, so the filter blends neighbouring samples as the mesh interpolates them.
            if ( u_T.Params2.y > 0.5 )
            {
                vec2  g     = ( v_WorldPos.xz - u_T.LandscapeFrame.xz ) / u_T.LandscapeFrame.w - u_T.LandscapeTile.xy;
                vec2  size  = vec2( textureSize( u_Weightmap, 0 ) );
                float pages = u_T.Params2.z;
                vec4  w0    = texture( u_Weightmap, LandscapeWeightmapPageUV( g, 0.0, size, pages ) );
                vec4  w1    = pages > 1.5 ? texture( u_Weightmap, LandscapeWeightmapPageUV( g, 1.0, size, pages ) )
                                          : vec4( 0.0 );
                // UE's Landscape Visibility Mask: the tile's visibility layer punches a hole (the shadow
                // caster, TerrainShadow.shader, discards on the same test).
                if ( LandscapeIsHole( LandscapeVisibility( w0, w1, u_T.Params.z ) ) )
                    discard;
                albedo = LandscapeWeightBlend(
                     w0, w1, u_T.LayerColors[0], u_T.LayerColors[1], u_T.LayerColors[2], u_T.LayerColors[3],
                     u_T.LayerColors[4], u_T.LayerColors[5], u_T.LayerColors[6], u_T.LayerColors[7],
                     u_T.LayerAlphaBlend[0], u_T.LayerAlphaBlend[1], albedo );
            }

            TerrainSurface s;
            s.N      = N;
            s.Albedo = albedo;
            return s;
        }
