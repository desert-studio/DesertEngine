// Terrain patch stage bodies, shared by the three Terrain programs (Terrain = forward, TerrainGBuffer =
// deferred, TerrainShadow = cascade depth): ONE statement of where a terrain vertex is, so the surface a
// cascade sees is the surface the camera sees — same patches, same tessellation, same displacement.
        // Tessellation evaluation — places each tessellated vertex of a landscape tile at its global sample
        // coordinate and displaces it by the tile's heights, bilinearly between samples, exactly as the CPU
        // answers a height query (LandscapeHeight.glslh is the one statement of both).

        layout( quads, equal_spacing, cw ) in;

        // No TerrainUB here: this stage projects with the pushed matrix (m_PushConstants.Transform) — the
        // camera's Projection * View in the camera passes, a cascade's matrix in the shadow pass.

        #include <Common/MaterialTransport.glslh>

        #include <Common/TerrainInstance.glslh>
        ReadBuffer(8) TerrainInstances
        {
            TerrainInstance u_Terrains[];
        };
        #define u_T u_Terrains[m_PushConstants.MaterialIndex]

        In(0) vec2 tc_WorldXZ[];
        In(1) vec2 tc_SampleXZ[];

        // A landscape tile's heights: the R16_UNORM copy of its uint16 samples (LandscapeECSSystem). Read
        // ONLY by texelFetch — a filtered read would blend samples the CPU never blends, and the decode
        // below recovers the exact integer each texel was uploaded from.
        Uniform(9) sampler2D u_Heightmap;

        #include <Common/LandscapeHeight.glslh>

        // A caster writes depth and nothing else: the shading outputs exist only for the programs that shade.
#ifndef TERRAIN_DEPTH_ONLY
        Out(0) vec3 v_WorldPos;
        Out(1) vec3 v_Normal;
        Out(2) float v_Height01; // normalized height [0..1] for slope/height tinting
#endif

        // One sample of this tile in centimetres above the root's base, x and z in [-1, last + 1]. The
        // heightmap carries a one-sample ring from the four neighbouring tiles (LandscapeBorderedSamples in
        // LandscapeData.hpp), so texel (x + 1, z + 1) is sample (x, z). Indices come from the tile's own
        // cells and from LandscapeGradientLow/High, which never leave that range — no clamp to hide a
        // defect behind.
        float TileHeightCm( int x, int z )
        {
            return LandscapeHeightCmFromSample(
                 LandscapeSampleFromUnorm( texelFetch( u_Heightmap, ivec2( x + 1, z + 1 ), 0 ).r ),
                 u_T.LandscapeTile.w );
        }

        // 1 when this tile's neighbour on a side is loaded (its row is in the ring), 0 on the landscape's
        // own edge. Params2.w is LandscapeNeighbourMask: West, East, South, North in bits 0..3.
        float NeighbourPresent( int bit )
        {
            return float( ( int( u_T.Params2.w + 0.5 ) >> bit ) & 1 );
        }

        // dh/dx, dh/dz at a sample — the CPU's GradientAt (LandscapeData.cpp), the same .glslh functions on
        // the same bordered samples. Central on a seam, so both tiles give it the same bits.
        vec2 TileGradient( int x, int z )
        {
            float last    = u_T.LandscapeTile.z;
            float xa      = LandscapeGradientLow( float( x ), NeighbourPresent( 0 ) );
            float xb      = LandscapeGradientHigh( float( x ), last, NeighbourPresent( 1 ) );
            float za      = LandscapeGradientLow( float( z ), NeighbourPresent( 2 ) );
            float zb      = LandscapeGradientHigh( float( z ), last, NeighbourPresent( 3 ) );
            float spacing = u_T.LandscapeFrame.w;
            return vec2( LandscapeGradient( TileHeightCm( int( xa ), z ), TileHeightCm( int( xb ), z ), xb - xa, spacing ),
                         LandscapeGradient( TileHeightCm( x, int( za ) ), TileHeightCm( x, int( zb ) ), zb - za, spacing ) );
        }

        // Everything that decides a vertex on a shared tile edge is exact: the corner
        // indices are integers, LandscapeLerp returns its endpoints bit for bit, the tile-local index is
        // an integer difference, and the far column of one tile is evaluated at fraction 1 of its last
        // cell while the near column of the next is fraction 0 of its first — the same sample, decoded by
        // the same function. So both tiles place the vertex at the same bits, and no crack can open.
        void main()
        {
            // The patch is an axis-aligned rectangle of samples, so X comes from the u edge alone and Z
            // from the v edge alone. NOT a bilerp of all four corners: that evaluates lerp(63, 63, t) for
            // the X of a seam vertex, which is not 63 — a*(1-t) + a*t rounds — and the two tiles then
            // disagree about which cell the vertex is in (the seam suite found exactly this).
            vec2 g0 = tc_SampleXZ[0]; // (u, v) = (0, 0)
            vec2 g1 = tc_SampleXZ[1]; // (1, 0)
            vec2 g3 = tc_SampleXZ[3]; // (0, 1)
            vec2 g  = vec2( LandscapeLerp( g0.x, g1.x, gl_TessCoord.x ), LandscapeLerp( g0.y, g3.y, gl_TessCoord.y ) );

            float samples = u_T.LandscapeTile.z + 1.0;
            vec2  local   = g - u_T.LandscapeTile.xy;
            float cellX   = LandscapeCellOf( local.x, samples );
            float cellZ   = LandscapeCellOf( local.y, samples );
            float fx      = local.x - cellX;
            float fz      = local.y - cellZ;
            int   cx      = int( cellX );
            int   cz      = int( cellZ );

            float h = LandscapeBilinear( TileHeightCm( cx, cz ), TileHeightCm( cx + 1, cz ), TileHeightCm( cx, cz + 1 ),
                                         TileHeightCm( cx + 1, cz + 1 ), fx, fz );

            vec2 worldXZ = u_T.LandscapeFrame.xz + g * u_T.LandscapeFrame.w;
            vec4 worldPos = vec4( worldXZ.x, u_T.LandscapeFrame.y + h, worldXZ.y, 1.0 );
            gl_Position   = m_PushConstants.Transform * worldPos;

#ifndef TERRAIN_DEPTH_ONLY
            v_WorldPos = worldPos.xyz;
            vec2 d00 = TileGradient( cx, cz );
            vec2 d10 = TileGradient( cx + 1, cz );
            vec2 d01 = TileGradient( cx, cz + 1 );
            vec2 d11 = TileGradient( cx + 1, cz + 1 );
            float dx = LandscapeBilinear( d00.x, d10.x, d01.x, d11.x, fx, fz );
            float dz = LandscapeBilinear( d00.y, d10.y, d01.y, d11.y, fx, fz );

            v_Normal   = normalize( vec3( -dx, 1.0, -dz ) ); // the surface y = h(x, z)
            v_Height01 = clamp( h / max( u_T.Params.z, 0.0001 ) * 0.5 + 0.5, 0.0, 1.0 );
#endif
        }
