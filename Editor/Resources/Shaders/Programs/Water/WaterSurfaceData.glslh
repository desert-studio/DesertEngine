// The water surface's inputs, shared by both stages of WaterSurface.shader: one statement of the frame block and of
// the tile row, mirrored on the CPU by Graphic/Systems/Scene/Water/WaterRenderer.cpp (WaterUB, WaterTileRow).
#ifndef DESERT_WATER_SURFACE_DATA_GLSLH
#define DESERT_WATER_SURFACE_DATA_GLSLH

        // Frame data only (one GPU copy per frame): everything per tile is its WaterTiles row.
        Uniform(0) WaterUB
        {
            // The view's UNJITTERED matrices of this frame and the previous one (Graphic::ViewFrame), for velocity.
            mat4 ViewProjection;
            mat4 PrevViewProjection;
            vec4 CameraPos; // xyz = the observer the LOD rings are centred on (world, cm)
            vec4 SunDir;    // xyz = the scene directional light's travel direction
            vec4 SunColor;  // rgb = colour, a = intensity
        }
        u;

        // One drawn quadtree tile (Water::WaterTileInstance): UE's FStagingInstanceData, unpacked.
        struct WaterTileRow
        {
            vec4 Tile;  // xy = lower (X, Z) corner relative to the zone origin, z = still level Y, w = side length
            vec4 Lod;   // x = LOD level, y = 1 if it morphs, z = 1 if it can morph twice, w = height LOD factor
            vec4 Zone;  // xy = the zone's world (X, Z) origin, z = LOD scale (cm), w = quads per side
        };

        ReadBuffer(1) WaterTiles
        {
            WaterTileRow u_Tiles[];
        };

#endif // DESERT_WATER_SURFACE_DATA_GLSLH
