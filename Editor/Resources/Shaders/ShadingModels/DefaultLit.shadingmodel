// DefaultLit — UE's MSM_DefaultLit: Cook-Torrance for every analytic light (Mesh/DirectLighting.glslh, the
// kd * albedo / PI diffuse plus GGX specular) and the split-sum environment with the
// one-bounce indirect (Mesh/AmbientIBL.glslh). The model of a surface template that names none.
Guid 6570679776162095495;
Payload
{
}
Inputs
{
    BaseColor;
    Metallic;
    Roughness;
}

#include <Mesh/BRDF.glslh>
#include <Mesh/DirectLighting.glslh>
// The pure half of the ambient text. A lighting pass has already included the whole file (its samplers too);
// a G-buffer pass, which only packs the shading word, has not, and gets the half that declares no binding.
#ifndef AMBIENT_IBL_GLSLH
#define AMBIENT_IBL_NO_SAMPLERS
#include <Mesh/AmbientIBL.glslh>
#endif

vec3 DefaultLitF0( DesertSurface S )
{
    return DesertSpecularF0( S );
}

vec3 Evaluate( DesertLight L, DesertSurface S, DesertPayload P )
{
    return EvaluateDirectLight( L.L, L.Radiance, S.V, S.N, DefaultLitF0( S ), S.Metallic, S.Roughness, S.BaseColor ) *
           L.Shadow;
}

vec3 EvaluateSpecular( DesertLight L, DesertSurface S, DesertPayload P )
{
    return EvaluateDirectLightSpecular( L.L, L.Radiance, S.V, S.N, DefaultLitF0( S ), S.Roughness ) * L.Shadow;
}

vec3 EvaluateAmbient( DesertAmbient A, DesertSurface S, DesertPayload P )
{
    const vec3 F0       = DefaultLitF0( S );
    const vec3 diffuse  = EvaluateAmbientIBLDiffuse( A.Irradiance, A.SpecularBRDF, F0, S.BaseColor, S.Metallic );
    const vec3 specular = EvaluateAmbientIBLSpecular( A.Prefiltered, A.SpecularBRDF, F0 );
    // UE ReflectionEnvironment: the reflection takes GetSpecularOcclusion( NoV, Roughness^2, AO ), the diffuse AO.
    const float specularOcclusion = DesertSpecularOcclusion( max( dot( S.N, S.V ), 0.0 ), S.Roughness, A.Occlusion );
    return ComposeAmbient( diffuse, specular, S.BaseColor, A.Occlusion, specularOcclusion, A.Indirect );
}
