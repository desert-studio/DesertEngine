// DefaultLit — UE's MSM_DefaultLit, the slab with no feature (Mesh/SubstrateSlab.glslh; UE Substrate's legacy
// conversion of DefaultLit is one slab of the material's BaseColor, Metallic, Specular and Roughness): Cook-Torrance
// for every analytic light (Mesh/DirectLighting.glslh, the kd * albedo / PI diffuse plus GGX specular; a rect source
// through Mesh/RectLight.glslh) and the split-sum environment with the one-bounce indirect (Mesh/AmbientIBL.glslh).
// The model of a surface template that names none.
Guid 6570679776162095495;
Payload
{
}
Inputs
{
    BaseColor;
    Metallic;
    Roughness;
}
SlabFeatures DefaultLitSlabFeatures;

#include <Mesh/SubstrateSlab.glslh>

uint DefaultLitSlabFeatures( DesertPayload P )
{
    return 0u;
}

vec3 Evaluate( DesertLight L, DesertSurface S, DesertPayload P )
{
    return DesertSlabEvaluate( L, S, DesertMakeSlab( S, DefaultLitSlabFeatures( P ) ) );
}

vec3 EvaluateSpecular( DesertLight L, DesertSurface S, DesertPayload P )
{
    return DesertSlabEvaluateSpecular( L, S, DesertMakeSlab( S, DefaultLitSlabFeatures( P ) ) );
}

vec3 EvaluateAmbient( DesertAmbient A, DesertSurface S, DesertPayload P )
{
    return DesertSlabEvaluateAmbient( A, S, DesertMakeSlab( S, DefaultLitSlabFeatures( P ) ) );
}
