#ifndef DESERT_SHADING_MODEL_CONTRACT_GLSLH
#define DESERT_SHADING_MODEL_CONTRACT_GLSLH

// THE CONTRACT BETWEEN A SHADING MODEL AND THE PASSES THAT LIGHT IT.
//
// A shading model is a file, ShadingModels/<Name>.shadingmodel (format: Engine/Core/ShaderCompiler/ShadingModels/
// ShadingModelManifest.hpp). Its GLSL body defines exactly three functions with the signatures below; nothing else
// of a model reaches a pass. Unlit and DefaultLit are such files too — no pass and no C++ names either of them.
//
//   vec3 Evaluate( DesertLight L, DesertSurface S, DesertPayload P );
//        The light ONE source reflects toward the eye (radiance, before exposure). Called once per source: the
//        sun, every point light, every spot light. The model applies L.Shadow itself (a toon model may band it).
//
//   vec3 EvaluateSpecular( DesertLight L, DesertSurface S, DesertPayload P );
//        The share of Evaluate that is the model's specular lobe (UE FDirectLighting.Specular); Evaluate minus it
//        is the diffuse share (transmission included). MegaLights denoises the two as separate signals
//        (Programs/Shadows/MegaLightsShadeSamples.shader), so a glossy highlight is not blurred by the diffuse
//        kernel. A model with no specular lobe returns vec3( 0.0 ).
//
//   vec3 EvaluateAmbient( DesertAmbient A, DesertSurface S, DesertPayload P );
//        The environment's contribution: IBL, the indirect bounce, the ambient floor, all times A.Occlusion.
//
// Emission is NOT the model's: the pass adds SurfaceOutput.Emissive after both calls, for every model. So Unlit is
// the model whose functions all return vec3( 0.0 ) — the texel is its emission, with no special case anywhere.
//
// Who includes what. The registry (ShadingModelRegistry) generates ShadingModels.generated.glslh, which includes
// this file, then every model body, then the dispatch:
//   vec3  DesertEvaluateShadingModel( int index, DesertLight L, DesertSurface S, DesertPayload P );
//   vec3  DesertEvaluateShadingModelSpecular( int index, DesertLight L, DesertSurface S, DesertPayload P );
//   vec3  DesertEvaluateShadingModelAmbient( int index, DesertAmbient A, DesertSurface S, DesertPayload P );
//   uvec2 DesertPackShadingWord( int index, float sampledTextureCount, DesertPayload P );
//   int   DesertShadingModelIndex( uvec2 shadingWord );
//   float DesertSampledTextureCount( uvec2 shadingWord );
//   DesertPayload DesertUnpackPayload( uvec2 shadingWord );
//   DesertPayload DesertQuantizePayload( DesertPayload P );
//   #define SHADING_MODEL_INDEX_<NAME> <index>   (one per model; SHADING_MODEL_INDEX_UNLIT is 0)
// The deferred composite (Programs/Deferred/DeferredLighting.shader) AND the forward passes
// (Mesh/Surface/Pass_Forward*.glslh) include the generated file and call the SAME two dispatchers — one formula
// for opaque and translucent. The forward pass quantizes its payload with DesertQuantizePayload before the call,
// so a translucent surface sees the same 8-bit payload an opaque one reads back from the G-buffer.
//
// Before a pass includes the generated file it provides the two environment lookups a model may call for
// directions other than the precomputed ones in DesertAmbient (both passes already bind the cubes:
// DeferredLighting.shader and Pass_Forward.glslh:44-45, through Common/SkyLook.glslh's rotation and gain):
//   vec3 DesertAmbientIrradiance( vec3 worldDirection );
//   vec3 DesertAmbientSpecular( vec3 worldDirection, float roughness );

// Declared here as well, so a model body that calls them compiles in every pass that includes the generated file:
// a G-buffer pass binds no cube and never calls the dispatch, so the call is unreachable there and glslang's
// linker asks no body for it; a lighting pass defines both (Mesh/AmbientIBL.glslh).
vec3 DesertAmbientIrradiance( vec3 worldDirection );
vec3 DesertAmbientSpecular( vec3 worldDirection, float roughness );

// ----------------------------------------------------------------------------------------------------------------
// The payload: at most four floats per model (UE's CustomData.rgba), carried by the G-buffer's shading word.
//
// The G-buffer (Mesh/Surface/Pass_GBuffer.glslh, read at Programs/Deferred/DeferredLighting.shader):
//   GBufferA           RGBA8    BaseColor.rgb, Metallic.a                       — full
//   GBufferB           RGBA16F  world Normal.rgb, Roughness.a                   — full
//   GBufferShadingWord RG32_UINT the shading word below
//   GBufferEmissive    RGBA16F  Emissive.rgb, AmbientOcclusion.a                — full
// World position is not stored: every reader reconstructs it from the scene depth (Common/ReconstructPosition.glslh).
// The word is a pair of 32-bit unsigned integers (uvec2), written and read with integer operations only (an
// integer target is never filtered: readers texelFetch it). Its bit fields, numbered across the pair (0..31 = .x,
// 32..63 = .y; no field straddles the two), like UE's GBufferB.a (ShadingModelID | SelectiveOutputMask << 4)
// with the payload in the place of UE's CustomData GBufferD (RGBA8 — the same four floats, the same 8-bit
// precision each):
//   bits  0.. 3  shading-model index (0..15; 0 = Unlit)
//   bits  4.. 7  sampled-texture count (the Material Complexity proxy, clamped to 15)
//   bits  8..15  payload 0, unorm8
//   bits 16..23  payload 1, unorm8
//   bit  24      NO_SUN_SHADOWS: set = the sun's cascaded shadows do not darken this surface
//                (SurfaceOutput.ReceiveSunShadows < 0.5, the material half of UE's receive-CSM-shadows flag)
//   bit  25      NO_CONTACT_SHADOW: set = the primitive does not cast contact shadows (UE !bCastContactShadow,
//                the G-buffer's PerObjectGBufferData bit): a light's contact-shadow ray that hits this texel
//                darkens with the light's Non Casting Intensity instead of its Casting Intensity
//                (Common/ContactShadow.glslh)
//   bits 26..31  free
//   bits 32..39  payload 2, unorm8   (.y bits 0..7)
//   bits 40..47  payload 3, unorm8   (.y bits 8..15)
//   bits 48..55  SUN_SELF_SHADOW, unorm8 of (1 - SurfaceOutput.SunSelfShadow): the relief's own shadow from the main
//                directional light (parallax occlusion, Mesh/Surface/SurfaceParallax.glslh); 0, the clear value, lit
//   bits 56..63  free
// The target clears to 0: an untouched texel reads Unlit, no payload, receives sun shadows.
// ShadingModelManifest.hpp (kShadingWordFields) is the C++ half of this table; the ShadingModelContract suite
// holds the two equal and the fields disjoint.
#define DESERT_SHADING_WORD_INDEX_FIRST_BIT    0
#define DESERT_SHADING_WORD_INDEX_BITS         4
#define DESERT_SHADING_WORD_TEXTURES_FIRST_BIT 4
#define DESERT_SHADING_WORD_TEXTURES_BITS      4
#define DESERT_SHADING_WORD_PAYLOAD0_FIRST_BIT 8
#define DESERT_SHADING_WORD_PAYLOAD1_FIRST_BIT 16
#define DESERT_SHADING_WORD_PAYLOAD2_FIRST_BIT 32
#define DESERT_SHADING_WORD_PAYLOAD3_FIRST_BIT 40
#define DESERT_SHADING_WORD_PAYLOAD_BITS       8
#define DESERT_SHADING_WORD_NO_SUN_SHADOWS_BIT 24
#define DESERT_SHADING_WORD_NO_CONTACT_SHADOW_BIT 25
#define DESERT_SHADING_WORD_SUN_SELF_SHADOW_FIRST_BIT 48
#define DESERT_SHADING_WORD_SUN_SELF_SHADOW_BITS      8

// The G-buffer writer marks the flag after DesertPackShadingWord, so the deferred composite applies the toggle
// exactly as the forward pass does, and a writer that forgets the mark gets the default, receives.
uvec2 DesertMarkSunShadowReceive( uvec2 shadingWord, float receiveSunShadows )
{
    const uint noReceive = receiveSunShadows < 0.5 ? 1u : 0u;
    return uvec2( shadingWord.x | ( noReceive << uint( DESERT_SHADING_WORD_NO_SUN_SHADOWS_BIT ) ), shadingWord.y );
}

// The relief's self-shadow, stored inverted so a cleared texel and a writer that forgets the mark read "lit".
uvec2 DesertMarkSunSelfShadow( uvec2 shadingWord, float sunSelfShadow )
{
    const uint occlusion = uint( round( clamp( 1.0 - sunSelfShadow, 0.0, 1.0 ) * 255.0 ) );
    return uvec2( shadingWord.x,
                  shadingWord.y | ( occlusion << uint( DESERT_SHADING_WORD_SUN_SELF_SHADOW_FIRST_BIT - 32 ) ) );
}

float DesertSunSelfShadow( uvec2 shadingWord )
{
    const uint occlusion = ( shadingWord.y >> uint( DESERT_SHADING_WORD_SUN_SELF_SHADOW_FIRST_BIT - 32 ) ) & 0xFFu;
    return 1.0 - float( occlusion ) / 255.0;
}

bool DesertReceivesSunShadows( uvec2 shadingWord )
{
    return ( ( shadingWord.x >> uint( DESERT_SHADING_WORD_NO_SUN_SHADOWS_BIT ) ) & 1u ) == 0u;
}

// The primitive's contact-shadow cast flag, from the draw (UE bCastContactShadow, the push PrimitiveFlags): marked
// like the sun-shadow receive, so a cleared texel and a writer that forgets the mark both read "casts".
uvec2 DesertMarkContactShadowCast( uvec2 shadingWord, bool castContactShadow )
{
    const uint noCast = castContactShadow ? 0u : 1u;
    return uvec2( shadingWord.x | ( noCast << uint( DESERT_SHADING_WORD_NO_CONTACT_SHADOW_BIT ) ), shadingWord.y );
}

// UE CastContactShadow( GBuffer ): whether a contact-shadow ray that hit this texel is stopped by a caster.
bool DesertCastsContactShadow( uvec2 shadingWord )
{
    return ( ( shadingWord.x >> uint( DESERT_SHADING_WORD_NO_CONTACT_SHADOW_BIT ) ) & 1u ) == 0u;
}

// A model's four payload floats, in [0, 1] (the pass clamps; 1/255 resolution). The manifest's `Payload` block
// names them for the material author; the body reads them as CustomData0..3 (UE's GBufferD CustomData.rgba),
// which are the SurfaceOutput fields the material writes. A model with no payload never reads P.
struct DesertPayload
{
    float CustomData0;
    float CustomData1;
    float CustomData2;
    float CustomData3;
};

// ----------------------------------------------------------------------------------------------------------------
// The surface at the shaded point: what DefaultLit reads today in both paths (DeferredLighting.shader:220-224, 286-288;
// Pass_Forward.glslh:96-106), in the form both can supply. The deferred path has only what the G-buffer carries,
// so a field enters this struct only together with its G-buffer channel.
struct DesertSurface
{
    vec3  WorldPosition;
    vec3  N;         // unit world-space shading normal
    vec3  V;         // unit vector from the surface toward the eye
    vec3  BaseColor; // linear
    float Metallic;
    float Roughness; // already clamped to >= 0.04 by the pass (the GGX NDF divides by it)
};

// THE ONE PLACE a DesertSurface is made: both passes (Pass_Forward.glslh, DeferredLighting.shader) build it here
// and nowhere else, so every model receives a unit N and V and a clamped roughness and none re-normalizes. An
// interpolated or G-buffer-decoded normal is not unit length; a model quantizing N.L (Toon's bands) turns that
// per-triangle shortfall into band edges that follow the polygons.
DesertSurface DesertMakeSurface( vec3 worldPosition, vec3 normal, vec3 toEye, vec3 baseColor, float metallic,
                                 float roughness )
{
    DesertSurface S;
    S.WorldPosition = worldPosition;
    S.N             = normalize( normal );
    S.V             = normalize( toEye );
    S.BaseColor     = baseColor;
    S.Metallic      = metallic;
    S.Roughness     = max( roughness, 0.04 ); // GGX NDF stays finite for mirror-smooth surfaces
    return S;
}

// One light source as it arrives at the surface (DirectLighting.glslh:36-47 is the same split: everything specific
// to the source is above the call, the BRDF below it).
struct DesertLight
{
    vec3  L;        // unit vector from the surface toward the light
    vec3  Radiance; // colour * intensity * distance falloff * cone — the source's own model, already applied
    float Shadow;   // 1 = unoccluded. The sun: cascades (unless ReceiveSunShadows < 0.5) times the cloud layer
                    // (DeferredLighting.shader:300, Pass_Forward.glslh:120-125); point and spot lights: 1.
};

// The environment at the surface, sampled once by the pass for the model's normal and roughness (the split-sum
// inputs of Mesh/AmbientIBL.glslh:30-38, 79-97).
struct DesertAmbient
{
    vec3  Irradiance;   // diffuse irradiance cube at S.N (sky look applied)
    vec3  Prefiltered;  // GGX-prefiltered cube at reflect(-S.V, S.N), mip by S.Roughness (sky look applied)
    vec2  SpecularBRDF; // split-sum LUT .rg at (max(dot(S.N, S.V), 0), S.Roughness)
    vec3  Indirect;     // one-bounce INCIDENT light (the deferred GI gather); vec3( 0.0 ) in the forward passes
    float Occlusion;    // the material's AmbientOcclusion times SSAO where the pass has it (DeferredLighting.shader:250)
};

#endif
