#ifndef DESERT_SHADING_MODEL_CONTRACT_GLSLH
#define DESERT_SHADING_MODEL_CONTRACT_GLSLH

// THE CONTRACT BETWEEN A SHADING MODEL AND THE PASSES THAT LIGHT IT.
//
// A shading model is a file, ShadingModels/<Name>.shadingmodel (format: Engine/Core/ShaderCompiler/ShadingModels/
// ShadingModelManifest.hpp). Its GLSL body defines exactly three functions with the signatures below; nothing else
// of a model reaches a pass. Unlit and DefaultLit are such files too — no pass and no C++ names either of them.
//
//   vec3 Evaluate( DesertLight L, DesertSurface S, DesertPayload P );
//        The light ONE source reflects toward the eye (radiance, before exposure). Called once per source: the
//        sun, every point light, every spot light. The model applies L.Shadow itself (a toon model may band it).
//
//   vec3 EvaluateSpecular( DesertLight L, DesertSurface S, DesertPayload P );
//        The share of Evaluate that is the model's specular lobe (UE FDirectLighting.Specular); Evaluate minus it
//        is the diffuse share (transmission included). MegaLights denoises the two as separate signals
//        (Programs/Shadows/MegaLightsShadeSamples.shader), so a glossy highlight is not blurred by the diffuse
//        kernel. A model with no specular lobe returns vec3( 0.0 ).
//
//   vec3 EvaluateAmbient( DesertAmbient A, DesertSurface S, DesertPayload P );
//        The environment's contribution: IBL and the indirect bounce, both times A.Occlusion.
//
// THE SLAB (Mesh/SubstrateSlab.glslh, UE Substrate): a lit model carries no BRDF of its own. It builds a DesertSlab
// from S and P and forwards to DesertSlabEvaluate / DesertSlabEvaluateSpecular / DesertSlabEvaluateAmbient; its
// own text is only what is not a slab lobe (TwoSidedFoliage's transmission). A model whose response IS the slab
// declares `SlabFeatures <function>;` (uint <function>( DesertPayload P ), the features its slab is built with):
// such a preset promises that with no feature bit set it shades exactly as DefaultLit. It also declares
// `Slab <function>;` (DesertSlab <function>( DesertSurface S, DesertPayload P ), the slab its three functions
// evaluate): DesertShadingModelSlab dispatches it, so a pass that needs the slab's parameters rather than its response
// (the path tracer's lobe sampler, Programs/PathTracing/PathTracer.shader) reads the very slab the raster shades.
//
// Emission is NOT the model's: the pass adds SurfaceOutput.Emissive after both calls, for every model. So Unlit is
// the model whose functions all return vec3( 0.0 ) — the texel is its emission, with no special case anywhere.
//
// Who includes what. The registry (ShadingModelRegistry) generates the VIRTUAL Generated/ShadingModels.glslh (no file:
// the includer answers it with GenerateGlsl()'s text, ShadingModelManifest.hpp kGeneratedInclude), which includes
// this file, then every model body, then the dispatch:
//   vec3  DesertEvaluateShadingModel( int index, DesertLight L, DesertSurface S, DesertPayload P );
//   vec3  DesertEvaluateShadingModelSpecular( int index, DesertLight L, DesertSurface S, DesertPayload P );
//   vec3  DesertEvaluateShadingModelAmbient( int index, DesertAmbient A, DesertSurface S, DesertPayload P );
//   uvec2 DesertPackShadingWord( int index, float sampledTextureCount, float specular, DesertPayload P );
//   float DesertShadingWordSpecular( uvec2 shadingWord );
//   int   DesertShadingModelIndex( uvec2 shadingWord );
//   float DesertSampledTextureCount( uvec2 shadingWord );
//   DesertPayload DesertUnpackPayload( uvec2 shadingWord );
//   DesertPayload DesertQuantizePayload( DesertPayload P );
//   #define SHADING_MODEL_INDEX_<NAME> <index>   (one per model; SHADING_MODEL_INDEX_UNLIT is 0)
// The deferred composite (Programs/Deferred/DeferredLighting.shader) AND the forward passes
// (Mesh/Surface/Pass_Forward*.glslh) include the generated file and call the SAME two dispatchers — one formula
// for opaque and translucent. The forward pass quantizes its payload with DesertQuantizePayload before the call,
// so a translucent surface sees the same 8-bit payload an opaque one reads back from the G-buffer.
//
// Before a pass includes the generated file it provides the two environment lookups a model may call for
// directions other than the precomputed ones in DesertAmbient (both passes already bind the cubes:
// DeferredLighting.shader and Pass_Forward.glslh:44-45, through Common/SkyLook.glslh's rotation and gain):
//   vec3 DesertAmbientIrradiance( vec3 worldDirection );
//   vec3 DesertAmbientSpecular( vec3 worldDirection, float roughness );

// Declared here as well, so a model body that calls them compiles in every pass that includes the generated file:
// a G-buffer pass binds no cube and never calls the dispatch, so the call is unreachable there and glslang's
// linker asks no body for it; a lighting pass defines both (Mesh/AmbientIBL.glslh).
vec3 DesertAmbientIrradiance( vec3 worldDirection );
vec3 DesertAmbientSpecular( vec3 worldDirection, float roughness );

// ----------------------------------------------------------------------------------------------------------------
// The payload: at most four floats per model (UE's CustomData.rgba), carried by the G-buffer's shading word.
//
// The G-buffer (Mesh/Surface/Pass_GBuffer.glslh, read at Programs/Deferred/DeferredLighting.shader):
//   GBufferA           RGBA8    BaseColor.rgb, Metallic.a                       — full
//   GBufferB           RGBA16F  world Normal.rgb, Roughness.a                   — full
//   GBufferShadingWord RG32_UINT the shading word below
//   GBufferEmissive    RGBA16F  Emissive.rgb, occlusion and caster sign in .a (Common/GBufferOcclusion.glslh)
// World position is not stored: every reader reconstructs it from the scene depth (Common/ReconstructPosition.glslh).
// The word is a pair of 32-bit unsigned integers (uvec2), written and read with integer operations only (an
// integer target is never filtered: readers texelFetch it). Its bit fields, numbered across the pair (0..31 = .x,
// 32..63 = .y; no field straddles the two), like UE's GBufferB.a (ShadingModelID | SelectiveOutputMask << 4)
// with the payload in the place of UE's CustomData GBufferD (RGBA8 — the same four floats, the same 8-bit
// precision each):
//   bits  0.. 3  shading-model index (0..15; 0 = Unlit)
//   bits  4.. 6  sampled-texture count (the Material Complexity proxy, clamped to 7; the view saturates at 3)
//   bit   7      EMISSION_IS_LIGHT: set = the texel's emission is a MegaLights light source (a material with
//                Emissive Lights Scene on, the draw's DESERT_PRIMITIVE_FLAG_EMISSION_IS_LIGHT): MegaLights lights the
//                scene from it directly, so a GI ray that hits the texel on screen takes no emission from it
//                (Common/GIHitLighting.glslh GIHitMaterial; UE MegaLights + Lumen: an emissive light source is not
//                counted again by the screen traces). The deferred composite still shows the emission itself.
//                DesertPackShadingWord never sets it
//   bits  8..15  payload 0, unorm8
//   bits 16..23  payload 1, unorm8
//   bit  24      NO_SUN_SHADOWS: set = the sun's cascaded shadows do not darken this surface
//                (SurfaceOutput.ReceiveSunShadows < 0.5, the material half of UE's receive-CSM-shadows flag)
//   bit  25      NO_CONTACT_SHADOW: set = the primitive does not cast contact shadows (UE !bCastContactShadow,
//                the G-buffer's PerObjectGBufferData bit): a light's contact-shadow ray that hits this texel
//                darkens with the light's Non Casting Intensity instead of its Casting Intensity
//                (Common/ContactShadow.glslh)
//   bit  26      LANDSCAPE: set = the pixel is the landscape's own surface (Programs/Terrain/TerrainGBuffer.shader),
//                not grass, foliage or a mesh standing on it - the ground mask a reader of the ground needs where the
//                depth buffer holds whatever stands in front (the Deformation Field view; later the field's
//                receivers). DEPTH32F has no stencil (UE keeps this in the stencil); DesertPackShadingWord never sets it
//   bits 27..31  SLAB_FEATURES: the texel's slab features (Mesh/SubstrateSlab.glslh kDesertSlab*: HAZE, CLEAR_COAT,
//                FUZZ, F90, ANISOTROPY), written by DesertPackShadingWord from the model's `SlabFeatures` manifest line; 0 for a
//                model that is no slab preset. "Deferred: Tile Classify" reads them: a slab preset's texel with no
//                feature is DefaultLit exactly and is shaded by the SIMPLE tiles (UE Substrate's tile classification)
//   bits 32..39  payload 2, unorm8   (.y bits 0..7)
//   bits 40..47  payload 3, unorm8   (.y bits 8..15)
//   bits 48..55  Specular, unorm8 (UE's Specular pin, GBuffer Specular): the dielectric F0 = 0.08 x Specular
//                (DesertSpecularF0); 0.5, UE's default, is the 4 % of a common dielectric
//   bits 56..63  SUN_SELF_SHADOW, unorm8 of (1 - SurfaceOutput.SunSelfShadow): the relief's own shadow from the main
//                directional light (parallax occlusion, Mesh/Surface/SurfaceParallax.glslh); 0, the clear value, lit
// The target clears to 0: an untouched texel reads Unlit, no payload, receives sun shadows.
// ShadingModelManifest.hpp (kShadingWordFields) is the C++ half of this table; the ShadingModelContract suite
// holds the two equal and the fields disjoint.
#define DESERT_SHADING_WORD_INDEX_FIRST_BIT    0
#define DESERT_SHADING_WORD_INDEX_BITS         4
#define DESERT_SHADING_WORD_TEXTURES_FIRST_BIT 4
#define DESERT_SHADING_WORD_TEXTURES_BITS      3
#define DESERT_SHADING_WORD_EMISSION_IS_LIGHT_BIT 7
#define DESERT_SHADING_WORD_PAYLOAD0_FIRST_BIT 8
#define DESERT_SHADING_WORD_PAYLOAD1_FIRST_BIT 16
#define DESERT_SHADING_WORD_PAYLOAD2_FIRST_BIT 32
#define DESERT_SHADING_WORD_PAYLOAD3_FIRST_BIT 40
#define DESERT_SHADING_WORD_PAYLOAD_BITS       8
#define DESERT_SHADING_WORD_NO_SUN_SHADOWS_BIT 24
#define DESERT_SHADING_WORD_NO_CONTACT_SHADOW_BIT 25
#define DESERT_SHADING_WORD_LANDSCAPE_BIT      26
#define DESERT_SHADING_WORD_SLAB_FEATURES_FIRST_BIT 27
#define DESERT_SHADING_WORD_SLAB_FEATURES_BITS      5
#define DESERT_SHADING_WORD_SPECULAR_FIRST_BIT 48
#define DESERT_SHADING_WORD_SPECULAR_BITS      8
#define DESERT_SHADING_WORD_SUN_SELF_SHADOW_FIRST_BIT 56
#define DESERT_SHADING_WORD_SUN_SELF_SHADOW_BITS      8

// The G-buffer writer marks the flag after DesertPackShadingWord, so the deferred composite applies the toggle
// exactly as the forward pass does, and a writer that forgets the mark gets the default, receives.
uvec2 DesertMarkSunShadowReceive( uvec2 shadingWord, float receiveSunShadows )
{
    const uint noReceive = receiveSunShadows < 0.5 ? 1u : 0u;
    return uvec2( shadingWord.x | ( noReceive << uint( DESERT_SHADING_WORD_NO_SUN_SHADOWS_BIT ) ), shadingWord.y );
}

// The relief's self-shadow, stored inverted so a cleared texel and a writer that forgets the mark read "lit".
uvec2 DesertMarkSunSelfShadow( uvec2 shadingWord, float sunSelfShadow )
{
    const uint occlusion = uint( round( clamp( 1.0 - sunSelfShadow, 0.0, 1.0 ) * 255.0 ) );
    return uvec2( shadingWord.x,
                  shadingWord.y | ( occlusion << uint( DESERT_SHADING_WORD_SUN_SELF_SHADOW_FIRST_BIT - 32 ) ) );
}

float DesertSunSelfShadow( uvec2 shadingWord )
{
    const uint occlusion = ( shadingWord.y >> uint( DESERT_SHADING_WORD_SUN_SELF_SHADOW_FIRST_BIT - 32 ) ) & 0xFFu;
    return 1.0 - float( occlusion ) / 255.0;
}

bool DesertReceivesSunShadows( uvec2 shadingWord )
{
    return ( ( shadingWord.x >> uint( DESERT_SHADING_WORD_NO_SUN_SHADOWS_BIT ) ) & 1u ) == 0u;
}

// The primitive's contact-shadow cast flag, from the draw (UE bCastContactShadow, the push PrimitiveFlags): marked
// like the sun-shadow receive, so a cleared texel and a writer that forgets the mark both read "casts".
uvec2 DesertMarkContactShadowCast( uvec2 shadingWord, bool castContactShadow )
{
    const uint noCast = castContactShadow ? 0u : 1u;
    return uvec2( shadingWord.x | ( noCast << uint( DESERT_SHADING_WORD_NO_CONTACT_SHADOW_BIT ) ), shadingWord.y );
}

// UE CastContactShadow( GBuffer ): whether a contact-shadow ray that hit this texel is stopped by a caster.
bool DesertCastsContactShadow( uvec2 shadingWord )
{
    return ( ( shadingWord.x >> uint( DESERT_SHADING_WORD_NO_CONTACT_SHADOW_BIT ) ) & 1u ) == 0u;
}

// The landscape mark: only the terrain's G-buffer pass calls it, after DesertPackShadingWord (which leaves the bit
// clear), so a cleared texel and every other writer read "not ground".
uvec2 DesertMarkLandscape( uvec2 shadingWord )
{
    return uvec2( shadingWord.x | ( 1u << uint( DESERT_SHADING_WORD_LANDSCAPE_BIT ) ), shadingWord.y );
}

bool DesertIsLandscape( uvec2 shadingWord )
{
    return ( ( shadingWord.x >> uint( DESERT_SHADING_WORD_LANDSCAPE_BIT ) ) & 1u ) != 0u;
}

// The emission-is-a-light mark: the G-buffer writer calls it after DesertPackShadingWord (which leaves the bit
// clear) with the draw's flag, so a cleared texel and a writer that forgets the mark read "ordinary emission",
// which GI counts.
uvec2 DesertMarkEmissionIsLight( uvec2 shadingWord, bool emissionIsLight )
{
    const uint mark = emissionIsLight ? 1u : 0u;
    return uvec2( shadingWord.x | ( mark << uint( DESERT_SHADING_WORD_EMISSION_IS_LIGHT_BIT ) ), shadingWord.y );
}

bool DesertEmissionIsLight( uvec2 shadingWord )
{
    return ( ( shadingWord.x >> uint( DESERT_SHADING_WORD_EMISSION_IS_LIGHT_BIT ) ) & 1u ) != 0u;
}

// The texel's slab features (Mesh/SubstrateSlab.glslh kDesertSlab*), 0 where the model is no slab preset.
uint DesertShadingWordSlabFeatures( uvec2 shadingWord )
{
    return ( shadingWord.x >> uint( DESERT_SHADING_WORD_SLAB_FEATURES_FIRST_BIT ) ) &
           ( ( 1u << uint( DESERT_SHADING_WORD_SLAB_FEATURES_BITS ) ) - 1u );
}

// A model's four payload floats, in [0, 1] (the pass clamps; 1/255 resolution). The manifest's `Payload` block
// names them for the material author; the body reads them as CustomData0..3 (UE's GBufferD CustomData.rgba),
// which are the SurfaceOutput fields the material writes. A model with no payload never reads P.
struct DesertPayload
{
    float CustomData0;
    float CustomData1;
    float CustomData2;
    float CustomData3;
};

// THE ROUGHNESS FLOOR of every GGX lobe the engine evaluates, raster and ray-traced alike (UE: one minimum roughness
// in the shading model's common header that the base pass, deferred lighting and every ray-tracing path read).
// Below it the GGX NDF divides by ~0 and the lobe is a delta no sampler or light evaluation can integrate. The
// writers floor by it: the G-buffer and front-layer passes (Mesh/Surface/Pass_GBuffer.glslh, Pass_FrontLayer.glslh)
// and the depth-normal pass (Mesh/Generic/DepthNormal.glslh) store it in the normal slot's alpha, the surface hit
// group in the ray payload (Mesh/Surface/Pass_RayHit.glslh). The readers floor by the SAME value where their input
// may not be floored: DesertMakeSurface below, the deferred composite and its bounce (Programs/Deferred/
// DeferredLighting.shader), MegaLights (Common/MegaLights.glslh), the path tracer (Programs/PathTracing/
// PathTracer.shader PathTracingMaterialOf) and GI hit lighting (Common/GIHitLighting.glslh GIHitLightResponse) - the
// landscape hit group (Programs/Terrain/TerrainRayHit.shader) writes its blended ARM roughness unfloored.
const float kDesertMinRoughness = 0.04;

// ----------------------------------------------------------------------------------------------------------------
// The surface at the shaded point: what DefaultLit reads today in both paths (DeferredLighting.shader:220-224, 286-288;
// Pass_Forward.glslh:96-106), in the form both can supply. The deferred path has only what the G-buffer carries,
// so a field enters this struct only together with its G-buffer channel.
struct DesertSurface
{
    vec3  WorldPosition;
    vec3  N;         // unit world-space shading normal
    vec3  V;         // unit vector from the surface toward the eye
    vec3  BaseColor; // linear
    float Metallic;
    float Roughness; // already clamped to >= kDesertMinRoughness by the pass (the GGX NDF divides by it)
    float Specular;  // UE's Specular pin: the dielectric reflectance, F0 = 0.08 x Specular (DesertSpecularF0)
};

// THE ONE PLACE a DesertSurface is made: both passes (Pass_Forward.glslh, DeferredLighting.shader) build it here
// and nowhere else, so every model receives a unit N and V and a clamped roughness and none re-normalizes. An
// interpolated or G-buffer-decoded normal is not unit length; a model quantizing N.L (Toon's bands) turns that
// per-triangle shortfall into band edges that follow the polygons.
DesertSurface DesertMakeSurface( vec3 worldPosition, vec3 normal, vec3 toEye, vec3 baseColor, float metallic,
                                 float roughness, float specular )
{
    DesertSurface S;
    S.WorldPosition = worldPosition;
    S.N             = normalize( normal );
    S.V             = normalize( toEye );
    S.BaseColor     = baseColor;
    S.Metallic      = metallic;
    S.Roughness     = max( roughness, kDesertMinRoughness ); // GGX NDF stays finite for mirror-smooth surfaces
    S.Specular      = specular;
    return S;
}

// UE ComputeF0 (ShadingCommon.ush): the reflectance at normal incidence, the dielectric's 0.08 x Specular blended
// into the base colour by Metallic. Every model's F0, so the material's Specular reaches every lobe it lights.
vec3 DesertSpecularF0( DesertSurface S )
{
    return mix( vec3( 0.08 * S.Specular ), S.BaseColor, S.Metallic );
}

// One light source as it arrives at the surface (DirectLighting.glslh:36-47 is the same split: everything specific
// to the source is above the call, the BRDF below it).
struct DesertLight
{
    vec3  L;        // unit vector from the surface toward the light
    vec3  Radiance; // colour * intensity * distance falloff * cone — the source's own model, already applied
    float Shadow;   // 1 = unoccluded. The sun: cascades (unless ReceiveSunShadows < 0.5) times the cloud layer
                    // (DeferredLighting.shader:300, Pass_Forward.glslh:120-125); point and spot lights: 1.
    // UE FShadowTerms::TransmissionShadow: the share of the light that reaches a subsurface receiver THROUGH what
    // stands between it and the light — exp( -thickness * density ), the occluder's thickness read from the same
    // shadow map with no receiver offset (Mesh/CascadedShadow.glslh TransmissionShadowFactor,
    // Mesh/LocalLightShadow.glslh), times the contact shadow and the cloud layer as Shadow is. A model's
    // transmitted light takes this, its surface light takes Shadow (UE TwoSidedBxDF via LightAccumulator_AddSplit):
    // Shadow's normal offset moves a leaf's far side AWAY from the light, behind the leaf itself, so Shadow is 0
    // exactly where the light shines through. 1 for a receiver that is not a subsurface model (no model reads it).
    float TransmissionShadow;
    // A RECT source (RectLightComponent; UE FAreaLight's rect, Mesh/LightSources.glslh DesertRectLightAt): the
    // emitting part the barn doors leave visible, relative to the surface - its centre and its two half-extents
    // (world, cm). Then L and Radiance are the rect's vector irradiance (UE RectIrradianceLambert): any model
    // that knows nothing of rects lights it exactly in the Lambert sense, and a model with a specular lobe aims
    // that lobe at the rect itself (Mesh/RectLight.glslh). Zero extents = a punctual source (sun, point, spot).
    vec3 RectCenter;
    vec3 RectExtentX;
    vec3 RectExtentY;
    // A rect's emitted radiance at the surface (colour * luminance * range window * IES): what its specular lobe
    // integrates over the rect, as Radiance is that times the rect's solid angle. And the bindless slot of the
    // GGX LTC tables that lobe is integrated with (Runtime::RectLightLtcService; 0 = none). Zero for a punctual.
    vec3 RectLuminance;
    int  RectLtcTexture;
    // A SPHERE source (UE ULocalLightComponent::SourceRadius; the sun's disc, UE LightSourceAngle): the vector from
    // the surface to the emitter's centre (world, cm; the sun: L itself, at unit distance) and the emitter's radius
    // (cm; the sun: the sine of its angular radius). L and Radiance stay the centre's - the diffuse and every
    // non-specular term read the sphere as the point it is far away - while a model's specular lobe aims at the
    // sphere's point nearest the reflection ray, energy-normalised for the lobe the sphere widens
    // (DesertSphereSpecularLight). Zero radius = a punctual source; zero for a rect (its lobe is the LTC's).
    vec3  SphereCenter;
    float SphereRadius;
    // A CAPSULE ("tube") source (UE ULocalLightComponent::SourceLength): half the emitter's segment (world, cm),
    // centred on SphereCenter - the capsule is SphereRadius around [SphereCenter - SphereAxis, SphereCenter +
    // SphereAxis]. L and Radiance are then the segment's (UE LineIrradiance: L the mean of the two ends' directions,
    // Radiance their irradiance), and the specular lobe aims at the segment's point nearest the reflection ray
    // (DesertSphereSpecularLight). Zero = a sphere (or a point).
    vec3  SphereAxis;
};

// Whether the light is a rect source (DesertLight::RectCenter).
bool DesertIsRectLight( DesertLight light )
{
    return dot( light.RectExtentX, light.RectExtentX ) > 0.0;
}

// Whether the light's specular lobe sees an emitter with a size - a sphere, the sun's disc or a capsule - rather than
// the point L names (DesertSphereSpecularLight). A rect's size is its LTC's, not this.
bool DesertIsAreaSpecularLight( DesertLight light )
{
    return light.SphereRadius > 0.0 || dot( light.SphereAxis, light.SphereAxis ) > 0.0;
}

// UE New_a2 (BRDF.ush): the GGX alpha^2 of a lobe of alpha^2 @p a2 widened by a source that subtends @p sinAlpha,
// at the half-vector cosine @p VoH.
float DesertAreaLightWidenedA2( float a2, float sinAlpha, float VoH )
{
    const float a = a2 * inversesqrt( max( a2, 1e-12 ) ); // sqrt( a2 ): the file also compiles as C++
    return a2 + 0.25 * sinAlpha * ( 3.0 * a + sinAlpha ) / ( VoH + 0.001 );
}

// THE SPHERE, THE SUN'S DISC AND THE CAPSULE AS A SPECULAR SOURCE - UE5's area light specular (DeferredLighting
// Common.ush IntegrateBxDF( FCapsuleLight ), BRDF.ush SphereMaxNoH / EnergyNormalization / ClosestPointLineToRay):
//   - a CAPSULE first moves the centre to the point of its segment nearest the reflection ray R
//     (ClosestPointLineToRay);
//   - the SPHERE about that point, of sine-angle sinAlpha = radius / distance * ( 1 - alpha ), is seen by the lobe
//     at the direction of the sphere's cone nearest R - R itself when R falls inside the cone - which is the
//     maximum-NoH direction of SphereMaxNoH (its first-order form, without UE's Newton step);
//   - the lobe widened by the sphere and by the segment's subtended angle is energy-normalised: Energy =
//     a2 / a2' (sphere) * sqrt( a2' / a2'' ) (line), UE EnergyNormalization - a large bulb or a long tube over a
//     glossy floor is a soft disc / a stretched highlight as bright in total as the point it replaces;
//   - the cosine the light arrives at stays the source's own (L, a capsule's mean of its ends), the sphere wrapped
//     over the horizon (UE SphereHorizonCosWrap), so the lobe's direction moves but its irradiance does not.
// Every model's specular lobe takes the light through here; its diffuse keeps L. A punctual or rect source is
// returned as it came.
DesertLight DesertSphereSpecularLight( DesertLight light, vec3 N, vec3 V, float roughness )
{
    if ( !DesertIsAreaSpecularLight( light ) || DesertIsRectLight( light ) )
        return light;
    // R = reflect( -V, N ), spelled out (the file also compiles as C++).
    const vec3 R = N * ( 2.0 * dot( N, V ) ) - V;

    // The capsule's segment: its point nearest R, and the angle it subtends (UE LineIrradiance CosSubtended).
    vec3  toLight          = light.SphereCenter;
    float lineCosSubtended = 1.0;
    const float axisLength2 = dot( light.SphereAxis, light.SphereAxis );
    if ( axisLength2 > 0.0 )
    {
        const vec3  end0   = light.SphereCenter - light.SphereAxis;
        const vec3  end1   = light.SphereCenter + light.SphereAxis;
        const vec3  line01 = light.SphereAxis * 2.0;
        const float A      = 4.0 * axisLength2;
        const float B      = dot( R, line01 );
        const float t      = clamp( dot( end0, R * B - line01 ) / max( A - B * B, 1e-6 ), 0.0, 1.0 );
        toLight            = end0 + line01 * t;
        lineCosSubtended   = clamp( dot( end0, end1 ) * inversesqrt( max( dot( end0, end0 ) * dot( end1, end1 ), 1e-12 ) ),
                                    -1.0, 1.0 );
    }

    // UE View.MinRoughness keeps the energy ratio finite on a mirror.
    const float alpha       = max( roughness * roughness, 0.0004 );
    const float a2          = alpha * alpha;
    const float distance2   = max( dot( toLight, toLight ), 1e-8 );
    const float invDistance = inversesqrt( distance2 );
    const vec3  centre      = toLight * invDistance;
    const float sinAlpha    = clamp( light.SphereRadius * invDistance * ( 1.0 - alpha ), 0.0, 1.0 );

    // SphereMaxNoH: the direction of the sphere's cone nearest R.
    vec3 lobeL = centre;
    if ( sinAlpha > 0.0 )
    {
        const float cosAlpha2 = 1.0 - sinAlpha * sinAlpha;
        const float cosAlpha  = cosAlpha2 * inversesqrt( max( cosAlpha2, 1e-12 ) );
        const float RoL       = dot( R, centre );
        if ( RoL >= cosAlpha )
            lobeL = R;
        else
        {
            const vec3  across  = R - centre * RoL;
            const float across2 = dot( across, across );
            if ( across2 > 1e-12 )
                lobeL = centre * cosAlpha + across * ( sinAlpha * inversesqrt( across2 ) );
        }
    }

    // EnergyNormalization at the lobe's half vector.
    const vec3  H      = normalize( V + lobeL );
    const float VoH    = clamp( dot( V, H ), 0.0, 1.0 );
    float       energy = 1.0;
    float       sphereA2 = a2;
    if ( sinAlpha > 0.0 )
    {
        sphereA2 = DesertAreaLightWidenedA2( a2, sinAlpha, VoH );
        energy   = a2 / sphereA2;
    }
    if ( lineCosSubtended < 1.0 )
    {
        const float lineTanAlpha2 = ( 1.0001 - lineCosSubtended ) / max( 1.0 + lineCosSubtended, 1e-4 );
        const float lineTanAlpha  = lineTanAlpha2 * inversesqrt( max( lineTanAlpha2, 1e-12 ) );
        const float lineA2        = DesertAreaLightWidenedA2( sphereA2, lineTanAlpha, VoH );
        energy                    = energy * ( sphereA2 * inversesqrt( max( sphereA2 * lineA2, 1e-24 ) ) );
    }

    // The source's own arrival cosine (SphereHorizonCosWrap over the sphere at the centre's distance), in place of
    // the cosine the moved direction would bring: the model's lobe multiplies by dot( N, L ) of the L it is given.
    const float centreDistance2 = max( dot( light.SphereCenter, light.SphereCenter ), 1e-8 );
    const float sinWrap2  = clamp( light.SphereRadius * light.SphereRadius / centreDistance2, 0.0, 1.0 );
    const float sinWrap   = sinWrap2 * inversesqrt( max( sinWrap2, 1e-12 ) );
    float       arrival   = dot( N, light.L );
    if ( sinWrap > 0.0 && arrival < sinWrap )
    {
        const float wrapped = max( arrival, -sinWrap ) + sinWrap;
        arrival             = wrapped * wrapped / ( 4.0 * sinWrap );
    }
    const float lobeCos = dot( N, lobeL );
    const float cosine  = lobeCos > 1e-4 ? max( arrival, 0.0 ) / lobeCos : 0.0;

    light.L        = lobeL;
    light.Radiance = light.Radiance * ( energy * cosine );
    return light;
}

// The environment at the surface, sampled once by the pass for the model's normal and roughness (the split-sum
// inputs of Mesh/AmbientIBL.glslh:30-38, 79-97).
struct DesertAmbient
{
    vec3  Irradiance;   // diffuse irradiance cube at S.N (sky look applied)
    vec3  Prefiltered;  // GGX-prefiltered cube at reflect(-S.V, S.N), mip by S.Roughness (sky look applied)
    vec2  SpecularBRDF; // split-sum LUT .rg at (DesertAmbientNoV(S.N, S.V), S.Roughness) (Mesh/AmbientIBL.glslh)
    vec3  Indirect;     // one-bounce INCIDENT light (the deferred GI gather); vec3( 0.0 ) in the forward passes
    float Occlusion;    // the material's AmbientOcclusion times SSAO where the pass has it (DeferredLighting.shader:250)
    // 1 when Irradiance and Prefiltered are a TRACED final gather (the screen probes: UE's Lumen diffuse indirect
    // and its rough reflections), 0 when they are the sky cubes (UE's sky light). A model whose ambient reads a
    // direction of its own (TwoSidedFoliage's far hemisphere) may read the sky cube only in the second case: in the
    // first the cube is the open sky the trace has already occluded, so a leaf deep in a canopy would take the
    // whole sky through its back face.
    float Traced;
    // The diffuse irradiance arriving from behind the surface, -S.N (same units as Irradiance): the sky cube's at -N
    // under the sky light, the traced gather's backface where Traced is 1 (UE BackfaceDiffuseIndirect). Read by a
    // model that lets light through (TwoSidedFoliage).
    vec3  BackIrradiance;
};

#endif
