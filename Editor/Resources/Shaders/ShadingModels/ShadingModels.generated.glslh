// ---- ShadingModels/Toon.shadingmodel (Guid 1484512969364128551, index 1) ----
#define Evaluate Toon_Evaluate
#define EvaluateAmbient Toon_EvaluateAmbient


vec3 Evaluate( DesertLight L, DesertSurface S, DesertPayload P )
{
    const float bands = floor( mix( 2.0, 8.0, P.CustomData0 ) + 0.5 );
    // The bands quantize the LIGHT (N.L), never the occlusion: a PCF shadow a few percent under 1 across a
    // low-poly curve would otherwise drop whole triangles a band. The shadow darkens the band it falls on.
    const float lit   = floor( max( dot( S.N, L.L ), 0.0 ) * bands ) / bands * L.Shadow;
    const float rim   = smoothstep( 1.0 - P.CustomData1, 1.0, 1.0 - max( dot( S.N, S.V ), 0.0 ) );
    return S.BaseColor * L.Radiance * ( lit + rim * lit );
}

vec3 EvaluateAmbient( DesertAmbient A, DesertSurface S, DesertPayload P )
{
    return S.BaseColor * A.Irradiance * A.Occlusion;
}

#undef Evaluate
#undef EvaluateAmbient

