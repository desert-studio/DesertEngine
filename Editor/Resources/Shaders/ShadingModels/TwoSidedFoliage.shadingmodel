// TwoSidedFoliage — the model of UE's MSM_TwoSidedFoliage: the slab (Mesh/SubstrateSlab.glslh, no feature) for the
// side the light falls on, plus the light that passes THROUGH a thin leaf to the side facing away: a Lambert lobe
// around -N, tinted by the leaf's SubsurfaceColor. It is the lobe the path tracer samples, so raster, stochastic
// lights, GI hits and the reference agree; the leaf conserves energy. Its environment term is DefaultLit's plus the sky seen through the leaf: the irradiance from
// the far hemisphere, -N, times SubsurfaceColor (UE SkyLightingDiffuseShared.ush, the TWOSIDED_FOLIAGE branch).
// Without the two transmission terms a leaf turned away from the sun is lit by the far hemisphere's blue sky
// alone — Bistro's blue-fringed cypresses and hedges.
//
// The payload is UE's: SubsurfaceColor.rgb in CustomData0..2, stored as its square root (UE
// EncodeSubsurfaceColor / ExtractSubsurfaceColor, DeferredShadingCommon.ush) so the 8-bit field spends its steps
// on the dark colours leaves are. A surface writes the sqrt of the far side's TINT; the pass that stores it splits
// the whole albedo by that tint (Mesh/Surface/SurfacePayload.glslh), and the body squares the transmitted part back. CustomData3 is UE's
// CustomData.a, the material's Opacity: the subsurface density a light's contact shadow fades with on a leaf
// (UE GetShadowTerms, IsSubsurfaceModel; Common/ContactShadow.glslh).
Guid 2293810725695897285;
Payload
{
    CustomData0 SubsurfaceColorR; // sqrt( SubsurfaceColor.r )
    CustomData1 SubsurfaceColorG; // sqrt( SubsurfaceColor.g )
    CustomData2 SubsurfaceColorB; // sqrt( SubsurfaceColor.b )
    CustomData3 SubsurfaceOpacity; // UE CustomData.a = Opacity (1 = densest; 0 = the leaf takes no contact shadow)
}
Inputs
{
    BaseColor;
    Metallic;
    Roughness;
}
SubsurfaceOpacity CustomData3;
// The surface cache's card capture keeps it per texel and lights the card's far side with it (UE: Lumen cards of a
// subsurface model carry GetMaterialSubsurfaceData; Programs/SurfaceCache).
SubsurfaceColor TwoSidedFoliageSubsurfaceColor;

#include <Mesh/SubstrateSlab.glslh>

// UE ExtractSubsurfaceColor: Square( CustomData.rgb ).
vec3 TwoSidedFoliageSubsurfaceColor( DesertPayload P )
{
    const vec3 encoded = vec3( P.CustomData0, P.CustomData1, P.CustomData2 );
    return encoded * encoded;
}

vec3 Evaluate( DesertLight L, DesertSurface S, DesertPayload P )
{
    // A thin sheet: the slab on the lit side, the transmitted albedo as a Lambert lobe around -N
    // (R + T = albedo, Common/FoliageEnergy.glslh). The path tracer samples this same lobe.
    const vec3 through = TwoSidedFoliageSubsurfaceColor( P ) * ( max( -dot( S.N, L.L ), 0.0 ) / PI );
    // UE LightAccumulator_AddSplit: the surface light (the slab, which applies L.Shadow) takes the light's Shadow,
    // the transmitted light its TransmissionShadow.
    return DesertSlabEvaluate( L, S, DesertMakeSlab( S, 0u ) ) + L.Radiance * through * L.TransmissionShadow;
}

// The slab's lobe; the transmission is diffuse (UE FDirectLighting.Transmission joins the diffuse signal).
vec3 EvaluateSpecular( DesertLight L, DesertSurface S, DesertPayload P )
{
    return DesertSlabEvaluateSpecular( L, S, DesertMakeSlab( S, 0u ) );
}

vec3 EvaluateAmbient( DesertAmbient A, DesertSurface S, DesertPayload P )
{
    // The leaf's reflection is occluded as UE's ReflectionEnvironment occludes every model's (the slab's
    // GetSpecularOcclusion on the specular, the AO on the diffuse): with the AO on it linearly, a leaf inside the
    // crown seen edge-on kept most of the open sky - Bistro's sparkling, pale-blue foliage.
    // The light through the leaf from its far side: the irradiance from -N times SubsurfaceColor. Under the SKY
    // LIGHT it is the sky cube's (UE SkyLightingDiffuseShared.ush, TWOSIDED_FOLIAGE); under a TRACED gather the
    // gather's own backface irradiance, occluded as the trace sees it (UE DiffuseIndirectComposite.usf with
    // r.Lumen.ScreenProbeGather.TwoSidedFoliageBackfaceDiffuse: BackfaceDiffuseIndirect x SubsurfaceColor). Both
    // arrive as A.BackIrradiance. The traced gather's front irradiance in its place (UE's
    // PreintegratedTwoSidedBxDF fallback) lit a leaf seen from below with the ground under it, not the sky above:
    // the dark crown of FOLIAGE-LOOK-3.
    const vec3 through = A.BackIrradiance * TwoSidedFoliageSubsurfaceColor( P ) * A.Occlusion;
    return DesertSlabEvaluateAmbient( A, S, DesertMakeSlab( S, 0u ) ) + through;
}
