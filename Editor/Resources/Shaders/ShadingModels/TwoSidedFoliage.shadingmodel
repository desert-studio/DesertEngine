// TwoSidedFoliage — UE's MSM_TwoSidedFoliage (ShadingModels.ush TwoSidedBxDF, the non-#if-0 branch): DefaultLit
// for the side the light falls on, plus the light that passes THROUGH a thin leaf to the side facing away — a
// wrapped N.L on the far side times a GGX lobe around the light's own direction, tinted by the leaf's
// SubsurfaceColor. Its environment term is DefaultLit's plus the sky seen through the leaf: the irradiance from
// the far hemisphere, -N, times SubsurfaceColor (UE SkyLightingDiffuseShared.ush, the TWOSIDED_FOLIAGE branch).
// Without the two transmission terms a leaf turned away from the sun is lit by the far hemisphere's blue sky
// alone — Bistro's blue-fringed cypresses and hedges.
//
// The payload is UE's: SubsurfaceColor.rgb in CustomData0..2, stored as its square root (UE
// EncodeSubsurfaceColor / ExtractSubsurfaceColor, DeferredShadingCommon.ush) so the 8-bit field spends its steps
// on the dark colours leaves are. The template writes sqrt(colour); the body squares it back. CustomData3 is UE's
// CustomData.a, the material's Opacity: the subsurface density a light's contact shadow fades with on a leaf
// (UE GetShadowTerms, IsSubsurfaceModel; Common/ContactShadow.glslh).
Guid 2293810725695897285;
Payload
{
    CustomData0 SubsurfaceColorR; // sqrt( SubsurfaceColor.r )
    CustomData1 SubsurfaceColorG; // sqrt( SubsurfaceColor.g )
    CustomData2 SubsurfaceColorB; // sqrt( SubsurfaceColor.b )
    CustomData3 SubsurfaceOpacity; // UE CustomData.a = Opacity (1 = densest; 0 = the leaf takes no contact shadow)
}
Inputs
{
    BaseColor;
    Metallic;
    Roughness;
}
SubsurfaceOpacity CustomData3;

#include <Mesh/BRDF.glslh>
#include <Mesh/DirectLighting.glslh>
// The pure half of the ambient text when the pass has not included the whole file (DefaultLit.shadingmodel says why).
#ifndef AMBIENT_IBL_GLSLH
#define AMBIENT_IBL_NO_SAMPLERS
#include <Mesh/AmbientIBL.glslh>
#endif

// UE ExtractSubsurfaceColor: Square( CustomData.rgb ).
vec3 TwoSidedFoliageSubsurfaceColor( DesertPayload P )
{
    const vec3 encoded = vec3( P.CustomData0, P.CustomData1, P.CustomData2 );
    return encoded * encoded;
}

// UE BRDF.ush D_GGX( a2, NoH ), the form TwoSidedBxDF calls with a2 = 0.6 * 0.6.
float TwoSidedFoliageGGX( float a2, float NoH )
{
    const float d = ( NoH * a2 - NoH ) * NoH + 1.0;
    return a2 / ( PI * d * d );
}

vec3 Evaluate( DesertLight L, DesertSurface S, DesertPayload P )
{
    const vec3 F0      = mix( vec3( 0.04 ), S.BaseColor, S.Metallic );
    const vec3 surface = EvaluateDirectLight( L.L, L.Radiance, S.V, S.N, F0, S.Metallic, S.Roughness, S.BaseColor );

    // http://blog.stevemcauley.com/2011/12/03/energy-conserving-wrapped-diffuse/ — UE's Wrap = 0.5 on -N.L.
    const float wrap    = 0.5;
    const float wrapNoL = clamp( ( -dot( S.N, L.L ) + wrap ) / ( ( 1.0 + wrap ) * ( 1.0 + wrap ) ), 0.0, 1.0 );
    // Scatter distribution: forward scattering, peaked where the eye looks through the leaf into the light.
    const float scatter      = TwoSidedFoliageGGX( 0.6 * 0.6, clamp( -dot( S.V, L.L ), 0.0, 1.0 ) );
    const vec3  transmission = L.Radiance * ( wrapNoL * scatter ) * TwoSidedFoliageSubsurfaceColor( P );

    // UE LightAccumulator_AddSplit: the surface light takes the light's Shadow, the transmitted light its
    // TransmissionShadow (the thickness of what stands between the leaf and the light). With Shadow on both, the
    // normal offset of the opaque test put a leaf's far side behind the leaf itself: every leaf turned from the
    // light was fully shadowed and the transmission never reached the screen.
    return surface * L.Shadow + transmission * L.TransmissionShadow;
}

vec3 EvaluateAmbient( DesertAmbient A, DesertSurface S, DesertPayload P )
{
    const vec3 F0  = mix( vec3( 0.04 ), S.BaseColor, S.Metallic );
    const vec3 ibl = EvaluateAmbientIBL( A.Irradiance, A.Prefiltered, A.SpecularBRDF, F0, S.BaseColor, S.Metallic,
                                         max( dot( S.N, S.V ), 0.0 ) );
    // The light through the leaf from its far side. Under the SKY LIGHT (A.Traced 0) it is the sky cube's
    // irradiance from -N (UE SkyLightingDiffuseShared.ush, TWOSIDED_FOLIAGE). Under a TRACED gather (A.Traced 1)
    // the cube is the open sky the trace has already occluded: read there, every leaf deep in a canopy took the
    // whole sky through its back face and the bush was lit flat, its interior as bright as its rim. UE's Lumen
    // answer (DiffuseIndirectComposite.usf, without r.Lumen.ScreenProbeGather.TwoSidedFoliageBackfaceDiffuse):
    // the SubsurfaceColor joins the diffuse lobe under the traced irradiance, at PreintegratedTwoSidedBxDF = 1/PI.
    const vec3 back    = A.Traced > 0.5 ? A.Irradiance * ( 1.0 / PI ) : DesertAmbientIrradiance( -S.N );
    const vec3 through = back * TwoSidedFoliageSubsurfaceColor( P ) * A.Occlusion;
    return ComposeAmbient( ibl, S.BaseColor, A.Occlusion, A.Indirect ) + through;
}
