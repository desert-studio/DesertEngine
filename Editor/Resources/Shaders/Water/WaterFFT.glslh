// THE FFT OCEAN ON THE GPU (WATER-RIVERS-FFT): the constants and the per-frame block the compute programs
// share - Programs/Water/WaterFFTSpectrum.shader (h(k, t) and its seven derived spectra), WaterFFT.shader (one
// radix-2 inverse FFT along the rows or the columns of every cascade) and WaterFFTFinalize.shader (the cascades'
// displacement / slope atlas the water mesh samples, Mesh/Surface/WaterMeshTiles.glslh), then WaterSurfFoam.shader
// (the surf foam over them).
//
// The CPU half and its units: Engine/Water/FFTOceanSpectrum.hpp (centimetres, radians per centimetre, seconds;
// the plane is (world X, world Z) relative to the body's WaveOrigin). The C++ twin of WaterFFTParams is
// WaterRenderer.cpp's WaterFFTParams.
#ifndef DESERT_WATER_FFT_GLSLH
#define DESERT_WATER_FFT_GLSLH

// Water::kFFTOceanResolution / kFFTOceanResolutionLog2 / kFFTOceanCascades.
#define WATER_FFT_SIZE 256
#define WATER_FFT_LOG2 8
#define WATER_FFT_CASCADES 3

// Deep-water gravity in cm/s^2, as Common/GerstnerWave.glslh's GERSTNER_GRAVITY.
const float WATER_FFT_GRAVITY = 980.0;
const float WATER_FFT_TWO_PI  = 6.2831853071795865;

struct WaterFFTParams
{
    vec4 Cascade; // xyz = patch side of cascades 0..2 (cm), w = the view's time (s, cameraUB.Time)
    vec4 Shape;   // x = choppiness (lambda), y = IFFT direction (0 = along rows, 1 = along columns), z = the atlas's first band this frame writes (0 or WATER_FFT_BANDS_PER_FRAME, WaterFFTFinalize), w = the surf windows' eye height (world Y, cm)
    vec4 Foam;    // the foam history (WaterFFTFinalize): x = the share of last frame's foam kept, exp(-dt / the body material's FoamDecaySeconds); y = 1 + the PREVIOUS frame's first band, 0 = no history (the first FFT frame, a new sea); z = the body material's FoamBreakerIndex (<= 0: no surf foam), w = the time since the previous half was written (s)
    // The surf foam's (WaterSurfFoam alone):
    vec4 Surf;       // xy = the eye (world X, Z) this half's windows stand around, zw = the previous half's
    vec4 SurfWave;   // xy = the set's WaveOrigin (world X, Z), z = its body's still level (cm), w = its TargetWaveMaskDepth (cm)
    vec4 SurfGround; // the WaterInfo atlas's ground region: xy = lower world (X, Z), z = 1 / side (1/cm), w = side in texels (0 = no ground, no surf)
};

// The foam history's band within a frame's half of the atlas (Mesh/Surface/WaterMeshTiles.glslh
// WATER_FFT_FOAM_BAND): after the cascades' displacement (0..2) and slopes (3..5).
#define WATER_FFT_FOAM 6

// The first of the surf foam's four bands within a half (WATER_FFT_SURF_BAND there): one 512 x 512 window in 256-wide
// rows (Water/WaterSurfFoam.glslh).
#define WATER_FFT_SURF 7

// Complex product of a and b (x = real, y = imaginary).
vec2 WaterFFTMul( vec2 a, vec2 b )
{
    return vec2( a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x );
}

// Two spectra of REAL fields packed into one complex signal: the inverse FFT of A + iB is a + ib.
vec2 WaterFFTPack( vec2 a, vec2 b )
{
    return vec2( a.x - b.y, a.y + b.x );
}

#endif // DESERT_WATER_FFT_GLSLH
