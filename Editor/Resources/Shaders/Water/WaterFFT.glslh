// THE FFT OCEAN ON THE GPU: the constants and the per-frame block the compute programs share -
// Programs/Water/WaterFFTSpectrum.shader (h(k, t) and its derived spectra), WaterFFT.shader (one radix-2 inverse
// FFT along the rows or the columns of every cascade), WaterFFTFinalize.shader (the waves' array) and
// WaterWaveMips.shader (its mips); Water/WaterSurfaceField.glslh reads the array.
//
// The CPU half and its units: FFTOceanSpectrum.hpp (centimetres, radians per centimetre, seconds; the plane is
// (world X, world Z) relative to the body's WaveOrigin, in the cascade's turned lattice).
#ifndef DESERT_WATER_FFT_GLSLH
#define DESERT_WATER_FFT_GLSLH

// Water::kFFTOceanResolution / kFFTOceanResolutionLog2 / kFFTOceanCascades.
#define WATER_FFT_SIZE 256
#define WATER_FFT_LOG2 8
#define WATER_FFT_CASCADES 4

// The layers of the waves' array, one per cascade each, in lattice axes.
#define WATER_WAVES_DISPLACEMENT 0 // xyz the displacement (lambda Dx, Dy, lambda Dz), w lambda dDx/dz
#define WATER_WAVES_SLOPES 4       // xy the height's slopes, zw lambda dDx/dx, lambda dDz/dz
#define WATER_WAVES_PREVIOUS 8     // the displacement one frame earlier
#define WATER_WAVES_MOMENTS 12     // xy the squared slopes: a mip's mean less its mean slope squared is the lost variance
#define WATER_WAVES_LAYERS 16
#define WATER_WAVES_MIPS 9

// Deep-water gravity in cm/s^2, as Common/GerstnerWave.glslh's GERSTNER_GRAVITY.
const float WATER_FFT_GRAVITY = 980.0;
const float WATER_FFT_TWO_PI  = 6.2831853071795865;

// WaterFFTParams (Cascade, Shape): Water/Private/WaterLayout.hpp.
#include <Generated/Water/WaterFFT.glslh>

// Complex product of a and b (x = real, y = imaginary).
vec2 WaterFFTMul( vec2 a, vec2 b )
{
    return vec2( a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x );
}

// Two spectra of REAL fields packed into one complex signal: the inverse FFT of A + iB is a + ib.
vec2 WaterFFTPack( vec2 a, vec2 b )
{
    return vec2( a.x - b.y, a.y + b.x );
}

#endif // DESERT_WATER_FFT_GLSLH
