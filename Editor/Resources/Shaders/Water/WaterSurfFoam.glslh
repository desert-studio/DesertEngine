// THE SURF FOAM'S WINDOWS (WATER-RIPPLES-FFT): where Programs/Water/WaterSurfFoam.shader writes the foam and
// WaterFFTSurfFoam (Mesh/Surface/WaterMeshTiles.glslh) reads it, one addressing for both.
//
// Three nested square windows of WATER_SURF_SIZE cells around the eye (a geometry clipmap, Losasso & Hoppe 2004): 25
// cm, 1 m and 4 m cells (128 m, 512 m, 2 km across). A cell is fixed to the WORLD and stored at its index modulo the
// window's size, so a moving eye re-addresses nothing: only the cells that enter a window start empty. The three
// windows share the texels (x, y, z = level 0..2).
#ifndef DESERT_WATER_SURF_FOAM_GLSLH
#define DESERT_WATER_SURF_FOAM_GLSLH

#define WATER_SURF_SIZE 512
#define WATER_SURF_HALF 256
#define WATER_SURF_LEVELS 3

// The side of a level's cell (cm).
float WaterSurfCell( int level )
{
    return level == 0 ? 25.0 : ( level == 1 ? 100.0 : 400.0 );
}

// The first cell of a level's window around the eye (world X, Z, cm).
ivec2 WaterSurfOrigin( vec2 eye, int level )
{
    return ivec2( floor( eye / WaterSurfCell( level ) ) ) - WATER_SURF_HALF;
}

// The atlas texel of a window texel (0..511 on both axes): the window's two 256-wide halves stand one under the
// other from `firstRow` on.
ivec2 WaterSurfAtlasTexel( int firstRow, ivec2 texel )
{
    return ivec2( texel.x & 255, firstRow + ( texel.x >> 8 ) * WATER_SURF_SIZE + texel.y );
}

#endif // DESERT_WATER_SURF_FOAM_GLSLH
