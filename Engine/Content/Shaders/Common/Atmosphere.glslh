// Procedural ARTISTIC sky (gradient model). Driven by the view ray + sun direction; the whole look
// (day / sunrise-sunset / night) is a function of the SUN ELEVATION (sunDir.y). Output is LINEAR HDR
// (post-process tonemap applies exposure/gamma).
//
// THIS IS THE ENGINE'S ONLY SKY EVALUATION. The screen sky pass and the IBL bake both include this file
// and call EvaluateSky; there is no second copy of the maths in GLSL or in C++, so the sky you SEE and the
// light it CASTS cannot drift apart.
//
// A pass gets its parameters through the SkyPacked loaders below: the LAYOUT lives here, in one place,
// while the BINDING stays each pass's own business — which is what lets the graphics sky pass and a
// compute pass read the same buffer from different descriptor sets. Nothing in this file declares a
// sampler, a derivative or any other fragment-only construct, so it compiles in a compute stage; the IBL
// bake has been proving that on every platform CI builds for some time now.

#ifndef ATMOSPHERE_GLSLH
#define ATMOSPHERE_GLSLH

const float ATM_PI = 3.141592653589793;

// Editor-tunable palette + scalars (see ECS::SkyAtmosphereData). Colours are LINEAR.
struct SkyConfig
{
    vec3  zenith;          // sky colour straight up (day)
    vec3  horizon;         // sky colour at the horizon (day)
    vec3  sunColor;        // sun disk/glow tint at noon
    vec3  sunsetColor;     // warm horizon reddening near the sun at low angles
    vec3  ground;          // hazy tone below the horizon (day)
    vec3  night;           // night sky zenith tint
    float skyBrightness;   // overall sky multiplier
    float horizonFalloff;  // gradient reach (smaller = horizon colour hugs the bottom)
    float sunGlow;         // sun glow strength
    float sunsetIntensity; // sunset reddening strength
    float starIntensity;   // night star brightness
};

// ---- The packed sky parameter block, mirrored by Graphic::SkyGpuPayload (Engine/Graphic/SkyPayload.hpp) ----
//
//   v[0]  xyz = direction TOWARD the sun (normalized), w = sun intensity
//   v[1]  rgb = zenith colour,  w = sky brightness
//   v[2]  rgb = horizon colour, w = horizon falloff
//   v[3]  rgb = sun colour,     w = sun glow
//   v[4]  rgb = sunset colour,  w = sunset intensity
//   v[5]  rgb = ground colour,  w = star intensity
//   v[6]  rgb = night colour,   w = sun angular RADIUS in RADIANS
//
// The physical-atmosphere medium (SkyModel::PhysicalAtmosphere), appended and never inserted —
// every offset above is a promise to every shader that reads the block. Coefficients are PER
// KILOMETRE, scale heights and altitudes in kilometres; the planet radius alone is WORLD UNITS and
// is converted to km inside SkyMedium.glslh (the one conversion):
//
//   v[7]  rgb = Rayleigh scattering /km, w = Rayleigh scale height (km)
//   v[8]  rgb = Mie scattering /km,      w = Mie scale height (km)
//   v[9]  rgb = Mie absorption /km,      w = Mie anisotropy g
//   v[10] rgb = ozone absorption /km,    w = atmosphere height (km)
//   v[11] rgb = ground albedo,           w = multi-scattering factor
//   v[12] x = ozone tip altitude (km), y = ozone tip value, z = ozone tent width (km),
//         w = planet radius (WORLD UNITS)
//
// The Phase 2 lanes — the model switch and the art-direction tints the physical sky pass and the
// Sky-View LUT read (appended, like the medium before them):
//
//   v[13] rgb = Sky Luminance Factor (sky pixels only), w = sky model (0 gradient, 1 physical)
//   v[14] rgb = Sky And Aerial Perspective Luminance Factor (inside every scattering integration),
//         w = reserved (0)
//
// A pass declares its own buffer at its own binding, copies it into a SkyPacked, and calls the loaders:
//
//   ReadBuffer(1) SkyBuffer { vec4 u_SkyPacked[SKY_PACKED_VEC4_COUNT]; };
//   SkyPacked s; for (int i = 0; i < SKY_PACKED_VEC4_COUNT; ++i) s.v[i] = u_SkyPacked[i];
//   vec3 color = EvaluateSky( dir, UnpackSunDirection(s), UnpackSunIntensity(s),
//                             UnpackSunAngularRadius(s), UnpackSkyConfig(s) );
//
// Adding a palette field is then one edit here plus one to the C++ mirror; no consumer changes a line.
#define SKY_PACKED_VEC4_COUNT 15

struct SkyPacked
{
    vec4 v[SKY_PACKED_VEC4_COUNT];
};

SkyConfig UnpackSkyConfig( SkyPacked s )
{
    SkyConfig c;
    c.zenith          = s.v[1].rgb;
    c.horizon         = s.v[2].rgb;
    c.sunColor        = s.v[3].rgb;
    c.sunsetColor     = s.v[4].rgb;
    c.ground          = s.v[5].rgb;
    c.night           = s.v[6].rgb;
    c.skyBrightness   = s.v[1].w;
    c.horizonFalloff  = s.v[2].w;
    c.sunGlow         = s.v[3].w;
    c.sunsetIntensity = s.v[4].w;
    c.starIntensity   = s.v[5].w;
    return c;
}

// Direction TOWARD the sun. The CPU writes it normalized (there is exactly one negation in the engine,
// ECS::Rules::AtmosphereSunDirection); normalizing again here costs nothing and makes the loader safe to
// call from a pass that assembled the block itself.
vec3 UnpackSunDirection( SkyPacked s )
{
    return normalize( s.v[0].xyz );
}

float UnpackSunIntensity( SkyPacked s )
{
    return s.v[0].w;
}

// RADIANS. The component authors an angular DIAMETER in degrees; the halving and the conversion happen
// once, on the C++ side, so no shader has to know which of the two it was handed.
float UnpackSunAngularRadius( SkyPacked s )
{
    return s.v[6].w;
}

// ---- The physical-atmosphere medium block, one accessor per vec4 -----------------------------------
// The INDICES live here, next to the layout comment they implement; the MEANING of each lane is
// SkyMedium.glslh's SkyMakeAtmParams, which takes these six in this order. A LUT pass therefore never
// spells an index, and reordering the block is one edit here plus one to the C++ mirror.

vec4 UnpackMediumRayleigh( SkyPacked s )
{
    return s.v[7];
}

vec4 UnpackMediumMie( SkyPacked s )
{
    return s.v[8];
}

vec4 UnpackMediumMieAbsorption( SkyPacked s )
{
    return s.v[9];
}

vec4 UnpackMediumOzone( SkyPacked s )
{
    return s.v[10];
}

vec4 UnpackMediumGround( SkyPacked s )
{
    return s.v[11];
}

vec4 UnpackMediumTentPlanet( SkyPacked s )
{
    return s.v[12];
}

// ---- The Phase 2 lanes ------------------------------------------------------------------------------

// True when the authored SkyModel is PhysicalAtmosphere. The one branch point every sky consumer
// shares: the C++ side packs 1.0 exactly, so the comparison is not a float hazard.
bool UnpackSkyModelIsPhysical( SkyPacked s )
{
    return s.v[13].w > 0.5;
}

// Art-direction tint on the PHYSICAL sky's on-screen pixels only (UE's SkyLuminanceFactor). Never
// touches the aerial perspective over geometry, and never the gradient model.
vec3 UnpackSkyLuminanceFactor( SkyPacked s )
{
    return s.v[13].rgb;
}

// Art-direction tint applied INSIDE every scattering integration of the physical model (UE's
// SkyAndAerialPerspectiveLuminanceFactor) — the Sky-View LUT fill and the IBL bake march, and the
// Phase 3 aerial-perspective volume after them.
vec3 UnpackSkyAndAerialPerspectiveLuminanceFactor( SkyPacked s )
{
    return s.v[14].rgb;
}

float atm_hash13( vec3 p )
{
    p = fract( p * vec3( 443.897, 441.423, 437.195 ) );
    p += dot( p, p.yzx + 19.19 );
    return fract( ( p.x + p.y ) * p.z );
}

// Full sky radiance along a world-space view direction. sunDir = direction TOWARD the sun (normalized).
vec3 EvaluateSky( vec3 dir, vec3 sunDir, float sunIntensity, float sunDiskRadius, SkyConfig cfg )
{
    dir    = normalize( dir );
    sunDir = normalize( sunDir );

    float up    = dir.y;
    float sunUp = sunDir.y;

    // Day / night blend + sunset window from the sun elevation.
    float day    = smoothstep( -0.10, 0.20, sunUp );
    float night  = 1.0 - day;
    float sunset = ( 1.0 - smoothstep( 0.0, 0.30, abs( sunUp ) ) ) * smoothstep( -0.25, 0.0, sunUp );

    // Day/night palettes (night derived from the night tint).
    vec3 zenith  = mix( cfg.night, cfg.zenith, day );
    vec3 horizon = mix( cfg.night * 1.6, cfg.horizon, day );

    // ---- Sky Color: C1-smooth horizon->zenith gradient (smoothstep => no kink/Mach line at up=0) ----
    vec3 sky = mix( horizon, zenith, smoothstep( 0.0, max( cfg.horizonFalloff, 0.05 ), up ) );

    // ---- Sunset: warm reddening of the horizon band toward the sun azimuth ----
    vec3  hd = vec3( dir.x, 0.0, dir.z );
    vec3  hs = vec3( sunDir.x, 0.0, sunDir.z );
    hd /= max( length( hd ), 1e-4 );
    hs /= max( length( hs ), 1e-4 );
    float sunAzim     = pow( clamp( dot( hd, hs ), 0.0, 1.0 ), 2.0 );
    float horizonBand = exp( -up * up * 8.0 ); // Gaussian (smooth at up=0)
    sky = mix( sky, cfg.sunsetColor, sunset * cfg.sunsetIntensity * horizonBand * ( 0.35 + 0.65 * sunAzim ) );

    sky *= cfg.skyBrightness;

    // ---- Sun: SOFT Gaussian disk (no hard edge) + a broad halo. A hard, ~sub-pixel disk aliases and seems
    // to crawl/jitter under camera rotation without TAA; a soft core is visually stable. The sun is anchored
    // to the WORLD sun direction, so it doesn't move as you turn. Warm at sunset, sunColor at noon. ----
    float cd      = dot( dir, sunDir );
    float ang     = acos( clamp( cd, -1.0, 1.0 ) );      // angular distance to the sun
    float r       = max( sunDiskRadius, 0.001 );
    float core    = exp( -( ang * ang ) / ( r * r ) );   // soft round sun (Gaussian)
    float glow    = pow( max( cd, 0.0 ), 8.0 ) * 0.10;   // broad soft halo (no tight high-freq ring)
    vec3  sunTint = mix( cfg.sunsetColor, cfg.sunColor, smoothstep( 0.0, 0.25, sunUp ) );
    sky += ( core * sunIntensity * 0.06 + glow * cfg.sunGlow * day ) * sunTint;

    // ---- Stars: STABLE soft points fixed in WORLD direction. Cells live in direction space; each star is a
    // soft round falloff around its cell centre, so stars don't pop/move blockily as the camera rotates (the
    // old per-cell threshold lit whole cells -> blocky, swimming "regenerating" look). ----
    if ( night > 0.01 && up > 0.0 )
    {
        vec3  sp = dir * 300.0;
        vec3  id = floor( sp );
        float h  = atm_hash13( id );
        if ( h > 0.992 )
        {
            float d    = length( fract( sp ) - 0.5 );          // distance from the cell centre
            float star = smoothstep( 0.35, 0.0, d ) * h;
            sky += star * night * cfg.starIntensity * smoothstep( 0.0, 0.25, up ) * vec3( 0.9, 0.95, 1.0 );
        }
    }

    // ---- Ground: hazy tone below the horizon, low-contrast + C1-smooth seam (no shimmer) ----
    vec3 ground = mix( cfg.ground * 0.30, cfg.ground, day );
    sky         = mix( sky, ground, smoothstep( 0.0, -0.35, up ) );

    return max( sky, 0.0 );
}

#endif // ATMOSPHERE_GLSLH
