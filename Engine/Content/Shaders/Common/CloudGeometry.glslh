// The geometry of a cloud layer: where a view ray enters and leaves the shell, how high inside it a
// sample sits, and how many steps the march is allowed to take. Written once in the dual-compile dialect
// (see Common/CloudNoise.glslh for the rules) and driven as C++ by Desert/Tests/Engine/CloudGeometry.
//
// THE LAYER IS A SPHERICAL SHELL, not a slab. Two spheres concentric with the planet, and the ray is
// intersected against both. A flat slab is the cheaper thing to write and it is wrong in the way that
// matters most: it puts the horizon at infinity, so a layer 3 km thick either fills the whole lower sky
// or is clipped by an invisible plane, and no amount of parameter tuning moves that. This is also UE's
// arrangement (VolumetricCloud.usf: two RayIntersectSphereSolution calls against BottomRadiusKm and
// TopRadiusKm) and Nubis's, and it is the reason the planet radius is a parameter at all.
//
// EVERYTHING HERE IS IN KILOMETRES, and positions are RELATIVE TO THE PLANET CENTRE. Both conventions are
// deliberate. Kilometres because the shell radii are ~6360 and float32 resolves that to about 0.4 m,
// which is finer than any cloud feature we render; world units (centimetres) would put the same radius at
// 6.36e8, where float32 resolves 64 m and the two shells of a thin layer would quantize onto each other.
// Planet-centre-relative because that is the frame in which both spheres are centred on the origin, so
// the intersection never forms the planet centre as a large coordinate and never subtracts two nearly
// equal squares.
//
// THE ROOTS ARE SIGNED. A ray pointing away from the shell produces negative roots and must be treated as
// a miss; taking their absolute value — the obvious-looking simplification — makes every ray "hit" the
// layer behind the camera, which renders as clouds mirrored below the horizon.

#ifndef CLOUD_GEOMETRY_GLSLH
#define CLOUD_GEOMETRY_GLSLH

// One world unit is one centimetre (Common::Units), so a kilometre is 100 000 of them. Mirrored by
// Graphic::kCloudWorldUnitsPerKm.
#define CLOUD_WORLD_UNITS_PER_KM 100000.0f

// The shell this frame marches. Radii are measured from the planet centre, which is what lets the
// intersection below be two plain sphere tests.
struct CloudLayer
{
    float PlanetRadiusKm;
    float BottomRadiusKm;
    float TopRadiusKm;
};

// Builds the shell from what the artist actually authors: an altitude above the ground and a thickness.
//
// The thickness is floored at a metre rather than at zero. A shell of exactly zero thickness has a
// coincident pair of roots, and every ray that grazes it produces a segment of length zero which the step
// schedule then divides by — the floor turns an authorable division by zero into an invisible layer.
CloudLayer CloudMakeLayer( float planetRadiusKm, float bottomAltitudeKm, float thicknessKm )
{
    CloudLayer layer;
    layer.PlanetRadiusKm = planetRadiusKm;
    layer.BottomRadiusKm = planetRadiusKm + max( bottomAltitudeKm, 0.0f );
    layer.TopRadiusKm    = layer.BottomRadiusKm + max( thicknessKm, 0.001f );
    return layer;
}

// Ray against a sphere centred on the origin. Returns the two signed roots, nearest first; a MISS is
// encoded as x > y, which is a state the hit path can never produce.
//
// The constant term is written as (len - r) * (len + r) rather than dot(o,o) - r*r. Algebraically they
// are the same; numerically they are not. With |o| and r both near 6360, dot(o,o) - r*r subtracts two
// numbers near 4.0e7 whose difference is of order 1, discarding roughly seven of the eight significant
// digits float32 has. The factored form subtracts before it multiplies, so the small quantity is computed
// exactly and only then scaled. This is the difference between a layer whose boundaries are resolved to
// the metre and one whose boundaries jitter by kilometres near the horizon.
vec2 CloudRaySphere( vec3 originKm, vec3 rayDir, float radiusKm )
{
    vec2 result;

    float len  = length( originKm );
    float b    = 2.0f * dot( originKm, rayDir );
    float c    = ( len - radiusKm ) * ( len + radiusKm );
    float disc = b * b - 4.0f * c;

    if ( disc < 0.0f )
    {
        result.x = 1.0f;
        result.y = -1.0f;
        return result;
    }

    float root = sqrt( disc );
    result.x   = ( -b - root ) * 0.5f;
    result.y   = ( -b + root ) * 0.5f;
    return result;
}

// The segment of the ray that lies inside the shell, as (tEnter, tExit) in kilometres along @p rayDir.
//
// NOTHING TO MARCH is reported as y <= x, and callers must test it. There are three ways to get there and
// all of them are ordinary: the ray points away from the planet's sky, the ray is below the layer and
// aimed at the ground, or the camera is above the layer looking up.
//
// The case analysis is Unreal's (VolumetricCloud.usf, the TMin/TMax block) and it is not obvious enough
// to re-derive: the reason the top chord is clamped to its NEAR root when both bottom roots are ahead is
// that the camera is then below the layer looking up through it, and the far top root is on the other
// side of the planet.
vec2 CloudLayerIntersect( CloudLayer layer, vec3 originKm, vec3 rayDir )
{
    vec2 result;

    vec2 top = CloudRaySphere( originKm, rayDir, layer.TopRadiusKm );
    if ( top.x > top.y )
    {
        result.x = 1.0f;
        result.y = -1.0f;
        return result;
    }

    vec2 bottom = CloudRaySphere( originKm, rayDir, layer.BottomRadiusKm );

    float tMin;
    float tMax;

    if ( bottom.x > bottom.y )
    {
        // The inner sphere is not on the path at all: the whole outer chord is inside the shell.
        tMin = top.x;
        tMax = top.y;
    }
    else
    {
        bool  bottomAhead = bottom.x > 0.0f && bottom.y > 0.0f;
        float tempTop     = ( top.x > 0.0f && top.y > 0.0f ) ? top.x : top.y;
        float tempBottom  = bottomAhead ? bottom.x : bottom.y;

        if ( bottomAhead )
            tempTop = max( 0.0f, top.x );

        tMin = min( tempBottom, tempTop );
        tMax = max( tempBottom, tempTop );
    }

    // The camera may already be inside the shell, in which case the entry root is behind it.
    result.x = max( tMin, 0.0f );
    result.y = tMax;

    // THE PLANET IS OPAQUE, and without this the function happily reports the shell on the FAR SIDE of it.
    //
    // Both sphere tests above are pure geometry: a ray aimed at the ground leaves the layer behind, passes
    // through the planet, and meets both shells again twelve thousand kilometres later. Nothing in the
    // case analysis rejects that, because nothing in it knows the planet is solid — it only knows two
    // radii. Measured, a ray straight down from half a kilometre up returns the segment
    // 12725.50 .. 12735.50 km and the march runs it.
    //
    // The scene depth hides it wherever there IS ground: the march cuts the segment at the geometry and
    // the result collapses to nothing. It shows the moment a downward ray finds no geometry — off the edge
    // of a terrain, through a hole, over water that is not drawn — as cloud rendered BELOW the horizon.
    //
    // One extra sphere test per ray, not per step, and it is the exact statement rather than a distance
    // cutoff that happens to catch it: if the planet is met before the layer is entered, there is nothing
    // to march.
    vec2 planet = CloudRaySphere( originKm, rayDir, layer.PlanetRadiusKm );
    if ( planet.x <= planet.y && planet.x > 0.0f && planet.x < result.x )
    {
        result.x = 1.0f;
        result.y = -1.0f;
    }

    return result;
}

// Where a sample sits inside the layer, 0 at the base and 1 at the top.
//
// Measured from the planet centre, so it follows the curvature: a sample twenty kilometres away is at the
// same fraction as one overhead when both are the same height above the ground. Taking the world Y
// instead — the tempting simplification, since near the camera the two agree — puts every distant cloud
// progressively lower in its own layer until, at the horizon, the whole layer is compressed into its
// floor.
float CloudHeightFraction( CloudLayer layer, vec3 positionKm )
{
    float altitude  = length( positionKm ) - layer.BottomRadiusKm;
    float thickness = max( layer.TopRadiusKm - layer.BottomRadiusKm, 1e-6f );
    return clamp( altitude / thickness, 0.0f, 1.0f );
}

// THE LOCAL ZENITH at a sample, which is not the world's +Y and is not the camera's.
//
// Positions in this frame are measured from the planet centre, so the direction "up" at a sample is the
// direction of the sample itself. Over the shell's reach that is not a pedantic distinction: at the
// hundred and fifty kilometres a layer's Max View Distance can span, the local vertical has tilted by
// atan(150 / 6360) = 1.35 degrees, so a ray toward the sun leaves the far deck at a measurably different
// zenith angle than it leaves the near one. Anything that reads a function of the SUN'S ELEVATION at a
// sample — an atmospheric transmittance, an ozone column — has to ask the sample, not the camera.
//
// No epsilon guard and none needed: a position in this frame has a magnitude of a planet radius, and the
// only way to hand this the origin is to hand it the planet's own centre.
vec3 CloudLocalUp( vec3 positionKm )
{
    return normalize( positionKm );
}

// How high a sample stands above the GROUND, kilometres — not above the layer's base, which is what
// CloudHeightFraction measures. The two differ by the layer's bottom altitude, and the distinction
// matters to anything that has to place the sample inside a shell that is not the cloud's: the atmosphere
// is measured from the planet surface and a cloud deck is five kilometres up it.
//
// Floored at zero rather than allowed negative. The march never places a sample below the shell, but the
// SHADOW ray's first segment can step below its start when the start is on the base itself, and a
// negative altitude reaching a LUT parameterisation is a coordinate outside its domain rather than a
// slightly wrong one.
float CloudAltitudeKm( CloudLayer layer, vec3 positionKm )
{
    return max( length( positionKm ) - layer.PlanetRadiusKm, 0.0f );
}

// ---------------------------------------------------------------------------------------------------
// THE STEP SCHEDULE, ALL FOUR NUMBERS OF IT
// ---------------------------------------------------------------------------------------------------
//
// The two below used to be declared in Common/CloudParams.glslh, next to the uniform block. That put them
// in a file which is not compilable as C++, so the only thing a test could do with them was read the file
// as TEXT and compare the digits — which is what Desert/Tests/Engine/CloudGeometry did. Text cannot
// express the relation that actually binds them, so they are here now, with the two they have to agree
// with.
//
// They are NOT component parameters, for the reason they are cvars in Unreal rather than fields of
// UVolumetricCloudComponent: they trade cost against quality identically in every scene. The authorable
// half of the schedule is the step CEILING, which is a quality tier.

// The floor. A ray whose segment is a metre long still gets two samples, because the march turns the
// count into an int and divides by it.
#define CLOUD_MIN_STEPS 2.0f

// Segment length at which the step count saturates. Unreal's r.VolumetricCloud.DistanceToSampleMaxCount.
//
// FOUR KILOMETRES AND NOT FIFTEEN, AND THE FOUR IS MEASURED. Below this length the fine step is
// `distanceToMax / maxCount` — a constant, independent of the segment — so this number, and not the
// segment, is what sets the march's resolution for every ray that crosses a THIN SHELL. That covers most
// of the library: after the profile became a table the shell is the species' own envelope, and six of the
// nine shipped types are under 1.5 km thick.
//
// At fifteen kilometres that resolution was 58.6 m fine and 234 m coarse, and the coarse one is what
// decides whether a cloud is FOUND at all (see the two-tier note below). Measured on the shipped library,
// Clouds_Demo's layer, 2304 rays per elevation, three elevations, the median chord of cloud along a view
// ray against that 234 m: five of the nine types were past Nyquist — Cirrus by 3.66x with 75 per cent of
// its chords thinner than one coarse step, then Altocumulus 2.13x, Cumulus Humilis 1.99x, Stratocumulus
// 1.72x and Lenticular 1.56x. The budget was not the reason: those same rays were spending 12 to 43 steps
// of the 256 the component grants them, because a 0.4 km shell crossed at any elevation is a segment
// nowhere near fifteen kilometres and the count had barely left its floor.
//
// Four kilometres spends that budget where it was already allotted. The fine step becomes 15.6 m and the
// coarse one 62.5 m, every one of the nine types clears Nyquist at all three elevations (the worst is
// Cirrus at 0.98x, where it was 3.66x), and the fraction of chords no jitter phase ever samples falls from
// 10.6 to 3.4 per cent on Cirrus and from 7.6 to 5.2 on Stratocumulus. NO RAY COSTS MORE THAN BEFORE in
// the sense that matters: the ceiling is `maxCount`, it is unchanged, and a ray that was already saturated
// — every cumulonimbus ray, every grazing ray — is untouched, because for a segment longer than this
// number the step is the segment over the ceiling and this number does not enter.
#define CLOUD_DISTANCE_TO_MAX_STEPS_KM 4.0f

// How many steps this ray is allowed. Unreal's heuristic, and the reason to prefer it over anything
// adaptive is that it is PREDICTABLE: the count depends only on the length of the segment, so the cost of
// a frame can be reasoned about before it is measured, and no ray can be made expensive by the contents
// of the scene.
//
// The count rises linearly with the segment until @p distanceToMaxKm and saturates after it. A ray that
// skims the underside of the layer is the expensive case — its segment is long — and the saturation is
// what stops it from being unboundedly so.
float CloudStepCount( float segmentLengthKm, float minCount, float maxCount, float distanceToMaxKm )
{
    float t = clamp( segmentLengthKm / max( distanceToMaxKm, 1e-6f ), 0.0f, 1.0f );
    return max( minCount, maxCount * t );
}

// The fine step the march derives from that count, as ONE function rather than as a division the shader
// performs and a test restates. Everything downstream — the coarse stride, the jitter, the resolvable
// chord — is a multiple of this, so it is the quantity worth naming.
float CloudFineStepKm( float segmentLengthKm, float minCount, float maxCount, float distanceToMaxKm )
{
    return segmentLengthKm / CloudStepCount( segmentLengthKm, minCount, maxCount, distanceToMaxKm );
}

// ---------------------------------------------------------------------------------------------------
// THE TWO-TIER SCHEDULE. These two numbers are the whole of it, and they are HERE rather than in the
// march because they are the classic pair that has to agree and that nothing checks: they lived as two
// literals inside CloudRaymarch.shader, which is not compiled as C++ and therefore could not be tested
// at all. Moved into this header they are driven by Desert/Tests/Engine/CloudGeometry, which asserts the
// RELATION below rather than the two values.
//
// The march spends the coarse step only where the answer is exactly zero — outside cloud, where any step
// size gives it correctly — and the fine step everywhere the medium has something in it. On the first
// coarse sample that finds material it steps BACK one coarse step and drops to fine, so the material
// between the last two coarse samples is not skipped; it climbs back out after
// CLOUD_EMPTY_FINE_SAMPLES_BEFORE_COARSE consecutive fine samples that find nothing.
//
// THE RELATION THAT HOLDS THE WHOLE THING UP: the number of empty fine samples must EXCEED the coarse
// multiplier. One excursion into the fine tier costs one coarse step backwards and buys that many fine
// steps forwards, so the net advance per cycle is (samples - multiplier) fine steps. At equality the
// march stands exactly still; below it, it walks backwards. Either way it burns its entire step budget
// without moving, and the symptom is not a wrong picture but a frame that costs its ceiling everywhere.
// ---------------------------------------------------------------------------------------------------

// How much longer the coarse step is than the fine one.
#define CLOUD_COARSE_STEP_MULTIPLIER 4.0f

// Consecutive fine samples with no profile after which the march returns to the coarse tier.
#define CLOUD_EMPTY_FINE_SAMPLES_BEFORE_COARSE 6

float CloudCoarseStepKm( float fineStepKm )
{
    return fineStepKm * CLOUD_COARSE_STEP_MULTIPLIER;
}

// ---------------------------------------------------------------------------------------------------
// WHAT THE MARCH CAN ACTUALLY FIND, which is a different number from what it can INTEGRATE
// ---------------------------------------------------------------------------------------------------
//
// The distinction was implicit and cost a defect. The fine step is the resolution the march integrates
// at; the COARSE step is the resolution it SEARCHES at, because outside cloud the ray strides by the
// coarse step and only drops to the fine tier once a coarse sample has already found material. A piece of
// cloud that fits entirely between two coarse samples is therefore never seen — not sampled coarsely, not
// found at all — and whether it fits depends on the ray's jitter, which is precisely the definition of
// speckle.
//
// So the chord the march can be relied on to find is TWO coarse steps, Nyquist against the search
// lattice, and this function is that statement. It exists so the relation can be asserted rather than
// remembered: Desert/Tests/Engine/CloudType holds every shipped `.decloudtype` against it, and if either
// side moves — a schedule constant here, a placement scale there — the test says so.
float CloudResolvableChordKm( float fineStepKm )
{
    return 2.0f * CloudCoarseStepKm( fineStepKm );
}

// The finest chord the schedule can resolve anywhere, which is the bound the library is calibrated
// against: a segment shorter than CLOUD_DISTANCE_TO_MAX_STEPS_KM is marched at that distance over the
// ceiling, and no ray is ever marched finer than that.
//
// @p maxCount is the component's Max Steps. It is a QUALITY TIER — an artist who lowers it is buying
// speed with resolution, deliberately — so the library is calibrated against the component's DEFAULT and
// this function takes the count rather than assuming it.
float CloudFinestResolvableChordKm( float maxCount )
{
    return CloudResolvableChordKm( CLOUD_DISTANCE_TO_MAX_STEPS_KM / max( maxCount, 1.0f ) );
}

// The distance the march advances over one complete excursion into the fine tier that finds nothing:
// one coarse step back, then a full run of fine steps before the tier flips again. It is the quantity
// the two constants above exist to keep POSITIVE, and it is a function so that the test drives the
// arithmetic the march performs rather than restating it.
float CloudTwoTierCycleAdvanceKm( float fineStepKm )
{
    return float( CLOUD_EMPTY_FINE_SAMPLES_BEFORE_COARSE ) * fineStepKm - CloudCoarseStepKm( fineStepKm );
}

#endif // CLOUD_GEOMETRY_GLSLH
