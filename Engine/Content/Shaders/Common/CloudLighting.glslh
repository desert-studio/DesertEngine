// The scattering maths of the cloud march: the phase function, Beer's law, the energy-conserving
// integration of one step, and the profile-driven ambient occlusion. Dual-compile dialect
// (Common/CloudNoise.glslh states the rules); driven as C++ by Desert/Tests/Engine/CloudLighting.
//
// This header owns the maths and nothing else. It has no samplers, no parameter block and no knowledge
// of how the light reached the sample — the march passes in radiance and gets back radiance, which is
// what lets the same functions serve the view ray, the light ray and the tests.

#ifndef CLOUD_LIGHTING_GLSLH
#define CLOUD_LIGHTING_GLSLH

#define CLOUD_PI 3.14159265358979323846f

// The phase function of a medium that has forgotten which way the light came from: energy spread evenly
// over the sphere. It is the limit the multiple-scattering octaves blend toward, because light that has
// bounced many times inside a cloud genuinely has no preferred direction left.
#define CLOUD_ISOTROPIC_PHASE ( 1.0f / ( 4.0f * CLOUD_PI ) )

// Henyey-Greenstein, the standard single-lobe phase. `g` in (-1, 1): positive scatters forward, which is
// what puts the bright rim on the cloud you are looking at through the sun.
//
// The denominator is floored. At g -> 1 and cosTheta -> 1 it goes to zero, and the unguarded pow(0, 1.5)
// is an infinity that propagates through the integral and lands as a permanently white pixel — the kind
// of defect that survives every unit test because it needs one exact alignment of view, sun and g.
float CloudPhaseHG( float cosTheta, float g )
{
    float gg    = clamp( g, -0.95f, 0.95f );
    float g2    = gg * gg;
    float denom = 1.0f + g2 - 2.0f * gg * cosTheta;
    return ( 1.0f - g2 ) / ( 4.0f * CLOUD_PI * pow( max( denom, 1e-4f ), 1.5f ) );
}

// TWO LOBES, blended — and the reason one is not enough is visible in every photograph of a cloud with
// the sun behind it. A single Henyey-Greenstein lobe has to be either strong, which lights the rim and
// leaves the body black, or weak, which lights the body and loses the rim. The pair does both: a sharp
// forward lobe carries the silver lining, a nearly isotropic one carries the body, and the blend decides
// how much of each.
//
// The blend is Unreal's arrangement — `HG(g1) + blend * (HG(g2) - HG(g1))` — and its shipped instance
// weights it toward the BODY: g 0.8, g2 0.1667, blend 0.575. That distribution is worth keeping when
// tuning: more than half the answer comes from the near-isotropic lobe, and the sharp one is a highlight
// on top rather than the main term.
float CloudPhaseDualLobe( float cosTheta, float forwardG, float backwardG, float blend )
{
    float forward  = CloudPhaseHG( cosTheta, forwardG );
    float backward = CloudPhaseHG( cosTheta, backwardG );
    return mix( forward, backward, clamp( blend, 0.0f, 1.0f ) );
}

// Beer-Lambert transmittance across a segment. Extinction is per kilometre and the distance is in
// kilometres, matching Common/CloudGeometry.glslh.
float CloudBeerTransmittance( float extinctionPerKm, float distanceKm )
{
    return exp( -max( extinctionPerKm, 0.0f ) * max( distanceKm, 0.0f ) );
}

// The energy-conserving integral of in-scattered radiance across one step, assuming the extinction and
// the in-scattered radiance are constant along it:
//
//     integral = (S - S * T) / sigma_t     with     T = exp(-sigma_t * dt)
//
// It matters that this is the closed form and not `S * dt`. The naive product over-brightens as the step
// grows, so a cloud's appearance would change with the step schedule — meaning it would change with
// distance from the camera and with the quality tier. Two tiers that disagree about how bright a cloud is
// are the same defect as two shaders that disagree about a constant, and it is just as invisible in a
// unit test of either one alone.
//
// The extinction is floored rather than special-cased at zero: the limit of the expression as sigma_t
// goes to zero is S * dt, and a floor of 1e-6 reproduces that to well inside half-float precision while
// keeping the function branchless.
vec3 CloudScatterIntegral( vec3 scattering, float extinctionPerKm, float stepKm )
{
    float sigma = max( extinctionPerKm, 1e-6f );
    float t     = exp( -sigma * max( stepKm, 0.0f ) );
    return ( scattering - scattering * t ) / sigma;
}

// ---------------------------------------------------------------------------------------------------
// THE MULTIPLE-SCATTERING SERIES — Wrenninge's octaves, as Unreal implements them
// ---------------------------------------------------------------------------------------------------
//
// WHY THIS LIVES HERE AND NOT IN THE MARCH. It was fifty lines inside CloudRaymarch.shader's inner loop
// until Р18, where nothing could reach it: the loop is the ONE part of the cloud lighting that no test
// could drive, so the two relations that bound it — that a step cannot scatter more light toward the eye
// than the source it integrates, and that more cloud between a sample and the sun means less light
// arrives — were unasserted while every simpler property beside them was tested twice. Moving it into
// this header compiles it as C++ with the rest (Desert/Tests/Engine/CloudLighting), which is the same
// reason CloudScatterIntegral is here rather than written out at its call site.
//
// THE MOVE IS NOT BIT-EXACT AND THE DIFFERENCE IS NAMED RATHER THAN GLOSSED. The loop used to multiply
// each octave's integral by the ray's transmittance and add it to the running luminance; it now sums the
// octaves first and the caller multiplies once, which is t*(a+b+c) against t*a + t*b + t*c. Measured on
// Clouds_Showcase, six points at 90 frames on a zero noise floor: 15 to 36 pixels of 980 480 differ, all
// of them by 1/255, bias zero, and the pattern is uncorrelated (coherence 0.50). Four independent
// renders of the new text reproduce each other exactly.
//
// WHAT IT APPROXIMATES. A cloud lit by single scattering alone is physically GREY: what makes a real one
// white is light that has bounced inside it many times. Measured against a converged Monte Carlo of a
// homogeneous lobe (the reference in Desert/Tests/Engine/CloudLighting), the first three scattering
// orders carry only 27 % of what reaches the eye at the shipped extinction and 16 % at a physical one —
// so this series is not "three orders", it is three TERMS standing in for all of them, and its weights
// are inflated accordingly.
//
// THE THREE FACTORS ARE NOT BUILT THE SAME WAY, and the difference is Unreal's rather than an
// inconsistency of ours. Scattering and extinction ACCUMULATE — each octave multiplies the previous
// octave's coefficient by the current step, and only then is the step squared, giving 1, c, c^3
// (VolumetricCloud.usf:388-393). The phase does NOT accumulate: every octave lerps from the BASE phase
// toward isotropic, and it is only the lerp factor that is squared, giving 1, p, p^2
// (VolumetricCloud.usf:422-429). Carrying the accumulating scheme over to the phase — which is what this
// loop used to do — gives the third octave p^3 instead of p^2, and at the shipped eccentricity of 0.18
// that is a weight of 0.0058 against 0.0324: six times closer to isotropic than the reference, which
// shows up as a cloud whose silver lining is missing from its third order.
//
// ONE SHADOW RAY SERVES EVERY OCTAVE. That is the whole economy of the scheme: the expensive part is
// finding how much material lies between a sample and the sun, and each order then reuses that number
// with its own extinction scale. @p opticalDepth is that one measurement.
//
// WHAT AN OCTAVE COSTS, measured by Р18 so the next person does not have to guess before proposing more
// of them. `Clouds: March` GPU self time out of the pass's own profiler line — never a frame-to-frame
// difference — on Clouds_ShadowsOnGround at a 320x192 trace, Debug/MoltenVK, three arms interleaved in
// one session on a SHARED machine and reported as the MINIMUM of four:
//
//     3 octaves, this file             14.395 ms   (spread 14.395 - 15.740, 9.3 %)
//     3 octaves, the loop written out  14.523 ms   (spread 14.523 - 14.852, 2.3 %)
//     1 octave,  this file             13.884 ms   (spread 13.884 - 14.587, 5.1 %)
//
// So moving the loop into this function costs NOTHING — the -0.128 ms is smaller than either arm's own
// spread — and an octave is 0.256 ms, 1.8 % of the pass, or 4.2 ns per ray. Six octaves would therefore
// be about +0.77 ms; Р18 measured that they make the picture WORSE and did not spend it.
//
// (The brief that set Р18 quoted 1.709 ms for this pass. The tree's own record is 12.695 ms for the same
// pass at the same trace size and build — VolumetricCloudRenderer.cpp:67 — and this measurement lands
// beside that one, not beside the brief's.)
//
// THE AMBIENT BELONGS TO THE FIRST ORDER ONLY. Unreal leaves it out of the octaves deliberately: the
// approximation carries no occlusion of its own, so feeding an unoccluded ambient into every order
// flattens the cloud into a uniform glow.

// The ceiling on the octave count, in ONE place because THREE of them agreed only by inspection: the
// slider's Range, the clamp in Graphic::PackCloudParams and the clamp here. This header cannot include
// the C++ constant, so Desert/Tests/Engine/SettingConsumers reads this line's text and fails if
// ECS::kCloudMultiScatterMaxOctaves ever parts company with it — the same arrangement, and for the same
// reason, as CLOUD_LIGHT_MARCH_MAX_SAMPLES's neighbour in CloudRaymarch.shader.
#define CLOUD_MAX_SCATTER_OCTAVES 3

// The series' parameters, unpacked from u_CloudMultiScatter once per pixel. A struct rather than four
// loose floats because the four are one calibration: the count decides how far the extinction ladder
// reaches, and changing it without the steps moves the deepest octave by a square.
struct CloudScatterSeries
{
    float Octaves;     // how many terms; clamped to CLOUD_MAX_SCATTER_OCTAVES
    float ScatterStep; // MultiScatterContribution — how much less each order scatters
    float ExtinctStep; // MultiScatterOcclusion    — how much less each order is absorbed
    float PhaseStep;   // MultiScatterEccentricity — how much directionality each order keeps
};

// The in-scattered radiance one sample contributes across one step, summed over the series.
//
// NOT attenuated by the ray's transmittance: that belongs to the ray's history and not to the medium, and
// keeping it out is what lets the bound below be stated at all ("this step cannot deliver more than the
// source it integrates" is false the moment the answer carries a factor from somewhere else).
//
// @p sunRadiance   the sun's radiance at the top of the shadow ray, unattenuated
// @p ambient       the sky's ambient radiance, already occluded by the caller's chosen geometry
// @p opticalDepth  material between this sample and the sun, measured ONCE at the base extinction
// @p phase         the base phase function evaluated at this ray's scattering angle
// @p sigmaT        this sample's own extinction, per kilometre
// @p albedo        the scattering albedo, PER COLOUR
// @p stepKm        the length of the step being integrated
//
// THE ALBEDO IS THE ONLY VECTOR QUANTITY OF THE MEDIUM, and the extinction beside it is deliberately not
// (O1_DESIGN.md §7.1, §9 п.2). That asymmetry is the whole reason this stays cheap: the extinction decides
// the OPTICAL DEPTH, which the shadow ray, the shadow map and the sky-occlusion volume all integrate as a
// scalar, so making it spectral would triple three separate marches. The albedo only ever multiplies an
// already-computed radiance, so a colour costs two more multiplies per octave and nothing else — Epic
// carry the same split, with `bGrayScaleMaterial` as the switch that collapses it.
//
// AND IT DOES NOT MIX THE CHANNELS. Every term below is either scalar or applied component-wise, so a
// coloured albedo is exactly three independent scalar runs — which is what Desert/Tests/Engine/CloudLighting
// asserts rather than assumes, because a stray dot() or a length() introduced here would look like a
// plausible tint and be a physical impossibility.
vec3 CloudMultiScatterStep( CloudScatterSeries series, vec3 sunRadiance, vec3 ambient, float opticalDepth,
                            float phase, float sigmaT, vec3 albedo, float stepKm )
{
    int count = int( clamp( series.Octaves, 1.0f, float( CLOUD_MAX_SCATTER_OCTAVES ) ) );

    float scatterFactor = 1.0f;
    float extinctFactor = 1.0f;
    float scatterStep   = clamp( series.ScatterStep, 0.0f, 1.0f );
    float extinctStep   = clamp( series.ExtinctStep, 0.0f, 1.0f );

    // UE's MsPhaseFactor. It starts at the authored step and is squared once per octave, and the octave
    // USES it directly rather than a running product of it. The first octave is the base phase itself,
    // which a factor of 1 expresses exactly.
    float phaseStep   = clamp( series.PhaseStep, 0.0f, 1.0f );
    float phaseFactor = 1.0f;

    vec3 luminance = vec3( 0.0f, 0.0f, 0.0f );

    for ( int octave = 0; octave < count; ++octave )
    {
        if ( octave > 0 )
        {
            scatterFactor *= scatterStep;
            extinctFactor *= extinctStep;

            scatterStep *= scatterStep;
            extinctStep *= extinctStep;

            phaseFactor = phaseStep;
            phaseStep *= phaseStep;
        }

        float octavePhase   = mix( CLOUD_ISOTROPIC_PHASE, phase, phaseFactor );
        float sunVisibility = exp( -opticalDepth * extinctFactor );

        vec3 inScatter = sunRadiance * ( sunVisibility * octavePhase );
        if ( octave == 0 )
            inScatter += ambient;

        float octaveExtinction = sigmaT * extinctFactor;
        // COMPONENT-WISE, and this one line is the whole numerical cost of the albedo becoming a colour.
        //
        // MEASURED, because the obvious guess was wrong. A grey albedo through the new text moves 0 to 3
        // pixels of 560 560 on the six protocol points, all by exactly 1/255, bias zero, coherence 0.499
        // — against a noise floor measured at 0. The first hypothesis was this expression's grouping
        // (floating-point multiplication is not associative): DISPROVED, `albedo * (sigmaT * scatterFactor)`
        // and `albedo * sigmaT * scatterFactor` render byte-identical frames, so the compiler normalises
        // them. Replacing `albedo` here with `albedo.x` — a scalar broadcast, which is what the code did
        // while the albedo was one float — restores byte-identity with the pre-change frame EXACTLY, on
        // every point. So the difference is the `vec3 * vec3` product itself, contracted differently by the
        // shader compiler from the `vec3 * float` it replaced, and nothing else in the change contributes:
        // not the new parameter slot, not the moved offsets, not the migrated material files.
        //
        // It is therefore unavoidable rather than untidy — a componentwise product IS the feature — and it
        // is a third of the 15-to-36-pixel difference this file's own note above already records for the
        // move that put this series here.
        vec3 scattering = inScatter * ( albedo * sigmaT * scatterFactor );

        luminance += CloudScatterIntegral( scattering, octaveExtinction, stepKm );
    }

    return luminance;
}

// Ambient occlusion from the dimensional profile: deck p.144, `pow(1 - dimensional_profile, 0.5)`.
//
// It is a geometric argument rather than a fitted curve. Most of the ambient light a cloud receives comes
// from the whole sky and penetrates only the surface, so the deeper inside the body a sample is, the less
// of that light reaches it — and the profile already IS the depth inside the body. Without this term the
// core of a three-kilometre cumulus is lit exactly as brightly as a wisp on its edge, which reads as a
// flat white cut-out no matter how good the silhouette is.
//
// @p strength blends toward no occlusion at 0, so the term is authorable without being removable by
// accident.
float CloudAmbientOcclusion( float profile, float strength )
{
    float occluded = pow( clamp( 1.0f - profile, 0.0f, 1.0f ), 0.5f );
    return mix( 1.0f, occluded, clamp( strength, 0.0f, 1.0f ) );
}

// ---------------------------------------------------------------------------------------------------
// SKY-LIGHT OCCLUSION BY THE CLOUD ABOVE THE SAMPLE — the quantity CloudAmbientOcclusion above CANNOT
// express, and the largest measured discrepancy in this sky (Docs/Clouds/DIAGNOSIS_CARTOON.md §1 #1/#2).
// ---------------------------------------------------------------------------------------------------
//
// THE PROBLEM, IN ONE SENTENCE. `Profile` is how deep a sample sits inside its OWN body, so a sample can
// never receive less than `mix(1, 0, strength)` of the whole sky's mean radiance however much OTHER cloud
// is stacked over it — at the shipped strength of 0.5 that floor is half the sky, and the visible surface
// (profile 0.576) receives 0.826 of it. Three kilometres of congestus overhead changes neither number.
// Р0 measured the consequence: deleting the ambient entirely moves contrast 0.202 -> 0.401 against the
// reference's 0.438 at 7 degrees — 84 % of the largest gap in the protocol — while the knob that exists
// to occlude it recovers 17 % there and 34 % at 42 degrees sunward. That split IS the signature: a local
// term bites where the occluder is the body itself and fails where the occluder is other cloud.
//
// WHAT REPLACES IT. A separate quantity — the optical depth of everything above the sample, integrated
// straight up — produced into a volume by Programs/Clouds/CloudSkyOcclusionVolume.shader and read back
// here. The three steps below are the whole of the maths: how a VERTICAL optical depth becomes a
// HEMISPHERICAL transmittance, how that hemisphere is composed back into the SPHERE the ambient is a mean
// over, and how the artist's strength blends the result in. The middle step is not optional bookkeeping —
// leaving it out is what made the deck go brown at full strength (see CloudSkyOcclusion).

// THE EXPONENTIAL INTEGRAL E1, Abramowitz & Stegun 5.1.53 (x <= 1, |error| < 2e-7) and 5.1.56 (x >= 1,
// |error| < 5e-5 in `x e^x E1(x)`). Its only caller is the transmittance below.
//
// GUARDED AT ZERO because E1 diverges there. The caller multiplies it by x*x, so the limit of the product
// is 0 and returning 0 reproduces it exactly — where the divergence itself would be an infinity times a
// zero, and a NaN transmittance is a black hole in the layer that no unit test of either half would find.
float CloudExpIntegralE1( float x )
{
    if ( x <= 0.0f )
        return 0.0f;

    if ( x <= 1.0f )
    {
        float series =
             -0.57721566f +
             x * ( 0.99999193f +
                   x * ( -0.24991055f + x * ( 0.05519968f + x * ( -0.00976004f + x * 0.00107857f ) ) ) );
        return series - log( x );
    }

    float numerator   = x * x + 2.334733f * x + 0.250621f;
    float denominator = x * x + 3.330657f * x + 1.681534f;
    return exp( -x ) * numerator / ( x * denominator );
}

// The fraction of the sky's mean radiance that survives @p verticalOpticalDepth of cloud overhead.
//
// THE SKY IS A HEMISPHERE AND THIS VOLUME STORES ONE NUMBER PER COLUMN, so the conversion from "how much
// cloud is straight up" to "how much of the sky is visible" is where the geometry is put back. For a
// horizontally uniform slab a ray leaving at zenith angle acos(mu) crosses tau/mu of material, and the
// cosine-weighted hemispherical transmittance is exactly
//
//     T(tau) = 2 * integral(0..1) mu * exp(-tau / mu) dmu = 2 * E3(tau)
//            = exp(-tau) * (1 - tau) + tau^2 * E1(tau)
//
// and that identity is what is evaluated here. Desert/Tests/Engine/CloudLighting integrates the left-hand
// side numerically and asserts the two agree to a fraction of a per cent.
//
// WHY NOT THE DIFFUSIVITY FACTOR. Radiative transfer's usual shortcut is one slant path at a fixed
// effective secant of 1.66, and it was written here first. The suite measured it at up to 27 % off over
// the range where the term is still visible, and — the part that decided it — the error CHANGES SIGN
// around tau 0.4: brighter than the truth below, darker above. A one-constant approximation whose error
// reverses in the middle of its working range is the shape of thing that gets "corrected" later by moving
// an artist's slider on one camera angle. The exact form costs about fifteen extra ALU ops and is
// evaluated ONCE PER TEXEL of the volume rather than at every one of the march's samples, which is
// exactly why it is affordable here and would not have been in the march.
//
// WHAT IS STILL AN APPROXIMATION: the slab. A slant ray through a FINITE cumulus exits its side long
// before it has crossed tau/mu, so real broken cloud occludes LESS than this says. The term is therefore
// biased dark and the bias grows with how broken the sky is. Its magnitude is still unmeasured — no
// converged reference for hemispherical occlusion over broken cloud exists in this repository — so what
// is claimed here is the DIRECTION only.
//
// THIS SENTENCE USED TO END "and the artist's strength below is what pulls it back", and that was the
// defect Р7 found rather than a description of one. A strength that has to be held at 0.5 to keep a
// modelling error out of the frame is a knob hiding a defect, and it is why the dial could not be raised:
// the frame went brown at 1.0. The pull-back now belongs to CloudSkyOcclusion, which composes this
// HEMISPHERE into the SPHERE the ambient is a mean over instead of scaling one by the other. The strength
// is an art dial again, and the slab bias is a bounded second-order error on top of a first-order
// composition that is now correct.
float CloudSkyDiffuseTransmittance( float verticalOpticalDepth )
{
    float tau = max( verticalOpticalDepth, 0.0f );
    return clamp( exp( -tau ) * ( 1.0f - tau ) + tau * tau * CloudExpIntegralE1( tau ), 0.0f, 1.0f );
}

// THE SHARE OF THE SPHERE THIS VOLUME CAN SPEAK FOR. The volume integrates material ABOVE a sample
// (Programs/Clouds/CloudSkyOcclusionVolume.shader walks the column from the top of the shell downward),
// and CloudSkyDiffuseTransmittance above converts that into an UPPER-HEMISPHERE transmittance. The
// quantity it is applied to is the FULL-SPHERE mean sky radiance — CloudRaymarch.shader reads
// SKY_DISTANT_LIGHT_SPHERE_TEXEL, and says in as many words that a cloud is lit from every direction at
// once. Half of those directions point DOWN, and nothing this volume knows about occludes them.
//
// ONE HALF, AND WHERE THAT NUMBER COMES FROM — read this before changing it. What the term wants is
//
//     f = integral L(w) T(w) dw / integral L(w) dw
//
// and the shader does not have L(w). It has ONE texel, the mean over the whole sphere
// (Graphic::kDistantLightWidth is 1), so every possible value of this constant is a statement about an
// angular distribution nobody here can see. The previous form chose the most extreme statement available
// — that ALL the ambient arrives from above — and that is what drove the multiplier to zero.
//
// One half is the value, and the ONLY value, that the available information supports: with nothing known
// about L beyond its mean, the hemispheres are two equal solid angles carrying equal shares. It is
// therefore not a fitted constant and must not be tuned into one; it is what "we know the mean and
// nothing else" evaluates to. The bound it enforces is what actually matters and holds for any true
// split w: f lies in [w, 1] and is exactly 1 when nothing is overhead. Zero satisfied neither.
//
// WHAT WOULD REPLACE IT WITH A MEASUREMENT, stated so the next person does not re-derive it: a SECOND
// texel in the distant sky light holding the UPPER hemisphere's own mean, from which
// w = 1 - L_upper / (2 * L_sphere) falls out on the GPU with no assumption at all. The 8x8 direction grid
// SkyDistantLight already walks is 32 up and 32 down, so the sum is already half-computed; what it costs
// is one more lane of groupshared reduction and one more texel of a 1xN image. That is
// Programs/Sky/SkyDistantLight.shader, Common/SkyScattering.glslh and Graphic::kDistantLightWidth — the
// SKY's files, not the cloud's, which is why Р7 did not do it.
#define CLOUD_SKY_LOWER_HEMISPHERE 0.5f

// The occlusion multiplier the march applies to the ambient term, from the transmittance the volume
// stores. @p strength is the SAME AmbientOcclusionStrength that drives CloudAmbientOcclusion — one knob
// with one meaning ("how strongly the sky light is occluded"), and the component's flag chooses only
// WHICH geometry computes it, so neither field goes dead when the other is in use.
//
// THE HEMISPHERE SPLIT, and why the term read `mix(1, T, strength)` before. Multiplying the full sphere
// by T asserts that a sample under three kilometres of congestus receives no sky light from ANY
// direction, including the open lower half it can see straight down into. At the shipped extinction of
// 8/km that assertion is not academic: the deck's own optical depth drives T to ~1e-7, and Р7 measured
// 74.5 % of the visible deck below an ambient multiplier of 0.10 at strength 1.0, with 0.03 % below
// 0.02. The sky light is not attenuated there, it is ANNIHILATED — and what remains is the sun term,
// whose colour is SunIlluminanceOnGround, the atmospherically reddened sun. That is the brown: the shade
// was not tinted warm, it had its only cool contributor deleted. Measured on Clouds_Protocol at 7
// degrees away from the sun, the deck's B/R runs 1.083 shipped -> 0.884 at strength 1.0, against 0.859
// with the ambient removed outright — 88.8 % of the whole displacement the term is capable of.
//
// WHAT THIS DOES TO THE DIAL, because it is not obvious and the owner is choosing on it. The old term was
// `1 - s(1 - T)` and the new one is `1 - (s/2)(1 - T)`, so strength s now buys exactly what s/2 used to:
// Р7 rendered strength 1.0 through this function and got a frame IDENTICAL IN EVERY CHANNEL to the
// shipped 0.5. The consequence is worth saying out loud rather than leaving to be discovered — the deep
// shading that made the 1.0 frame's lobes read as solid volumes was the sky light being DELETED, not a
// better-modelled cloud, and it is not reachable without the brown that came with it. A real cumulus
// underside is grey-blue because it is weakly occluded and sees most of the sky; the term that darkens it
// past that point is not modelling anything.
//
// WHY THIS IS NOT THE PROFILE TERM'S PROBLEM TOO. CloudAmbientOcclusion floors at zero and that is
// correct for it: `Profile` measures depth inside the sample's OWN body, which surrounds it on every
// side, so a sample in the core genuinely is shut off from the whole sphere. The two floors differ
// because the two geometries differ, which is the same reason the flag chooses between them.
//
// WHAT IS STILL AN APPROXIMATION. The lower hemisphere is left fully open. Cloud BELOW a sample does
// occlude it, and this volume does not carry that number — it accumulates downward, so at any slice it
// holds only what is overhead. The error is therefore one-sided and bounded: this can be too BRIGHT
// deep inside a body, never too dark, where the form it replaces could only ever be too dark. The
// visible underside of a deck, which is what a ground camera sees and what this feature exists for, has
// open air beneath it and is the case the split is exact for.
float CloudSkyOcclusion( float skyTransmittance, float strength )
{
    float sphere = CLOUD_SKY_LOWER_HEMISPHERE +
                   ( 1.0f - CLOUD_SKY_LOWER_HEMISPHERE ) * clamp( skyTransmittance, 0.0f, 1.0f );

    return mix( 1.0f, sphere, clamp( strength, 0.0f, 1.0f ) );
}

// ---------------------------------------------------------------------------------------------------
// THE VOLUME ITSELF — its extents, and where a sample lands in it
// ---------------------------------------------------------------------------------------------------
//
// IT SHARES THE PROCEDURAL MODELLING VOLUME'S FRAME EXACTLY: the same region origin, the same side, the
// same wind shift, the same REPEAT horizontally (Common/CloudField.glslh, CloudProceduralVolumeUvw). That
// is the one design decision in this feature and it is what kills the seam an earlier attempt had.
//
// THE SEAM IT AVOIDS. Docs/Sky/HANDOVER.md §1 item 3 records a version of this that projected the SUN-space
// shadow map onto the vertical, and its third fault was that the shadow map's footprint is a 30 km radius
// square snapped to the camera — so the term was ZERO outside it, and at 7 degrees of elevation the
// protocol's own ray runs from 18.29 km to 47.27 km through the shell, which is mostly OUTSIDE. The
// elevation where the discrepancy is largest is exactly the elevation a camera-snapped square cannot
// reach. The modelling volume's region has no outside at all: the bake splats every lump at its wrapped
// positions, so the field is EXACTLY periodic over the region and "past the footprint" is the same sky
// again — the identical degenerate far path the profile fetch beside it already takes.
//
// HALF THE MODELLING VOLUME ON EVERY AXIS (256 x 32 x 256 -> 128 x 16 x 128), and the halving is a
// relation rather than a size: what this volume stores is a HEMISPHERICAL integral, whose own horizontal
// footprint is the height of the cloud above the sample — kilometres — so a texel finer than the layer is
// thick stores structure the quantity does not have. At the shipped 48 km region a texel is 375 m against
// a 3.6 km deck, still an order inside it. Desert/Tests/Engine/CloudLighting asserts the relation.
#define CLOUD_SKY_OCCLUSION_RESOLUTION 128.0f
#define CLOUD_SKY_OCCLUSION_SLICES 16.0f

// Where a sample lands in the volume. @p windPos is the WIND-SHIFTED position the field itself is
// evaluated at (Common/CloudField.glslh builds it), so this addresses the same frame the profile does and
// the two cannot drift; @p heightFraction is the sample's own normalised altitude in the shell, which the
// march already holds.
//
// VERTICALLY CLAMPED TO THE TEXEL CENTRES for the reason CloudProceduralVolumeUvw gives at its own clamp:
// every sampler in this engine is REPEAT, and a height fraction of 1 would otherwise wrap to the bottom
// slice — so the top of the layer would be told the whole deck is above it.
vec3 CloudSkyOcclusionUvw( vec2 regionOriginKm, float invRegionSizeKm, float heightFraction, vec3 windPos )
{
    float halfV = 0.5f / CLOUD_SKY_OCCLUSION_SLICES;

    return vec3( ( windPos.x - regionOriginKm.x ) * invRegionSizeKm,
                 clamp( heightFraction, halfV, 1.0f - halfV ),
                 ( windPos.z - regionOriginKm.y ) * invRegionSizeKm );
}

#endif // CLOUD_LIGHTING_GLSLH
