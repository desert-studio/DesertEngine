// The cloud noise library: periodic, seeded, and written ONCE in a dialect that compiles both as GLSL
// (inside the cloud passes) and as C++ (by Desert/Tests/Engine/CloudNoise and by the offline volume
// generator, Engine/Graphic/Clouds/CloudNoiseGenerator.cpp). The tests therefore drive the exact text
// the generator runs rather than a CPU re-implementation of it, which is the only arrangement in which
// "the test passes" says anything about the picture.
//
// WHO EVALUATES THIS AND WHO DOES NOT. Since the volume became an asset, NOTHING evaluates these
// functions on the GPU: the march samples a 3D texture and the arithmetic runs once, offline, in the
// generator. The dialect is kept all the same, because the file's other reader is the test suite that
// compiles it as C++, and because `CloudRemap` below IS still compiled as GLSL by Common/CloudField.glslh.
//
// PERIODICITY IS STRUCTURAL, not a property we hope for. Every lattice index is wrapped into the period
// BEFORE it is hashed, so the field tiles exactly at the period for every seed and every octave. A noise
// that only almost tiles shows as a seam running the length of the sky, and no amount of tuning removes
// it.
//
// THE HASH IS AN INTEGER FINALIZER, not `fract(sin(dot(...)))`. The trigonometric hash is
// implementation-defined at the precision where it matters, differs between drivers, and — the reason it
// is banned here rather than merely discouraged — differs between the GPU and the CPU, which would make
// the C++ test above assert against numbers the shader never produces.
//
// DIALECT RULES (shared with Common/SkyMedium.glslh and enforced by the fact that this file is compiled
// as C++): no swizzles beyond .x/.y/.z, no `out` parameters, no arrays, no `inline`, no namespaces;
// float literals carry the `f` suffix; a struct is returned through a named local with per-field
// assignment; every function is defined before it is used, because GLSL has no forward declarations.

#ifndef CLOUD_NOISE_GLSLH
#define CLOUD_NOISE_GLSLH

// ---------------------------------------------------------------------------------------------------
// Integer hash
// ---------------------------------------------------------------------------------------------------

// The MurmurHash3 32-bit finalizer. Chosen because its avalanche is measured rather than asserted: one
// flipped input bit changes every output bit with probability ~0.5, which is what makes neighbouring
// lattice cells uncorrelated. The three constants are Appleby's and are not interchangeable with
// arbitrary large odd numbers.
uint CloudHashFinalize( uint h )
{
    h = h ^ ( h >> 16u );
    h = h * 0x85EBCA6Bu;
    h = h ^ ( h >> 13u );
    h = h * 0xC2B2AE35u;
    h = h ^ ( h >> 16u );
    return h;
}

// Hashes a lattice cell. The three odd primes are pairwise coprime so that the x, y and z contributions
// cannot alias onto one another along a diagonal — a cheaper combiner shows as visible structure running
// at 45 degrees through the noise.
uint CloudHashCell( uint x, uint y, uint z, uint seed )
{
    uint h = seed * 0x9E3779B1u;
    h = h + x * 0x27D4EB2Du;
    h = h + y * 0x85EBCA77u;
    h = h + z * 0xC2B2AE3Du;
    return CloudHashFinalize( h );
}

// Wraps a lattice coordinate into [0, period) as an unsigned index. `mod` is used rather than a cast
// because the cast truncates toward zero and would fold -0.5 and +0.5 onto the same cell, putting a
// mirror seam through the origin. glm::mod and GLSL mod agree on x - y*floor(x/y), which is
// non-negative for a positive period.
uint CloudWrapIndex( float coordinate, float period )
{
    return uint( mod( floor( coordinate ), period ) );
}

// ---------------------------------------------------------------------------------------------------
// Periodic improved Perlin noise
// ---------------------------------------------------------------------------------------------------

// Perlin's quintic fade, 6t^5 - 15t^4 + 10t^3. Its first AND second derivatives vanish at 0 and 1, which
// is why the classic cubic (3t^2 - 2t^3) is not used here: the cubic's second derivative is discontinuous
// at the lattice planes, and that discontinuity is directly visible as a faint grid once the noise is
// used as an erosion threshold.
float CloudFade( float t )
{
    return t * t * t * ( t * ( t * 6.0f - 15.0f ) + 10.0f );
}

// Perlin's gradient selector: the hash picks one of twelve edge-of-cube directions and returns its dot
// product with the offset. Written with ternaries rather than a lookup table because the dialect forbids
// arrays — the arithmetic is Perlin's own and produces the same twelve gradients.
float CloudGradientDot( uint h, float x, float y, float z )
{
    uint  bits = h & 15u;
    float u    = bits < 8u ? x : y;
    float v    = bits < 4u ? y : ( ( bits == 12u || bits == 14u ) ? x : z );
    float su   = ( bits & 1u ) == 0u ? u : -u;
    float sv   = ( bits & 2u ) == 0u ? v : -v;
    return su + sv;
}

// Improved Perlin noise that tiles exactly with @p period lattice cells on every axis.
//
// Returns roughly [-1, 1]; the theoretical bound of 3D Perlin is +-sqrt(3)/2 but the practical range is
// narrower, so callers that need [0, 1] should remap and saturate rather than assume.
float CloudPerlinPeriodic( vec3 position, float period, uint seed )
{
    float x0f = floor( position.x );
    float y0f = floor( position.y );
    float z0f = floor( position.z );

    float fx = position.x - x0f;
    float fy = position.y - y0f;
    float fz = position.z - z0f;

    uint x0 = CloudWrapIndex( x0f, period );
    uint y0 = CloudWrapIndex( y0f, period );
    uint z0 = CloudWrapIndex( z0f, period );
    uint x1 = CloudWrapIndex( x0f + 1.0f, period );
    uint y1 = CloudWrapIndex( y0f + 1.0f, period );
    uint z1 = CloudWrapIndex( z0f + 1.0f, period );

    float ux = CloudFade( fx );
    float uy = CloudFade( fy );
    float uz = CloudFade( fz );

    float g000 = CloudGradientDot( CloudHashCell( x0, y0, z0, seed ), fx, fy, fz );
    float g100 = CloudGradientDot( CloudHashCell( x1, y0, z0, seed ), fx - 1.0f, fy, fz );
    float g010 = CloudGradientDot( CloudHashCell( x0, y1, z0, seed ), fx, fy - 1.0f, fz );
    float g110 = CloudGradientDot( CloudHashCell( x1, y1, z0, seed ), fx - 1.0f, fy - 1.0f, fz );
    float g001 = CloudGradientDot( CloudHashCell( x0, y0, z1, seed ), fx, fy, fz - 1.0f );
    float g101 = CloudGradientDot( CloudHashCell( x1, y0, z1, seed ), fx - 1.0f, fy, fz - 1.0f );
    float g011 = CloudGradientDot( CloudHashCell( x0, y1, z1, seed ), fx, fy - 1.0f, fz - 1.0f );
    float g111 = CloudGradientDot( CloudHashCell( x1, y1, z1, seed ), fx - 1.0f, fy - 1.0f, fz - 1.0f );

    float x00 = mix( g000, g100, ux );
    float x10 = mix( g010, g110, ux );
    float x01 = mix( g001, g101, ux );
    float x11 = mix( g011, g111, ux );

    float y0i = mix( x00, x10, uy );
    float y1i = mix( x01, x11, uy );

    return mix( y0i, y1i, uz );
}

// The remap every cloud paper writes inline and every implementation eventually gets wrong at the
// degenerate end. Defined once, with the division guarded: originalMin == originalMax is one hand-edited
// scene away, and an unguarded version turns the whole layer into NaN, which reads as a black sky.
float CloudRemap( float value, float originalMin, float originalMax, float newMin, float newMax )
{
    float t = ( value - originalMin ) / max( originalMax - originalMin, 1e-6f );
    return newMin + clamp( t, 0.0f, 1.0f ) * ( newMax - newMin );
}

// ---------------------------------------------------------------------------------------------------
// Periodic Alligator noise
// ---------------------------------------------------------------------------------------------------
//
// WHY THIS AND NOT WORLEY, which is what stood here before. Guerrilla state the reason in their own words
// (Nubis Cubed, SIGGRAPH 2023, deck p.95): "we used inverted Worley noise to create billowy details, but
// we had to do quite a lot of layering and work in the sampler to get something that looked like cloud
// billows as opposed to PACKED SPHERES. This time we decided to use Houdini's Alligator noise, which looks
// very much like our layered Worley noise but with more appropriate cloud-like LACUNARITY to these
// structures." The lacunarity is the difference and it is structural, not a matter of tuning: inverted
// Worley gives every cell the same peak value, so the field is a lattice of equal spheres; Alligator gives
// each feature point its own amplitude and subtracts the runner-up, so lobes come in a range of sizes with
// creases between them.
//
// THE ALGORITHM IS NOT IN THE DECK. Slide 96 names the noise, shows the four channels and links the source
// instead of printing it: "Alligator Noise Code (via SideFX),
// https://www.sidefx.com/docs/hdk/alligator_2alligator_8_c-example.html". That HDK example is the
// definition followed here, and it is four steps:
//
//   1. one feature point per lattice cell, at a hashed offset inside the cell;
//   2. each feature point carries its OWN hashed amplitude — this is the part Worley does not have;
//   3. a radial basis with unit radius, `smoothstep`'s own polynomial: rbf(d) = (1-d)^2 * (3 - 2*(1-d));
//   4. the value is the LARGEST weighted contribution MINUS the second largest.
//
// Step 4 is what puts the creases in. Where two feature points contribute equally the two largest cancel
// and the field is 0, so cell boundaries are zero-valued seams; near a feature point one contribution
// dominates and the field rises to that point's amplitude. Inverted, those seams become the web the deck
// describes as the starting point for the wispy channel.
//
// The 3x3x3 neighbourhood is exact rather than an approximation: an offset lies inside its own cell, so a
// point two cells away is at least one cell distant and the unit-radius basis is already zero there.
float CloudAlligator( vec3 position, float period, uint seed )
{
    float x0f = floor( position.x );
    float y0f = floor( position.y );
    float z0f = floor( position.z );

    float best   = 0.0f;
    float second = 0.0f;

    for ( int dz = -1; dz <= 1; ++dz )
    {
        for ( int dy = -1; dy <= 1; ++dy )
        {
            for ( int dx = -1; dx <= 1; ++dx )
            {
                float cx = x0f + float( dx );
                float cy = y0f + float( dy );
                float cz = z0f + float( dz );

                uint h = CloudHashCell( CloudWrapIndex( cx, period ), CloudWrapIndex( cy, period ),
                                        CloudWrapIndex( cz, period ), seed );

                // The offset comes from three disjoint ten-bit slices of one hash. Safe HERE because the
                // finalizer's avalanche is MEASURED (see the suite): its bits are mutually independent, so
                // three slices are as uncorrelated as three separate hashes at a third of the cost.
                float ox = float( h & 1023u ) * ( 1.0f / 1024.0f );
                float oy = float( ( h >> 10u ) & 1023u ) * ( 1.0f / 1024.0f );
                float oz = float( ( h >> 20u ) & 1023u ) * ( 1.0f / 1024.0f );

                // The amplitude needs its OWN hash rather than the two bits left over above: those two bits
                // would give four amplitudes for the whole volume, which is not lacunarity, it is banding.
                // Re-finalizing the cell hash is cheaper than hashing the cell again and, the avalanche
                // being what it is, just as independent of the ten-bit slices already spent.
                uint  ha        = CloudHashFinalize( h ^ 0x68BC21EBu );
                float amplitude = float( ha & 0xFFFFu ) * ( 1.0f / 65535.0f );

                float px = cx + ox - position.x;
                float py = cy + oy - position.y;
                float pz = cz + oz - position.z;

                float d = sqrt( px * px + py * py + pz * pz );
                if ( d < 1.0f )
                {
                    // SideFX's radial basis, verbatim: smooth(1-d) with smooth(t) = t*t*(3 - 2*t).
                    float t     = 1.0f - d;
                    float value = amplitude * t * t * ( 3.0f - 2.0f * t );

                    // Two running maxima rather than a sort: the algorithm needs the top two and nothing
                    // else, and a 27-element sort in a dialect without arrays is not expressible anyway.
                    if ( value > best )
                    {
                        second = best;
                        best   = value;
                    }
                    else if ( value > second )
                    {
                        second = value;
                    }
                }
            }
        }
    }

    return best - second;
}

// The [0, 1] form. MEASURED, exactly like every other range constant in this file and for the same reason:
// the difference of the two largest contributions is mostly small, and a field whose 99th percentile sits
// well below 1 cannot cut a cloud open however hard the erosion strength is driven. The raw field measures
// min 0.000 / p01 0.001 / p50 0.117 / p99 0.700 / max 0.952 over a 48^3 grid at period 4, so the window is
// its own p01..p99 and the suite prints those numbers and asserts that the remapped field still reaches
// both ends — a change to the amplitude or the basis therefore fails here rather than in a frame six
// weeks later.
//
// THE HISTOGRAM IS SKEWED BY CONSTRUCTION and has to be stated, not left to be discovered. The difference
// of the two largest contributions is near zero over most of space — that IS the noise, it is what "billows
// as opposed to packed spheres" (deck p.95) means numerically, and it is exactly the asymmetry inverted
// Worley does not have. Linearly remapped, the field measures p01 0.001 / p25 0.057 / p50 0.152 / p75 0.324
// / p99 0.927 over a 64^3 grid at period 6.
//
// (Those figures are the raw field at period 6; the shipped volume's coarser periods narrow the tails a
// little without moving the middle, which is what the suite prints and pins.)
//
// AND A FIELD THIS SKEWED CANNOT BE THRESHOLDED BY A SLIDER CALIBRATED AGAINST A SYMMETRIC ONE. Every
// consumer of this volume compares it against a number: the coverage threshold, the erosion depth, the type
// variance. The four channels it replaces measured a median of 0.48 to 0.53 apiece, and every default and
// every documented table in the component was measured against that. Dropped in unshaped, the wispy pair
// (which is one minus this field) carries a median of 0.83, and the FIRST FRAME rendered was a solid
// overcast ceiling at a Coverage of 0.25 whose documented meaning is scattered cumulus — not because the
// noise was wrong but because the slider was now reading a different part of the distribution.
//
// So the exponent below, and it is the only honest way to fix that: it is MONOTONE, so it does not move a
// single level set — the silhouettes, the webs and the lobes are bit for bit the ones the Alligator
// produces — it only relabels the values so that the median lands at 0.5 where every consumer expects it.
// The character of the noise is the change we wanted; the calibration of the slider is not.
//
// 0.367 = ln(0.5)/ln(0.152), the one number that puts the measured median at the middle. Afterwards the
// field measures p01 0.089 / p25 0.348 / p50 0.500 / p75 0.661 / p99 0.972, against 0.000 / 0.310 / 0.479 /
// 0.654 / 1.000 for the inverted-Worley channel it replaces — the same calibration, a different shape.
#define CLOUD_ALLIGATOR_LOW          0.0f
#define CLOUD_ALLIGATOR_HIGH         0.70f
#define CLOUD_ALLIGATOR_MEDIAN_SHAPE 0.367f

float CloudAlligator01( vec3 position, float period, uint seed )
{
    float linear = clamp( CloudRemap( CloudAlligator( position, period, seed ), CLOUD_ALLIGATOR_LOW,
                                      CLOUD_ALLIGATOR_HIGH, 0.0f, 1.0f ),
                          0.0f, 1.0f );

    return pow( linear, CLOUD_ALLIGATOR_MEDIAN_SHAPE );
}

// ---------------------------------------------------------------------------------------------------
// Curl noise
// ---------------------------------------------------------------------------------------------------

// The curl of a vector potential built from three decorrelated Perlin fields. Being a curl, it is
// DIVERGENCE-FREE by construction — the field neither creates nor destroys volume — and that is the whole
// reason to use it rather than three independent noises as an offset: a divergent offset field pulls the
// material apart into holes, while a divergence-free one shears it, which is what turns a smooth edge
// into the wisps and hooks that a real cloud has where the air is moving past it.
//
// Central differences at a fixed epsilon rather than analytic derivatives: the potential is a fractal sum
// and its analytic gradient is neither cheaper nor more accurate at this scale. The epsilon is a
// hundredth of a lattice cell — small enough to be a derivative, large enough to stay clear of float
// cancellation in the subtraction.
vec3 CloudCurl( vec3 position, float period, uint seed )
{
    float e = 0.01f;

    // Three potential components, decorrelated by seed rather than by offsetting the position: an offset
    // large enough to decorrelate would break the periodicity that the whole tiling scheme depends on.
    float p1yPlus  = CloudPerlinPeriodic( vec3( position.x, position.y + e, position.z ), period, seed );
    float p1yMinus = CloudPerlinPeriodic( vec3( position.x, position.y - e, position.z ), period, seed );
    float p1zPlus  = CloudPerlinPeriodic( vec3( position.x, position.y, position.z + e ), period, seed );
    float p1zMinus = CloudPerlinPeriodic( vec3( position.x, position.y, position.z - e ), period, seed );

    float p2xPlus  = CloudPerlinPeriodic( vec3( position.x + e, position.y, position.z ), period, seed + 1319u );
    float p2xMinus = CloudPerlinPeriodic( vec3( position.x - e, position.y, position.z ), period, seed + 1319u );
    float p2zPlus  = CloudPerlinPeriodic( vec3( position.x, position.y, position.z + e ), period, seed + 1319u );
    float p2zMinus = CloudPerlinPeriodic( vec3( position.x, position.y, position.z - e ), period, seed + 1319u );

    float p3xPlus  = CloudPerlinPeriodic( vec3( position.x + e, position.y, position.z ), period, seed + 2633u );
    float p3xMinus = CloudPerlinPeriodic( vec3( position.x - e, position.y, position.z ), period, seed + 2633u );
    float p3yPlus  = CloudPerlinPeriodic( vec3( position.x, position.y + e, position.z ), period, seed + 2633u );
    float p3yMinus = CloudPerlinPeriodic( vec3( position.x, position.y - e, position.z ), period, seed + 2633u );

    float inv2e = 1.0f / ( 2.0f * e );

    float cx = ( ( p3yPlus - p3yMinus ) - ( p2zPlus - p2zMinus ) ) * inv2e;
    float cy = ( ( p1zPlus - p1zMinus ) - ( p3xPlus - p3xMinus ) ) * inv2e;
    float cz = ( ( p2xPlus - p2xMinus ) - ( p1yPlus - p1yMinus ) ) * inv2e;

    return vec3( cx, cy, cz );
}

// Curly-Alligator, and it is the deck's construction in the deck's own order (p.95): "we started with
// INVERTED alligator noise, which creates nice web like shapes, and then DISTORTED it using curl noise. We
// call this Curly-Alligator noise."
//
// Both halves are load-bearing. The inversion turns the Alligator's zero-valued cell seams into ridges, so
// the field reads as a web of filaments rather than as a scatter of lobes — the wispy end of the erosion,
// which is what the deck says Perlin-Worley was not pure enough to supply. The curl then shears that web
// sideways along a DIVERGENCE-FREE flow: a divergent offset field would pull the filaments apart into
// holes, while a divergence-free one drags them, which is what turns a straight strand into the hooks a
// real cloud edge has where air is moving past it.
//
// The distortion is applied to the SAMPLE POSITION, not to the value, which is why the result is still a
// periodic field: the curl potential shares the period, so a shift by one period moves the flow and the
// alligator lattice by exactly the same amount.
float CloudCurlyAlligator01( vec3 position, float period, uint seed, float strength )
{
    vec3 flow = CloudCurl( position, period, seed + 5051u );

    vec3 sheared = vec3( position.x + flow.x * strength, position.y + flow.y * strength,
                         position.z + flow.z * strength );

    return 1.0f - CloudAlligator01( sheared, period, seed );
}

// ---------------------------------------------------------------------------------------------------
// The volume
// ---------------------------------------------------------------------------------------------------

// THE FOUR CHANNELS OF THE CLOUD NOISE VOLUME, in one place, written once.
//
// The layout is the deck's (p.96), channel for channel: "The first two channels are low and high frequency
// Curly-Alligator noise and the last two are Low and High frequency Alligator Noise."
//
//   R  Curly-Alligator, low  frequency   WISPY, coarse   — also the coarse coverage field
//   G  Curly-Alligator, high frequency   WISPY, fine     — also the coverage field's edge roughening
//   B  Alligator,       low  frequency   BILLOWY, coarse — the erosion of a heaped cloud
//   A  Alligator,       high frequency   BILLOWY, fine   — the erosion of a flat sheet
//
// The deck's own volume is 128^3 with four channels (p.96) and ours is the same resolution in RGBA8,
// 8 MiB — which is also UE's arrangement for `Noise_Texture3D`, "each color channel describes a different
// noise pattern" (UEReference/Documentation/EpicDoc_CloudMaterial.md section 4). The one place we differ
// from UE is that our alpha IS used; UE's is not, and a channel nobody reads is a quarter of the bandwidth
// of every sample in the march paid forever.
//
// WHY THIS IS A FUNCTION AND NOT FOUR CALLS AT THE CALL SITE. It has exactly two callers — the offline
// generator that writes the volume and the field test that reads a volume it did not bake — and they are
// obliged to agree channel for channel. Written twice, they agree until the first tuning pass.
//
// The periods are lattice cells across the unit cube and must divide it a whole number of times, or REPEAT
// sampling puts a seam through the sky. They are parameters rather than constants because they are what an
// artist changes to get a different edge: the same four noises at half the period is a different cloud.
//
// ---------------------------------------------------------------------------------------------------
// EACH CHANNEL IS ONE OCTAVE, AND A FRACTAL ONE WAS MEASURED AND REFUSED — task Р10, 2026-08-28
// ---------------------------------------------------------------------------------------------------
//
// Р9 ended by naming this function as the place to spend the programme's remaining idea: the erosion's
// structure function "SATURATES BY 200 m, the signature of a field with exactly ONE scale in it... A
// channel that summed two or three octaves would have no single cell scale to expose and would keep
// rising past 200 m" (Common/CloudField.glslh). Р10 built that, measured it, and is not shipping it.
// Everything below is measured on Clouds_Protocol with Р9's own instrument, so the numbers compare.
//
// THE SATURATION IS REAL and is now asserted rather than remembered — Desert/Tests/Engine/CloudNoise's
// EveryChannelHasExactlyOneScaleAndSaturatesFarBelowTheDepthTheEyeLooksThrough prints the table and
// pins the ratio. All four channels are flat by a fifth of a tile: D(.20)/D(.40) reads 0.947, 0.963,
// 0.949 and 1.009. So the diagnosis was right.
//
// THE PRESCRIPTION WAS NOT, and it fails for a reason nobody had written down: THE EROSION FIELD IS
// EXACTLY PERIODIC AT THE TILE. It is a REPEAT fetch of a unit cube spanning Detail Tile Size, so its
// structure function returns to ZERO at 1 km by construction and it can carry no energy above that at
// any resolution or octave count. The band the brief asked to fill — "scales comparable to and above the
// 657 m integration length" — is therefore 657 m to 1 km, which at whole-number periods is a single
// octave at period 1: one Alligator cell per tile. That is not a surface, it is the tile.
//
// AND A MEAN-PRESERVING FRACTAL MAKES IT WORSE, which is the part that is worth having in writing. A
// weighted average of independent octaves normalised to keep the mean is a VARIANCE SINK — sd falls as
// sqrt(sum w^2)/sum w — so the field gets SMOOTHER at every lag. Channel 3's D at an 83 m lag reads
// 0.201 with one octave, 0.146 with two and 0.125 with three. The construction that preserves the mean
// by averaging cannot add roughness in principle, and measuring it was the fastest way to find that out.
//
// AN ADDITIVE FRACTAL — each octave entering as (o - 0.5) about the median, which does preserve the mean
// without averaging — does add roughness, and is STRICTLY DOMINATED BY THE LEVER Р9 ALREADY REFUSED.
// Silhouette roughness added at an 80 m lag, above the 94.3 m the bare lumps give, at MATCHED total
// deviation:
//
//     construction                        deviation   added roughness
//     one octave (shipped)                    1.00        4.1 m
//     fractal, 3 octaves, COARSER             1.75        5.3 m
//     fractal, 3 octaves, FINER               1.75        5.3 m
//     mean-preserving contrast, one octave    1.75        6.8 m   <- Р9's refused lever
//     fractal, 4 octaves, lacunarity 1.5      3.10        7.3 m
//     mean-preserving contrast, one octave    3.10        9.4 m   <- and again
//
// TWO THINGS FALL OUT OF THAT TABLE. First, a coarse-biased and a fine-biased fractal at the same
// deviation give the SAME 5.3 m, so WHERE the energy sits is irrelevant and only how much of it there is
// matters — which refutes the surviving-the-average mechanism directly, on its own instrument. Second,
// spreading a deviation across scales delivers about three quarters of the roughness that spending it in
// one octave does, because the coarse octaves put energy where an 80 m lag cannot see it and the fine
// ones put it where the 657 m integral eats it. The fractal is not a way around the refusal; it is the
// refused mechanism at a discount.
//
// THE FRAME AGREES. The best fractal above, baked into both shipped `.dcnv` volumes and rendered against
// an unchanged binary (the repeat shot is 0 differing pixels of 980 480, so every figure is the change):
// 65.7-71.6 % of pixels move by a MEAN of 0.65-1.11 of 255, tonal contrast holds to within 0.004 on Р0's
// ruler at all four points, mean luminance moves +0.002 — and at EL 25 and EL 45 alike the lobes are the
// same smooth rounded cotton wool they were. No harm, and no surface: a 3.3 % change in a quantity that
// is 4.3 % of the silhouette to begin with.
//
// WHAT DID PAY, AND IT IS Р9'S ACTUAL HYPOTHESIS RATHER THAN THE ONE Р10 WAS SET. The fractal's value is
// not roughness, it is that it HAS NO SINGLE CELL SIZE TO EXPOSE. Р9 refused the mean-preserving contrast
// because at 3 the near field grew the Alligator's own `best - second` lattice as a bright honeycomb and
// tonal contrast at EL 45 fell 0.464 -> 0.373. Applying that same contrast to a FRACTAL channel, the
// lattice does not appear at all, and the EL 45 penalty falls from Р9's 0.091 to 0.010 (0.418 -> 0.408 on
// Р10's own baseline) — a factor of nine — while the edges finally break into filaments. That is one
// frame at one angle and it is NOT a shipping recommendation: it is the measurement that says the pair is
// worth a task, where neither half alone was. Whoever takes it must restate the two relations Р9 found
// mis-stated first (the mean-travel floor pins the uniform component; the retention justification claims
// nothing else depends on the profile, and both frequency blends do), because a deep cut moves both.
//
// ---------------------------------------------------------------------------------------------------
// THE PAIR WAS BUILT AND REFUSED — task Р13, 2026-09-01. THE FRACTAL HALF IS THE HARMLESS ONE.
// ---------------------------------------------------------------------------------------------------
//
// Р13 built exactly what the paragraph above asks for: an ADDITIVE fractal here (three octaves, lacunarity
// 2, gain 0.5, each octave entering as `(o - 0.5)`), both shipped `.dcnv` re-baked from their own recipes,
// and Р9's mean-preserving contrast on `detailField` in Common/CloudField.glslh. Everything below was
// measured on a baseline re-shot with the sky-light occlusion volume ON, which is what Р12 made the
// default and what makes Р9's and Р10's absolute figures not directly comparable. The repeat shot on
// Clouds_Protocol is 0 differing bytes and the same md5, so every pixel figure is the change.
//
// THE PREMISE OF THE FRACTAL DOES NOT SURVIVE ITS OWN INSTRUMENT. The reason to sum octaves was that a
// field with several lattices "would have no single cell scale to expose and would keep rising past
// 200 m". It does not. EveryChannelHasExactlyOneScaleAndSaturates... prints D(.20)/D(.40) at 0.947 /
// 0.959 / 0.965 / 1.002 for the fractal against 0.947 / 0.963 / 0.949 / 1.009 for the single octave: the
// saturation is exactly where it was. The reason is the one Р10 already wrote down two paragraphs up and
// did not carry through to the prescription — the field is EXACTLY PERIODIC AT THE TILE, so the only
// octaves a fractal can add are FINER ones, and a finer octave cannot make a structure function keep
// rising at a lag of 200 m. Filling that band needs COARSER scales, and above the tile there are none.
//
// WHAT THE FRACTAL ALONE IS WORTH, measured with the contrast at 1 (all relations green):
//
//     silhouette roughness added at an 80 m lag     4.1 m -> 5.8 m, on the 94.3 m the bare lumps give
//     mean travel                                 138.7 m -> 136.0 m  (1.11x the march chord -> 1.09x)
//     the erosion's decorrelation length            160 m -> 160 m    (unchanged — see below)
//
// +1.7 m on a 94.3 m silhouette is 1.8 % of it, for a re-bake that moves 60-78 % of the pixels of every
// frame of every scene, three times the bake cost, and every published table in the programme. It does
// not earn that, so the assets came back — the same judgement, for the same reason, that Р10's own
// re-bake got. What is kept is the finding.
//
// AND THE ONE THING A FUTURE FRACTAL MUST NOT REPEAT, because it was found by building it: the OCTAVE
// COUNT IS NOT A CONSTANT, it is bounded by the voxel. CloudNoise_Default is period 2/4/3/6, so three
// octaves at lacunarity 2 reach period 24 — 5.3 voxels per lattice cell at the shipped 128, which the
// volume can hold. CloudNoise_FineWisp is 4/8/6/12 and the same three octaves reach 48: 2.7 voxels,
// which it cannot. A bare count would have put an aliasing octave into the CIRRUS volume alone, and the
// frame that showed it would have been blamed on the cirrus. Any future octave sum has to take the
// bake's resolution as an input and stop when the next cell would be under about four voxels.
//
// WHY THE CONTRAST — the other half, and the half that actually moves the picture — is refused too, with
// its five broken relations and its whole-dome numbers, is written where it would have lived:
// Common/CloudField.glslh, at the bottom.
vec4 CloudNoiseVolumeChannels( vec3 uvw, uint seed, float curlStrength, float wispyPeriodLF,
                               float wispyPeriodHF, float billowPeriodLF, float billowPeriodHF )
{
    // The seed offsets are distinct primes so that two channels sharing a period cannot land on the same
    // lattice values and read as one channel with a strange amplitude.
    float r = CloudCurlyAlligator01( uvw * wispyPeriodLF, wispyPeriodLF, seed + 0u, curlStrength );
    float g = CloudCurlyAlligator01( uvw * wispyPeriodHF, wispyPeriodHF, seed + 977u, curlStrength );
    float b = CloudAlligator01( uvw * billowPeriodLF, billowPeriodLF, seed + 1861u );
    float a = CloudAlligator01( uvw * billowPeriodHF, billowPeriodHF, seed + 2749u );

    return vec4( r, g, b, a );
}

#endif // CLOUD_NOISE_GLSLH
