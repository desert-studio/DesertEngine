// Shared VERTEX stage for shader-graph (and other generic surface) shaders: the generic-mesh
// contract — fixed vertex layout, CameraUB at binding 0, Transform push constant.
//
// The including stage configures it with defines BEFORE the #include:
//   #define GRAPH_LIT 1        — also pass what the engine's surface shading model needs: the
//                               world-space normal (1), the world-space position (2) and the eye
//                               position (3). The last two are what Common/GraphSurfaceLighting.glslh
//                               builds the view vector from and what the cloud shadow map and the
//                               punctual lights are evaluated at; a lit surface that knows only its
//                               normal can carry a Lambert cosine and nothing else, which is exactly
//                               the model this contract replaced.
//
// There was a GRAPH_DEPTH_ONLY variant here, for a generated "Depth" pass meant to be the shadow
// caster. It is gone with that pass: this stage transforms by cameraUB, the CAMERA, so it could
// never have rendered a light-space cascade whatever stage list was wrapped around it. Graph
// materials cast through the engine's own shadow pipeline instead.

In(0) vec3 a_Position;
In(1) vec3 a_Normal;
In(2) vec3 a_Tangent;
In(3) vec3 a_Bitangent;
In(4) vec2 a_TextureCoord;

#include <Common/CameraUB.glslh>

// The per-draw block — model matrix here, material row index in the fragment stage. Shared rather than
// declared locally: Vulkan takes ONE push range per pipeline, so the two stages have to agree on its
// length byte for byte, and this vertex stage used to declare a 64-byte block while the fragment stage
// generated for `Properties Binding(n)` needs 68.
#include <Common/MaterialTransport.glslh>

Out(0) vec2 v_UV;
#ifdef GRAPH_LIT
Out(1) vec3 v_Normal;
Out(2) vec3 v_WorldPos;
Out(3) vec3 v_CameraPos;
#endif

void main()
{
    v_UV = a_TextureCoord;
#ifdef GRAPH_LIT
    // The INVERSE TRANSPOSE, byte for byte what the mesh shaders use. `mat3( Transform ) * a_Normal`
    // stood here and is correct only under uniform scale: a non-uniformly scaled object shaded its
    // own normals wrong, which under the old Lambert read as a tuning problem and under the shared
    // model would read as one too. A graph surface claiming to be lit like the rest of the engine has
    // to start from the same normal as the rest of the engine.
    v_Normal    = transpose( inverse( mat3( m_PushConstants.Transform ) ) ) * a_Normal;
    v_WorldPos  = vec3( m_PushConstants.Transform * vec4( a_Position, 1.0 ) );
    v_CameraPos = cameraUB.CameraPos;
#endif
    gl_Position = cameraUB.Projection * cameraUB.View * m_PushConstants.Transform * vec4( a_Position, 1.0 );
}
