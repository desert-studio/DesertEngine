#ifndef SMAA_GLSLH
#define SMAA_GLSLH

// SMAA 1x — ported from Jorge Jimenez's SMAA.hlsl (MIT). This is the "medium" subset: luma edge
// detection + horizontal/vertical pattern search with the precomputed AreaTex/SearchTex lookups.
// Diagonal- and corner-detection are intentionally omitted for a compact first version (still a big
// quality jump over FXAA on near-horizontal/vertical edges). RT metrics = (1/w, 1/h, w, h) are derived
// from the relevant texture's size per pass. AreaTex/SearchTex are uploaded as RGBA8 (area in .rg,
// search length in .r) since the engine has no RG8/R8 format.

#define SMAA_THRESHOLD 0.10
#define SMAA_MAX_SEARCH_STEPS 16
#define SMAA_MAX_SEARCH_STEPS_DIAG 8
#define SMAA_LOCAL_CONTRAST_ADAPTATION_FACTOR 2.0
#define SMAA_AREATEX_MAX_DISTANCE 16.0
#define SMAA_AREATEX_MAX_DISTANCE_DIAG 20.0
#define SMAA_AREATEX_PIXEL_SIZE (1.0 / vec2(160.0, 560.0))
#define SMAA_AREATEX_SUBTEX_SIZE (1.0 / 7.0)
#define SMAA_SEARCHTEX_SIZE vec2(66.0, 33.0)
#define SMAA_SEARCHTEX_PACKED_SIZE vec2(64.0, 16.0)

const vec3 SMAA_LUMA = vec3( 0.2126, 0.7152, 0.0722 );

// Conditional per-component move (HLSL SMAAMovc) — needed by both the diagonal search and the
// neighborhood blending, so defined up here.
void SMAAMovc2( bvec2 cond, inout vec2 v, vec2 s )
{
    if ( cond.x ) v.x = s.x;
    if ( cond.y ) v.y = s.y;
}
void SMAAMovc4( bvec4 cond, inout vec4 v, vec4 s )
{
    SMAAMovc2( cond.xy, v.xy, s.xy );
    SMAAMovc2( cond.zw, v.zw, s.zw );
}

// ---------------------------------------------------------------------------------------------------
// Edge detection (luma based, with local contrast adaptation). Returns vec2(left-edge, top-edge).
// ---------------------------------------------------------------------------------------------------
vec2 SMAALumaEdgeDetection( sampler2D colorTex, vec2 texcoord )
{
    vec2 threshold = vec2( SMAA_THRESHOLD );

    float L      = dot( textureLod( colorTex, texcoord, 0.0 ).rgb, SMAA_LUMA );
    float Lleft  = dot( textureLodOffset( colorTex, texcoord, 0.0, ivec2( -1, 0 ) ).rgb, SMAA_LUMA );
    float Ltop   = dot( textureLodOffset( colorTex, texcoord, 0.0, ivec2( 0, -1 ) ).rgb, SMAA_LUMA );

    vec4 delta;
    delta.xy   = abs( L - vec2( Lleft, Ltop ) );
    vec2 edges = step( threshold, delta.xy );

    if ( dot( edges, vec2( 1.0 ) ) == 0.0 )
        return vec2( 0.0 );

    float Lright  = dot( textureLodOffset( colorTex, texcoord, 0.0, ivec2( 1, 0 ) ).rgb, SMAA_LUMA );
    float Lbottom = dot( textureLodOffset( colorTex, texcoord, 0.0, ivec2( 0, 1 ) ).rgb, SMAA_LUMA );
    delta.zw      = abs( L - vec2( Lright, Lbottom ) );

    vec2 maxDelta = max( delta.xy, delta.zw );

    float Lleftleft = dot( textureLodOffset( colorTex, texcoord, 0.0, ivec2( -2, 0 ) ).rgb, SMAA_LUMA );
    float Ltoptop   = dot( textureLodOffset( colorTex, texcoord, 0.0, ivec2( 0, -2 ) ).rgb, SMAA_LUMA );
    delta.zw        = abs( vec2( Lleft, Ltop ) - vec2( Lleftleft, Ltoptop ) );

    maxDelta        = max( maxDelta.xy, delta.zw );
    float finalDelta = max( maxDelta.x, maxDelta.y );

    edges.xy *= step( finalDelta, SMAA_LOCAL_CONTRAST_ADAPTATION_FACTOR * delta.xy );
    return edges;
}

// ---------------------------------------------------------------------------------------------------
// Blending-weight calculation (search + area lookups).
// ---------------------------------------------------------------------------------------------------
float SMAASearchLength( sampler2D searchTex, vec2 e, float offset )
{
    vec2 scale = SMAA_SEARCHTEX_SIZE * vec2( 0.5, -1.0 );
    vec2 bias  = SMAA_SEARCHTEX_SIZE * vec2( offset, 1.0 );

    scale += vec2( -1.0, 1.0 );
    bias  += vec2( 0.5, -0.5 );

    scale *= 1.0 / SMAA_SEARCHTEX_PACKED_SIZE;
    bias  *= 1.0 / SMAA_SEARCHTEX_PACKED_SIZE;

    // SMAA requires CLAMP addressing on SearchTex — its lookup Y intentionally exceeds 1.0, and a repeat
    // sampler (the engine's global default) would wrap to the wrong row. Clamp the coord to emulate clamp.
    vec2 coord = clamp( scale * e + bias, vec2( 0.0 ), vec2( 1.0 ) );
    return textureLod( searchTex, coord, 0.0 ).r;
}

float SMAASearchXLeft( sampler2D edgesTex, sampler2D searchTex, vec2 texcoord, float end, vec4 metrics )
{
    vec2 e = vec2( 0.0, 1.0 );
    for ( int i = 0; i < SMAA_MAX_SEARCH_STEPS; ++i )
    {
        if ( !( texcoord.x > end && e.g > 0.8281 && e.r == 0.0 ) )
            break;
        e = textureLod( edgesTex, texcoord, 0.0 ).rg;
        texcoord -= vec2( 2.0, 0.0 ) * metrics.xy;
    }
    float offset = -( 255.0 / 127.0 ) * SMAASearchLength( searchTex, e, 0.0 ) + 3.25;
    return metrics.x * offset + texcoord.x;
}

float SMAASearchXRight( sampler2D edgesTex, sampler2D searchTex, vec2 texcoord, float end, vec4 metrics )
{
    vec2 e = vec2( 0.0, 1.0 );
    for ( int i = 0; i < SMAA_MAX_SEARCH_STEPS; ++i )
    {
        if ( !( texcoord.x < end && e.g > 0.8281 && e.r == 0.0 ) )
            break;
        e = textureLod( edgesTex, texcoord, 0.0 ).rg;
        texcoord += vec2( 2.0, 0.0 ) * metrics.xy;
    }
    float offset = -( 255.0 / 127.0 ) * SMAASearchLength( searchTex, e, 0.5 ) + 3.25;
    return -metrics.x * offset + texcoord.x;
}

float SMAASearchYUp( sampler2D edgesTex, sampler2D searchTex, vec2 texcoord, float end, vec4 metrics )
{
    vec2 e = vec2( 1.0, 0.0 );
    for ( int i = 0; i < SMAA_MAX_SEARCH_STEPS; ++i )
    {
        if ( !( texcoord.y > end && e.r > 0.8281 && e.g == 0.0 ) )
            break;
        e = textureLod( edgesTex, texcoord, 0.0 ).rg;
        texcoord -= vec2( 0.0, 2.0 ) * metrics.xy;
    }
    float offset = -( 255.0 / 127.0 ) * SMAASearchLength( searchTex, e.gr, 0.0 ) + 3.25;
    return metrics.y * offset + texcoord.y;
}

float SMAASearchYDown( sampler2D edgesTex, sampler2D searchTex, vec2 texcoord, float end, vec4 metrics )
{
    vec2 e = vec2( 1.0, 0.0 );
    for ( int i = 0; i < SMAA_MAX_SEARCH_STEPS; ++i )
    {
        if ( !( texcoord.y < end && e.r > 0.8281 && e.g == 0.0 ) )
            break;
        e = textureLod( edgesTex, texcoord, 0.0 ).rg;
        texcoord += vec2( 0.0, 2.0 ) * metrics.xy;
    }
    float offset = -( 255.0 / 127.0 ) * SMAASearchLength( searchTex, e.gr, 0.5 ) + 3.25;
    return -metrics.y * offset + texcoord.y;
}

vec2 SMAAArea( sampler2D areaTex, vec2 dist, float e1, float e2 )
{
    vec2 texcoord = SMAA_AREATEX_MAX_DISTANCE * round( 4.0 * vec2( e1, e2 ) ) + dist;
    texcoord = SMAA_AREATEX_PIXEL_SIZE * texcoord + ( 0.5 * SMAA_AREATEX_PIXEL_SIZE );
    // AreaTex also needs CLAMP addressing — emulate it so a repeat sampler can't wrap the lookup.
    texcoord = clamp( texcoord, vec2( 0.0 ), vec2( 1.0 ) );
    return textureLod( areaTex, texcoord, 0.0 ).rg;
}

// ---------------------------------------------------------------------------------------------------
// Diagonal pattern detection (the part that smooths diagonal "staircases" — without it SMAA only fixes
// near-horizontal/vertical edges and FXAA's broad blur looks smoother on diagonals).
// ---------------------------------------------------------------------------------------------------
vec2 SMAADecodeDiagBilinearAccess( vec2 e )
{
    e.r = e.r * abs( 5.0 * e.r - 5.0 * 0.75 );
    return round( e );
}
vec4 SMAADecodeDiagBilinearAccess( vec4 e )
{
    e.rb = e.rb * abs( 5.0 * e.rb - 5.0 * 0.75 );
    return round( e );
}

vec2 SMAASearchDiag1( sampler2D edgesTex, vec2 texcoord, vec2 dir, out vec2 e, vec4 metrics )
{
    vec4 coord = vec4( texcoord, -1.0, 1.0 );
    vec3 t     = vec3( metrics.xy, 1.0 );
    e          = vec2( 0.0 );
    for ( int i = 0; i < SMAA_MAX_SEARCH_STEPS_DIAG; ++i )
    {
        if ( !( coord.z < float( SMAA_MAX_SEARCH_STEPS_DIAG - 1 ) && coord.w > 0.9 ) )
            break;
        coord.xyz = t * vec3( dir, 1.0 ) + coord.xyz;
        e         = textureLod( edgesTex, coord.xy, 0.0 ).rg;
        coord.w   = dot( e, vec2( 0.5 ) );
    }
    return coord.zw;
}

vec2 SMAASearchDiag2( sampler2D edgesTex, vec2 texcoord, vec2 dir, out vec2 e, vec4 metrics )
{
    vec4 coord = vec4( texcoord, -1.0, 1.0 );
    coord.x += 0.25 * metrics.x;
    vec3 t = vec3( metrics.xy, 1.0 );
    e      = vec2( 0.0 );
    for ( int i = 0; i < SMAA_MAX_SEARCH_STEPS_DIAG; ++i )
    {
        if ( !( coord.z < float( SMAA_MAX_SEARCH_STEPS_DIAG - 1 ) && coord.w > 0.9 ) )
            break;
        coord.xyz = t * vec3( dir, 1.0 ) + coord.xyz;
        e         = textureLod( edgesTex, coord.xy, 0.0 ).rg;
        e         = SMAADecodeDiagBilinearAccess( e );
        coord.w   = dot( e, vec2( 0.5 ) );
    }
    return coord.zw;
}

vec2 SMAAAreaDiag( sampler2D areaTex, vec2 dist, vec2 e, float offset )
{
    vec2 texcoord = vec2( SMAA_AREATEX_MAX_DISTANCE_DIAG ) * e + dist;
    texcoord      = SMAA_AREATEX_PIXEL_SIZE * texcoord + 0.5 * SMAA_AREATEX_PIXEL_SIZE;
    texcoord.x += 0.5;                                     // diagonal areas live in the right half
    texcoord.y += SMAA_AREATEX_SUBTEX_SIZE * offset;       // offset = 0 for SMAA 1x
    texcoord = clamp( texcoord, vec2( 0.0 ), vec2( 1.0 ) );
    return textureLod( areaTex, texcoord, 0.0 ).rg;
}

// Returns the diagonal blending weights (in .rg). subsampleIndices = 0 for 1x.
vec2 SMAACalculateDiagWeights( sampler2D edgesTex, sampler2D areaTex, vec2 texcoord, vec2 e, vec4 metrics )
{
    vec2 weights = vec2( 0.0 );
    vec4 d;
    vec2 end;

    if ( e.r > 0.0 )
    {
        vec2 dd = SMAASearchDiag1( edgesTex, texcoord, vec2( -1.0, 1.0 ), end, metrics );
        d.x = dd.x;
        d.z = dd.y;
        d.x += float( end.y > 0.9 );
    }
    else
    {
        d.x = 0.0;
        d.z = 0.0;
    }
    {
        vec2 dd = SMAASearchDiag1( edgesTex, texcoord, vec2( 1.0, -1.0 ), end, metrics );
        d.y = dd.x;
        d.w = dd.y;
    }

    if ( d.x + d.y > 2.0 )
    {
        vec4 coords = vec4( -d.x + 0.25, d.x, d.y, -d.y - 0.25 ) * metrics.xyxy + texcoord.xyxy;
        vec4 c;
        c.xy = textureLodOffset( edgesTex, coords.xy, 0.0, ivec2( -1, 0 ) ).rg;
        c.zw = textureLodOffset( edgesTex, coords.zw, 0.0, ivec2( 1, 0 ) ).rg;
        vec4 dec = SMAADecodeDiagBilinearAccess( vec4( c.x, c.y, c.z, c.w ) );
        c.y = dec.x;
        c.x = dec.y;
        c.w = dec.z;
        c.z = dec.w;
        vec2 cc = vec2( 2.0 ) * vec2( c.x, c.z ) + vec2( c.y, c.w );
        SMAAMovc2( bvec2( step( 0.9, d.zw ) ), cc, vec2( 0.0 ) );
        weights += SMAAAreaDiag( areaTex, d.xy, cc, 0.0 );
    }

    {
        vec2 dd = SMAASearchDiag2( edgesTex, texcoord, vec2( -1.0, -1.0 ), end, metrics );
        d.x = dd.x;
        d.z = dd.y;
    }
    if ( textureLodOffset( edgesTex, texcoord, 0.0, ivec2( 1, 0 ) ).r > 0.0 )
    {
        vec2 dd = SMAASearchDiag2( edgesTex, texcoord, vec2( 1.0, 1.0 ), end, metrics );
        d.y = dd.x;
        d.w = dd.y;
        d.y += float( end.y > 0.9 );
    }
    else
    {
        d.y = 0.0;
        d.w = 0.0;
    }

    if ( d.x + d.y > 2.0 )
    {
        vec4 coords = vec4( -d.x, -d.x, d.y, d.y ) * metrics.xyxy + texcoord.xyxy;
        vec4 c;
        c.x  = textureLodOffset( edgesTex, coords.xy, 0.0, ivec2( -1, 0 ) ).g;
        c.y  = textureLodOffset( edgesTex, coords.xy, 0.0, ivec2( 0, -1 ) ).r;
        c.zw = textureLodOffset( edgesTex, coords.zw, 0.0, ivec2( 1, 0 ) ).gr;
        vec2 cc = vec2( 2.0 ) * vec2( c.x, c.z ) + vec2( c.y, c.w );
        SMAAMovc2( bvec2( step( 0.9, d.zw ) ), cc, vec2( 0.0 ) );
        vec2 w2 = SMAAAreaDiag( areaTex, d.xy, cc, 0.0 );
        weights += w2.gr;
    }

    return weights;
}

vec4 SMAABlendingWeightCalculation( sampler2D edgesTex, sampler2D areaTex, sampler2D searchTex,
                                    vec2 texcoord, vec4 metrics )
{
    // The exact sub-texel offsets from SMAABlendingWeightCalculationVS — SMAA's bilinear search depends
    // on these precise positions, so they must NOT be simplified.
    vec2 pixcoord = texcoord * metrics.zw;
    vec4 offset0  = texcoord.xyxy + metrics.xyxy * vec4( -0.25, -0.125, 1.25, -0.125 );
    vec4 offset1  = texcoord.xyxy + metrics.xyxy * vec4( -0.125, -0.25, -0.125, 1.25 );
    vec4 offset2  = vec4( offset0.xz, offset1.yw ) +
                    vec4( metrics.xx, metrics.yy ) * vec4( -2.0, 2.0, -2.0, 2.0 ) * float( SMAA_MAX_SEARCH_STEPS );

    vec4 weights = vec4( 0.0 );
    vec2 e       = textureLod( edgesTex, texcoord, 0.0 ).rg;

    if ( e.g > 0.0 ) // Edge at north -> horizontal pattern (or a diagonal)
    {
        // Diagonals have both a north and a west edge; detect them first and give them priority.
        weights.rg = SMAACalculateDiagWeights( edgesTex, areaTex, texcoord, e, metrics );
        if ( weights.r != -weights.g ) // a diagonal was found
        {
            e.r = 0.0; // skip the vertical orthogonal pass below
        }
        else // no diagonal -> do the horizontal orthogonal search
        {
        vec2 d;
        vec3 coords;
        coords.x = SMAASearchXLeft( edgesTex, searchTex, offset0.xy, offset2.x, metrics );
        coords.y = offset1.y;
        d.x      = coords.x;

        float e1 = textureLod( edgesTex, coords.xy, 0.0 ).r;

        coords.z = SMAASearchXRight( edgesTex, searchTex, offset0.zw, offset2.y, metrics );
        d.y      = coords.z;

        d = abs( round( metrics.zz * d - pixcoord.xx ) );

        vec2  sqrt_d = sqrt( d );
        float e2     = textureLodOffset( edgesTex, vec2( coords.z, coords.y ), 0.0, ivec2( 1, 0 ) ).r;

        weights.rg = SMAAArea( areaTex, sqrt_d, e1, e2 );
        } // end else (no diagonal)
    }

    if ( e.r > 0.0 ) // Edge at west -> vertical pattern
    {
        vec2 d;
        vec3 coords;
        coords.y = SMAASearchYUp( edgesTex, searchTex, offset1.xy, offset2.z, metrics );
        coords.x = offset0.x;
        d.x      = coords.y;

        float e1 = textureLod( edgesTex, coords.xy, 0.0 ).g;

        coords.z = SMAASearchYDown( edgesTex, searchTex, offset1.zw, offset2.w, metrics );
        d.y      = coords.z;

        d = abs( round( metrics.ww * d - pixcoord.yy ) );

        vec2  sqrt_d = sqrt( d );
        float e2     = textureLodOffset( edgesTex, vec2( coords.x, coords.z ), 0.0, ivec2( 0, 1 ) ).g;

        weights.ba = SMAAArea( areaTex, sqrt_d, e1, e2 );
    }

    return weights;
}

// ---------------------------------------------------------------------------------------------------
// Neighborhood blending (apply the weights to blend with neighbors). Faithful transcription of
// SMAANeighborhoodBlendingPS — exploits bilinear filtering to mix the current pixel with one neighbor.
// ---------------------------------------------------------------------------------------------------
vec4 SMAANeighborhoodBlending( sampler2D colorTex, sampler2D blendTex, vec2 texcoord, vec4 metrics )
{
    // offset.xy = right pixel; offset.zw = bottom pixel (y-down texcoords).
    vec4 offset = vec4( texcoord + vec2( metrics.x, 0.0 ), texcoord + vec2( 0.0, metrics.y ) );

    vec4 a;
    a.x  = textureLod( blendTex, offset.xy, 0.0 ).a;          // right
    a.y  = textureLod( blendTex, offset.zw, 0.0 ).g;          // bottom
    a.wz = textureLod( blendTex, texcoord, 0.0 ).xz;          // a.w = .x (left), a.z = .z (top)

    if ( dot( a, vec4( 1.0 ) ) < 1e-5 )
        return textureLod( colorTex, texcoord, 0.0 );

    bool h = max( a.x, a.z ) > max( a.y, a.w );

    vec4 blendingOffset = vec4( 0.0, a.y, 0.0, a.w );
    vec2 blendingWeight = a.yw;
    SMAAMovc4( bvec4( h ), blendingOffset, vec4( a.x, 0.0, a.z, 0.0 ) );
    SMAAMovc2( bvec2( h ), blendingWeight, a.xz );
    blendingWeight /= dot( blendingWeight, vec2( 1.0 ) );

    vec4 blendingCoord = blendingOffset * vec4( metrics.xy, -metrics.xy ) + texcoord.xyxy;

    vec4 color = blendingWeight.x * textureLod( colorTex, blendingCoord.xy, 0.0 );
    color += blendingWeight.y * textureLod( colorTex, blendingCoord.zw, 0.0 );
    return color;
}

#endif // SMAA_GLSLH
