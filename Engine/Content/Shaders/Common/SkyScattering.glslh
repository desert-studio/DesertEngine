// The physical atmosphere's scattering integrator, the Sky-View LUT parameterisation, the sun disc and
// the camera aerial-perspective volume's slice mapping and froxel walk — Phases 2 and 3 of the Sky
// Atmosphere programme, implemented from Sébastien Hillaire, "A Scalable and Production Ready Sky and
// Atmosphere Rendering Technique" (EGSR 2020) and its MIT-licensed reference implementation
// (github.com/sebh/UnrealEngineSkyAtmosphere). UE is a behavioural reference for names and composition
// order only; no Epic source text appears here.
//
// This file is compiled TWICE, from the same text:
//   * as GLSL, by Programs/Sky/SkyViewLut.shader, Programs/Sky/SkyAerialPerspectiveLut.shader,
//     Programs/Fog/HeightFog.shader (the slice mapping only — it reads the volume, it does not fill
//     it), Programs/Compute/BakeProceduralSky.shader and Programs/ProceduralSky/ProceduralSky.shader;
//   * as C++, by Desert/Tests/Engine/SkyScattering/SkyScatteringReference.hpp, which the
//     SkyScattering tests drive.
// SkyMedium.glslh's restricted dialect applies verbatim: no swizzles, no `out` parameters, no
// arrays, `f` suffixes, structs returned through a named local, functions defined before use.
//
// THE LUT CALLBACKS. The integrator reads the transmittance and multi-scattering LUTs per step, but
// a sampler cannot appear in text that must also compile as C++. The includer therefore provides the
// two lookups as MACROS before including this file:
//
//   #define SKY_SCATTERING_SUN_TRANSMITTANCE(atm, radiusKm, sunZenithCos)  ...vec3...
//   #define SKY_SCATTERING_MULTI_SCATTER(atm, radiusKm, sunZenithCos)      ...vec3...
//
// A shader expands them to texture() lookups; the test reference expands them to the SkyMedium march
// itself. The integrator block is #ifdef-guarded on the first macro, so an includer that only wants
// the mapping and the sun disc (the screen sky pass) simply does not define them.
//
// Requires: Common/SkyMedium.glslh included first (medium, phases, sphere geometry, texel remap).

#ifndef SKY_SCATTERING_GLSLH
#define SKY_SCATTERING_GLSLH

// The Sky-View LUT extent. Part of the parameterisation, not a quality knob: the sub-texel remap
// below bakes these numbers into every write and every read, and the C++ side allocates the image at
// the same extent (SkyboxRenderer's kSkyViewLutWidth/Height mirror these — the SkyScattering tests
// pin the remap at exactly this resolution).
const float SKY_VIEW_LUT_WIDTH  = 192.0f;
const float SKY_VIEW_LUT_HEIGHT = 104.0f;

// ---- The camera in the planet's frame --------------------------------------------------------------
// World convention: the world origin lies ON the planet surface with +Y up, so
// the planet centre is (0, -bottomRadius, 0). Both helpers below avoid ever FORMING a planet-scale
// coordinate: r is recovered from r^2 - Rb^2 = |c|^2 + 2*Rb*c.y, which is small near the surface.

float SkyViewHeightKm(vec3 cameraKm, float bottomRadiusKm)
{
    float q = dot(cameraKm, cameraKm) + 2.0f * bottomRadiusKm * cameraKm.y; // r^2 - Rb^2, exactly
    return bottomRadiusKm + q / (sqrt(max(q + bottomRadiusKm * bottomRadiusKm, 1.0f)) + bottomRadiusKm);
}

vec3 SkyViewZenith(vec3 cameraKm, float bottomRadiusKm)
{
    vec3 fromCentre = vec3(cameraKm.x, cameraKm.y + bottomRadiusKm, cameraKm.z);
    return fromCentre / max(length(fromCentre), 1.0f);
}

// Cosine of the AZIMUTH angle between the view and the sun as seen around the zenith — the third
// coordinate of the Sky-View LUT (the first two are r and the view zenith cosine). The atmosphere is
// symmetric around the sun's azimuth, which is what lets a 2D LUT hold the whole sky. Degenerate
// projections (looking straight up, sun at the zenith) return 1: every azimuth is the sun's there.
float SkyViewLightViewCos(vec3 zenith, vec3 viewDir, vec3 sunDir)
{
    vec3  viewAzimuthal = viewDir - zenith * dot(viewDir, zenith);
    vec3  sunAzimuthal  = sunDir - zenith * dot(sunDir, zenith);
    float lengths       = length(viewAzimuthal) * length(sunAzimuthal);
    if (lengths < 1e-6f)
        return 1.0f;
    return clamp(dot(viewAzimuthal, sunAzimuthal) / lengths, -1.0f, 1.0f);
}

// ---- The Sky-View LUT parameterisation (Hillaire section 5.3) --------------------------------------
// unit.y splits at the EXACT horizon angle for the given view height and spends its precision there
// through a sqrt warp on both sides — the horizon is where the sky changes fastest, and a linear
// lat-long mapping visibly bands it at 104 rows. unit.x is the light-view azimuth cosine, sqrt-warped
// toward the sun where the Mie forward lobe lives. The two functions are EXACT inverses over the
// whole domain for a fixed view height — the property the tests round-trip.

// Cosine of the view zenith angle at which the ray grazes the planet: mu_h = -rho/r. Everything at
// or below it hits the ground.
float SkyViewHorizonCos(float bottomRadiusKm, float viewHeightKm)
{
    float rho =
         sqrt(max((viewHeightKm - bottomRadiusKm) * (viewHeightKm + bottomRadiusKm), 0.0f));
    return -rho / max(viewHeightKm, 1.0f);
}

bool SkyViewHitsGround(float bottomRadiusKm, float viewHeightKm, float viewZenithCos)
{
    return viewZenithCos < SkyViewHorizonCos(bottomRadiusKm, viewHeightKm);
}

struct SkyViewLutCoord
{
    float ViewZenithCos; // cosine of the view angle against the zenith at the camera
    float LightViewCos;  // cosine of the azimuth angle between view and sun around the zenith
};

vec2 SkyViewUnitFromParams(float bottomRadiusKm, float viewHeightKm, float viewZenithCos,
                           float lightViewCos)
{
    float horizonCos   = SkyViewHorizonCos(bottomRadiusKm, viewHeightKm);
    float horizonAngle = acos(clamp(horizonCos, -1.0f, 1.0f)); // zenith->horizon, in (pi/2, pi]
    float beta         = max(SKY_PI - horizonAngle, 1e-4f);    // horizon->nadir remainder

    float viewZenith = acos(clamp(viewZenithCos, -1.0f, 1.0f));

    vec2 unit;
    if (viewZenith <= horizonAngle)
    {
        // Sky half: [0, horizonAngle] onto [0, 0.5), warped so unit.y ~ 0.5 dwells at the horizon.
        float coord = viewZenith / horizonAngle;
        unit.y      = (1.0f - sqrt(max(1.0f - coord, 0.0f))) * 0.5f;
    }
    else
    {
        // Ground half: (horizonAngle, pi] onto [0.5, 1], the same warp mirrored.
        float coord = (viewZenith - horizonAngle) / beta;
        unit.y      = sqrt(max(coord, 0.0f)) * 0.5f + 0.5f;
    }
    unit.x = sqrt(clamp((1.0f - lightViewCos) * 0.5f, 0.0f, 1.0f));
    return unit;
}

SkyViewLutCoord SkyViewParamsFromUnit(float bottomRadiusKm, float viewHeightKm, vec2 unit)
{
    float horizonCos   = SkyViewHorizonCos(bottomRadiusKm, viewHeightKm);
    float horizonAngle = acos(clamp(horizonCos, -1.0f, 1.0f));
    float beta         = max(SKY_PI - horizonAngle, 1e-4f);

    float viewZenith;
    if (unit.y < 0.5f)
    {
        float c    = 1.0f - 2.0f * unit.y;
        viewZenith = horizonAngle * (1.0f - c * c);
    }
    else
    {
        float c    = 2.0f * unit.y - 1.0f;
        viewZenith = horizonAngle + beta * (c * c);
    }

    SkyViewLutCoord coord;
    coord.ViewZenithCos = cos(viewZenith);
    coord.LightViewCos  = clamp(1.0f - 2.0f * unit.x * unit.x, -1.0f, 1.0f);
    return coord;
}

// The ray for a LUT texel, in the LUT's local frame: +Y is the zenith at the camera and the sun lies
// in the XY plane toward +X. sin(azimuth) takes the positive branch — legitimate because the
// atmosphere is mirror-symmetric across the sun's azimuthal plane.
vec3 SkyViewRayDirection(float viewZenithCos, float lightViewCos)
{
    float sinZenith  = sqrt(max(1.0f - viewZenithCos * viewZenithCos, 0.0f));
    float sinAzimuth = sqrt(max(1.0f - lightViewCos * lightViewCos, 0.0f));

    vec3 dir;
    dir.x = sinZenith * lightViewCos;
    dir.y = viewZenithCos;
    dir.z = sinZenith * sinAzimuth;
    return dir;
}

// ---- The sun disc ----------------------------------------------------------------------------------
// The disc is NOT in the Sky-View LUT (it would alias at 192x104); the sky pass adds it analytically:
// outer-space luminance x transmittance-LUT toward the view, shaped by the two factors below.

// 1 inside the disc fading to 0 at the rim over the outer half of the apex angle — the soft edge that
// keeps a ~half-degree disc from shimmering under camera rotation without TAA.
float SkySunDiscSoftEdge(float viewDotSun, float cosApexAngle)
{
    float denom = max(1.0f - cosApexAngle, 1e-7f);
    return clamp(2.0f * (viewDotSun - cosApexAngle) / denom, 0.0f, 1.0f);
}

// Limb darkening: the disc's rim is dimmer and redder than its centre because the slanted line of
// sight leaves the photosphere through higher, cooler gas. The classic one-parameter-per-channel
// power law I(mu)/I(centre) = mu^a with the astronomical fit a = (0.397, 0.503, 0.652) — blue darkens
// fastest, which is what makes the rim warm. @p centerToEdge is 0 at the disc centre, 1 at the rim.
vec3 SkySunLimbDarkening(float centerToEdge)
{
    float d  = clamp(centerToEdge, 0.0f, 1.0f);
    float mu = sqrt(max(1.0f - d * d, 0.0f));

    vec3 darkening;
    darkening.x = pow(mu, 0.397f);
    darkening.y = pow(mu, 0.503f);
    darkening.z = pow(mu, 0.652f);
    return darkening;
}

// The lit ground where a view ray lands: Lambertian albedo under the transmitted sun. The caller
// multiplies by the VIEW path's transmittance (the integrator's Transmittance lane, or the Sky-View
// LUT's alpha) — split so the screen pass and the IBL bake can share the formula while sourcing the
// view transmittance differently.
vec3 SkyGroundLuminance(SkyAtmParams p, vec3 sunIlluminance, vec3 sunTransmittanceAtGround,
                        float sunZenithCosAtGround)
{
    return p.GroundAlbedo * (1.0f / SKY_PI) * sunIlluminance *
           clamp(sunZenithCosAtGround, 0.0f, 1.0f) * sunTransmittanceAtGround;
}

// ---- The planet's shadow on the air --------------------------------------------------------------
// A sample sees the sun only while the sun stands above ITS OWN horizon, mu_h = -rho/r. Written as a
// hard step that is a defect, not a simplification, and the twilight sky is where it shows: the
// march's far segments are tens of kilometres long at the Sky-View budget (the squared distribution
// spends its resolution near the camera), so the step lands inside one enormous slab and the whole
// slab flips lit or unlit at once. On screen that quantisation is a pair of bright bands standing
// symmetrically about the sun's azimuth — measured at 20% over the surrounding sky, and it MOVES with
// the sample count instead of converging away (32 and 128 samples are clean at one sun elevation, 96
// is not, because the artefact is a resonance between the sample positions and the terminator, not a
// convergence error).
//
// The terminator is not a step in reality either: the sun is a disc ~0.27 degrees in radius, so the
// umbra fades over a penumbra of at least that width, and refraction near the horizon widens it
// further. Fading the shadow over a band is therefore the more physical description AND it removes
// the resonance, because no segment can now flip by more than the fraction of the band it crosses.
//
// The width is deliberately NARROWER than the sun's own disc (0.0047 in cosine at the horizon): a
// wider band admits more light and lifts the whole twilight sky, and this term is here to remove an
// artefact, not to re-open the twilight brightness. At this width the 64-sample fill reproduces the
// 128- and 256-sample answers to within a display level.
const float SKY_TERMINATOR_HALF_WIDTH_COS = 0.002f; // ~0.11 deg of sun-zenith angle at the horizon

// 0 in full shadow, 1 in full sun, smooth across the terminator band. @p radiusKm is the sample's
// distance from the planet centre, @p sunZenithCos the cosine of the sun against the sample's zenith.
float SkyPlanetShadow(float radiusKm, float sunZenithCos, float bottomRadiusKm)
{
    float rho = sqrt(max((radiusKm - bottomRadiusKm) * (radiusKm + bottomRadiusKm), 0.0f));
    float horizonCos = -rho / max(radiusKm, 1.0f);

    float x = clamp((sunZenithCos - horizonCos) / (2.0f * SKY_TERMINATOR_HALF_WIDTH_COS) + 0.5f, 0.0f,
                    1.0f);
    return x * x * (3.0f - 2.0f * x);
}

// ---- The sun, as seen from a point INSIDE the atmosphere -------------------------------------------
//
// Everything a consumer needs to turn the sun's OUTER-SPACE illuminance into the illuminance at a point
// in the shell, EXCEPT the texture fetch — which cannot live in text that compiles as C++, and which is
// the only part that differs between the two passes that use this.
//
// WHY IT EXISTS AS ONE TEXT. Two passes march the volumetric cloud field — the screen march
// (Programs/Clouds/CloudRaymarch.shader) and the environment bake
// (Programs/Compute/BakeProceduralSky.shader) — and both light it from the SAME packed block. When
// ECS::VolumetricCloudData::PerSampleAtmosphereTransmittance is on, that block carries the outer-space
// illuminance and each pass owes the atmosphere's cut at the sample's own altitude. Two copies of this
// arithmetic is the mirror that drifts, and this subsystem has already paid for that shape more than
// once; one copy, compiled as C++ by Desert/Tests/Engine/SkyScattering, is the answer.
//
// THE TWO PIECES ARE RETURNED TOGETHER because they are one decision: the LUT's parameterisation stores
// "transmittance from a radius to space along a zenith angle" and has NO state for "the planet is in the
// way", so for a sun below the sample's horizon the mapping simply saturates at its grazing column.
// Fetched without the shadow, a night sky lights its clouds with per cents of the sun — almost all of it
// RED, so the deck glows dark red rather than going dark.
//
// SkyPlanetShadow AND NOT A RAY TEST OF OUR OWN, which is the whole point of reusing the sky's function:
// it is what this file multiplies the sun by for every sky pixel, so a cloud and the sky BEHIND IT switch
// the sun off at the same rate and over the same 0.11-degree band. A hard SkyIntersectsGround here would
// be correct and would still be a seam — the deck going out instantly against a sky fading over a
// terminator.
struct SkySunAtPoint
{
    vec2  Uv;           // where to fetch the transmittance LUT, clamped to its texel centres
    float PlanetShadow; // 0 in full shadow, 1 in full sun, smooth across the terminator band
};

// @p altitudeKm above the GROUND (not above any layer's base), @p sunZenithCos against the point's OWN
// local zenith, @p lutSize the transmittance LUT's dimensions in texels.
SkySunAtPoint SkySunAtAltitude(float bottomRadiusKm, float topRadiusKm, float altitudeKm,
                               float sunZenithCos, vec2 lutSize)
{
    float viewHeightKm = SkyRadiusAtAltitude(bottomRadiusKm, topRadiusKm, altitudeKm);

    SkySunAtPoint sun;
    sun.PlanetShadow = SkyPlanetShadow(viewHeightKm, sunZenithCos, bottomRadiusKm);
    sun.Uv           = SkyTransmittanceLutUvClamped(bottomRadiusKm, topRadiusKm, viewHeightKm, sunZenithCos,
                                                    lutSize);
    return sun;
}

// ---- The camera aerial-perspective volume's parameterisation (Hillaire section 5.4) ----------------
// A froxel volume in the camera's frustum: x and y are the screen, z is DISTANCE ALONG THE RAY, and each
// texel holds the atmosphere between the camera and that distance. The two mappings below are the whole
// z parameterisation and are EXACT inverses — the fill writes a slice through one and the apply pass
// reads a pixel's distance through the other, and a mismatch is haze at the wrong distance everywhere
// and provably wrong nowhere.
//
// The distribution is SQUARED (UE's, and the paper's reason): a froxel at normalised slice u covers
// camera distance D*u^2, so half the slices land in the nearest quarter of the range, where the air the
// camera is standing in dominates the picture and where the eye can still tell two distances apart.
//
// The volume's extent is part of the parameterisation, not a quality dial — SkyboxRenderer's
// kAerialPerspectiveWidth/Height/Depth mirror these three, and the sub-texel remap (SkyUnitToTexelUv,
// SkyMedium.glslh) bakes them into every write and every read.
const float SKY_AP_VOLUME_WIDTH  = 32.0f;
const float SKY_AP_VOLUME_HEIGHT = 32.0f;
const float SKY_AP_VOLUME_DEPTH  = 16.0f;

// Camera distance of the slice at normalised depth @p sliceUnit, for a volume that reaches @p apDepthKm.
float SkyApDistanceFromSliceUnit(float sliceUnit, float apDepthKm)
{
    float u = clamp(sliceUnit, 0.0f, 1.0f);
    return apDepthKm * u * u;
}

// Its exact inverse: the normalised slice a surface at @p distanceKm belongs to. Saturating past the
// volume's far end is deliberate — beyond apDepthKm the haze has long since stopped changing, and the
// alternative (wrapping, or a black froxel) is a hard ring at the volume's edge.
float SkyApSliceUnitFromDistance(float distanceKm, float apDepthKm)
{
    return sqrt(clamp(distanceKm / max(apDepthKm, 1e-4f), 0.0f, 1.0f));
}

// How many march sub-steps one froxel segment earns. With the squared distribution the segments grow
// linearly with the slice index — at the 96 km default the first is 0.4 km and the last is over 12 —
// so a fixed count per slice either wastes work near the camera or puts a twelve-kilometre slab at one
// density. One sample per SKY_AP_STEP_TARGET_KM, capped, spends the samples where the length is.
const float SKY_AP_STEP_TARGET_KM      = 1.0f;
const int   SKY_AP_MAX_SEGMENT_SAMPLES = 8;

int SkyApSegmentSampleCount(float segmentLengthKm)
{
    int steps = int(clamp(segmentLengthKm, 0.0f, 1.0e6f) / SKY_AP_STEP_TARGET_KM) + 1;
    return steps < SKY_AP_MAX_SEGMENT_SAMPLES ? steps : SKY_AP_MAX_SEGMENT_SAMPLES;
}

// ---- The distant sky light's texel -------------------------------------------------------------------
// Which column of the 1x1 image holds the mean. Stated OUTSIDE the integrator block below, because the
// pass that only READS the image (the height fog) deliberately does not define the LUT callback macros
// the integrator is guarded on — and it still has to address it. Graphic::kDistantLightSphereTexel
// states the same number on the C++ side; the value it holds is defined by SkyDistantLight below.
const int SKY_DISTANT_LIGHT_SPHERE_TEXEL = 0; // the full sphere — the height fog's ambient

// ---- The single-scattering integrator (Hillaire section 4, with the multi-scattering LUT) ----------

#ifdef SKY_SCATTERING_SUN_TRANSMITTANCE

struct SkyScatterResult
{
    vec3 Luminance;     // in-scattered light along the ray, camera to the shell exit (or the ground)
    vec3 Transmittance; // what survives the same trip — the sky pass's alpha lane
};

// ONE marched step of the atmosphere, and the only place the source function is written. Both consumers
// go through it — the distant-sky march below and the aerial-perspective volume's froxel walk — because
// two spellings of one integrand is this project's most expensive defect class, and here it would show
// as terrain haze that disagrees with the sky it fades into.
//
// Frostbite's analytic arrangement: the source is constant over the segment, so source x transmittance
// integrates in closed form and the step is exact for any dt the medium is smooth over.
//
// Returns the segment's own contribution in .Luminance — NOT yet multiplied by the throughput the caller
// has accumulated — and the segment's transmittance in .Transmittance.
//
// @p position is PLANET-CENTRED. The radius is clamped to the planet surface, so a ray that has walked
// below the ground (a flat scene on a spherical atmosphere does that past the horizon distance) sees
// sea-level density rather than an exponential that runs away.
SkyScatterResult SkyIntegrateStep(SkyAtmParams p, vec3 position, vec3 sunDir, vec3 sunIlluminance,
                                  float phaseRayleigh, float phaseMie, float dt)
{
    float radius   = max(length(position), p.BottomRadiusKm);
    vec3  zenith   = position / radius;
    float altitude = radius - p.BottomRadiusKm;

    // One density evaluation per sample; scattering split per species because each carries its own
    // phase, extinction assembled from the same densities.
    float dRayleigh = SkyDensityRayleigh(p, altitude);
    float dMie      = SkyDensityMie(p, altitude);
    float dOzone    = SkyDensityOzone(p, altitude);

    vec3 scatterRayleigh = p.RayleighScattering * dRayleigh;
    vec3 scatterMie      = p.MieScattering * dMie;
    vec3 extinction =
         scatterRayleigh + scatterMie + p.MieAbsorption * dMie + p.OzoneAbsorption * dOzone;

    vec3 stepTransmittance = exp(-extinction * dt);
    vec3 safeExtinction    = max(extinction, vec3(1e-6f, 1e-6f, 1e-6f));

    float sunZenithCos = dot(zenith, sunDir);
    float planetShadow = SkyPlanetShadow(radius, sunZenithCos, p.BottomRadiusKm);

    vec3 sunTransmittance = SKY_SCATTERING_SUN_TRANSMITTANCE(p, radius, sunZenithCos);
    vec3 psiMs            = SKY_SCATTERING_MULTI_SCATTER(p, radius, sunZenithCos);

    vec3 source =
         sunIlluminance *
         (planetShadow * sunTransmittance * (phaseRayleigh * scatterRayleigh + phaseMie * scatterMie) +
          psiMs * (scatterRayleigh + scatterMie));

    SkyScatterResult step;
    step.Luminance     = (source - source * stepTransmittance) / safeExtinction;
    step.Transmittance = stepTransmittance;
    return step;
}

// March a view ray through the atmosphere. @p originKm is PLANET-CENTRED (|originKm| = the view
// height r); @p rayDir and @p sunDir are unit directions in the same frame; @p sunIlluminance is the
// outer-space sun illuminance the whole result is linear in.
//
// Per step, Frostbite's analytic form integrates source x transmittance exactly over the segment
// (the arrangement the multi-scattering LUT already uses), with:
//   * sun transmittance from the transmittance LUT via SKY_SCATTERING_SUN_TRANSMITTANCE;
//   * the analytic planet shadow above, faded across the terminator (no geometry shadow map enters
//     the sky's own march, in this phase or the last);
//   * the multi-scattering LUT's Psi_ms via SKY_SCATTERING_MULTI_SCATTER, deliberately NOT attenuated
//     by the planet shadow or the sun transmittance — Psi already represents light diffused through
//     the whole sky, which is exactly why twilight is not pitch black.
//
// Samples follow the paper's squared distribution, t = tMax * (i/N)^2: half the samples land in the
// nearest quarter of the ray, where the camera-adjacent air dominates the picture.
SkyScatterResult SkyIntegrateScatteredLuminance(SkyAtmParams p, vec3 originKm, vec3 rayDir, vec3 sunDir,
                                                vec3 sunIlluminance, int sampleCount)
{
    float r0 = max(length(originKm), p.BottomRadiusKm + SKY_PLANET_RADIUS_OFFSET_KM);
    float mu = dot(originKm, rayDir) / max(length(originKm), 1.0f);

    bool  hitsGround = SkyIntersectsGround(r0, mu, p.BottomRadiusKm);
    float tMax       = hitsGround ? SkyDistanceToBottom(r0, mu, p.BottomRadiusKm)
                                  : SkyDistanceToTop(r0, mu, p.TopRadiusKm);

    // Phase angles are constant along a straight ray: cosTheta = +1 when looking INTO the sun (the
    // light travels -sunDir, the scattered direction toward the eye is -rayDir).
    float cosTheta      = dot(rayDir, sunDir);
    float phaseRayleigh = SkyPhaseRayleigh(cosTheta);
    float phaseMie      = SkyPhaseCornetteShanks(p.MiePhaseG, cosTheta);

    vec3 luminance  = vec3(0.0f, 0.0f, 0.0f);
    vec3 throughput = vec3(1.0f, 1.0f, 1.0f);

    float tPrev = 0.0f;
    for (int i = 0; i < sampleCount; ++i)
    {
        float u     = (float(i) + 1.0f) / float(sampleCount);
        float tNext = tMax * u * u;
        float dt    = max(tNext - tPrev, 0.0f);
        float t     = tPrev + dt * 0.5f;
        tPrev       = tNext;

        vec3 position = originKm + rayDir * t;

        SkyScatterResult step =
             SkyIntegrateStep(p, position, sunDir, sunIlluminance, phaseRayleigh, phaseMie, dt);

        luminance += throughput * step.Luminance;
        throughput = throughput * step.Transmittance;
    }

    SkyScatterResult result;
    result.Luminance     = luminance;
    result.Transmittance = throughput;
    return result;
}

// ---- The aerial-perspective volume's froxel walk ---------------------------------------------------
// Integrate ONE froxel's segment [tStartKm, tEndKm] of the camera ray and hand back the RUNNING
// accumulators, so the fill walks a single ray outward slice by slice and each slice's stored value is
// the integral from the camera to that slice — never an independent march.
//
// That distinction is the whole reason this function exists rather than N calls to the integrator above.
// Re-marching from the camera for every slice (the obvious implementation) gives consecutive slices
// slightly different quadrature, and the difference is not noise: it is a step at each slice boundary
// that trilinear filtering cannot hide, and it is exactly the banding a 16-slice volume over 96 km is
// notorious for. Carried accumulators make slice k's value equal slice k-1's plus one segment BY
// CONSTRUCTION, so the sequence is monotone in luminance and in optical depth whatever the sampling is.
//
// @p originKm is PLANET-CENTRED (|originKm| = the camera's distance from the planet centre); @p rayDir
// and @p sunDir are unit directions in the same frame. An empty or inverted segment returns the
// accumulators untouched, which is what makes the froxel at zero distance the identity of the composite
// (no in-scatter, full transmittance) instead of a colour shift on a surface touching the lens.
SkyScatterResult SkyApIntegrateSegment(SkyAtmParams p, vec3 originKm, vec3 rayDir, vec3 sunDir,
                                       vec3 sunIlluminance, float tStartKm, float tEndKm,
                                       vec3 luminanceIn, vec3 transmittanceIn)
{
    SkyScatterResult result;
    result.Luminance     = luminanceIn;
    result.Transmittance = transmittanceIn;

    float spanKm = tEndKm - tStartKm;
    if (spanKm <= 0.0f)
        return result;

    int   sampleCount = SkyApSegmentSampleCount(spanKm);
    float dt          = spanKm / float(sampleCount);

    // Constant along a straight ray, so they are hoisted out of the sub-steps exactly as the distant-sky
    // march hoists them.
    float cosTheta      = dot(rayDir, sunDir);
    float phaseRayleigh = SkyPhaseRayleigh(cosTheta);
    float phaseMie      = SkyPhaseCornetteShanks(p.MiePhaseG, cosTheta);

    for (int i = 0; i < sampleCount; ++i)
    {
        float t        = tStartKm + (float(i) + 0.5f) * dt;
        vec3  position = originKm + rayDir * t;

        SkyScatterResult step =
             SkyIntegrateStep(p, position, sunDir, sunIlluminance, phaseRayleigh, phaseMie, dt);

        result.Luminance     = result.Luminance + result.Transmittance * step.Luminance;
        result.Transmittance = result.Transmittance * step.Transmittance;
    }
    return result;
}

// ---- The distant sky light (UE's Distant Sky Light LUT) --------------------------------------------
// ONE value for the whole frame: the average radiance of the sky as seen from near the ground. UE
// evaluates the sky in a fixed set of directions at a fixed altitude and averages them into a single
// float4, and its height fog reads that value as its ambient in-scattering. Ours does the same.
//
// WHY AN AVERAGE OVER A FIXED DIRECTION SET, and not "the zenith colour" or "the dome, weighted": the
// quantity a fog pixel wants is the mean radiance arriving from every direction, which is exactly the
// integral of L over the sphere divided by 4pi. The 8x8 grid of SkyUniformSphereDirection cells is
// area-uniform, so the plain mean of its 64 samples IS that integral's midpoint estimate — no solid
// angle weights, no normalisation constant that can go missing.
//
// The altitude is 6 km (UE's r.SkyAtmosphere.DistantSkyLightLUT.Altitude). It is deliberately NOT the
// camera's: this is the light of the DISTANT sky, the value a fog kilometres away is lit by, and
// anchoring it at the camera would make the fog's colour change as the camera climbs a hill.

const float SKY_DISTANT_LIGHT_ALTITUDE_KM = 6.0f;
const int   SKY_DISTANT_LIGHT_DIRECTIONS  = 64; // the 8x8 area-uniform grid
const int   SKY_DISTANT_LIGHT_SAMPLES     = 32; // per-direction march budget, the bake's

// Direction @p index of the fixed set, 0 .. SKY_DISTANT_LIGHT_DIRECTIONS-1, in the frame whose +Y is
// the zenith. Integer division and modulo agree between GLSL and C++ for non-negative operands, which
// is what lets one workgroup thread take index gl_LocalInvocationIndex and the C++ reference take the
// same index in a loop and get the same direction.
vec3 SkyDistantLightDirection(int index)
{
    int row = index / 8;
    int col = index - row * 8;
    return SkyUniformSphereDirection((float(row) + 0.5f) / 8.0f, (float(col) + 0.5f) / 8.0f);
}

// The radiance along ONE of those directions. Composed exactly as the IBL bake composes a panorama
// texel — the marched air, plus the lit ground under it where the ray reaches the surface — because
// the two are the same quantity sampled at different resolutions, and a fog lit by one while the
// reflections are lit by the other is this project's most expensive defect class wearing a new hat.
vec3 SkyDistantLightRadiance(SkyAtmParams p, vec3 rayDir, vec3 sunDir, vec3 sunIlluminance,
                             float altitudeKm, int sampleCount)
{
    vec3 originKm = vec3(0.0f, p.BottomRadiusKm + altitudeKm, 0.0f);

    SkyScatterResult result =
         SkyIntegrateScatteredLuminance(p, originKm, rayDir, sunDir, sunIlluminance, sampleCount);

    vec3 radiance = result.Luminance;

    if (SkyIntersectsGround(originKm.y, rayDir.y, p.BottomRadiusKm))
    {
        float sunZenithCos = clamp(sunDir.y, -1.0f, 1.0f);
        vec3  sunT         = SKY_SCATTERING_SUN_TRANSMITTANCE(
             p, p.BottomRadiusKm + SKY_PLANET_RADIUS_OFFSET_KM, sunZenithCos);
        float viewT =
             (result.Transmittance.x + result.Transmittance.y + result.Transmittance.z) / 3.0f;
        radiance = radiance + SkyGroundLuminance(p, sunIlluminance, sunT, sunZenithCos) * viewT;
    }
    return radiance;
}

// The whole value, spelled sequentially. The GPU pass evaluates the 64 directions in parallel and sums
// them in groupshared memory; this loop is the same sum with the same per-direction function and the
// same divisor, which is what the tests drive and what makes "the shader agrees with the reference" a
// statement about arithmetic rather than about two similar-looking listings.
vec3 SkyDistantLight(SkyAtmParams p, vec3 sunDir, vec3 sunIlluminance)
{
    vec3 sum = vec3(0.0f, 0.0f, 0.0f);
    for (int i = 0; i < SKY_DISTANT_LIGHT_DIRECTIONS; ++i)
    {
        sum = sum + SkyDistantLightRadiance(p, SkyDistantLightDirection(i), sunDir, sunIlluminance,
                                            SKY_DISTANT_LIGHT_ALTITUDE_KM, SKY_DISTANT_LIGHT_SAMPLES);
    }
    return sum / float(SKY_DISTANT_LIGHT_DIRECTIONS);
}

#endif // SKY_SCATTERING_SUN_TRANSMITTANCE

#endif // SKY_SCATTERING_GLSLH
