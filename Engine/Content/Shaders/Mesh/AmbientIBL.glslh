#ifndef AMBIENT_IBL_GLSLH
#define AMBIENT_IBL_GLSLH

// THE ambient term of this engine's PBR — one text, compiled by every shader that has one.
//
// Why it is a header and not four copies: the forward mesh shaders and the deferred lighting pass shade
// the SAME materials in the SAME scene, and a scene picks which of them runs with a single enum field.
// While the deferred composite carried its own ambient (a flat `vec3(0.08)` that read no environment
// cube at all) the two paths disagreed catastrophically — the owner saw ground and buildings almost
// black under a bright sky, and flipping RenderingPath from 1 to 0 lit them. That is the "two
// implementations of one quantity" shape this project has now paid for several times; the cure is not a
// test that the copies still agree but a single copy that cannot disagree.
//
// It is split in two on purpose:
//   * EvaluateAmbientIBL is PURE ALGEBRA over already-fetched samples. It declares no sampler, so it
//     also compiles as C++ (see Desert/Tests/Engine/AmbientIBL) and the split-sum identity can be
//     asserted without a GPU.
//   * AmbientIBL does the three fetches and calls it. It names u_EnvIrradianceTex / u_EnvSpecularTex /
//     u_BRDFLUTTexture and the `skyLook` block (Common/SkyLook.glslh), which the includer must have
//     declared. Define AMBIENT_IBL_NO_SAMPLERS to take only the algebra half.
//
// Requires Mesh/PBRFunctions.glslh (fresnelSchlick) to have been included first.

// The anti-black epsilon, and NOT an ambient model. Real ambient comes from the environment cubes above;
// this only keeps a fully-occluded face with no environment bound from reading as a pure-black hole. It
// is deliberately two orders of magnitude below the old deferred constant so it cannot double-count the
// sky the way that constant did. Multiply it by albedo * ao at the call site.
const vec3 PBR_AMBIENT_FLOOR = vec3(0.008, 0.009, 0.012);

// Split-sum image-based lighting (Karis 2013) from samples the caller already took:
//   irradiance    — the diffuse irradiance cube at N (exitant radiance for a Lambertian BRDF, so it is
//                   NOT divided by PI again here);
//   prefiltered   — the GGX-prefiltered radiance cube at reflect(-view, N), roughness-selected mip;
//   specularBRDF  — the .rg of the split-sum BRDF LUT at (cosLo, roughness);
//   cosLo         — max(0, dot(N, view)).
// The Fresnel term uses cosLo rather than a half-vector angle because the prefiltered cube integrates
// over many incident directions and there is no single L to build an H from (Lagarde 2011).
vec3 EvaluateAmbientIBL(vec3 irradiance, vec3 prefiltered, vec2 specularBRDF, vec3 F0, vec3 albedo,
                        float metalness, float cosLo)
{
	vec3 F  = fresnelSchlick(F0, cosLo);
	vec3 kd = mix(vec3(1.0) - F, vec3(0.0), metalness);

	vec3 diffuseIBL  = kd * albedo * irradiance;
	vec3 specularIBL = (F0 * specularBRDF.x + specularBRDF.y) * prefiltered;

	return diffuseIBL + specularIBL;
}

// The whole ambient contribution of a surface, assembled — and the reason this is a function rather
// than one line at each of the four call sites. The pieces are not interchangeable in how they meet
// albedo: EvaluateAmbientIBL has ALREADY folded albedo into its diffuse half (and deliberately not into
// its specular half, because a reflection is not tinted by the surface it leaves), while `indirect`
// arrives as INCIDENT light from a bounce gather and still has to be reflected. Getting that backwards
// is a whole-frame error that looks like a tuning problem.
//
//   ibl       — EvaluateAmbientIBL / AmbientIBL for this surface;
//   albedo    — linear base colour;
//   ao        — the occlusion factor, 1 = unoccluded. It attenuates the ENTIRE ambient, which is what
//               makes it ambient occlusion and not a second albedo;
//   indirect  — one-bounce incident light, vec3(0.0) where the path has no GI (the forward mesh
//               shaders); the deferred composite passes its screen-space or RSM gather here.
vec3 ComposeAmbient(vec3 ibl, vec3 albedo, float ao, vec3 indirect)
{
	return ibl * ao + albedo * ao * (PBR_AMBIENT_FLOOR + indirect);
}

#ifndef AMBIENT_IBL_NO_SAMPLERS

#include <Common/SkyLook.glslh>

// The sampling half. `view` points from the surface toward the eye; `N` is the world-space shading
// normal; `roughness` must already be clamped away from 0 by the caller (the GGX mip selection is linear
// in it, so an unclamped 0 lands on mip 0 for a mirror, which is correct — the clamp is the NDF's).
//
// Both cube fetches go through the sky's look (Common/SkyLook.glslh): the cubes are the file as
// authored, and the scene's rotation and gain turn and scale the lookup — the same two calls the skybox
// pass draws the backdrop with, so a chrome ball reflects what is visible behind it.
vec3 AmbientIBL(vec3 view, vec3 N, vec3 F0, float metalness, float roughness, vec3 albedo)
{
	vec2  yaw        = skyLook.YawCosSin.xy;
	vec3  gain       = skyLook.Gain.rgb;
	vec3  irradiance = ApplySkyGain(texture(u_EnvIrradianceTex, SkyLookDirection(N, yaw)).rgb, gain);
	float cosLo      = max(0.0, dot(N, view));

	// reflect(-view, N) = 2*dot(N,view)*N - view (unclamped, correct specular reflection)
	vec3 Lr = reflect(-view, N);

	int  specularTextureLevels = textureQueryLevels(u_EnvSpecularTex);
	vec3 specularIrradiance    = ApplySkyGain(
	     textureLod(u_EnvSpecularTex, SkyLookDirection(Lr, yaw), roughness * specularTextureLevels).rgb, gain);

	vec2 specularBRDF = texture(u_BRDFLUTTexture, vec2(cosLo, roughness)).rg;

	return EvaluateAmbientIBL(irradiance, specularIrradiance, specularBRDF, F0, albedo, metalness, cosLo);
}

#endif // AMBIENT_IBL_NO_SAMPLERS

#endif // AMBIENT_IBL_GLSLH
