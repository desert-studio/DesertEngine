#ifndef POINTLIGHT_GLSLH
#define POINTLIGHT_GLSLH

#include "PBRFunctions.glslh"
#include "DirectLighting.glslh"

// std430 layout — must match ShaderProtocols::PointLightPayload (48 bytes).
struct PointLight {
    vec3  color;
    float intensity;
    vec3  position;
    float radius;
    float minRadius;
    int   falloff;     // LightFalloff: 0=Linear, 1=Quadratic, 2=InverseSquare
    vec2  _pad;
};

// Unbounded storage buffer — no MAX_POINT_LIGHT cap. Count comes from LightsMetadata.PointLightCount.
ReadBuffer(6) PointLightsUB
{
    PointLight pointLights[];
};

// HSV hue (0..1) -> fully-saturated RGB.
vec3 HueToRGB(float h)
{
    vec3 c = abs(fract(h + vec3(0.0, 1.0/3.0, 2.0/3.0)) * 6.0 - 3.0) - 1.0;
    return clamp(c, 0.0, 1.0);
}

// Stable, distinct debug color per light index (for the "color per source" lighting debug view).
// Golden-ratio hue stepping on the SMALL per-type index (0,1,2,...) gives well-spread colors; callers
// must pass the per-type index (not a globally offset one) so different types don't collide near red.
vec3 LightDebugColor(uint i)
{
    return HueToRGB(fract(float(i) * 0.61803398875));
}

// What this light contributes: its own distance falloff, then THE shared direct-light BRDF. The BRDF
// used to be spelled out here as well, which made this the third of four copies of one formula in the
// engine — and the copies had drifted (the forward mesh shaders' sun was missing the /PI this one had,
// so a point light and the sun of equal intensity did not agree on the same surface). Everything that
// is specific to a point light is above the call; everything shared is behind it.
vec3 CalculatePointLight(PointLight light, vec3 worldPosition, vec3 view, vec3 N, vec3 F0, float metalness, float roughness, vec3 albedo)
{
    vec3 L = light.position - worldPosition;
    float distance = length(L);

    L = normalize(L);

    float attenuation = LightFalloffFactor(distance, light.minRadius, light.radius, light.falloff);
    vec3 radiance = light.color * light.intensity * attenuation;

    return EvaluateDirectLight(L, radiance, view, N, F0, metalness, roughness, albedo);
}

// Scalar "how much this point light lands here" (color-agnostic) for the lighting debug view.
float PointLightContribution(PointLight light, vec3 worldPosition, vec3 N)
{
    vec3  L    = light.position - worldPosition;
    float dist = length(L);
    float cosLi = max(dot(N, normalize(L)), 0.0);
    if (cosLi <= 0.0) return 0.0;
    float attenuation = LightFalloffFactor(dist, light.minRadius, light.radius, light.falloff);
    return attenuation * cosLi * light.intensity;
}

#endif // POINTLIGHT_GLSLH
