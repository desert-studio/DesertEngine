# BuildScripts/ThirdParty/OpenEXR.lua: OpenEXRCore (the C core: .exr texture sources) with its bundled zstd
# (decoder + encoder C sources, no asm) and OpenJPH (portable code, every SIMD variant removed), one static library.
# The config headers OpenEXR's and Imath's own CMake would configure are written into build/generated/openexr/include
# at configure time -- the path the Editor, GamePackager and TextureCook include.
# OpenEXR's own CMakeLists.txt is not used: it builds the C++ Imf library, the tools and its own Imath/Deflate targets.
set(_root "${DESERT_ROOT}/ThirdParty/openexr")
set(_imath "${DESERT_ROOT}/ThirdParty/Imath")
set(_core "${_root}/src/lib/OpenEXRCore")
set(_zstd "${_root}/external/zstd/lib")
set(_ojph "${_root}/external/OpenJPH/src/core")
set(_generated "${DESERT_ROOT}/build/generated/openexr/include")
if(NOT EXISTS "${_core}/openexr.h" OR NOT EXISTS "${_imath}/src/Imath/half.h")
    message(FATAL_ERROR "ThirdParty/openexr or ThirdParty/Imath is empty. Both are submodules: run "
                        "`git submodule update --init --recursive`.")
endif()

function(_desert_exr_define path name out)
    file(READ "${path}" _text)
    if(NOT _text MATCHES "#[ \t]*define[ \t]+${name}[ \t]+([0-9]+)")
        message(FATAL_ERROR "OpenEXR.cmake: cannot read ${name} from ${path}")
    endif()
    set(${out} ${CMAKE_MATCH_1} PARENT_SCOPE)
endfunction()

# configure_file's job, with the same refusal premake had: an @VAR@ without a value fails configure.
# Values are variables named _v_<NAME>; a #cmakedefine is on when _d_<NAME> is true.
function(_desert_exr_substitute template out)
    set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${template}")
    file(READ "${template}" _text)
    string(REGEX MATCHALL "#cmakedefine01[ \t]+[A-Za-z0-9_]+" _defs01 "${_text}")
    foreach(d IN LISTS _defs01)
        string(REGEX REPLACE "^#cmakedefine01[ \t]+" "" _name "${d}")
        if(_d_${_name})
            string(REPLACE "${d}" "#define ${_name} 1" _text "${_text}")
        else()
            string(REPLACE "${d}" "#define ${_name} 0" _text "${_text}")
        endif()
    endforeach()
    string(REGEX MATCHALL "#cmakedefine[ \t]+[A-Za-z0-9_]+[^\n]*" _defs "${_text}")
    foreach(d IN LISTS _defs)
        string(REGEX MATCH "^#cmakedefine[ \t]+([A-Za-z0-9_]+)" _ "${d}")
        set(_name "${CMAKE_MATCH_1}")
        if(_d_${_name})
            string(REPLACE "${d}" "#define ${_name} 1" _text "${_text}")
        else()
            string(REPLACE "${d}" "/* #undef ${_name} */" _text "${_text}")
        endif()
    endforeach()
    string(REGEX MATCHALL "@[A-Za-z0-9_]+@" _refs "${_text}")
    list(REMOVE_DUPLICATES _refs)
    foreach(ref IN LISTS _refs)
        string(REPLACE "@" "" _name "${ref}")
        if(NOT DEFINED _v_${_name})
            message(FATAL_ERROR "OpenEXR.cmake: no value for ${ref} in ${template}")
        endif()
        string(REPLACE "${ref}" "${_v_${_name}}" _text "${_text}")
    endforeach()
    set(${out} "${_text}" PARENT_SCOPE)
endfunction()

_desert_exr_define("${_core}/openexr_version.h" OPENEXR_VERSION_MAJOR _v_OPENEXR_VERSION_MAJOR)
_desert_exr_define("${_core}/openexr_version.h" OPENEXR_VERSION_MINOR _v_OPENEXR_VERSION_MINOR)
_desert_exr_define("${_core}/openexr_version.h" OPENEXR_VERSION_PATCH _v_OPENEXR_VERSION_PATCH)
_desert_exr_define("${_ojph}/openjph/ojph_version.h" OPENJPH_VERSION_MAJOR _v_openjph_VERSION_MAJOR)
_desert_exr_define("${_ojph}/openjph/ojph_version.h" OPENJPH_VERSION_MINOR _v_openjph_VERSION_MINOR)
_desert_exr_define("${_ojph}/openjph/ojph_version.h" OPENJPH_VERSION_PATCH _v_openjph_VERSION_PATCH)
_desert_exr_define("${_zstd}/zstd.h" ZSTD_VERSION_MAJOR _v_zstd_VERSION_MAJOR)
_desert_exr_define("${_zstd}/zstd.h" ZSTD_VERSION_MINOR _v_zstd_VERSION_MINOR)
_desert_exr_define("${_zstd}/zstd.h" ZSTD_VERSION_RELEASE _v_zstd_VERSION_PATCH)
file(READ "${_imath}/CMakeLists.txt" _imath_cmake)
if(NOT _imath_cmake MATCHES "project[ \t]*\\([ \t]*Imath[ \t]+VERSION[ \t]+([0-9.]+)")
    message(FATAL_ERROR "OpenEXR.cmake: cannot read Imath's version from ThirdParty/Imath/CMakeLists.txt")
endif()
set(_imath_tag "${CMAKE_MATCH_1}")
string(REGEX MATCH "^[0-9]+\\.([0-9]+)\\.([0-9]+)" _ "${_imath_tag}")
set(_exr_version "${_v_OPENEXR_VERSION_MAJOR}.${_v_OPENEXR_VERSION_MINOR}.${_v_OPENEXR_VERSION_PATCH}")
set(_v_OPENEXR_LIB_SOVERSION 0)
set(_v_Imath_SOVERSION 0)
set(_v_Imath_VERSION_MAJOR 3)
set(_v_Imath_VERSION_MINOR ${CMAKE_MATCH_1})
set(_v_Imath_VERSION_PATCH ${CMAKE_MATCH_2})
set(_v_OPENEXR_NAMESPACE_CUSTOM 0)
set(_v_OPENEXR_INTERNAL_IMF_NAMESPACE Imf_3_5)
set(_v_OPENEXR_IMF_NAMESPACE Imf)
set(_v_OPENEXR_VERSION "${_exr_version}")
set(_v_OPENEXR_PACKAGE_NAME "OpenEXR ${_exr_version}")
set(_v_OPENEXR_VERSION_RELEASE_TYPE "")
set(_v_OPENEXR_LIB_VERSION "${_exr_version}")
set(_v_ILMTHREAD_NAMESPACE_CUSTOM 0)
set(_v_ILMTHREAD_INTERNAL_NAMESPACE IlmThread_3_5)
set(_v_ILMTHREAD_NAMESPACE IlmThread)
set(_v_IMATH_NAMESPACE_CUSTOM 0)
set(_v_IMATH_INTERNAL_NAMESPACE Imath_3_2)
set(_v_IMATH_NAMESPACE Imath)
set(_v_IMATH_VERSION "${_imath_tag}")
set(_v_IMATH_PACKAGE_NAME "Imath ${_imath_tag}")
set(_v_IMATH_VERSION_RELEASE_TYPE "")
set(_v_IMATH_LIB_VERSION "${_imath_tag}")
set(_d_OPENEXR_USE_INTERNAL_DEFLATE ON)
set(_d_OPENEXR_USE_INTERNAL_ZSTD ON)
set(_d_OPENEXR_IMF_HAVE_DARWIN ${DESERT_IS_MACOS})
set(_d_ILMTHREAD_THREADING_ENABLED ON)
set(_d_IMATH_USE_NOEXCEPT ON)

_desert_exr_substitute("${_root}/cmake/OpenEXRConfig.h.in" _text)
desert_write_generated("${_generated}/OpenEXRConfig.h" "${_text}")
_desert_exr_substitute("${_root}/cmake/OpenEXRConfigInternal.h.in" _text)
desert_write_generated("${_generated}/OpenEXRConfigInternal.h" "${_text}")
_desert_exr_substitute("${_root}/cmake/IlmThreadConfig.h.in" _text)
desert_write_generated("${_generated}/IlmThreadConfig.h" "${_text}")
_desert_exr_substitute("${_imath}/config/ImathConfig.h.in" _text)
desert_write_generated("${_generated}/Imath/ImathConfig.h" "${_text}")
desert_write_generated("${_generated}/ImathConfig.h" "${_text}")

file(GLOB _core_src CONFIGURE_DEPENDS "${_core}/*.c" "${_core}/*.cpp" "${_core}/*.h")
file(GLOB _ojph_src CONFIGURE_DEPENDS
    "${_ojph}/codestream/*.cpp" "${_ojph}/coding/*.cpp" "${_ojph}/others/*.cpp" "${_ojph}/others/*.c"
    "${_ojph}/transform/*.cpp")
list(FILTER _ojph_src EXCLUDE REGEX "_(sse|sse2|ssse3|avx|avx2|avx512|wasm|vsx)\\.cpp$")
list(SORT _core_src)
list(SORT _ojph_src)
set(_zstd_src
    common/debug.c common/entropy_common.c common/error_private.c common/fse_decompress.c common/pool.c
    common/threading.c common/xxhash.c common/zstd_common.c
    compress/fse_compress.c compress/hist.c compress/huf_compress.c compress/zstd_compress.c
    compress/zstd_compress_literals.c compress/zstd_compress_sequences.c compress/zstd_compress_superblock.c
    compress/zstd_double_fast.c compress/zstd_fast.c compress/zstd_lazy.c compress/zstd_ldm.c compress/zstd_opt.c
    compress/zstd_preSplit.c compress/zstdmt_compress.c
    decompress/huf_decompress.c decompress/zstd_ddict.c decompress/zstd_decompress.c decompress/zstd_decompress_block.c)
list(TRANSFORM _zstd_src PREPEND "${_zstd}/")
desert_add_library(OpenEXRCore FOLDER ThirdParty SOURCES ${_core_src} ${_zstd_src} ${_ojph_src})
desert_warnings_off(OpenEXRCore)  # premake: warnings "Off"
set_target_properties(OpenEXRCore PROPERTIES CXX_STANDARD 17 C_STANDARD 11)
target_include_directories(OpenEXRCore PRIVATE
    "${_core}" "${_generated}" "${_imath}/src/Imath" "${_zstd}" "${_ojph}" "${_ojph}/openjph" "${_ojph}/shared")
target_compile_definitions(OpenEXRCore PRIVATE ZSTD_DISABLE_ASM OJPH_DISABLE_SIMD _FILE_OFFSET_BITS=64)
if(DESERT_IS_WINDOWS)
    target_compile_definitions(OpenEXRCore PRIVATE _CRT_SECURE_NO_WARNINGS WIN32_LEAN_AND_MEAN)
else()
    set_target_properties(OpenEXRCore PROPERTIES POSITION_INDEPENDENT_CODE ON)
    target_compile_definitions(OpenEXRCore PRIVATE OJPH_POSIX_MEMALIGN_EXISTS)
endif()
