# BuildScripts/ThirdParty/Opus.lua: libopus, float build. The source lists are read from upstream's own *.mk
# files, so a submodule bump cannot leave this file listing a stale set.
set(_root "${DESERT_ROOT}/ThirdParty/opus")
if(NOT EXISTS "${_root}/include/opus.h")
    message(FATAL_ERROR "ThirdParty/opus is empty. It is a submodule: run `git submodule update --init ThirdParty/opus`.")
endif()
# A list is `NAME = \` followed by continuation lines. Read as text with the continuations joined (file(STRINGS)
# cannot be used: a trailing backslash escapes the list separator and glues lines together).
function(_desert_opus_make_list mk name out)
    set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_root}/${mk}")
    file(READ "${_root}/${mk}" _text)
    string(REPLACE "\r" "" _text "${_text}")
    string(REPLACE ";" "," _text "${_text}")
    string(REPLACE "\\n" " " _text "${_text}")
    string(REPLACE "\n" ";" _lines "${_text}")
    set(_found OFF)
    foreach(line IN LISTS _lines)
        if(line MATCHES "^${name} = (.*)$")
            set(_found ON)
            string(REGEX MATCHALL "[A-Za-z0-9_/.]+\.c" _paths "${CMAKE_MATCH_1}")
            break()
        endif()
    endforeach()
    if(NOT _found)
        message(FATAL_ERROR "Opus.cmake: no list ${name} in ${_root}/${mk}")
    endif()
    list(TRANSFORM _paths PREPEND "${_root}/")
    set(${out} ${_paths} PARENT_SCOPE)
endfunction()
_desert_opus_make_list(celt_sources.mk CELT_SOURCES _celt)
_desert_opus_make_list(silk_sources.mk SILK_SOURCES _silk)
_desert_opus_make_list(silk_sources.mk SILK_SOURCES_FLOAT _silk_float)
_desert_opus_make_list(opus_sources.mk OPUS_SOURCES _opus)
_desert_opus_make_list(opus_sources.mk OPUS_SOURCES_FLOAT _opus_float)
desert_add_library(Opus FOLDER ThirdParty SOURCES ${_celt} ${_silk} ${_silk_float} ${_opus} ${_opus_float})
set_target_properties(Opus PROPERTIES C_STANDARD 11)
target_include_directories(Opus PRIVATE
    "${_root}/include" "${_root}/celt" "${_root}/silk" "${_root}/silk/float" "${_root}")
target_compile_definitions(Opus PRIVATE OPUS_BUILD USE_ALLOCA HAVE_LRINTF)
desert_optimize_speed(Opus)
if(DESERT_IS_WINDOWS)
    target_compile_definitions(Opus PRIVATE _CRT_SECURE_NO_WARNINGS)
else()
    set_target_properties(Opus PROPERTIES POSITION_INDEPENDENT_CODE ON)
endif()
