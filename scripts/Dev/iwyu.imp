# include-what-you-use mappings for this tree (scripts/Dev/iwyu.sh): a private header of a library -> the public
# header the project includes. Without them IWYU proposes glm/detail, entt/entity, spdlog/details or libc++'s __ headers.
[
  # C++ library: libc++'s implementation headers (<__vector/vector.h>, <__fwd/string.h>, ...) are never included.
  { include: ["@<__fwd/string.h>", "private", "<string>", "public"] },
  { include: ["@<__fwd/string_view.h>", "private", "<string_view>", "public"] },
  { include: ["@<__fwd/sstream.h>", "private", "<sstream>", "public"] },
  { include: ["@<__fwd/fstream.h>", "private", "<fstream>", "public"] },
  { include: ["@<__fwd/ostream.h>", "private", "<ostream>", "public"] },
  { include: ["@<__fwd/istream.h>", "private", "<istream>", "public"] },
  { include: ["@<__fwd/array.h>", "private", "<array>", "public"] },
  { include: ["@<__fwd/span.h>", "private", "<span>", "public"] },
  { include: ["@<__fwd/pair.h>", "private", "<utility>", "public"] },
  { include: ["@<__fwd/tuple.h>", "private", "<tuple>", "public"] },
  { include: ["@<__fwd/memory_resource.h>", "private", "<memory_resource>", "public"] },
  { include: ["@<__memory/.*>", "private", "<memory>", "public"] },
  { include: ["@<__functional/.*>", "private", "<functional>", "public"] },
  { include: ["@<__utility/.*>", "private", "<utility>", "public"] },
  { include: ["@<__algorithm/.*>", "private", "<algorithm>", "public"] },
  { include: ["@<__numeric/.*>", "private", "<numeric>", "public"] },
  { include: ["@<__iterator/.*>", "private", "<iterator>", "public"] },
  { include: ["@<__ranges/.*>", "private", "<ranges>", "public"] },
  { include: ["@<__chrono/.*>", "private", "<chrono>", "public"] },
  { include: ["@<__filesystem/.*>", "private", "<filesystem>", "public"] },
  { include: ["@<__format/.*>", "private", "<format>", "public"] },
  { include: ["@<__mutex/.*>", "private", "<mutex>", "public"] },
  { include: ["@<__thread/.*>", "private", "<thread>", "public"] },
  { include: ["@<__atomic/.*>", "private", "<atomic>", "public"] },
  { include: ["@<__string/.*>", "private", "<string>", "public"] },
  { include: ["@<__system_error/.*>", "private", "<system_error>", "public"] },
  { include: ["@<__concepts/.*>", "private", "<concepts>", "public"] },
  { include: ["@<__type_traits/.*>", "private", "<type_traits>", "public"] },
  { include: ["@<__math/.*>", "private", "<cmath>", "public"] },
  { include: ["@<__random/.*>", "private", "<random>", "public"] },
  { include: ["@<__variant/.*>", "private", "<variant>", "public"] },
  { include: ["@<__tuple/.*>", "private", "<tuple>", "public"] },
  { include: ["@<__exception/.*>", "private", "<exception>", "public"] },
  { include: ["@<__bit/.*>", "private", "<bit>", "public"] },
  { include: ["@<__compare/.*>", "private", "<compare>", "public"] },
  { include: ["@<__condition_variable/.*>", "private", "<condition_variable>", "public"] },
  { include: ["@<__ios/.*>", "private", "<ios>", "public"] },
  { include: ["@<__stop_token/.*>", "private", "<stop_token>", "public"] },
  { include: ["@<__hash_table>", "private", "<unordered_map>", "public"] },
  { include: ["@<__tree>", "private", "<map>", "public"] },
  { include: ["@<__split_buffer>", "private", "<vector>", "public"] },
  { include: ["@<__bit_reference>", "private", "<vector>", "public"] },
  { include: ["@<__node_handle>", "private", "<unordered_map>", "public"] },
  { include: ["@<__locale>", "private", "<locale>", "public"] },
  { include: ["@<__std_mbstate_t.h>", "private", "<cwchar>", "public"] },
  { include: ["@<__mbstate_t.h>", "private", "<cwchar>", "public"] },
  { include: ["@<__verbose_abort>", "private", "<exception>", "public"] },
  { include: ["@<__assert>", "private", "<cassert>", "public"] },
  { include: ["@<_types/.*>", "private", "<cstdint>", "public"] },
  { include: ["@<sys/_types/.*>", "private", "<cstddef>", "public"] },
  { include: ["@<sys/_pthread/.*>", "private", "<pthread.h>", "public"] },
  { include: ["@<arm/_types.h>", "private", "<cstdint>", "public"] },

  # glm: one public header for the core types; detail/ and the ext/ pieces behind it are private.
  { include: ["@<glm/detail/.*>", "private", "<glm/glm.hpp>", "public"] },
  { include: ["@<glm/ext/(vector|matrix|scalar)_.*>", "private", "<glm/glm.hpp>", "public"] },
  { include: ["@<glm/ext/quaternion_.*>", "private", "<glm/gtc/quaternion.hpp>", "public"] },
  { include: ["@<glm/(vec2|vec3|vec4|mat2x2|mat3x3|mat4x4|common|exponential|geometric|matrix|trigonometric|vector_relational|integer|packing)\\.hpp>", "private", "<glm/glm.hpp>", "public"] },

  # EnTT: the project includes the single umbrella header.
  { include: ["@<entt/(config|container|core|entity|graph|locator|meta|poly|process|resource|signal)/.*>", "private", "<entt/entt.hpp>", "public"] },

  # Logging: spdlog/fmt are reached through the project's logger.
  { include: ["@<spdlog/.*>", "private", "<Common/Core/Logger.hpp>", "public"] },

  # Vulkan: the generated per-feature headers sit behind vulkan.h; VMA and vk-bootstrap are public as they are.
  { include: ["@<vulkan/vulkan_.*>", "private", "<vulkan/vulkan.h>", "public"] },
  { include: ["@<vulkan/vk_platform.h>", "private", "<vulkan/vulkan.h>", "public"] },

  # Dear ImGui: imconfig is behind imgui.h.
  { include: ["<ImGui/imconfig.h>", "private", "<ImGui/imgui.h>", "public"] },
  { include: ["\"imconfig.h\"", "private", "<ImGui/imgui.h>", "public"] }
]
